b2_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "ef9c30359c74b9a3e16b156220ff47173c639269", "git_parents": ["5923aada3281bc0bf26d8aeea6e94e61d0ec35c9"], "node": "4ee0ac834a84b937347147e1e2606cf28dad2c8f", "parents": ["e74795e3ffbf0d3e7ceab033d98bea19d0b2d9a4"], "tags": []}], "date": 1787144871, "git_changesets": ["ef9c30359c74b9a3e16b156220ff47173c639269"], "user": "ffxbld@lando.moz.tools"}, "28070": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 485039f30acedc68e07db7a605723dc8b1a36707 with FIREFOX_155_0b2_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "cc800556beb9027b8046e35baa2c3d6cd3e689c6", "git_parents": ["ef9c30359c74b9a3e16b156220ff47173c639269"], "node": "a016254473499ae97d56d1a3cf2fd900d4040277", "parents": ["4ee0ac834a84b937347147e1e2606cf28dad2c8f"], "tags": []}], "date": 1787144966, "git_changesets": ["cc800556beb9027b8046e35baa2c3d6cd3e689c6"], "user": "ffxbld@lando.moz.tools"}, "28071": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE DONTBUILD\n", "files": ["browser/config/version_display.txt", "mobile/android/version.txt"], "git_node": "54b7c7dcc4bc844fbcc0573252a21abf49baa0a0", "git_parents": ["7335c569dfadc805b83125c21044e1a3cc82b987"], "node": "a94bf2f108b8bc03352295425cf803c65bc19191", "parents": ["485039f30acedc68e07db7a605723dc8b1a36707"], "tags": []}], "date": 1787145975, "git_changesets": ["54b7c7dcc4bc844fbcc0573252a21abf49baa0a0"], "user": "ffxbld@lando.moz.tools"}, "28072": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 485039f30acedc68e07db7a605723dc8b1a36707 with FIREFOX-ANDROID_155_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "f6ffd4182caa79f55eebde7319fb59ac9a421a9c", "git_parents": ["cc800556beb9027b8046e35baa2c3d6cd3e689c6"], "node": "d4f3d05708c310e500e6d27c09f6559cc5a9ff74", "parents": ["a016254473499ae97d56d1a3cf2fd900d4040277"], "tags": []}], "date": 1787145995, "git_changesets": ["f6ffd4182caa79f55eebde7319fb59ac9a421a9c"], "user": "ffxbld@lando.moz.tools"}, "28073": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 485039f30acedc68e07db7a605723dc8b1a36707 with DEVEDITION_155_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "8d40f6fa3b7f33f32b455256e88d67cae47dc656", "git_parents": ["f6ffd4182caa79f55eebde7319fb59ac9a421a9c"], "node": "c90d4e9e448be10f3e84d8c18fb90c921720a3d4", "parents": ["d4f3d05708c310e500e6d27c09f6559cc5a9ff74"], "tags": []}], "date": 1787153514, "git_changesets": ["8d40f6fa3b7f33f32b455256e88d67cae47dc656"], "user": "ffxbld@lando.moz.tools"}, "28074": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 485039f30acedc68e07db7a605723dc8b1a36707 with FIREFOX_155_0b2_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "3da0ff8451efdd7c99f4abf3c1ba47a508499c1a", "git_parents": ["8d40f6fa3b7f33f32b455256e88d67cae47dc656"], "node": "a62cda3d03a72edb327fc2ba45510ce1771a190a", "parents": ["c90d4e9e448be10f3e84d8c18fb90c921720a3d4"], "tags": []}], "date": 1787153699, "git_changesets": ["3da0ff8451efdd7c99f4abf3c1ba47a508499c1a"], "user": "ffxbld@lando.moz.tools"}, "28075": {"changesets": [{"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2063669 - Mark a timed out xpcshell test done again so the scheduler stops waiting for it, r=ahal a=test-only DONTBUILD\n\nA test process that gets killed on timeout often leaves a child process behind\nholding the stdout pipe the harness reads, so communicate() never sees EOF and\nrun_test() never returns. testTimeout used to set done itself, which let the\nscheduler abandon the blocked thread: join(1) times out, is_alive() is true, and\nthe test goes to the retry list. Bug 2052432 left done for run() to set, which\nthat thread will never reach, so the scheduler waits for the test forever and the\njob dies on mozharness's 1000 second output timeout without logging anything\nmore.\n\nSet it at the end of testTimeout rather than where it used to be, so the TIMEOUT\ntest_end is logged before a retry can interleave its test_start with our output.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318775\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "80093293722058cba90c15233a7be4bba018137d", "git_parents": ["54b7c7dcc4bc844fbcc0573252a21abf49baa0a0"], "node": "cbea54796342df2acb96aed3f547d62bcb8211f1", "parents": ["a94bf2f108b8bc03352295425cf803c65bc19191"], "tags": []}], "date": 1787161452, "git_changesets": ["80093293722058cba90c15233a7be4bba018137d"], "user": "rvandermeulen@mozilla.com"}, "28076": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042768 - Remove incorrect weak map marking checks  a=RyanVM\n\nThis removes the incorrect check (that actually wasn't running until recently\nbecause of another bug) and adds more checks that are hopefuly correct this time.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D303321\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319768\n", "files": ["js/src/gc/Verifier.cpp", "js/src/gc/WeakMap-inl.h", "js/src/gc/WeakMap.h", "js/src/jit-test/tests/gc/bug-2042768.js"], "git_node": "2d99f76d1422ef93a04f89412b058164f0ff9c11", "git_parents": ["80093293722058cba90c15233a7be4bba018137d"], "node": "6d9630dcffbf34e04a1be2da4b38f6be40edb77a", "parents": ["cbea54796342df2acb96aed3f547d62bcb8211f1"], "tags": []}], "date": 1787161866, "git_changesets": ["2d99f76d1422ef93a04f89412b058164f0ff9c11"], "user": "rvandermeulen@mozilla.com"}, "28077": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061775 - Ensure GC marker knows which zone we're in when marking weakmaps  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318433\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319799\n", "files": ["js/src/gc/GCMarker.h", "js/src/gc/Marking.cpp", "js/src/gc/WeakMap-inl.h", "js/src/jit-test/tests/gc/bug-2061775.js"], "git_node": "9005972c9a0dd79c242cf90e6c3847cf07e99046", "git_parents": ["2d99f76d1422ef93a04f89412b058164f0ff9c11"], "node": "56bed45db42ac473680579c7636838fd3cf557cb", "parents": ["6d9630dcffbf34e04a1be2da4b38f6be40edb77a"], "tags": []}], "date": 1787161894, "git_changesets": ["9005972c9a0dd79c242cf90e6c3847cf07e99046"], "user": "rvandermeulen@mozilla.com"}, "28078": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057457 - Ensure we don't lose atom references for symbol weak edges  a=RyanVM\n\nThe problem is that our efforts to refine the atom references effectively by\ndelaying marking atoms referenced by uncollected zones until after refining the\natom reference bitmaps means that we throw away refernces to live atoms that\nare only weakly referenced by collecting zones.\n\nThis is the same problem we've fixed several times in the weak map marking\ncode.\n\nThe fix adds a common way to handle marking weakly refereneced atoms and uses\nit in both cases. This allows us to remove two previous attempts to patch up\nthis problem. It is similar to what we do for weak map edges: mark weakly\nreferenced atoms that are referenced by uncollected zones eagarly. Thes means\nthey are marked when we refine the reference bitmaps for collected zones so\nexisting references are preserved and not thrown away.\n\nThe patch does the marking manually since we can be in the sweep state by this\ntime and the marking machinery doesn't allow any more marking.\n\nThis moves updating the reference bitmaps until the end of sweeping so that it\ncan see marking done by tracing weak edges. Deferred gray marking checks are\ndone after this happens.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316060\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319800\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/GCRuntime.h", "js/src/gc/Marking.cpp", "js/src/gc/Sweeping.cpp", "js/src/gc/WeakMap-inl.h", "js/src/gc/WeakMap.cpp", "js/src/jit-test/tests/gc/bug-1997896.js", "js/src/jit-test/tests/gc/bug-2042465.js"], "git_node": "e6d0148bf36ff246f9364b623029b17bf5574208", "git_parents": ["9005972c9a0dd79c242cf90e6c3847cf07e99046"], "node": "62d3fb5dd162d99d40022e0ee79d1b685846be1b", "parents": ["56bed45db42ac473680579c7636838fd3cf557cb"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057457 - Add testcase  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316061\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319801\n", "files": ["js/src/jit-test/tests/gc/bug-2057457.js"], "git_node": "29fc32df3477252e53f00ee22f3eeb11d42876f7", "git_parents": ["e6d0148bf36ff246f9364b623029b17bf5574208"], "node": "69922be61b580d91c3d1fe235378ee34e2c9cd2c", "parents": ["62d3fb5dd162d99d40022e0ee79d1b685846be1b"], "tags": []}], "date": 1787161933, "git_changesets": ["e6d0148bf36ff246f9364b623029b17bf5574208", "29fc32df3477252e53f00ee22f3eeb11d42876f7"], "user": "rvandermeulen@mozilla.com"}, "28079": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061300 - Make ProxyObject::renew work when called on dying objects  a=RyanVM\n\nThis is similar to other places where we call setMayHavePointersToDeadCells().\nWe may end up remapping dying proxy objects so if we insert a storebuffer entry\nwe need to set this flag so we'll empty the nursery before we sweep the object.\n\nThe patch also makes a change to the shell to supply a rewrap callback that\ncalls Wrapper::Renew on existing proxies, like the browser does.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318478\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319802\n", "files": ["js/src/jit-test/tests/gc/bug-2061300.js", "js/src/proxy/Proxy.cpp", "js/src/shell/js.cpp"], "git_node": "610a95166863ce5e9c31df07a1f80adadcf04b01", "git_parents": ["29fc32df3477252e53f00ee22f3eeb11d42876f7"], "node": "25cf5ef55db157d9678e3f00be4b8f79d33501d3", "parents": ["69922be61b580d91c3d1fe235378ee34e2c9cd2c"], "tags": []}], "date": 1787161968, "git_changesets": ["610a95166863ce5e9c31df07a1f80adadcf04b01"], "user": "rvandermeulen@mozilla.com"}, "28080": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2061292 - Ensure scrolled content is in the same doc.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319156\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319727\n", "files": ["layout/base/PresShell.cpp", "testing/web-platform/tests/css/css-contain/content-visibility/crashtests/scroll-into-view-target-moved-to-other-document.html"], "git_node": "740cea4729eff4cbde0aac1155e888ad7ed7bacd", "git_parents": ["610a95166863ce5e9c31df07a1f80adadcf04b01"], "node": "12968b892a5522e5760ac753ee8aeada3110a2b9", "parents": ["25cf5ef55db157d9678e3f00be4b8f79d33501d3"], "tags": []}], "date": 1787162002, "git_changesets": ["740cea4729eff4cbde0aac1155e888ad7ed7bacd"], "user": "rvandermeulen@mozilla.com"}, "28081": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2063384 - No-Vary-Search writes revalidation to wrong cache key  a=RyanVM\n\nThis patch makes sure avoids writing to a cache entry when that entry was\nreturned due to no-vary-search header matching.\nWhen that happens, and the channel needs to truncate, revalidate or reopen\nthe entry, we will use the channel's URL instead of writing to the returned\ncache entry, as that may have different query parameters.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318681\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319787\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h", "netwerk/test/unit/test_no_vary_search_revalidation.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "a0c9b70c82a2f29631297dbaa2f21c4a5c3b626c", "git_parents": ["740cea4729eff4cbde0aac1155e888ad7ed7bacd"], "node": "09b64fd0341726a0914d1463a3e8d9a968d7e639", "parents": ["12968b892a5522e5760ac753ee8aeada3110a2b9"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2063384 - Avoid appending duplicate keys to mNoVarySearchIndex  a=RyanVM\n\nDoing so could make the array grow with every revalidation.\nInstead we only add it when the key is not already present in the array.\nA call to Contains is fine, as the number of elements in the array is normally a just a handful,\nso we don't need to worry about performance here.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318682\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319788\n", "files": ["netwerk/cache2/CacheStorage.h"], "git_node": "6e4afcba705c196a415335beed57daf8e53c0026", "git_parents": ["a0c9b70c82a2f29631297dbaa2f21c4a5c3b626c"], "node": "70c99784a66c7a063e6407b6e8a430536e347158", "parents": ["09b64fd0341726a0914d1463a3e8d9a968d7e639"], "tags": []}], "date": 1787162043, "git_changesets": ["a0c9b70c82a2f29631297dbaa2f21c4a5c3b626c", "6e4afcba705c196a415335beed57daf8e53c0026"], "user": "rvandermeulen@mozilla.com"}, "28082": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2063994.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319068\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319069\n", "files": ["image/decoders/nsJXLDecoder.cpp"], "git_node": "aeea1e022653c080f3f28b83830873a22aa8eb9c", "git_parents": ["6e4afcba705c196a415335beed57daf8e53c0026"], "node": "e2d2eaaed92986f4693d9aa708f1941e050a4a44", "parents": ["70c99784a66c7a063e6407b6e8a430536e347158"], "tags": []}], "date": 1787162069, "git_changesets": ["aeea1e022653c080f3f28b83830873a22aa8eb9c"], "user": "rvandermeulen@mozilla.com"}, "28083": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064446 - Update intellij-markdown to version 0.7.9.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319571\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319765\n", "files": ["gradle/libs.versions.toml"], "git_node": "8bae7e36eaf4a26a13fde945f61a7579e4a4bfa5", "git_parents": ["aeea1e022653c080f3f28b83830873a22aa8eb9c"], "node": "1f6091f9d0808e61e4e1713e5bb3005e713a93af", "parents": ["e2d2eaaed92986f4693d9aa708f1941e050a4a44"], "tags": []}], "date": 1787162102, "git_changesets": ["8bae7e36eaf4a26a13fde945f61a7579e4a4bfa5"], "user": "rvandermeulen@mozilla.com"}, "28084": {"changesets": [{"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059702 - Fix some Tier-3 build issues in SharedMemoryPlatform_posix.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317966\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319865\n", "files": ["ipc/glue/SharedMemoryPlatform_posix.cpp"], "git_node": "b322c9b8ab0ade82e4c6d3e721b7508f757bd73d", "git_parents": ["8bae7e36eaf4a26a13fde945f61a7579e4a4bfa5"], "node": "0772e6409d4fa440e5127983a1b1a5984b5cea11", "parents": ["1f6091f9d0808e61e4e1713e5bb3005e713a93af"], "tags": []}], "date": 1787162466, "git_changesets": ["b322c9b8ab0ade82e4c6d3e721b7508f757bd73d"], "user": "rvandermeulen@mozilla.com"}, "28085": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043546 - Populate securityInfo for adopted Happy Eyeballs 0-RTT transactions  a=RyanVM\n\nAn accepted 0-RTT winner sends its request as early data, so the adopted transaction may never refresh securityInfo the way Finish0RTT does. In particular, nsHttpTransaction::ReadSegments may not be called, leaving the channel with a null securityInfo.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319446\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319797\n", "files": ["netwerk/protocol/http/HappyEyeballsTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h"], "git_node": "870ef5723d292547d312f5da914bdc7f4df53502", "git_parents": ["b322c9b8ab0ade82e4c6d3e721b7508f757bd73d"], "node": "d51e69fe799522eb6a8ec720d5bd030c45dab888", "parents": ["0772e6409d4fa440e5127983a1b1a5984b5cea11"], "tags": []}], "date": 1787162495, "git_changesets": ["870ef5723d292547d312f5da914bdc7f4df53502"], "user": "rvandermeulen@mozilla.com"}, "28086": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058006 - Call Destroy() unconditionally in ~StatusBarEntry.  a=RyanVM\n\nAllow Destroy() to tear down mIconLoader, even if Init() does not successfully\ncomplete initialization.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318206\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319878\n", "files": ["widget/windows/SystemStatusBar.cpp"], "git_node": "5b1898ea13aa30105f81918725f5c10648cb82c1", "git_parents": ["870ef5723d292547d312f5da914bdc7f4df53502"], "node": "6a2ae027c821c166b6896438c7232073fb105802", "parents": ["d51e69fe799522eb6a8ec720d5bd030c45dab888"], "tags": []}], "date": 1787162528, "git_changesets": ["5b1898ea13aa30105f81918725f5c10648cb82c1"], "user": "rvandermeulen@mozilla.com"}, "28087": {"changesets": [{"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2057700 - Don't count a crash the harness logged quietly as an unexpected crash, r=ahal a=test-only\n\nmozharness fails a job when the number of crash actions exceeds the number of\nexpected CRASH statuses. A test that times out is force-killed to get a minidump\nof the hang, which emits a crash action, but the test ends as TIMEOUT, so nothing\nraises that limit: the job goes red with \"Got 1 unexpected crashes\" and no failing\ntest, even though the timeout was retried and passed.\n\nHarnesses already mark these: mozcrash's quiet flag is set for crashes they don't\nconsider worth reporting -- mochitest passes it when crashes are expected, xpcshell\nwhen they are expected or the test will be retried. Don't count those. The stacks\nare still logged and the dump still uploaded; a crash on a run that isn't retried\nis unaffected and still fails the job.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318256\n", "files": ["testing/mozbase/mozlog/mozlog/handlers/statushandler.py", "testing/mozbase/mozlog/tests/test_structured.py"], "git_node": "0e73158e59d97ea294d14bf5706c8b2700d8d9fb", "git_parents": ["5b1898ea13aa30105f81918725f5c10648cb82c1"], "node": "e27e6fae2d44cfdfe7941792f9a1f43a921fb74c", "parents": ["6a2ae027c821c166b6896438c7232073fb105802"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2063670 - Don't wait for a blocked test thread in the xpcshell sequential and retry phases, r=ahal a=test-only\n\nThe scheduler's parallel phase copes with a test whose thread can no longer finish\n(it joins with a timeout and moves on), but the sequential and retry phases join\nwithout one. A test that times out leaving a child process holding its stdout pipe\nopen never returns from communicate(), so those two loops wait for a thread that\nwill never exit and the job dies on mozharness's 1000 second output timeout.\n\nWait for the done flag rather than for the thread in both loops, and give exception\nand traceback a value up front, since a thread abandoned this way never reaches the\ncode in run() that assigns them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318776\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "a1fe35f0876b19aa2ea7dc5abdd8002e5b5da270", "git_parents": ["0e73158e59d97ea294d14bf5706c8b2700d8d9fb"], "node": "b27eababeaa6ae8c0870c56410d49d3de71b39b2", "parents": ["e27e6fae2d44cfdfe7941792f9a1f43a921fb74c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2063726 - Set done from a finally so a raise in the xpcshell timeout cleanup can't strand the run, r=ahal a=test-only\n\ntestTimeout runs on the timer thread, and everything between marking a test timed\nout and marking it done -- killing the process, processing its dump, reporting the\ntimeout, cleaning the temp dirs -- can raise. When it does, the thread dies without\nsetting done and without releasing the lock. The test's own thread is typically\nblocked forever on a stdout pipe a surviving child process holds open, so nothing\nelse will ever set done and the scheduler waits for that test until mozharness kills\nthe job on its 1000 second output timeout.\n\nA try push hit this on Windows, where mozcrash raised PermissionError copying a\nminidump the OS still had open.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318833\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "893ffef543b234067a1a6de2ac927b01265a3f33", "git_parents": ["a1fe35f0876b19aa2ea7dc5abdd8002e5b5da270"], "node": "e6adf63e99041c9200e0b3e6709ec208c799214a", "parents": ["b27eababeaa6ae8c0870c56410d49d3de71b39b2"], "tags": []}], "date": 1787190710, "git_changesets": ["0e73158e59d97ea294d14bf5706c8b2700d8d9fb", "a1fe35f0876b19aa2ea7dc5abdd8002e5b5da270", "893ffef543b234067a1a6de2ac927b01265a3f33"], "user": "rvandermeulen@mozilla.com"}, "28088": {"changesets": [{"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063266 - Revert \"Bug 2025793\" - Bundle newtab during build r=mconley,sylvestre a=RyanVM\n\nThis reverts Bug 2025793\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319590\n", "files": [".gitignore", ".hgignore", "CLOBBER", "browser/extensions/moz.configure", "browser/extensions/newtab/.npmrc", "browser/extensions/newtab/addon-jar.mn", "browser/extensions/newtab/bin/try-runner.js", "browser/extensions/newtab/build-newtab-bundles.py", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/data/content/vendor.bundle.js", "browser/extensions/newtab/lib/cache.worker.js", "browser/extensions/newtab/moz.build", "browser/extensions/newtab/package-lock.json", "browser/extensions/newtab/webext-glue/moz.build", "browser/extensions/newtab/webpack.system-addon.config.js", "taskcluster/kinds/artifact-build/kind.yml", "taskcluster/kinds/build-extensions/kind.yml", "taskcluster/kinds/build/kind.yml", "taskcluster/kinds/hazard/kind.yml", "taskcluster/kinds/instrumented-build/kind.yml", "taskcluster/kinds/searchfox/kind.yml", "taskcluster/kinds/valgrind/kind.yml", "toolkit/content/license.html", "tools/lint/rejected-words.yml"], "git_node": "2e0d261654934bc97117c0142c72f625934b7dc1", "git_parents": ["893ffef543b234067a1a6de2ac927b01265a3f33"], "node": "7f9267ac33d9dcf7ef60441f35795bf7e5425d87", "parents": ["e6adf63e99041c9200e0b3e6709ec208c799214a"], "tags": []}], "date": 1787191451, "git_changesets": ["2e0d261654934bc97117c0142c72f625934b7dc1"], "user": "rvandermeulen@mozilla.com"}, "28089": {"changesets": [{"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063993 - Disable Rust logins storage on release  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319038\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319769\n", "files": ["modules/libpref/init/all.js"], "git_node": "b38d1226bf17cf1397759e90d7d2202cac31d7e6", "git_parents": ["2e0d261654934bc97117c0142c72f625934b7dc1"], "node": "c481dd68f7cef257a4f3c5e0d26487122d3b51f7", "parents": ["7f9267ac33d9dcf7ef60441f35795bf7e5425d87"], "tags": []}], "date": 1787191505, "git_changesets": ["b38d1226bf17cf1397759e90d7d2202cac31d7e6"], "user": "rvandermeulen@mozilla.com"}, "28090": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2064188 - Ensure Nimbus update timer is set during init  a=RyanVM\n\nIn bug 1941963, side effects were removed from\nRemoteSettingsExperimentLoader.sys.mjs, making it safe to import without\ntriggering the creation of a global RemoteSettingsExperimentLoader.\nHowever, that patch also gated setting the update timer based on the\nRemoteSettingsExperimentLoader's enabled state. Unfortunately,\nthe timer was registered *before* the enabled flag was set, which meant\nthat the timer was never actually registered.\n\nWe now ensure that we set the enable state before registering the timer.\nThis behaviour is tracked by a new test.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319282\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319808\n", "files": ["toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_timer.js", "toolkit/components/nimbus/test/unit/xpcshell.toml"], "git_node": "c62b2543d6955d36bf396bb25dc02d69a1b03c3f", "git_parents": ["b38d1226bf17cf1397759e90d7d2202cac31d7e6"], "node": "3fa852842e50a976254533b08ae38c407a8bb5a7", "parents": ["c481dd68f7cef257a4f3c5e0d26487122d3b51f7"], "tags": []}], "date": 1787191592, "git_changesets": ["c62b2543d6955d36bf396bb25dc02d69a1b03c3f"], "user": "rvandermeulen@mozilla.com"}, "28091": {"changesets": [{"author": "Swarup Ukil \u003csukil@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059655 - Update tainted range to be relative to substituted value.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318245\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319939\n", "files": ["servo/components/style/custom_properties.rs", "testing/web-platform/tests/css/css-values/attr-security.html"], "git_node": "8bcea49702f24ce1e1939cef6e22555cf13bbd6f", "git_parents": ["c62b2543d6955d36bf396bb25dc02d69a1b03c3f"], "node": "02246af9d24e9e7af38894ffd9653909c0c57534", "parents": ["3fa852842e50a976254533b08ae38c407a8bb5a7"], "tags": []}], "date": 1787191718, "git_changesets": ["8bcea49702f24ce1e1939cef6e22555cf13bbd6f"], "user": "rvandermeulen@mozilla.com"}, "28092": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059199 - Reject NUL bytes in chunked trailer and chunk-size lines  a=RyanVM\n\nA trailer field line whose first byte is NUL would look empty to the\nend-of-trailer check, ending the trailer section early. We would then stop\nreading the body before the server (or a shared proxy) does, and disagree\nwith them about where the response ends.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317742\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319930\n", "files": ["netwerk/protocol/http/nsHttpChunkedDecoder.cpp"], "git_node": "d279e15f15e269f0be78209ef25d03067bc99025", "git_parents": ["8bcea49702f24ce1e1939cef6e22555cf13bbd6f"], "node": "4da09b4029c49a4b423aad9514bcb5d4166feded", "parents": ["02246af9d24e9e7af38894ffd9653909c0c57534"], "tags": []}], "date": 1787191983, "git_changesets": ["d279e15f15e269f0be78209ef25d03067bc99025"], "user": "rvandermeulen@mozilla.com"}, "28093": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2061110, handle popover hiding in a bit more consistent way,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319204\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319971\n", "files": ["dom/base/Document.cpp"], "git_node": "b99c4111863d1242ae665b9b3a13a726b1aa1124", "git_parents": ["d279e15f15e269f0be78209ef25d03067bc99025"], "node": "176bf88e0a2e43b4b9d4e9eebe2fceeda3f5eb0a", "parents": ["4da09b4029c49a4b423aad9514bcb5d4166feded"], "tags": []}], "date": 1787192179, "git_changesets": ["b99c4111863d1242ae665b9b3a13a726b1aa1124"], "user": "rvandermeulen@mozilla.com"}, "28094": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/fenix/app/src/main/res/values-cak/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-ka/strings.xml"], "git_node": "786fd1da96442f2a0f11b2b680657e6e4db4d127", "git_parents": ["b99c4111863d1242ae665b9b3a13a726b1aa1124"], "node": "61aa1beacb4de16a3af611a19081aef6304ba11c", "parents": ["176bf88e0a2e43b4b9d4e9eebe2fceeda3f5eb0a"], "tags": []}], "date": 1787192281, "git_changesets": ["786fd1da96442f2a0f11b2b680657e6e4db4d127"], "user": "ffxbld@lando.moz.tools"}, "28095": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058013 - Only resolve non-filesystem picker results as shell libraries  a=RyanVM\n\nA genuine shell library is a virtual item with no filesystem path.  A\n.library-ms file is an ordinary file whose XML can name any local directory.\n\nfiledialog::GetFolderResults was passing whatever IFileDialog::GetResult\nreturned to IShellLibrary::LoadLibraryFromItem and, on success, replacing it\nwith the library's embedded default save folder.\n\nGating the resolution on the item being affirmatively not a filesystem object\nkeeps real libraries selectable and resolving as before, while a .library-ms\nfile \"resolves\" to itself -- the .library-ms file, not its target.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318246\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319956\n", "files": ["widget/windows/filedialog/WinFileDialogCommands.cpp"], "git_node": "a2ef5e6aa975037e40cb49c8d99d6db4efbf90b5", "git_parents": ["786fd1da96442f2a0f11b2b680657e6e4db4d127"], "node": "24081407d51e6c6672b4a0225d3652740bd37a1c", "parents": ["61aa1beacb4de16a3af611a19081aef6304ba11c"], "tags": []}], "date": 1787192625, "git_changesets": ["a2ef5e6aa975037e40cb49c8d99d6db4efbf90b5"], "user": "rvandermeulen@mozilla.com"}, "28096": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059027 - Create the DLL blocklist shared section with an empty DACL.  a=RyanVM\n\nSharedSection::Init() creates the section with no security descriptor.\nGive the object a present-but-empty DACL, as ipc/glue does for freezable\nshared memory.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318252\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319960\n", "files": ["browser/app/winlauncher/freestanding/SharedSection.cpp", "browser/app/winlauncher/freestanding/moz.build", "browser/app/winlauncher/test/TestCrossProcessWin.cpp", "browser/app/winlauncher/test/moz.build"], "git_node": "1b3b173ac664fabd6f9ef132c388875e91974ffa", "git_parents": ["a2ef5e6aa975037e40cb49c8d99d6db4efbf90b5"], "node": "dc736f380b11de5056303b202eafd105a65ce432", "parents": ["24081407d51e6c6672b4a0225d3652740bd37a1c"], "tags": []}], "date": 1787192679, "git_changesets": ["1b3b173ac664fabd6f9ef132c388875e91974ffa"], "user": "rvandermeulen@mozilla.com"}, "28097": {"changesets": [{"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2061220, Bug 2058051 - Backport cubeb WASAPI output channel count and WinMM stream destroy fixes.  a=RyanVM\n\nThis branch pins an older libcubeb revision, so the two fixes are carried as\nlocal vendoring patches rather than a full libcubeb update:\n\n- wasapi-output-mix-channel-count.patch: upstream cubeb dc56ea41 and f0bd97db\n  (mozilla/cubeb#856), bug 2061220.  Creates the output mixer when the device\n  mix channel count differs from the stream channel count, and rejects stream\n  params whose layout and channel count disagree.\n- winmm-destroy-work-item-uaf.patch: upstream cubeb f6b59a3b\n  (mozilla/cubeb#854), bug 2058051.  Counts pending buffer thread work items\n  per stream and in-flight driver callbacks per context so stream and context\n  destruction wait for them to drain.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319944\n", "files": ["media/libcubeb/moz.yaml", "media/libcubeb/src/cubeb.c", "media/libcubeb/src/cubeb_wasapi.cpp", "media/libcubeb/src/cubeb_winmm.c", "media/libcubeb/test/test_sanity.cpp", "media/libcubeb/wasapi-output-mix-channel-count.patch", "media/libcubeb/winmm-destroy-work-item-uaf.patch"], "git_node": "0f427e40a7b0429039f8057b1aeded836d2aa4d5", "git_parents": ["1b3b173ac664fabd6f9ef132c388875e91974ffa"], "node": "4be2c3a6e4d739fbaf1080a4597de368c4ec0ec1", "parents": ["dc736f380b11de5056303b202eafd105a65ce432"], "tags": []}], "date": 1787192775, "git_changesets": ["0f427e40a7b0429039f8057b1aeded836d2aa4d5"], "user": "rvandermeulen@mozilla.com"}, "28098": {"changesets": [{"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064156 - Consolidate referral entry points to one metric  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319203\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319940\n", "files": ["browser/base/content/aboutDialog.js", "browser/base/content/browser-sets.js", "browser/base/content/browser-sync.js", "browser/base/content/utilityOverlay.js", "browser/components/preferences/config/account-sync.mjs", "browser/components/referrals/Referrals.sys.mjs", "browser/components/referrals/metrics.yaml", "browser/components/referrals/tests/browser/browser_referralsAccountMenu.js", "browser/components/referrals/tests/browser/browser_referralsAppMenu.js"], "git_node": "e4d6d9da099915580dc94cc13c5c42313975f27d", "git_parents": ["0f427e40a7b0429039f8057b1aeded836d2aa4d5"], "node": "da5bdc262183377e681858414d52fe26c54a9a2d", "parents": ["4be2c3a6e4d739fbaf1080a4597de368c4ec0ec1"], "tags": []}], "date": 1787192871, "git_changesets": ["e4d6d9da099915580dc94cc13c5c42313975f27d"], "user": "rvandermeulen@mozilla.com"}, "28099": {"changesets": [{"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055693 - Remove dead javascript: URI handling in LoadHistoryEntry.  a=RyanVM\n\nPer spec, javascript: URIs are never stored in SH. Neither has this code test\ncoverage, nor does the test on the bug that introduced it still pass.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314860\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319680\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/shistory/SessionHistoryEntry.cpp"], "git_node": "aba0819d67060d84da19c81ff4d02709a38493e4", "git_parents": ["e4d6d9da099915580dc94cc13c5c42313975f27d"], "node": "cae51ebcc5c0640a756ae50ab925fd3f1cfd330f", "parents": ["da5bdc262183377e681858414d52fe26c54a9a2d"], "tags": []}], "date": 1787192957, "git_changesets": ["aba0819d67060d84da19c81ff4d02709a38493e4"], "user": "rvandermeulen@mozilla.com"}, "28100": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060008.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315941\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319674\n", "files": ["gfx/2d/DrawTargetCairo.cpp"], "git_node": "75b7586c5963996f4c4cd2cedface2483f73f7cf", "git_parents": ["aba0819d67060d84da19c81ff4d02709a38493e4"], "node": "0b79202095f15a0637c21774e3a1c3110f9b489b", "parents": ["cae51ebcc5c0640a756ae50ab925fd3f1cfd330f"], "tags": []}], "date": 1787192990, "git_changesets": ["75b7586c5963996f4c4cd2cedface2483f73f7cf"], "user": "rvandermeulen@mozilla.com"}, "28101": {"changesets": [{"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2062673 - Only clamp the raster scale of perspective surfaces to a minimum of one  a=RyanVM\n\ncoplanar_scale_factors() also succeeds for a non-perspective mapping, so the\nclamp from bug 2060361 applied to every nested surface, growing the raster\narea of any that was minified. Keep the exact, unclamped scale factors off\nthe perspective path.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318263\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319926\n", "files": ["gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/spatial_tree.rs"], "git_node": "33559d6776899605d71112e046878d37ec43a9e1", "git_parents": ["75b7586c5963996f4c4cd2cedface2483f73f7cf"], "node": "d9d5f1874c24105f4881b30185ecf17b7fcb4a93", "parents": ["0b79202095f15a0637c21774e3a1c3110f9b489b"], "tags": []}], "date": 1787193055, "git_changesets": ["33559d6776899605d71112e046878d37ec43a9e1"], "user": "rvandermeulen@mozilla.com"}, "28102": {"changesets": [{"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063261 - Stop the round container icon background from clipping the icon itself  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319559\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319736\n", "files": ["browser/components/contextualidentity/content/usercontext.css", "toolkit/content/widgets/moz-box-common.css"], "git_node": "83845f376dc2bee85a4ab1d9b9639df448a8fafe", "git_parents": ["33559d6776899605d71112e046878d37ec43a9e1"], "node": "55696d61662a7a48bbb944f0215b024f52c46ef0", "parents": ["d9d5f1874c24105f4881b30185ecf17b7fcb4a93"], "tags": []}], "date": 1787193501, "git_changesets": ["83845f376dc2bee85a4ab1d9b9639df448a8fafe"], "user": "rvandermeulen@mozilla.com"}, "28103": {"changesets": [{"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063336 - Cap the cookie database WAL size in bytes instead of pages  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319294\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319735\n", "files": ["netwerk/cookie/CookiePersistentStorage.cpp"], "git_node": "39460e627b5160561dd93351d6e0c2a238463ce9", "git_parents": ["83845f376dc2bee85a4ab1d9b9639df448a8fafe"], "node": "3977be84e4eadf18af15fb8c54332ff83e61b1da", "parents": ["55696d61662a7a48bbb944f0215b024f52c46ef0"], "tags": []}], "date": 1787193545, "git_changesets": ["39460e627b5160561dd93351d6e0c2a238463ce9"], "user": "rvandermeulen@mozilla.com"}, "28104": {"changesets": [{"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061869 - Start Smart Window schedulers when first-run onboarding completes  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317194\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319890\n", "files": ["browser/components/aiwindow/models/memories/MemoriesSchedulers.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_memories.js"], "git_node": "bb0073af4d1c49b656df6c0e348fcb813cffe10a", "git_parents": ["39460e627b5160561dd93351d6e0c2a238463ce9"], "node": "c0aafef2526394d6203913afc5bbeec9cebc6300", "parents": ["3977be84e4eadf18af15fb8c54332ff83e61b1da"], "tags": []}], "date": 1787194425, "git_changesets": ["bb0073af4d1c49b656df6c0e348fcb813cffe10a"], "user": "rvandermeulen@mozilla.com"}, "28105": {"changesets": [{"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063308 - Gate /command palette display  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318482\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319864\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_command_palette.js", "browser/components/urlbar/content/SmartbarInputUtils.mjs"], "git_node": "605569eae3bbe0548eb2b1c8a8835080a1f523fc", "git_parents": ["bb0073af4d1c49b656df6c0e348fcb813cffe10a"], "node": "8ad1cc3c60d236cbab52863ceeed39571677132c", "parents": ["c0aafef2526394d6203913afc5bbeec9cebc6300"], "tags": []}], "date": 1787194485, "git_changesets": ["605569eae3bbe0548eb2b1c8a8835080a1f523fc"], "user": "rvandermeulen@mozilla.com"}, "28106": {"changesets": [{"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047007 - Add Smart Window enabled metrics  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319283\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319891\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/modules/SmartWindowTelemetry.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_metrics_telemetry.js"], "git_node": "c123e35f4df66621c47465e5ac899c3123abc97b", "git_parents": ["605569eae3bbe0548eb2b1c8a8835080a1f523fc"], "node": "b4c5a4a0c56dc61e1f29d6dbff655a547ac80457", "parents": ["8ad1cc3c60d236cbab52863ceeed39571677132c"], "tags": []}], "date": 1787194600, "git_changesets": ["c123e35f4df66621c47465e5ac899c3123abc97b"], "user": "rvandermeulen@mozilla.com"}, "28107": {"changesets": [{"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064470 - Add SW Agent Watch kit.svg  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319607\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319866\n", "files": ["browser/components/aiwindow/ui/assets/agent-watch-kit.svg"], "git_node": "11972faa03be1d2ca63f2d632eac19d2252e61be", "git_parents": ["c123e35f4df66621c47465e5ac899c3123abc97b"], "node": "acefcf7d60a567a29d89c56727c83ce1e8f7d33b", "parents": ["b4c5a4a0c56dc61e1f29d6dbff655a547ac80457"], "tags": []}], "date": 1787194634, "git_changesets": ["11972faa03be1d2ca63f2d632eac19d2252e61be"], "user": "rvandermeulen@mozilla.com"}, "28108": {"changesets": [{"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062695 - Improve Precision for Clusters for Auto Tab Grouping.  a=RyanVM\n\nThis patch adds the missed tab title preprocessing that was present in Smart Tab Grouping.\nIt also reduces false positives in clusters so groups have higher cohesion.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319192\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319817\n", "files": ["browser/app/profile/firefox.js", "browser/components/tabbrowser/SmartTabGrouping.sys.mjs", "browser/components/tabbrowser/test/xpcshell/smarttabgrouping/test_text_preprocessing.js"], "git_node": "57403817207e9fd5dd1e8b698cc126fd59d3931f", "git_parents": ["11972faa03be1d2ca63f2d632eac19d2252e61be"], "node": "74c512080546d4ec7df5ac4853c2e4572d84be03", "parents": ["acefcf7d60a567a29d89c56727c83ce1e8f7d33b"], "tags": []}], "date": 1787194697, "git_changesets": ["57403817207e9fd5dd1e8b698cc126fd59d3931f"], "user": "rvandermeulen@mozilla.com"}, "28109": {"changesets": [{"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062696 - Improve group naming for Auto Tab Grouping.  a=RyanVM\n\nThis patch updates the default group name generation call to use the MLPA backend.\nOn rouge, there was an improvement of ~8% against our golden dataset. If no name\nis generated, it falls back to the local model for name generation.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318789\n\n(cherry picked from commit 60e482af8dea4ca5cc2099a5abb3efed20d18e78)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319834\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_auto_tab_grouping_labeling.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_organize_tabs_callout.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/aiwindow/ui/test/xpcshell/test_AutoTabGrouping.js", "toolkit/components/ml/content/EngineProcess.sys.mjs"], "git_node": "d74589cb0a7e318398deb03839a20715bb259454", "git_parents": ["57403817207e9fd5dd1e8b698cc126fd59d3931f"], "node": "eaf1d150d85fc5b4a78962f7218021433bf10ee4", "parents": ["74c512080546d4ec7df5ac4853c2e4572d84be03"], "tags": []}], "date": 1787194755, "git_changesets": ["d74589cb0a7e318398deb03839a20715bb259454"], "user": "rvandermeulen@mozilla.com"}, "28110": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump\n\nach -\u003e f95b1994f0ed79b4abb34940ca57818a42ce2bde\naf -\u003e f95b1994f0ed79b4abb34940ca57818a42ce2bde\nan -\u003e f95b1994f0ed79b4abb34940ca57818a42ce2bde\nar -\u003e f95b1994f0ed79b4abb34940ca57818a42ce2bde\nast -\u003e f95b1994f0ed79b4abb34940ca57818a42ce2bde\naz -\u003e f95b1994f0ed79b4abb34940ca57818a42ce2bde\nbe -\u003e f95b1994f0ed79b4abb34940ca57818a42ce2bde\nbg -\u003e f95b1994f0ed79b4abb34940ca57818a42ce2bde\n