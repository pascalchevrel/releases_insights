07d", "28be99b5efe29b2aac2bbadd4087602e3242c627"], "user": "rvandermeulen@mozilla.com"}, "28190": {"changesets": [{"author": "Gela \u003cgmalekpour@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053320 - Part 1: Don't tie Nimbus tooling to `HomeActivity` UI  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319628\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320784\n", "files": ["mobile/android/fenix/app/src/main/AndroidManifest.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/experiments/QANimbusToolingReceiver.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/experiments/QANimbusToolingReceiverTest.kt"], "git_node": "d508b05fe662aee5877affc7b3f71dd3876b43cb", "git_parents": ["28be99b5efe29b2aac2bbadd4087602e3242c627"], "node": "b11f7780f6075da756a577877450b737dc501701", "parents": ["30bc973c692cfc114b5697d2cc66141639e88b71"], "tags": []}, {"author": "Gela \u003cgmalekpour@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053320 - Part 2: Remove nimbus tooling initialization from Focus  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319634\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320785\n", "files": ["mobile/android/focus-android/app/src/main/java/org/mozilla/focus/activity/MainActivity.kt"], "git_node": "128289101c656814c88894230804cdc7e4ec6c4f", "git_parents": ["d508b05fe662aee5877affc7b3f71dd3876b43cb"], "node": "bbbed0f647b9b83559814afd3639ca59f2fa1d6e", "parents": ["b11f7780f6075da756a577877450b737dc501701"], "tags": []}], "date": 1787582115, "git_changesets": ["d508b05fe662aee5877affc7b3f71dd3876b43cb", "128289101c656814c88894230804cdc7e4ec6c4f"], "user": "rvandermeulen@mozilla.com"}, "28191": {"changesets": [{"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059205 - Use the origin of the final U