c56a7\nwo -\u003e b5a42a3462bb1c2fb2efbc442518034d07fc56a7\nxh -\u003e b5a42a3462bb1c2fb2efbc442518034d07fc56a7\nzam -\u003e b5a42a3462bb1c2fb2efbc442518034d07fc56a7\nzh-CN -\u003e b5a42a3462bb1c2fb2efbc442518034d07fc56a7\nzh-TW -\u003e b5a42a3462bb1c2fb2efbc442518034d07fc56a7\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "15826a954ef84a4bbbff55bc812102d74c1b776e", "git_parents": ["3e610a82f28e68152eab4dc3d2c4794392b68a11"], "node": "c1df0449155a2e1798601f70545158159043f852", "parents": ["4743cd569c70cd712c3d922ae0eb34212f21e582"], "tags": []}], "date": 1787475971, "git_changesets": ["3e610a82f28e68152eab4dc3d2c4794392b68a11", "15826a954ef84a4bbbff55bc812102d74c1b776e"], "user": "ffxbld@lando.moz.tools"}, "28173": {"changesets": [{"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063024 - Add a onnxruntime native availability telemetry probe  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318531\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320722\n", "files": ["browser/app/profile/firefox.js", "browser/components/BrowserComponents.manifest", "testing/profiles/base/user.js", "toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/metrics.yaml", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_native_ort_availability_probe.js"], "git_node": "ad12d9e39c598b404f85800af1b58790e991802a", "git_parents": ["15826a954ef84a4bbbff55bc812102d74c1b776e"], "node": "a7f1d6fc142c760b1cffb123f5d53e39fa2e3ca7", "parents": ["c1df0449155a2e1798601f70545158159043f852"], "tags": []}], "date": 1787503437, "git_changesets": ["ad12d9e39c598b404f85800af1b58790e991802a"], "user": "rvandermeulen@mozilla.com"}, "28174": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065199 - Remove declaration that didn't use to apply.  a=RyanVM\n\nThis declaration, introduced in bug 1313751, didn't use to apply because\nthe ::before pseudo-element was a block formatting context itself (with\noverflow: hidden), and unicode-bidi is not inherited.\n\nAfter the changes to label rendering in bug 2049182 it applies, but it\napplies to the whole block rather than just the text, causing this\nissue.\n\nThis restores the behavior that we used to ship in 153. Another patch\nincoming with what I think is the desired behavior.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320641\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320645\n", "files": ["browser/themes/shared/toolbarbuttons.css"], "git_node": "2c6a9730233746227d6890641dec97bea421798c", "git_parents": ["ad12d9e39c598b404f85800af1b58790e991802a"], "node": "69f11606ee8ed218f0763eb197f4f687018efd69", "parents": ["a7f1d6fc142c760b1cffb123f5d53e39fa2e3ca7"], "tags": []}], "date": 1787503462, "git_changesets": ["2c6a9730233746227d6890641dec97bea421798c"], "user": "rvandermeulen@mozilla.com"}, "28175": {"changesets": [{"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065593 - restore logins after switching back to json  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319826\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320590\n", "files": ["modules/libpref/init/all.js", "toolkit/components/passwordmgr/LoginStorageMigrator.sys.mjs", "toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/passwordmgr/test/unit/test_LoginStorageMigrator.js"], "git_node": "587bab198c8fd9648ccfcf63c79b75caee0770cb", "git_parents": ["2c6a9730233746227d6890641dec97bea421798c"], "node": "4f3bd2fad046a57f9036f443e9353809eced0aaf", "parents": ["69f11606ee8ed218f0763eb197f4f687018efd69"], "tags": []}], "date": 1787503506, "git_changesets": ["587bab198c8fd9648ccfcf63c79b75caee0770cb"], "user": "rvandermeulen@mozilla.com"}, "28176": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058660 -  Retarget WebTransportSessionProxy before activating queued streams,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315245\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320738\n", "files": ["netwerk/protocol/webtransport/WebTransportSessionProxy.cpp"], "git_node": "32eca3df1b030350386143ff278bea115d5715eb", "git_parents": ["587bab198c8fd9648ccfcf63c79b75caee0770cb"], "node": "35c5ec1a4894140029f8408920c69461dfe4de1c", "parents": ["4f3bd2fad046a57f9036f443e9353809eced0aaf"], "tags": []}], "date": 1787509189, "git_changesets": ["32eca3df1b030350386143ff278bea115d5715eb"], "user": "rvandermeulen@mozilla.com"}, "28177": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320746\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/newtab-section-layouts.json", "services/settings/dumps/main/newtab-sections-ordering.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "e105982fe23bd37710ee5128e260e509016bc2a1", "git_parents": ["32eca3df1b030350386143ff278bea115d5715eb"], "node": "1c8bcad9af646a461adf81b33b071ce6068cfd0e", "parents": ["35c5ec1a4894140029f8408920c69461dfe4de1c"], "tags": []}], "date": 1787516122, "git_changesets": ["e105982fe23bd37710ee5128e260e509016bc2a1"], "user": "rvandermeulen@mozilla.com"}, "28178": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2061532  a=RyanVM\n\nANGLE Metal backend usage is also going to disable RenderExternalTextureHost usage.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318624\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320768\n", "files": ["gfx/webrender_bindings/RenderExternalTextureHost.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "e7ac3b35467dd8233f82ccacf9652fc3fb364ee8", "git_parents": ["e105982fe23bd37710ee5128e260e509016bc2a1"], "node": "c8994eddb14ff45da8c173d0149921705ad3d293", "parents": ["1c8bcad9af646a461adf81b33b071ce6068cfd0e"], "tags": []}], "date": 1787530945, "git_changesets": ["e7ac3b35467dd8233f82ccacf9652fc3fb364ee8"], "user": "rvandermeulen@mozilla.com"}, "28179": {"changesets": [{"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065206 - Disable trackerCount by default; it will be enabled via Experimenter instead.  a=RyanVM\n\nWe\u2019re going to set the pref to false by default for the Show Trackers feature, since we\u2019ll be using Experimenter to enable it for users instead. This approach is also safer for rollout, as it gives us full control over the feature\u2019s visibility. If anything goes wrong, we can simply disable the experiment and have the feature remain off by default.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320216\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320764\n", "files": ["browser/app/profile/firefox.js", "browser/components/preferences/tests/etp/browser_etp_status.js", "browser/components/urlbar/tests/browser-trustPanel/browser.toml"], "git_node": "3b5be5277d9ac1584d0d3c323ecc103ef0a4c921", "git_parents": ["e7ac3b35467dd8233f82ccacf9652fc3fb364ee8"], "node": "98736752b84631e1a2346a7932a4472799faa9c5", "parents": ["c8994eddb14ff45da8c173d0149921705ad3d293"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065630 - Enable the tracker count pref by default, but keep the feature gate off.  a=RyanVM\n\nThe tracker count only shows when both browser.urlbar.trackerCount.featureGate and browser.urlbar.trackerCount.enabled are true. Bug 2065206 disabled both by default. The Experimenter treatment flips only the featureGate (the Nimbus-controlled pref), so with enabled=false the count would still stay hidden until a user manually toggled it in Settings.\n\nDefault enabled to true so the treatment shows the count immediately once the gate is on. featureGate stays false, so the feature remains off for the general population, and enabled remains a plain user pref (not Nimbus-controlled), so users can still toggle it off/on in Settings.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320583\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320765\n", "files": ["browser/app/profile/firefox.js"], "git_node": "dd83c647f5f544a641e6a4fdb8800a0a9e82a39c", "git_parents": ["3b5be5277d9ac1584d0d3c323ecc103ef0a4c921"], "node": "c1fe6610c57380a159935d490dfd34983a668941", "parents": ["98736752b84631e1a2346a7932a4472799faa9c5"], "tags": []}], "date": 1787531036, "git_changesets": ["3b5be5277d9ac1584d0d3c323ecc103ef0a4c921", "dd83c647f5f544a641e6a4fdb8800a0a9e82a39c"], "user": "rvandermeulen@mozilla.com"}, "28180": {"changesets": [{"author": "Vincent Tunru \u003cgit@vincenttunru.com\u003e", "branch": "default", "desc": "Bug 2062876, Bug 2060155 - Update tracker count on page load panel opens.  a=RyanVM\n\nApparently `onContentBlockingEvent` only gets called when a new category of trackers (e.g. fingerprinters) gets blocked, so if multiple trackers in the same category get blocked, the tracker count in the address bar doesn't get updated anymore.\n\nTo compensate, this patch also manually recomputes the number of blocked trackers on navigation complete, and when the trust panel gets opened, to ensure the two are always aligned.\n\nAlso update browser_trust_panel.js for the new count semantics: test_update now counts the tracker already blocked on page load (1/2/3 instead of 0/1/2), and test_blocker_count_no_stale_overwrite is removed since its single-blocker stubbing no longer matches the new compute (to be re-implemented in a follow-up).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319818\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320757\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "browser/themes/shared/identity-block/identity-block.css"], "git_node": "381107ae23963f4cf38bbe8542ed00d3f7955158", "git_parents": ["dd83c647f5f544a641e6a4fdb8800a0a9e82a39c"], "node": "dc5523590172262a268837b6fef968a7f8de50c5", "parents": ["c1fe6610c57380a159935d490dfd34983a668941"], "tags": []}], "date": 1787531074, "git_changesets": ["381107ae23963f4cf38bbe8542ed00d3f7955158"], "user": "rvandermeulen@mozilla.com"}, "28181": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/feature/addons/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gn/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pa-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml"], "git_node": "747ad3daaed790f07b518f76a9adcf1f8c648417", "git_parents": ["381107ae23963f4cf38bbe8542ed00d3f7955158"], "node": "cca684eda07bcaaca2e8eb81f511c66b92cf7d9d", "parents": ["dc5523590172262a268837b6fef968a7f8de50c5"], "tags": []}], "date": 1787537777, "git_changesets": ["747ad3daaed790f07b518f76a9adcf1f8c648417"], "user": "ffxbld@lando.moz.tools"}, "28182": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2059333. Use explicit reinterprets in the NEON swizzle specializations so they build with GCC.  a=RyanVM\n\nBug 2052246 converted the NEON swizzle specializations to take and return\nxsimd::batch\u003cT, Arch\u003e but kept the bodies of the old hand written intrinsics,\nwhich mix vreinterpretq suffixes that no longer match the element type of the\nbatch they are given. On NEON each batch has exactly one register type, so\nbatch\u003cuint8_t, Arch\u003e is uint8x16_t, batch\u003cuint16_t, Arch\u003e is uint16x8_t and\nbatch\u003cuint32_t, Arch\u003e is uint32x4_t. clang enables lax vector conversions by\ndefault and silently bitcasts between same width integer vector types, so the\nmismatches compiled anyway. GCC has no such conversion and rejects all of them.\nThis cannot happen on x86 because every integer batch there maps to the same\n__m128i or __m256i, so a mismatched suffix is never a type error, and it did not\nshow up in CI because we build with clang on every platform.\n\nAdd the reinterprets needed to get to and from the register type each batch\nactually has. They are all bitcasts, so the generated code is identical.\n\nSwizzleVector_SIMD is constrained to xsimd::neon and so is only instantiated on\n32 bit ARM, which is why the aarch64 build did not report it. It has the same\nproblem, plus a conditional operator whose two arms end up as uint16x8_t and\nuint8x16_t, so fix it here too.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317694\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320781\n", "files": ["gfx/2d/SwizzleNEON.h"], "git_node": "e6cefd7c9189d2d17d52440ef23e9a9fb0462c92", "git_parents": ["747ad3daaed790f07b518f76a9adcf1f8c648417"], "node": "0326de02c990f32de911e8261418d7795c1c11c4", "parents": ["cca684eda07bcaaca2e8eb81f511c66b92cf7d9d"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2061106. Give arm a SwapRB8_SIMD specialization instead of a SwizzleVector_SIMD one, so GCC can resolve it.  a=RyanVM\n\nSwizzleVector_SIMD has an unconstrained generic definition in SwizzleGeneric.h\nand, until now, an overload in SwizzleNEON.h constrained to xsimd::neon.\nProcessRow_SIMD and Process_SIMD take the op as a deduced non type template\nparameter, so naming SwizzleVector_SIMD there forms the address of an overload\nset. With xsimd::neon64 the constraint is not satisfied and only the generic\ncandidate is left, but on 32 bit ARM both are viable. C++20 says the more\nconstrained candidate wins, and clang implements that, but GCC does not here and\ncalls the conversion ambiguous, so 32 bit ARM does not build. GCC 15 still\nbehaves this way.\n\nThe specialization is at the wrong level though. The reason arm wants it is that\nthere is no xsimd::swizzle vectorization, and xsimd::shuffle is used by\nSwapRB8_SIMD, not by SwizzleVector_SIMD. SSE2 already handles the same problem\nthe same way: it has no pshufb, so it specializes SwapRB8_SIMD and leaves\nSwizzleVector_SIMD alone.\n\nSpecialize SwapRB8_SIMD for xsimd::neon with the swap taken out of the old\nSwizzleVector_SIMD, and drop the SwizzleVector_SIMD specialization. SwapRB8_SIMD\nis only ever called, never named as a template argument, so GCC resolves it with\nordinary overload resolution, which it does implement. SwizzleGeneric.h does not\nneed to change at all.\n\nThe generated code is equivalent. On aarch64 it is identical. On armv7 the opcode\nhistogram is the same except that some of the selects come out as vbif or vbit\nrather than vbsl, 30 selects and 1592 instructions either way.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317695\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320782\n", "files": ["gfx/2d/SwizzleNEON.h"], "git_node": "521bca7829233f5bffdfb25834202648ffcbf5c2", "git_parents": ["e6cefd7c9189d2d17d52440ef23e9a9fb0462c92"], "node": "6891c2950e681c6ce118812c4c3595c25b4c7265", "parents": ["0326de02c990f32de911e8261418d7795c1c11c4"], "tags": []}], "date": 1787544366, "git_changesets": ["e6cefd7c9189d2d17d52440ef23e9a9fb0462c92", "521bca7829233f5bffdfb25834202648ffcbf5c2"], "user": "rvandermeulen@mozilla.com"}, "28183": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump\n\nach -\u003e 971f34bc941573601d249187677c21d947fb25e6\naf -\u003e 971f34bc941573601d249187677c21d947fb25e6\nan -\u003e 971f34bc941573601d249187677c21d947fb25e6\nar -\u003e 971f34bc941573601d249187677c21d947fb25e6\nast -\u003e 971f34bc941573601d249187677c21d947fb25e6\naz -\u003e 971f34bc941573601d249187677c21d947fb25e6\nbe -\u003e 971f34bc941573601d249187677c21d947fb25e6\nbg -\u003e 971f34bc941573601d249187677c21d947fb25e6\nbn -\u003e 971f34bc941573601d249187677c21d947fb25e6\nbr -\u003e 971f34bc941573601d249187677c21d947fb25e6\nbs -\u003e 971f34bc941573601d249187677c21d947fb25e6\nca -\u003e 971f34bc941573601d249187677c21d947fb25e6\nca-valencia -\u003e 971f34bc941573601d249187677c21d947fb25e6\ncak -\u003e 971f34bc941573601d249187677c21d947fb25e6\ncs -\u003e 971f34bc941573601d249187677c21d947fb25e6\ncy -\u003e 971f34bc941573601d249187677c21d947fb25e6\nda -\u003e 971f34bc941573601d249187677c21d947fb25e6\nde -\u003e 971f34bc941573601d249187677c21d947fb25e6\ndsb -\u003e 971f34bc941573601d249187677c21d947fb25e6\nel -\u003e 971f34bc9415736