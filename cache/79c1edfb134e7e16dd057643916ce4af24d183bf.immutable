t_parents": ["f37d0a50fcedbefe2cc7cc1a94001a318e2740b3"], "node": "563a6ae5def67f71dffc08f0db90ced0a335aeb2", "parents": ["5581efa1ae2c12a43ebbd3f81b9dc12f43e7c5be"], "tags": []}], "date": 1786957392, "git_changesets": ["f37d0a50fcedbefe2cc7cc1a94001a318e2740b3", "ca26a64b04c4fc260596705b4f15d16571b7c209"], "user": "ffxbld@lando.moz.tools"}, "28025": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044416 - Create backgroundtasks using backgroundtaskbuilder on windows msix packages. r=nrishel,browser-installer-reviewers,iholmes,cdupuis\" for causing bug 2063065.\n\nThis reverts commit 703db28f06cb90b5fc2fde1ad1b84829e5f4eb6c.\n", "files": ["Cargo.lock", "Cargo.toml", "browser/installer/windows/msix/AppxManifest.xml.in", "build/workspace-hack/Cargo.toml", "python/mozbuild/mozbuild/repackaging/msix.py", "toolkit/components/moz.build", "toolkit/components/taskscheduler/TaskScheduler.sys.mjs", "toolkit/components/taskscheduler/TaskSchedulerWinMSIXImpl.sys.mjs", "toolkit/components/taskscheduler/components.conf", "toolkit/components/taskscheduler/moz.build", "toolkit/components/taskscheduler/nsIWinBackgroundTaskRegistrar.idl", "toolkit/components/taskscheduler/rust/Cargo.toml", "toolkit/components/taskscheduler/rust/src/WinBackgroundTaskRegistrar.h", "toolkit/components/taskscheduler/rust/src/lib.rs", "toolkit/library/rust/gkrust-features.mozbuild", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs", "toolkit/modules/AppConstants.sys.mjs", "toolkit/modules/moz.build", "toolkit/moz.build", "toolkit/moz.configure", "toolkit/mozapps/msixcomserver-rust/Cargo.toml", "toolkit/mozapps/msixcomserver-rust/moz.build", "toolkit/mozapps/msixcomserver-rust/src/lib.rs", "toolkit/mozapps/msixcomserver/moz.build", "toolkit/mozapps/msixcomserver/msixcomserver.cpp", "toolkit/mozapps/msixcomserver/msixcomserver.def"], "git_node": "4f9d1ec829da3ea2aeb60ac9deb389078938fc15", "git_parents": ["ca26a64b04c4fc260596705b4f15d16571b7c209"], "node": "8ff1b429a90937642c20905c28281fc17397b033", "parents": ["563a6ae5def67f71dffc08f0db90ced0a335aeb2"], "tags": []}], "date": 1786976311, "git_changesets": ["4f9d1ec829da3ea2aeb60ac9deb389078938fc15"], "user": "rvandermeulen@mozilla.com"}, "28026": {"changesets": [{"author": "Artur Iunusov \u003caiunusov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058001 - validate quota object size  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314688\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319087\n", "files": ["dom/quota/RemoteQuotaObjectParent.cpp"], "git_node": "b091303afeaeac2bdfe557616ee8c82b72ef4d38", "git_parents": ["4f9d1ec829da3ea2aeb60ac9deb389078938fc15"], "node": "322b1e4dfb2d189c7e64ed8f35f09c84befa82c2", "parents": ["8ff1b429a90937642c20905c28281fc17397b033"], "tags": []}], "date": 1786976729, "git_changesets": ["b091303afeaeac2bdfe557616ee8c82b72ef4d38"], "user": "rvandermeulen@mozilla.com"}, "28027": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2060153 - Add the guard to `BrowserParent::RecvSynthesizeNativeMouseMove`  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316452\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318984\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "1d3ea39337dc5d487ddf5089e8a17130b7452551", "git_parents": ["b091303afeaeac2bdfe557616ee8c82b72ef4d38"], "node": "bb4e5396abeabaa9cde662b09f9c37448727d7d3", "parents": ["322b1e4dfb2d189c7e64ed8f35f09c84befa82c2"], "tags": []}], "date": 1786976761, "git_changesets": ["1d3ea39337dc5d487ddf5089e8a17130b7452551"], "user": "rvandermeulen@mozilla.com"}, "28028": {"changesets": [{"author": "tannal \u003cmtan@igalia.com\u003e", "branch": "default", "desc": "Bug 2062929 - Enable the mathml.a flag to fix the ci failures for Firefox beta  a=RyanVM\n\nThis enable the `mathml.a.element.enabled` flag for all WPT in the mathml/ directory.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318942\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319112\n", "files": ["testing/web-platform/meta/mathml/__dir__.ini"], "git_node": "4e16abda2e783f606513e747ff0c1400207c2435", "git_parents": ["1d3ea39337dc5d487ddf5089e8a17130b7452551"], "node": "ab1a6241f1b317ed5e988ba5ede76e4ea40accc9", "parents": ["bb4e5396abeabaa9cde662b09f9c37448727d7d3"], "tags": []}], "date": 1786976820, "git_changesets": ["4e16abda2e783f606513e747ff0c1400207c2435"], "user": "rvandermeulen@mozilla.com"}, "28029": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2060599 - Make `IMContextWrapper::OnKeyEvent` forget the previous commit string first  a=RyanVM\n\nIf the input context is set to not editable, the last committed grapheme\ncluster is never cleared. Therefore, the following `eKeyDown` and\n`eKeyPress` events after an editable element blurred will be initialized\nwith the committed grapheme cluster. The value is required only\nimmediately after the call of `OnKeyEvent`. Therefore, it should forget\nthe old value first. Then, the value becomes a void string and\n`nsGtkKeyUtils::DispatchKeyDownOrKeyUpEvent` will compute the typed\ncharacter from the `GdkEventKey` values.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318325\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318983\n", "files": ["widget/gtk/IMContextWrapper.cpp", "widget/gtk/nsGtkKeyUtils.cpp"], "git_node": "52700769a642cd7d941a97900e222d8c14ce3c8a", "git_parents": ["4e16abda2e783f606513e747ff0c1400207c2435"], "node": "1129fc997b6d44868166a90f0cf2ab05526da08b", "parents": ["ab1a6241f1b317ed5e988ba5ede76e4ea40accc9"], "tags": []}], "date": 1786976859, "git_changesets": ["52700769a642cd7d941a97900e222d8c14ce3c8a"], "user": "rvandermeulen@mozilla.com"}, "28030": {"changesets": [{"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062153 - [devtools] Fix RDM Device Settings modal. .  a=RyanVM\n\nWhen the dialog is displayed, span the RDM iframe to the bottom row so it overlaps the browser stack,\nas well as a potential bottom-docked DevTools toolbox.\nWe also need to adjust the z-index so it's displayed on top of the browser stack.\nFinally, we set the `accomodate-ua` class on the .browserContainer element, and\nuse it to udpate the `--rdm-toolbar-height` variable, that we then use to set\nthe grid row's height; this way the row is always the same height, even when\nwe open the dialog (if we wouldn't do that, the row would grow, and we wouldn't\nhave the same space between the RDM toolbar and the content page).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317419\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319049\n", "files": ["browser/themes/shared/browser-shared.css", "browser/themes/shared/tabbrowser/content-area.css", "devtools/client/responsive/responsive-browser.css", "devtools/client/responsive/ui.js"], "git_node": "36f9a88f8fde4b014c751c5439e439ca1d696b5e", "git_parents": ["52700769a642cd7d941a97900e222d8c14ce3c8a"], "node": "645eb5721e80170236a1a8482c9165375a06dde2", "parents": ["1129fc997b6d44868166a90f0cf2ab05526da08b"], "tags": ["DEVEDITION_155_0b1_BUILD2", "DEVEDITION_155_0b1_RELEASE", "FIREFOX-ANDROID_155_0b1_BUILD2", "FIREFOX-ANDROID_155_0b1_RELEASE", "FIREFOX_155_0b1_BUILD2", "FIREFOX_155_0b1_RELEASE"]}], "date": 1786976919, "git_changesets": ["36f9a88f8fde4b014c751c5439e439ca1d696b5e"], "user": "rvandermeulen@mozilla.com"}, "28031": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 645eb5721e80170236a1a8482c9165375a06dde2 with FIREFOX_155_0b1_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "19ff0ad6cb3933cb