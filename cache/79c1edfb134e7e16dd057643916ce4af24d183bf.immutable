47524ccfb6466b03bea10511f14218"], "tags": []}], "date": 1787685680, "git_changesets": ["373ab662c41aa242034a2386c352b0a0cc29d92b"], "user": "rvandermeulen@mozilla.com"}, "28221": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings mobile-merino-manifest ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321382\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/translations-models.json"], "git_node": "301f01fb7d2a7560421bb5eebe9688b694dd375c", "git_parents": ["373ab662c41aa242034a2386c352b0a0cc29d92b"], "node": "080ee0300a618abc1132adfac44699e9a0b8cab6", "parents": ["1aa596867fcbac66ee48b279b8fa6d0a366f36cd"], "tags": []}], "date": 1787690470, "git_changesets": ["301f01fb7d2a7560421bb5eebe9688b694dd375c"], "user": "rvandermeulen@mozilla.com"}, "28222": {"changesets": [{"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063357 - Give the IP Protection auth layer a shared error vocabulary.  a=RyanVM\n\nProviders each reported failures with their own ad-hoc strings. Add AUTH_ERRORS\nand a per-backend toError(), so that a status other than 200 always resolves\nwith an error the caller can act on.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319450\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321393\n", "files": ["toolkit/components/ipprotection/IPPAuthProvider.sys.mjs", "toolkit/components/ipprotection/enterprise/IPPEnterpriseAuthProvider.sys.mjs", "toolkit/components/ipprotection/fxa/GuardianClient.sys.mjs", "toolkit/components/ipprotection/fxa/IPPAndroidAuthProvider.sys.mjs", "toolkit/components/ipprotection/fxa/IPPFxaActivateAuthProvider.sys.mjs", "toolkit/components/ipprotection/gpi/IPPGpiAuthProvider.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_GuardianClient.js"], "git_node": "247f0661710be8c2605a264ce32745e7254414d4", "git_parents": ["301f01fb7d2a7560421bb5eebe9688b694dd375c"], "node": "99bdd816c4a743d7cf40cc0f294b7f046a4ff590", "parents": ["080ee0300a618abc1132adfac44699e9a0b8cab6"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063357 - Report a specific reason for every IP Protection activation failure.  a=RyanVM\n\nFailures that resolved with a bare {started: false} now name their cause, and\nthe auth provider's error is forwarded instead of being collapsed into\nPASS_UNAVAILABLE.\n\nAlso drops the Android special case for 451, which reported a region block as a\ncatastrophic failure.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319452\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321394\n", "files": ["toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/docs/Constants.md", "toolkit/components/ipprotection/tests/xpcshell/head.js", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "5e078b83994f34b704aaf4619cfd0866427b579b", "git_parents": ["247f0661710be8c2605a264ce32745e7254414d4"], "node": "f91def330220a11eb0725aaf96369366c2ac0cd5", "parents": ["99bdd816c4a743d7cf40cc0f294b7f046a4ff590"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063357 - Keep the IP Protection panel silent for errors it already shows.  a=RyanVM\n\nActivation now reports a reason when the proxy is paused or not ready, which\nthe panel must not turn into an error message on top of its own UI.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319453\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321395\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs"], "git_node": "978436cb40dafe36679f163b0b7e49c9f3a551a1", "git_parents": ["5e078b83994f34b704aaf4619cfd0866427b579b"], "node": "34644b80d384643684abc894c217988fce70392e", "parents": ["f91def330220a11eb0725aaf96369366c2ac0cd5"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063357 - Map IP Protection activation errors to typed GeckoView codes.  a=RyanVM\n\nCauses the proxy could not name, and every deactivate() and refreshUsage()\nfailure, arrived as ERROR_UNKNOWN. Add a code per cause and route all three\nqueries through the same mapper.\n\napi.txt is regenerated by ./mach gradle :geckoview:apiUpdateFileDebug.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319455\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321396\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/ipprotection/GeckoIPProtectionHandler.kt", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/IPProtectionControllerTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/IPProtectionController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md"], "git_node": "47452c5cdc9cf48b1976b1c8a832feee3715c54b", "git_parents": ["978436cb40dafe36679f163b0b7e49c9f3a551a1"], "node": "a06a3a01e7400aaae062f605e9d37625e242ff00", "parents": ["34644b80d384643684abc894c217988fce70392e"], "tags": []}], "date": 1787695740, "git_changesets": ["247f0661710be8c2605a264ce32745e7254414d4", "5e078b83994f34b704aaf4619cfd0866427b579b", "978436cb40dafe36679f163b0b7e49c9f3a551a1", "47452c5cdc9cf48b1976b1c8a832feee3715c54b"], "user": "rvandermeulen@mozilla.com"}, "28223": {"changesets": [{"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065190 - Warn when enrolling with a stale sign-in watcher  a=RyanVM\n\nIn order to call enroll() you must have been signed in, i've noticed not on every path the\nsignIn-Watcher was notified so adding some warning and a telemetry ping for that, in case.\n(The call will fail if the user is not really signed in, anyway)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320169\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321412\n", "files": ["toolkit/components/ipprotection/fxa/IPPFxaActivateAuthProvider.sys.mjs"], "git_node": "d82cdc707321b3e9e0ea9caf17d376896d9ed903", "git_parents": ["47452c5cdc9cf48b1976b1c8a832feee3715c54b"], "node": "349de9d6602a0e9152030164216cb38e87fb235b", "parents": ["a06a3a01e7400aaae062f605e9d37625e242ff00"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065190 - Announce signin before enrolling  a=RyanVM\n\nSo i have noticed that the ProxyManager activate() and enroll() functions\nare beeing called before announcing that the User has now signed in.\n\nGiven that we auto-activate after the successfull enrol() and enrolling implies\nthe user has to be signed in to succeed, let's make sure we tell toolkit that before actually enrolling.\n\nOtherwise, enrolling will succeed but the activation after that is guaranteed to fail.\nProxyManager, [[ https://searchfox.org/firefox-main/source/toolkit/components/ipprotection/IPPProxyManager.sys.mjs#341 | will check whether it was told about the signin ]] and fail if it thinks you are signed out.\n\nOn the 2nd activation it seems the\n```\nAccountStatus.TryAgain -\u003e {\n                            handler?.notifyAccountStatus(true)\n                        }\n```\nbranch is called first, at least at that time ProxyManager has noticed the sign-in.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320170\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321413\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt"], "git_node": "f804084816fc60a759f552696b1cf9577e959558", "git_parents": ["d82cdc707321b3e9e0ea9caf17d376896d9ed903"], "node": "dea7a9302fbbd79beb39f5b243de4a0fd6882ca4", "parents": ["349de9d6602a0e9152030164216cb38e87fb235b"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065190 - Add a test to assert signedIn == true is passed before attempting to enroll  a=RyanVM\n\nI was not sure if that behavior should have a test, given i could not found anything about ipprotectionfeature, so made this in an extra commit so i can abandon in case we don't need it :)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320171\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321414\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/IPProtectionFeatureTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/TestHelpers.kt"], "git_node": "c209de15e62016734922abeaa894cfab3dae5c7e", "git_parents": ["f804084816fc60a759f552696b1cf9577e959558"], "node": "6e9dde24e4eabbe0db549b87b11927262d18250b", "parents": ["dea7a9302fbbd79beb39f5b243de4a0fd6882ca4"], "tags": []}], "date": 1787701062, "git_changesets": ["d82cdc707321b3e9e0ea9caf17d376896d9ed903", "f804084816fc60a759f552696b1cf9577e959558", "c209de15e62016734922abeaa894cfab3dae5c7e"], "user": "rvandermeulen@mozilla.com"}, "28224": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065190 - Fix ktlint error. a=bustage\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/IPProtectionFeatureTest.kt"], "git_node": "f9c80759a495fec213d087857098d43d317b4bf3", "git_parents": ["c209de15e62016734922abeaa894cfab3dae5c7e"], "node": "ba0db163f7c107836bb8912165796380f4b46ff6", "parents": ["6e9dde24e4eabbe0db549b87b11927262d18250b"], "tags": []}], "date": 1787702439, "git_changesets": ["f9c80759a495fec213d087857098d43d317b4bf3"], "user": "rvandermeulen@mozilla.com"}, "28225": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-ja/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/findinpage/src/main/res/values-bo/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-bg/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-cak/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-cs/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-da/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-dsb/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-en-rGB/s