41c\nsr -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nsv-SE -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nta -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nte -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nth -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\ntl -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\ntr -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\ntrs -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nuk -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nur -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nuz -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nvi -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nwo -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nxh -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nzam -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nzh-CN -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\nzh-TW -\u003e 08fbe4508b73aeddf3f484bc8ed7e8530736f41c\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "0442638cfb5507afe67df15ebee4d1384d7037ec", "git_parents": ["3f4cf4c2ee6db003dc04a0889b6befd720aaa902"], "node": "cb0a75910382fab5c752c49b25fb7b5e38105a2e", "parents": ["685e2219b68972915fb5be824400584cef77e0e5"], "tags": []}], "date": 1786871007, "git_changesets": ["3f4cf4c2ee6db003dc04a0889b6befd720aaa902", "0442638cfb5507afe67df15ebee4d1384d7037ec"], "user": "ffxbld@lando.moz.tools"}, "28019": {"changesets": [{"author": "Xuan Chen \u003chenry.chen@oss.cipunited.com\u003e", "branch": "default", "desc": "Bug 2062941 - [mips64] Migrate backend to FaultingCodeRange.  a=RyanVM\n\nAnd also remove an obsolete workaround from Assembler-mips-shared.cpp.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317788\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318914\n", "files": ["js/src/jit/MacroAssembler.cpp", "js/src/jit/mips-shared/Assembler-mips-shared.cpp", "js/src/jit/mips-shared/Assembler-mips-shared.h", "js/src/jit/mips-shared/MacroAssembler-mips-shared.cpp", "js/src/jit/mips-shared/MacroAssembler-mips-shared.h", "js/src/jit/mips64/MacroAssembler-mips64.cpp", "js/src/jit/mips64/MacroAssembler-mips64.h"], "git_node": "a7ecf97121b15086a1170822cad4500b8f92335c", "git_parents": ["0442638cfb5507afe67df15ebee4d1384d7037ec"], "node": "1b906c69afcd8562758b42effcd56790050234ec", "parents": ["cb0a75910382fab5c752c49b25fb7b5e38105a2e"], "tags": []}, {"author": "Xuan Chen \u003chenry.chen@oss.cipunited.com\u003e", "branch": "default", "desc": "Bug 2062948 - [mips64] Unmerge shared WASM Atomic code from Loong64.  a=RyanVM\n\nWith the introduction of LAM_BH, MIPS64 and Loong64 can no longer share\ntheir PopAndAllocate implementations since MIPS always uses the LL/SC\npair.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318098\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318915\n", "files": ["js/src/wasm/WasmBCMemory.cpp"], "git_node": "56495fc26f6c3b92dd5070f474937ec4212729cb", "git_parents": ["a7ecf97121b15086a1170822cad4500b8f92335c"], "node": "bf8e5eed812ab2ca056d5df04a021c130222b5fc", "parents": ["1b906c69afcd8562758b42effcd56790050234ec"], "tags": []}], "date": 1786901271, "git_changesets": ["a7ecf97121b15086a1170822cad4500b8f92335c", "56495fc26f6c3b92dd5070f474937ec4212729cb"], "user": "rvandermeulen@mozilla.com"}, "28020": {"changesets": [{"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063312 - Fix WebRenderUserData key computation in nsDisplayStickyPosition::UpdateScrollData.  a=RyanVM\n\nThe WebRenderUserData key computed here needs to match the one\ncomputed in ClipManager which actually creates the WebRenderUserData,\nand that keys on the first continuation of the frame (since a sticky\nframe with multiple continuations creates a single sticky ASR with\na single WrAnimationProperty).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318860\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318902\n", "files": ["layout/painting/crashtests/2063312.html", "layout/painting/crashtests/crashtests.list", "layout/painting/nsDisplayList.cpp"], "git_node": "f6f51a397b331f67045e61de909243bb914b2b5d", "git_parents": ["56495fc26f6c3b92dd5070f474937ec4212729cb"], "node": "a540db6267cf75ee3f90b529d7e27f8290f85f97", "parents": ["bf8e5eed812ab2ca056d5df04a021c130222b5fc"], "tags": []}], "date": 1786901528, "git_changesets": ["f6f51a397b331f67045e61de909243bb914b2b5d"], "user": "rvandermeulen@mozilla.com"}, "28021": {"changesets": [{"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2061411 - Apply a scale transform to embedded-bitmap glyphs  a=RyanVM\n\nBitmap fonts rasterize with an identity glyph shape, so a transform's scale\nsurvives only as the scalar RasterizedGlyph::scale. The device glyph path from\nbug 2044211 multiplies that into the atlas footprint, so a scaled emoji paints\nat its untransformed size: too small scaling up, too big and clipped scaling\ndown (bug 2062234).\n\nWiden the bug 2055177 bitmap-strike gate from \"not an axis-aligned scale\" to\n\"not a pure translation\", so a scale joins rotation and skew on the local-raster\npath.\n\n2056856-bitmap-clip becomes scale(1.0)-only: wrench fakes a device pixel scale\nwith a root scale transform, so at other scales its glyphs are no longer\ndevice-grid-placed and it asserts nothing.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318258\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318958\n", "files": ["gfx/wr/webrender/src/prim_store/text_run.rs", "gfx/wr/wrench/reftests/text/2061411-bitmap-scale-ref.yaml", "gfx/wr/wrench/reftests/text/2061411-bitmap-scale.yaml", "gfx/wr/wrench/reftests/text/reftest.list"], "git_node": "6c91453dec093f18f458177fc74c01953cd173de", "git_parents": ["f6f51a397b331f67045e61de909243bb914b2b5d"], "node": "0422b97095f9f8a74fc5f246e7221d62638577b5", "parents": ["a540db6267cf75ee3f90b529d7e27f8290f85f97"], "tags": []}], "date": 1786912176, "git_changesets": ["6c91453dec093f18f458177fc74c01953cd173de"], "user": "rvandermeulen@mozilla.com"}, "28022": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings tld-suffixes mobile-experiments ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318960\n", "files": ["mobile/android/fenix/app/src/main/res/raw/initial_experiments.json", "netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/newtab-section-layouts.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "2bfecf36f7d59fefd4770a43549d9ab81330e222", "git_parents": ["6c91453dec093f18f458177fc74c01953cd173de"], "node": "2073f199a8d006a9cbd3bca9d57aff41a1b3b382", "parents": ["0422b97095f9f8a74fc5f246e7221d62638577b5"], "tags": []}], "date": 1786912203, "git_changesets": ["2bfecf36f7d59fefd4770a43549d9ab81330e222"], "user": "rvandermeulen@mozilla.com"}, "28023": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/fenix/app/src/main/res/values-ar/strings.xml", "mobile/android/fenix/app/src/main/res/values-es/strings.xml", "mobile/android/fenix/app/src/main/res/values-gn/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-iw/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-sat/strings.xml", "mobile/android/fenix/app/src/main/res/v