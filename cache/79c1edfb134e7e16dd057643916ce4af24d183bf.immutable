d4b909d4b3c06", "git_parents": ["4acbc10cb13900985486d389ea591bfedea8aba0"], "node": "e27976fb808d86886e81a1ec3bc9e1e062985f2f", "parents": ["362a4bbddd229a55fe8cd998816add2e71cb47f5"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062573 - Execute the create task form on Enter key in Smart Window  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318178\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320501\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_command_palette.js", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs"], "git_node": "cb3a39085bb1a0968ed2e7f2bbe6d3c13925f0e2", "git_parents": ["275dd92895c5f21ffd4a13c0812d4b909d4b3c06"], "node": "398a55cc49f129ad9dffba715903d9957657a151", "parents": ["e27976fb808d86886e81a1ec3bc9e1e062985f2f"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062597 - Enable to create the Create task in Smart Window full chat mode  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318181\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320502\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_command_palette.js", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs"], "git_node": "30adc25e2c54a60caae8136c940beb83c1dd39e9", "git_parents": ["cb3a39085bb1a0968ed2e7f2bbe6d3c13925f0e2"], "node": "8ef5e0acefd17a20fd683bd8ad466325fe6338c2", "parents": ["398a55cc49f129ad9dffba715903d9957657a151"], "tags": []}], "date": 1787409038, "git_changesets": ["275dd92895c5f21ffd4a13c0812d4b909d4b3c06", "cb3a39085bb1a0968ed2e7f2bbe6d3c13925f0e2", "30adc25e2c54a60caae8136c940beb83c1dd39e9"], "user": "rvandermeulen@mozilla.com"}, "28166": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054645 - Restrict DMABuf import to hardware GL rendering.  a=RyanVM\n\nDMABuf surfaces are only used with hardware GL rendering. Do not import\na DMABuf surface into a GL texture when software rendering is in use.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313682\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320660\n", "files": ["widget/gtk/DMABufSurface.cpp"], "git_node": "e47bb961da9cfd0a7446f6da77a152a64fc30738", "git_parents": ["30adc25e2c54a60caae8136c940beb83c1dd39e9"], "node": "6be5143e33b21a7d00e146a57c089bc47832044c", "parents": ["8ef5e0acefd17a20fd683bd8ad466325fe6338c2"], "tags": []}], "date": 1787409522, "git_changesets": ["e47bb961da9cfd0a7446f6da77a152a64fc30738"], "user": "rvandermeulen@mozilla.com"}, "28167": {"changesets": [{"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994400 - Fix shortcut panel hiding during IME composition  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285552\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320470\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/GenAIChild.sys.mjs", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "c28f06d91d5ccd27af7ea73530bec6a3c18f5688", "git_parents": ["e47bb961da9cfd0a7446f6da77a152a64fc30738"], "node": "f1845b6212d80f279832455be25c31f09ebf7adb", "parents": ["6be5143e33b21a7d00e146a57c089bc47832044c"], "tags": []}], "date": 1787410965, "git_changesets": ["c28f06d91d5ccd27af7ea73530bec6a3c18f5688"], "user": "rvandermeulen@mozilla.com"}, "28168": {"changesets": [{"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 1811277 - Clean up settings action telemetry test a=test-only DONTBUILD\n", "files": ["browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_engagement_selected_result.js"], "git_node": "387b6675afe9e6086ae7b291c27634949b380836", "git_parents": ["c28f06d91d5ccd27af7ea73530bec6a3c18f5688"], "node": "f4ee909c62b11bc0fab016ad2fb781febf1e11b2", "parents": ["f1845b6212d80f279832455be25c31f09ebf7adb"], "tags": []}], "date": 1787418313, "git_changesets": ["387b6675afe9e6086ae7b291c27634949b380836"], "user": "rvandermeulen@mozilla.com"}, "28169": {"changesets": [{"author": "Diego Escalante \u003cdescalante@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059168 - Keep the attr tainting value when turning computed values into declared values. .  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319276\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320677\n", "files": ["servo/components/style/custom_properties.rs", "servo/components/style/properties_and_values/value.rs", "testing/web-platform/tests/css/css-values/attr-security-transition-2.html"], "git_node": "8def7a3a649f2b65a2059cfcf6e42133ce2cd58c", "git_parents": ["387b6675afe9e6086ae7b291c27634949b380836"], "node": "e3c35e56b29b16a6bc59163ec7bd2ae0c140aaae", "parents": ["f4ee909c62b11bc0fab016ad2fb781febf1e11b2"], "tags": []}], "date": 1787418486, "git_changesets": ["8def7a3a649f2b65a2059cfcf6e42133ce2cd58c"], "user": "rvandermeulen@mozilla.com"}, "28170": {"changesets": [{"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 2064648 - Don't apply the file:// URI allowlist to worker process selection.  a=RyanVM\n\nIsolationBehaviorForURI() maps any origin in the file:// URI allowlist to\nIsolationBehavior::File so that a document which is permitted to link to local\nfiles renders in the file content process, in case it uses file:// sub-resources.\nThat allowlist is built from the capability.policy.* prefs which the\nLocalFileLinks enterprise policy writes, which intranet deployments use so that\nan internal portal (typically SharePoint) may link to files on a network share.\n\nThe rule was never meant to apply to workers. Before worker process selection\nmoved to ProcessIsolation in bug 1850589, E10SUtils.validatedWebRemoteType()\nguarded the equivalent check with !aIsWorker. Losing that guard was silent until\nbug 2050536 added ValidateBehaviorForWorker(), whose File case requires the\ncurrent remote type to be the file remote type. ServiceWorkerPrivate::Initialize()\nruns in the parent but passes the shared \"web\" remote type, so it now fails, and\nin release builds MOZ_ALWAYS_SUCCEEDS() lets construction continue with a\ndefault-constructed mRemoteWorkerData that crashes on the first intercepted fetch.\n\nThread an aIsWorker argument through IsolationBehaviorForURI() and skip the\nallowlist lookup for workers, restoring the pre-bug-1850589 behavior of selecting\nan ordinary web remote type. Genuine file: principals are unaffected; they are\nmatched earlier by scheme, which the new test also covers. Documents are\nunaffected as well, as browser_new_file_whitelisted_http_tab.js continues to\nverify.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320314\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320670\n", "files": ["dom/ipc/ProcessIsolation.cpp", "dom/ipc/gtest/ProcessIsolationTest.cpp"], "git_node": "f5c6e037f58a5f0fe0b1f0fa5c353e6caea14b15", "git_parents": ["8def7a3a649f2b65a2059cfcf6e42133ce2cd58c"], "node": "4623064d2f25b8ef13791088d241b8f9f69d06a5", "parents": ["e3c35e56b29b16a6bc59163ec7bd2ae0c140aaae"], "tags": []}, {"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 2064648 - Neutralize a ServiceWorkerPrivate whose Initialize() failed.  a=RyanVM\n\nInitialize() is called only from the constructor and has no retry, but in\nrelease builds MOZ_ALWAYS_SUCCEEDS() does not stop construction. A\nServiceWorkerPrivate therefore survives a failed Initialize() with a\ndefault-constructed mRemoteWorkerData whose OptionalServiceWorkerData union is\nstill T__None, and RefreshRemoteWorkerData() then fatally asserts in\nget_ServiceWorkerData() the first time the worker is asked to spawn.\n\nClear mInfo on any early return from Initialize(). That is the same state\nNoteDeadServiceWorkerInfo() already establishes, so the existing guards do the\nwork: SpawnWorkerIfNeeded() bails before touching mRemoteWorkerData, and since\nExecServiceWorkerOp() and SendFetchEventInternal() both go through it, every\noperation now fails cleanly. A failed fetch interception resets the interception\nand the request goes to the network, so the site loads without its service\nworker rather than taking down the parent process.\n\nSendPushEvent() and SendCookieChangeEvent() are the only entry points which\ndereference mInfo before delegating to SpawnWorkerIfNeeded(), so give them the\nsame null check SendFetchEvent() already has. Everything else which asserts\nmInfo requires a spawned worker or mControllerChild and so is unreachable.\n\nThe MOZ_DIAGNOSTIC_ASSERT in the constructor is deliberately kept, so an\nunexpected Initialize() failure remains loud on Nightly and Dev Edition.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320315\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320671\n", "files": ["dom/serviceworkers/ServiceWorkerPrivate.cpp"], "git_node": "6606ea1e1fa7fdf1221b659320fb35d7aa2b4ee3", "git_parents": ["f5c6e037f58a5f0fe0b1f0fa5c353e6caea14b15"], "node": "da224c87938089202d8309016ebca77d0effd631", "parents": ["4623064d2f25b8ef13791088d241b8f9f69d06a5"], "tags": []}], "date": 1787418529, "git_changesets": ["f5c6e037f58a5f0fe0b1f0fa5c353e6caea14b15", "6606ea1e1fa7fdf1221b659320fb35d7aa2b4ee3"], "user": "rvandermeulen@mozilla.com"}, "28171": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.c