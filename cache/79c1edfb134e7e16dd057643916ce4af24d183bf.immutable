0d19266f48", "git_parents": ["a51172c5ecd577b6fb9b6343804c858db1635f4c"], "node": "25f959bb7d4087509ee0aeb57c250697ccd1dd05", "parents": ["10b1cf1fc807d9060e9a73d875b48de5bb4cd42d"], "tags": []}], "date": 1786721273, "git_changesets": ["0b0b90f4d55942dab3ce615c0497b10d19266f48"], "user": "rvandermeulen@mozilla.com"}, "28004": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2042751 - Make `maybe_gather_combining()` in the collator fetch the CCC for non-starters in `upcoming`.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318082\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318664\n", "files": ["js/src/tests/non262/Intl/Collator/ccc.js", "third_party/rust/icu_collator/src/elements.rs"], "git_node": "9ec1ce05f7a27dfcc894a1d714c1c6d53f3fbe9b", "git_parents": ["0b0b90f4d55942dab3ce615c0497b10d19266f48"], "node": "346ab7d181c4ac30c7c454fe08526b2bcbeada39", "parents": ["25f959bb7d4087509ee0aeb57c250697ccd1dd05"], "tags": []}], "date": 1786721298, "git_changesets": ["9ec1ce05f7a27dfcc894a1d714c1c6d53f3fbe9b"], "user": "rvandermeulen@mozilla.com"}, "28005": {"changesets": [{"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2054619 - WebRTC backport: Video capture: validate SPA pod values to prevent OOB reads  a=RyanVM\n\nAdd bounds checks when reading SPA pod choice values in OnNodeParam\nand ParseFormat. Validate that the pod value size matches the expected\ntype using spa_pod_type_size() and that the number of choice items\nis sufficient before accessing the underlying arrays.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: a0253ec15b3d3072fb35d6be29ba9224c36f9dd7\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318394\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318723\n", "files": ["third_party/libwebrtc/modules/video_capture/linux/pipewire_session.cc", "third_party/libwebrtc/moz-patch-stack/a0253ec15b.no-op-cherry-pick-msg"], "git_node": "98c3f6612a95925460978088fad568c374229cc8", "git_parents": ["9ec1ce05f7a27dfcc894a1d714c1c6d53f3fbe9b"], "node": "e914c2ecd16ea95f308ce0451dbf64ee5c7c4d0c", "parents": ["346ab7d181c4ac30c7c454fe08526b2bcbeada39"], "tags": []}], "date": 1786721322, "git_changesets": ["98c3f6612a95925460978088fad568c374229cc8"], "user": "rvandermeulen@mozilla.com"}, "28006": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063115 - Fetch the full Gradle dependency cache for the geckoview-lite builds.  a=diannaS\n\nOn the release channel the geckoview-lite fat AAR build binds to GeckoView's api variant, which hides\nGeckoView's implementation dependencies, so the examples compile against the older androidx versions that\nappcompat asks for. The lite dependency cache never holds those: in the toolchain build the same project\ndependency binds to a runtime variant instead, GeckoView's own androidx.core wins the conflict, and nothing\never resolves the older ones. Which variant is chosen comes down to the capability GeckoView derives from\nits artifact id, and that only matches what a project dependency asks for on release, lite and fat AAR\ntogether, which is why nothing else sees this.\n\nThe full artifact does hold those versions, incidentally, because fenix and android-components resolve them\nin passes of their own. It is a superset of the lite artifact, so the lite builds lose nothing by fetching\nit, at the cost of roughly half a gigabyte more per fetch.\n\nThe lite toolchain keeps its definition, now unused, while we work out whether a second dependency cache\nearns its keep.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318725\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318817\n", "files": ["taskcluster/kinds/build-fat-aar/kind.yml", "taskcluster/kinds/build/android.yml"], "git_node": "925aa826195bb27cbcdf6956a95a12372040f7cd", "git_parents": ["98c3f6612a95925460978088fad568c374229cc8"], "node": "9b594f494a7136c1bcea90c599c765c78b6a6b10", "parents": ["e914c2ecd16ea95f308ce0451dbf64ee5c7c4d0c"], "tags": []}], "date": 1786737775, "git_changesets": ["925aa826195bb27cbcdf6956a95a12372040f7cd"], "user": "dsmith@mozilla.com"}, "28007": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update HSTS HPKP -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318825\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "bad5ffb4132ac4f0c355d1bd5a58841e0c19af02", "git_parents": ["925aa826195bb27cbcdf6956a95a12372040f7cd"], "node": "23c8fc4585c1cbc3982fe8b690a810a431d949f2", "parents": ["9b594f494a7136c1bcea90c599c765c78b6a6b10"], "tags": []}], "date": 1786738613, "git_changesets": ["bad5ffb4132ac4f0c355d1bd5a58841e0c19af02"], "user": "rvandermeulen@mozilla.com"}, "28008": {"changesets": [{"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2063334 - drop expected failures for some webrtc web platform tests on macOS  a=RyanVM\n\nThe same changes landed as a larger expectation update for the synchronization\nwith wpt upstream in bug 2062820.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318687\n", "files": ["testing/web-platform/meta/webrtc/RTCConfiguration-iceTransportPolicy.html.ini", "testing/web-platform/meta/webrtc/RTCDataChannel-bufferedAmount.html.ini", "testing/web-platform/meta/webrtc/RTCDataChannel-close.html.ini"], "git_node": "fcfd72afd736bb61d3c7fc1e356a067204f8a71e", "git_parents": ["bad5ffb4132ac4f0c355d1bd5a58841e0c19af02"], "node": "a88a4d2e1d759222d489b2db41066c5f3670a8cd", "parents": ["23c8fc4585c1cbc3982fe8b690a810a431d949f2"], "tags": []}], "date": 1786738667, "git_changesets": ["fcfd72afd736bb61d3c7fc1e356a067204f8a71e"], "user": "rvandermeulen@mozilla.com"}, "28009": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062496 - Exempt the stale drag test's mouse release from a11y checks.  a=RyanVM\n\nThe press has to happen while moving-tab mode leaves #nav-bar inert, so it lands\non the toolbox, while the release that balances it lands on the urlbar input,\nrecovery having ended moving-tab mode by then. The click goes to the two\ntargets' common ancestor, which is the toolbox, and a11y-checks flags it for\nhaving no interactive accessible.\n\nVerified with --enable-a11y-checks, where the file fails the way it does in CI\nwithout this and passes with it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318407\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318826\n", "files": ["browser/components/tabbrowser/test/browser/dragdrop/browser_stale_drag_session.js"], "git_node": "036c9644c2938a62f035f9d669b81e95ed7b43cc", "git_parents": ["fcfd72afd736bb61d3c7fc1e356a067204f8a71e"], "node": "c38c77f41d2af41164549c56b697eb25bd320413", "parents": ["a88a4d2e1d759222d489b2db41066c5f3670a8cd"], "tags": []}], "date": 1786738696, "git_changesets": ["036c9644c2938a62f035f9d669b81e95ed7b43cc"], "user": "rvandermeulen@mozilla.com"}, "28010": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 71302855625d5bfc0352ff18192d1cd0c6d95553 with FIREFOX-ANDROID_154_0_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "81d7d57a282bb4e92dbdd75af6b67dd19aca269d", "git_parents": ["318f11b66277b3929da2e5f348f1b0b385d6446f"], "node": "93cee7dd05fa20dbc6d60a766ec957b593020548", "parents": ["e1b753e28d153309e483e1058aff81899cf1becd"], "tags": []}], "date": 1786753015, "git_changesets": ["81d7d57a282bb4e92dbdd75af6b67dd19aca269d"], "user": "ffxbld@lando.moz.tools"}, "28011": {"changesets": [{"author": "Release Engi