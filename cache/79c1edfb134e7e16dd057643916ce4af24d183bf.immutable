esets": ["68f678ef0f9963d73e019b1667331af61436e54b"], "user": "ffxbld@lando.moz.tools"}, "28038": {"changesets": [{"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063599 - Only enable ML address form field detection on pre-release channels.  a=RyanVM\n\nTelemetry on 154 shows a regression in credit card expiry date detection\nsince ML field detection was enabled for all channels.\n\nGate the extensions.formautofill.useml default on the update channel so it\nstays enabled on Nightly, Dev Edition and Beta, and is disabled on Release\nand ESR.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318986\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319145\n", "files": ["modules/libpref/init/all.js"], "git_node": "d977cb37d5498c5cf3b689e79f6dbdbcdf4045e4", "git_parents": ["666a3782cbdaaa9b90231328bd586bfc31ab9ad9"], "node": "31085f08b65df89c9851031a53567704db58be1e", "parents": ["39116da7b0bd6227f1fb6696c7955baf4ce936f8"], "tags": []}], "date": 1787010101, "git_changesets": ["d977cb37d5498c5cf3b689e79f6dbdbcdf4045e4"], "user": "rvandermeulen@mozilla.com"}, "28039": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2056118 - Step back in numeric mode if identical prefix ends with digit but only one of left or right starts with digit.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318712\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319004\n", "files": ["js/src/tests/non262/Intl/Collator/numeric.js", "third_party/rust/icu_collator/src/comparison.rs"], "git_node": "6452be750f2bf876f675f621bc4bd7a2aef59833", "git_parents": ["d977cb37d5498c5cf3b689e79f6dbdbcdf4045e4"], "node": "6818ea60c77fec6a3921cfbdc5767bb0961cebdf", "parents": ["31085f08b65df89c9851031a53567704db58be1e"], "tags": []}], "date": 1787010133, "git_changesets": ["6452be750f2bf876f675f621bc4bd7a2aef59833"], "user": "rvandermeulen@mozilla.com"}, "28040": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2059047 - Reset looked_ahead when resetting drain_from_upcoming.  a=RyanVM\n\nUpstream issue: https://github.com/unicode-org/icu4x/issues/8296\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318684\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319007\n", "files": ["js/src/tests/non262/Intl/Collator/contraction.js", "third_party/rust/icu_collator/src/elements.rs"], "git_node": "e55411619b4af7c55afef573644f19baa98f3719", "git_parents": ["6452be750f2bf876f675f621bc4bd7a2aef59833"], "node": "a921e2ab1ac4d14171c32e6d3bb91c84197e0fe7", "parents": ["6818ea60c77fec6a3921cfbdc5767bb0961cebdf"], "tags": []}], "date": 1787010182, "git_changesets": ["e55411619b4af7c55afef573644f19baa98f3719"], "user": "rvandermeulen@mozilla.com"}, "28041": {"changesets": [{"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2058661 - Clear the drag source window's GdkDragContext pointer synchronously. r=stransky a=RyanVM\n\ngtk_drag_begin_with_coordinates() returns a borrowed context: GtkDragSourceInfo\nholds the only reference, and gtk_drag_source_info_destroy() drops it as soon as\nthe drag-end handler returns. nsWindow::mSourceDragContext was cleared only from\nan async runnable (EndDragSessionMainThread -\u003e EndDragSessionImpl), so between\nGTK's unref and that runnable the pointer dangled, and nsWindow::OnUnmap() calls\ngtk_drag_cancel() on it. Content can land an unmap in that window with a\nwindow.close() task queued before the drag ended.\n\nEndDragSessionImpl keeps its own clear for drags torn down without a drag-end.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315509\n\n(cherry picked from commit 39b3d67e87f8061fe04f97007e0ef23f50ffc06e)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319277\n", "files": ["widget/gtk/nsDragSessionSource.cpp"], "git_node": "468b4be395baf85e496f29248655ed25a734008a", "git_parents": ["e55411619b4af7c55afef573644f19baa98f3719"], "node": "2b87be0ecb8cbe13d3e609711736d2cabbc21392", "parents": ["a921e2ab1ac4d14171c32e6d3bb91c84197e0fe7"], "tags": []}], "date": 1787010260, "git_changesets": ["468b4be395baf85e496f29248655ed25a734008a"], "user": "rvandermeulen@mozilla.com"}, "28042": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059144 - Part 1: Validate principal and scope for push  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315347\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319076\n", "files": ["dom/base/MessageManagerCallback.h", "dom/base/ProcessMessageManager.cpp", "dom/base/ProcessMessageManager.h", "dom/chrome-webidl/MessageManager.webidl", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/InProcessImpl.cpp", "dom/ipc/nsIDOMProcessParent.idl", "dom/push/PushComponents.sys.mjs", "dom/push/test/xpcshell/test_service.js", "dom/push/test/xpcshell/test_service_child.js", "dom/push/test/xpcshell/test_service_parent.js", "dom/push/test/xpcshell/xpcshell.toml", "testing/web-platform/mozilla/meta/push-api/principal.https.window.js.ini", "testing/web-platform/mozilla/tests/push-api/principal.https.window.js"], "git_node": "205a7a7cc398508090369a39e4b2060093b9e598", "git_parents": ["468b4be395baf85e496f29248655ed25a734008a"], "node": "6c3a50fcf97952481dd8c884cbededfe8a09bd24", "parents": ["2b87be0ecb8cbe13d3e609711736d2cabbc21392"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059144 - Part 2: Add ChromeUtils.validateServiceWorkerScope  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316038\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319077\n", "files": ["dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/chrome-webidl/ChromeUtils.webidl", "dom/push/PushComponents.sys.mjs", "dom/serviceworkers/ServiceWorkerUtils.cpp", "dom/serviceworkers/ServiceWorkerUtils.h", "testing/web-platform/mozilla/tests/push-api/principal.https.window.js"], "git_node": "0f9c7eb7223d9d3dbe0a4955a680119054f74df4", "git_parents": ["205a7a7cc398508090369a39e4b2060093b9e598"], "node": "a42497e7d25a7fc03cdf7335279b392f864d0535", "parents": ["6c3a50fcf97952481dd8c884cbededfe8a09bd24"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059144 - Part 3: Add nsIPrincipal::IsAddonPrincipal  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317509\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319078\n", "files": ["caps/BasePrincipal.cpp", "caps/BasePrincipal.h", "caps/nsIPrincipal.idl", "dom/serviceworkers/ServiceWorkerUtils.cpp"], "git_node": "fa551ccef482e8a8b0960c267b60dc51381c6417", "git_parents": ["0f9c7eb7223d9d3dbe0a4955a680119054f74df4"], "node": "e4aad1a2e4450b7d50cebce1627a0aea1cc05a2a", "parents": ["a42497e7d25a7fc03cdf7335279b392f864d0535"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2057382 - Part 1: Check whether scope is malformed  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314657\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319079\n", "files": ["dom/notification/NotificationHandler.cpp", "ipc/glue/BackgroundParentImpl.cpp", "testing/web-platform/mozilla/tests/notifications/simulate-click-handler.sub.https.window.js"], "git_node": "a43dc8e8fb850d7230c39368b8f3970326db0ba3", "git_parents": ["fa551ccef482e8a8b0960c267b60dc51381c6417"], "node": "e067048178ac62c7c81c72a1ae49b77d79a7af4c", "parents": ["e4aad1a2e4450b7d50cebce1627a0aea1cc05a2a"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2057382 - Part 2: Adjust scope validation  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318753\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319080\n", "files": ["dom/notification/NotificationHandler.cpp", "dom/notification/NotificationParent.cpp"], "git_node": "8f487b4de69f6ef1dbc2ce8047a645e946f4acb0", "git_parents": ["a43dc8e8fb850d7230c39368b8f3970326db0ba3"], "node": "f46d510c37593d10f710d9e1ed3b6536e912e237", "parents": ["e067048178ac62c7c81c72a1ae49b77d79a7af4c"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2057382, 2059144: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/push/PushComponents.sys.mjs"], "git_node": "50605cb0992dc74e82d14be6386a5ca2aec82570", "git_parents": ["8f487b4de69f6ef1dbc2ce8047a645e946f4acb0"], "node": "37bb203ccaf152545a1632d6ee513be05a12d87f", "parents": ["f46d510c37593d10f710d9e1ed3b6536e912e237"], "tags": []}], "date": 1787010421, "git_changesets": ["205a7a7cc398508090369a39e4b2060093b9e598", "0f9c7eb7223d9d3dbe0a4955a680119054f74df4", "fa551ccef482e8a8b0960c267b60dc51381c6417", "a43dc8e8fb850d7230c39368b8f3970326db0ba3", "8f487b4de69f6ef1dbc2ce8047a645e946f4acb0", "50605cb0992dc74e82d14be6386a5ca2aec82570"], "user": "rvandermeulen@mozilla.com"}, "28043": {"changesets": [{"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061846 - Debounce vpn toggle  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318804\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319201\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/ui/Modifier.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt"], "git_node": "c983adec1acea2e613ae2f3c1388c9ff9257ce7d", "gi