te-element/template-for/template-for-replace.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-sanitization.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-script-children.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-script-eval.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-script-replace.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-shadow-nested.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-shadow-root.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-shadow.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-style-in-head.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-style.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-supersedes-invalid-shadowrootmode.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-title.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-unclosed-content.html.ini"], "git_node": "a4e6b596a30e077f552fed1cccb8d4f6444360c2", "git_parents": ["528bb8501a42589a7dac8cb1664f5f9ea7388b36"], "node": "7ec7b30faeb9f4cd3a3f7c870d00f644e17c4b61", "parents": ["58082558c26908845ff8e1d0d89904bb0bb56300"], "tags": []}, {"author": "Derek Schuff \u003cdschuff@chromium.org\u003e", "branch": "default", "desc": "Bug 2064770 [wpt PR 62058] - Wasm Proposals: Install JS files for proposal tests, a=testonly\n\nAutomatic update from web-platform-tests\nWasm Proposals: Install JS files for proposal tests (#62058)\n\nHTML tests converted from wasm come with a JS file for each. The updater script\nwas failing to copy them into the wpt dir along with the HTMLs. This PR\ncopies the per-test JS files along with the per-repo JS utility files (but\nnot testharness.js; we use the harness built into wpt).\n\nAlso drop the stack-switching proposal for now, as it needs a merge\nfrom the upstream spec before it wil work correctly. Instead use\nwide-arithmetic, a phase 4 proposal with an up-to-date spec repo.\n--\n\nwpt-commits: e2e97cb5437e2d816914003baa7fd6e23c401bab\nwpt-pr: 62058\n", "files": ["testing/web-platform/tests/.github/workflows/update-wasm-tests.yml", "testing/web-platform/tests/wasm/proposals.json", "testing/web-platform/tests/wasm/tools/update-proposals.py"], "git_node": "ce7754220867696d4a47602562528db4835c2547", "git_parents": ["a4e6b596a30e077f552fed1cccb8d4f6444360c2"], "node": "c4c31b053d45eabbfbcf8d3402814ffc34b54cf6", "parents": ["7ec7b30faeb9f4cd3a3f7c870d00f644e17c4b61"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2053620 [wpt PR 61145] - [animation-trigger] Deflake scroll-animations/animation-trigger WPT tests, a=testonly\n\nAutomatic update from web-platform-tests\n[animation-trigger] Deflake scroll-animations/animation-trigger WPT tests (#61145)\n\nThe `animation-trigger-*.html` web platform tests were flaky due to race\nconditions with scrolling events and unresolved promises. Example\nfailure:\nhttps://ci.chromium.org/ui/p/chromium/builders/ci/Linux%20Tests%20(dbg)(1)/132298/overview\n\nThis CL fixes the flakiness by:\n1. Updating runAndWaitForFrameUpdate in testcommon.js to correctly await\n   the inner callbacks, ensuring that the test runner waits for promises\n   (such as scrollend) when they are returned by the callback.\n2. Returning early in setScrollTop if the scroller is already at the\n   target position, preventing timeouts waiting for a scrollend event\n   that will never fire.\n3. Updating the reset() functions in the tentative tests to return the\n   scroll reset promise, ensuring that the test runner awaits it before\n   proceeding with the test assertions.\n\nBug: 390314945\nChange-Id: I7e3a520d57551fe6b5ffbec3087de2893b84cdd8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8027206\nReviewed-by: David A \u003cawogbemila@chromium.org\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCommit-Queue: Yao Xiao \u003cyaoxia@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1659043}\n\nCo-authored-by: Yao Xiao \u003cyaoxia@chromium.org\u003e\n--\n\nwpt-commits: 2de43edf07ce217f2287fbddd87e7d3d427beff0\nwpt-pr: 61145\n", "files": ["testing/web-platform/tests/scroll-animations/animation-trigger/animation-trigger-play-forwards-backwards.tentative.html", "testing/web-platform/tests/scroll-animations/animation-trigger/animation-trigger-play.tentative.html", "testing/web-platform/tests/scroll-animations/animation-trigger/animation-trigger-replay.tentative.html", "testing/web-platform/tests/scroll-animations/animation-trigger/support/support.js", "testing/web-platform/tests/web-animations/testcommon.js"], "git_node": "275556c72c4750a24956e7bbe0e79ecdb60f3201", "git_parents": ["ce7754220867696d4a47602562528db4835c2547"], "node": "d5d55be9a457516c51fc89be026a2cfd1b2b2f47", "parents": ["c4c31b053d45eabbfbcf8d3402814ffc34b54cf6"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053620 [wpt PR 61145] - Update wpt metadata, a=testonly\n\nwpt-pr: 61145\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/web-animations/timing-model/animations/document-timeline-animation.html.ini"], "git_node": "e292aad6fdf94c211383a0f1db886b579a2fc8fa", "git_parents": ["275556c72c4750a24956e7bbe0e79ecdb60f3201"], "node": "067bd7c667e20ec4ba0ce1932ab404b883f389de", "parents": ["d5d55be9a457516c51fc89be026a2cfd1b2b2f47"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2056755 [wpt PR 61470] - Fix access to storage from out-of-process shared workers., a=testonly\n\nAutomatic update from web-platform-tests\nFix access to storage from out-of-process shared workers. (#61470)\n\nhttps://crrev.com/c/7894258 added a ChildProcessSecurityPolicy check\nwhich had the unintended consequence of blocking certain shared workers\nfrom accessing OPFS. This was because shared workers do not commit their\norigin and if the worker is the only thing in that process, it will have\nno committed origin.\n\nThis adds a call to AddCommittedOrigin to SharedWorkerServiceImpl::CreateWorker.\n\nIt also adds SharedWorker capabilities to Remote Context Helper.\n\nTAG=agy\nCONV=340ac3cb-b9c1-4e26-8f74-1dc0aceec103\n\nFixed: 517484284,528332884\nChange-Id: Ic5787f7278ccd161275ab32585ac98a516fda16f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8097788\nReviewed-by: Alex Moshchuk \u003calexmos@chromium.org\u003e\nCommit-Queue: Fergal Daly \u003cfergal@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1666063}\n\nCo-authored-by: Fergal Daly \u003cfergal@chromium.org\u003e\n--\n\nwpt-commits: f07c4ff475cbb5fe0f45e2dc76501581d5b6cd96\nwpt-pr: 61470\n", "files": ["testing/web-platform/tests/fs/opfs-shared-worker-coep.https.window.js", "testing/web-platform/tests/html/browsers/browsing-the-web/remote-context-helper-tests/addSharedWorker.window.js", "testing/web-platform/tests/html/browsers/browsing-the-web/remote-context-helper-tests/addSharedWorkerNull.window.js", "testing/web-platform/tests/html/browsers/browsing-the-web/remote-context-helper/resources/remote-context-helper.js"], "git_node": "49b1ce0de79bcd35875f781ecfba64ac01610e89", "git_parents": ["e292aad6fdf94c211383a0f1db886b579a2fc8fa"], "node": "cd7581403fd20be5a17bc00a04d76b49ec66f5db", "parents": ["067bd7c667e20ec4ba0ce1932ab404b883f389de"], "tags": []}, {"author": "David Awogbemila \u003cawogbemila@chromium.org\u003e", "branch": "default", "desc": "Bug 2064856 [wpt PR 62057] - Do not fallback to DocumentTimeline for timeline-trigger-source: none, a=testonly\n\nAutomatic update from web-platform-tests\nDo not fallback to DocumentTimeline for timeline-trigger-source: none\n\nWhen timeline-trigger-source was set to 'none' (or an unresolved named\ntimeline), ComputeTimeline returned nullptr. However,\nCSSAnimations::ComputeTimelineTrigger had a fallback that replaced a\nnull timeline with the document timeline. Because\ntimeline-trigger-source: auto resolves to the document timeline, this\ncaused 'none' to behave identically to 'auto', tripping immediately.\n\nNote: this patch adds parsing tests but there is no actual change to the parsing behavior.\nBug: 546631269\nChange-Id: Id7598760b0e157f33dac2f406ae82daf6ecadf97\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8254586\nCommit-Queue: David A \u003cawogbemila@chromium.org\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1682398}\n\n--\n\nwpt-commits: 06485c5c599a7ccaddb178fd46ffce0895b51ca1\nwpt-pr: 62057\n", "files": ["testing/web-platform/tests/scroll-animations/animation-trigger/parsing/timeline-trigger-shorthand.tentative.html", "testing/web-platform/tests/scroll-animations/animation-trigger/timeline-trigger-none-auto.tentative.html"], "git_node": "e9780e40b9b5f72949c53db530060d7124762cca", "git_parents": ["49b1ce0de79bcd35875f781ecfba64ac01610e89"], "node": "d5f31f5d3fa619e93b017f70426f1b1a7c3f5b4a", "parents": ["cd7581403fd20be5a17bc00a04d76b49ec66f5db"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064856 [wpt PR 62057] - Update wpt metadata, a=testonly\n\nwpt-pr: 62057\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/scroll-animations/animation-trigger/parsing/timeline-trigger-shorthand.tentative.html.ini", "testing/web-platform/meta/scroll-animations/animation-trigger/timeline-trigger-none-auto.tentative.html.ini"], "git_node": "e3776c24262d70ae47db1545ae3fa548771411c2", "git_parents": ["e9780e40b9b5f72949c53db530060d7124762cca"], "node": "090544be649a1fbe65263d63179318bdd45efdce", "parents": ["d5f31f5d3fa619e93b017f70426f1b1a7c3f5b4a"], "tags": []}, {"author": "Shubham Gupta \u003cshubhamg13.work@gmail.com\u003e", "branch": "default", "desc": "Bug 2064685 [wpt PR 62041] - layout: Implement bits of mark_paint_timing, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate Expectations\n\nSigned-off-by: Shubham Gupta \u003cshubhamg13.work@gmail.com\u003e\n\n--\n\nwpt-commits: 6d04ba0c8fe40387c263a40f9ee7c2c5a9499f3f\nwpt-pr: 62041\n", "files": ["testing/web-platform/tests/largest-contentful-paint/initially-invisible-images.html"], "git_node": "6b276c053c41f41414c43ea506e894aa1d342cd7", "git_parents": ["e3776c24262d70ae47db1545ae3fa548771411c2"], "node": "f678eda7fc0ab22aa53b38e1ec2ef18394c3789e", "parents": ["090544be649a1fbe65263d63179318bdd45efdce"], "tags": []}, {"author": "Luke Warlow \u003clwarlow@igalia.com\u003e", "branch": "default", "desc": "Bug 2064889 [wpt PR 62065] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320556, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320556 (#62065)\n--\n\nwpt-commits: b4f204893431214b6abe15e41934413c68098ae2\nwpt-pr: 62065\n", "files": ["testing/web-platform/tests/dom/nodes/moveBefore/select-option-optgroup.html"], "git_node": "618dfed6907c8bd028c3d3b4332e56f04d8ba453", "git_parents": ["6b276c053c41f41414c43ea506e894aa1d342cd7"], "node": "cbfd7fedbb025ab2b03bb2e592074701105ef8c2", "parents": ["f678eda7fc0ab22aa53b38e1ec2ef18394c3789e"], "tags": []}, {"author": "Celeste Pan \u003ccelestepan@microsoft.com\u003e", "branch": "default", "desc": "Bug 2064599 [wpt PR 62031] - [Masonry] Use grid-axis content box size to resolve percentages in flow-tolerance, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Use grid-axis content box size to resolve percentages in flow-tolerance\n\nWe were previously using the stacking axis size of the content box to\nresolve percentages for the flow-tolerance feature, but per spec [1],\nflow-tolerance percentages should resolve \"relative to the grid-axis\ncontent box size of the grid lanes container\".\n\n[1] https://drafts.csswg.org/css-grid-3/#placement-tolerance\n\nBug: 343257585, 517590298\nChange-Id: I68c7c9c42f80694e7b28a3602cb2882519db958f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8252957\nReviewed-by: Yanling Wang \u003cyanlingwang@microsoft.com\u003e\nReviewed-by: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCommit-Queue: Celeste Pan \u003ccelestepan@microsoft.com\u003e\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1682431}\n\n--\n\nwpt-commits: a33cf8b9743aba44088de58e17fbc4c3b207ef1e\nwpt-pr: 62031\n", "files": ["testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-column-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-column-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-intrinsic-column-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-intrinsic-column-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-intrinsic-row-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-intrinsic-row-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-row-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-row-001.html"], "git_node": "bd6e3ae7ceaf7775a535170b8e9bc7637ff0da5c", "git_parents": ["618dfed6907c8bd028c3d3b4332e56f04d8ba453"], "node": "1174074e602b6c0863463d050e608351da420f2d", "parents": ["cbfd7fedbb025ab2b03bb2e592074701105ef8c2"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064599 [wpt PR 62031] - Update wpt metadata, a=testonly\n\nwpt-pr: 62031\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-column-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-intrinsic-column-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-intrinsic-row-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/flow-tolerance/flow-tolerance-percentage-row-001.html.ini"], "git_node": "2fe0439b14c5606c73151bcf4fc456dddab625a7", "git_parents": ["bd6e3ae7ceaf7775a535170b8e9bc7637ff0da5c"], "node": "e10e78a27a62151416dd43bef43eb86d5bb35d64", "parents": ["1174074e602b6c0863463d050e608351da420f2d"], "tags": []}, {"author": "Javier Contreras Tenorio \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2064905 [wpt PR 62068] - [masonry] Make grid-axis rules be blocked by spanners, a=testonly\n\nAutomatic update from web-platform-tests\n[masonry] Make grid-axis rules be blocked by spanners\n\nRecord each lane entry's unique placement ID during the existing\n`CrossGap` walk. For each `MainGap`, merge the sorted `CrossGap` runs\nfrom its adjacent lanes and compare the entry IDs for every resulting\nsegment.\n\nWe store the blocked ranges using `GapSegmentStateRanges`, the same way\nthat the other containers do this. Then we reuse the same linear segment\nwalker during paint to generate intersection offsets.\n\nSome WPT ref files required changes, due to recent resolutions reached\nby the CSSWG https://github.com/w3c/csswg-drafts/issues/14153 to reflect\nper-lane stacking-axis gutters.\n\nWe add more WPT coverage including for rule-break: intersection and\nnone.\n\nWe are explicitly deferring `overlap-join` grid lanes implementation\nas a follow up\n\nBug: 343257585\nChange-Id: Ia2d917fb4d1ff109564a50dc60e687797ec9e301\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8261939\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1682509}\n\n--\n\nwpt-commits: 42160a82d609269df70fece4f63ba0815fd90d97\nwpt-pr: 62068\n", "files": ["testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-006-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-007-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-014-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-017-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-018-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-019-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-022-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-023-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-028-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-029-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-033-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-037-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-039-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-039.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-040-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-040.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-004-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-005-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-007-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-007.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-010-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-022-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-022.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-023-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-023.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-024-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-024.html"], "git_node": "5e1bacefc7ca8397b280027d26b80827d8fd9d25", "git_parents": ["2fe0439b14c5606c73151bcf4fc456dddab625a7"], "node": "c8ed820842e0346b2cd5daf209b73427248c98e1", "parents": ["e10e78a27a62151416dd43bef43eb86d5bb35d64"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064905 [wpt PR 62068] - Update wpt metadata, a=testonly\n\nwpt-pr: 62068\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-039.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-040.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-022.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-023.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-024.html.ini"], "git_node": "8548897f4ca42ce19ad188e2fe3a4c3f8d003f48", "git_parents": ["5e1bacefc7ca8397b280027d26b80827d8fd9d25"], "node": "eb02cadfaca210d72284b9b56eba397ab1212896", "parents": ["c8ed820842e0346b2cd5daf209b73427248c98e1"], "tags": []}, {"author": "Jochen K\u00fchner \u003cjochen.kuehner@gmx.de\u003e", "branch": "default", "desc": "Bug 2064928 [wpt PR 62071] - Use layout geometry for GeometryUtils coordinate mapping, a=testonly\n\nAutomatic update from web-platform-tests\nUse layout geometry for GeometryUtils coordinate mapping\n\nGeometryMapper relies on retained paint property trees. A transform-only\nstyle change can leave a direct transform update pending without marking\nthose trees dirty, allowing GeometryUtils to return stale coordinates.\n\nDo not update paint-property state from a synchronous geometry query.\nUse LayoutObject coordinate mapping for all conversions instead. Keep\ngeometry reads on layout-derived data that has already been made\ncurrent. This also removes the separate eligibility and fragmentation\nchecks needed by the retained-property fast path.\n\nAn official-build interleaved geometry benchmark shows no measurable\nregression after removing GeometryMapper. Add WPT coverage for a\ntransform update made after prepaint.\n\nBug: 427918516\n\nChange-Id: I7724c2137258f0774b25b352ff235f5e09907301\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8224423\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1682688}\n\n--\n\nwpt-commits: 389fb4a891fb53e493c1c81fa58bd7136d358e21\nwpt-pr: 62071\n", "files": ["testing/web-platform/tests/css/cssom-view/cssom-geometryutils-lifecycle.html"], "git_node": "3618630b127a937f8fab7b8987cb879f2af1d432", "git_parents": ["8548897f4ca42ce19ad188e2fe3a4c3f8d003f48"], "node": "a5ce92d5000e9dc42f5fba0dc671cd0a2f83a6be", "parents": ["eb02cadfaca210d72284b9b56eba397ab1212896"], "tags": []}, {"author": "Wei Wang \u003cwei4.wang@intel.com\u003e", "branch": "default", "desc": "Bug 2064894 [wpt PR 62066] - [WebNN] Reject conv2d/pool2d/convTranspose2d strides, dilations and filters that exceed the usable extent, a=testonly\n\nAutomatic update from web-platform-tests\n[WebNN] Reject conv2d/pool2d/convTranspose2d strides, dilations and\nfilters that exceed the usable extent\n\nconv2d, pooling and convTranspose2d take strides and dilations as\nunsigned long and the only validation was a != 0 check on each value.\nWhen the input spatial size and the filter/window are 1x1, the derived\noutput size collapses to 1 for any stride/dilation, so an arbitrarily\nlarge value survives all output-size math and is serialized\nverbatim into the backend graph, even though it is semantically\nequivalent to a much smaller value and cannot legitimately arise.\n\nThis CL adds an upper bound in the output-size validation:\n- Forward conv2d and pool2d: reject a stride or dilation larger than\n  the padded input spatial size. Padding is included so that valid\n  padded windows are not rejected. A value larger than the padded\n  input can place the window at most once, so it is always equivalent\n  to a smaller value.\n- Forward conv2d and pool2d: reject an effective (dilated) filter\n  window larger than the padded input spatial size. when the\n  effective filter size exceeds the padded input, the window can\n  never be fully placed, so the operation has no valid output.\n- ConvTranspose2d: a stride or dilation larger than the output size\n  can only arise when input==1 or filter==1, where its value is a pure\n  no-op. Reject such values so that unbounded uint32 strides/dilations\n  can not flow unchecked into backends\n\nThis CL also adds WPTs for the new checks.\n\nThere is a related discussion about this in the spec issue[1].\n\n[1] https://github.com/webmachinelearning/webnn/issues/928#issuecomment-4723645239\n\nFixed: 546106051\nChange-Id: I37eea4793cbd42d2e80aab23e68c127ff0f5381d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8250961\nReviewed-by: Reilly Grant \u003creillyg@chromium.org\u003e\nReviewed-by: Phillis Tang \u003cphillis@chromium.org\u003e\nReviewed-by: Hu, Ningxin \u003cningxin.hu@intel.com\u003e\nCommit-Queue: Wang, Wei4 \u003cwei4.wang@intel.com\u003e\nCr-Commit-Position: refs/heads/main@{#1682769}\n\n--\n\nwpt-commits: e5c6f33944034560e09421e650211f5e1ccc619d\nwpt-pr: 62066\n", "files": ["testing/web-platform/tests/webnn/validation_tests/conv2d.https.any.js", "testing/web-platform/tests/webnn/validation_tests/convTranspose2d.https.any.js", "testing/web-platform/tests/webnn/validation_tests/pooling.https.any.js"], "git_node": "de586710dc3731a22487ae2b8963c3877ea9611d", "git_parents": ["3618630b127a937f8fab7b8987cb879f2af1d432"], "node": "6816ed88f21072f5b3b029039de22275f31f33fe", "parents": ["a5ce92d5000e9dc42f5fba0dc671cd0a2f83a6be"], "tags": []}, {"author": "Jochen K\u00fchner \u003cjochen.kuehner@gmx.de\u003e", "branch": "default", "desc": "Bug 2065016 [wpt PR 62077] - Update both GeometryUtils endpoints before conversion, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate both GeometryUtils endpoints before conversion\n\nUpdating a source node does not force layout for a relativeTo endpoint\nin an unrelated display-locked subtree of the same document. Update the\ntarget endpoint separately.\n\nMake the target update unconditional whenever a target exists. A clean\nlifecycle update is a no-op. Avoiding endpoint relationship logic keeps\nthe update correct across shadow trees and future lifecycle changes.\n\nAdd WPT coverage using source and target nodes in separate content-\nvisibility locks.\n\nBug: 427918516\n\nChange-Id: I082d236c655bb5669f98e8649c9f36313b8ddd02\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8227484\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1682689}\n\n--\n\nwpt-commits: 8b65c16d049837be99b5d7a3fe114f6dce9fb683\nwpt-pr: 62077\n", "files": ["testing/web-platform/tests/css/cssom-view/cssom-geometryutils-lifecycle.html"], "git_node": "e4c66d27783dec1e35f32cdf6a4d068aae239e0e", "git_parents": ["de586710dc3731a22487ae2b8963c3877ea9611d"], "node": "6223460af08886dbc8b2d9e015683d2fe52280ef", "parents": ["6816ed88f21072f5b3b029039de22275f31f33fe"], "tags": []}, {"author": "Aran Donohue \u003caran.donohue@gmail.com\u003e", "branch": "default", "desc": "Bug 2064566 [wpt PR 62026] - Move the WebTransport headers test to external/wpt, a=testonly\n\nAutomatic update from web-platform-tests\nMove the WebTransport headers test to external/wpt\n\nR=flackr@chromium.org, ricea@chromium.org\n\nChange-Id: I844c3180fccad46b0f0120467c2a71dc4e3f085a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8265548\nReviewed-by: Adam Rice \u003cricea@chromium.org\u003e\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCommit-Queue: Adam Rice \u003cricea@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1682887}\n\n--\n\nwpt-commits: aa2d8857a5d3990dfcb6e1b433fddbbe3e553046\nwpt-pr: 62026\n", "files": ["testing/web-platform/tests/webtransport/headers.https.any.js"], "git_node": "e501b9b9e7e81e0ad248e923bc7b8935db7b71b3", "git_parents": ["e4c66d27783dec1e35f32cdf6a4d068aae239e0e"], "node": "df4fc8780f29b0bfad3882eb52d01723927a9c67", "parents": ["6223460af08886dbc8b2d9e015683d2fe52280ef"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064566 [wpt PR 62026] - Update wpt metadata, a=testonly\n\nwpt-pr: 62026\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webtransport/headers.https.any.js.ini"], "git_node": "49823bfc60925c97ddac5686a3a5c13c05f6da72", "git_parents": ["e501b9b9e7e81e0ad248e923bc7b8935db7b71b3"], "node": "5d69b97847e6c6c185067f43ea40f2a28090ff68", "parents": ["df4fc8780f29b0bfad3882eb52d01723927a9c67"], "tags": []}, {"author": "Shannon Booth \u003cshannon.ml.booth@gmail.com\u003e", "branch": "default", "desc": "Bug 2065073 [wpt PR 59333] - Test lazy loading intersection observations outside viewport, a=testonly\n\nAutomatic update from web-platform-tests\nTest lazy loading intersection observations outside viewport\n\nFor: https://github.com/whatwg/html/issues/10019\n\n--\n\nwpt-commits: 7fe4e301823f3cb26b0d110cc139f219eb56dba2\nwpt-pr: 59333\n", "files": ["testing/web-platform/tests/intersection-observer/img-lazy-loading-not-blocked-by-img-outside-viewport.html"], "git_node": "db26d09d5edd29de7531fdb65470abe02e2c91a4", "git_parents": ["49823bfc60925c97ddac5686a3a5c13c05f6da72"], "node": "6571620b952fb97a74b31ee7c840ac7c84ac7036", "parents": ["5d69b97847e6c6c185067f43ea40f2a28090ff68"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064837 [wpt PR 62064] - sanitizer-api: Add edge cases for template elements, a=testonly\n\nAutomatic update from web-platform-tests\nsanitizer-api: Add edge cases for template elements (#62064)\n--\n\nwpt-commits: 4e0e5989466b0e1b6f62c809bdd25abbd546207d\nwpt-pr: 62064\n", "files": ["testing/web-platform/tests/sanitizer-api/sethtml-tree-construction.sub.dat"], "git_node": "4ac667578d99b6e3702f732858d32cb4242e01f3", "git_parents": ["db26d09d5edd29de7531fdb65470abe02e2c91a4"], "node": "67da61c569e67f346050d2e482ad6281cd1dac75", "parents": ["6571620b952fb97a74b31ee7c840ac7c84ac7036"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064834 [wpt PR 62063] - sanitizer-api: Add edge cases around namespace sanitization, a=testonly\n\nAutomatic update from web-platform-tests\nsanitizer-api: Add edge cases around namespace sanitization (#62063)\n--\n\nwpt-commits: a7afc9f5013ac24b915df6c87bd4756c6879997a\nwpt-pr: 62063\n", "files": ["testing/web-platform/tests/sanitizer-api/sanitizer-removeUnsafe.html"], "git_node": "66ccf4ebdaa51b0762fb14568b648bddd37a9d7c", "git_parents": ["4ac667578d99b6e3702f732858d32cb4242e01f3"], "node": "ce499d3484053071814098fcc3f23fa40de407c5", "parents": ["67da61c569e67f346050d2e482ad6281cd1dac75"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064827 [wpt PR 62061] - sanitizer-api: Add test cases for data- with no suffix, a=testonly\n\nAutomatic update from web-platform-tests\nsanitizer-api: Add test cases for data- with no suffix (#62061)\n--\n\nwpt-commits: d9ca4ddcd0367223b34ebbe2bccee58b1ca107d1\nwpt-pr: 62061\n", "files": ["testing/web-platform/tests/sanitizer-api/sanitizer-boolean-defaults.html"], "git_node": "cadd8bdc06de972ecb8a6bbf349ae83fd85125fd", "git_parents": ["66ccf4ebdaa51b0762fb14568b648bddd37a9d7c"], "node": "0ce1da08d161ac37a48b2dbc094495f890506bb8", "parents": ["ce499d3484053071814098fcc3f23fa40de407c5"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064825 [wpt PR 62060] - sanitizer-api: Add test cases for tables with adoption agency algorithm, a=testonly\n\nAutomatic update from web-platform-tests\nsanitizer-api: Add test cases for tables with adoption agency algorithm (#62060)\n--\n\nwpt-commits: 6745634413e4153144e23bc3e866d6b14d3e55e6\nwpt-pr: 62060\n", "files": ["testing/web-platform/tests/sanitizer-api/html5lib-basics.html"], "git_node": "e8f1d07f14e75e2a6c22724ce44a3923ebe8254e", "git_parents": ["cadd8bdc06de972ecb8a6bbf349ae83fd85125fd"], "node": "10139b6240a1d886429ed5c9e3cf0f61f6e3f19c", "parents": ["0ce1da08d161ac37a48b2dbc094495f890506bb8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064825 [wpt PR 62060] - Update wpt metadata, a=testonly\n\nwpt-pr: 62060\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/sanitizer-api/html5lib-basics.html.ini"], "git_node": "5ea5e725b20146269d5c35f6686fcc34374d62bb", "git_parents": ["e8f1d07f14e75e2a6c22724ce44a3923ebe8254e"], "node": "11c622d86389f412ebf19b30a858de010a871404", "parents": ["10139b6240a1d886429ed5c9e3cf0f61f6e3f19c"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2065144 [wpt PR 62079] - sanitizer-api: Add edge cases around case folding & case normalisation, a=testonly\n\nAutomatic update from web-platform-tests\nsanitizer-api: Add edge cases around case folding & case normalisation (#62079)\n\n* sanitizer-api: Add edge cases around case folding & case normalisation\n\n* add spec links\n--\n\nwpt-commits: c3131ef3c38290f8851c69cd494afa715b784270\nwpt-pr: 62079\n", "files": ["testing/web-platform/tests/sanitizer-api/sanitizer-names.html"], "git_node": "699152e97f8ee5f95fc4535a6c3659a4c7ac770e", "git_parents": ["5ea5e725b20146269d5c35f6686fcc34374d62bb"], "node": "0d4bc2246b60597eeb814242359008a4f8809dff", "parents": ["11c622d86389f412ebf19b30a858de010a871404"], "tags": []}, {"author": "Fran\u00e7ois Beaufort \u003cbeaufort.francois@gmail.com\u003e", "branch": "default", "desc": "Bug 2065114 [wpt PR 62078] - [WebMCP] Expose RegisteredTool.inputSchema as an object, a=testonly\n\nAutomatic update from web-platform-tests\n[WebMCP] Expose RegisteredTool.inputSchema as an object\n\nThis CL updates the WebIDL definition for RegisteredTool.inputSchema\nfrom DOMString to object to align with the WebMCP specification:\nhttps://github.com/webmachinelearning/webmcp/pull/241\n\nIn Blink, JSONStringToScriptObject() is used in\nModelContext::OnGetScriptToolsCompleted() to parse the mojo string\ninto a ScriptObject when constructing the RegisteredTool results.\n\nWeb platform tests in external/wpt/webmcp/imperative/ are updated to\nexpect inputSchema as a JavaScript object rather than a serialized\nJSON string.\n\nBug: 489045948\nChange-Id: I7a28b36d725c85e24726708aecee4cd9f3cbb476\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8248081\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCommit-Queue: Fr \u003cbeaufort.francois@gmail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1682945}\n\n--\n\nwpt-commits: 9ef2de86389e3f388578fe5fc599c979078c6667\nwpt-pr: 62078\n", "files": ["testing/web-platform/tests/webmcp/declarative/getTools-declarative-schema.https.html", "testing/web-platform/tests/webmcp/declarative/toolchange-on-control-add-remove.https.html", "testing/web-platform/tests/webmcp/imperative/exposedTo-cross-origin-child.https.html", "testing/web-platform/tests/webmcp/imperative/exposedTo-defaults-same-origin.https.html", "testing/web-platform/tests/webmcp/imperative/exposedTo-multiple-children.https.html", "testing/web-platform/tests/webmcp/imperative/getTools-imperative-schema.https.html", "testing/web-platform/tests/webmcp/imperative/resources/helpers.js", "testing/web-platform/tests/webmcp/resources/helpers.js"], "git_node": "030ddea158ff4c15987caad60ff196669e4e0ba6", "git_parents": ["699152e97f8ee5f95fc4535a6c3659a4c7ac770e"], "node": "c6514e388e77a3973f511d9b8b17cccc6f3a46f6", "parents": ["0d4bc2246b60597eeb814242359008a4f8809dff"], "tags": []}, {"author": "Daniel Vogelheim \u003cvogelheim@chromium.org\u003e", "branch": "default", "desc": "Bug 2064903 [wpt PR 62067] - Consistently set XML parser \"already started\" flag from parseFromString., a=testonly\n\nAutomatic update from web-platform-tests\nConsistently set XML parser \"already started\" flag from parseFromString.\n\nThis is a follow-on to crrev.com/c/8215568, which fixed the issue only\npartually. Because that fix compares QualifiedNames instead of calling\n`Matches()`, that fix will overlook script elements with non-empty\nprefixes.\n\nBug: 542115030, 540021703\nChange-Id: I6ffb6d4a8400e9c2d2cb6be8e84f56beb7163763\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8263155\nCommit-Queue: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1683004}\n\n--\n\nwpt-commits: b6b2d09394f056ad846dc12e13a4f8e612a23c6a\nwpt-pr: 62067\n", "files": ["testing/web-platform/tests/domparsing/DOMParser-parseFromString-xml-scripting-support-disabled.html"], "git_node": "cf0ba6c30c333667b5e8260c53d59be474bfe8cd", "git_parents": ["030ddea158ff4c15987caad60ff196669e4e0ba6"], "node": "5a538d2aadee08ed29fc5adb6917f6454c6d8a48", "parents": ["c6514e388e77a3973f511d9b8b17cccc6f3a46f6"], "tags": []}, {"author": "Stephen McGruer \u003csmcgruer@chromium.org\u003e", "branch": "default", "desc": "Bug 2065162 [wpt PR 62083] - [payment-method-manifest] Remove dynamic test ID from failure message, a=testonly\n\nAutomatic update from web-platform-tests\n[payment-method-manifest] Remove dynamic test ID from failure message (#62083)\n\nThis was causing flake in Chrome test infra, since the failure message\nwould change on each run.\n--\n\nwpt-commits: db80bd24a77f1b5f8ba40a5b320dec3720a37c8d\nwpt-pr: 62083\n", "files": ["testing/web-platform/tests/payment-method-manifest/resources/helpers.js"], "git_node": "6ebb629385e0fb2460b3d731c4f90cf4e2a4c0a0", "git_parents": ["cf0ba6c30c333667b5e8260c53d59be474bfe8cd"], "node": "44e892757614c5c6d442830f044312062a6d78ce", "parents": ["5a538d2aadee08ed29fc5adb6917f6454c6d8a48"], "tags": []}, {"author": "Daniel Huigens \u003cd.huigens@protonmail.com\u003e", "branch": "default", "desc": "Bug 2065266 [wpt PR 62086] - [WebCryptoAPI] Add tests for [EnforceRange] WebIDL attribute, a=testonly\n\nAutomatic update from web-platform-tests\n[WebCryptoAPI] Add tests for [EnforceRange] WebIDL attribute (#62086)\n\nThe `[EnforceRange]` attribute of the `length` parameter of `deriveBits`\nwas added in https://github.com/w3c/webcrypto/pull/555.\n\nThe `[EnforceRange]` attribute of the `length` and `modulusLength`\nproperties of the `{Aes,Hmac,Rsa}KeyGenParams` dictionaries was\nalready there.\n\nThis change adds tests for both.\n--\n\nwpt-commits: b5af458bb2e817310239e66447c7055ce835f570\nwpt-pr: 62086\n", "files": ["testing/web-platform/tests/WebCryptoAPI/derive_bits_keys/derived_bits_length.js", "testing/web-platform/tests/WebCryptoAPI/derive_bits_keys/derived_bits_length_testcases.js", "testing/web-platform/tests/WebCryptoAPI/generateKey/failures.js"], "git_node": "2f442a5f84549b7423fd482ff61347346688c509", "git_parents": ["6ebb629385e0fb2460b3d731c4f90cf4e2a4c0a0"], "node": "b62421ff252394e1902570b196d738508cef8587", "parents": ["44e892757614c5c6d442830f044312062a6d78ce"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065266 [wpt PR 62086] - Update wpt metadata, a=testonly\n\nwpt-pr: 62086\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/WebCryptoAPI/derive_bits_keys/derived_bits_length.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_AES-CBC.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_AES-CTR.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_AES-GCM.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_AES-KW.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_AES-OCB.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_HMAC.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_RSA-OAEP.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_RSA-PSS.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_RSASSA-PKCS1-v1_5.https.any.js.ini"], "git_node": "6207718cc3b0e681cd97d7fd76026783a2ed2bf7", "git_parents": ["2f442a5f84549b7423fd482ff61347346688c509"], "node": "d659d8b1257d619379728d52c3d7fb9c0bc636bf", "parents": ["b62421ff252394e1902570b196d738508cef8587"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2064997 [wpt PR 62075] - vt: Don't painthold while pre-rendering, a=testonly\n\nAutomatic update from web-platform-tests\nvt: Don't painthold while pre-rendering\n\nIf we do paint holding while pre-rendering then when the pre-render\nis actually activated, we assume becaues the paint holding is already\nrunning that we should just force it to show the first frame\n(and stop the paint holding). This breaks view transitions to\npre-rendering pages.\n\nR=rakina@chromium.org\n\nBug: 538634442\nChange-Id: I2e8a209fb268e4c41c605ab017b9814d0753714b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8265713\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nReviewed-by: Rakina Zata Amni \u003crakina@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1683158}\n\n--\n\nwpt-commits: c1c2d1db27ab8cdca85e53262e591a79eee03e5c\nwpt-pr: 62075\n", "files": ["testing/web-platform/tests/css/css-view-transitions/navigation/prerender-coop.https.html", "testing/web-platform/tests/css/css-view-transitions/navigation/resources/prerender-coop.html", "testing/web-platform/tests/css/css-view-transitions/navigation/resources/prerender-coop.html.headers"], "git_node": "8d6e444c0eba915def8d7cf90a4b1ad62c14e514", "git_parents": ["6207718cc3b0e681cd97d7fd76026783a2ed2bf7"], "node": "8dc1faabad64bd14e1dc7bddcc36815606398d30", "parents": ["d659d8b1257d619379728d52c3d7fb9c0bc636bf"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064997 [wpt PR 62075] - Update wpt metadata, a=testonly\n\nwpt-pr: 62075\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-view-transitions/navigation/prerender-coop.https.html.ini"], "git_node": "b62ac9b356f02a64a403ed4a96b74b292ddc8031", "git_parents": ["8d6e444c0eba915def8d7cf90a4b1ad62c14e514"], "node": "ebc2e17180517e5b5a1226814f5702d20b0e9f67", "parents": ["8dc1faabad64bd14e1dc7bddcc36815606398d30"], "tags": []}, {"author": "Yulun Wu \u003cyulun_wu@apple.com\u003e", "branch": "default", "desc": "Bug 2064614 [wpt PR 62034] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321107, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=321107 (#62034)\n--\n\nwpt-commits: ca3a5b7ba6a27a5915b06d5f329fd88f47cb2b53\nwpt-pr: 62034\n", "files": ["testing/web-platform/tests/css/selectors/media/support/stall-resume.py"], "git_node": "3d7b1c77f0ec53220bc4c4f706ccad0a1b27534c", "git_parents": ["b62ac9b356f02a64a403ed4a96b74b292ddc8031"], "node": "3c8783869f097aa0a04d2abe91c9bb07b1fa190a", "parents": ["ebc2e17180517e5b5a1226814f5702d20b0e9f67"], "tags": []}, {"author": "Yulun Wu \u003cyulun_wu@apple.com\u003e", "branch": "default", "desc": "Bug 2064618 [wpt PR 62035] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321113, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=321113\n\n--\n\nwpt-commits: 6c7127bdd9f2cc6a3668fd9791757843e09d5a9e\nwpt-pr: 62035\n", "files": ["testing/web-platform/tests/css/selectors/media/sound-state.html"], "git_node": "85cbab0407232a6b9e29d1582974473eb108eb1f", "git_parents": ["3d7b1c77f0ec53220bc4c4f706ccad0a1b27534c"], "node": "da0a72be93258d228fb81cb4b417826a22e1e78d", "parents": ["3c8783869f097aa0a04d2abe91c9bb07b1fa190a"], "tags": []}, {"author": "Martin Robinson \u003cmrobinson@igalia.com\u003e", "branch": "default", "desc": "Bug 2065226 [wpt PR 62082] - script: Avoid double adjustment of Selection ranges during `contenteditable` node movement, a=testonly\n\nAutomatic update from web-platform-tests\nscript: Avoid double adjustment of Selection ranges during `contenteditable` node movement\n\nThe editing specification has a different way of updating selection\nranges than the typical live range update method in the `insert` and\n`remove` algorithms. Because selections are currently represented as\nlive ranges (something that will change soon), this means that the\nadjustment was being applied twice: once by the live range update and\nthen once by the `contenteditable` code's range fixup. This change makes\nit so that the `contenteditable` fixup runs against the original\nselection boundaries, meaning that the final fixup is done only once.\n\nSigned-off-by: Martin Robinson \u003cmrobinson@igalia.com\u003e\n\n--\n\nwpt-commits: 5d45ecb5839f7882854a1086c7b8c1c53bfa9ec7\nwpt-pr: 62082\n", "files": ["testing/web-platform/tests/editing/crashtests/updating-selection-offsets-after-insertHorizontalRule.html"], "git_node": "a9166dcc484fe60a8fcb12a90ecf291b2e4c5acf", "git_parents": ["85cbab0407232a6b9e29d1582974473eb108eb1f"], "node": "caa3af500324e5010112b22ce57d0d4018cd118b", "parents": ["da0a72be93258d228fb81cb4b417826a22e1e78d"], "tags": []}, {"author": "Javier Contreras Tenorio \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2065396 [wpt PR 62097] - [masonry] Expand gap decoration WPTs for rule-inset and rule-break, a=testonly\n\nAutomatic update from web-platform-tests\n[masonry] Expand gap decoration WPTs for rule-inset and rule-break\n\nGrid-lanes gap decorations did not have focused coverage for rule-inset\nendpoint or rule-break: none.\n\nAdd an expected failure for overlapping stacking-axis gutters, whose\npercentage basis requires union-width behavior that is not yet\nimplemented\n\nBug: 343257585\nChange-Id: I4e8f9283a4b30c51deaa378c4237f3ac5deb87b2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8269567\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nAuto-Submit: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1683489}\n\n--\n\nwpt-commits: 853c3cec2c3bf97723904597dd240304c36592b6\nwpt-pr: 62097\n", "files": ["testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-break-stacking-axis-noop-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-break-stacking-axis-noop.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-across-spanner-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-across-spanner.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-cap-vs-junction-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-cap-vs-junction.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-negative-cap-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-negative-cap.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-negative-junction-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-negative-junction.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-overlapping-gutters-percentage-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-overlapping-gutters-percentage.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-percentage-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-percentage.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-with-break-none-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-with-break-none.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-inset-cap-vs-junction-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-inset-cap-vs-junction.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-inset-percentage-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-inset-percentage.html"], "git_node": "ab9380bb87e1d88a6d979678164512a8997989a1", "git_parents": ["a9166dcc484fe60a8fcb12a90ecf291b2e4c5acf"], "node": "80016e10f9f9158f8137e9c261331e08e34fa5d7", "parents": ["caa3af500324e5010112b22ce57d0d4018cd118b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065396 [wpt PR 62097] - Update wpt metadata, a=testonly\n\nwpt-pr: 62097\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-break-stacking-axis-noop.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-inset-across-spanner.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-inset-cap-vs-junction.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-inset-negative-cap.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-inset-negative-junction.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-inset-overlapping-gutters-percentage.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-inset-percentage.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-inset-with-break-none.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-inset-cap-vs-junction.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-inset-percentage.html.ini"], "git_node": "cb0c45088e06608333f4979f8a9c9b52ae6004fa", "git_parents": ["ab9380bb87e1d88a6d979678164512a8997989a1"], "node": "661453dcc99660d14f29e0e6dab465f3f18fcc01", "parents": ["80016e10f9f9158f8137e9c261331e08e34fa5d7"], "tags": []}, {"author": "Javier Contreras \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2065391 [wpt PR 62096] - [gap-decorations] Assign flex gap decoration values for reversed flex, a=testonly\n\nAutomatic update from web-platform-tests\n[gap-decorations] Assign flex gap decoration values for reversed flex\n\nAssign listed and repeated flex gap-decoration values according to flex\nplacement order when `flex-direction` or `flex-wrap` reverses placement,\nmatching the CSSWG resolution in\nhttps://github.com/w3c/csswg-drafts/issues/14156.\n\nBy default, placement order is what we use to assign values in grid,\nmulticol, and grid lanes. The special case handling is needed for\nreversed flex and soon for reversed column fill for grid-lanes.\n\nGap geometry remains in logical paint order. Layout records reversal\nmetadata, while paint maps each stored gap to its placement-order value\nindex.\n\nSo this CL adds an accessor class (`GapDataListValueAccessor`) that will\nbe used instead of the forward-only iterator when assigning gap\ndecoration values in the reversal cases. In that same file, we make some\nof the logic previously used by `BuildRegions` into a helper function so\nwe can reuse it.\n\nIn the common case, time complexity for assigning values does not\nchange. Without reversal, the time complexity is O(A + G), where A is\nthe number of entries in the (non-expanded) list i.e. `rule-color: red,\ngreen, blue` and G is the number of gaps in the axis.\n\nWith reversals, we add an extra logarithmic factor but ONLY for cases\nwhere there are fixed integer repeaters `red, repeat(3, blue green),\nblue`. In these cases the complexity is O(A+GlogA), but even then,\nusually A will be small (in the aforementioned example it is 3).\n\nBecause of this seemingly small time complexity penalty, I will\ninvestigate getting rid of the iterator entirely and just using the\naccessor, if after profiling we see that the difference is not\nsignificant.\n\nWe add WPT coverage for direction reversal, wrap reversal, RTL\ninteraction, uneven flex lines, and `repeat(auto, ...)`.\n\nAs a small refactor, `GapDataListIterator` now stores the shared\n`RegionSlotCounts` directly, and we add a helper in `GapData` so the\niterator and accessor can reuse logic.\n\nChange-Id: I559bcf0e294a233431636d554e29985476a26a70\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8248120\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nAuto-Submit: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1683498}\n\n--\n\nwpt-commits: fbb56f5460abe38f6c43d3d3e389eb15b91e0e6b\nwpt-pr: 62096\n", "files": ["testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-auto-repeat-flex-direction-reverse-ref.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-auto-repeat-flex-direction-reverse.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-integer-repeat-flex-direction-reverse-ref.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-integer-repeat-flex-direction-reverse.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-multi-value-column-reverse-uneven-lines-ref.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-multi-value-column-reverse-uneven-lines.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-multi-value-flex-direction-reverse-ref.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-multi-value-flex-direction-reverse.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-multi-value-reverse-direction-interaction-ref.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-multi-value-reverse-direction-interaction.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-multi-value-width-flex-direction-reverse-ref.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-multi-value-width-flex-direction-reverse.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-multi-value-wrap-reverse-ref.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-multi-value-wrap-reverse-uneven-lines-ref.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-multi-value-wrap-reverse-uneven-lines.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-multi-value-wrap-reverse.html"], "git_node": "fa0a40b356981001a875b1880fd14b06f7b2d2fe", "git_parents": ["cb0c45088e06608333f4979f8a9c9b52ae6004fa"], "node": "1560aa694c6409585b700e65c18b8d72c5da4945", "parents": ["661453dcc99660d14f29e0e6dab465f3f18fcc01"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065391 [wpt PR 62096] - Update wpt metadata, a=testonly\n\nwpt-pr: 62096\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-gaps/flex/flex-gap-decorations-auto-repeat-flex-direction-reverse.html.ini", "testing/web-platform/meta/css/css-gaps/flex/flex-gap-decorations-integer-repeat-flex-direction-reverse.html.ini", "testing/web-platform/meta/css/css-gaps/flex/flex-gap-decorations-multi-value-column-reverse-uneven-lines.html.ini", "testing/web-platform/meta/css/css-gaps/flex/flex-gap-decorations-multi-value-flex-direction-reverse.html.ini", "testing/web-platform/meta/css/css-gaps/flex/flex-gap-decorations-multi-value-reverse-direction-interaction.html.ini", "testing/web-platform/meta/css/css-gaps/flex/flex-gap-decorations-multi-value-width-flex-direction-reverse.html.ini", "testing/web-platform/meta/css/css-gaps/flex/flex-gap-decorations-multi-value-wrap-reverse-uneven-lines.html.ini", "testing/web-platform/meta/css/css-gaps/flex/flex-gap-decorations-multi-value-wrap-reverse.html.ini"], "git_node": "19449c894c05f8c2e21651b243b1a9d518ae50df", "git_parents": ["fa0a40b356981001a875b1880fd14b06f7b2d2fe"], "node": "95a3134a879036227f284a836db4d5d4b1f9cd18", "parents": ["1560aa694c6409585b700e65c18b8d72c5da4945"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2065427 [wpt PR 62101] - Fix focus navigation loop for internal popover invokers, a=testonly\n\nAutomatic update from web-platform-tests\nFix focus navigation loop for internal popover invokers\n\nWhen a popover is opened with an invoker that is inside the popover\nitself (e.g. via `showPopover({source: btn})`), the focus navigation\nlogic in FocusController previously treated that internal element as\nthe scope owner for the popover.\n\nBecause the scope owner was a descendant of the popover itself,\ntraversing out of the popover focus scope (e.g. upon reaching the end\nof the popover or tabbing away) would re-resolve the popover scope from\nthe internal owner, creating a cyclic ownership chain and causing an\ninfinite loop or stack overflow crash.\n\nThis patch updates `InvokerForOpenPopover()` and\n`GetOpenPopoverTarget()` to return nullptr when\n`FlatTreeTraversal::Contains()` finds the invoker inside the popover,\npreventing internal invokers from acting as scope owners.\n\nFixed: 542274292\nChange-Id: I6ff5fed25db2b4d255cb36873d5fbc480ae620da\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8265901\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1683577}\n\n--\n\nwpt-commits: c2160b7c132d0a0ba0a23e7a8ddeba2f76bce03a\nwpt-pr: 62101\n", "files": ["testing/web-platform/tests/html/semantics/popovers/popover-focus-invoker-inside-popover.html"], "git_node": "e718362c92356e22517d966f500d03aca300c876", "git_parents": ["19449c894c05f8c2e21651b243b1a9d518ae50df"], "node": "15a7619f80cd6123c5e240f5585bb555a60b4cb5", "parents": ["95a3134a879036227f284a836db4d5d4b1f9cd18"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065427 [wpt PR 62101] - Update wpt metadata, a=testonly\n\nwpt-pr: 62101\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/popovers/chrome-392042073-crash.html.ini", "testing/web-platform/meta/html/semantics/popovers/popover-focus-invoker-inside-popover.html.ini"], "git_node": "bbb6a213dd86f90dbfcea9fc8e204c36c9121564", "git_parents": ["e718362c92356e22517d966f500d03aca300c876"], "node": "0b71c23d477ffd5a00f6c9f19945765b26f21623", "parents": ["15a7619f80cd6123c5e240f5585bb555a60b4cb5"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2064951 [wpt PR 62072] - Maintain interest invoker state when focus moves into iframe popover, a=testonly\n\nAutomatic update from web-platform-tests\nMaintain interest invoker state when focus moves into iframe popover\n\nWhen an interest invoker invokes an `\u003ciframe popover\u003e`, moving focus\ninto the iframe's content document caused the invoker to lose focus\n(because the iframe content document now has focus). This triggered a\nloseinterest task that closed the popover.\n\nThis CL addresses the issue by:\n1. Enabling AllSourceInterestInvokersRecursive and\n   Element::HandleInterestForHoverOrFocus to traverse across document\n   boundaries via Document::LocalOwner().\n2. Handling bubbling focusin and focusout events at the child\n   Document::DefaultEventHandler and forwarding them to the local frame\n   owner element.\n3. Handling focus changes into and out of cross-origin (remote) frames\n   in FocusController::SetFocusedFrame.\n\nFixed: 534893151\nChange-Id: Ib8fb5a7fc11c7397b7c120e1fc45feb267f96a67\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8264990\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1683588}\n\n--\n\nwpt-commits: b47a7e305aca81844444ce5557a1517943c4e5b7\nwpt-pr: 62072\n", "files": ["testing/web-platform/tests/html/semantics/interestfor/interestfor-iframe-popover.tentative.html"], "git_node": "2331d6e63243724acd3433aeebc6f89e43576958", "git_parents": ["bbb6a213dd86f90dbfcea9fc8e204c36c9121564"], "node": "b0d3df9de7de6d1cdb7b79a0690991a9ae7ddc49", "parents": ["0b71c23d477ffd5a00f6c9f19945765b26f21623"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064951 [wpt PR 62072] - Update wpt metadata, a=testonly\n\nwpt-pr: 62072\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/interestfor/interestfor-iframe-popover.tentative.html.ini"], "git_node": "834fe264aec80b704beba1a995f34a083820ea7a", "git_parents": ["2331d6e63243724acd3433aeebc6f89e43576958"], "node": "6864e9c88ff2874bdab1987e24150ccf8139bd90", "parents": ["b0d3df9de7de6d1cdb7b79a0690991a9ae7ddc49"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2065442 [wpt PR 62105] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=313374, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=313374 (#62105)\n--\n\nwpt-commits: 0ff01d5278b01a4250e3f8550c15fde732d8808b\nwpt-pr: 62105\n", "files": ["testing/web-platform/tests/svg/styling/text-overflow-presentation-attribute-foreignobject-ref.html", "testing/web-platform/tests/svg/styling/text-overflow-presentation-attribute-foreignobject.html"], "git_node": "2062e46b5b6541db4775d85144a7a23a699f7978", "git_parents": ["834fe264aec80b704beba1a995f34a083820ea7a"], "node": "a5cf57ffdc86bc3c1e49b47b2b4ee1e771e508fa", "parents": ["6864e9c88ff2874bdab1987e24150ccf8139bd90"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2065445 [wpt PR 62104] - [html-in-canvas] Skip transforms from drawable element to canvas, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Skip transforms from drawable element to canvas\n\nCanvas element transforms map a drawable element's border box directly\nto the canvas coordinate space. For nested drawable elements, ancestor\ntransforms, offsets, and clips between the drawable element and the\ncanvas should be skipped.\n\nThis patch updates the element canvas transform paint property node to\nbe parented directly under the canvas. Similarly, this patch updates\nMapLocalToAncestor, MapAncestorToLocal, and\nMapToVisualRectInAncestorSpaceInternal to jump directly between the\ndrawable element and the canvas. Additionally, GetUsedCanvasTransform\nhas been changed to require a valid CanvasForDrawing. Additionally,\npseudo elements have been prevented from being drawable.\n\nBug: 532229486\nChange-Id: I37fa0a15b5156574bdd5f4bd879272ca05e467be\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8266994\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1683625}\n\n--\n\nwpt-commits: 0e668158beee8ba393247616ea6d4eece6739583\nwpt-pr: 62104\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/canvas-transform-get-bounding-client-rect.tentative.html"], "git_node": "a7113a3aaff0c906276e3ccf851838d0999a5b68", "git_parents": ["2062e46b5b6541db4775d85144a7a23a699f7978"], "node": "f5ac73dffa634260bfc7b398fceac467fac9f892", "parents": ["a5cf57ffdc86bc3c1e49b47b2b4ee1e771e508fa"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065445 [wpt PR 62104] - Update wpt metadata, a=testonly\n\nwpt-pr: 62104\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/canvas-transform-get-bounding-client-rect.tentative.html.ini"], "git_node": "f600dbf2e649013bba431a9ed4e4ba37a940cee5", "git_parents": ["a7113a3aaff0c906276e3ccf851838d0999a5b68"], "node": "ef3757c2a22c6fff67a538914bb2b406baf134e8", "parents": ["f5ac73dffa634260bfc7b398fceac467fac9f892"], "tags": []}, {"author": "Shiyi Zou \u003cshiyi.zou@intel.com\u003e", "branch": "default", "desc": "Bug 2065448 [wpt PR 62106] - webnn: validate LSTM/GRU full-sequence output unconditionally, a=testonly\n\nAutomatic update from web-platform-tests\nwebnn: validate LSTM/GRU full-sequence output unconditionally\n\nSome backends allocate the full-sequence output tensor internally\nregardless of the `returnSequence` flag but do not validate its size,\nwhich can cause an out-of-bounds write. Always validate the\nfull-sequence output descriptor so that oversized shapes are rejected\nbefore reaching the backend.\n\nBug: 546067906\nChange-Id: If58b35857c39eb272a8feb1a43a16385df2fe915\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8256436\nReviewed-by: Hu, Ningxin \u003cningxin.hu@intel.com\u003e\nCommit-Queue: Zou, Shiyi \u003cshiyi.zou@intel.com\u003e\nReviewed-by: Reilly Grant \u003creillyg@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1683674}\n\n--\n\nwpt-commits: 7603ba0968894307ad737144de86c7e21614f209\nwpt-pr: 62106\n", "files": ["testing/web-platform/tests/webnn/validation_tests/gru.https.any.js", "testing/web-platform/tests/webnn/validation_tests/lstm.https.any.js"], "git_node": "c6452ff2b99088e75f92aa3853f7946e9de43253", "git_parents": ["f600dbf2e649013bba431a9ed4e4ba37a940cee5"], "node": "f087cf7597f1d22e370dcd508312b9b5f1d72ceb", "parents": ["ef3757c2a22c6fff67a538914bb2b406baf134e8"], "tags": []}, {"author": "moonira \u003cmoonira@google.com\u003e", "branch": "default", "desc": "Bug 2065494 [wpt PR 62109] - Support random() values in if() style() condition, a=testonly\n\nAutomatic update from web-platform-tests\nSupport random() values in if() style() condition\n\nproperty-scoped and element-scoped random() values in if() style\ncondition should behave the same as if defined in other css property.\nFor property-index-scoped, if random() is evaluated within an arb-sub\nfunction as part of substitution (rather than as the substitution value\nitself), e.g. if() condition, for caching we use index of random()\nacross all arb-subs in the property, in parse order.\n\nBug: 522304655, 413385732\nChange-Id: I2eb9d0c77793f84de00f454d2a4c811252a8dc00\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8255320\nReviewed-by: Anders Hartvoll Ruud \u003candruud@chromium.org\u003e\nCommit-Queue: Munira Tursunova \u003cmoonira@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1683771}\n\n--\n\nwpt-commits: e68a4b9c4b6a6dffa5a74881d6f4f119ddcfda51\nwpt-pr: 62109\n", "files": ["testing/web-platform/tests/css/css-values/random-in-if.tentative.html"], "git_node": "6bb56ccc7e84364cc6fd5d557ba4a59730029059", "git_parents": ["c6452ff2b99088e75f92aa3853f7946e9de43253"], "node": "3b60672a9695104d35e5bdd0caa2219616fbc689", "parents": ["f087cf7597f1d22e370dcd508312b9b5f1d72ceb"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065494 [wpt PR 62109] - Update wpt metadata, a=testonly\n\nwpt-pr: 62109\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/random-in-if.tentative.html.ini"], "git_node": "98921e441e09ef041598a62d72f9b74f3e5c8ed5", "git_parents": ["6bb56ccc7e84364cc6fd5d557ba4a59730029059"], "node": "822a759b22a7fdbd79e4108156d0d5d473c6ef94", "parents": ["3b60672a9695104d35e5bdd0caa2219616fbc689"], "tags": []}, {"author": "Fr \u003cbeaufort.francois@gmail.com\u003e", "branch": "default", "desc": "Bug 2065543 [wpt PR 62111] - Revert \"[WebMCP] Expose RegisteredTool.inputSchema as an object\", a=testonly\n\nAutomatic update from web-platform-tests\nRevert \"[WebMCP] Expose RegisteredTool.inputSchema as an object\"\n\nThis reverts commit ec5ace9a94e9b4610a8f0ed1b9548ced902c6315.\n\nReason for revert: A packaging update failure with the \"WebMCP - Model Context Tool Inspector\" extension is currently blocking Chrome Canary users from interacting with WebMCP tools. Reverting this change temporarily to unblock users during my upcoming OOO; the CL will be relanded once the extension update is published.\n\nOriginal change's description:\n\u003e [WebMCP] Expose RegisteredTool.inputSchema as an object\n\u003e\n\u003e This CL updates the WebIDL definition for RegisteredTool.inputSchema\n\u003e from DOMString to object to align with the WebMCP specification:\n\u003e https://github.com/webmachinelearning/webmcp/pull/241\n\u003e\n\u003e In Blink, JSONStringToScriptObject() is used in\n\u003e ModelContext::OnGetScriptToolsCompleted() to parse the mojo string\n\u003e into a ScriptObject when constructing the RegisteredTool results.\n\u003e\n\u003e Web platform tests in external/wpt/webmcp/imperative/ are updated to\n\u003e expect inputSchema as a JavaScript object rather than a serialized\n\u003e JSON string.\n\u003e\n\u003e Bug: 489045948\n\u003e Change-Id: I7a28b36d725c85e24726708aecee4cd9f3cbb476\n\u003e Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8248081\n\u003e Reviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\n\u003e Commit-Queue: Fr \u003cbeaufort.francois@gmail.com\u003e\n\u003e Cr-Commit-Position: refs/heads/main@{#1682945}\n\nBug: 489045948\nNo-Presubmit: true\nNo-Tree-Checks: true\nNo-Try: true\nChange-Id: Id3fbbf9e22d902cc9341bd14fae78927582e1cfe\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8276309\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCommit-Queue: Fr \u003cbeaufort.francois@gmail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1683806}\n\n--\n\nwpt-commits: d1e7ae9146207a1a0c2cacc347d50546569f37d8\nwpt-pr: 62111\n", "files": ["testing/web-platform/tests/webmcp/declarative/getTools-declarative-schema.https.html", "testing/web-platform/tests/webmcp/declarative/toolchange-on-control-add-remove.https.html", "testing/web-platform/tests/webmcp/imperative/exposedTo-cross-origin-child.https.html", "testing/web-platform/tests/webmcp/imperative/exposedTo-defaults-same-origin.https.html", "testing/web-platform/tests/webmcp/imperative/exposedTo-multiple-children.https.html", "testing/web-platform/tests/webmcp/imperative/getTools-imperative-schema.https.html", "testing/web-platform/tests/webmcp/imperative/resources/helpers.js", "testing/web-platform/tests/webmcp/resources/helpers.js"], "git_node": "eb29a0f85cbf26aedd44a9888c71709678e9403b", "git_parents": ["98921e441e09ef041598a62d72f9b74f3e5c8ed5"], "node": "179388f6ecd83e225ce765683ac1835c83b3d336", "parents": ["822a759b22a7fdbd79e4108156d0d5d473c6ef94"], "tags": []}, {"author": "Bern\u00e1t G\u00e1bor \u003cgaborjbernat@gmail.com\u003e", "branch": "default", "desc": "Bug 2062478 [wpt PR 61846] - HTML parser: fix legacy PI parse errors, a=testonly\n\nAutomatic update from web-platform-tests\nHTML parser: fix legacy PI parse errors\n\nThe PI tokenizer states replaced the bogus-comment behavior for question-mark tag openings, but these older cases still count the removed tokenizer error.\n\nKeep their independent missing-doctype errors, use the current PI error and position where parsing is invalid, and remove the tokenizer error where the PI is valid.\n--\n\nwpt-commits: 8f1efd278facb6c96d46c0cd92897a8a3faeaf29\nwpt-pr: 61846\n", "files": ["testing/web-platform/tests/html/syntax/parsing/resources/comments01.dat", "testing/web-platform/tests/html/syntax/parsing/resources/html5test-com.dat", "testing/web-platform/tests/html/syntax/parsing/resources/tests1.dat"], "git_node": "af1e008ea38327007b405b2d8888555a1e143e1c", "git_parents": ["eb29a0f85cbf26aedd44a9888c71709678e9403b"], "node": "44440b48749ee2fd64f04202750e19f94890bd24", "parents": ["179388f6ecd83e225ce765683ac1835c83b3d336"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2065650 [wpt PR 62113] - Add JPEG XL ProPhoto RGB color management reftest, a=testonly\n\nAutomatic update from web-platform-tests\nAdd JPEG XL ProPhoto RGB color management reftest\n\nAdd a ProPhoto RGB ICC fixture and compare its JPEG XL rendering\nagainst an equivalent sRGB PNG reference.\n\nBug: None\nChange-Id: I018fafdb1a693324d1b14d8ca4411881a3a332ea\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8276711\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nSLSA-Policy-Verified: SLSA Policy Verification Service \u003cdevtools-gerritcodereview-exitgate@google.com\u003e\nReviewed-by: Philip J\u00e4genstedt \u003cfoolip@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1683924}\n\n--\n\nwpt-commits: f5c419d7942dd846100fbb210954bd57ea8d8238\nwpt-pr: 62113\n", "files": ["testing/web-platform/tests/jpegxl/resources/prophoto-rgb.jxl", "testing/web-platform/tests/jpegxl/resources/prophoto-rgb.png", "testing/web-platform/tests/jpegxl/wide-gamut-prophoto-rgb-ref.html", "testing/web-platform/tests/jpegxl/wide-gamut-prophoto-rgb.html"], "git_node": "b51cb733cfb81a4dd9d6f067bfc4947384849067", "git_parents": ["af1e008ea38327007b405b2d8888555a1e143e1c"], "node": "1adb9aea30c8515c4ce35c761cf3fc0009f2befc", "parents": ["44440b48749ee2fd64f04202750e19f94890bd24"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065650 [wpt PR 62113] - Update wpt metadata, a=testonly\n\nwpt-pr: 62113\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/jpegxl/wide-gamut-prophoto-rgb.html.ini"], "git_node": "7753f31b2b5a79a6e3b3b1c8cb78b8ed5789d93c", "git_parents": ["b51cb733cfb81a4dd9d6f067bfc4947384849067"], "node": "cee9f046325a1d73369996d8e36499379a1b226e", "parents": ["1adb9aea30c8515c4ce35c761cf3fc0009f2befc"], "tags": []}, {"author": "Sam Weinig \u003csam@webkit.org\u003e", "branch": "default", "desc": "Bug 2065370 [wpt PR 62091] - Update tests to not assume multiplications by 1 can be simplified away , a=testonly\n\nAutomatic update from web-platform-tests\nFix css/css-values/calc-infinity-nan-serialize-length.html and css/css-values/calc-nesting-002.html (#62091)\n\ncss/css-values/calc-infinity-nan-serialize-length.html and css/css-values/calc-nesting-002.html\nincorrectly assert that a calc() expression of the form `1 * math-function()` can be simplified\nto be just `math-function()`.\n--\n\nwpt-commits: 4bcf3c46b76c81adc1be630d9d72634a076919ac\nwpt-pr: 62091\n", "files": ["testing/web-platform/tests/css/css-values/calc-infinity-nan-serialize-length.html", "testing/web-platform/tests/css/css-values/calc-nesting-002.html"], "git_node": "bc9aaf2bf34f5b420693e5cb4ccfeb8b32364b04", "git_parents": ["7753f31b2b5a79a6e3b3b1c8cb78b8ed5789d93c"], "node": "e6826996f0688fee4cfa8bdf760128106bf872ef", "parents": ["cee9f046325a1d73369996d8e36499379a1b226e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065370 [wpt PR 62091] - Update wpt metadata, a=testonly\n\nwpt-pr: 62091\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/calc-infinity-nan-serialize-length.html.ini"], "git_node": "883a06a8da8882ea195db4cc8897ee9f1cbe9426", "git_parents": ["bc9aaf2bf34f5b420693e5cb4ccfeb8b32364b04"], "node": "094f8032fe63c045ea45a43ad27e140aadf46ebe", "parents": ["e6826996f0688fee4cfa8bdf760128106bf872ef"], "tags": []}, {"author": "Sam Weinig \u003csam@webkit.org\u003e", "branch": "default", "desc": "Bug 2065367 [wpt PR 62090] - Fix css/css-values/calc-in-media-queries-with-mixed-units.html, a=testonly\n\nAutomatic update from web-platform-tests\nFix css/css-values/calc-in-media-queries-with-mixed-units.html (#62090)\n\nThe media query in mixed-units-09.html did not match the description in the test\nand did not compute to 10px. This updates the media query in mixed-units-09.html\nto match the description.\n--\n\nwpt-commits: 4c9bca64d9254cd2af05d43d69cf71fab49f9d92\nwpt-pr: 62090\n", "files": ["testing/web-platform/tests/css/css-values/support/mixed-units-09.html"], "git_node": "72073ecdf68d83e8f5e0533c5e7d52f76a043991", "git_parents": ["883a06a8da8882ea195db4cc8897ee9f1cbe9426"], "node": "b01c066419257a27906bef24420b888f1e721921", "parents": ["094f8032fe63c045ea45a43ad27e140aadf46ebe"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065367 [wpt PR 62090] - Update wpt metadata, a=testonly\n\nwpt-pr: 62090\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/animations/scale-interpolation-crash.html.ini", "testing/web-platform/meta/css/css-values/calc-in-media-queries-with-mixed-units.html.ini"], "git_node": "a90a475baead2b23108dd8d8fcf8f427e88bfa95", "git_parents": ["72073ecdf68d83e8f5e0533c5e7d52f76a043991"], "node": "fcb8583830f4609ce3cf8f3965b6f29ce65de02e", "parents": ["b01c066419257a27906bef24420b888f1e721921"], "tags": []}, {"author": "Morten Stenshorne \u003cmstensho@chromium.org\u003e", "branch": "default", "desc": "Bug 2065662 [wpt PR 62117] - [RouteMatching] Consume whitespace after url-pattern() / url() token., a=testonly\n\nAutomatic update from web-platform-tests\n[RouteMatching] Consume whitespace after url-pattern() / url() token.\n\nIt was already passing for --dashed-ident and *unquoted* url(), but made\nthe --dashed-ident test more evil to cover this anyway.\n\nBug: 436805487\nChange-Id: Ia8c5117675dfca87d2882a6fbae61f5254308057\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8275313\nCommit-Queue: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1684044}\n\n--\n\nwpt-commits: 2fd7f68bea229b5d138234ee52a36903787273b2\nwpt-pr: 62117\n", "files": ["testing/web-platform/tests/css/css-navigation/tentative/parsing/navigation-rule-location-valid.html"], "git_node": "4926a72caa25ef04b0af44a0e655a9a857c5be7d", "git_parents": ["a90a475baead2b23108dd8d8fcf8f427e88bfa95"], "node": "91a32b7a6065af53e07d59c9a0888fdeb366c5d8", "parents": ["fcb8583830f4609ce3cf8f3965b6f29ce65de02e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065662 [wpt PR 62117] - Update wpt metadata, a=testonly\n\nwpt-pr: 62117\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-navigation/tentative/parsing/navigation-rule-location-valid.html.ini"], "git_node": "a0c454b78181ba1005a5e976be9cf8329761fd58", "git_parents": ["4926a72caa25ef04b0af44a0e655a9a857c5be7d"], "node": "4c157700fa6c167c7d096085c7860677d598c5d7", "parents": ["91a32b7a6065af53e07d59c9a0888fdeb366c5d8"], "tags": []}, {"author": "Filip Skokan \u003cpanva.ip@gmail.com\u003e", "branch": "default", "desc": "Bug 2065664 [wpt PR 62115] - [WebCryptoAPI] Expand supports() validation coverage, a=testonly\n\nAutomatic update from web-platform-tests\n[WebCryptoAPI] Expand supports() validation coverage\n\nKeep ECDH mismatched-curve cases independent of the existing overlength\nderiveBits tests. Add supports() coverage for RSA, HKDF, HMAC, EC\nderivation and import, ML-DSA contexts, and ML-KEM imported keys.\n\nRefs: https://github.com/w3c/webcrypto/issues/560\nRefs: https://github.com/w3c/webcrypto/pull/558\nRefs: https://github.com/WICG/webcrypto-modern-algos/pull/76\nRefs: https://github.com/WICG/webcrypto-modern-algos/pull/77\n\n--\n\nwpt-commits: e235e089b4e44a598f2d61e93732e0c4d9f03e04\nwpt-pr: 62115\n", "files": ["testing/web-platform/tests/WebCryptoAPI/derive_bits_keys/derive.js", "testing/web-platform/tests/WebCryptoAPI/derive_bits_keys/ecdh.js", "testing/web-platform/tests/WebCryptoAPI/supports-modern.tentative.https.any.js", "testing/web-platform/tests/WebCryptoAPI/supports.tentative.https.any.js", "testing/web-platform/tests/WebCryptoAPI/util/supports.js"], "git_node": "bef4751f1d38ccd58ea6eec9d4bea893640317e8", "git_parents": ["a0c454b78181ba1005a5e976be9cf8329761fd58"], "node": "25d3cd6c882d715ccb4d244137446d187623370d", "parents": ["4c157700fa6c167c7d096085c7860677d598c5d7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065664 [wpt PR 62115] - Update wpt metadata, a=testonly\n\nwpt-pr: 62115\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/WebCryptoAPI/supports-modern.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/supports.tentative.https.any.js.ini"], "git_node": "338d2440f9e5ddcb53fe1399500ecd6932674cea", "git_parents": ["bef4751f1d38ccd58ea6eec9d4bea893640317e8"], "node": "1761e2db6f272f5a6a2f1fc48cb914fc15482d51", "parents": ["25d3cd6c882d715ccb4d244137446d187623370d"], "tags": []}, {"author": "Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2065647 [wpt PR 62108] - [css-mixins] Expose CSSPrivateRule to the CSSOM (2/N), a=testonly\n\nAutomatic update from web-platform-tests\n[css-mixins] Expose CSSPrivateRule to the CSSOM (2/N)\n\nThis CL expands on CL:8228248, which parses @private into a\nStyleRulePrivate object. It exposes that parsed rule to the CSSOM as a\nCSSPrivateRule (behind the CSSPrivate flag): the rule serializes back to\nits serialized form via cssText, and can be read from and inserted into\na style rule's cssRules. @private is still inert for style resolution\nand hygienic-rewrites will be done in a followup CL.\n\nhttps://github.com/w3c/csswg-drafts/issues/14004#issuecomment-5189637234\n\nLow-Coverage-Reason: COVERAGE_UNDERREPORTED\nChange-Id: I86447c620f65f46d326f075691f36770b08923de\nBug: 542651959\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8222046\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCommit-Queue: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1684048}\n\n--\n\nwpt-commits: b05b1b737e0f82d387fdc798b58b3aa85d4981bd\nwpt-pr: 62108\n", "files": ["testing/web-platform/tests/css/css-mixins/private/private-cssom-insert-rule.tentative.html", "testing/web-platform/tests/css/css-mixins/private/private-cssom-serialization.tentative.html"], "git_node": "585af71c6ee943fa00b402b2c54c91a44f9ad1ad", "git_parents": ["338d2440f9e5ddcb53fe1399500ecd6932674cea"], "node": "c75da7b1e52e5a44add62a7bd07bb952dcf8465f", "parents": ["1761e2db6f272f5a6a2f1fc48cb914fc15482d51"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065647 [wpt PR 62108] - Update wpt metadata, a=testonly\n\nwpt-pr: 62108\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-mixins/private/private-cssom-insert-rule.tentative.html.ini", "testing/web-platform/meta/css/css-mixins/private/private-cssom-serialization.tentative.html.ini"], "git_node": "f9a027e1c5c266bce888bcb9f8c157304206aff9", "git_parents": ["585af71c6ee943fa00b402b2c54c91a44f9ad1ad"], "node": "79ed2bf0170f322971c63ae973a1aeec1ff45bf6", "parents": ["c75da7b1e52e5a44add62a7bd07bb952dcf8465f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065819 - [wpt-sync] Update web-platform-tests to b05b1b737e0f82d387fdc798b58b3aa85d4981bd, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: b05b1b737e0f82d387fdc798b58b3aa85d4981bd\nwpt-type: landing\n", "files": ["testing/web-platform/meta/WebCryptoAPI/derive_bits_keys/derived_bits_length.https.any.js.ini", "testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/__dir__.ini", "testing/web-platform/meta/cookiestore/cookieStore_getAll_set_basic.https.any.js.ini", "testing/web-platform/meta/cookiestore/cookieStore_set_arguments.https.any.js.ini", "testing/web-platform/meta/cookiestore/httponly_cookies.https.window.js.ini", "te