ntent-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/content-src/components/Widgets/Privacy/_Privacy.scss", "browser/extensions/newtab/data/content/assets/widget-privacy-etp-off.svg", "browser/extensions/newtab/lib/Widgets/PrivacyFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Privacy.test.jsx", "browser/extensions/newtab/test/xpcshell/test_PrivacyFeed.js", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "10bc3a11195556646d742ec832847dc35c3ebdef", "git_parents": ["86c4004aa41823af07c5a61bed1f97e3f902f58e"], "node": "8bbcc957f1de576c353704b3a6d366220d9ef15b", "parents": ["54e7dab4973238b8707853de700190499c54a25a"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049041 - Part 1: Add catastrophic error handling to vpn locations screen r=android-reviewers,Roger,gmalekpour\n\nThe patch enables the locatoin screen to shown the blocking dialog if\nthe proxy errors out and requires the user to disable vpn to continue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318253\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocationsFragment.kt"], "git_node": "f07fab7778ea5fd544f1340eeecaf6e728765ac0", "git_parents": ["10bc3a11195556646d742ec832847dc35c3ebdef"], "node": "44efbdaef15aec94b7809a144c1f136e3e4bb89d", "parents": ["8bbcc957f1de576c353704b3a6d366220d9ef15b"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049041 - Part 2: Add telemetry for a location switch failure r=android-reviewers,Roger,gmalekpour\n\nAdding a new activation state solves two problems: 1) we handle the\nparticular activation failutre separately, passing the data all the way\nto the TelemetryMiddleware; 2) ToggleFailed was a misguiding name since\nit references to turning on or off, but in our case it is a switch to a\nnew location.\n\nNB that there is no snackbar in that case - that's intentional. The\nswitch implies an active connection, so if proxy does error out at the\nswitch, it will go into catastrophic error state; not a toggle failed\nsnackbar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318300\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Actions.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddleware.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddlewareTest.kt"], "git_node": "1443e6870ef3d6f9218848fece9525d49a5d480b", "git_parents": ["f07fab7778ea5fd544f1340eeecaf6e728765ac0"], "node": "5109efb6ca297e60d8a4cabfa6f394369ef463f1", "parents": ["44efbdaef15aec94b7809a144c1f136e3e4bb89d"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049041 - Part 3: Fold the location switch into the activation request. r=android-reviewers,sfamisa,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321388\n", "