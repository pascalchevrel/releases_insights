com/D318699\n", "files": ["services/sync/modules/bridged_engine.sys.mjs", "services/sync/modules/engines/tabs.sys.mjs"], "git_node": "99fe1f3979e7388771dbb98d6af324b0ab72925f", "git_parents": ["7ff6b346b7e3aa7005722ca3c2355b8f2b2ab769"], "node": "5309c537258c269d7c498c5f69858c116b36f428", "parents": ["bdd5d92461e282ccc8d7e659d381012ddc74884f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062213 - Stop the newtab tests racing a preloaded about:newtab.\n\nA preloaded about:newtab is swapped in under the tab openNewTabPage just opened, so the poll waiting for the bar loses the actor it runs in. Test verification fails on its second iteration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321099\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/head.js"], "git_node": "f3afdf82dcae9cf01bbff5bb4806b77b3880a925", "git_parents": ["99fe1f3979e7388771dbb98d6af324b0ab72925f"], "node": "fe305d65e44876c7f80e5cf18ae763c6c3700f13", "parents": ["5309c537258c269d7c498c5f69858c116b36f428"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2065678 - ./mach test-info testrun-report: detect main branch if Git repository used also in mach_commands.py.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321085\n", "files": ["testing/mach_commands.py", "testing/testinfo.py"], "git_node": "979b44085ff0c7b3947210c9f339c5483186707d", "git_parents": ["f3afdf82dcae9cf01bbff5bb4806b77b3880a925"], "node": "e974421c441bc218d7a9ba135254c886f3bbfee1", "parents": ["fe305d65e44876c7f80e5cf18ae763c6c3700f13"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2065678 - ./mach test-info testrun-report: detect main branch if Git repository used: linting fixes.\n\nDifferential Revision: https://phab