 -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nfi -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nfr -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nfy-NL -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nga-IE -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\ngd -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\ngl -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\ngn -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\ngu-IN -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nhe -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nhi-IN -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nhr -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nhsb -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nhu -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nhy-AM -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nia -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nid -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nis -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nit -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nja -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nka -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nkab -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nkk -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nkm -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nkn -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nko -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nlij -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nlo -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nlt -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nltg -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nlv -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nmeh -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nmix -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nml -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nmr -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nms -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nmy -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nnb-NO -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nne-NP -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nnl -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nnn-NO -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\noc -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\npa-IN -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\npl -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\npt-BR -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\npt-PT -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nrm -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nro -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nru -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nsk -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nsl -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nson -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nsq -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nsr -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nsv-SE -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nta -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nte -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nth -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\ntl -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\ntr -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\ntrs -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nuk -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nur -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nuz -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nvi -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nwo -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nxh -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nzam -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nzh-CN -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\nzh-TW -\u003e 32ed75b50ab9726923efb03091e62a683a4c708b\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "804300111d7aa0e09c85f97635d2ad6b7a4ca15c", "git_parents": ["72dbcf6237468d82f30bcabb9f91b2625abdee84"], "node": "4e72151eca5554da27f7e528abdd72478024cf83", "parents": ["dcec5bd31e825f48736163e2e1749a5b29891971"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2065084 - Escape backslashes when embedding a path in parsemark's JS template. r=arai\n\nos.path.join can generate paths with backslashes, and the string is embedded into the JS string literal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320074\n", "files": ["js/src/tests/parsemark.py"], "git_node": "49136a33404dd790c7f282955bbf93b9b4222705", "git_parents": ["804300111d7aa0e09c85f97635d2ad6b7a4ca15c"], "node": "5ac428096734cc8ef3b314d3578f1686069198fe", "parents": ["4e72151eca5554da27f7e528abdd72478024cf83"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054163 - [devtools] Wait for scroll to stabilize in browser_webconsole_console_group_open_no_scroll.js r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320034\n", "files": ["devtools/client/webconsole/test/browser/browser_webconsole_console_group_open_no_scroll.js"], "git_node": "9a7f16303765cfa8e8c75a0b98875e7b8b1e110f", "git_parents": ["49136a33404dd790c7f282955bbf93b9b4222705"], "node": "49b4cd20b74e699876188ab352f70e239bf0bb43", "parents": ["5ac428096734cc8ef3b314d3578f1686069198fe"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033123 - Improve `./mach uniffi generate` output r=nalexander,firefox-build-system-reviewers\n\nWe now also report:\n- What Android bindings were generated.\n- That the command finished successfully.\n\nAnd `--no-completion-messages` is now passed to the\nnested `./mach build`, so it no longer reports\nsuccess before the whole command has finished.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318373\n", "files": ["toolkit/components/uniffi-bindgen-gecko-js/mach_commands.py"], "git_node": "a3a6c0b9eeb18f673b92fdb5a907bd3bdb65ee2a", "git_parents": ["9a7f16303765cfa8e8c75a0b98875e7b8b1e110f"], "node": "9617fa6cc7e842c62af59b26ba3f926fc92a153c", "parents": ["49b4cd20b74e699876188ab352f70e239bf0bb43"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Package `libmegazord.so` as an extra archive for downstream consumers r=nalexander,firefox-build-system-reviewers\n\nThe desktop `libsForTests` JAR needs `libmegazord.so` for JVM unit tests to\nrun. Produce a `target.libmegazord_so_artifacts.zip` from the built\n`libmegazord.so` at package time and upload it for downstream consumers.\n\nOn desktop the megazord is a non-default `uniffi-target`, so a normal build\nnever produces it. Add a `MOZ_LIBMEGAZORD_ARTIFACTS` option that builds the\nmegazord as part of the default build, so `libmegazord.so `exists by the\ntime package runs and the package step archives it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292601\n", "files": ["taskcluster/kinds/build/macosx.yml", "third_party/application-services/megazords/fenix-dylib/moz.build", "third_party/application-services/megazords/full/moz.build", "toolkit/moz.configure", "toolkit/mozapps/installer/package-name.mk", "toolkit/mozapps/installer/packager.mk", "toolkit/mozapps/installer/upload-files.mk"], "git_node": "8d5e2d55eb2de329a7702b95853561083f3f9e75", "git_parents": ["a3a6c0b9eeb18f673b92fdb5a907bd3bdb65ee2a"], "node": "f59460d18424a9a47d084fc93df974803e1bd43d", "parents": ["9617fa6cc7e842c62af59b26ba3f926fc92a153c"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Stage `libmegazord.so` under appservices destdir for `libsForTests` gradle tasks r=nalexander,firefox-build-system-reviewers,geckoview-reviewers,sergesanspaille\n\nlibmegazord.so was being staged into the geckoview output dir, which\nforced it into the GeckoView AAR even when consumers don't want a-s.\nStage it under an appservices destdir instead, so the megazord gradle\nproject picks it up there for its own AAR.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298761\n", "files": ["mobile/android/installer/package-manifest.in"], "git_node": "cfefd2d06bc5dda15227679232e1f92f25c84433", "git_parents": ["8d5e2d55eb2de329a7702b95853561083f3f9e75"], "node": "3bfae93a3f53c595cdee059cf7954ba0725b1569", "parents": ["f59460d18424a9a47d084fc93df974803e1bd43d"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Integrate megazord AAR into fat AAR pipeline alongside geckoview r=nalexander,geckoview-reviewers\n\nThe fat AAR build needs the full-megazord AAR alongside geckoview's. The\nmegazord output lands under `appservices/`, and artifact builds fetch\n`target.maven.zip` so they pick up both AARs.\n\nThe geckoview archive build also publishes every app-services component\n(via `:publishAppServicesAndroid`), not just the megazord, so the\nstandalone android-components and fenix builds can resolve them as Maven\nAARs from `target.maven.zip`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306610\n", "files": ["mobile/android/gradle.configure", "python/mozbuild/mozbuild/action/fat_aar.py"], "git_node": "0a9b29deab780fb3d92f46e92133c180ec08ee90", "git_parents": ["cfefd2d06bc5dda15227679232e1f92f25c84433"], "node": "2d8fa11ba9ed8d7a0fa3bb1b077924979d168733", "parents": ["3bfae93a3f53c595cdee059cf7954ba0725b1569"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030831 - Relax `a-s` version ping on try r=nalexander,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292594\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/DependenciesPlugin.kt"], "git_node": "dcfb1ab7d8c5f055e7e7bfdf5c69b12427ea3f58", "git_parents": ["0a9b29deab780fb3d92f46e92133c180ec08ee90"], "node": "96b3ea516acf0a91e299cde3bb022ad819f15d22", "parents": ["2d8fa11ba9ed8d7a0fa3bb1b077924979d168733"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Normalize app-services groupId and gate subproject inclusion on dependency-download context r=nalexander,android-reviewers\n\nWhen `MOZ_APPSERVICES_IN_TREE` is set, every gradle consumer that\ndepends on `org.mozilla.appservices:*` should pick up the local\nsubprojects instead of fetching from maven.mozilla.org.\n`ComponentsDependencies` now switches groupId on access based on a flag\nthe settings plugin passes in. The a-s subprojects only load when\n`DOWNLOAD_ALL_GRADLE_DEPENDENCIES` is also set, since standalone\nfenix/focus builds consume a-s as Maven AARs from `target.maven.zip`\ninstead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292607\n", "files": ["gradle/libs.versions.toml", "mobile/android/android-components/plugins/dependencies/src/main/java/DependenciesPlugin.kt", "mobile/android/android-components/settings.gradle", "mobile/android/fenix/settings.gradle", "mobile/android/focus-android/settings.gradle", "taskcluster/kinds/toolchain/android.yml"], "git_node": "cc9172f8ccfbc350bbf37cac3f5bcc460a0ba6f5", "git_parents": ["dcfb1ab7d8c5f055e7e7bfdf5c69b12427ea3f58"], "node": "6486c9763b4018f12d0b3a3a937dcf9c27a36cef", "parents": ["96b3ea516acf0a91e299cde3bb022ad819f15d22"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Include NSS runtime dependencies in megazord extra archive for desktop `libsForTests` r=nalexander,firefox-build-system-reviewers\n\nlibmegazord.so depends on NSS shared libs at runtime. Extend the\narchive to also include them (`nss3`, `freebl3`, `softokn3`, etc.),\ngated on the same flags as `services/app-services/nss_libs.mozbuild`.\n\nLink libmegazord.so with an `$ORIGIN` (Linux) or `@loader_path` (macOS)\nrpath so those bundled libraries load from its own directory wherever the\narchive is unpacked. Windows has no rpath and finds them through the\nloader search path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292609\n", "files": ["python/mozbuild/mozbuild/action/package_libmegazord_artifacts.py", "third_party/application-services/megazords/fenix-dylib/moz.build", "toolkit/mozapps/installer/packager.mk"], "git_node": "2ee56ae7d616bafa9b130c57d3725e11b4a47367", "git_parents": ["cc9172f8ccfbc350bbf37cac3f5bcc460a0ba6f5"], "node": "2d5b8957876e3e2db3e9111549510ecb84fd32ee", "parents": ["6486c9763b4018f12d0b3a3a937dcf9c27a36cef"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Extract `libsForTests` native libraries for JVM unit tests r=nalexander,geckoview-reviewers\n\nJVM unit tests load the megazord and NSS libraries through JNA, which\nneeds `jna.library.path` and friends pointing at where those libraries\nlive. Add a Gradle convention that unpacks the `libsForTests` JAR's native\nlibraries through an artifact transform and passes the extracted directory\nto each test task through `jna.library.path` and `java.library.path`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292611\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "88a848b4b851e9372c675074cd2305c05c735df3", "git_parents": ["2ee56ae7d616bafa9b130c57d3725e11b4a47367"], "node": "4fafadaf5483a2b95bc6fe63dab8cf3e630c01e2", "parents": ["2d5b8957876e3e2db3e9111549510ecb84fd32ee"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2064222 - Fenix makes two calls to network connectivity service on every warm applink r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320146\n", "files": ["netwerk/base/NetworkConnectivityService.cpp", "netwerk/test/unit/test_network_connectivity_service_idle_startup.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "cd75387346999754a2bc17dbde7f82979c57ee60", "git_parents": ["88a848b4b851e9372c675074cd2305c05c735df3"], "node": "91874e9e9b690453cb2a674bb7f9ccca14700217", "parents": ["4fafadaf5483a2b95bc6fe63dab8cf3e630c01e2"], "tags": []}, {"author": "Jon Coppeard \u003cjonco@pobox.com\u003e", "branch": "default", "desc": "Bug 2060114 - Part 1: Refactor code to record atom refs r=sfink\n\nThis moves the OOM handling higher to simplify things.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320127\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/WeakMap.cpp"], "git_node": "8d85d0aaa3abf5d5520e65b7b01581c757e983f4", "git_parents": ["cd75387346999754a2bc17dbde7f82979c57ee60"], "node": "dcf5a8f0cd9a6321eb7427cdad6bd2c09a6f9074", "parents": ["91874e9e9b690453cb2a674bb7f9ccca14700217"], "tags": []}, {"author": "Jon Coppeard \u003cjonco@pobox.com\u003e", "branch": "default", "desc": "Bug 2060114 - Part 2: Take lock when updating atom references while concurrent marking is happening r=sfink\n\nTODO: Check when we need to take lock. We shouldn't need to expand the table\nwhen called from marking code, although we will need to from the main thread.\nSo we will need to lock when reading in CM.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320128\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/Cell.h", "js/src/gc/GC-inl.h", "js/src/gc/GCMarker.h", "js/src/vm/MutexIDs.h"], "git_node": "bf692f04cf1e16b90a25eb7e52f414068991942a", "git_parents": ["8d85d0aaa3abf5d5520e65b7b01581c757e983f4"], "node": "42ce61f34d58e22a1d1cada1ad322ab4c0f4e185", "parents": ["dcf5a8f0cd9a6321eb7427cdad6bd2c09a6f9074"], "tags": []}, {"author": "Jon Coppeard \u003cjonco@pobox.com\u003e", "branch": "default", "desc": "Bug 2060114 - Part 3: Add testcase to exercise atom reference locking under concurrent marking r=sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320129\n", "files": ["js/src/jit-test/tests/gc/bug-2060114.js"], "git_node": "fd8a59d257bac023c464a56049f1cfeb328082ee", "git_parents": ["bf692f04cf1e16b90a25eb7e52f414068991942a"], "node": "312fe94639a35027a527967bbfc8fc902d58377d", "parents": ["42ce61f34d58e22a1d1cada1ad322ab4c0f4e185"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2064224 [Linux] Skip Vulkan HW decode in case of avcodec_get_hw_frames_parameters() failure r=tboiko,media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320066\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp"], "git_node": "9ae09e13d4e56a7dfca82add65ed0fd66ed8014a", "git_parents": ["fd8a59d257bac023c464a56049f1cfeb328082ee"], "node": "81385831109e178e4e74f306f498ddab48d9074e", "parents": ["312fe94639a35027a527967bbfc8fc902d58377d"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2061267 - Use std::string_view directly. r=platform-i18n-reviewers,jfkthame\n\nCurrently, `FluentBuiltInNumberFormatterCreate` uses `std::string` to\npass the arguments as `std::string_view`. But this scope is incorrect.\n\nSimply, we should use `std::string_view` directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319982\n", "files": ["intl/l10n/FluentBundle.cpp"], "git_node": "3bdeae802251ea518f3e3071c4405c7bab3db2cd", "git_parents": ["9ae09e13d4e56a7dfca82add65ed0fd66ed8014a"], "node": "c7d7de044304dd42adc0c2c983ea29855fdd3ab0", "parents": ["81385831109e178e4e74f306f498ddab48d9074e"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063169 - Add WR_FEATURE_SUPERELLIPSE variant to ps_quad_mask. r=gfx-reviewers,nical\n\nSplit expensive superellipse calculations in a separate shader variant.\n\nSpeeds up startup time by skipping the compilation of the complex shader,\nloading it lazily instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319577\n", "files": ["gfx/wr/webrender/res/ps_quad_mask.glsl", "gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_build/src/shader_features.rs"], "git_node": "0a6758960cfb3b1ac1816d3bf50a40494366217d", "git_parents": ["3bdeae802251ea518f3e3071c4405c7bab3db2cd"], "node": "8e96505606980b141fec194759b13e04ba844510", "parents": ["c7d7de044304dd42adc0c2c983ea29855fdd3ab0"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063169 - Add WR_FEATURE_SUPERELLIPSE variant to ps_quad_box_shadow. r=gfx-reviewers,nical\n\nSplit expensive superellipse calculations in a separate shader variant to load it lazily instead and speedup startup time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319796\n", "files": ["gfx/wr/webrender/res/ps_quad_box_shadow.glsl", "gfx/wr/webrender/src/pattern/box_shadow.rs", "gfx/wr/webrender/src/pattern/mod.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_build/src/shader_features.rs"], "git_node": "dff8d3e1893b24a08b1d71df756ca0f334c4382f", "git_parents": ["0a6758960cfb3b1ac1816d3bf50a40494366217d"], "node": "a144b6d6bf9ea4da8af8241de02b43d770aa5a55", "parents": ["8e96505606980b141fec194759b13e04ba844510"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2063169 - Disable browser_window_sizing.js on Windows opt standalone. r=devtools-reviewers,jdescottes\n\nThe test reads window.outerWidth and screen.* from the content process right\nafter setViewportSize resolves. In an RDM pane those values come from the last\ndimensions the parent sent the content process, and the parent only sends them\nfrom its refresh driver tick, in nsRefreshDriver::Tick -\u003e\nUpdateRemoteFrameEffects. setViewportSize resolves before that happens, so the\ntest can measure the pre-RDM size.\n\nOn this configuration the test loses that race consistently, which blocks the\nWR_FEATURE_SUPERELLIPSE shader patches from landing. Disable it there while the\ntest fix is reviewed separately.\n\nbrowser_viewport_changed_meta.js and browser_viewport_zoom_resolution_invariant.js\nare already disabled on the same configuration for related races.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320211\n", "files": ["devtools/client/responsive/test/browser/browser.toml"], "git_node": "f7f450757e556a28dbd150cd9bdf542a1a01cb99", "git_parents": ["dff8d3e1893b24a08b1d71df756ca0f334c4382f"], "node": "4017a618fb496f5dfc75467be94244e7b68964e8", "parents": ["a144b6d6bf9ea4da8af8241de02b43d770aa5a55"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064194 part 1 - Make the tabbrowser's lazy-browser insertion public API. r=tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320067\n", "files": ["browser/components/extensions/parent/ext-tabs.js", "browser/components/sessionstore/test/browser_615394-SSWindowState_events_duplicateTab.js", "browser/components/sessionstore/test/browser_615394-SSWindowState_events_setTabState.js", "browser/components/sessionstore/test/browser_906076_lazy_tabs.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tabs.js", "testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs"], "git_node": "60164321191964e3d548570e53361237863b3baf", "git_parents": ["f7f450757e556a28dbd150cd9bdf542a1a01cb99"], "node": "f3aac6d2df8166755be7def1f70301aad9763d2a", "parents": ["4017a618fb496f5dfc75467be94244e7b68964e8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064194 part 2 - Stop reaching into the tabbrowser's internals from outside it. r=tabbrowser-reviewers,fxview-reviewers,webcompat-reviewers,nsharpley,twisniewski\n\nSanitizer gets a public method for the one field it touched. The dropped `_multiSelectedTabsSet` assertions are redundant with the `multiselected` checks beside them, since a tab's `multiselected` attribute and its membership in that set are always updated together.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320068\n", "files": ["browser/components/firefoxview/tests/browser/browser_firefoxview_tab.js", "browser/components/reportbrokensite/ReportBrokenSite.sys.mjs", "browser/components/sessionstore/test/browser_1284886_suspend_tab.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_using_Ctrl.js", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_using_Shift.js", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_using_keyboard.js", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_using_selectedTabs.js", "browser/modules/Sanitizer.sys.mjs"], "git_node": "b37bf3335cefa0c300f0c179267cf1b731ce2542", "git_parents": ["60164321191964e3d548570e53361237863b3baf"], "node": "26556fe69434421de73257892e66dbfcd865a057", "parents": ["f3aac6d2df8166755be7def1f70301aad9763d2a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064194 part 3 - Keep the tabbrowser's pref getters off the instance. r=tabbrowser-reviewers,jsudiaman\n\nThe pref getters that only this module reads move to its `lazy` object, so one observer serves every window instead of one per window. Two more move to the tab context menu, their only consumer. The one that stays is read from two sibling modules, so it becomes public API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320069\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/content/tab-context-menu.js"], "git_node": "346d44db02c484933f5bca03f9df627a43d1124d", "git_parents": ["b37bf3335cefa0c300f0c179267cf1b731ce2542"], "node": "99c1f73bd41cdaa8c12d049450448ea1552b811f", "parents": ["26556fe69434421de73257892e66dbfcd865a057"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064194 part 4 - Drop the tabbrowser's dead _allowTabChange check. r=tabbrowser-reviewers,nsharpley\n\nNothing has set the flag since the old print preview code went away in bug 1702501, so the condition it guarded is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320070\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "690396e99531df0f31a1cf553f7d1b1f08371ad7", "git_parents": ["346d44db02c484933f5bca03f9df627a43d1124d"], "node": "a6ddb740b3f2bcff8101d7fe24d6f3786eabd921", "parents": ["99c1f73bd41cdaa8c12d049450448ea1552b811f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064194 part 5 - Make the tabbrowser's internal members private. r=tabbrowser-reviewers,jsudiaman\n\nNothing outside the class reaches these. The members that its sibling modules and `TabProgressListener` reach keep their underscore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320071\n", "files": ["browser/components/extensions/test/browser/browser_ext_tabs_discard_reversed.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_lazy_tab_browser_events.js", "toolkit/content/tests/browser/browser_f7_caret_