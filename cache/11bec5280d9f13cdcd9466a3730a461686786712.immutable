es/l10n-changesets.json"], "git_node": "8f408ed5d3b9ed9eeab50ceb3a8e76c03921bb70", "git_parents": ["fb6a93bc91e711d203c79deed218f2d9a985d70f"], "node": "cb5610ae1070fd55ff4fa3d06ec31c5ea0a81a8e", "parents": ["a8c7946401ddcabc6fdaea6af658b25f64c56e33"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2065054 - Don't normalize image mask polygon points by the external scroll offset r=gfx-reviewers,nical\n\npolygon_contains_point treats an ImageMaskClip's points as relative to the\nmask rect's origin, so they carry no external scroll offset. Shifting them\nin define_clip_image_mask displaced them from the already-normalized rect,\nculling every hit-test item under a clip-path: polygon() once its scroll\nframe had scrolled. Rendering was unaffected; only the hit tester reads the\npolygon.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320289\n", "files": ["gfx/layers/apz/test/mochitest/helper_hittest_clippath_scrolled.html", "gfx/layers/apz/test/mochitest/test_group_hittest-2.html", "gfx/wr/webrender_api/src/display_list.rs"], "git_node": "a5e9750e1fcf026c77ba66327d8334037bd99f4e", "git_parents": ["8f408ed5d3b9ed9eeab50ceb3a8e76c03921bb70"], "node": "5576883d11d38850e2c4ecdddfca02a00d6051bc", "parents": ["cb5610ae1070fd55ff4fa3d06ec31c5ea0a81a8e"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings ct-logs - r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320747\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/newtab-section-layouts.json", "services/settings/dumps/main/newtab-sections-ordering.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "2a8970711b1469f64641dc79f12e6ba7b534218f", "git_parents": ["a5e9750e1fcf026c77ba66327d8334037bd99f4e"], "node": "6003544de892d45a66a703045a5d5787d1819e54", "parents": ["5576883d11d38850e2c4ecdddfca02a00d6051bc"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2061393 - Validate the content compositor bridge namespace and reject live pipeline id collisions. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318237\n", "files": ["gfx/ipc/GPUParent.cpp", "gfx/ipc/GPUParent.h", "gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/GPUProcessManager.h", "gfx/ipc/PGPU.ipdl", "gfx/layers/ipc/CompositorManagerParent.cpp", "gfx/layers/ipc/CompositorManagerParent.h", "gfx/layers/wr/AsyncImagePipelineManager.h", "gfx/layers/wr/WebRenderBridgeParent.cpp"], "git_node": "72d17dcee33453204d14fa6197fe43a4d3ab623e", "git_parents": ["2a8970711b1469f64641dc79f12e6ba7b534218f"], "node": "94678b10b00085ba80af68f18ecb4eb7ce1f1c56", "parents": ["6003544de892d45a66a703045a5d5787d1819e54"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-cak/strings.xml", "mobile/android/fenix/app/src/main/res/values-fi/strings.xml", "mobile/android/fenix/app/src/main/res/values-in/strings.xml", "mobile/android/fenix/app/src/main/res/values-ka/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml"], "git_node": "b61db4744efedb05d723592d977ab010e5d503a7", "git_parents": ["72d17dcee33453204d14fa6197fe43a4d3ab623e"], "node": "6095860581e78c5b46197a7756871322720851a7", "parents": ["94678b10b00085ba80af68f18ecb4eb7ce1f1c56"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065968 - Update JSON-java to version 20260814. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320760\n", "files": ["gradle/libs.versions.toml"], "git_node": "d3392f9363d6c4c3b3c0437bfcd3d3352ae869a2", "git_parents": ["b61db4744efedb05d723592d977ab010e5d503a7"], "node": "8aceb29033195d027fc4ca1307dde43b4e4363d3", "parents": ["6095860581e78c5b46197a7756871322720851a7"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065968 - Update JUnit to version 6.1.3. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320761\n", "files": ["gradle/libs.versions.toml"], "git_node": "56cff36e014e428f41e731ff1f9b85269816fa02", "git_parents": ["d3392f9363d6c4c3b3c0437bfcd3d3352ae869a2"], "node": "aba2e7bfa1aba2cc7edb7c08111244c88b7b0d90", "parents": ["8aceb29033195d027fc4ca1307dde43b4e4363d3"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065968 - Update OkHttp to version 5.5.0. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320762\n", "files": ["gradle/libs.versions.toml"], "git_node": "35dd7f48144bf348273db0956bfd48a4517dc4c5", "git_parents": ["56cff36e014e428f41e731ff1f9b85269816fa02"], "node": "d2edfb18214cd2d882213eda046bb29b1900bb4c", "parents": ["aba2e7bfa1aba2cc7edb7c08111244c88b7b0d90"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065968 - Update Google Play Services Base to version 18.10.1. r=android-reviewers,adhingra\n\nThe POM also moves play-services-basement from 18.10.0 to 18.11.0, which doesn't change any\nbehavior for our usage of the library.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320763\n", "files": ["gradle/libs.versions.toml"], "git_node": "b7b9048c7e7a4f393de37a1a98cb0cad25d5f83f", "git_parents": ["35dd7f48144bf348273db0956bfd48a4517dc4c5"], "node": "48d08660f64fd779d743b074c937f1abdaf01b98", "parents": ["d2edfb18214cd2d882213eda046bb29b1900bb4c"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2062742 - Snap picture cache slice content on the slice's own raster grid r=gfx-reviewers,nical\n\nA slice composites its tiles 1:1 at a rounded device offset, so its content is\nrasterized on the slice's own grid - where quad coverage rounding and glyph pen\nsnapping already happen. The frame-time rect pass was the last thing snapping\nagainst the root.\n\nWhen a slice's node sits at a fractional device offset (a scroll root under a\nnon-snapping reference frame), a rect snapped on the root grid lands at x.5 in\nthe slice's space. The coverage rounding in quad.rs quantizes that away again,\nand since bug 2049363 keeps the pattern rect exact, the displaced coverage crops\na cached border corner by up to half a device pixel and repeats clamped texels\non the other side, so borders come out clipped rather than merely shifted.\n\nSnap against the surface's raster node whenever the surface snaps; that node is\nthe root for every surface except a tile cache. content_transform is relative to\nthe coordinate system root and carries no device scale, so the surface's\ndevice_pixel_scale is applied on top.\n\nThe bug 2004666 tests asserted the mechanism, snapping against the root; they\nnow assert the outcome it was reaching for - that snapped content composites on\nwhole device pixels, which the rounded composite offset makes true in the\nslice's own space and false against the root.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320305\n", "files": ["gfx/wr/webrender/src/space.rs", "gfx/wr/wrench/reftests/snap/reftest.list", "gfx/wr/wrench/reftests/snap/slice-scroll-root-snap-ref.yaml", "gfx/wr/wrench/reftests/snap/slice-scroll-root-snap.yaml"], "git_node": "be840e265725d162b649523feff7c126633bcf9e", "git_parents": ["b7b9048c7e7a4f393de37a1a98cb0cad25d5f83f"], "node": "1238e61a058ed01491e82c19ba01e5a255271696", "parents": ["48d08660f64fd779d743b074c937f1abdaf01b98"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065364 - Fix assertion failure when suspending with JS_IS_CONSTRUCTING on the stack. r=iain\n\nThe test also covers `yield*`, spread, and `.return(..)` cases. These are all\ncomplicated so it seemed worth testing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320352\n", "files": ["js/src/jit-test/tests/generators/resume-constructing.js", "js/src/jit/WarpCacheIRTranspiler.cpp"], "git_node": "dde89a1fb28ea9d6a2f82aad23a11287cbfc47e7", "git_parents": ["be840e265725d162b649523feff7c126633bcf9e"], "node": "b02f2c45258ab7a01113642bac2b1df16f5a827c", "parents": ["1238e61a058ed01491e82c19ba01e5a255271696"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["netwerk/sctp/src/win32-free.patch", "netwerk/sctp/src/win32-rands.patch"], "git_node": "017a9913bd6c272a859aea16d3cab5a4d46bf1b0", "git_parents": ["153093eba12ff2c9e9b81a00c8a92fb2e5cd7f72", "dde89a1fb28ea9d6a2f82aad23a11287cbfc47e7"], "node": "69981ff91c5ff9d587d6b8e76c2ccce4fddf6794", "parents": ["f7d07393995ef8e17338256d249df9b86204baf0", "b02f2c45258ab7a01113642bac2b1df16f5a827c"], "tags": []}], "date": 1787564047, "git_changesets": ["192ec0b0c589f195e2a5bfa9a5cd16af791c1314", "995eddcd7d07fd34597c3ba7ad2d7ddd2893b05b", "dfc601359983d4ffde5bb63aa53a137736d9a68c", "58d6e0fbdebc083c660c48bb6d75e0a8851cd1f7", "c3ab64b113cb2c029bb22bc5c030ec271d60195c", "fb6a93bc91e711d203c79deed218f2d9a985d70f", "8f408ed5d3b9ed9eeab50ceb3a8e76c03921b