16c643f866bc04f35b092", "parents": ["38b2c5c6061e6d335c78f610c3b218b013101a0c"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064973 - Remove network.cookies.open_error glean counter r=cookie-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320112\n", "files": ["netwerk/cookie/CookiePersistentStorage.cpp", "netwerk/metrics.yaml"], "git_node": "cb2eb836e446fb5f7aafaa4013ec27874ce1a25e", "git_parents": ["be66afd1ac9fdd6c44827a42551c1fd602412378"], "node": "b21ed114258a0143d03c39df286a5d0c084e7e6a", "parents": ["40f47a2024f9142a50016c643f866bc04f35b092"], "tags": []}, {"author": "Sarah Chung \u003csachung@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033556 - add full bleed responsive image options for ActivationWindowMessage r=omc-reviewers,nina-py,andhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317865\n", "files": ["browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/extensions/newtab/content-src/components/ActivationWindowMessage/ActivationWindowMessage.jsx", "browser/extensions/newtab/content-src/components/ActivationWindowMessage/_ActivationWindowMessage.scss", "browser/extensions/newtab/docs/v2-system-addon/activation-window.md"], "git_node": "62007c6b55c829516df4f26a5a04b0ab1c53c971", "git_parents": ["cb2eb836e446fb5f7aafaa4013ec27874ce1a25e"], "node": "6bc90db73856388b025170e78221bfd2885fea90", "parents": ["b21ed114258a0143d03c39df286a5d0c084e7e6a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1963352 - Unship the :-moz-placeholder pseudo-class. r=firefox-style-system-reviewers,dshin\n\nNote that this is different from the ::-moz-placeholder pseudo-element.\n\nThis was a compat hack from ages ago and has never matched anything, see\nbug 1366709 where we introduced it for stylo, and bug 819871 where this\nhack was added.\n\nI think we should try to remove it from content nowadays.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320042\n", "files": ["layout/style/test/test_selectors.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/gecko/selector_parser.rs"], "git_node": "ed38e447cce8a33d768a88877d1a7e0d29f514db", "git_parents": ["62007c6b55c829516df4f26a5a04b0ab1c53c971"], "node": "3be2c02d10cdf5b25953d66de165c719140f7768", "parents": ["6bc90db73856388b025170e78221bfd2885fea90"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2063905 - Validate PostMessage source against innerWindowId, r=dom-core-reviewers,farre\n\nThis is a more reliable mechanism for validating the owning process,\nwhich should avoid edge cases around navigation where the owning process\nfor a BrowsingContext may change while postMessage is being sent.\n\nIf the inner window is gone, this clears out source, in a manner similar\nto PostMessageEvent::Run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319247\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "c732a358c1bf3bd81c2c0577fa926fd829eb528a", "git_parents": ["ed38e447cce8a33d768a88877d1a7e0d29f514db"], "node": "7cd0a88d2deb1b61a795c580d335400a5803f449", "parents": ["3be2c02d10cdf5b25953d66de165c719140f7768"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063169 - Add WR_FEATURE_SUPERELLIPSE variant to ps_quad_mask. r=gfx-reviewers,nical\n\nSplit expensive superellipse calculations in a separate shader variant.\n\nSpeeds up startup time by skipping the compilation of the complex shader,\nloading it lazily instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319577\n", "files": ["gfx/wr/webrender/res/ps_quad_mask.glsl", "gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_build/src/shader_features.rs"], "git_node": "310a65b0bb4ffcbd6fe638e96eb867b071bee755", "git_parents": ["c732a358c1bf3bd81c2c0577fa926fd829eb528a"], "node": "f70b0ea9523e34ea345d9ee7d029b00a5ccc7cdf", "parents": ["7cd0a88d2deb1b61a795c580d335400a5803f449"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063169 - Add WR_FEATURE_SUPERELLIPSE variant to ps_quad_box_shadow. r=gfx-reviewers,nical\n\nSplit expensive superellipse calculations in a separate shader variant to load it lazily instead and speedup startup time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319796\n", "files": ["gfx/wr/webrender/res/ps_quad_box_shadow.glsl", "gfx/wr/webrender/src/pattern/box_shadow.rs", "gfx/wr/webrender/src/pattern/mod.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_build/src/shader_features.rs"], "git_node": "cf28185781130669dc30cd11277e32d58a23cd38", "git_parents": ["310a65b0bb4ffcbd6fe638e96eb867b071bee755"], "node": "98ba052a5ee89cf7e43e0ff5825238109502f82d", "parents": ["f70b0ea9523e34ea345d9ee7d029b00a5ccc7cdf"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064829 - Add missing reference targets to bug-mgmt documentation. r=freddyb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320049\n", "files": ["docs/bug-mgmt/processes/fixing-security-bugs.md", "docs/bug-mgmt/processes/security-approval.md", "docs/contributing/how_to_submit_a_patch.md"], "git_node": "fd8dbc13a269ad838378144e230aee796be1c55e", "git_parents": ["cf28185781130669dc30cd11277e32d58a23cd38"], "node": "a625e16f38ff61dfc34242e7040ed78a6f801a86", "parents": ["98ba052a5ee89cf7e43e0ff5825238109502f82d"], "tags": []}, {"author": "Krist Baliev \u003ckbaliev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062242 - Adjust wording for doorhanger option to never save addresses. r=mtigley,fluent-reviewers,bolsson,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319467\n", "files": ["browser/locales/en-US/browser/preferences/formAutofill.ftl", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs"], "git_node": "e5ed6ec9f10c65dce30aee3a1aaacc51608b8f63", "git_parents": ["fd8dbc13a269ad838378144e230aee796be1c55e"], "node": "027ee4b826ef3cf2ef89431c42ff69d53a926587", "parents": ["a625e16f38ff61dfc34242e7040ed78a6f801a86"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064079 - Check in ktfmt idea configuration into tree r=adhingra,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319183\n", "files": [".idea/ktfmt.xml", "moz.build"], "git_node": "b15d4be261014f9f261201977cb1aa0076284217", "git_parents": ["e5ed6ec9f10c65dce30aee3a1aaacc51608b8f63"], "node": "dc0806ce39fe6668033feccbaea4679bfaf27249", "parents": ["027ee4b826ef3cf2ef89431c42ff69d53a926587"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059563 - Run emulated startup tests on autoland, not central. r=perftest-reviewers,mozperftest-reviewers,afinder,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315440\n", "files": ["taskcluster/kinds/perftest/android-emulator.yml"], "git_node": "8d0f1ce5d409865149f90c8e6f2c092a6b15466a", "git_parents": ["b15d4be261014f9f261201977cb1aa0076284217"], "node": "a7fd5f5c75ed7b0a9a41f2c4c8a2d0c44684575f", "parents": ["dc0806ce39fe6668033feccbaea4679bfaf27249"], "tags": []}, {"author": "elkal98 \u003ckhalid.alhaddad98@gmail.com\u003e", "branch": "default", "desc": "Bug 2040974 - [remote] Use a custom exit code when Marionette or RemoteAgent fail to start their server. r=whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306987\n", "files": ["remote/components/Marionette.sys.mjs", "remote/components/RemoteAgent.sys.mjs", "testing/marionette/harness/marionette_harness/tests/unit/test_marionette.py"], "git_node": "2f9db142371f9af886008e7d370f272ed01f2912", "git_parents": ["8d0f1ce5d409865149f90c8e6f2c092a6b15466a"], "node": "40b8b88dd9397ffcabbb397c10e38ac466e6c315", "parents": ["a7fd5f5c75ed7b0a9a41f2c4c8a2d0c44684575f"], "tags": []}, {"author": "Kenneth Langga \u003cklangga@gmail.com\u003e", "branch": "default", "desc": "Bug 2059329 - Add a pref-gated Rust XDG notification portal backend. r=saschanaz,gtk-reviewers,emilio\n\nThis is the first step of a progressive series and deliberately covers\nonly showing a minimal notification: a synchronous AddNotification call\nwith title and body. Actions, replacement, explicit close, and\nnonblocking calls will follow in succeeding commits.\n\nThe backend is selected at service creation when\nShouldUsePortal(PortalKind::Notification) allows the portal; the auto\nbehavior of widget.use-xdg-desktop-portal.notification resolves to\nfalse while the backend is not feature complete, so it is opt-in via\nthe pref for now. There is no runtime fallback to libnotify: if the\nportal cannot show notifications, libnotify is unlikely to work either.\nBuilds without D-Bus no longer create a system alerts service.\n\nKnown limitations until the follow-ups land: portal-shown notifications\ncannot be closed or withdrawn at shutdown, and callback state is\nreleased right after OnAlertShow because alert interaction is not\nimplemented yet, so alertfinished fires while the notification is still\nvisible.\n\nErrors do not disable the backend; a dead session-bus connection is\ndropped and reconnected on the next call. A reply timeout is reported\nas a failure even though the portal may still show the notification\nafterwards.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316532\n", "files": ["Cargo.lock", "modules/libpref/init/StaticPrefList.yaml", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs", "toolkit/system/gnome/components.conf", "toolkit/system/gnome/nsSystemAlertsService.cpp", "toolkit/system/gnome/rust/Cargo.toml", "toolkit/system/gnome/rust/src/PortalAlertsService.h", "toolkit/system/gnome/rust/src/lib.rs", "toolkit/system/gnome/rust/src/portal_alerts_service.rs", "widget/gtk/WidgetUtilsGtk.cpp", "widget/gtk/WidgetUtilsGtk.h"], "git_node": "4ea750cd8dfae3479daa2ad1002794b3bd1b8f34", "git_parents": ["2f9db142371f9af886008e7d370f272ed01f2912"], "node": "ce3fc22ddb5dbae2e70945e3b370fcff20c490e2", "parents": ["40b8b88dd9397ffcabbb397c10e38ac466e6c315"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064093 - Part 1: Add a GC zeal mode to insert pauses to make triggering races easier r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319424\n", "files": ["js/src/gc/GC.cpp", "js/src/gc/GC.h", "js/src/gc/GCEnum.h", "js/src/gc/Verifier.cpp", "js/src/jit-test/tests/gc/gczeal.js"], "git_node": "9f15e18a6e9961389fb10b0d02503de9e2785a33", "git_parents": ["4ea750cd8dfae3479daa2ad1002794b3bd1b8f34"], "node": "71e38463d8070e364b3aeeb591885eb6e305e1a2", "parents": ["ce3fc22ddb5dbae2e70945e3b370fcff20c490e2"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064093 - Part 2: Add test for chaging objects to dictionary mode under concurrent marking r=jandem\n\nI used claude to write this test case which combined with the delay reliably\ncauses a crash.\n\nBetween setShape and setDictionaryModeSlotSpan below, obj's shape reports\nisDictionary() but the slots header's dictionary slot span has not been\nupdated, so tracing computes the wrong slot count.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319425\n", "files": ["js/src/jit-test/tests/gc/concurrent-marking-dictionary-mode-slot-span-race.js", "js/src/vm/Shape.cpp"], "git_node": "6d489cb88597bb9e0ec3c7554fd79ae4885d2f71", "git_parents": ["9f15e18a6e9961389fb10b0d02503de9e2785a33"], "node": "103bf71ee5c9df09d4ab45ba511b57790db30b15", "parents": ["71e38463d8070e364b3aeeb591885eb6e305e1a2"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064093 - Part 3: Update object's dictionary slot count before setting the shape to fix race under concurrent marking r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319426\n", "files": ["js/src/vm/NativeObject-inl.h", "js/src/vm/Shape.cpp"], "git_node": "672c7702d613faf7a23c1dfe86f304d2a00b6ebe", "git_parents": ["6d489cb88597bb9e0ec3c7554fd79ae4885d2f71"], "node": "7edf37a0af33b61ce4f4b02d7868c11d550b4c88", "parents": ["103bf71ee5c9df09d4ab45ba511b57790db30b15"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047032: Handle no time being set when switching into document timeline from scroll timeline. r=layout-scroll-driven-animation-reviewers,boris\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319811\n", "files": ["dom/animation/Animation.cpp", "testing/web-platform/tests/scroll-animations/crashtests/change-timeline-from-finite-to-monotonic-crash-002.html"], "git_node": "252e2c3d83f51e51fb1b890be70629546e802d05", "git_parents": ["672c7702d613faf7a23c1dfe86f304d2a00b6ebe"], "node": "6ad3d9d2f2bbc98380ad15b1f8c4cc12c17af897", "parents": ["7edf37a0af33b61ce4f4b02d7868c11d550b4c88"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058328: Flush layout before timeline.source check in unattached-subject-inset.html. r=layout-scroll-driven-animation-reviewers,boris\n\n... Since looking up timeline source is async as per the following resolution:\nhttps://github.com/w3c/csswg-drafts/issues/13480\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319921\n", "files": ["testing/web-platform/tests/scroll-animations/view-timelines/unattached-subject-inset.html"], "git_node": "44ef3d6243bf20adc2254edb6317953efb0a5579", "git_parents": ["252e2c3d83f51e51fb1b890be70629546e802d05"], "node": "6c712d76c254ec21b8444e1215435af725bd266a", "parents": ["6ad3d9d2f2bbc98380ad15b1f8c4cc12c17af897"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2061215: Skip argument count checking. r=emilio\n\nThere isn't really any need to test the argument count before passing to `HandleCommandLine`, we don't in the dbus case either.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320085\n", "files": ["toolkit/components/remote/nsXRemoteServer.cpp"], "git_node": "deb41d3e4a31afbffa3dceaab1d1fae432ff703a", "git_parents": ["44ef3d6243bf20adc2254edb6317953efb0a5579"], "node": "2f7c8a36a806b5979c138be5146b77e2d6a50c07", "parents": ["6c712d76c254ec21b8444e1215435af725bd266a"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065153 - Update metadata for html/semantics/interactive-elements/the-summary-element/interactive-content.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320136\n", "files": ["testing/web-platform/meta/html/semantics/interactive-elements/the-summary-element/interactive-content.html.ini"], "git_node": "ba22b44bd88f3d8ee06b300f28e61516111b9747", "git_parents": ["deb41d3e4a31afbffa3dceaab1d1fae432ff703a"], "node": "3d3d4c6f8127bb75eb4ecc44ce9a0bd050232c44", "parents": ["2f7c8a36a806b5979c138be5146b77e2d6a50c07"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063609 - Prevent crash when a content provider fails to return a file name r=android-reviewers,rebecatudor273\n\nFilePicker.enqueueForCleanup() calls Uri.getFileName() to name the temporary file that will be deleted later. Content URIs are processed in getFileNameForContentUris(), which used to query the content provider for OpenableColumns.DISPLAY_NAME column without accounting for some failures:\n\n- ContentResolver.query() re throws whatever the content provider throws. For instance, an unrecognized URI can be rejected with an IllegalArgumentException\n- moveToFirst() returns a boolean telling whether the move succeeded. This value was ignored and getString() could be called with an invalid cursor position, leading to a CursorIndexOutOfBoundsException\n\nBoth cases made Firefox crash. getFileNameForContentUris() now checks moveToFirst() result before calling getString(), and treats a RuntimeException from the query or from the cursor read as \"no name available\". A fallback name is now generated once, at the end of the function.\n\nNew unit tests have been added to cover these cases. The existing tests covering getFileNameForContentUris() have been renamed to use GIVEN ... WHEN ... THEN ... form for consistency.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319723\n", "files": ["mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/android/net/Uri.kt", "mobile/android/android-components/components/support/ktx/src/test/java/mozilla/components/support/ktx/android/net/UriTest.kt"], "git_node": "1961d663da0c7b3636e3e7699ae4ddd2caf27d75", "git_parents": ["ba22b44bd88f3d8ee06b300f28e61516111b9747"], "node": "8b5b009b2b9d66254e9d44b7c02deed5d6f315f5", "parents": ["3d3d4c6f8127bb75eb4ecc44ce9a0bd050232c44"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2059709 - Copy wasm component bytecode out of shared memory before compiling. r=bvisness\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319586\n", "files": ["js/src/wasm/WasmJS.cpp"], "git_node": "df058da5620b6cc118beca48a4340a0bf319fefe", "git_parents": ["1961d663da0c7b3636e3e7699ae4ddd2caf27d75"], "node": "b00a61300e910845af42d8096c6e21862f671722", "parents": ["8b5b009b2b9d66254e9d44b7c02deed5d6f315f5"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064925 - Update string to use Firefox for all channels r=fluent-reviewers,niklas,mconley,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319951\n", "files": ["browser/base/content/aboutDialog.xhtml", "browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-menubar.inc.xhtml", "browser/components/preferences/config/account-sync.mjs", "browser/locales/en-US/browser/aboutDialog.ftl", "browser/locales/en-US/browser/appmenu.ftl", "browser/locales/en-US/browser/menubar.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "python/l10n/fluent_migrations/bug_2064925_referrals_share_firefox.py"], "git_node": "fea3d07805fc404d47f1a261b215b727b62a7163", "git_parents": ["df058da5620b6cc118beca48a4340a0bf319fefe"], "node": "445377ccbe10cffadcc34fcd9389d2259fcd88b0", "parents": ["b00a61300e910845af42d8096c6e21862f671722"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2064979 - Extend metrics expiring at the end of Firefox 156 to 166: networking.http_3_* r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320086\n", "files": ["netwerk/metrics.yaml"], "git_node": "f9de241255f34f5ebb07ae6a8be9d386f605c150", "git_parents": ["fea3d07805fc404d47f1a261b215b727b62a7163"], "node": "858f4c21f10167c090603d79ceee4a0415df93ec", "parents": ["445377ccbe10cffadcc34fcd9389d2259fcd88b0"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2064981 - Extend metrics expiring at the end of Firefox 156 to 166: networking.http_3_* r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320087\n", "files": ["netwerk/metrics.yaml"], "git_node": "9aef3406fc5f7ceb7c1b712a4a2c1307df831b64", "git_parents": ["f9de241255f34f5ebb07ae6a8be9d386f605c150"], "node": "86e1fc51c0633bc1d68a3a3d340e2267e9e3d5b9", "parents": ["858f4c21f10167c090603d79ceee4a0415df93ec"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2064971 - Extend http3.stale_dcb_dcz_cache_entries_purged to 168 r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320117\n", "files": ["netwerk/protocol/http/metrics.yaml"], "git_node": "0754b4a27e563e4b4d1ab0396514519e5b57f998", "git_parents": ["9aef3406fc5f7ceb7c1b712a4a2c1307df831b64"], "node": "d032e3c00012221b6db534d91e03303b70b4719c", "parents": ["86e1fc51c0633bc1d68a3a3d340e2267e9e3d5b9"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058328: Flush layout before timeline.source check in unattached-subject-inset.html. r=layout-scroll-driven-animation-reviewers,boris\" for causing unexpected pass wpt failures\n\nThis reverts commit 44ef3d6243bf20adc2254edb6317953efb0a5579.\n", "files": ["testing/web-platform/tests/scroll-animations/view-timelines/unattached-subject-inset.html"], "git_node": "ba953ed814e9fde78a41183d4e5d211c9bec0ac3", "git_parents": ["0754b4a27e563e4b4d1ab0396514519e5b57f998"], "node": "a0330bc677418bcba2fcc73ad0e85c96cad8e005", "parents": ["d032e3c00012221b6db534d91e03303b70b4719c"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063169 - Add WR_FEATURE_SUPERELLIPSE variant to ps_quad_box_shadow. r=gfx-reviewers,nical\" for causing dt failures at browser/browser_window_sizing.js\n\nThis reverts commit cf28185781130669dc30cd11277e32d58a23cd38.\n\nRevert \"Bug 2063169 - Add WR_FEATURE_SUPERELLIPSE variant to ps_quad_mask. r=gfx-reviewers,nical\"\n\nThis reverts commit 310a65b0bb4ffcbd6fe638e96eb867b071bee755.\n", "files": ["gfx/wr/webrender/res/ps_quad_box_shadow.glsl", "gfx/wr/webrender/res/ps_quad_mask.glsl", "gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/pattern/box_shadow.rs", "gfx/wr/webrender/src/pattern/mod.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_build/src/shader_features.rs"], "git_node": "e9f2aa0c66ca7fa57b5a794190cfe4781ceea000", "git_parents": ["ba953ed814e9fde78a41183d4e5d211c9bec0ac3"], "node": "8757e6cba3e241b69819f5d925359ec241f1dc86", "parents": ["a0330bc677418bcba2fcc73ad0e85c96cad8e005"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064333 - Turn scoped registries on for nightly builds r=dom-core-reviewers,smaug,devtools-reviewers,ochameau\" for causing unexpected ok wpt failures at sanitizer-custom-elements-constructor.html\n\nThis reverts commit a173c556f3e0667cf3238d5c86a2fe2f4b705f31.\n", "files": ["devtools/client/webconsole/test/browser/browser_webconsole_object_inspector_entries.snapshot.mjs", "devtools/shared/tests/objects/AllJavascriptTypes.mjs", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/dom/idlharness.window.js.ini", "testing/web-platform/meta/domparsing/tentative/stream-html-custom-element-sanitizer.html.ini", "testing/web-platform/meta/html/dom/idlharness.https.html.ini"], "git_node": "1812c216a7c417422910e16e271a39d7ca402372", "git_parents": ["e9f2aa0c66ca7fa57b5a794190cfe4781ceea000"], "node": "1566d693834f32951cbd9203984278663f392f19", "parents": ["8757e6cba3e241b69819f5d925359ec241f1dc86"], "tags": []}, {"author": "Vanessa Prema \u003cvprema@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063372 - feat(trustpanel): Add telemetry for breach alert shield animation r=vinilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319592\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/controlcenter/metrics.yaml"], "git_node": "8a429398fd54a4217e0648cfe23987b859d68aea", "git_parents": ["1812c216a7c417422910e16e271a39d7ca402372"], "node": "6b21d3a8fe516bc72b56b8bba4ead6f8888a00ce", "parents": ["1566d693834f32951cbd9203984278663f392f19"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064382 - Fix anti-tracking exception not being applied to new popups r=timhuang\n\nA new popup for e.g. login via google has \"about:blank\" as aTopLevelURI. Getting the\nschemeless site for \"about:blank\" fails and exceptions do not get applied for the\npopup URL (e.g. \"accounts.google.com\").\nFix this by deriving the top level URI from the document principal of the top-level\nwindow global when the document URI is \"about:blank\". Such a document inherits its\nprincipal from its creator. Sandboxed popups keep an opaque origin, so no top level\nURI is derived for them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319463\n", "files": ["netwerk/url-classifier/UrlClassifierCommon.cpp", "toolkit/components/url-classifier/tests/browser/browser.toml", "toolkit/components/url-classifier/tests/browser/browser_popup_tracker.js"], "git_node": "f9acf40b5dfee798ca1d00f8d64ca69cbfb418eb", "git_parents": ["8a429398fd54a4217e0648cfe23987b859d68aea"], "node": "357619cafca3e64466af3237747c6bfbfe7e792c", "parents": ["6b21d3a8fe516bc72b56b8bba4ead6f8888a00ce"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2064158 - Make nsEffectiveTLDService available everywhere, r=necko-reviewers,valentin\n\nCurrently this service is only available in the main and parent\nprocesses, but the data backing it is just stored statically in memory.\n\nThis change makes the entire service become a simple statically\nallocated singleton with a fake reference count, which means it no\nlonger needs main thread initialization.\n\nThe MRU cache is initialized lazily on the main thread, and cleared on\nshutdown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319557\n", "files": ["netwerk/build/components.conf", "netwerk/dns/nsEffectiveTLDService.cpp", "netwerk/dns/nsEffectiveTLDService.h", "xpcom/ds/Dafsa.h", "xpcom/tests/gtest/TestDafsa.cpp"], "git_node": "980317752aef7f31051a87fc90d33a315d8de676", "git_parents": ["f9acf40b5dfee798ca1d00f8d64ca69cbfb418eb"], "node": "c7e80d55ec258f39efd97e1ee4e42a2977e6c0ab", "parents": ["357619cafca3e64466af3237747c6bfbfe7e792c"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996020 - add AlignedMallocOrNull to allow low-mem alloc attempts without crashing. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318846\n", "files": ["third_party/libwebrtc/rtc_base/memory/aligned_malloc.cc", "third_party/libwebrtc/rtc_base/memory/aligned_malloc.h"], "git_node": "d6ec83d509bef017e3fd50cf9c99a32315d9c296", "git_parents": ["980317752aef7f31051a87fc90d33a315d8de676"], "node": "d79be5854fe56d92642014904c4079643e86ace0", "parents": ["c7e80d55ec258f39efd97e1ee4e42a2977e6c0ab"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996020 - Add I420Buffer::CreateOrNull and use it in VideoCaptureImpl::IncomingFrame. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318847\n", "files": ["third_party/libwebrtc/api/video/i420_buffer.cc", "third_party/libwebrtc/api/video/i420_buffer.h", "third_party/libwebrtc/modules/video_capture/video_capture_impl.cc"], "git_node": "16bdcdee01f6392e26f81290015f722df1b78f8c", "git_parents": ["d6ec83d509bef017e3fd50cf9c99a32315d9c296"], "node": "f0c6e846e0d33294378079b83208d1a91c5bf293", "parents": ["d79be5854fe56d92642014904c4079643e86ace0"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2063089 - part 1: rerun alias analysis after loop unrolling.  r=jandem.\n\nMIR-level loop unrolling can have the effect of making some\nMDefinition::loadDependency_ fields become incorrect.  Fixing them up\nincrementally is not easy, so this patch supplies an alternative fix, which is\nto simply recompute them all, after unrolling is complete, by rerunning alias\nanalysis.\n\nChanges:\n\n* UnrollLoops.cpp: free method UnrollAndOrPeelLoop:\n\n  - remove code to fix up loadDependency_ fields during node cloning.  That\n    code is now known to be insufficient, and leaving it in is misleading.\n\n* UnrollLoops.cpp: free method UnrollLoops:\n\n  - control flow change: make an early exit if we have no final candidate loops\n    to unroll.  This allows a few simplifications of the code that follows.\n\n  - for debug builds, invalidate all the loadDependency_ fields so as to catch\n    any subsequent uses\n\n  - rerun alias analysis after loop unrolling, if unrolling changed anything,\n    by calling AccountForCFGChanges.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319428\n", "files": ["js/src/jit/UnrollLoops.cpp"], "git_node": "48020f9e4973070de25e69ad9ebc8fee32628879", "git_parents": ["16bdcdee01f6392e26f81290015f722df1b78f8c"], "node": "82f4168596cf903c22ede6f294f642df9d38b012", "parents": ["f0c6e846e0d33294378079b83208d1a91c5bf293"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2063089 - part 2: test cases for unrolling in the presence of memory dependencies.  r=jandem.\n\nThis patch contains three tricky testcases, all of which have in the past\ndemonstrated incorrect unrolling of loops in the presence of MIR-level\ninter-node memory dependencies.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319429\n", "files": ["js/src/jit-test/tests/wasm/regress/bug2045312.js", "js/src/jit-test/tests/wasm/regress/bug2045575.js", "js/src/jit-test/tests/wasm/regress/bug2063089.js"], "git_node": "9b2523f8167e9874885765719240a7f849333aa9", "git_parents": ["48020f9e4973070de25e69ad9ebc8fee32628879"], "node": "9e1db9bb49d23b24c963f174621128bd4ea3db0e", "parents": ["82f4168596cf903c22ede6f294f642df9d38b012"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065161 - UrlbarShared object has type any again. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320132\n", "files": ["browser/components/urlbar/UrlbarProviderInterventions.sys.mjs", "browser/components/urlbar/UrlbarProviderSearchTips.sys.mjs", "browser/components/urlbar/content/UrlbarShared.mjs"], "git_node": "00f402762fb180381129cc3c2b386ab22023d484", "git_parents": ["9b2523f8167e9874885765719240a7f849333aa9"], "node": "8b7a8c9f4770b3e52cf13fa95b6dfd35b6332a57", "parents": ["9e1db9bb49d23b24c963f174621128bd4ea3db0e"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064086 - Create new UI smoke test to verify Google Lens functionality r=jajohnson\n\nThis new smoke UI test partially automates the manual test that verifies the Google Lens functionality.\n\nThis test verifies two scenarios:\n1. the Google Lens icon is displayed in the edit-mode search bar (available only in normal mode + Google set as default browser) \u003e clicks the button \u003e verifies that the first-run opt-out sheet appears\n2. return to homepage \u003e re-open Lens \u003e \"Try it now\" \u003e camera screen \u003e gallery button \u003e photo picker launches \u003e an image is selected and accepted (handoff to the uploader).\n\nAdding a fix for a navigation issue: the search bar's page anchor was SEARCH_ENGINE_SELECTOR, which the redesigned Home toolbar also shows in display mode, so navigateToPage falsely thought it was already in edit mode and skipped the tap. Fixed by anchoring on the edit-mode-only ADDRESSBAR_SEARCH_BOX.\n\nThe UI test successfully passed 100x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&revision=1112cbd057fe53245e20e710b43319ec5453c3ad | Try ]]\nAll efficiency UI tests successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&revision=1112cbd057fe53245e20e710b43319ec5453c3ad | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319418\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/GoogleLensPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/GoogleLensSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SearchBarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/GoogleLensSearchTest.kt"], "git_node": "e20c8399785f77bc519e716bca36a615ab3648b6", "git_parents": ["00f402762fb180381129cc3c2b386ab22023d484"], "node": "56ca6c5bc3a77f077cf24dcca1ea80ccc8a67258", "parents": ["8b7a8c9f4770b3e52cf13fa95b6dfd35b6332a57"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2064745 - Set layout.css.typed-om.enabled for svg-element-attributeStyleMap.html tests r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320150\n", "files": ["testing/web-platform/meta/svg/styling/svg-element-attributeStyleMap.html.ini"], "git_node": "3654366e0262433c17fe680157892e1e29321629", "git_parents": ["e20c8399785f77bc519e716bca36a615ab3648b6"], "node": "f882c7283cc28c5ffad19ee74801356d2b1509f1", "parents": ["56ca6c5bc3a77f077cf24dcca1ea80ccc8a67258"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058328: Flush layout before timeline.source check in unattached-subject-inset.html. r=layout-scroll-driven-animation-reviewers,boris\n\n... Since looking up timeline source is async as per the following resolution:\nhttps://github.com/w3c/csswg-drafts/issues/13480\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319921\n", "files": ["testing/web-platform/meta/scroll-animations/view-timelines/unattached-subject-inset.html.ini", "testing/web-platform/tests/scroll-animations/view-timelines/unattached-subject-inset.html"], "git_node": "828d2b47684f152fc6ba1dde2260744c5caa23e1", "git_parents": ["3654366e0262433c17fe680157892e1e29321629"], "node": "367125df1ae3ca6fa6fa04674e84bf7b500e3020", "parents": ["f882c7283cc28c5ffad19ee74801356d2b1509f1"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057850 - Bring back browser subdialog tests under Nova pref r=hjones\n\nThe subdialog tests were skipped on the Nova variant because they were\nflaky. Try runs with the tests unskipped show them passing consistently\non Linux 22.04 wayland, Linux 24.04, and macOS 15 aarch64, so the\nskip-ifs are no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319230\n", "files": ["browser/components/preferences/tests/browser-srd.toml", "browser/components/preferences/tests/browser.toml"], "git_node": "a58506e13436aa41e7d52cf0127b32684b4ebf81", "git_parents": ["828d2b47684f152fc6ba1dde2260744c5caa23e1"], "node": "d18c6619e2d7f17f158c34c262dd134d7e19b6a3", "parents": ["367125df1ae3ca6fa6fa04674e84bf7b500e3020"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063023 - Probe native ONNX availability before building the best-onnx pipeline r=ai-platform-reviewers,nordzilla\n\nThe \"best-onnx\" backend optimistically built the native ONNX pipeline and only\nfell back to the wasm backend after native engine creation threw. On systems\nwithout the native runtime this wasted the entire native pipeline build --\ntransformers.js, the tokenizer, and the model -- before failing.\n\nResolve \"best-onnx\" by first running the cheap InferenceSession.isAvailable()\nprobe once per inference process and choosing onnx-native or onnx up front. The\nresult is cached, and concurrent cold-cache resolutions share a single probe. The\nexisting engine-creation fallback stays as a safety net for the case where the\nruntime probes as available but still fails to initialize.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319299\n", "files": ["toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_best_onnx_fallback.js", "toolkit/components/ml/tests/browser/ml_best_onnx_fallback_stub.worker.mjs", "toolkit/components/ml/tests/browser/ml_native_ort_error_stub.worker.mjs", "toolkit/components/ml/tests/browser/ml_native_ort_unavailable_stub.worker.mjs"], "git_node": "1bea19e07f8cb609845691f46ae43e1c6016afec", "git_parents": ["a58506e13436aa41e7d52cf0127b32684b4ebf81"], "node": "211f46fda84b274b8b5e58dd1717d0f93e87f8e1", "parents": ["d18c6619e2d7f17f158c34c262dd134d7e19b6a3"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055837 - use taskcluster-built python for mochitest tasks. r=taskgraph-reviewers,bhearsum\n\nLinux mochitest-chrome-a11y remains on system python because it imports\nthe system gi and pyatspi modules.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312747\n", "files": ["taskcluster/kinds/mochitest/kind.yml"], "git_node": "12415db457fc7adc6c13fda6b3ccc6a9e724b3bc", "git_parents": ["1bea19e07f8cb609845691f46ae43e1c6016afec"], "node": "f02b7a138228a6ab7c890bbf992a0339636e90c6", "parents": ["211f46fda84b274b8b5e58dd1717d0f93e87f8e1"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055837 - use taskcluster-built python for reftest tasks. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312748\n", "files": ["taskcluster/kinds/reftest/kind.yml"], "git_node": "2b7c61324e7f95c1fe18db8688e3f0e1e93163a5", "git_parents": ["12415db457fc7adc6c13fda6b3ccc6a9e724b3bc"], "node": "6ba4f809b9d558f194c7a0c6ed3f2ce65da2bbe5", "parents": ["f02b7a138228a6ab7c890bbf992a0339636e90c6"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055837 - use taskcluster-built python for web-platform-tests tasks. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312749\n", "files": ["taskcluster/kinds/web-platform-tests/kind.yml"], "git_node": "6c323749e63591cd33fc2d121e3c130dd0d6907f", "git_parents": ["2b7c61324e7f95c1fe18db8688e3f0e1e93163a5"], "node": "25e3167a7c2828b1092c36001ec2b91dde2e4978", "parents": ["6ba4f809b9d558f194c7a0c6ed3f2ce65da2bbe5"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047032: Handle no time being set when switching into document timeline from scroll timeline. r=layout-scroll-driven-animation-reviewers,boris\" for causing wpt failures at StickyTimeDuration.h\n\nThis reverts commit 252e2c3d83f51e51fb1b890be70629546e802d05.\n", "files": ["dom/animation/Animation.cpp", "testing/web-platform/tests/scroll-animations/crashtests/change-timeline-from-finite-to-monotonic-crash-002.html"], "git_node": "e26cbf34e72f6feb8824a8e5a371c4a06218607b", "git_parents": ["6c323749e63591cd33fc2d121e3c130dd0d6907f"], "node": "eb9cc18dcfc50502d0808cfe4968618296e6f01c", "parents": ["25e3167a7c2828b1092c36001ec2b91dde2e4978"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062215 - Stretch the input box with CSS instead of the XUL flex attribute. r=desktop-theme-reviewers,emilio,daleharvey\n\nxul.css gives every XUL element `display: flex` and turns `flex=\"1\"` into `flex: 1`, and a content document loads neither, so the box did not stretch across the input container and the input did not fill the box. The shared sheet states both, computing in chrome what chrome computed before.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319713\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/themes/shared/urlbar.css"], "git_node": "7beb0bda95080e53716eb10b98a6a6c8b56f83cb", "git_parents": ["e26cbf34e72f6feb8824a8e5a371c4a06218607b"], "node": "e6b6eedb33e5a30b57e9957a55a523abaa9f7182", "parents": ["eb9cc18dcfc50502d0808cfe4968618296e6f01c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062215 - Keep the buttons' inline inset equal to their block inset. r=mbeier\n\nThe block inset is half the height the buttons leave over, while the inline inset was a flat padding, so a bar an embedder made taller left them close to the inline edge and far from the block ones. Deriving both from the same leftover keeps every chrome configuration where it was, the branch that draws a border on the container taking that border out of the padding.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319714\n", "files": ["browser/themes/shared/urlbar.css"], "git_node": "9e2ff2c08be5b737888b63e1950a4ad8ecb715d1", "git_parents": ["7beb0bda95080e53716eb10b98a6a6c8b56f83cb"], "node": "aa77dff45d5fff919ffc806de0cd5608f95cdfb5", "parents": ["e6b6eedb33e5a30b57e9957a55a523abaa9f7182"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064632 - Reach chrome-only APIs only where they exist. r=mbeier\n\n`isInstance` is chrome-only on every WebIDL interface, as are an input's `editor`, `ReaderMode`, `AIWindow` and `gBrowser`, and a content realm threw on each. `handleEvent` reports such a throw to a console nothing reads, so every symptom was silent: selecting a result did nothing, the down arrow moved the caret, the focus ring outlived the focus, and the switcher's popup kept a redundant separator. Interface checks now go through `UrlbarShared`, which picks an implementation per realm; the composition state comes from the input, which tracks it; an `about:reader` URL shows as it is (bug 2064583); and engines to install need a browser window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319716\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarEventBufferer.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/content/UrlbarTelemetryUtils.mjs", "browser/components/urlbar/content/UrlbarView.mjs"], "git_node": "b63b646cc5a920241029fee48cc7571b84132996", "git_parents": ["9e2ff2c08be5b737888b63e1950a4ad8ecb715d1"], "node": "5dd74ebf7c966891683246a8d536fe1dd0088075", "parents": ["aa77dff45d5fff919ffc806de0cd5608f95cdfb5"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064632 - Notify observers and cancel extension sessions only where they exist. r=mbeier\n\nA content realm has neither an extension input session nor an observer service, and `_on_blur` threw on the former, so nothing after it ran, closing the view included.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319759\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "18c805eb0eb046f725d197760eee669b906f376d", "git_parents": ["b63b646cc5a920241029fee48cc7571b84132996"], "node": "575b533552f6a68310edef6c39f642b3f905d655", "parents": ["5dd74ebf7c966891683246a8d536fe1dd0088075"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062210 - Move the result group and engagement telemetry helpers to UrlbarShared. r=mbeier\n\nThe recorder runs in the realm that shows the results, which cannot reach `UrlbarUtils`, so on New Tab it threw and dropped the engagement events. `isPersistedSearchTermsEnabled` stays behind: persisted search terms are an address bar feature, and a content realm reads them as off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319760\n", "files": ["browser/components/urlbar/UrlbarMuxerStandard.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/content/UrlbarTelemetryUtils.mjs", "browser/components/urlbar/tests/browser-results/browser_hideHeuristic.js", "browser/components/urlbar/tests/unit/test_suggestedIndexRelativeToGroup.js"], "git_node": "7343eb5105ebf13487a3e934a92fea933b13de40", "git_parents": ["18c805eb0eb046f725d197760eee669b906f376d"], "node": "8f4c0f5a5fecbb3300500aba89c7336f08799427", "parents": ["575b533552f6a68310edef6c39f642b3f905d655"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064632 - Take the switcher's open-where decision through the actor. r=mbeier\n\nThis is the route `whereToOpen` already takes for the same call. Dropping the `ignoreAlt` argument it used to pass changes nothing, since the mapping here funnels anything that is not a tab to the current one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319857\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs"], "git_node": "b974800f0ae2a52c2d60958d5499abf3d7f06550", "git_parents": ["7343eb5105ebf13487a3e934a92fea933b13de40"], "node": "548d45e291a3dfbafa98dd73a708b52266a5361c", "parents": ["8f4c0f5a5fecbb3300500aba89c7336f08799427"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062215 - Size the newtab address bar to the search slot. r=mbeier,mconley\n\nThe slot is a fixed height that the handoff button filled, and the constant lives here, so newtab gives the component that height.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319717\n", "files": ["browser/extensions/newtab/content-src/components/Search/_Search.scss"], "git_node": "b3c199c0e9afacd965d6738bb6a6da5310e64668", "git_parents": ["b974800f0ae2a52c2d60958d5499abf3d7f06550"], "node": "c37a48648fcbc1952308a30bb942b46838fd7408", "parents": ["548d45e291a3dfbafa98dd73a708b52266a5361c"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044002 - Remove Get*ArrayLengthAndData APIs that directly access slot r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319970\n", "files": ["js/public/experimental/TypedData.h", "js/src/jsapi-tests/testLargeArrayBuffers.cpp", "js/src/vm/ArrayBufferViewObject.h", "js/src/vm/TypedArrayObject.h"], "git_node": "b17e03bfeeab30f4be2018164a8bcbe36e6f483e", "git_parents": ["b3c199c0e9afacd965d6738bb6a6da5310e64668"], "node": "847571a9f9e8de0f98bf44fc75f126206cebb3cb", "parents": ["c37a48648fcbc1952308a30bb942b46838fd7408"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062976: Fix article language and write it to the readerview page r=android-reviewers,skhan\n\nNeeds manual testing:\n\nOn the device:\n1. Developer options -\u003e USB debugging on\n2. Fenix -\u003e Settings -\u003e Advanced -\u003e Remote debugging via USB on\n\nOn the desktop:\n  3. Open Firefox, go to about:debugging\n  4. Setup -\u003e Enable USB Devices\n  5. Connect the phone, unlock it, accept the ADB prompt\n  6. Select the device in the left panel\n\nTo read the value: click Inspect on the tab, open the Console, and evaluate `document.documentElement.lang`\n\nTest the default path\n1. Pick an article that declares a language. Confirm it first: load the article, and inspect it BEFORE entering reader mode, and check that `document.documentElement.lang` is non-empty.\n2. Enter reader mode.\n3. Evaluate `document.documentElement.lang` on the reader page.\n\nEXPECTED: the article's tag, for example \"fr\" or \"zh-CN\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319873\n", "files": ["mobile/android/android-components/components/feature/readerview/src/main/assets/extensions/readerview/readerview.js"], "git_node": "2cad4cd3913c065143c6544e519a138a39d6b08e", "git_parents": ["b17e03bfeeab30f4be2018164a8bcbe36e6f483e"], "node": "689ddcff2e0f67df2690b4e3fd8de733d7c433c9", "parents": ["847571a9f9e8de0f98bf44fc75f126206cebb3cb"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2056446 - Bypass the load URI delegate when loading about:home r=android-reviewers,jonalmeida\n\n- Load about:home bypassing the load URI delegate, which still adds about:home to the session history so navigating back returns to the homepage.\n- This prevents hitting unwanted loads of about:home and navigation to the native homepage when about:home engine session is recreated from the homepage tab being suspended or in an event where the engine session has been unloaded.\n- When we close all the tabs and undo, keep track selected tab before the tab removal so that when we undo we don't even up showing a blank browser tab because we restored the homepage tab.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317377\n", "files": ["mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/engine/middleware/LinkingMiddleware.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/engine/middleware/LinkingMiddlewareTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/TabsCleanupFeature.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/TabsCleanupFeatureTest.kt"], "git_node": "67797727c73a12ee0bf36e55f6e308624a6989bf", "git_parents": ["2cad4cd3913c065143c6544e519a138a39d6b08e"], "node": "0ba84f5230223e5944a811b57317ddb8ccd7459d", "parents": ["689ddcff2e0f67df2690b4e3fd8de733d7c433c9"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065000 - Enable some new clang 21 warnings. r=firefox-build-system-reviewers,sergesanspaille\n\nEnable four warnings, three of which are new in clang 21:\n\n* -Wimplicit-int-enum-cast: catches some implicit conversions from int\n  to enum\n\n* -Woctal-prefix-extension: catches clang's nonstandard 0o octal prefix,\n  which gcc does not support\n\n* -Wshift-bool: catches right shifting a bool, which implicitly converts\n  it to int\n\n* -Wvector-conversion: catches implicit conversions between incompatible\n  SIMD vector types\n\nhttps://releases.llvm.org/21.1.0/tools/clang/docs/DiagnosticsReference.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319986\n", "files": ["build/moz.configure/warnings.configure"], "git_node": "e9d15114030c0366ba87f00f8a427b550deebb74", "git_parents": ["67797727c73a12ee0bf36e55f6e308624a6989bf"], "node": "3a8224944aec9b593a916fbe2c0aec681913a3f0", "parents": ["0ba84f5230223e5944a811b57317ddb8ccd7459d"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065050 - [devtools] Add moz log for devtools adb helpers r=devtools-reviewers,ochameau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320028\n", "files": ["devtools/client/shared/remote-debugging/adb/adb-binary.js", "devtools/client/shared/remote-debugging/adb/adb-client.js", "devtools/client/shared/remote-debugging/adb/adb-logger.js", "devtools/client/shared/remote-debugging/adb/adb-process.js", "devtools/client/shared/remote-debugging/adb/adb-running-checker.js", "devtools/client/shared/remote-debugging/adb/adb-socket.js", "devtools/client/shared/remote-debugging/adb/commands/list-devices.js", "devtools/client/shared/remote-debugging/adb/commands/prepare-tcp-connection.js", "devtools/client/shared/remote-debugging/adb/commands/run-command.js", "devtools/client/shared/remote-debugging/adb/commands/shell.js", "devtools/client/shared/remote-debugging/adb/commands/track-devices.js", "devtools/client/shared/remote-debugging/adb/moz.build", "devtools/client/shared/remote-debugging/adb/xpcshell/test_prepare-tcp-connection.js"], "git_node": "b80cee07668abd722eccdfdaa9f73026d1f33ea7", "git_parents": ["e9d15114030c0366ba87f00f8a427b550deebb74"], "node": "aaf7ddbeabc06d6caa8f0463e59ae3d89b6e7d1b", "parents": ["3a8224944aec9b593a916fbe2c0aec681913a3f0"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045293 - [devtools] Disable about:debugging tests starting ADB on macos 1500 r=devtools-reviewers,ochameau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320029\n", "files": ["devtools/client/aboutdebugging/test/browser/browser.toml"], "git_node": "7860c26ecbd1f8b9b5870beee26e49e3a5f2ab05", "git_parents": ["b80cee07668abd722eccdfdaa9f73026d1f33ea7"], "node": "8f6a85b20d3ca7aa3861f1f96e932532e124dcf8", "parents": ["aaf7ddbeabc06d6caa8f0463e59ae3d89b6e7d1b"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063759 - Avoid line-clamp style adjustment for displays that aren't block/inline. r=firefox-style-system-reviewers,emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319194\n", "files": ["layout/generic/nsBlockFrame.cpp", "servo/components/style/style_adjuster.rs", "testing/web-platform/tests/css/css-overflow/line-clamp/webkit-line-clamp-bug-2063759-crash.html"], "git_node": "c0e30ee6b7d3a74774a61e1ff685cad2ef1aa72c", "git_parents": ["7860c26ecbd1f8b9b5870beee26e49e3a5f2ab05"], "node": "903b70f3553db4ae24611d809efd9b549f244c03", "parents": ["8f6a85b20d3ca7aa3861f1f96e932532e124dcf8"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061425 - Replace mozperftest tests using hg clone of repo with tarball download. r=perftest-reviewers,mozperftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316885\n", "files": ["build/sparse-profiles/perftest", "python/mozbuild/mozbuild/action/test_archive.py", "python/mozperftest/perfdocs/writing.md", "taskcluster/kinds/perftest/android-emulator.yml", "taskcluster/kinds/perftest/android.yml", "taskcluster/kinds/perftest/linux.yml", "testing/perfdocs/generated/writing.md"], "git_node": "a665bd538653afa035d4c4739792d67d677f0f6f", "git_parents": ["c0e30ee6b7d3a74774a61e1ff685cad2ef1aa72c"], "node": "a07c59f217ddb56ec0ee9e90fabae39670f29afe", "parents": ["903b70f3553db4ae24611d809efd9b549f244c03"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045289 - Reformat moz-label accesskeys when the label text changes while not observing. r=hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319248\n", "files": ["toolkit/content/tests/widgets/test_moz_label.html", "toolkit/content/widgets/moz-label/moz-label.mjs"], "git_node": "38e9edffd0719397761062b9ed35ab558deaf93e", "git_parents": ["a665bd538653afa035d4c4739792d67d677f0f6f"], "node": "8b647df2337b457aa202945a42d05625b38bdf8d", "parents": ["a07c59f217ddb56ec0ee9e90fabae39670f29afe"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2063302 - Add telemetry for collapse/expand shortcuts buttons r=android-reviewers,npoon\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318853\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/fake/FakeHomepagePreview.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sessioncontrol/SessionControlInteractor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/TopSites.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/controller/TopSiteController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/interactor/TopSiteInteractor.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/controller/DefaultTopSiteControllerTest.kt"], "git_node": "0555e58c5d39c41d11fedd5d01f7f65123a921fe", "git_parents": ["38e9edffd0719397761062b9ed35ab558deaf93e"], "node": "027a01aa5076b380c71159f18acc4f0805038d8e", "parents": ["8b647df2337b457aa202945a42d05625b38bdf8d"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059917 - Fix jiggle effect while scrolling by adding preserveAspectRatio and viewBox to all bundled theme preview svg files. r=mstriemer,desktop-theme-reviewers,zombie\n\nThis patch prevents the jiggle effect that was hit by the theme preview SVG files while the users\nis scrolling the about:addons themes list view by adding to each of the theme preview SVG images\nan explicit viewBox attribute along with setting preserveAspectRatio to none.\n\nThe issue seems to have been triggered because the computed height is a non-integer number and at paint time\nthat non-integer height was snapped based on the element position, which along with preserving the aspect\nratio was then triggering the jiggle effect (because the height was being snapped to 89 or 90 based on the\nelement position while scrolling the page).\n\nSetting preserveAspectRatio prevents the jiggling effect without a user noticeable visual difference for the\ntheme preview images, and achieved with changes restricted to the SVG images (no webcomponent or test logic\nto adjust).\n\nThis patch is also introducing an additional test task which verifier that all the bundled theme preview SVG files\nare including the expected SVG DOM attributes (in particular preserveAspectRatio and viewBox, and also checks that\nwidth and height are set consistently with the viewBox attribute).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316767\n", "files": ["browser/themes/addons/alpenglow/preview.svg", "browser/themes/addons/dark/preview.svg", "browser/themes/addons/extra-themes-previews/nova-ash@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-dusk@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-flame@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-flare@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-lagoon@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-lavender@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-pine@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-smoke@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-spark@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-sun@mozilla.org-preview.svg", "browser/themes/addons/extra-themes-previews/nova-tide@mozilla.org-preview.svg", "browser/themes/addons/light/preview.svg", "toolkit/mozapps/extensions/content/components/aboutaddons-themes-picker.css", "toolkit/mozapps/extensions/default-theme/preview-nova.svg", "toolkit/mozapps/extensions/default-theme/preview.svg", "toolkit/mozapps/extensions/test/browser/browser_html_themes_picker.js"], "git_node": "4add51867c5e7e010bb2a1c91263a4be591fa809", "git_parents": ["0555e58c5d39c41d11fedd5d01f7f65123a921fe"], "node": "935d3458efed2a005fe5e4774556450f3a6a3d0a", "parents": ["027a01aa5076b380c71159f18acc4f0805038d8e"], "tags": []}, {"author": "Ben Chatterton \u003cbchatterton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065221: Switch dte-tests to run-on-repo-type hg, r=bhearsum DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320209\n", "files": ["taskcluster/kinds/dte-test/kind.yml"], "git_node": "ebcfd719ba5607af8f5ceefad167cbcf95b540a5", "git_parents": ["4add51867c5e7e010bb