home/collections/migration/CollectionsToTabGroupsMigrationWorkerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/collections/migration/fake/FakeCollectionsMigrationRepository.kt"], "git_node": "22dcd16299245e68d3c8be9a1916d9fab9a050c2", "git_parents": ["18609526d848a3b5c94178bda9d0b8f6e4fdbb5b"], "node": "a28ad8074d0bf58ca1f22edce0074e462c893a76", "parents": ["3182055d7a466e193f17e76e77b0be81fae93d9a"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066504 - Dedupe impressions for a carousel slide that cycles back into view. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321307\n", "files": ["browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSCard/DSCard.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamImpressionStats/ImpressionStats.jsx", "browser/extensions/newtab/test/unit/content-src/components/DiscoveryStreamComponents/ImpressionStats.test.jsx"], "git_node": "9330dd84d40790a5c5189e5588094502ead09fbc", "git_parents": ["22dcd16299245e68d3c8be9a1916d9fab9a050c2"], "node": "a82fb7025d2eaa2af03691505cfca076b926e7c5", "parents": ["a28ad8074d0bf58ca1f22edce0074e462c893a76"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2065558 - Clear pointer selection when pointer moves between rows. r=mtigley,credential-management-reviewers,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320492\n", "files": ["toolkit/components/satchel/test/browser/browser_popup_mouseover.js", "toolkit/content/widgets/autocomplete-popup.js"], "git_node": "2040408d2c09a9b0340775175237728a775eb8a8", "git_parents": ["9330dd84d40790a5c5189e5588094502ead09fbc"], "node": "9831fb3618df67be885c56c8a7d1e072ddc061d9", "parents": ["a82fb7025d2eaa2af03691505cfca076b926e7c5"], "tags": []}, {"author": "Akhil Pindiprolu \u003capindiprolu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062819 - [Icon update] Update tab counter icon r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318220\n", "files": ["mobile/android/android-components/components/compose/tabstray/src/main/java/mozilla/components/compose/tabstray/TabCounterButton.kt", "mobile/android/android-components/components/compose/tabstray/src/main/res/drawable/mozac_tabcounter_background.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_infinite_tabs_24.xml", "mobile/android/android-components/components/ui/tabcounter/src/main/java/mozilla/components/ui/tabcounter/TabCounter.kt", "mobile/android/android-components/components/ui/tabcounter/src/main/java/mozilla/components/ui/tabcounter/TabCounterView.kt", "mobile/android/android-components/components/ui/tabcounter/src/main/res/drawable/mozac_ui_infinite_tabcounter_box.xml", "mobile/android/android-components/components/ui/tabcounter/src/main/res/drawable/mozac_ui_tabcounter_box.xml", "mobile/android/android-components/components/ui/tabcounter/src/main/res/layout/mozac_ui_tabcounter_layout.xml", "mobile/android/android-components/components/ui/tabcounter/src/test/java/mozilla/components/ui/tabcounter/TabCounterTest.kt", "mobile/android/android-components/samples/acorn-components/src/main/java/org/mozilla/samples/acorn/components/ui/IconsScreen.kt"], "git_node": "b358d937dc1bf46255f9a17969981b3ffcc889ca", "git_parents": ["2040408d2c09a9b0340775175237728a775eb8a8"], "node": "37cf8c65d951f7f5b029b368d7d0df9d9d9c5d7a", "parents": ["9831fb3618df67be885c56c8a7d1e072ddc061d9"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058311 - SW Auto Tab Grouping Styling, Menu Button Placement, Nova Tweaks r=fluent-reviewers,desktop-theme-reviewers,Mardak,dao,flod,kcochrane\" for causing mochitest failures @ test_initialize_vertical_tabs.py\n\nThis reverts commit a3ce1e049826c603cd0934aa97e8cb729ded2855.\n", "files": ["browser/base/content/navigator-toolbox.inc.xhtml", "browser/base/content/navigator-toolbox.js", "browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/sidebar/tests/browser/browser_verticalTabs_widget_placements.js", "browser/locales-preview/autoTabGrouping.ftl", "browser/themes/shared/smartwindowGroupTabs.css", "browser/themes/shared/toolbarbutton-icons.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "63cf9cf6bc82ee9101e9209de7bf189b341e35b3", "git_parents": ["b358d937dc1bf46255f9a17969981b3ffcc889ca"], "node": "680b89264b2850dc6c5da49dd3f9ae0b805221a8", "parents": ["37cf8c65d951f7f5b029b368d7d0df9d9d9c5d7a"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2065486 - Update illustration for sync disconnected state in sidebar r=fxview-reviewers,desktop-theme-reviewers,nsharpley,emilio\" for causing mochitests failures in browser_syncedtabs_errors_firefoxview.js.\n\nThis reverts commit 18609526d848a3b5c94178bda9d0b8f6e4fdbb5b.\n", "files": ["browser/components/firefoxview/SyncedTabsController.sys.mjs", "browser/components/firefoxview/firefox-view-synced-tabs-error-handler.sys.mjs", "browser/themes/shared/sidebar/kit-page-history.svg", "browser/themes/shared/sidebar/kit-qr-tabs-devices-empty.svg", "browser/themes/shared/sidebar/kit-tabs-devices-error.svg", "browser/themes/shared/sidebar/kit-tabs-devices.svg"], "git_node": "4f45e9520cb9e0ec9d5488ed31152f43a6362618", "git_parents": ["63cf9cf6bc82ee9101e9209de7bf189b341e35b3"], "node": "d88d42885924d5b19b5716e24d1c0d268930fb85", "parents": ["680b89264b2850dc6c5da49dd3f9ae0b805221a8"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2061307 - Add overlap check in IntrI8SelectColumnsOfB. r=yury\n\nIf colIndexList overlaps the output region, gemmology reads indices\nincrementally while writing output, allowing output writes to corrupt\nnot-yet-read indices and bypass column-index bounds checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319582\n", "files": ["js/src/intgemm/IntegerGemmIntrinsic.cpp", "js/src/jit-test/tests/wasm/builtin-modules/integer-gemm/I8SelectColumnsOfB.js"], "git_node": "2de601fc1abe9ca49acafdadf3e55122a8345fd3", "git_parents": ["4f45e9520cb9e0ec9d5488ed31152f43a6362618"], "node": "65ff77f0d619c4722d1274f9db62b1b53414eeb5", "parents": ["d88d42885924d5b19b5716e24d1c0d268930fb85"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066758 - Fix the l10n IDs of the sports and flight status result menu commands. r=daleharvey\n\nBug 2066877 covers the L10nCache behavior that makes a single missing string empty the whole menu instead of dropping one item.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321675\n", "files": ["browser/components/urlbar/content/enUS-searchFeatures.ftl", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_realtime_flight_status.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_sports.js"], "git_node": "bc8a545a5b7c1229a5e042c756de743b2df4cb6e", "git_parents": ["2de601fc1abe9ca49acafdadf3e55122a8345fd3"], "node": "8dd746bc7b26120d10d7637136cf5b1fa3435f75", "parents": ["65ff77f0d619c4722d1274f9db62b1b53414eeb5"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051873 - Report OOM in wasm InitExprInterpreter operand stack pushes. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320504\n", "files": ["js/src/wasm/WasmInitExpr.cpp"], "git_node": "e5a39e7025c60b20425495cfedbc5bedd2ff28d8", "git_parents": ["bc8a545a5b7c1229a5e042c756de743b2df4cb6e"], "node": "0c09f6d461e3a1af387e982606d0c54a31b60738", "parents": ["8dd746bc7b26120d10d7637136cf5b1fa3435f75"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058605 - Cap the virtual memory used by wasm continuation stacks. r=yury\n\nAn unbounded chain of `resume (cont.new ...)` never tripped a stack limit,\nbecause every level runs at the top of a fresh continuation stack with its own\nlimit. Each stack needs two guard pages, and every guard page splits its arena's\nmapping into more kernel mappings, so the recursion exhausted the process'\nmapping count and mprotect started failing inside the infallible\ngc::ProtectPages.\n\nBound the virtual memory a ContStackAllocator will map with a new\njavascript.options.wasm_cont_stack_max_vmem pref. The cap applies to both the\narena capacity and the number of arenas, and allocating past it now traps with\n'too many continuation stacks'.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320543\n", "files": ["js/public/friend/ErrorNumbers.msg", "js/src/jit-test/tests/wasm/stack-switching/cont-stack-limit.js", "js/src/wasm/WasmStacks.cpp", "js/src/wasm/WasmStacks.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "ebda487b6b7f09cc881fd7a24c184a76ba83ad98", "git_parents": ["e5a39e7025c60b20425495cfedbc5bedd2ff28d8"], "node": "64cec8f353d119831e731010d1a715fb0204edbb", "parents": ["0c09f6d461e3a1af387e982606d0c54a31b60738"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059577 - Track inlinedCallerOffsetsIndex per inline frame. r=yury\n\nRootCompiler stored inlinedCallerOffsetsIndex_ as a single shared field, but it\nis really a per-inlined-function value. finishInlineCall popped\ninlinedCallerOffsets_ without restoring the index, so TrapSiteDesc/CallSiteDesc\ncreated in the caller after an inlined call carried the finished callee's index\nand reported phantom inlined frames.\n\nMove the index onto FunctionCompiler, which is already constructed and destroyed\nper inline frame, and have startInlineCall hand it back for the callee compiler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320554\n", "files": ["js/src/jit-test/tests/wasm/inlining-stack-trace.js", "js/src/wasm/WasmIonCompile.cpp"], "git_node": "f50b50f0d511c68aed284791b148948f04437201", "git_parents": ["ebda487b6b7f09cc881fd7a24c184a76ba83ad98"], "node": "a6d68f2508321ea053e50ba914998903176196af", "parents": ["64cec8f353d119831e731010d1a715fb0204edbb"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066742: Increase QM DB page size and enable incremental vacuum. r=dom-storage-reviewers,asuth\n\nWhen PowerSafe Overwrite setting is on, writing a page can corrupt other\npages in the same sector on a crash. Matching the page size to sector\nsize eliminates this issue.\n\nFor old profiles, a schema migration or a build id bump creates page\nchurn and to deal with that, we also add vacuuming to the migration context.\nProper maintenance is left as a future improvement.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321548\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/InitializationTypes.cpp", "dom/quota/InitializationTypes.h", "dom/quota/QuotaManager.h", "dom/quota/test/xpcshell/telemetry/test_qm_first_initialization_attempt.js"], "git_node": "c1823c57351adcefbbd4fcd3d43ac6ccf8c76a25", "git_parents": ["f50b50f0d511c68aed284791b148948f04437201"], "node": "320616530e6434be3355f52d0e8737c19c63473a", "parents": ["a6d68f2508321ea053e50ba914998903176196af"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062795 - tweak checkbox and radio styles for Nova r=emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319284\n", "files": ["layout/reftests/box-shadow/1212823-2-ref.html", "layout/reftests/box-shadow/reftest.list", "layout/reftests/forms/input/checkbox/reftest.list", "layout/reftests/image-element/reftest.list", "widget/Theme.cpp"], "git_node": "368606ece14862c0c24bdef602db6c50168c1221", "git_parents": ["c1823c57351adcefbbd4fcd3d43ac6ccf8c76a25"], "node": "c948d610843e8d557d24ffed885ccbbfcf236c5a", "parents": ["320616530e6434be3355f52d0e8737c19c63473a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2066702 - Key a history row on its page, and on the day for the date sorts, rather than on the visit time, r=fxview-reviewers,jsudiaman.\n\nHistoryController.#normalizeVisit mutates each cached visit in place, and the\ncached visits are normalized again on every refresh (updateCache reuses them\nwhen the Places observer hands it a history map), so the visit time kept being\nappended: `guid` grew from `pageGuid` to `pageGuid|t` to `pageGuid|t|t`, and\n`pageGuid` was left holding the previous, already suffixed value.\n\nThat broke deleting pages, because sidebar-history passes those page guids to\nPlacesUtils.history.remove, which rejects a corrupted guid as neither a valid\nguid nor a URL and throws synchronously, so the `.catch` attached to the call\nnever runs and \"Delete Pages\" silently did nothing after the first background\nrefresh.\n\nThe remaining time suffix was unstable by design: visiting a page again changed\nits row's guid, so the sidebar's multiselection, which is tracked by guid, was\nsilently emptied by any background refresh. A row identifies a page, and for\nthe date sorts a page per day, since that is how the query groups visits, so\nderive the guid from the page guid captured on the first pass and the start of\nthe day rather than from the visit time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321493\n", "files": ["browser/components/firefoxview/HistoryController.sys.mjs", "browser/components/sidebar/tests/browser/browser_history_multiselect.js"], "git_node": "13b1896ad214c13bb55b3513bc71b12d8565276b", "git_parents": ["368606ece14862c0c24bdef602db6c50168c1221"], "node": "d1190400f852078fea73320e6576657217af8746", "parents": ["c948d610843e8d557d24ffed885ccbbfcf236c5a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2032569 - Stop browser_history_multiselect.js from racing background history refreshes, r=jsudiaman.\n\nA history refresh rebuilds the sidebar's cards, so the `sidebar-tab-list`\nelements and their rows are replaced. The test captured the lists once in\nadd_setup, then waited for mutations on elements that could by then be detached,\nso the waits never resolved and the task timed out. While the cards were being\nrebuilt there was no list at that index at all, which is the\n`firstList is undefined` failure seen in test-verify. It also counted rows the\nprevious task had left `selected`, because `resetSelection` clears the tracked\nselection but only requests the re-render that drops the attribute.\n\n- Look the lists up right before using them, and wait for a rebuilt list to\n  render its rows.\n- Wait for the selection to be cleared in the DOM after resetting it, and for\n  the focused row through the list rather than for an event on a captured row.\n- Wait for the tabs opened by test_open_all_in_tabs to load and flush the\n  pending Places writes, so the visits they record are settled there. Every\n  waitForNewTab listener resolves on the first TabOpen, so poll for the tabs\n  instead of registering one listener per tab.\n- Settle the rebuild that removing a page triggers, and assert the selection\n  test_open_all_in_tabs_warn depends on, so a missing warning dialog fails on\n  that assertion instead of timing out.\n- Run the tasks that mutate history after the ones that need a stable row set,\n  so their churn cannot land in an unrelated task.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321494\n", "files": ["browser/components/sidebar/tests/browser/browser_history_multiselect.js"], "git_node": "878f114b7fcddcb7192cab54dfdb1aaeabe14fa2", "git_parents": ["13b1896ad214c13bb55b3513bc71b12d8565276b"], "node": "2f5cb7cba3cec1ebc8d9e3eb23ef6826e96bb31b", "parents": ["d1190400f852078fea73320e6576657217af8746"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2048847 - Track whether the selector always matches during bucketing, and skip matching if so. r=firefox-style-system-reviewers,dshin\n\nI think this is not terrible, and saves some cycles in speedometer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321320\n", "files": ["layout/style/PseudoStyleType.h", "servo/components/selectors/matching.rs", "servo/components/style/gecko/pseudo_element.rs", "servo/components/style/gecko/pseudo_elements.py", "servo/components/style/rule_collector.rs", "servo/components/style/selector_map.rs", "servo/components/style/servo/selector_parser.rs", "servo/components/style/stylist.rs"], "git_node": "95301699ebffd378af869954520d9c8b8d58c397", "git_parents": ["878f114b7fcddcb7192cab54dfdb1aaeabe14fa2"], "node": "dba49edca099917d2a2e8fd87478e4404d999f57", "parents": ["2f5cb7cba3cec1ebc8d9e3eb23ef6826e96bb31b"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 1991957 - Reorder multichannel Vorbis channels in ffvpx's libvorbis decoder wrapper. r=media-playback-reviewers,alwu\n\nffvpx decodes Vorbis with libavcodec's libvorbis wrapper (libvorbisdec.c)\nrather than its native vorbisdec.c. Vorbis stores channels in the order given\nby the Vorbis I specification section 4.3.9 - for 5.1 that is L, C, R, rear L,\nrear R, LFE - which is not the order the rest of the stack expects. The native\ndecoder remaps between the two; the wrapper does not, so multichannel Vorbis\nplayed with its channels permuted.\n\nReorder libvorbis' output using ff_vorbis_channel_layout_offsets, and declare\nthe resulting layout from ff_vorbis_ch_layouts rather than leaving it\nAV_CHANNEL_ORDER_UNSPEC, mirroring what libopusdec.c already does for Opus.\nThis is carried as a local patch because the wrapper is rarely built upstream -\nit loses decoder selection to the native decoder - and is still unfixed there.\n\nThis regressed in bug 1873663, which removed our own Vorbis decoder and with it\nthe explicit channel remap it performed. Mono and stereo were unaffected, since\ntheir Vorbis channel order already matches what we expect.\n\nAdd a test as well: nothing covered decoded channel order, only channel count,\nwhich is why the removal went unnoticed. The fixture uses a 60Hz tone because\nlibvorbis lowpasses the LFE channel in its 5.1 mode, which would otherwise\nswallow the segment that has to prove the LFE slot.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321391\n", "files": ["dom/media/webaudio/test/mochitest.toml", "dom/media/webaudio/test/test_decodeMultichannelOrder.html", "dom/media/webaudio/test/vorbis-6ch-channel-order.webm", "media/ffvpx/README_MOZILLA", "media/ffvpx/libavcodec/libvorbisdec.c", "media/ffvpx/libvorbisdec-channel-order.patch"], "git_node": "0e420f74312172736efe40459a1f226e87f5dc94", "git_parents": ["95301699ebffd378af869954520d9c8b8d58c397"], "node": "41ba7427fa3cea8e9169bff7c5156613873f28f9", "parents": ["dba49edca099917d2a2e8fd87478e4404d999f57"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066193 - Update opus to 212d66c20944d0a0db91132f826a27dd0d5edd5d r=kinetik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321008\n", "files": ["media/libopus/moz.build", "media/libopus/moz.yaml", "media/libopus/silk/x86/NSQ_del_dec_avx2.c"], "git_node": "42c1c201114e77a19c1218bd7fe7d5f358c3e137", "git_parents": ["0e420f74312172736efe40459a1f226e87f5dc94"], "node": "5d7b7dde3e95bfa777069a86a051716fe0d93492", "parents": ["41ba7427fa3cea8e9169bff7c5156613873f28f9"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064967 - Share one native ONNX availability cache between the ML engine parent and child r=ai-platform-reviewers,nordzilla\n\n\"best-onnx\" resolution cached native ONNX availability in the inference\nchild, duplicating the cache EngineProcess already maintains in the parent.\nThe two could disagree, and neither test nor caller could control a single\nsource of truth.\n\nHave MLEngineChild query MLEngineParent, which routes to\nEngineProcess.requestIsNativeOnnxRuntimeAvailable(), so every requestor\nshares one cached probe. A probe that throws surfaces as false and is taken\nat face value: an ORT load failure is far likelier than a flaky probe, and\nnative is unlikely to work afterward either. Engine creation keeps its\none-shot wasm retry as a safety net.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320969\n", "files": ["toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_best_onnx_fallback.js"], "git_node": "91ddd4dee1844a1975050cebe8465a634fb07965", "git_parents": ["42c1c201114e77a19c1218bd7fe7d5f358c3e137"], "node": "eb9d800e57c3c6400a14ee0242511327fcc047c7", "parents": ["5d7b7dde3e95bfa777069a86a051716fe0d93492"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065555 - Add smart window launch command invoked glean telemetry r=tgiles,omarg,omc-reviewers,mimi\n\nA new `smart_window.launch_command_invoked` telemetry, placed just before `open_window`, with extra keys:\n\n- trigger (string) \u2014 entry point requesting the launch\n- fxa (boolean) \u2014 signed in at request time; false means the launch routes through the FxA sign-in flow\n- new_window (boolean) \u2014 new window vs. switching the current one\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321341\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_switcher_telemetry.js", "browser/components/preferences/config/aiFeatures.mjs", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window.js", "browser/components/uitour/UITour.sys.mjs", "browser/components/uitour/test/browser_UITour_aiwindow.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_fxa_aiwindow_signin_flow.js"], "git_node": "0851904f59c392f7d53ba9c129c3c77f7d12ee49", "git_parents": ["91ddd4dee1844a1975050cebe8465a634fb07965"], "node": "334bb5530ed80bd3962f4b6c3e136c66c479869c", "parents": ["eb9d800e57c3c6400a14ee0242511327fcc047c7"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066196 - Hide share with os button in sharing panel for now. r=jprickett\" for causing mochitest failures @ browser_testSharePanelTelemetry.js\n\nThis reverts commit 43a20f8c5eb9d03e664dea177b1aa45545129d8c.\n", "files": ["browser/components/sharing/SharePageAction.sys.mjs", "browser/components/sharing/tests/browser/browser_testSharePanelButtonVisibility.js", "browser/components/sharing/tests/browser/browser_testSharePanelTelemetry.js"], "git_node": "570a7b21bceaa2cf3cc227daebaeeec903d79e9f", "git_parents": ["0851904f59c392f7d53ba9c129c3c77f7d12ee49"], "node": "a6fdc3bed69ed098b920dde585fd46c5ead146f7", "parents": ["334bb5530ed80bd3962f4b6c3e136c66c479869c"], "tags": []}], "date": 1787801871, "git_changesets": ["b2ba0a9187e132643ef4e86cece944f57330aba7", "5a001fce88edd90d3c832d8b370edd7459fc4bad", "b863c5f2878bc9c764484c6377d5b69e2629e229", "9f6164eefcf22744f208152952f2718e3f48d1cf", "f0ca9418a90d7eeb2afe369e85ba46cbee1e8de2", "8ca4269a6226446c12e06e5455faff4f3dd3ae10", "8c49b3bc1e5be8a513908467b915e91040ffb892", "e7f0d291755ef185f0077d0aa9923b3efdba5270", "43a20f8c5eb9d03e664dea177b1aa45545129d8c", "68b5e7a13a97ba342bfc7bfdf23c92717591fdc7", "641e53189935dd337860a93899d1cdfaf0f8f303", "b262fda815a813a9621571658ef77793ed8cdb34", "7c1796cbcdf91262182faec4e2693b771700fce6", "159227ee6106e171045bfd889e99dd03a436919a", "abc5dc9ac96695bc97749fe4aab0e92c4ef5d3c8", "f0a9f69879fe2fe6721ab2db0d7b6f67d7074efe", "a3ce1e049826c603cd0934aa97e8cb729ded2855", "a82a735f4690bf499142b2fc0f877086cfa04b86", "bf2492a050c761c1a1365eb2b36c44af56bce2b4", "0ece59eab924221a37c84ce6e8ce40862015bf87", "fc64f3a1a985a9bce875c07d587c5d6e20e91029", "0f5aadb4e6ddf43b8afda7d3e39eb9d8c6a7e99a", "59efe4aef0213a3528d44651f1b766526c1b82d7", "18609526d848a3b5c94178bda9d0b8f6e4fdbb5b", "22dcd16299245e68d3c8be9a1916d9fab9a050c2", "9330dd84d40790a5c5189e5588094502ead09fbc", "2040408d2c09a9b0340775175237728a775eb8a8", "b358d937dc1bf46255f9a17969981b3ffcc889ca", "63cf9cf6bc82ee9101e9209de7bf189b341e35b3", "4f45e9520cb9e0ec9d5488ed31152f43a6362618", "2de601fc1abe9ca49acafdadf3e55122a8345fd3", "bc8a545a5b7c1229a5e042c756de743b2df4cb6e", "e5a39e7025c60b20425495cfedbc5bedd2ff28d8", "ebda487b6b7f09cc881fd7a24c184a76ba83ad98", "f50b50f0d511c68aed284791b148948f04437201", "c1823c57351adcefbbd4fcd3d43ac6ccf8c76a25", "368606ece14862c0c24bdef602db6c50168c1221", "13b1896ad214c13bb55b3513bc71b12d8565276b", "878f114b7fcddcb7192cab54dfdb1aaeabe14fa2", "95301699ebffd378af869954520d9c8b8d58c397", "0e420f74312172736efe40459a1f226e87f5dc94", "42c1c201114e77a19c1218bd7fe7d5f358c3e137", "91ddd4dee1844a1975050cebe8465a634fb07965", "0851904f59c392f7d53ba9c129c3c77f7d12ee49", "570a7b21bceaa2cf3cc227daebaeeec903d79e9f"], "user": "pstanciu@mozilla.com"}, "45191": {"changesets": [{"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066750 - Quota manager: add telemetry for initilization failures because of storage.sqlite file corruption. r=dom-storage-reviewers,hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321516\n", "files": ["dom/quota/OriginOperations.cpp", "dom/quota/metrics.yaml"], "git_node": "4edf80a4a8557d2be2f2270a8ab7f35e58088eda", "git_parents": ["570a7b21bceaa2cf3cc227daebaeeec903d79e9f"], "node": "1f72d88ba0a8b7b5482e13fa6227060c2861d738", "parents": ["a6fdc3bed69ed098b920dde585fd46c5ead146f7"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2066779 [Linux][Vulkan Video] Cache VulkanDeviceHolder per FFmpeg lib. r=stransky,media-playback-reviewers\n\nDon't share one weak holder across system FFmpeg and ffvpx (different lavu ABIs). Key the cache by FFmpegLibWrapper*.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321597\n", "files": ["dom/media/platforms/ffmpeg/VulkanDeviceHolder.cpp", "dom/media/platforms/ffmpeg/VulkanDeviceHolder.h"], "git_node": "1ad5cbe8b9dd99fcfb585722573d3eb1ac07d689", "git_parents": ["4edf80a4a8557d2be2f2270a8ab7f35e58088eda"], "node": "090179b0a10fb828de52ed4fa2b8069f261d4942", "parents": ["1f72d88ba0a8b7b5482e13fa6227060c2861d738"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2062877 - Snap border radii that drive a corner segment to whole device pixels r=gfx-reviewers,nical\n\nA rounded border corner is rasterized into a cached texture sized to the whole\ndevice pixels of its corner box, then stretched onto that box. When the box has\na fractional device size the composite resamples the cached arc, so a hairline\ncurve loses contrast against the straight sides, which are grid snapped and\nfully opaque. The curve then reads as thinner than the sides, and a radius whose\nfractional part is below a half is drawn a whole pixel too large because the\ntask size rounds while the rasterized geometry rounded up.\n\nThe corner box is max(radius, width), so snap a radius that exceeds its border\nwidth to a whole device pixel, matching what is already done for the widths.\nThat makes the corner composite exact, which in turn lets the rasterized arc use\nthe requested radius and thickness rather than rounding both up. A hairline side\nkeeps a texel of its own in the corner task so it cannot drop out of the arc.\n\nMeasured against an ideal supersampled arc, a fractional-radius corner goes from\n0.027 RMSE and 0.23 peak error to 0.010 and 0.09, matching what a whole-pixel\nradius already rendered, and the mean peak coverage along the curve rises from\n0.66 to 0.75.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319658\n", "files": ["gfx/layers/apz/test/reftest/reftest.list", "gfx/wr/webrender/src/border.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/wrench/reftests/border/border-corner-fractional-radius-ref.yaml", "gfx/wr/wrench/reftests/border/border-corner-fractional-radius.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/border-shape.png", "gfx/wr/wrench/reftests/border/reftest.list", "layout/reftests/bugs/reftest.list"], "git_node": "d43c6f810c1941ddfc48c1a8a7d24fe1644d3d74", "git_parents": ["1ad5cbe8b9dd99fcfb585722573d3eb1ac07d689"], "node": "66ebf5d1b8b17465a274aa8e9e1466923b264f21", "parents": ["090179b0a10fb828de52ed4fa2b8069f261d4942"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2059322: Add an a11y perf test for panning an SVG workspace with many shapes. r=eeejay,perftest-reviewers,mozperftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321049\n", "files": ["accessible/tests/browser/performance/browser_panManySVGShapes.js", "accessible/tests/browser/performance/perftest.toml", "python/mozperftest/perfdocs/config.yml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx-aarch64.yml", "taskcluster/kinds/perftest/macosx.yml", "taskcluster/kinds/perftest/windows11-24h2-ref.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "testing/perfdocs/generated/mozperftest.md"], "git_node": "ebb57717dc597338940e5fcea43d303f78bcd6d0", "git_parents": ["d43c6f810c1941ddfc48c1a8a7d24fe1644d3d74"], "node": "1dc01cc2d55e8a2fa23288be62a6748fd4d8e5b6", "parents": ["66ebf5d1b8b17465a274aa8e9e1466923b264f21"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062991 - Change Jump back in to Continue and remove show all button r=android-reviewers,android-l10n-reviewers,mobiletest-reviewers,adhingra,aaronmt,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321041\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/HomeScreenTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsHomepageTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/HomeSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SearchBarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsHomepageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/HomeTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsHomepageTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/HomeScreenRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuHomepageRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/fake/FakeHomepagePreview.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/recenttabs/controller/RecentTabController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/recenttabs/interactor/RecentTabInteractor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sessioncontrol/SessionControlInteractor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Homepage.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/home_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/SessionControlInteractorTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/recenttabs/controller/RecentTabControllerTest.kt"], "git_node": "e6e28395f52c32c3ac8004b42454145b6a40a8d3", "git_parents": ["ebb57717dc597338940e5fcea43d303f78bcd6d0"], "node": "3e881d2ebbec74bf23a9b3c12873ddbb4330f491", "parents": ["1dc01cc2d55e8a2fa23288be62a6748fd4d8e5b6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066238 - Remove an input's item set from the text context menu when the input goes away. r=daleharvey,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321470\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_context.js", "toolkit/content/editMenuOverlay.js", "toolkit/content/tests/chrome/file_edit_contextmenu.xhtml", "toolkit/content/tests/chrome/test_edit_contextmenu.html"], "git_node": "2aaf4bad1dfbb691602d742d5770b789e1880d3b", "git_parents": ["e6e28395f52c32c3ac8004b42454145b6a40a8d3"], "node": "8fdcd0ad0e12c88a67a88b1354455d4e76ea4cf8", "parents": ["3e881d2ebbec74bf23a9b3c12873ddbb4330f491"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2036593: Wait for the process being replaced before relaunching on macOS. r=application-update-reviewers,mac-reviewers,mstange\n\nWhile two processes of the same app bundle are registered with macOS at the same time, the second one counts as another instance of the app and is given its own dock tile. That tile then stays in the dock's list of recently used applications after the process is gone, so stale icons appear to build up, roughly one per restart.\n\nSince bug 1827651 we relaunch through NSWorkspace with `createsNewApplicationInstance` set, which is what makes macOS treat the relaunched process as a separate instance rather than as the same app coming back. Bug 1914807 then added the updater as a relauncher process to give the old process a chance to shut down first, but nothing actually waited for it, so in practice the two still overlap. Going back to NSTask does not look like an option, since we rely on NSWorkspace to register the app for session resume.\n\nWe now hand the pid of the process being replaced to the relauncher, and it waits for that process to leave Launch Services before it launches the replacement. The updater does the same for the callback application after applying an update, where it already has the pid.\n\nWe also stop asking for a new instance once nothing of that bundle identifier is running, so that a relaunch reuses the dock tile that is already there. We keep asking for one while any process of that bundle identifier is running, even one running from a different copy of the application: macOS resolves the open by bundle identifier rather than by the path we pass, so without the request it hands us that other process, drops the arguments, and the application we asked for never comes up.\n\nOne consequence is that a dock icon that is not kept in the dock now disappears for the short time between the old process exiting and the new one starting. Before, the two overlapped and the icon stayed put. A pinned icon, which we believe is the more common case, only loses its running indicator for that moment.\n\nThe tests cover both halves of this. One runs the relauncher directly against a pid that is still alive and checks that it waits instead of returning right away. The other restarts the browser and samples the process table across the restart to confirm that the old and the new process are never alive at the same time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316703\n", "files": ["toolkit/mozapps/update/updater/launchchild_osx.mm", "toolkit/mozapps/update/updater/updater.cpp", "toolkit/xre/nsCommandLineServiceMac.mm", "toolkit/xre/test/marionette/manifest.toml", "toolkit/xre/test/marionette/test_relaunch_dock_overlap.py"], "git_node": "27fcd7290bd1952cbeaf457aedc8f32fc81be2eb", "git_parents": ["2aaf4bad1dfbb691602d742d5770b789e1880d3b"], "node": "9ba854286de6ce70f40e07598dff23cc0608ea6a", "parents": ["8fdcd0ad0e12c88a67a88b1354455d4e76ea4cf8"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061295: Hold a reference to nsDataObj in callbacks r=win-reviewers,gstoll\n\nAs the comment in `WaitForCompletion` explains, it does a SpinEventLoopUntil\nas part of CStream callbacks, and the CStream can be unregistered during that,\nwhich is fine, but we need to hold a strong reference first since we use\nthe object afterward.  The reference in `WaitForCompletion` is technically\nredundant but makes future uses safer and admits a comment that future clients\nmay actually heed.\n\nIt also adds an unrelated missing null check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321699\n", "files": ["widget/windows/nsDataObj.cpp"], "git_node": "4feef4026519096e14fa00dc1cd977427cded595", "git_parents": ["27fcd7290bd1952cbeaf457aedc8f32fc81be2eb"], "node": "07e11378228bed7ee8ce087d58b0df871026e9fb", "parents": ["9ba854286de6ce70f40e07598dff23cc0608ea6a"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063460 - Fix urlbar result explanation position for rows that don't have URLs. r=dao,desktop-theme-reviewers,urlbar-reviewers\n\nSet `flex-grow: 1` on explanations so they take up the remaining available space\nafter the `top-no-wrap` (or URL if present) and `justify-content: end` so\nthey're end-aligned. The reason this bug doesn't happen for rows with URLs is\nthat URLs have `flex-grow: 1`, so they push the explanation to the end of the\nrow.\n\nAdd back `min-width: 0` (just removed in D318639) on rows with explanations but\nno URL so that the title starts to overflow more quickly than usual so there's\nenough room for the explanation. Also for those rows, add `margin-inline-start`\nto the explanation so that it doesn't get too close to the `top-no-wrap` (e.g.,\nthe \"Visit\" action text).\n\nRemove `urlbarView-overflowable` on explanations. Overflow can't even happen on\nexplanations right now due to their CSS, and I don't think we would ever want to\napply the fadeout effect to them anyway. (We have a `wrap` rule to hide them in\nvery narrow windows.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318851\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/themes/shared/urlbar/view-nova.css"], "git_node": "d305dd7765521c574e4722b71f73f9e8e7d66ebd", "git_parents": ["4feef4026519096e14fa00dc1cd977427cded595"], "node": "d703424bc08e1e93a6686a904e213b2f84d21321", "parents": ["07e11378228bed7ee8ce087d58b0df871026e9fb"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063282 - Let the color and date pickers follow the input's color scheme. r=emilio,desktop-theme-reviewers\n\nThis supersedes #DateTimePickerPanel's content-preferred-color-scheme rule, which resolved a global preference.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321676\n", "files": ["browser/themes/shared/tabbrowser/content-area.css", "toolkit/actors/InputPickerChildCommon.sys.mjs", "toolkit/actors/InputPickerParentCommon.sys.mjs", "toolkit/content/tests/browser/browser.toml", "toolkit/content/tests/browser/browser_input_picker_color_scheme.js", "toolkit/modules/InputPickerPanelCommon.sys.mjs"], "git_node": "a38427e5688c9b417b05a0e228f302c5166da4d1", "git_parents": ["d305dd7765521c574e4722b71f73f9e8e7d66ebd"], "node": "820cc3824d296596ad47c8782bffbe0ab9403b54", "parents": ["d703424bc08e1e93a6686a904e213b2f84d21321"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066893 - Let the form autocomplete popup follow the input's color scheme. r=emilio,credential-management-reviewers,desktop-theme-reviewers,mtigley\n\nThe chrome-input path clears both inline properties, so the shared popup stops carrying a content field's scheme and direction into the save-password doorhanger. That and the per-element scheme together supersede #PopupAutoComplete's content-preferred-color-scheme rule.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321690\n", "files": ["browser/themes/shared/tabbrowser/content-area.css", "toolkit/actors/AutoCompleteChild.sys.mjs", "toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser.toml", "toolkit/components/passwordmgr/test/browser/browser_doorhanger_autocomplete_color_scheme.js", "toolkit/components/satchel/test/browser/browser.toml", "toolkit/components/satchel/test/browser/browser_autocomplete_color_scheme.js", "toolkit/content/widgets/autocomplete-popup.js"], "git_node": "4720b284e5537b22de707084ae5c3df4dbcdaad6", "git_parents": ["a38427e5688c9b417b05a0e228f302c5166da4d1"], "node": "42ca44240dc6b50abbbcb945b0b5f2439ce90dbf", "parents": ["820cc3824d296596ad47c8782bffbe0ab9403b54"], "tags": []}, {"author": "Emily McDonough \u003cemcdonough@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064548 - Prefer Skrifa for glyph codes in FreeType fonts. r=jfkthame\n\nThis bypasses the caching code we have for FreeType fonts. We should evaluate\nlater if we want to hoist this caching mechanism into gfxFontEntry for use\nwith Skrifa fonts in general or not.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319645\n", "files": ["gfx/thebes/gfxFT2FontBase.h"], "git_node": "1047c20827e16fb1dd1a03d3099c94e35b3ab17f", "git_parents": ["4720b284e5537b22de707084ae5c3df4dbcdaad6"], "node": "6f26c6e96972df53d2ca5bbea3c44f97a6419b67", "parents": ["42ca44240dc6b50abbbcb945b0b5f2439ce90dbf"], "tags": []}, {"author": "Noah Bond \u003cnbond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053265 - Android ADR 0002 - Globally-accessible organized tab data r=jdelorenzo,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316121\n", "files": ["mobile/android/docs/adrs/0002-global-organized-tab-data.md"], "git_node": "7859f0536828b7c5437699785b5fa8129308af16", "git_parents": ["1047c20827e16fb1dd1a03d3099c94e35b3ab17f"], "node": "f7e00f4077986ef307fbe70423ac1d7a47186caf", "parents": ["6f26c6e96972df53d2ca5bbea3c44f97a6419b67"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065725: ATK test harness: If the document has no children, just ignore that and use the document. r=accessibility-platform-reviewers,eeejay\n\ngetDoc looks for a child of the document to see if this is an iframe test.\nFor this particular intermittent, there might be no children because the accessibility engine hasn't built the document yet.\nThe most correct fix for that would probably be to wait for the doc load complete event before running the ATK query.\nHowever, it's entirely possible to have a valid test document with no children, so we need to handle this anyway.\nFurthermore, this makes it consistent with the IA2 test harness, which already just uses the document if there are no children.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320836\n", "files": ["accessible/tests/browser/atk/a11y_setup.py"], "git_node": "b6694942a430b4d7156e8266a802eaced4aaf8fc", "git_parents": ["7859f0536828b7c5437699785b5fa8129308af16"], "node": "1d78dd9cb196ee0861721b916cd29dcc4d2d02cf", "parents": ["f7e00f4077986ef307fbe70423ac1d7a47186caf"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066528: Fix crashes when destroying a DocAccessibleParent for a WindowGlobalParent which is also being destroyed. r=accessibility-platform-reviewers,eeejay\n\n1. In WindowGlobalParent::RecvDestroy, call DocAccessibleParent::Destroy before starting to tear down the WindowGlobalParent and its descendants.\n  Once Send__delete__ is called, the WindowGlobalParent is starting to tear down and it's no longer possible to get its BrowserParent.\n  Send__delete__ will indirectly end up calling DocAccessibleParent::Destroy again, but that's okay because DocAccessibleParent ignores subsequent Destroy calls.\n2. In OuterDocOfRemoteAccessible, null check GetBrowserParent.\n  (1) should mean that we don't hit this situation in the crash covered by this bug.\n  However, it's still possible that other code paths could hit it due to destruction edge cases, either now or in future.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321478\n", "files": ["accessible/ipc/RemoteAccessible.cpp", "dom/ipc/WindowGlobalParent.cpp"], "git_node": "b9da3fcbcb3280419d66cd50beeb938978c76eca", "git_parents": ["b6694942a430b4d7156e8266a802eaced4aaf8fc"], "node": "7c686420a60c1d26b6af17d2f73aaa129f80b211", "parents": ["1d78dd9cb196ee0861721b916cd29dcc4d2d02cf"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058311 - SW Auto Tab Grouping Styling, Menu Button Placement, Nova Tweaks r=fluent-reviewers,desktop-theme-reviewers,Mardak,dao,flod,kcochrane\n\nCleans up some spacing and styling in the ATG menu, and moves the button to appear beside the window switcher\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316575\n", "files": ["browser/base/content/navigator-toolbox.inc.xhtml", "browser/base/content/navigator-toolbox.js", "browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/sidebar/tests/browser/browser_verticalTabs_widget_placements.js", "browser/components/sidebar/tests/marionette/test_initialize_vertical_tabs.py", "browser/locales-preview/autoTabGrouping.ftl", "browser/themes/shared/smartwindowGroupTabs.css", "browser/themes/shared/toolbarbutton-icons.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "53837142d475592ed8fd1f5574740f258278c13c", "git_parents": ["b9da3fcbcb3280419d66cd50beeb938978c76eca"], "node": "2c75cc212c0bb500e683364e9a8420422a5e7f6f", "parents": ["7c686420a60c1d26b6af17d2f73aaa129f80b211"], "tags": []}, {"author": "Ben Chatterton \u003cbchatterton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066783: Switch test set until GHA flow ready, r=jsegunoside\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321668\n", "files": ["taskcluster/kinds/dte-test/kind.yml"], "git_node": "a3011f7f58c9ce1a5d92c21f2fe5b3bf75f978ab", "git_parents": ["53837142d475592ed8fd1f5574740f258278c13c"], "node": "01a12823a797b0c49d32b8e5e7580d3267660887", "parents": ["2c75cc212c0bb500e683364e9a8420422a5e7f6f"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052424 - Fix sidebar animation by removing no-longer-needed nova animation branch. r=jsudiaman\n\n- Turns out the chrome gaps was what broke this. Removing that whole branch for nova fixes it\n- Add a test to assert on animation behavior\n- Fix up the browser_glean_sidebar.js test, it was racy and this change pushed it over the edge\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318855\n", "files": ["browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/tests/SidebarTestUtils.sys.mjs", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_glean_sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_animation.js"], "git_node": "667fbd0a5576814f8ffd100a8d20e40119f2109e", "git_parents": ["a3011f7f58c9ce1a5d92c21f2fe5b3bf75f978ab"], "node": "0cec8a917ad5ce7b0b9a3b01595583771886a8fc", "parents": ["01a12823a797b0c49d32b8e5e7580d3267660887"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066055 - Hide the pinned tabs divider while the launcher is expanded. r=sclements,tabbrowser-reviewers\n\nThis fixes a regression where the divider was incorrectly shown when the sidebar is expanded.\n\nI updated the styles such that the divider is now hidden in that scenario. When the sidebar is expanded while expand-on-hover is enabled, we still see the old thin full-width line.\n\nI also added two tests to check that the dividers are hidden when they should be and that the hidden divider is still a drag target.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321367\n", "files": ["browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_launcher_dividers.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "dec78451716b6b36a1c411ecd3578a1144419007", "git_parents": ["667fbd0a5576814f8ffd100a8d20e40119f2109e"], "node": "4bc8dfe08097c9178edaeacb6dedc0ccdee4b715", "parents": ["0cec8a917ad5ce7b0b9a3b01595583771886a8fc"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2061357 - Add tab selector dialog to when clicking the Smart Form Fill autocomplete row edit button r=mlucks,fluent-reviewers,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317241\n", "files": ["browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.css", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.stories.mjs", "browser/components/aiwindow/ui/content/smartformfill-tab-select.css", "browser/components/aiwindow/ui/content/smartformfill-tab-select.html", "browser/components/aiwindow/ui/content/smartformfill-tab-select.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/SmartFormFillAutocomplete.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillConstants.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_tab_selector.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "f6ba53fbf559cb82c76a1cb58d1436402bebbd44", "git_parents": ["dec78451716b6b36a1c411ecd3578a1144419007"], "node": "70da97591c8b3a562702475a0baa2feec3792ca9", "parents": ["4bc8dfe08097c9178edaeacb6dedc0ccdee4b715"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2063884 - Element should become unfocusable when it gets display:contents. r=morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320269\n", "files": ["accessible/generic/DocAccessible.cpp", "accessible/tests/browser/states/browser.toml", "accessible/tests/browser/states/browser_test_display_contents.js"], "git_node": "9711343ad9cf3b7044cbcf440e787cee8ae09cee", "git_parents": ["f6ba53fbf559cb82c76a1cb58d1436402bebbd44"], "node": "68fadd278557b23b07137a16638fdf8f35361a23", "parents": ["70da97591c8b3a562702475a0baa2feec3792ca9"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2063883 - display:contents accessibles should have SELECTABLE_TEXT if appropriate. r=morgan\n\nSince the accessible is unframed, use the nearest ancestor frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320538\n", "files": ["accessible/generic/HyperTextAccessible.cpp", "accessible/generic/LocalAccessible.cpp", "accessible/generic/LocalAccessible.h", "accessible/tests/browser/states/browser_test_display_contents.js"], "git_node": "02bb2508b05f2fbae89e21a2715dfbf27d98476d", "git_parents": ["9711343ad9cf3b7044cbcf440e787cee8ae09cee"], "node": "36bb7674050813ff3d3223c2968192b8fb07c623", "parents": ["68fadd278557b23b07137a16638fdf8f35361a23"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/feature/summarize/src/main/res/values-bg/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-dsb/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-el/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-en-rGB/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-es-rAR/strings.xml", "mobile/andr