o.json", "third_party/rust/phf_shared/CHANGELOG.md", "third_party/rust/phf_shared/Cargo.lock", "third_party/rust/phf_shared/Cargo.toml", "third_party/rust/phf_shared/Cargo.toml.orig", "third_party/rust/phf_shared/src/hasher.rs", "third_party/rust/phf_shared/src/lib.rs", "third_party/rust/phf_shared/src/ptrhash.rs", "toolkit/crashreporter/client/app/Cargo.toml"], "git_node": "94c7ff59f3a3f8d330766d8b90bc33318bdc3606", "git_parents": ["608db5c24f0c4199ebe041c58fe16f0ef3a144fe"], "node": "5bff36f58090962f270c987b588c359e456490c8", "parents": ["ea043f78bf63de0506e7f7ad4c5e7909ed290229"], "tags": []}, {"author": "Dharma Ong \u003cdharmaong00@gmail.com\u003e", "branch": "default", "desc": "Bug 2064728 - Extend SearchbarInput from base class. r=dao,search-reviewers,urlbar-reviewers,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319863\n", "files": ["browser/base/content/browser-main.js", "browser/base/content/browser.js", "browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/search/OpenSearchManager.sys.mjs", "browser/components/urlbar/content/SearchbarInput.mjs", "browser/components/urlbar/jar.mn", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "c947aedff44549acaa39b019a85ae6376ae8bce4", "git_parents": ["94c7ff59f3a3f8d330766d8b90bc33318bdc3606"], "node": "88e59cb6d1f163bac612979b447f9ece07abf258", "parents": ["5bff36f58090962f270c987b588c359e456490c8"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063169 - Fix uninitialized corner shape values in box shadows. r=gfx-reviewers,layout-reviewers,emilio,nical\n\nHaving unitialized values here resulted in WebRender using the corner-shape code path, as the shape_xxx values are not exactly 1.0. This in turns triggers the loading of the superellipse variants of the box shadow shaders (even with the pref off), which are quite complex and take a long time to load on low-end platforms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320568\n", "files": ["layout/painting/nsDisplayList.cpp"], "git_node": "fa65f2521d8c4abf5812ca7a9c2573c7b0592aa5", "git_parents": ["c947aedff44549acaa39b019a85ae6376ae8bce4"], "node": "999fa05e9e091a61664a34e16b4f5b364b30a2f3", "parents": ["88e59cb6d1f163bac612979b447f9ece07abf258"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063169 - Fix subpixel offset in software version of ps_quad_mask. r=nical,gfx-reviewers\n\nThe SWGL-optimized path in ps_quad_mask did not support anti-aliasing the top and bottom edges\nof the rect when using subpixel offsets. This created visible artifacts in box shadows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321282\n", "files": ["gfx/wr/webrender/res/ps_quad_mask.glsl"], "git_node": "a4496f52a24a3cd4cf468615a51226c1ab7c90f3", "git_parents": ["fa65f2521d8c4abf5812ca7a9c2573c7b0592aa5"], "node": "343cd356e34d235d9abb092afbef54a1b18de925", "parents": ["999fa05e9e091a61664a34e16b4f5b364b30a2f3"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059330 - Update tab height for Touch density in Nova r=desktop-theme-reviewers,tabbrowser-reviewers,jsudiaman,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321039\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "622301521c8e833801d320cf6169ae02c04df766", "git_parents": ["a4496f52a24a3cd4cf468615a51226c1ab7c90f3"], "node": "19e1ee37c8389f9ea04c2072a70e42e4b7ffe79f", "parents": ["343cd356e34d235d9abb092afbef54a1b18de925"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064729 - Replace using size 24 icons with size 16 for profiles r=desktop-theme-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321238\n", "files": ["browser/base/content/browser-profiles.js", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "964738a9ee7f5383b955d2d464e730454f35834a", "git_parents": ["622301521c8e833801d320cf6169ae02c04df766"], "node": "a590c6814c7fe81f05b446fdb8033bfdec1cb978", "parents": ["19e1ee37c8389f9ea04c2072a70e42e4b7ffe79f"], "tags": []}, {"author": "Abhishek Nimalan \u003cabhisheknimalan@gmail.com\u003e", "branch": "default", "desc": "Bug 1998767 - Symbolicate Mochitest and XPCshell profiles. r=taskgraph-reviewers,bhearsum,sparky,canova,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316256\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/other.py", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/kinds/test/xpcshell.yml", "taskcluster/test_configs/variants.yml", "testing/mochitest/runtests.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/__init__.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/symbolication.py", "testing/xpcshell/runxpcshelltests.py"], "git_node": "5f45cf291ff4177ad7d42b10ef26470fa0e93d5d", "git_parents": ["964738a9ee7f5383b955d2d464e730454f35834a"], "node": "ec50f4f342545116234bdc4b4d5ce48d48bf5eb0", "parents": ["a590c6814c7fe81f05b446fdb8033bfdec1cb978"], "tags": []}, {"author": "Bryan Johns \u003cbjohns@mozilla.com\u003e", "branch": "default", "desc": "Bug Bug 2052363 - Added bulk deletion SQLite statement; Deferred DBsize reporting r=ai-security-reviewers,again,czhou\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319861\n", "files": ["browser/components/aiwindow/ui/modules/ChatSql.sys.mjs", "browser/components/aiwindow/ui/modules/ChatStore.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_telemetry.js", "browser/components/aiwindow/ui/test/xpcshell/test_ChatStore.js"], "git_node": "82e8e212ea9f817064ae744feaa87bb1475d235e", "git_parents": ["5f45cf291ff4177ad7d42b10ef26470fa0e93d5d"], "node": "aaf9cc12c5d28143f6c7c7f1017935b67154d7cb", "parents": ["ec50f4f342545116234bdc4b4d5ce48d48bf5eb0"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2066016 - Don't use a special longer idle timeout for the DoH HTTP/3 connection r=necko-reviewers,valentin\n\nBug 1949422 gave the DoH HTTP/3 connection its own idle timeout, the pref\nnetwork.trr.idle_timeout_for_http3_conn, set to 400s on early beta and\nearlier (30s otherwise) to improve connection reuse. Every other HTTP/3\nconnection uses network.http.http3.idle_timeout (30s).\n\n400s is close to seven minutes, and a window that long causes two problems.\n\nNAT rebinding: neqo only sends keep-alive pings while a request stream is\nopen, so an idle DoH connection sends nothing. RFC 4787 asks for a NAT UDP\nmapping lifetime of at least two minutes and recommends five, but many home\nrouters use less, and RFC 8085 notes that a significant fraction of deployed\nmiddleboxes use shorter timeouts still. Once the connection sits idle past\nthe router's UDP timeout the mapping is dropped and return traffic is lost;\nwith a 400s idle timeout the connection can stay dead for minutes before it\nis torn down and rebuilt.\n\nBlack holes: even with a request in flight, keep-alive does not shorten the\nteardown. An ack-eliciting packet restarts the idle timer only if none has\nbeen sent since the last packet was received (RFC 9000 section 10.1), so a\none-way black hole lives about one idle timeout past the last received\npacket.\n\nDrop the special case so the DoH connection uses the same 30s idle timeout\nas other HTTP/3 connections; 30s sits below common NAT UDP timeouts. The\ngeneral idle-timeout plumbing that bug 1949422 added is kept, only the\nDoH-specific value is removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320837\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/Http3Session.cpp"], "git_node": "9de9dc5115cfdaf87c6852bce3e43f0720ef752c", "git_parents": ["82e8e212ea9f817064ae744feaa87bb1475d235e"], "node": "b24d1b3f73574e7719e1368f24e9a3a23f7bb825", "parents": ["aaf9cc12c5d28143f6c7c7f1017935b67154d7cb"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064179 - Add the missing changelog entry for Modifier.debouncedToggleable r=android-reviewers,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321235\n", "files": ["mobile/android/android-components/docs/changelog.md"], "git_node": "9d79b5b2e33d9948fce0e9cbdd4e1861b3920934", "git_parents": ["9de9dc5115cfdaf87c6852bce3e43f0720ef752c"], "node": "595a36a28928112caf7bb0c267264ea5e656d4eb", "parents": ["b24d1b3f73574e7719e1368f24e9a3a23f7bb825"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2062324 - Deal with pseudos in needs_visited_matching.\n\nTo fix content-color-on-visited-before-1.html, for example.\n", "files": ["servo/components/style/style_resolver.rs"], "git_node": "b365f1454ab959dd5aed330aa5b4eb409d0c8c8d", "git_parents": ["9d79b5b2e33d9948fce0e9cbdd4e1861b3920934"], "node": "be4c65d7a6ebc3c92104225b6f14b0ae158f1a75", "parents": ["595a36a28928112caf7bb0c267264ea5e656d4eb"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065691: Adjust scroll-timeline-in-container-query.html to account for unknown timeline not generating an effect. r=layout-scroll-driven-animation-reviewers,boris\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321007\n", "files": ["testing/web-platform/meta/scroll-animations/css/scroll-timeline-in-container-query.html.ini", "testing/web-platform/tests/scroll-animations/css/scroll-timeline-in-container-query.html"], "git_node": "409d9fc055cc12dd35d299cf6dd285ec58d90aed", "git_parents": ["b365f1454ab959dd5aed330aa5b4eb409d0c8c8d"], "node": "aa1e8fe88289ba4fd9cf226552db13ed5f8efec5", "parents": ["be4c65d7a6ebc3c92104225b6f14b0ae158f1a75"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065613 - rsclientcerts: support larger-than-neccessary buffers in C_GetAttributeValue r=jschanck\n\nThis also takes the opportunity to update how some cryptoki values are\nserialized and make the trace debugging output more useful.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320615\n", "files": ["Cargo.lock", "security/manager/ssl/ipcclientcerts/Cargo.toml", "security/manager/ssl/osclientcerts/Cargo.toml", "security/manager/ssl/rsclientcerts/Cargo.toml", "security/manager/ssl/rsclientcerts/src/cryptoki.rs", "security/manager/ssl/rsclientcerts/src/lib.rs"], "git_node": "1a327778e7c5ab4a6438047e8f48a7873c0109a4", "git_parents": ["409d9fc055cc12dd35d299cf6dd285ec58d90aed"], "node": "843cc0aeda1bb525f8384ca2f0eae32138359ae5", "parents": ["aa1e8fe88289ba4fd9cf226552db13ed5f8efec5"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065613 - support trust in rsclientcerts r=jschanck,supply-chain-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320616\n", "files": ["Cargo.lock", "security/manager/ssl/ipcclientcerts/src/backend.rs", "security/manager/ssl/osclientcerts/src/backend_android.rs", "security/manager/ssl/osclientcerts/src/backend_macos.rs", "security/manager/ssl/osclientcerts/src/backend_windows.rs", "security/manager/ssl/rsclientcerts/Cargo.toml", "security/manager/ssl/rsclientcerts/src/cryptoki.rs", "security/manager/ssl/rsclientcerts/src/lib.rs", "security/manager/ssl/rsclientcerts/src/manager.rs", "security/manager/ssl/tests/unit/pkcs11testmodule/src/backend.rs", "security/manager/ssl/tests/unit/pkcs11testmodule/src/lib.rs", "security/manager/ssl/tests/unit/pkcs11testmodule/src/test-ca.pem", "security/manager/ssl/tests/unit/pkcs11testmodule/src/test-ca.pem.certspec", "security/manager/ssl/tests/unit/pkcs11testmodule/src/test-int-ee.pem", "security/manager/ssl/tests/unit/pkcs11testmodule/src/test-int-ee.pem.certspec", "security/manager/ssl/tests/unit/pkcs11testmodule/src/test-int.pem", "security/manager/ssl/tests/unit/pkcs11testmodule/src/test-int.pem.certspec", "security/manager/ssl/tests/unit/test_pkcs11_module.js", "supply-chain/audits.toml", "third_party/rust/pkcs11-bindings/.cargo-checksum.json", "third_party/rust/pkcs11-bindings/.cargo_vcs_info.json", "third_party/rust/pkcs11-bindings/Cargo.lock", "third_party/rust/pkcs11-bindings/Cargo.toml", "third_party/rust/pkcs11-bindings/Cargo.toml.orig", "third_party/rust/pkcs11-bindings/build.rs"], "git_node": "21788aa08bca15252a28e7153d369851be2d41bb", "git_parents": ["1a327778e7c5ab4a6438047e8f48a7873c0109a4"], "node": "53b18c73321bcde9398a1053a8a72753ea62cce7", "parents": ["843cc0aeda1bb525f8384ca2f0eae32138359ae5"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060198 - Update Various GeckoView Variants r=taskgraph-reviewers,bhearsum\n\nPatch updates variants for six more months:\n* aab\n* geckoview-no-fission\n* geckoview-fission\n* geckoview-fission-isolate-high-value\n* no-fission\n* geckoview-zygote\n\nAssociated autogenerated variant expiring bugs related: bug 2060200, bug 2060199, bug 2060198, bug 2060202, bug 2060197\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321222\n", "files": ["taskcluster/test_configs/variants.yml"], "git_node": "e5ed23e07b5f68e5e71a4d77bb43fbc17d338857", "git_parents": ["21788aa08bca15252a28e7153d369851be2d41bb"], "node": "2d929a76fb11897709212ec2f734c78662264236", "parents": ["53b18c73321bcde9398a1053a8a72753ea62cce7"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060201 - Increase no-fission test variant expiry date r=asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319730\n", "files": ["taskcluster/test_configs/variants.yml"], "git_node": "7f9d95ddd3f323d189a78141e876706550f0cf5f", "git_parents": ["e5ed23e07b5f68e5e71a4d77bb43fbc17d338857"], "node": "ac310e4f238df9f3db28e2b32d877aaf8acdcd31", "parents": ["2d929a76fb11897709212ec2f734c78662264236"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2066058 - Make nsDOMMutationObserver receiver lookup O(1). r=jjaschke\n\nAdd an `mReceiverMap` hash table to optimize `GetReceiverFor` lookups.\n`mReceivers` is retained as the ordered, owning storage to safely allow arbitrary destructors during garbage collection and disconnects.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320866\n", "files": ["dom/base/nsDOMMutationObserver.cpp", "dom/base/nsDOMMutationObserver.h"], "git_node": "d48e4cfbff4b438d1e1dae4706bba5ecad3f6780", "git_parents": ["7f9d95ddd3f323d189a78141e876706550f0cf5f"], "node": "94c111d03325a67c35bc38f2ba49a22d6fef61c5", "parents": ["ac310e4f238df9f3db28e2b32d877aaf8acdcd31"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2054442 - [remote] Use requestAnimationFrame for incremental actions transitions. r=jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319790\n", "files": ["remote/shared/webdriver/Actions.sys.mjs"], "git_node": "32a4a894961d2d496e11ed00cd83625830fb828f", "git_parents": ["d48e4cfbff4b438d1e1dae4706bba5ecad3f6780"], "node": "5a770d835c2dc97a7091981cf1e2dcb383b9d11f", "parents": ["94c111d03325a67c35bc38f2ba49a22d6fef61c5"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2054442 - [wdspec] Add tests to ensure actions with a duration dispatch multiple events. r=jdescottes\n\nA pointer move, touch move, or wheel scroll action with a duration greater\nthan zero has to be split into multiple incremental events, dispatched roughly\nonce per animation frame, instead of collapsing into a single event.\n\nAdd tests for all three input types, for both WebDriver classic and BiDi, that\nrecord the dispatched events and assert that more than one is received.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319791\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/duration.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/duration.py"], "git_node": "3f4c1fdbe36a90c103a9da5216cd88612bf399c1", "git_parents": ["32a4a894961d2d496e11ed00cd83625830fb828f"], "node": "9bae90b8c643731000d7eb01177ffcbd1a7e72df", "parents": ["5a770d835c2dc97a7091981cf1e2dcb383b9d11f"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2066189 [Linux][Vulkan Video] nit: clarify direct-export floor TODO comments. r=stransky,media-playback-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321302\n", "files": ["dom/media/platforms/ffmpeg/FFmpegLibWrapper.h", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp"], "git_node": "e0ab553c6a46506a108169eaa7b4b102a7f378a2", "git_parents": ["3f4c1fdbe36a90c103a9da5216cd88612bf399c1"], "node": "e19b0245cd5cb04f296a4657f1607376e713187f", "parents": ["9bae90b8c643731000d7eb01177ffcbd1a7e72df"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2065829 - jit: use and32 immediate form in irregexp character checks. r=jandem\n\nTwo irregexp character checks (CheckCharacterAfterAnd and CheckBitInTable)\nmaterialized a compile-time-constant mask with move32(mask) followed by\nand32(reg, reg). Use the 3-arg and32(Imm32, src, dest) so the mask is an\nimmediate operand: on AArch64 both the character masks and kTableMask encode\nas bitmask immediates, so the mov disappears.\n\nThe removed mov is off the critical path (it materializes in parallel with\nthe character load), so this is code-size/instruction-count only: a regex\nmicrobench (min-ms) was flat on an Apple M4. All 133 'MOV + AND/ORR/EOR\nfoldable to bitmask immediate' findings in Octane's RegExp tier drop to zero\nwith correct results.\n\nThe Ion fuse-guard case (627 findings from emitGuardObjectFuseProperty) is\ndeliberately left out: testing baked-in stub-field constants in Ion ICs is a\nmore general opportunity that needs a broader design change.\n\nFound via armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321292\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp"], "git_node": "37e63ab0a250bad1765beda56f7af2efbe7ac7c6", "git_parents": ["e0ab553c6a46506a108169eaa7b4b102a7f378a2"], "node": "6cc5655a7966732d073ed804496c1196872c3545", "parents": ["e19b0245cd5cb04f296a4657f1607376e713187f"], "tags": []}, {"author": "Bryan Olsson \u003cbolsson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065693 - Update l10n documentation, r=flod DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320625\n", "files": ["intl/l10n/docs/fluent/review.md", "intl/l10n/docs/fluent/tutorial.md", "intl/l10n/docs/migrations/fluent.md"], "git_node": "6a74dd61b73aedbde8e809440f8ff209d0bf1dd5", "git_parents": ["37e63ab0a250bad1765beda56f7af2efbe7ac7c6"], "node": "ffdc7bc2095052af0134f2f4e1639c815ddeaaad", "parents": ["6cc5655a7966732d073ed804496c1196872c3545"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066155 - Cap the cookie database WAL at 512KB instead of 2MB r=valentin,cookie-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321089\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/cookie/CookiePersistentStorage.cpp"], "git_node": "2aa0bcf95c98681376e30d6a9aa4df2b27885abc", "git_parents": ["6a74dd61b73aedbde8e809440f8ff209d0bf1dd5"], "node": "5bc739fa9afb2ddedfd34f5890667df3191a8fbf", "parents": ["ffdc7bc2095052af0134f2f4e1639c815ddeaaad"], "tags": []}], "date": 1787693904, "git_changesets": ["e776bcb3763a33caecd76b20e9c996a587d0abe2", "6d17e0cd5888d56c9e4627058dbf106633732275", "e8a4922ff2a88ad13b8dbd6b382ca7039fe200af", "d39603dcbe08704fe95f3c61afa2745b6c7f49ca", "f13aa80ee21250b932da97b97f96cd75406d5457", "fbe6bb72f9ea66f5788acd3f6c0df1321e007221", "6e5617ad64e9e8ef56ba450e464db11f6be441af", "8fc23fc09af1a4b22f561fc589299a8e5b7d74cf", "ffab55ad6d7325acada2312324277f8104d82779", "3452cb7a239527ff0fbc3da72b820d6126afb7f3", "4d88cf88f0eb315e49fea86c2c8c45696add1fe7", "8f1f08a923984b7fcf9a75152a42678c664489f8", "b4d8347c340e97dcb4b87a82f7676775ba592cbc", "79a6c4aa9f750a7ad3d0684b408cf1af4947ddc2", "5666c1393719a83f61df2a813db8540c6e4073be", "7ffa79ce8017972c0f4967863c46db9e4e996d45", "438243dc75e52bc28bdfa9f651d25a31eba25a50", "b548ced3cb9c39d952512f8bead051dbe9dc7ee0", "b45d06edd186bbea3dc39518e1b26ef6d7d04c52", "ccb9da77d015c33efec427987d40d51461e9933d", "c0eadb5aab8982a52e1171c81c0ba7b7ce17355d", "fa1266d46b9cb17d9018e1e424d3c645bcf61066", "608db5c24f0c4199ebe041c58fe16f0ef3a144fe", "94c7ff59f3a3f8d330766d8b90bc33318bdc3606", "c947aedff44549acaa39b019a85ae6376ae8bce4", "fa65f2521d8c4abf5812ca7a9c2573c7b0592aa5", "a4496f52a24a3cd4cf468615a51226c1ab7c90f3", "622301521c8e833801d320cf6169ae02c04df766", "964738a9ee7f5383b955d2d464e730454f35834a", "5f45cf291ff4177ad7d42b10ef26470fa0e93d5d", "82e8e212ea9f817064ae744feaa87bb1475d235e", "9de9dc5115cfdaf87c6852bce3e43f0720ef752c", "9d79b5b2e33d9948fce0e9cbdd4e1861b3920934", "b365f1454ab959dd5aed330aa5b4eb409d0c8c8d", "409d9fc055cc12dd35d299cf6dd285ec58d90aed", "1a327778e7c5ab4a6438047e8f48a7873c0109a4", "21788aa08bca15252a28e7153d369851be2d41bb", "e5ed23e07b5f68e5e71a4d77bb43fbc17d338857", "7f9d95ddd3f323d189a78141e876706550f0cf5f", "d48e4cfbff4b438d1e1dae4706bba5ecad3f6780", "32a4a894961d2d496e11ed00cd83625830fb828f", "3f4c1fdbe36a90c103a9da5216cd88612bf399c1", "e0ab553c6a46506a108169eaa7b4b102a7f378a2", "37e63ab0a250bad1765beda56f7af2efbe7ac7c6", "6a74dd61b73aedbde8e809440f8ff209d0bf1dd5", "2aa0bcf95c98681376e30d6a9aa4df2b27885abc"], "user": "ctuns@mozilla.com"}, "45174": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065935 - Stop temporary download cache cleanups from racing each other. r=android-reviewers,mcarare\n\nTemporaryDownloadFeature's init block launches a fire-and-forget cleanupCache() on ioDispatcher.\nMost construction sites in the two temporary/ test classes left that parameter at its\nDispatchers.IO default, so the cleanup escaped runTest and raced both TemporaryFolder teardown\nand the next test's cleanup over the same directory. When it lost, deleteRecursively() hit\nFileTreeWalk's isFile assertion, and since Gradle runs tests with assertions enabled the\nAssertionError surfaced against whichever test called runTest next.\n\nBoth test classes now build features through a createFeature() helper that always supplies the\ntest dispatcher, so the Dispatchers.IO default is no longer reachable from either. Sibling\nfeatures do share the cache directory at runtime, so cleanupCache() also treats an entry that\nvanished mid-walk as deleted, and the init block's coroutine gets the exception handler the rest\nof the class already uses.\n\nTwo adjacent problems in the same code, fixed here rather than left behind:\n\n- cleanupCache() tallied failures with all(), which stops at the first entry it cannot delete\n  and strands the rest. It counts them instead.\n- coroutineExceptionHandler() dropped anything outside the types it listed, and listed\n  NullPointerException redundantly alongside RuntimeException.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320749\n", "files": ["mobile/android/android-components/components/feature/downloads/src/main/java/mozilla/components/feature/downloads/temporary/TemporaryDownloadFeature.kt", "mobile/android/android-components/components/feature/downloads/src/test/java/mozilla/components/feature/downloads/temporary/CopyDownloadFeatureTest.kt", "mobile/android/android-components/components/feature/downloads/src/test/java/mozilla/components/feature/downloads/temporary/ShareResourceFeatureTest.kt"], "git_node": "b7bba6fba0930a23de34a19053fc9804a2eb2049", "git_parents": ["2aa0bcf95c98681376e30d6a9aa4df2b27885abc"], "node": "fc53f160bfdf78c89f8513dc5ffca5fcf72fff39", "parents": ["5bc739fa9afb2ddedfd34f5890667df3191a8fbf"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2066182 - view-transition-class matching shouldn't assume the view transition is active. r=firefox-style-system-reviewers,view-transitions-reviewers,dshin,boris\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321294\n", "files": ["layout/style/GeckoBindings.cpp", "testing/web-platform/tests/css/css-view-transitions/view-transition-class-non-existing-crash.html"], "git_node": "68d8aed86fa766050797eab1dbd20b669f7c9cb0", "git_parents": ["b7bba6fba0930a23de34a19053fc9804a2eb2049"], "node": "1d52c12850b54612badc4a71416574b49f42b87e", "parents": ["fc53f160bfdf78c89f8513dc5ffca5fcf72fff39"], "tags": []}, {"author": "hanna.alemu \u003chalemu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041980 - Move ASRouter tests off CFR message templates. r=omc-reviewers,andhuang\n\nSeveral tests used CFR messages only as a generic base template, so they have to\nmove to a surviving surface before the templates can be removed. This relocates\nInfoBar.schema.json out of templates/CFR/, moves INFOBAR_ACTION_86 into\nPanelTestProvider, and converts the remaining cfr_doorhanger and\ncfr_urlbar_chiclet fixtures to infobar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318363\n", "files": ["browser/components/asrouter/bin/import-rollouts.js", "browser/components/asrouter/content-src/schemas/make-schemas.py", "browser/components/asrouter/content-src/templates/CFR/templates/InfoBar.schema.json", "browser/components/asrouter/content-src/templates/InfoBar/InfoBar.schema.json", "browser/components/asrouter/docs/infobars.md", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/moz.build", "browser/components/asrouter/tests/browser/browser_asrouter_bug1761522.js", "browser/components/asrouter/tests/browser/browser_asrouter_experimentsAPILoader.js", "browser/components/asrouter/tests/browser/browser_asrouter_group_frequency.js", "browser/components/asrouter/tests/browser/browser_asrouter_group_userprefs.js", "browser/components/asrouter/tests/browser/browser_asrouter_infobar.js", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js", "browser/components/asrouter/tests/browser/browser_asrouter_universal_infobar.js", "browser/components/asrouter/tests/browser/browser_trigger_messagesLoaded.js", "browser/components/asrouter/tests/browser/browser_trigger_nimbusUpdate.js", "browser/components/asrouter/tests/browser/head.js", "browser/components/asrouter/tests/unit/templates/ExtensionDoorhanger.test.jsx", "browser/components/asrouter/tests/xpcshell/test_remoteExperiments.js", "toolkit/components/messaging-system/schemas/index.md"], "git_node": "365628b4f08f0b1e9d57f10cfeb7f1d0ba44981e", "git_parents": ["68d8aed86fa766050797eab1dbd20b669f7c9cb0"], "node": "62c6dc080fe7c480fe6763e7e184ae771503a781", "parents": ["1d52c12850b54612badc4a71416574b49f42b87e"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051116 - Include aria-label in the attributes checked for detecting potential login forms/fields r=credential-management-reviewers,dimi\n\nWhen we have a lone input field within a form, and the id, name or className does not match our defined 'login regex', we are not able to infer that it is a login form, even if the form has an 'aria-label' that could match our regex.\n\nThis patch is to include aria-label in fields we are trying to match, so that in the event that the form has an aria label that could match, we are able to correctly detect it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319794\n", "files": ["toolkit/components/passwordmgr/LoginManager.shared.sys.mjs", "toolkit/components/passwordmgr/test/mochitest/mochitest.toml", "toolkit/components/passwordmgr/test/mochitest/test_autofill_username-only_aria_label.html", "toolkit/components/passwordmgr/test/unit/test_isInferredLoginForm.js", "toolkit/components/passwordmgr/test/unit/test_isInferredUsernameField.js"], "git_node": "8f572b986a1a81d541525fb364af44ae089668e2", "git_parents": ["365628b4f08f0b1e9d57f10cfeb7f1d0ba44981e"], "node": "e42e4791497cc4648a260ee66345b4e01f751d18", "parents": ["62c6dc080fe7c480fe6763e7e184ae771503a781"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066343 - Restore the display cutout mode when leaving immersive mode r=mcarare,android-reviewers\n\ntryDisableEdgeToEdge() reset the cutout mode to DEFAULT, clobbering the ALWAYS that\nWindowCompat.enableEdgeToEdge() sets at startup, so exiting fullscreen left the window letterboxed against\na display cutout. Bug 2065140 made the write reach WindowManager, which is what exposed this.\n\nThe right value cannot be assumed, since it depends on whether the consumer enabled edge-to-edge and on the\npage's viewport-fit. Remember the mode when entering immersive mode and put it back when leaving, keeping\nthe first value when entering happens twice and changing nothing when there is nothing to restore.\n\nFullScreenFeature now only re-applies the tab's viewport-fit on exit when the page asked for one, since\nre-applying the default would write over the restore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321151\n", "files": ["mobile/android/android-components/components/feature/session/src/main/java/mozilla/components/feature/session/FullScreenFeature.kt", "mobile/android/android-components/components/feature/session/src/test/java/mozilla/components/feature/session/FullScreenFeatureTest.kt", "mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/android/view/Activity.kt", "mobile/android/android-components/components/support/ktx/src/main/res/values/tags.xml", "mobile/android/android-components/components/support/ktx/src/test/java/mozilla/components/support/ktx/android/view/ActivityTest.kt"], "git_node": "e9610bf4182e22a6f2d99f3c8c21a7f3802465cf", "git_parents": ["8f572b986a1a81d541525fb364af44ae089668e2"], "node": "b6a859f5850c7a897ba011aaaa01eaf9824cf8d9", "parents": ["e42e4791497cc4648a260ee66345b4e01f751d18"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2065821 - Clear SoundTouch state when discarding future audio r=media-playback-reviewers,karlt\n\nClearFutureData discards raw decoded samples but previously retained\nSoundTouch output derived from them. Clear its internal state too, so pause,\nseek, and reset do not continue playing discarded audio.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320704\n", "files": ["dom/media/mediasink/AudioDecoderInputTrack.cpp", "media/libsoundtouch/src/RLBoxSoundTouch.cpp", "media/libsoundtouch/src/RLBoxSoundTouch.h", "media/libsoundtouch/src/RLBoxSoundTouchFactory.cpp", "media/libsoundtouch/src/RLBoxSoundTouchFactory.h"], "git_node": "ac8df485a6b337651ca353c8491c98c32fcef507", "git_parents": ["e9610bf4182e22a6f2d99f3c8c21a7f3802465cf"], "node": "19542ebe64ee94a2a5cf810cf96387849eae7255", "parents": ["b6a859f5850c7a897ba011aaaa01eaf9824cf8d9"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2065821 - Test clearing time-stretched audio r=media-playback-reviewers,karlt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320705\n", "files": ["dom/media/gtest/TestAudioDecoderInputTrack.cpp"], "git_node": "4e5bc8a910c9675fec173d0832c1fd0623981670", "git_parents": ["ac8df485a6b337651ca353c8491c98c32fcef507"], "node": "715a633a1ee20dd1804f8e00cd87d5a897418ea6", "parents": ["19542ebe64ee94a2a5cf810cf96387849eae7255"], "tags": []}, {"author": "Harshit \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063065 - Make MSIX background tasks activate and run in a full trust process. r=nrishel,browser-installer-reviewers,aborondo,frontend-codestyle-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318008\n", "files": ["Cargo.lock", "browser/installer/windows/msix/AppxManifest.xml.in", "build/rust/mozbuild/generate_buildconfig.py", "python/mozbuild/mozbuild/repackaging/msix.py", "toolkit/components/backgroundtasks/BackgroundTasks.cpp", "toolkit/components/taskscheduler/TaskSchedulerWinMSIXImpl.sys.mjs", "toolkit/components/taskscheduler/nsIWinBackgroundTaskRegistrar.idl", "toolkit/components/taskscheduler/rust/Cargo.toml", "toolkit/components/taskscheduler/rust/src/lib.rs", "toolkit/components/taskscheduler/tests/xpcshell/xpcshell.toml", "toolkit/modules/AppConstants.sys.mjs", "toolkit/modules/moz.build", "toolkit/moz.configure", "toolkit/mozapps/msixcomserver-rust/Cargo.toml", "toolkit/mozapps/msixcomserver-rust/src/lib.rs", "toolkit/mozapps/msixcomserver/msixcomserver.cpp", "toolkit/mozapps/msixcomserver/msixcomserver.def", "tools/lint/eslint/eslint-plugin-mozilla/lib/rules/valid-ci-uses.mjs"], "git_node": "23bfb4dc67a35b55c97b8e2b4fb7b6a6ed46d025", "git_parents": ["4e5bc8a910c9675fec173d0832c1fd0623981670"], "node": "b9b2740f8b5e7a78dac65568de662e1e125998e9", "parents": ["715a633a1ee20dd1804f8e00cd87d5a897418ea6"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049749 p1 - Change existing public annotations to ping scope r=gsvelto\n\nThese annotations are already designated as public within Socorro, so\nthere should be no reason they a