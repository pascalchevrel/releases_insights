arameter.cpp", "tools/clang-tidy/test/readability-non-const-parameter.json", "tools/clang-tidy/test/readability-qualified-auto.cpp", "tools/clang-tidy/test/readability-qualified-auto.json", "tools/clang-tidy/test/readability-redundant-control-flow.cpp", "tools/clang-tidy/test/readability-redundant-control-flow.json", "tools/clang-tidy/test/readability-redundant-member-init.cpp", "tools/clang-tidy/test/readability-redundant-member-init.json", "tools/clang-tidy/test/readability-redundant-preprocessor.cpp", "tools/clang-tidy/test/readability-redundant-preprocessor.json", "tools/clang-tidy/test/readability-redundant-smartptr-get.cpp", "tools/clang-tidy/test/readability-redundant-smartptr-get.json", "tools/clang-tidy/test/readability-redundant-string-cstr.cpp", "tools/clang-tidy/test/readability-redundant-string-cstr.json", "tools/clang-tidy/test/readability-redundant-string-init.cpp", "tools/clang-tidy/test/readability-redundant-string-init.json", "tools/clang-tidy/test/readability-simplify-boolean-expr.cpp", "tools/clang-tidy/test/readability-simplify-boolean-expr.json", "tools/clang-tidy/test/readability-static-accessed-through-instance.cpp", "tools/clang-tidy/test/readability-static-accessed-through-instance.json", "tools/clang-tidy/test/readability-uniqueptr-delete-release.cpp", "tools/clang-tidy/test/readability-uniqueptr-delete-release.json", "tools/clang-tidy/test/structures.h"], "git_node": "68fcea8289fcdc257901f2501a02ad7be32d90a4", "git_parents": ["931838c49910f62ef803713b3db133127e067a00"], "node": "98e8460c6c79f3dfb8dcdf8d990d93240f1984cb", "parents": ["f326af426e5f4b956c380e1de1798730214df125"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2062551 - Allow heapsnapshot records when DevTools are active. r=devtools-reviewers,smaug,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318392\n", "files": ["devtools/shared/heapsnapshot/HeapSnapshotTempFileHelperParent.cpp", "devtools/shared/heapsnapshot/tests/xpcshell/test_saveHeapSnapshot_e10s_01.js"], "git_node": "3b2ed8b4924f675f0155ec96487fca0fe92f4ed3", "git_parents": ["68fcea8289fcdc257901f2501a02ad7be32d90a4"], "node": "a7ec8817db78f9afe7565d376ab098fa31370e4b", "parents": ["98e8460c6c79f3dfb8dcdf8d990d93240f1984cb"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2064293 - jit/arm64: fold boolean-truthiness branch into cbz/cbnz.  r=jandem\n\nMacroAssembler::branchTestBooleanTruthy and\nMacroAssembler::branchTestInt32Truthy emitted 'tst Wp,Wp; b.cond' via\ntestBooleanTruthy(). The boolean payload is 0 (false) or 1 (true) in the\nlow 32 bits, so the zero-test branch folds directly into cbz/cbnz.\n\ncbz/cbnz share b.cond's imm19 range (+/-1MB) and the same veneer/linking\npath, so there is no displacement change; this matches the existing\nbranchTest32/branch32/branchPtr cbz/cbnz fast paths. Removes one\ninstruction from every Baseline conditional (if/while/&&/||/ternary):\n~15k fewer on Octane's Baseline tier. Code-size/instruction-count win;\nwall-clock neutral on M4 (the eliminated tst is an off-critical-path\nuop).\n\nFound via armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319383\n", "files": ["js/src/jit/arm64/MacroAssembler-arm64-inl.h", "js/src/jit/arm64/MacroAssembler-arm64.h"], "git_node": "6bb2fb877a20cdea644ec85d1e0adf325e085852", "git_parents": ["3b2ed8b4924f675f0155ec96487fca0fe92f4ed3"], "node": "98343fcd42115ebfba426d0d553a155bd4216c53", "parents": ["a7ec8817db78f9afe7565d376ab098fa31370e4b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065140 - Apply layoutInDisplayCutoutMode through Window.setAttributes r=mcarare,android-reviewers\n\nWindow.getAttributes() returns the live WindowManager.LayoutParams, but a change only reaches\nWindowManager via setAttributes(), which dispatches onWindowAttributesChanged and triggers a relayout.\nThe immersive-mode helpers mutated the returned object in place, so the cutout mode was never applied.\n\nOnly write the cutout mode when edge-to-edge is not enforced. Once an app targets SDK 35 and does not\nopt out, PhoneWindow marks the window edge-to-edge enforced and clears decorFitsSystemWindows, so the\ncutout mode no longer changes how the window is laid out. Google Play Console reports\nLAYOUT_IN_DISPLAY_CUTOUT_MODE_DEFAULT as deprecated for both Fenix and Focus. Every write is now gated\nthe same way, so the immersive-mode helpers and the page-driven viewport-fit handlers no longer cost a\nrelayout for a value the platform ignores. FLAG_LAYOUT_NO_LIMITS is deliberately left ungated because it\nis still used to detect immersive mode.\n\nLeaving fullscreen resets the cutout mode, which would otherwise discard the viewport-fit the page asked\nfor, so FullScreenFeature applies the tab's value again on exit.\n\nFenix's viewportFitChange is made visible for testing, and the immersive-mode KDocs now note that the\ncutout mode is only changed when edge-to-edge is not enforced.\n\nThe existing tests asserted on the object returned by Window.getAttributes(), so they passed even though\nthe value never reached WindowManager. They now verify that setAttributes() is called.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320770\n", "files": ["mobile/android/android-components/components/feature/pwa/src/test/java/mozilla/components/feature/pwa/feature/WebAppActivityFeatureTest.kt", "mobile/android/android-components/components/feature/session/src/main/java/mozilla/components/feature/session/FullScreenFeature.kt", "mobile/android/android-components/components/feature/session/src/test/java/mozilla/components/feature/session/FullScreenFeatureTest.kt", "mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/android/view/Activity.kt", "mobile/android/android-components/components/support/ktx/src/test/java/mozilla/components/support/ktx/android/view/ActivityTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/BrowserFragmentTest.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/browser/integration/FullScreenIntegration.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/browser/integration/FullScreenIntegrationTest.kt"], "git_node": "419ae15dad4378443d8172d8cc6f6c8091d56f72", "git_parents": ["6bb2fb877a20cdea644ec85d1e0adf325e085852"], "node": "b44af76934e8aa0313a4b1be12544baad9833ae3", "parents": ["98343fcd42115ebfba426d0d553a155bd4216c53"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065936 - Update protobuf to v36.0. r=timhuang\n\n- Re-vendored protobuf at v36.0 and regenerated all in-tree gencode.\n- Excluded the cpp_file_options and json_enumvalue_options gencode that upstream\n  started shipping in the release artifacts; the .proto sources they derive from\n  were already excluded.\n- Added the two lite-runtime sources our gencode actually reaches, type_id.cc and\n  unknown_field_set_lite.cc, and exported the four headers the built lite sources\n  newly reach. arena_allocation_policy.cc is also new to libprotobuf_lite_srcs but\n  defines nothing, so it stays out.\n- Bumped the Java/Maven protobuf version to match.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320755\n", "files": ["devtools/shared/heapsnapshot/CoreDump.pb.cc", "devtools/shared/heapsnapshot/CoreDump.pb.h", "gradle/libs.versions.toml", "third_party/opentelemetry-cpp/third_party/opentelemetry-proto/opentelemetry/proto/collector/trace/v1/trace_service.pb.cc", "third_party/opentelemetry-cpp/third_party/opentelemetry-proto/opentelemetry/proto/collector/trace/v1/trace_service.pb.h", "third_party/opentelemetry-cpp/third_party/opentelemetr