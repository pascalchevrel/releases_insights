rowser/tabs/browser_tab_groups_tab_interactions_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_manager_close.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_manager_groups.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_move_to_new_window_reload.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_preview.js", "browser/components/urlbar/ActionsProviderTabGroups.sys.mjs", "browser/components/urlbar/SmartbarMentionsPanelSearch.sys.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_sessionStore.js", "browser/components/urlbar/tests/browser/browser_aboutHomeLoading.js", "browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcuts.mjs", "browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/ContentCrashHandlers.sys.mjs", "browser/modules/test/browser/browser_UsageTelemetry_private_and_restore.js", "docshell/test/browser/browser_bug2004165.js", "docshell/test/browser/browser_bug2007897.js", "dom/base/test/browser_newtab_session_history.js", "dom/documentpip/tests/browser/browser_sessionstore_ignore_dpip.js", "netwerk/base/nsNetUtil.cpp", "services/sync/tps/extensions/tps/resource/tps.sys.mjs", "testing/talos/talos/startup_test/sessionrestore/addon/api.js", "testing/talos/talos/talos-powers/api.js", "toolkit/components/httpsonlyerror/tests/browser/browser_errorpage.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_restore_session.js", "toolkit/components/thumbnails/test/head.js", "toolkit/content/widgets/browser-custom-element.mjs", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "05d579ece18a136fefc53d6fd5d76e6da7890dc7", "git_parents": ["ee2694aa86322f609287de45064105979b8de7bf"], "node": "95646bac2b5ffee9df3dfa478c4650c5a39953b9", "parents": ["79fdf7c7492d8612adc59911ea22d35dde2eef84"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065038 - metadata update\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/nested-drawable.tentative.html.ini"], "git_node": "6aca970b1297a130a07d1d4ec07c53e0c793e9a2", "git_parents": ["05d579ece18a136fefc53d6fd5d76e6da7890dc7"], "node": "1f5a1ad31c1f48726d9dd5e8d3eff16b9999c1c7", "parents": ["95646bac2b5ffee9df3dfa478c4650c5a39953b9"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1968416 - Register the collapsed range before clearing the old ones. r=masayuki\n\nSelection::CollapseInternal() unregistered every current range and then\nregistered a new collapsed one.  When both use the same node as their closest\ncommon inclusive ancestor, that node's range list momentarily became empty, so\nUnregisterClosestCommonInclusiveAncestor() unmarked its whole flattened\nsubtree and the following MarkDescendants() marked it again.\n\nRegister the new range first.  The node's list then never becomes empty, and\nthe existing guards in both functions skip the two walks on their own.  The\nsame holds when either node is an ancestor of the other, where the walk that\ndoes happen now stops at the other node instead of covering it.\n\nAddRangesForSelectableNodes() adds nothing at all when it goes through\nAddRangesForUserSelectableNodes() and no part of the range is selectable,\nwhich leaves the registration backed by no range of this selection.  Clear()\nhas emptied the ranges by then, so the range took index 0 if it was added at\nall: unregister it again when it was not, and on the error path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317252\n", "files": ["dom/base/Selection.cpp", "testing/web-platform/tests/selection/collapse-common-ancestor-1.html", "testing/web-platform/tests/selection/collapse-common-ancestor-2.html", "testing/web-platform/tests/selection/collapse-common-ancestor-3.html", "testing/web-platform/tests/selection/collapse-common-ancestor-ref.html"], "git_node": "52a52f64306f9113dab5a028ba7472c677c46eb9", "git_parents": ["6aca970b1297a130a07d1d4ec07c53e0c793e9a2"], "node": "93284149ba817a492f8e55cf0bab8db6a4ac3aec", "parents": ["1f5a1ad31c1f48726d9dd5e8d3eff16b9999c1c7"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1991189 [Linux] Note dmabuf release only if we actually release it r=emilio,gtk-reviewers\n\n- Remove dmabuf mem log from DMABufSurfaceYUV::ImportPRIMESurfaceDescriptor() / DMABufSurfaceYUV::ReleaseVADRMPRIMESurfaceDescriptor()\n  as it's redundant and owned by ffmpeg.\n- Note dmabuf release only if we actually release it - ignore empty surfaces.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319415\n", "files": ["widget/gtk/DMABufSurface.cpp", "widget/gtk/DMABufSurface.h"], "git_node": "59029cbbeb41f9e06d81a21d87fa9af769aff68c", "git_parents": ["52a52f64306f9113dab5a028ba7472c677c46eb9"], "node": "7e8a3144c362f3bd90bef53c60cebc67d8a1149f", "parents": ["93284149ba817a492f8e55cf0bab8db6a4ac3aec"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063947. Reapply libFuzzer's local patches to the vendored sources. r=truber\" for causing build bustages\n\nThis reverts commit f957f67a08a7872d2eb64e69e15d06d7a9c773cc.\n", "files": ["taskcluster/scripts/misc/vendor-verify-expected-fail.yml", "tools/fuzzing/libfuzzer/FuzzerDataFlowTrace.cpp", "tools/fuzzing/libfuzzer/FuzzerDataFlowTrace.h", "tools/fuzzing/libfuzzer/FuzzerDriver.cpp", "tools/fuzzing/libfuzzer/FuzzerFork.cpp", "tools/fuzzing/libfuzzer/FuzzerFork.h", "tools/fuzzing/libfuzzer/FuzzerIO.cpp", "tools/fuzzing/libfuzzer/FuzzerIO.h", "tools/fuzzing/libfuzzer/FuzzerIOPosix.cpp", "tools/fuzzing/libfuzzer/FuzzerIOWindows.cpp", "tools/fuzzing/libfuzzer/FuzzerInternal.h", "tools/fuzzing/libfuzzer/FuzzerLoop.cpp", "tools/fuzzing/libfuzzer/FuzzerMerge.cpp", "tools/fuzzing/libfuzzer/FuzzerMerge.h", "tools/fuzzing/libfuzzer/FuzzerTracePC.cpp", "tools/fuzzing/libfuzzer/FuzzerTracePC.h", "tools/fuzzing/libfuzzer/moz.yaml"], "git_node": "b2d46f7e9efc5d18d0109fcd0183d8cd754919c7", "git_parents": ["59029cbbeb41f9e06d81a21d87fa9af769aff68c"], "node": "94f97e359193097389e34a271302d056c6031c8a", "parents": ["7e8a3144c362f3bd90bef53c60cebc67d8a1149f"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1996189 part 3 - Generate MIR/LIR boilerplate for MGenerator. r=mgaudet\" for causing wpt assertion failures at WarpBuilder.cpp\n\nThis reverts commit b420528a4b5b7cb9204105e9f938c31c72ef3f76.\n\nRevert \"Bug 1996189 part 2 - Support async module scripts in Warp. r=mgaudet\"\n\nThis reverts commit 177abd3f2bb962fcc44e6fbbc413e1fc99fc10dc.\n\nRevert \"Bug 1996189 part 1 - Add AbstractGeneratorObject::create overload for modules. r=mgaudet\"\n\nThis reverts commit 03c8501bd7d29ad77f35e43349d360c16332d44b.\n", "files": ["js/src/jit-test/tests/generators/resume-modules.js", "js/src/jit/CodeGenerator.cpp", "js/src/jit/Ion.cpp", "js/src/jit/LIROps.yaml", "js/src/jit/Lowering.cpp", "js/src/jit/MIR.h", "js/src/jit/MIROps.yaml", "js/src/jit/VMFunctionList-inl.h", "js/src/jit/VMFunctions.cpp", "js/src/jit/VMFunctions.h", "js/src/jit/WarpBuilder.cpp", "js/src/vm/GeneratorObject.cpp", "js/src/vm/GeneratorObject.h"], "git_node": "5f0e2f5771401467d1bfba0f2d9e911bd664d828", "git_parents": ["b2d46f7e9efc5d18d0109fcd0183d8cd754919c7"], "node": "c57087ead729fbea65af77832dae9eb4eab1f9f4", "parents": ["94f97e359193097389e34a271302d056c6031c8a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2064683 - Remove CHROME_WINDOW_CLOSE. r=dom-core-reviewers,win-reviewers,sfoster,gstoll,smaug\n\nNothing sets close=no / close=0, and GTK doesn't even deal with it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319813\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/taskbartabs/TaskbarTabsWindowManager.sys.mjs", "toolkit/components/browser/nsIWebBrowserChrome.idl", "toolkit/components/windowwatcher/nsWindowWatcher.cpp", "toolkit/components/windowwatcher/test/browser_new_content_window_chromeflags.js", "toolkit/components/windowwatcher/test/head.js", "widget/InitData.h", "widget/cocoa/nsCocoaWindow.mm", "widget/gtk/nsWindow.cpp", "widget/windows/nsWindow.cpp", "xpfe/appshell/nsAppShellService.cpp"], "git_node": "8288f74a112af14feafff6400a9ed179304b5cc1", "git_parents": ["5f0e2f5771401467d1bfba0f2d9e911bd664d828"], "node": "8efa1eff755a736ec8252ca98486dca986f75144", "parents": ["c57087ead729fbea65af77832dae9eb4eab1f9f4"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063169 - Add WR_FEATURE_SUPERELLIPSE variant to ps_quad_mask. r=gfx-reviewers,nical\n\nSplit expensive superellipse calculations in a separate shader variant.\n\nSpeeds up startup time by skipping the compilation of the complex shader,\nloading it lazily instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319577\n", "files": ["gfx/wr/webrender/res/ps_quad_mask.glsl", "gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_build/src/shader_features.rs"], "git_node": "73cd5c16d7c4d0aa2351a0f46ab7f02a234bb930", "git_parents": ["8288f74a112af14feafff6400a9ed179304b5cc1"], "node": "539e356f8113f6fd63577d4df0825dc5928acdc7", "parents": ["8efa1eff755a736ec8252ca98486dca986f75144"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063169 - Add WR_FEATURE_SUPERELLIPSE variant to ps_quad_box_shadow. r=gfx-reviewers,nical\n\nSplit expensive superellipse calculations in a separate shader variant to load it lazily instead and speedup startup time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319796\n", "files": ["gfx/wr/webrender/res/ps_quad_box_shadow.glsl", "gfx/wr/webrender/src/pattern/box_shadow.rs", "gfx/wr/webrender/src/pattern/mod.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_build/src/shader_features.rs"], "git_node": "42a31b4e8e79d496ff359873691355ec86d7d249", "git_parents": ["73cd5c16d7c4d0aa2351a0f46ab7f02a234bb930"], "node": "63dbb1e064ad31bd50a43e39d633e7a6818d00e3", "parents": ["539e356f8113f6fd63577d4df0825dc5928acdc7"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047627 - Fix uninitialized corner shape values in theme drawing. r=gfx-reviewers,nical\n\nFollowing the first implementation of CSS corner shape rendering (see bug 2035317),\nthe struct wr::BorderRadius now has four new fields for the corner shapes, which\nwere left uninitialized here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317056\n", "files": ["widget/ThemeDrawing.cpp"], "git_node": "9f1a32cbd52eefc252e4d1fd505dcbda6f78fa04", "git_parents": ["42a31b4e8e79d496ff359873691355ec86d7d249"], "node": "32d59252ff60e6ca399d8c03ab7e1a76561035d5", "parents": ["63dbb1e064ad31bd50a43e39d633e7a6818d00e3"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064810 - [efficiency] Convert the SettingsSitePermissionsTest autoplay smoke tests to ui/efficiency r=aaronmt\n\nPorts the two default-autoplay smoke tests: verifyAutoplayBlockAudioOnlySettingOnNotMutedVideoTest\n(TestRail 2095125) and verifyAutoplayBlockAudioOnlySettingOnMutedVideoTest (TestRail 2286807). Both\nassert the behaviour of the default Autoplay setting, so neither changes it: a video with sound must\nnot autoplay and needs the page's Play control, while a muted video plays on its own.\n\nAdds SettingsSiteSettingsAutoplayPage with its navigation and return edges, and Autoplay selectors\nauthored against a live screen dump rather than the legacy robot's locators. Two parity notes:\n\nEach radio's text is the label and its subtext joined by a newline (\"Block audio only\\nRecommended\"),\nso an exact-text selector built from the strings.xml label alone can never resolve. The screen is\nanchored on an autoplay-only text-contains fragment, because the radio res-ids are shared with the\nCamera, Location and Microphone screens, where the 3rd and 4th radios are merely hidden and\nonView(withId(...)) resolves regardless of visibility.\n\nLegacy asserted the three visible options with Espresso withEffectiveVisibility(VISIBLE). The port\nuses a UIAutomator res-id group check, which carries the same guarantee because that tree contains\nonly displayed nodes.\n\nBoth tests pass on device with no retry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319901\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsSitePermissionsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsSiteSettingsAutoplayPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSiteSettingsAutoplaySelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSiteSettingsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsSitePermissionsTest.kt"], "git_node": "cfd01c9e9239ca34fd1d30160069519c45283399", "git_parents": ["9f1a32cbd52eefc252e4d1fd505dcbda6f78fa04"], "node": "f51491491079e3ab6956cc5e9d555e654e752c77", "parents": ["32d59252ff60e6ca399d8c03ab7e1a76561035d5"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064815 - [efficiency] Convert three SitePermissionsTest permission-prompt smoke tests to ui/efficiency r=aaronmt\n\nPorts blockNotificationsPermissionTest (TestRail 2334294), allowLocationPermissionsTest (TestRail\n251380) and audioVideoPermissionWithoutRememberingTheDecisionTest (TestRail 2334295).\n\nThe page under test stays the test-eng team's live permissions page rather than a mock-server asset:\nthese prompts are raised by real getUserMedia/Notification/geolocation calls, which no local fixture\nreproduces. Carries over the legacy class's GrantPermissionRule, MockLocationUpdatesRule and the\nPromptAbuserDetector toggle - without the last one, a second prompt in the same test is suppressed as\nabuse and the assertion reads as a missing prompt.\n\nPrompt selectors match the prompt buttons by res-id AND label, which keeps legacy's\nassertItemTextEquals assertions on the per-permission labels (Never/Always for notifications,\nDon't allow/Allow elsewhere) instead of only proving that a button exists.\n\nThe page's trigger buttons are matched by web DOM id and label, both taken from a live dump. A\ntext-only match is unsafe: the page prints a heading above each button (\"Test Camera & Microphone\nDialogue\" over \"Camera & Microphone\"), so a text-contains selector resolves the non-clickable heading\nand the click then fails with \"Failed to click UiObject\" while reporting the element as found.\n\nAll three tests pass on device with no retry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319902\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SitePermissionsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SitePermissionsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SitePermissionsTest.kt"], "git_node": "ef893e3b3becab349da54ca99777d5cf575659fc", "git_parents": ["cfd01c9e9239ca34fd1d30160069519c45283399"], "node": "a16cf3c13c444ad0111fc732a73e9531cf0462ac", "parents": ["f51491491079e3ab6956cc5e9d555e654e752c77"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064823 - [efficiency] Convert SettingsSitePermissionsTest.clearAllSitePermissionsExceptionsTest to ui/efficiency r=aaronmt\n\nPorts clearAllSitePermissionsExceptionsTest (TestRail 2095124). The test creates a real exception by\nallowing the notifications prompt on the test-eng permissions page, then clears it from\nSettings \u003e Site settings \u003e Exceptions.\n\nThe Cancel round-trip is kept because it is the point of the test: legacy dismissed the\nclear-permissions dialog once and re-opened it, proving Cancel clears nothing, before confirming with\nOK.\n\nAdds exceptions-screen selectors - the exception row, the clear-on-all-sites button, and the dialog\ntitle with its Cancel/OK buttons - all resolved from string resources rather than literals.\n\nPasses on device with no retry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319903\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsSitePermissionsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSiteSettingsExceptionsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsSitePermissionsTest.kt"], "git_node": "92167a2b1c26bc471ee0c889f051d62f78675c58", "git_parents": ["ef893e3b3becab349da54ca99777d5cf575659fc"], "node": "de5c68c77a7dd396deaeb984d1e37122e48a4b3e", "parents": ["a16cf3c13c444ad0111fc732a73e9531cf0462ac"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064833 - [efficiency] Convert SettingsSitePermissionsTest.systemBlockedPermissionsRedirectToSystemAppSettingsTest to ui/efficiency r=aaronmt\n\nWalks the Camera, Location and Microphone permission screens while Android still blocks all three,\nfollows the in-app \"Go to Settings\" button into the app's system permission settings, grants all three\nthere, and asserts all three screens no longer show the blocked-by-Android section. The legacy test\ncarries no TestRail link, so none is recorded in the port.\n\nBuilds out the SettingsSiteSettingsPermissionsPage stub. It was never instantiated in PageContext, so\nits navigation registration never ran, and its edge stopped one screen short of its own arrival anchor.\nIt now reaches the Camera screen and registers a return edge. Selectors were authored against a live\nscreen dump, which also supplied the blocked-state container res-id that legacy reached through a\nprivate helper.\n\nOne deliberate improvement over the legacy assertions. Legacy branched on Build.VERSION to decide\nwhether to assert the granted row's \"Only while app is in use\" summary, which is only rendered up to\nAPI 30; above that it asserted only that a row with the permission's title exists - and that row is\npresent whether the permission is allowed or denied, so the assertion could not fail on a modern\nrelease. The port keeps the row assertion for parity and adds the OS's own permission state through\nPackageManager, which needs no version branch and cannot pass for a denied permission.\n\nPasses on device with no retry, and the whole converted class passes together.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319904\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsSitePermissionsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsSiteSettingsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsSiteSettingsPermissionsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SystemSettingsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSiteSettingsPermissionsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSiteSettingsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsSitePermissionsTest.kt"], "git_node": "18aa0cdfc6dcb2c539d75135f26eb1d151b086c1", "git_parents": ["92167a2b1c26bc471ee0c889f051d62f78675c58"], "node": "2ba413a7ed3adf0659d5bfe1c3f5373b7fccc447", "parents": ["de5c68c77a7dd396deaeb984d1e37122e48a4b3e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2063681 - Make build system telemetry be recorded in the right machrc if there's an env var. r=firefox-build-system-reviewers,ahochheiden\n\nDon't create it if it doesn't exist tho.\n\nThis re-implements bug 1697272 effectively, which regressed at some\npoint, and adds a few tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318788\n", "files": ["build/mach_initialize.py", "python/mach/mach/main.py", "python/mach/mach/telemetry.py", "python/mach/mach/util.py", "python/mozboot/mozboot/bootstrap.py", "python/mozbuild/mozbuild/test/test_telemetry_settings.py"], "git_node": "4f09d9e9f2305ac38f5a83af6f4bd21c02de4fa4", "git_parents": ["18aa0cdfc6dcb2c539d75135f26eb1d151b086c1"], "node": "a144d013abce0ee56e444f37e86ab020abcd04fd", "parents": ["2ba413a7ed3adf0659d5bfe1c3f5373b7fccc447"], "tags": []}, {"author": "Gregory Pappas \u003cgp3033@protonmail.com\u003e", "branch": "default", "desc": "Bug 1978211 - Remove layout.css.moz-broken.content.enabled pref r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257929\n", "files": ["layout/reftests/bugs/reftest.list", "layout/reftests/image/reftest.list", "layout/tools/reftest/jar.mn", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/gecko/selector_parser.rs"], "git_node": "a52021bfebee73b34e44233a412f462ea558e1ac", "git_parents": ["4f09d9e9f2305ac38f5a83af6f4bd21c02de4fa4"], "node": "06d7f5fa1d7a3e0e3ac8bd832682b1d97cc8b391", "parents": ["a144d013abce0ee56e444f37e86ab020abcd04fd"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2065070 - Clean up FAIL/PASS on CommandEvent IDL exposure test r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320051\n", "files": ["testing/web-platform/meta/html/dom/idlharness.https.html.ini"], "git_node": "f6ec832dd4f33a9f009e4034592381fd3adc829b", "git_parents": ["a52021bfebee73b34e44233a412f462ea558e1ac"], "node": "f8956bab50bb6f90eecbf0161ac5e7484c77d5c5", "parents": ["06d7f5fa1d7a3e0e3ac8bd832682b1d97cc8b391"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2065067 - Clean up FAIL/PASS on CloseWatcher IDL exposure test r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320050\n", "files": ["testing/web-platform/meta/html/dom/idlharness.https.html.ini"], "git_node": "3b2cf84fc2c1c532abbf032e785e5a551ebcfff6", "git_parents": ["f6ec832dd4f33a9f009e4034592381fd3adc829b"], "node": "a23e3d847e41ee7fe7c4017de59cfe1563314176", "parents": ["f8956bab50bb6f90eecbf0161ac5e7484c77d5c5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065065 - Remove dom.viewTransitions.enabled. r=webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320047\n", "files": ["accessible/tests/browser/tree/browser.toml", "browser/base/content/test/static/browser_parsable_css.js", "dom/view-transitions/test/browser/browser.toml", "dom/webidl/Document.webidl", "dom/webidl/ViewTransition.webidl", "layout/inspector/tests/mochitest.toml", "layout/style/res/ua.css", "layout/style/test/mochitest.toml", "layout/style/test/property_database.js", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/DynamicToolbarTest.kt", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/gecko/pseudo_elements.toml", "servo/components/style/gecko/selector_parser.rs", "servo/components/style/properties/longhands.toml", "testing/web-platform/meta/css/__dir__.ini", "testing/web-platform/meta/css/css-shadow-parts/__dir__.ini", "testing/web-platform/meta/css/css-values/__dir__.ini", "testing/web-platform/meta/css/css-view-transitions/__dir__.ini", "testing/web-platform/mozilla/meta/css/css-view-transitions/__dir__.ini", "xpcom/ds/StaticAtoms.py"], "git_node": "e00696042c3b4784aeb6d8376ee7b55c21c091d4", "git_parents": ["3b2cf84fc2c1c532abbf032e785e5a551ebcfff6"], "node": "abad8518f0c5696d40ddc241a2b5db17734283e9", "parents": ["a23e3d847e41ee7fe7c4017de59cfe1563314176"], "tags": []}, {"author": "alin lastun \u003calastun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046496 - Add an \"off\" address bar state for VPN r=android-reviewers,android-l10n-reviewers,jonalmeida,parker\n\nAdded new state and action so the app knows when to show the \"off\" animation.\n\n   Added animation finish callback so the button updates only after the animation ends (no fixed timers).\n\n   Used key() on text changes so Compose creates a fresh animation each time the pill changes.\n\n   Fixed a memory leak by saving only the store reference instead of the whole toolbar object and its views.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315582\n", "files": ["mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ActionContainer.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/concept/Action.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ui/AnimatedPillButton.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Actions.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/ProxyActivation.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/CustomTabBrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionRepositoryMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/CustomTabBrowserToolbarMiddlewareTest.kt"], "git_node": "f7131e6c48a46215fa2ded109563bb00e0d05b3b", "git_parents": ["e00696042c3b4784aeb6d8376ee7b55c21c091d4"], "node": "aa4103e229ef4b07fa2643692229edf4526bbabc", "parents": ["abad8518f0c5696d40ddc241a2b5db17734283e9"], "tags": []}, {"author": "iain holmes \u003ciholmes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065015: Fix typo for UnsupportedLaunchOnLogin implementation.r=aborondo\n\nFixes the typo in the resource line\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320033\n", "files": ["toolkit/modules/launchonlogin/LaunchOnLogin.sys.mjs"], "git_node": "7973d661f0ad948df213050ae390c297572b2677", "git_parents": ["f7131e6c48a46215fa2ded109563bb00e0d05b3b"], "node": "31c221fe397e82fa4e4d153f8c57d5ae2dec9123", "parents": ["aa4103e229ef4b07fa2643692229edf4526bbabc"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1978211 - Remove two tests.\n\nThese tests test :-moz-broken on object, which hasn't work in quite a\nwhile, and trigger loads that we don't want to allow in the parent\nprocess.\n", "files": ["layout/reftests/bugs/315920-18d.html", "layout/reftests/bugs/315920-18g.html", "layout/reftests/bugs/reftest.list"], "git_node": "b34dff9b92e5c1c869bbdabc0f8a51e7e31415f3", "git_parents": ["7973d661f0ad948df213050ae390c297572b2677"], "node": "96cd60ed91e6d70e95a6843731c252920688de7e", "parents": ["31c221fe397e82fa4e4d153f8c57d5ae2dec9123"], "tags": []}, {"author": "Travis Long \u003ctlong@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053520 - Add nimbus-cli to mach android commands. r=geckoview-reviewers,nalexander\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319573\n", "files": ["mobile/android/docs/fenix.md", "mobile/android/mach_commands.py", "mobile/android/nimbus_cli.py"], "git_node": "f153474811a73a6abf10a0ac5f93920769436682", "git_parents": ["b34dff9b92e5c1c869bbdabc0f8a51e7e31415f3"], "node": "14e98ae7ca69d8cd2c2614f3cd8c101e214650a8", "parents": ["96cd60ed91e6d70e95a6843731c252920688de7e"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065060 - Update metadata for html/user-activation/navigate-to-crossorigin-redirect.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320052\n", "files": ["testing/web-platform/meta/html/user-activation/navigate-to-crossorigin-redirect.html.ini"], "git_node": "aa122ac0a584608ebf217170522991282149a17d", "git_parents": ["f153474811a73a6abf10a0ac5f93920769436682"], "node": "1e8af51d8d7b6c6ed0f1754403b8fdb9dea8a122", "parents": ["14e98ae7ca69d8cd2c2614f3cd8c101e214650a8"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065058 - Update metadata for html/semantics/scripting-1/the-script-element/module/dynamic-import/microtasks/basic.shared.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320053\n", "files": ["testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/dynamic-import/microtasks/basic.any.js.ini"], "git_node": "a06f60f42642177e61d5ea5674b8efe6d79b9345", "git_parents": ["aa122ac0a584608ebf217170522991282149a17d"], "node": "f4546ebb1ba8ff334db53ec91aa2ca39c2a8db05", "parents": ["1e8af51d8d7b6c6ed0f1754403b8fdb9dea8a122"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064688 - Create new import bookmarks related smoke test r=jajohnson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319753\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/AppAndSystemHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/MockBrowserDataHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BookmarksPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/BookmarksTest.kt"], "git_node": "846169f23f28bf07a39e8609ff80a5b137f1e491", "git_parents": ["a06f60f42642177e61d5ea5674b8efe6d79b9345"], "node": "8df61d0b90fc5c2a1f60de0d34d7cc85113e235b", "parents": ["f4546ebb1ba8ff334db53ec91aa2ca39c2a8db05"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064369 - Give the chrome text context menu's items ids. r=daleharvey\n\nThey're the insertion anchors for the item-contributing API added next.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319493\n", "files": ["toolkit/content/editMenuOverlay.js", "toolkit/content/tests/chrome/test_edit_contextmenu.html"], "git_node": "c7ba672a1fee174e4217f72f304cc2d43fbf5665", "git_parents": ["846169f23f28bf07a39e8609ff80a5b137f1e491"], "node": "a9f3021d7d382341f55e965ae6d1018211f53e50", "parents": ["8df61d0b90fc5c2a1f60de0d34d7cc85113e235b"], "tags": []}, {"author": "Sarah Clements \u003csclements@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063233 - Fix double line in account section of app menu r=nsharpley,desktop-theme-reviewers,dao\n\n* Update profiles divider, creating a new function to show and hide all relevant elements\n* Update styling and test coverage\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319480\n", "files": ["browser/base/content/browser-profiles.js", "browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser_sync.js", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "c049862ffe55c49a4e4906504699fab4d1470e45", "git_parents": ["c7ba672a1fee174e4217f72f304cc2d43fbf5665"], "node": "2f352f2f5911f595e52acd44dcf0fe0e7fad5f2b", "parents": ["a9f3021d7d382341f55e965ae6d1018211f53e50"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063169 - Add WR_FEATURE_SUPERELLIPSE variant to ps_quad_box_shadow. r=gfx-reviewers,nical\" for causing dt failures at browser_window_sizing.js\n\nThis reverts commit 42a31b4e8e79d496ff359873691355ec86d7d249.\n\nRevert \"Bug 2063169 - Add WR_FEATURE_SUPERELLIPSE variant to ps_quad_mask. r=gfx-reviewers,nical\"\n\nThis reverts commit 73cd5c16d7c4d0aa2351a0f46ab7f02a234bb930.\n", "files": ["gfx/wr/webrender/res/ps_quad_box_shadow.glsl", "gfx/wr/webrender/res/ps_quad_mask.glsl", "gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/pattern/box_shadow.rs", "gfx/wr/webrender/src/pattern/mod.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_build/src/shader_features.rs"], "git_node": "27132fcd9ae02122ff7aa6d4ecd8f2dbebbcaf28", "git_parents": ["c049862ffe55c49a4e4906504699fab4d1470e45"], "node": "8c18454c5e8dc40d21fd3bd14184c307e12745ef", "parents": ["2f352f2f5911f595e52acd44dcf0fe0e7fad5f2b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1978211 - Skip some tests on Android.\n", "files": ["layout/reftests/bugs/reftest.list"], "git_node": "bf01a05dc565a71265f7630c9b7eba63d044b1ae", "git_parents": ["27132fcd9ae02122ff7aa6d4ecd8f2dbebbcaf28"], "node": "2b462c02a16607e34967072dd198c304bdc03eaa", "parents": ["8c18454c5e8dc40d21fd3bd14184c307e12745ef"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064718 - Deliver browser-scoped permission removals to every content process holding a copy. r=timhuang\n\nRemovals were routed with BrowsingContext::GetCurrentTopByBrowserId. On tab close\nthat always returns null, since BrowsingContext::Detach unregisters the BrowserId\nbefore firing \"browsing-context-discarded\", the notification that drives\nRemoveAllForBrowser. Broadcast ClearBrowserPermissions instead; it names no\norigin, so this discloses nothing.\n\nA removal on a live tab only reached bc-\u003eCanonical()-\u003eGetContentParent(), missing\nprocesses seeded by TransmitBrowserPermissionsForPrincipal. SetBrowserPermission\ndoes carry an origin, so select its targets by permission key via\nNeedsPermissionsUpdate rather than broadcasting. That key has no tab dimension,\nso a process holding the origin for another tab is notified too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319849\n", "files": ["browser/base/content/test/permissions/browser.toml", "browser/base/content/test/permissions/browser_temporary_permissions_child_clear.js", "extensions/permissions/PermissionManager.cpp"], "git_node": "a845ae2cf750ce5c3dd6087409a7d33dd1055b66", "git_parents": ["bf01a05dc565a71265f7630c9b7eba63d044b1ae"], "node": "0e3365ccff9e0160545f5a7020d81eecf7ed44a3", "parents": ["2b462c02a16607e34967072dd198c304bdc03eaa"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064716 - Handle bulk browser-scoped permission clears in the SitePermissions observer. r=timhuang\n\nThe \"browser-perm-changed\" observer QI'd its subject to nsIPermission\nunconditionally, but a bulk clear notifies with an nsISupportsPRUint64 carrying\nthe browserId. The QI threw NS_NOINTERFACE, so no PermissionStateChange event was\ndispatched after removeAllForBrowser or removeByActionForBrowser. Discriminate on\nthe notification data, as PermissionObserver::Observe does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319850\n", "files": ["browser/modules/SitePermissions.sys.mjs", "browser/modules/test/browser/browser_SitePermissions.js"], "git_node": "4f46b1144708ba4894327ef5c675a0eccfa26a7d", "git_parents": ["a845ae2cf750ce5c3dd6087409a7d33dd1055b66"], "node": "716ced67d992bbf2d3b188920b1fdf7f98d85216", "parents": ["0e3365ccff9e0160545f5a7020d81eecf7ed44a3"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062215 - Dress the switcher's panel-list where no panel does. r=daleharvey\n\nA XUL panel paints the surface the list sits on in a chrome window, so the list keeps no background of its own; where nothing wraps it, it takes the background the widget gives it. The items take their radius from `--panel-menuitem-border-radius`, as they already take their padding and margin, since `--menuitem-border-radius` is only ever defined on a panel or a menupopup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319715\n", "files": ["browser/themes/shared/urlbar.css"], "git_node": "7825584d37611b41f61f04b4094173a712173064", "git_parents": ["4f46b1144708ba4894327ef5c675a0eccfa26a7d"], "node": "a5eee37b85d9b515e8a3a3b81ca8352c3ec6c5f3", "parents": ["716ced67d992bbf2d3b188920b1fdf7f98d85216"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2040051 - Make `nsGenericHTMLElement::GetAssociatedEditor` return an extant editor r=dom-core-reviewers,smaug\n\nThis is used only for notifying editors of new `spellcheck` value when\n`spellcheck` attr is changed. Therefore, it does not need to create\nnew `TextEditor`s immediately because new `TextEditor` will be\ninitialized with the latest `spellcheck` value. And also the root caller\nis `AfterSetAttr`. So, any script shouldn't run when initializing new\n`TextEditor` instances. So, the method should return only extant\n`TextEditor` when it's a `TextControlElement`.\n\nAdditionally, this refactors the related methods to return a raw\npointer of `EditorBase`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320015\n", "files": ["dom/html/HTMLBodyElement.cpp", "dom/html/HTMLBodyElement.h", "dom/html/nsGenericHTMLElement.cpp", "dom/html/nsGenericHTMLElement.h", "testing/web-platform/tests/html/semantics/forms/the-input-element/type-change-to-password-when-parent-has-spellcheck-attr-crash.html"], "git_node": "306c6d3d179b01aac89274e4c35c0bfe78eab85d", "git_parents": ["7825584d37611b41f61f04b4094173a712173064"], "node": "56eb775c98df1dcd7c908656df11b9a4c3c63240", "parents": ["a5eee37b85d9b515e8a3a3b81ca8352c3ec6c5f3"], "tags": []}, {"author": "Tiaan Louw \u003ctlouw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019903 - Stop loading font cmaps after shutdown begins r=layout-reviewers,jfkthame\n\nCancel pending cmap loading at AppShutdownConfirmed and remove the redundant late-shutdown observer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320082\n", "files": ["gfx/thebes/gfxPlatformFontList.cpp"], "git_node": "811896c8f32a266698faa747262710f67336065e", "git_parents": ["306c6d3d179b01aac89274e4c35c0bfe78eab85d"], "node": "000564c46824a06e26de566700d05796462a9e0a", "parents": ["56eb775c98df1dcd7c908656df11b9a4c3c63240"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2045971 [Linux] Add Vulkan support to ffvpx r=tboiko,padenot\n\n- Add Vulkan HW decode of free formats to ffvpx from ffmpeg 9917308cc209a885c6870f0345905104c6ea8799\n- Use MOZ_USE_HWDECODE_VULKAN to build Vulkan HW decode support\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318090\n", "files": ["dom/media/platforms/PDMFactory.cpp", "dom/media/platforms/ffmpeg/FFmpegDecoderModule.h", "dom/media/platforms/ffmpeg/FFmpegLibs.h", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h", "dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.cpp", "dom/media/platforms/ffmpeg/ffmpeg60/moz.build", "dom/media/platforms/ffmpeg/ffmpeg61/moz.build", "dom/media/platforms/ffmpeg/ffmpeg62/moz.build", "dom/media/platforms/ffmpeg/ffmpeg63/moz.build", "dom/media/platforms/ffmpeg/ffvpx/moz.build", "media/ffvpx/config_components.h", "media/ffvpx/config_override.h", "media/ffvpx/libavcodec/avcodec.symbols", "media/ffvpx/libavcodec/moz.build", "media/ffvpx/libavcodec/vulkan_av1.c", "media/ffvpx/libavcodec/vulkan_decode.c", "media/ffvpx/libavcodec/vulkan_decode.h", "media/ffvpx/libavcodec/vulkan_video.c", "media/ffvpx/libavcodec/vulkan_video.h", "media/ffvpx/libavcodec/vulkan_vp9.c", "media/ffvpx/libavutil/avutil.symbols", "media/ffvpx/libavutil/hwcontext_vulkan.c", "media/ffvpx/libavutil/hwcontext_vulkan.h", 