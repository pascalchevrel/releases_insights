_capture/BUILD.gn", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0045.patch", "third_party/libwebrtc/moz-patch-stack/s0055.patch", "third_party/libwebrtc/moz-patch-stack/s0074.patch", "third_party/libwebrtc/moz-patch-stack/s0082.patch", "third_party/libwebrtc/moz-patch-stack/s0086.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0098.patch", "third_party/libwebrtc/moz-patch-stack/s0100.patch", "third_party/libwebrtc/moz-patch-stack/s0104.patch", "third_party/libwebrtc/moz-patch-stack/s0109.patch"], "git_node": "c7a96f79ea186362bc6c6e65912d345fe6d26b4a", "git_parents": ["342683f956b1b28251a8303c37d67fe28c3269c6"], "node": "11631a2bf2fdaa9f54a49262b4d69282d41a8e5a", "parents": ["faa98487a8ba4a7ba175c1bc6a0e94bdacada1a6"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058693 - Vendor libwebrtc from f20b476703\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f20b476703beca9555bcfa68cacd60ad669a7607\n    Switch mac testers from Max15 x64 to Mac26 arm64\n\n    see https://chromium-review.git.corp.google.com/c/chromium/src/+/8071389\n\n    Change-Id: Ifa390bf15fb0a247b19f9834c34565571a46c992\n    Bug: None\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/489400\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48217}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/infra/specs/client.webrtc.json", "third_party/libwebrtc/infra/specs/mixins.pyl", "third_party/libwebrtc/infra/specs/mixins_webrtc.pyl", "third_party/libwebrtc/infra/specs/tryserver.webrtc.json", "third_party/libwebrtc/infra/specs/waterfalls.pyl", "third_party/libwebrtc/tools_webrtc/mb/mb_config.pyl"], "git_node": "8