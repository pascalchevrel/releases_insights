sswordmgr/test/unit/test_login_autocomplete_result.js", "toolkit/components/satchel/FillHelpers.sys.mjs", "toolkit/components/satchel/FormHistoryChild.sys.mjs", "toolkit/components/satchel/FormHistoryParent.sys.mjs", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.css", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.mjs", "toolkit/components/satchel/test/browser/browser_autocomplete.js", "toolkit/content/widgets/autocomplete-popup.js"], "git_node": "077c88d3b3f483be330d1c59eca3768341293c35", "git_parents": ["6e5a2154036a0b485f531ac49d7b3a9a4b2ae64f"], "node": "0a6338cc2d6950ba5ea8e583f0fc600e6a5e8742", "parents": ["2a633584d70fba2be119ec37bae188c172c84ba6"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062876, Bug 2060155 - Update tracker count on page load panel opens. r=kandres,desktop-theme-reviewers,dao,daleharvey DONTBUILD\" for causing failures at browser_trust_panel.js.\n\nThis reverts commit 969f1fd2d807c7db379558b7469bb57dee877ecd.\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "browser/themes/shared/identity-block/identity-block.css"], "git_node": "afb1003b8a17e2c6fb4309972391517ab5d8b829", "git_parents": ["077c88d3b3f483be330d1c59eca3768341293c35"], "node": "55fc7d3b764293d3404bf9ad2b210ac7e6e8babe", "parents": ["0a6338cc2d6950ba5ea8e583f0fc600e6a5e8742"], "tags": []}, {"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059599 - WebGPU tests not running on MacOS in release branch CI r=webgpu-reviewers,jimb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319268\n", "files": ["dom/webgpu/tests/mochitest/mochitest-disabled.toml", "dom/webgpu/tests/mochitest/mochitest-no-pref.toml", "dom/webgpu/tests/mochitest/mochitest.toml", "testing/web-platform/mozilla/meta/webgpu/__dir__.ini"], "git_node": "46b080be704b9096f7441393274bee25d1d518fa", "git_parents": ["afb1003b8a17e2c6fb4309972391517ab5d8b829"], "node": "1cc469a160a3a5b5d75943868c045f254c649d90", "parents": ["55fc7d3b764293d3404bf9ad2b210ac7e6e8babe"], "tags": []}, {"author": "mimi \u003cmjung@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059344 - Fixes close button clipped focus ring for Menu Message cards r=omc-reviewers,mviar\n\nI also updated z-index of the close button as the card illustration for some layouts was clipping the focus ring as well. This issue was present with and without nova pref enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320219\n", "files": ["browser/components/asrouter/content/components/menu-message/menu-message.css"], "git_node": "c84c81a58dc10215b83224845fcfa82355f6444e", "git_parents": ["46b080be704b9096f7441393274bee25d1d518fa"], "node": "8307bb15a7860be35d78a8cffd612d449d7fb331", "parents": ["1cc469a160a3a5b5d75943868c045f254c649d90"], "tags": []}], "date": 1787285382, "git_changesets": ["52dd3e30810e093312476d027a52ec69ef4e6d6b", "ac41fd82b2242ba66393a5d50584a21344cba134", "90bed268089ae36655738310211508f3b6fd1a09", "ad08825ff180e7158b235a0b722fbba6663c308c", "ad9ee727a2bc6cbe442111118dd3c45cd9ecfe55", "609c4cf1fabf8297f084b3eac338b6c78475b873", "b24081a77576ba0e451da29f42ab118b3f84a925", "b7a4077d9860931302f91ad00da5a2c1511893f0", "bb06c115c3fb5533bab5dd6d5ef42facc0c7856d", "a6e0324a44fd39ecd7b461bd0421eacc4122bb92", "31eb0d29c480b37664e6a65ec839e06b47726250", "418173ce145ae715d3d2944f843d4c7d12379f33", "eaf0a0ed2cd9afaf4c2e7003df8732a96363904c", "969f1fd2d807c7db379558b7469bb57dee877ecd", "91ab66d3860f1a4870b05958ec276b5fa4f7e084", "14aa4c808e098e1b15dc9808956c728994f7a9c3", "04d7c4e93d0b4543c3f8cf285a4ea3baf20d885b", "f62170256e3495b81d41d70fbf4b963dddd0c06c", "eca39e0abf6a4a40d66bd0dbdc5a2ec188de1eb0", "e95565ec70c4c52c5f4ca17f48d0c05b2825679e", "93828bb34e60e4833ed99f51b7d38b2dd3440cf8", "7706ec1d92bd03219fb6d410305229a53a25e6d0", "1009fe49afe4e6a86d97878fa66b351dfbeb6b43", "499f6d9b0d021c76fb2824e24a8d3e5ba535a239", "6e5a2154036a0b485f531ac49d7b3a9a4b2ae64f", "077c88d3b3f483be330d1c59eca3768341293c35", "afb1003b8a17e2c6fb4309972391517ab5d8b829", "46b080be704b9096f7441393274bee25d1d518fa", "c84c81a58dc10215b83224845fcfa82355f6444e"], "user": "ctuns@mozilla.com"}, "45136": {"changesets": [{"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055837 - use taskcluster-built python for test tasks. r=taskgraph-reviewers,bhearsum\" for causing python related talos failures.\n\nThis reverts commit 413330b70ec72049f8e6d7e9c970595ba7665b23.\n", "files": ["taskcluster/kinds/test/compiled.yml", "taskcluster/kinds/test/kind.yml", "taskcluster/kinds/test/misc.yml", "taskcluster/kinds/test/xpcshell.yml"], "git_node": "7b61047039c98a25b9ef5c6824089ab6c60bf54c", "git_parents": ["c84c81a58dc10215b83224845fcfa82355f6444e"], "node": "e87385c560139645e428f19949e48c6f53cad6ee", "parents": ["8307bb15a7860be35d78a8cffd612d449d7fb331"], "tags": []}], "date": 1787294465, "git_changesets": ["7b61047039c98a25b9ef5c6824089ab6c60bf54c"], "user": "csabou@mozilla.com"}, "45137": {"changesets": [{"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054925 - Don't drop SERP engagements when the docshell swaps during a top level navigation - r=search-reviewers,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319766\n", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs"], "git_node": "c11fd60695f8235ebe357a8dd23dffa6d32e4354", "git_parents": ["c84c81a58dc10215b83224845fcfa82355f6444e"], "node": "156ecdb118c3900708eaa0ce3cf09e0620b6bd76", "parents": ["8307bb15a7860be35d78a8cffd612d449d7fb331"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2036593: Wait for the process being replaced before relaunching on macOS. r=application-update-reviewers,mac-reviewers,mstange\n\nWhile two processes of the same app bundle are registered with macOS at the same time, the second one counts as another instance of the app and is given its own dock tile. That tile then stays in the dock's list of recently used applications after the process is gone, so stale icons appear to build up, roughly one per restart.\n\nSince bug 1827651 we relaunch through NSWorkspace with `createsNewApplicationInstance` set, which is what makes macOS treat the relaunched process as a separate instance rather than as the same app coming back. Bug 1914807 then added the updater as a relauncher process to give the old process a chance to shut down first, but nothing actually waited for it, so in practice the two still overlap. Going back to NSTask does not look like an option, since we rely on NSWorkspace to register the app for session resume.\n\nWe now hand the pid of the process being replaced to the relauncher, and it waits for that process to leave Launch Services before it launches the replacement. The updater does the same for the callback application after applying an update, where it already has the pid. We also stop asking for a new instance when no instance of that bundle is running, so that a relaunch reuses the dock tile that is already there.\n\nOne consequence is that a dock icon that is not kept in the dock now disappears for the short time between the old process exiting and the new one starting. Before, the two overlapped and the icon stayed put. A pinned icon, which we believe is the more common case, only loses its running indicator for that moment.\n\nThe tests cover both halves of this. One runs the relauncher directly against a pid that is still alive and checks that it waits instead of returning right away. The other restarts the browser and samples the process table across the restart to confirm that the old and the new process are never alive at the same time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316703\n", "files": ["toolkit/mozapps/update/updater/launchchild_osx.mm", "toolkit/mozapps/update/updater/updater.cpp", "toolkit/xre/nsCommandLineServiceMac.mm", "toolkit/xre/test/marionette/manifest.toml", "toolkit/xre/test/marionette/test_relaunch_dock_overlap.py"], "git_node": "a0f541eba6c133159b9bcd4d0aca7695039c8e72", "git_parents": ["c11fd60695f8235ebe357a8dd23dffa6d32e4354"], "node": "0eba31b5630fa13202f95f3dc722a1d381cd9458", "parents": ["156ecdb118c3900708eaa0ce3cf09e0620b6bd76"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060668: Remove leftovers from the Cocoa \"fit to screen\" removal. r=mac-reviewers,mstange\n\nBug 1872997 removed FitRectToVisibleAreaForScreen() but left two things behind. nsCocoaWindow::DoResize() still takes an aConstrainToCurrentScreen argument that nothing reads, and widget/tests/moz.build still maps *413277* to Widget: Cocoa even though test_bug413277.html was removed by the same change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316396\n", "files": ["widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm", "widget/tests/moz.build"], "git_node": "3361304d0194f9417ee4bcad21d16f09413913d1", "git_parents": ["a0f541eba6c133159b9bcd4d0aca7695039c8e72"], "node": "24273546ce65295f066fe32f311aa17c5ca9ec38", "parents": ["0eba31b5630fa13202f95f3dc722a1d381cd9458"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064931 - Record learn-more clicks on the dnsNotFound search CTA layout - r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320181\n", "files": ["browser/base/content/test/about/browser_aboutNetError_searchCTA.js", "toolkit/content/net-error-card.mjs"], "git_node": "4fa383acaba7743a9ec439bec8118a255c223cfe", "git_parents": ["3361304d0194f9417ee4bcad21d16f09413913d1"], "node": "fa4ebd690334a2867a2b6a4ff59cc45ef11b68ff", "parents": ["24273546ce65295f066fe32f311aa17c5ca9ec38"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055718 - Enable the dnsNotFound search CTA in Nightly - r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320182\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/test/about/browser_aboutCertError_accesskey.js", "browser/base/content/test/about/browser_aboutNetError_telemetry.js"], "git_node": "427b4a7032ab1c3e28c0756e14b6a3c5c2dcf928", "git_parents": ["4fa383acaba7743a9ec439bec8118a255c223cfe"], "node": "23eec6d9c0e52d11d7f24d997385b50895efbb2b", "parents": ["fa4ebd690334a2867a2b6a4ff59cc45ef11b68ff"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050519 - Add a gtest covering GMP plugin visibility on the first query. r=media-playback-reviewers,azebrowski\n\nHasPluginForAPI() is meant to answer only once the scan of MOZ_GMP_PATH has\nregistered the plugins it found. Assert that, for both kinds of test plugin.\n\ngmp-fake is queried first and has to stay first. It is described by a Chromium\nmanifest.json, and parsing that round trips to the main thread, so it is\nregistered a few tasks after the scan itself has run. Querying either of the\nothers first spins the event loop enough to hide the problem.\n\nThere are two suites, one querying from the main thread and one from a background\ntask queue, since the two have to wait for the scan in different ways: the latter\nruns on a thread pool worker, which refuses dispatches while it is running a\ntask. Each has to be alone in its suite so that it gets a process where nothing\nhas touched the GMP service yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319744\n", "files": ["dom/media/gtest/TestGMPPluginScan.cpp", "dom/media/gtest/moz.build"], "git_node": "3b5e77fcb1c30e7b05241e2cb2f5c6da5d45b3ef", "git_parents": ["427b4a7032ab1c3e28c0756e14b6a3c5c2dcf928"], "node": "4ac1524092034ef07aeba5b71900fa89c07d3ed4", "parents": ["23eec6d9c0e52d11d7f24d997385b50895efbb2b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050519 - Settle the GMP init promise when the GMP thread goes away. r=media-playback-reviewers,padenot\n\nInitializePlugins() settles mInitPromise from the GMP thread. If the thread is\njoined while the scan of MOZ_GMP_PATH is still in flight, the tasks that would\nhave settled it are dropped, and every EnsureInitialized() caller waits forever.\n\nSettle it from the shutdown-threads observer instead, once the thread is gone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320024\n", "files": ["dom/media/gmp/GMPServiceParent.cpp"], "git_node": "d6efb526a0f829fda2e4f124eb7e4329441534b1", "git_parents": ["3b5e77fcb1c30e7b05241e2cb2f5c6da5d45b3ef"], "node": "44851305645016249d8503717f9d1eaef97377ab", "parents": ["4ac1524092034ef07aeba5b71900fa89c07d3ed4"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050519 - Wait for GMP plugin registration before answering plugin queries. r=media-playback-reviewers,azebrowski\n\nEnsurePluginsOnDiskScanned() waited for the GMP thread to run a dummy runnable,\nand took mScannedPluginOnDisk to mean the scan had finished. Neither is a barrier\nfor plugin registration: LoadFromEnvironment() sets that flag and returns while\nthe GMPParent::Init() promises it started are still in flight, and the plugins\nthose find are appended to mPlugins by later GMP thread tasks. HasPluginForAPI()\nand FindPluginDirectoryForAPI() could therefore report a plugin as missing while\nit was still being registered.\n\nWait on EnsureInitialized() instead, which is the barrier that already exists for\n\"LoadFromEnvironment() has completed\", and drop mScannedPluginOnDisk.\n\nHow we wait depends on the calling thread, since both entry points are callable\nfrom any thread. Registering a plugin described by a Chromium manifest.json\nparses it on the main thread, so a main thread caller has to spin the event loop\nrather than block, or it would deadlock against the scan it is waiting for.\nEverywhere else we block in media::Await(), which runs its continuation on a\nbackground queue instead of dispatching to the calling thread. That matters\nbecause the calling thread may be a thread pool worker, which refuses dispatches\nwhile it is running a task, and would leave a spinning caller stuck forever.\n\nOn macOS and Windows, GMPParent::Init() also reads the plugin binary header to\ncheck its architecture. That is enough extra work for the main thread to win the\nrace, which is why TestWebrtcVideoEncoderFactory.RacyGmpPluginForwards and\nTestWebrtcVideoDecoderFactory.RacyGmpPluginForwards fail there but never on\nLinux. Also fixes bug 2051008.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319745\n", "files": ["dom/media/gmp/GMPServiceParent.cpp", "dom/media/gmp/GMPServiceParent.h"], "git_node": "cdab661372fc8c4032a1efe46dc6af68677659df", "git_parents": ["d6efb526a0f829fda2e4f124eb7e4329441534b1"], "node": "0eb2545c16f4160d5f635220bf04bc332cd1a7e3", "parents": ["44851305645016249d8503717f9d1eaef97377ab"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064969 - Extend probe expiration dates to Fx 169: browser.searchinit.*_opensearch_*. r=search-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320203\n", "files": ["toolkit/components/search/metrics.yaml"], "git_node": "5b14a0e0b22f9195016d1dc477c3d645c6d8719f", "git_parents": ["cdab661372fc8c4032a1efe46dc6af68677659df"], "node": "64fe730e06dea410bc157f33c1c46f27610ed003", "parents": ["0eb2545c16f4160d5f635220bf04bc332cd1a7e3"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064447: Ensure pdfjs updates fail if there's an error and force a clean tree r=calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319560\n", "files": ["toolkit/components/pdfjs/update.sh"], "git_node": "ddbb2a912146118792546cf6220f6535b1758e3f", "git_parents": ["5b14a0e0b22f9195016d1dc477c3d645c6d8719f"], "node": "993c3f9fa7750ce42ed1e8e1abc7dbc7b473e44b", "parents": ["64fe730e06dea410bc157f33c1c46f27610ed003"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063861 - Update irregexp to 5280f012d5ce0714c8db750cbada4251c76412c7 r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318912\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-compiler.cc", "js/src/irregexp/imported/regexp-compiler.h", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h", "js/src/irregexp/moz.yaml"], "git_node": "f375670532a8e5ca47f8e089bd37605beaf3c072", "git_parents": ["ddbb2a912146118792546cf6220f6535b1758e3f"], "node": "260c6422a4ca57f399c7d537e69c1bc45daa7ea3", "parents": ["993c3f9fa7750ce42ed1e8e1abc7dbc7b473e44b"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063861 - Apply mozilla patches for irregexp r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318913\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h"], "git_node": "61c18b622bf91e113f003a9ba9ea8f03972adf65", "git_parents": ["f375670532a8e5ca47f8e089bd37605beaf3c072"], "node": "16a75d02aa91c97e71cef143fc019afe7253f021", "parents": ["260c6422a4ca57f399c7d537e69c1bc45daa7ea3"], "tags": []}, {"author": "Pier Angelo Vendrame \u003cpierov@torproject.org\u003e", "branch": "default", "desc": "Bug 2059471: Do not spoof screen orientation when it is locked. r=tjr\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315317\n", "files": ["dom/base/ScreenOrientation.cpp"], "git_node": "98f8d2303f1f382f9618bf5be9ce4f880e21268c", "git_parents": ["61c18b622bf91e113f003a9ba9ea8f03972adf65"], "node": "c81bc88def09209953e90ffaa73617af51640357", "parents": ["16a75d02aa91c97e71cef143fc019afe7253f021"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-it/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-nb-rNO/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-it/strings.xml", "mobile/android/android-components/components/feature/contextmenu/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-cak/strings.xml", "mobile/android/fenix/app/src/main/res/values-dsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-hsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-ka/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-pa-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-ro/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml", "mobile/android/focus-android/app/src/main/res/values-it/strings.xml"], "git_node": "c4b7386a235687a9373af5e719900d9ad3bbe7e5", "git_parents": ["98f8d2303f1f382f9618bf5be9ce4f880e21268c"], "node": "690902ca472ae94e38a10e71069c503bb75c0cf9", "parents": ["c81bc88def09209953e90ffaa73617af51640357"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2064683 - Throw on BarProp.visible setter. r=vhilla,sthompson\n\nAs per discussion in D316217. There's a sessionstore caller, but\nsessionstore will open the window with the right window features\nregardless, so it's effectively a no-op (and after D316217 it is\ndefinitely a no-op).\n\nI tested restoring sessions with popup windows open and such just in\ncase it wasn't covered by tests, and it works alright.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317990\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "dom/base/BarProps.cpp", "dom/base/BarProps.h"], "git_node": "b81beae5733361f03c142663be047fc47c358811", "git_parents": ["c4b7386a235687a9373af5e719900d9ad3bbe7e5"], "node": "922d7e17a9328be48c49f17d998842bff18234be", "parents": ["690902ca472ae94e38a10e71069c503bb75c0cf9"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047032: Handle no time being set when switching into document timeline from scroll timeline. r=layout-scroll-driven-animation-reviewers,boris\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319811\n", "files": ["dom/animation/Animation.cpp", "testing/web-platform/tests/scroll-animations/crashtests/change-timeline-from-finite-to-monotonic-crash-002.html"], "git_node": "c1f1dbc44ecfb9862621fb754d075be579c195c1", "git_parents": ["b81beae5733361f03c142663be047fc47c358811"], "node": "791210cabea01dc93746cec7dd2b2fccef6e7f93", "parents": ["922d7e17a9328be48c49f17d998842bff18234be"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065206 - Disable trackerCount by default; it will be enabled via Experimenter instead. r=credential-management-reviewers,mtigley,urlbar-reviewers,akulyk,adw\n\nWe\u2019re going to set the pref to false by default for the Show Trackers feature, since we\u2019ll be using Experimenter to enable it for users instead. This approach is also safer for rollout, as it gives us full control over the feature\u2019s visibility. If anything goes wrong, we can simply disable the experiment and have the feature remain off by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320216\n", "files": ["browser/app/profile/firefox.js", "browser/components/preferences/tests/etp/browser_etp_status.js", "browser/components/urlbar/tests/browser-trustPanel/browser.toml"], "git_node": "d8965ccd54b3485e05d3596534cf08f8c24162e2", "git_parents": ["c1f1dbc44ecfb9862621fb754d075be579c195c1"], "node": "9aa6a07ade10c44c6477ec96bff185f62988a90b", "parents": ["791210cabea01dc93746cec7dd2b2fccef6e7f93"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062851: Pre-allocate Map/Set capacity when constructing from iterable r=spidermonkey-reviewers,jonco\n\nNote that this covers Map(Map), Set(Set), and Map(Array), but not Set(Array). Set(Array) is often used to deduplicate values, so the array length might be much larger than the set size. The same is technically true of Map(Array), but that's much less common. Instead, I just exposed the shrinking code so that we can do a final shrink if necessary after we're done building the Map.\n\nAs a drive-by, I removed the limitation on array length. I expect that arrays are usually going to either fail immediately or succeed. There's at least one case in chart.js where an array has 3000-some elements, and this check prevented us from taking the fast path. Pulling that code out into a microbenchmark, we're faster with the restriction removed. Given that the alternative is a walk through the entire array in self-hosted code, even the worst case here shouldn't be too significant. Testing locally, iterating over a 3000 element array with an invalid final element (a Uint8Array) was only 2% of the total time; we instead spend all our time in self-hosted MapConstructorInit.\n\nThis takes the Map microbenchmark in bug 1432565 (comment 5) from 200ms -\u003e 125ms. The Set microbenchmark goes from 105ms -\u003e 70ms. A microbenchmark creating a Map from an array goes from 210ms to 135ms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318011\n", "files": ["js/src/builtin/MapObject-inl.h", "js/src/builtin/MapObject.cpp", "js/src/builtin/OrderedHashTableObject.h"], "git_node": "cbc32d42d9a2001450a7331eb57e981c602c7a38", "git_parents": ["d8965ccd54b3485e05d3596534cf08f8c24162e2"], "node": "13e7129bc57aed75e1cd70bf0821ccea1b420490", "parents": ["9aa6a07ade10c44c6477ec96bff185f62988a90b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064194 part 1 - Make the tabbrowser's lazy-browser insertion public API. r=tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320067\n", "files": ["browser/components/extensions/parent/ext-tabs.js", "browser/components/sessionstore/test/browser_615394-SSWindowState_events_duplicateTab.js", "browser/components/sessionstore/test/browser_615394-SSWindowState_events_setTabState.js", "browser/components/sessionstore/test/browser_906076_lazy_tabs.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tabs.js", "testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs"], "git_node": "c54cc4f9832223cd44ea19f882df6aee2cfa6ee3", "git_parents": ["cbc32d42d9a2001450a7331eb57e981c602c7a38"], "node": "bb6b38a3fdb207268505c04a4110183f1768b5b3", "parents": ["13e7129bc57aed75e1cd70bf0821ccea1b420490"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064194 part 2 - Stop reaching into the tabbrowser's internals from outside it. r=tabbrowser-reviewers,fxview-reviewers,webcompat-reviewers,nsharpley,twisniewski\n\nSanitizer gets a public method for the one field it touched. The dropped `_multiSelectedTabsSet` assertions are redundant with the `multiselected` checks beside them, since a tab's `multiselected` attribute and its membership in that set are always updated together.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320068\n", "files": ["browser/components/firefoxview/tests/browser/browser_firefoxview_tab.js", "browser/components/reportbrokensite/ReportBrokenSite.sys.mjs", "browser/components/sessionstore/test/browser_1284886_suspend_tab.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_using_Ctrl.js", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_using_Shift.js", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_using_keyboard.js", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_using_selectedTabs.js", "browser/modules/Sanitizer.sys.mjs"], "git_node": "674522f01606d0ea5cfcb4fec40f88e82ab83689", "git_parents": ["c54cc4f9832223cd44ea19f882df6aee2cfa6ee3"], "node": "6ad3305314a996f3f6c9cf1bb2b999f1d8aa1807", "parents": ["bb6b38a3fdb207268505c04a4110183f1768b5b3"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064194 part 3 - Keep the tabbrowser's pref getters off the instance. r=tabbrowser-reviewers,jsudiaman\n\nThe pref getters that only this module reads move to its `lazy` object, so one observer serves every window instead of one per window. Two more move to the tab context menu, their only consumer. The one that stays is read from two sibling modules, so it becomes public API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320069\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/content/tab-context-menu.js"], "git_node": "ce6b6bc5c83b017f11af7fa134d9005c3e12a9b8", "git_parents": ["674522f01606d0ea5cfcb4fec40f88e82ab83689"], "node": "9161a637fe22893db98387aa8dc140ceaadfb169", "parents": ["6ad3305314a996f3f6c9cf1bb2b999f1d8aa1807"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064194 part 4 - Drop the tabbrowser's dead _allowTabChange check. r=tabbrowser-reviewers,nsharpley\n\nNothing has set the flag since the old print preview code went away in bug 1702501, so the condition it guarded is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320070\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "5a62ca2c47f2a7eeff7d26501af8cde062647d05", "git_parents": ["ce6b6bc5c83b017f11af7fa134d9005c3e12a9b8"], "node": "4dbc48623f80b4d48a88296128fcd2abc323f56a", "parents": ["9161a637fe22893db98387aa8dc140ceaadfb169"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064194 part 5 - Make the tabbrowser's internal members private. r=tabbrowser-reviewers,jsudiaman\n\nNothing outside the class reaches these. The members that its sibling modules and `TabProgressListener` reach keep their underscore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320071\n", "files": ["browser/components/extensions/test/browser/browser_ext_tabs_discard_reversed.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_lazy_tab_browser_events.js", "toolkit/content/tests/browser/browser_f7_caret_browsing.js"], "git_node": "9cd97a8c076a8819ff5e091da7eb7c158ca1171a", "git_parents": ["5a62ca2c47f2a7eeff7d26501af8cde062647d05"], "node": "308ca3942678d74fa6ee2c3743a6cd6731372acf", "parents": ["4dbc48623f80b4d48a88296128fcd2abc323f56a"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065143 - Refine allowed slot types for array buffer objects r=spidermonkey-reviewers,iain\n\nIf we arrange to call initFixedSlotTyped instead of setFixedSlotTypes on\ninitialization we can remove the undefined type from the slot definitions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320165\n", "files": ["js/src/vm/ArrayBufferObject.cpp", "js/src/vm/ArrayBufferObject.h"], "git_node": "d2e2baef455373552a99e685f7d6505d1a7580c8", "git_parents": ["9cd97a8c076a8819ff5e091da7eb7c158ca1171a"], "node": "cdddde5d15f0f3c82dccdcf5f5309031a5fa1e7d", "parents": ["308ca3942678d74fa6ee2c3743a6cd6731372acf"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058523 \u2014 fix --tab-group-gray for Nova dark theme r=desktop-theme-reviewers,tabbrowser-reviewers,akulyk,sthompson,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317999\n", "files": ["browser/themes/shared/tabbrowser/tab.tokens.css", "browser/themes/shared/tabbrowser/tab.tokens.jso