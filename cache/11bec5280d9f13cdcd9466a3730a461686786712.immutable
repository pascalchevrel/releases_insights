son", "services/settings/dumps/main/search-config-icons/fa0fc42c-d91d-fca7-34eb-806ff46062dc.meta.json", "services/settings/dumps/main/search-config-icons/fca3e3ee-56cd-f474-dc31-307fd24a891d.meta.json", "services/settings/dumps/main/search-config-icons/fed4f021-ff3e-942a-010e-afa43fda2136.meta.json", "services/settings/dumps/main/search-config-overrides-v2.json", "services/settings/dumps/main/search-default-override-allowlist.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/main/sites-classification.json", "services/settings/dumps/main/top-sites.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/main/translations-wasm.json", "services/settings/dumps/main/url-classifier-skip-urls.json", "services/settings/dumps/main/url-parser-default-unknown-schemes-interventions.json", "services/settings/dumps/main/urlbar-persisted-search-terms.json", "services/settings/dumps/main/websites-with-shared-credential-backends.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "8f92950e49a6c4aa86e336099436872d5d30d579", "git_parents": ["b42b38b6e8d4e33fa28b2123df1c39cce326c3fc"], "node": "07faa694aa9b58250347164809c389e48832483d", "parents": ["42f6fdcde0c55d653bd5c2ce67a55b12432c7e5f"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063203 - Fix Metal synchronisation when exporting or snapshotting canvas surfaces. r=gfx-reviewers,lsalzman\n\nCanvasTranslator::WaitForSurface() and\nCanvasTranslator::RecvSnapshotExternalCanvas() support accelerated\ncopies from Canvas2D to WebGL and from WebGL to Canvas2D,\nrespectively. Both paths copy the source canvas contents into a\ntemporary swapchain surface, which is a SharedSurface_IOSurface on\nmacOS.\n\nAfter being written to, the temporary SharedSurface_IOSurface is\nproducer-released by EndWrite(). When using Metal ANGLE,\nProducerReleaseImpl() creates a GPU fence protecting that write.\n\nThe temporary surface is subsequently acquired and released for\nreading while its surface descriptor is consumed. EndRead() calls\nProducerReadReleaseImpl(), which by default delegates to\nProducerReleaseImpl() and therefore attempts to create a second GPU\nfence. No new fence is required when releasing a read because the\nsurface was not modified. Furthermore, the fence created by the\npreceding write has not yet been consumed, so attempting to create\nanother fence triggers the assertion that no fence already exists.\n\nOverride SharedSurface_IOSurface::ProducerReadReleaseImpl() with a\nno-op so that releasing a producer read does not create another fence.\n\nThe fence created by the write to the temporary surface is also not\ncurrently consumed. Move it into the exported or snapshotted\nSurfaceDescriptorMacIOSurface descriptor, as is already done for the\nregular WebGLContext::PushRemoteTexture() presentation path. Make\nGLBlitHelper wait on the fence before blitting from the descriptor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318408\n", "files": ["gfx/gl/GLBlitHelper.cpp", "gfx/gl/SharedSurfaceIO.h", "gfx/layers/ipc/CanvasTranslator.cpp"], "git_node": "813e34cdb8c00817a14f13142cdf8789c9cb9f77", "git_parents": ["8f92950e49a6c4aa86e336099436872d5d30d579"], "node": "57434a5916fc5bdd8ef7e1f63b03e762105d5b85", "parents": ["07faa694aa9b58250347164809c389e48832483d"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061477 - Add a View Tab Groups row to the Organize Tabs panel r=desktop-theme-reviewers,fluent-reviewers,sfoster,echa,flod\n\nAuto Tab Grouping / 'Organize Tabs'\n\nFigma: https://www.figma.com/design/75Z1LtkCEUJWCxoY2KyNHv/Smart-Window-Q2?node-id=10208-85576&m=dev\n\nv0 Brief: https://docs.google.com/document/d/15_lGUTaAM6HFimBwkfBVPPCg_0ROGIyInNeLSPPb0NE/edit?tab=t.0#heading=h.k0db31goubh2\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316913\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/locales-preview/autoTabGrouping.ftl", "browser/themes/shared/smartwindowGroupTabs.css"], "git_node": "296db44a09f34f3942541edd5790de60dd160e45", "git_parents": ["813e34cdb8c00817a14f13142cdf8789c9cb9f77"], "node": "43611781d41842caccf329661ae0f9b5c8eb4e19", "parents": ["57434a5916fc5bdd8ef7e1f63b03e762105d5b85"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061010 - Add show more shortcuts Nimbus flag and secret setting. r=android-reviewers,npoon\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317954\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "0db2e7b5770a1dea59f2a3f89675f01aaa1c8afe", "git_parents": ["296db44a09f34f3942541edd5790de60dd160e45"], "node": "3c8ae1fb223c26feacfb74b4ee83c34a42ccc7fb", "parents": ["43611781d41842caccf329661ae0f9b5c8eb4e19"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062780 - Update TextButton so that it can take a content block for icons. r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317955\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/button/TextButton.kt"], "git_node": "8cdf9fb4f4a0300915b50744e350294e466b5de2", "git_parents": ["0db2e7b5770a1dea59f2a3f89675f01aaa1c8afe"], "node": "f613dde698026f56a9f267315d687bb8cec40d38", "parents": ["3c8ae1fb223c26feacfb74b4ee83c34a42ccc7fb"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061011 - Add expand/collapse control to the homepage shortcuts section r=android-reviewers,android-l10n-reviewers,parker,skhan\n\nBehind the show-more-shortcuts Nimbus feature, the shortcuts section on the\nhomepage now shows a \"Show all\" control whenever there are more shortcuts than\nfit in the collapsed grid. Expanding reveals every shortcut the store holds,\nand \"Show less\" collapses back to the first 8.\n\nThe expanded state lives in the composition rather than the app store or a\npreference, so every new tab and homepage load starts collapsed.\n\nThe control is not shown in pager mode, which keeps its own fixed truncation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317970\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/TopSiteState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/TopSites.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/TopSitesTestTag.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/TopSitesExpandToggleTest.kt"], "git_node": "8521a2ad272175fd9619f83f2e75ceb7004cfea2", "git_parents": ["8cdf9fb4f4a0300915b50744e350294e466b5de2"], "node": "331a7d43ce6faa674bf6d85801d9fbcb63a0c4a0", "parents": ["f613dde698026f56a9f267315d687bb8cec40d38"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062790 - Hide the shortcuts library button while the show more shortcuts experiment is active. r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318202\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/TopSiteState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Homepage.kt"], "git_node": "87d086088336e4bad951a7c3e44a77706497bef8", "git_parents": ["8521a2ad272175fd9619f83f2e75ceb7004cfea2"], "node": "e8a5b278dc1eb077947fa2eaa405b6b1710d9331", "parents": ["331a7d43ce6faa674bf6d85801d9fbcb63a0c4a0"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063070 - Show the add shortcut tile when the homepage shortcuts section is expanded. r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318203\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/TopSiteState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/TopSites.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/TopSiteStateTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/TopSitesExpandToggleTest.kt"], "git_node": "747501a625503b6e84dc4a2aab1eb246c984665c", "git_parents": ["87d086088336e4bad951a7c3e44a77706497bef8"], "node": "efd86572411ad682cf5ccbb3abbbc4694a6d6bad", "parents": ["e8a5b278dc1eb077947fa2eaa405b6b1710d9331"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062455 - Wait for painting to be unsuppressed before tests click on error pages, r=firefox-desktop-core-reviewers ,mossop.\n\nPresShell suppresses painting while a document is loading, to avoid showing a\npartially loaded page. It is unsuppressed by a timer armed for\nnglayout.initialpaint.delay (5ms), but that runnable is queued behind the rest\nof the page load work, so it typically runs several tens of milliseconds after\nPresShell::Initialize. On macOS this lands in the same window as the click the\ntest synthesizes, and hit testing ignores content while painting is suppressed,\nso the click resolved to the document root and fired no click event.\n\nBrowserTestUtils.waitForErrorPage now waits for painting to be unsuppressed\nbefore resolving, so that its callers don't need to know about this. Painting\nis suppressed per document, so the tests that load the error page in an iframe\ncan't rely on it, and use the new BrowserTestUtils.waitForPaintingUnsuppressed\ndirectly instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317968\n", "files": ["browser/base/content/test/about/browser.toml", "browser/base/content/test/about/head.js", "browser/components/urlbar/tests/browser-trustPanel/browser.toml", "testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs", "testing/mochitest/BrowserTestUtils/BrowserTestUtilsChild.sys.mjs", "toolkit/components/certviewer/tests/browser/browser.toml", "toolkit/components/certviewer/tests/browser/head.js"], "git_node": "519cac27f26fd9ba84316e3ccdb1f7c00e9b415c", "git_parents": ["747501a625503b6e84dc4a2aab1eb246c984665c"], "node": "7bd93deb4c86db13158913d9906296a26d404ba3", "parents": ["efd86572411ad682cf5ccbb3abbbc4694a6d6bad"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062455 - Stop skipping browser_aboutCertError.js on mac, r=firefox-desktop-core-reviewers ,Gijs.\n\nBug 1996741 was fixed while the test was skipped, and the annotation was forgotten.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317969\n", "files": ["browser/base/content/test/about/browser.toml"], "git_node": "5844c2c3d9080c46825d176ab7a416f8bc265a6f", "git_parents": ["519cac27f26fd9ba84316e3ccdb1f7c00e9b415c"], "node": "00356adaa697538d3eec92326aee97f023510ce5", "parents": ["7bd93deb4c86db13158913d9906296a26d404ba3"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062351 - Remove outer window gaps of floating chrome for nova r=desktop-theme-reviewers,emilio\" for causing mass failures. IGNORE BAD COMMIT MESSAGES.\n\nThis reverts commit dfea1bfeb5532fb35faf33da917a8044da0077f9.\n", "files": ["browser/themes/shared/browser-shared.css", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/content-area.css", "gfx/layers/apz/test/mochitest/helper_zoom_out_clamped_scrollpos.html"], "git_node": "78f706ede3b628b7fc273387e0cd8ee7ffac8a0f", "git_parents": ["5844c2c3d9080c46825d176ab7a416f8bc265a6f"], "node": "273bc34b99120757913680aca73e705bd5738583", "parents": ["00356adaa697538d3eec92326aee97f023510ce5"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063238 - doc: fix the dead DevTools contribution workflow links r=devtools-reviewers,nchevobbe\" for causing doc failures @contributing.md. IGNORE BAD COMMIT MESSAGES\n\nThis reverts commit f37ae94413728a0f5d606e116113f4de20c33b9c.\n", "files": ["devtools/docs/contributor/bugs-issues.md", "devtools/docs/contributor/contributing.md"], "git_node": "487eadb556f537f6635e5b32c01061776e994d17", "git_parents": ["78f706ede3b628b7fc273387e0cd8ee7ffac8a0f"], "node": "1e45c5c2f2bca98e3e3746d3f2f74f72542b661f", "parents": ["273bc34b99120757913680aca73e705bd5738583"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063033 - Do not delete borrowed MozFramebuffer color backings. r=gfx-reviewers,stransky,lsalzman\" for causing gtest failures @OwnedColorBackingIsDeletedWithFramebuffer. IGNORE BAD COMMIT MESSAGES\n\nThis reverts commit d9a1b493c4f318244eb03080f87fcceca739e966.\n", "files": ["gfx/gl/MozFramebuffer.cpp", "gfx/gl/MozFramebuffer.h", "gfx/gl/gtest/TestMozFramebuffer.cpp", "gfx/gl/gtest/moz.build", "gfx/layers/SurfacePoolWayland.cpp"], "git_node": "efbf88e05be1dce66f686c3537ef7d548a6319ee", "git_parents": ["487eadb556f537f6635e5b32c01061776e994d17"], "node": "702e857c12f1543e9d3252b0ef4cca70004c35e0", "pare