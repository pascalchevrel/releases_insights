smolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2065678 - ./mach test-info testrun-report: detect main branch if Git repository used also in mach_commands.py. r=ahal\" DONTBUILD\n\nThis reverts commit 1ac9c360f82e17f20c6a79c02a04439ea13b6adf.\n", "files": ["testing/mach_commands.py", "testing/testinfo.py"], "git_node": "df8999ea045933bbccd0cfe297c57ee48d516110", "git_parents": ["1ac9c360f82e17f20c6a79c02a04439ea13b6adf"], "node": "1b098a38015ae6fa81c174bcad627cd5fbf987b0", "parents": ["4aa70903295d4606646367374f5dbfe44c575307"], "tags": []}], "date": 1787648388, "git_changesets": ["df8999ea045933bbccd0cfe297c57ee48d516110"], "user": "smolnar@mozilla.com"}, "45168": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062213 - Make picking a result work in a content realm. r=daleharvey\n\nIn chrome the display spec now comes from re-parsing the URL's href rather than from the nsIURI backing the parsed URL, which agrees for anything `URL` accepts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320698\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_pickResult.js"], "git_node": "b286d5371e059342aa8af8cbda18ad57497c7584", "git_parents": ["8de196ab6b58adbe31781e661d18654cb5b0b76b"], "node": "ec2ab9b2c69dc2ca76fe5d50828622953085d8ff", "parents": ["693f59d5be8f3e82050fefee8505d3e565e9fa0c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062213 - Hand focus back to the page when Escape leaves the newtab bar at rest. r=daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320716\n", "files": ["browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_escape.js", "browser/components/urlbar/tests/browser-newtab/browser_pickResult.js", "browser/components/urlbar/tests/browser-newtab/head.js"], "git_node": "e5f704dcde0d268b002ebc07ac78cad3a091990a", "git_parents": ["b286d5371e059342aa8af8cbda18ad57497c7584"], "node": "63b3d7e2fb44870186fe547312357142f227b76d", "parents": ["ec2ab9b2c69dc2ca76fe5d50828622953085d8ff"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064369 - Move moz-urlbar off moz-input-box onto the new API. r=desktop-theme-reviewers,hjones,daleharvey\n\nThe address bar and search bar are both moz-urlbar, so they share one menu now. Each item set is scoped to its own input and hidden for the other, and AddSearchEngineHelper tracks the items it created rather than everything after its separator, which is no longer only its own.\n\nWith the wrapper an HTML element, the input's tooltip is the document's default tooltip instead of #aHTMLTooltip, because FindTooltip sends every non-XUL target there. The text still comes from the title attribute, and browser_tooltip.js checks the tooltip that opens.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319498\n", "files": ["accessible/tests/browser/events/browser_test_focus_searchbar.js", "accessible/tests/browser/events/browser_test_focus_urlbar.js", "browser/base/content/test/contextMenu/browser_contextmenu_touch.js", "browser/base/content/test/performance/browser_appmenu.js", "browser/base/content/test/performance/browser_tabopen.js", "browser/base/content/test/performance/browser_tabopen_squeeze.js", "browser/base/content/test/performance/browser_tabstrip_overflow_underflow.js", "browser/components/qrcode/test/browser/browser_qrcode_share_menu.js", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser_tooltip.js", "browser/components/urlbar/tests/browser-autofill/browser_inputField_contextmenu_dismissal.js", "browser/components/urlbar/tests/browser-autofill/browser_inputField_contextmenu_dismissal_telemetry.js", "browser/components/urlbar/tests/browser-editing/browser_urlbar_selection.js", "browser/components/urlbar/tests/browser-engagementTelemetry/head.js", "browser/components/urlbar/tests/browser-search/browser_add_search_engine.js", "browser/components/urlbar/tests/browser-tips/browser_searchTips_interaction.js", "browser/components/urlbar/tests/browser/browser_strip_on_share.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_addEngine.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_context.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_mouseNavigation.js", "browser/themes/shared/urlbar.css", "dom/security/test/https-first/browser_schemeless.js"], "git_node": "ed908a9a55a85c21171b723fb92c9260ad851d9f", "git_parents": ["e5f704dcde0d268b002ebc07ac78cad3a091990a"], "node": "0a40504630fd0e4084cfb301440233919a84af5a", "parents": ["63b3d7e2fb44870186fe547312357142f227b76d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064369 - Stop enabling XUL in the input's markup parser. r=mbeier\n\nThe markup has no XUL element left, so the parser needs no XUL support.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319899\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "a9587c6e35ab8859768abaab64173ebf89e93410", "git_parents": ["ed908a9a55a85c21171b723fb92c9260ad851d9f"], "node": "ab5f50f0aafb4a2d486a5bd6268f31dc36079303", "parents": ["0a40504630fd0e4084cfb301440233919a84af5a"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2064424 - [devtools] Make the spawnClientToDebugSystemPrincipal more similar to Browser Toolbox. r=devtools-reviewers,bomsy\n\nTo better reproduce the browser toolbox codepath use `DistinctSystemPrincipalLoader`\nwhich will use `useDevToolsGlobal` instead of `freshCompartment`.\n(So that the Browser Console and Browser Toolbox uses the same environment)\n\nAlso try to destroy the special loader when the returned client is destroyed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319531\n", "files": ["devtools/shared/commands/commands-factory.js"], "git_node": "205029cc87df0d7a94a3033c3baae1925e3f7fb6", "git_parents": ["a9587c6e35ab8859768abaab64173ebf89e93410"], "node": "af9214b45c344934fb7b2c92a6a6f4c2814eddeb", "parents": ["ab5f50f0aafb4a2d486a5bd6268f31dc36079303"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2064424 - [devtools] Always use CommandsFactory helpers to instantiate local DevToolsClient's. r=devtools-reviewers,nchevobbe\n\nThis helps share the logic to create the DevToolsServer\nand better highlights tab-debugger client (createLocalClientForTests)\nversus browser-toolbox-debugger client (spawnClientToDebugSystemPrincipal).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319532\n", "files": ["devtools/client/aboutdebugging/test/browser/helper-mocks.js", "devtools/client/framework/test/browser_about-devtools-toolbox_reload.js", "devtools/client/framework/test/browser_target_parents.js", "devtools/client/shared/test/browser_dbg_globalactor.js", "devtools/client/shared/test/browser_dbg_listaddons.js", "devtools/client/shared/test/browser_dbg_listtabs-01.js", "devtools/client/shared/test/browser_dbg_multiple-windows.js", "devtools/client/shared/test/shared-head.js", "devtools/server/tests/browser/browser_getProcess.js", "devtools/server/tests/browser/head.js", "devtools/server/tests/chrome/test_device.html", "devtools/server/tests/chrome/test_preference.html", "devtools/server/tests/xpcshell/head_dbg.js", "devtools/server/tests/xpcshell/test_addon_events.js", "devtools/server/tests/xpcshell/test_addon_reload.js", "devtools/server/tests/xpcshell/test_addons_actor.js", "devtools/server/tests/xpcshell/test_client_request.js", "devtools/server/tests/xpcshell/test_front_destroy.js", "devtools/server/tests/xpcshell/test_requestTypes.js", "devtools/server/tests/xpcshell/test_webext_apis.js", "devtools/server/tests/xpcshell/test_webextension_descriptor.js", "devtools/shared/commands/target/tests/head.js", "devtools/shared/tests/xpcshell/head_devtools.js", "devtools/shared/tests/xpcshell/test_debugger_client.js"], "git_node": "7610af17744863bb8079c335264253915492d78c", "git_parents": ["205029cc87df0d7a94a3033c3baae1925e3f7fb6"], "node": "b1db0bab4ad1394be301f89f50d00efa595b8028", "parents": ["af9214b45c344934fb7b2c92a6a6f4c2814eddeb"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2063467 - [devtools] Check for the remote pref before opening a TCP port for DevTools. r=devtools-reviewers,bomsy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319533\n", "files": ["devtools/shared/security/socket.js"], "git_node": "5578665cc054207042a4385f6dfe86ae341573d0", "git_parents": ["7610af17744863bb8079c335264253915492d78c"], "node": "6df21fce0d885ff9186b84e400e1f0aa2d38fce0", "parents": ["b1db0bab4ad1394be301f89f50d00efa595b8028"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2063463 - [devtools] Only allow custom browser toolbox path on local builds. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319534\n", "files": ["devtools/client/framework/browser-toolbox/Launcher.sys.mjs", "devtools/startup/DevToolsStartup.sys.mjs"], "git_node": "b24062b92444786a934ee62c9e5fd94a6d8aea29", "git_parents": ["5578665cc054207042a4385f6dfe86ae341573d0"], "node": "77b7846b933b9391574d1e4453651a56d7dd87e7", "parents": ["6df21fce0d885ff9186b84e400e1f0aa2d38fce0"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007696 - Split CompileForESM into three parts; r=rhunt\n\nTo support off-main thread compilation, we want a version of\nCompileForESM that doesn't require a JSContext. This splits the\ncurrent function into three parts, one that creates the CompileArgs,\none for compilation, and a third to handle the compilation results,\ncreating a WebAssembly.Module instance suitable for use as an ESM.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318573\n", "files": ["js/src/vm/Modules.cpp", "js/src/wasm/WasmJS.cpp", "js/src/wasm/WasmJS.h", "js/src/wasm/WasmModule.h", "js/src/wasm/WasmTypeDecls.h"], "git_node": "8669bb2390a24d84176853a96728a504664eed0f", "git_parents": ["b24062b92444786a934ee62c9e5fd94a6d8aea29"], "node": "5c85a2e461ab2041c07722c9ec8330ca457cbc41", "parents": ["77b7846b933b9391574d1e4453651a56d7dd87e7"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007696 - Move Wasm ESM functions to public api; r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318574\n", "files": ["js/public/Modules.h", "js/public/WasmModule.h", "js/src/vm/Modules.cpp", "js/src/wasm/WasmCompileArgs.h", "js/src/wasm/WasmJS.cpp", "js/src/wasm/WasmJS.h", "js/src/wasm/WasmSerialize.cpp"], "git_node": "831b32e535e4d2017a3add3e2330f316d0c74b9e", "git_parents": ["8669bb2390a24d84176853a96728a504664eed0f"], "node": "eebb64dc9da1ab3dd52010445d0d5055f577adf5", "parents": ["5c85a2e461ab2041c07722c9ec8330ca457cbc41"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007696 - Add OffThreadCompileTask; r=arai\n\nThis splits the existing CompileOrDecodeTask into two parts,\none of which handles cancellation, and the other compiling\nor decoding to a Stencil. The new base class will be used in\nthe next patch for CompileWasmTask.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318575\n", "files": ["dom/script/ScriptLoadContext.cpp", "dom/script/ScriptLoadContext.h", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": "103f8393dc96f86d1fcb1545d9c4c4a83dd8c229", "git_parents": ["831b32e535e4d2017a3add3e2330f316d0c74b9e"], "node": "85bfb9a68f8591d3720b409b96c2404a5dff0edf", "parents": ["eebb64dc9da1ab3dd52010445d0d5055f577adf5"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007696 - Define WasmCompileTask; r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318576\n", "files": ["dom/script/ScriptLoadContext.h", "dom/script/ScriptLoader.cpp"], "git_node": "b3723068a2d2a75ba0163648245520d99c5e5002", "git_parents": ["103f8393dc96f86d1fcb1545d9c4c4a83dd8c229"], "node": "e4ed8937211eef9d6d695ad0be268ec110ecf48f", "parents": ["85bfb9a68f8591d3720b409b96c2404a5dff0edf"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007696 - Add ModuleLoadRequest::IsSourcePhaseRequest; r=arai,dom-worker-reviewers,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319469\n", "files": ["dom/script/ModuleLoader.cpp", "dom/workers/loader/WorkerModuleLoader.cpp", "dom/worklet/loader/WorkletModuleLoader.cpp", "js/loader/ModuleLoadRequest.cpp", "js/loader/ModuleLoadRequest.h"], "git_node": "90354546713b278dbc07315e9e04cac175b83547", "git_parents": ["b3723068a2d2a75ba0163648245520d99c5e5002"], "node": "8cf1b96ba8a9945669920b0a80b1bca07444218a", "parents": ["e4ed8937211eef9d6d695ad0be268ec110ecf48f"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007696 - Use WasmCompileTask for source phase modules; r=arai,frontend-codestyle-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318577\n", "files": ["dom/base/test/file_wasm_offthread_module.sjs", "dom/base/test/mochitest.toml", "dom/base/test/test_wasm_offthread_compile.html", "dom/script/ModuleLoader.cpp", "dom/script/ScriptLoadContext.cpp", "dom/script/ScriptLoadContext.h", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "eslint-ignores.config.mjs"], "git_node": "49ebc83dbd3f478140d3cf30010bbd4046e8610e", "git_parents": ["90354546713b278dbc07315e9e04cac175b83547"], "node": "126b924193d0ec94eacf3729bf73f6fa1ac4a684", "parents": ["8cf1b96ba8a9945669920b0a80b1bca07444218a"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2007696: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/loader/ModuleLoadRequest.cpp", "js/public/WasmModule.h", "js/src/wasm/WasmJS.cpp"], "git_node": "e1ce2a9318ff81f8a10a37557e78fffa1b6246cc", "git_parents": ["49ebc83dbd3f478140d3cf30010bbd4046e8610e"], "node": "ec6a043f5c0c6ad602ef2ff891a76f6c7a3b7e67", "parents": ["126b924193d0ec94eacf3729bf73f6fa1ac4a684"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065759 - Give the tabbrowser's TabMetrics and tabLocalization an explicit getter. r=jsudiaman,tabbrowser-reviewers\n\nDefining them via ChromeUtils from init() hid both from TypeScript. The getters clear 47 of the errors that keep Tabbrowser.sys.mjs excluded from the directory's tsconfig. tabLocalization is a plain Localization rather than a DOMLocalization, so nothing about it is per-window and the one instance on lazy can serve every tabbrowser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320659\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "4da8dff6316a0a7c89d27d25c0f3af8705c3e580", "git_parents": ["e1ce2a9318ff81f8a10a37557e78fffa1b6246cc"], "node": "be6247e278909a4df061a193ad514d72e6c39918", "parents": ["ec6a043f5c0c6ad602ef2ff891a76f6c7a3b7e67"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2061517 - Remove unused sTimerID global in progressui_gtk.cpp r=gtk-reviewers,application-update-reviewers,emilio,yjuglaret\n\nsTimerID was only ever assigned, never read, which fails the build with\n-Werror,-Wunused-but-set-global on recent clang.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316933\n", "files": ["toolkit/mozapps/update/updater/progressui_gtk.cpp"], "git_node": "2bbb34d2d0792c5611ea0067fc38483331fe4c4c", "git_parents": ["4da8dff6316a0a7c89d27d25c0f3af8705c3e580"], "node": "498224daf2a71988c4e3548b0e086adc34fc2258", "parents": ["be6247e278909a4df061a193ad514d72e6c39918"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060442 - Options in feature callout dropdown menu are center-aligned instead of left-aligned - r=omc-reviewers,emcminn\n\nTest experiment with feature callout messages with a submenu dropdown: https://experimenter.services.mozilla.com/nimbus/test-only-built-in-vpn-messaging-evergreen-copy/summary/ (clone of rollout with the CFRs noted in the original bug)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320926\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "d26ed90463866c967b98366f7ddb520c98660767", "git_parents": ["2bbb34d2d0792c5611ea0067fc38483331fe4c4c"], "node": "7787718b5b3be1560fa225371bf986e445db6783", "parents": ["498224daf2a71988c4e3548b0e086adc34fc2258"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060442 - Options in feature callout dropdown menu are center-aligned instead of left-aligned - r=omc-reviewers,emcminn\" for causing node tests failures\n\nThis reverts commit d26ed90463866c967b98366f7ddb520c98660767.\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "d08cd23ee8cbffc000d9be3447b2cabf73d1465d", "git_parents": ["d26ed90463866c967b98366f7ddb520c98660767"], "node": "68bd353ac38b731f8865c3f19ea8f4baaefb8803", "parents": ["7787718b5b3be1560fa225371bf986e445db6783"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064369, Bug 2062213 - Stop enabling XUL in the input's markup parser. r=mbeier\" for causing mochitests failures\n\nThis reverts commit a9587c6e35ab8859768abaab64173ebf89e93410.\n\nRevert \"Bug 2064369 - Move moz-urlbar off moz-input-box onto the new API. r=desktop-theme-reviewers,hjones,daleharvey\"\n\nThis reverts commit ed908a9a55a85c21171b723fb92c9260ad851d9f.\n\nRevert \"Bug 2062213 - Hand focus back to the page when Escape leaves the newtab bar at rest. r=daleharvey\"\n\nThis reverts commit e5f704dcde0d268b002ebc07ac78cad3a091990a.\n\nRevert \"Bug 2062213 - Make picking a result work in a content realm. r=daleharvey\"\n\nThis reverts commit b286d5371e059342aa8af8cbda18ad57497c7584.\n", "files": ["accessible/tests/browser/events/browser_test_focus_searchbar.js", "accessible/tests/browser/events/browser_test_focus_urlbar.js", "browser/base/content/test/contextMenu/browser_contextmenu_touch.js", "browser/base/content/test/performance/browser_appmenu.js", "browser/base/content/test/performance/browser_tabopen.js", "browser/base/content/test/performance/browser_tabopen_squeeze.js", "browser/base/content/test/performance/browser_tabstrip_overflow_underflow.js", "browser/components/qrcode/test/browser/browser_qrcode_share_menu.js", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser_tooltip.js", "browser/components/urlbar/tests/browser-autofill/browser_inputField_contextmenu_dismissal.js", "browser/components/urlbar/tests/browser-autofill/browser_inputField_contextmenu_dismissal_telemetry.js", "browser/components/urlbar/tests/browser-editing/browser_urlbar_selection.js", "browser/components/urlbar/tests/browser-engagementTelemetry/head.js", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_escape.js", "browser/components/urlbar/tests/browser-newtab/browser_pickResult.js", "browser/components/urlbar/tests/browser-newtab/head.js", "browser/components/urlbar/tests/browser-search/browser_add_search_engine.js", "browser/components/urlbar/tests/browser-tips/browser_searchTips_interaction.js", "browser/components/urlbar/tests/browser/browser_strip_on_share.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_addEngine.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_context.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_mouseNavigation.js", "browser/themes/shared/urlbar.css", "dom/security/test/https-first/browser_schemeless.js"], "git_node": "d91c991d014af23c272a6408dcac2e04854272f1", "git_parents": ["d08cd23ee8cbffc000d9be3447b2cabf73d1465d"], "node": "e2b2e4be934a28d6d0572abc91a55e11e969b78d", "parents": ["68bd353ac38b731f8865c3f19ea8f4baaefb8803"], "tags": []}, {"author": "Exploding Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1928343 - Delete unused files property-sequences.h and property-sequences.cc in js/src/irregexp/imported r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320574\n", "files": ["js/src/irregexp/import-irregexp.py", "js/src/irregexp/imported/property-sequences.cc", "js/src/irregexp/imported/property-sequences.h", "js/src/irregexp/moz.build"], "git_node": "b9b4fcf2bf83d38c43cb426183ee190bdfd7106e", "git_parents": ["d91c991d014af23c272a6408dcac2e04854272f1"], "node": "1d45ca167778ca5b7c88f237e8f604757f6145e5", "parents": ["e2b2e4be934a28d6d0572abc91a55e11e969b78d"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2064531 - [Monitor Agent][FE] Move the agent monitor item into the dialog about page component r=yjamora\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319640\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js"], "git_node": "c94b4bd4d93709182a35ed3447df01f371425f8b", "git_parents": ["b9b4fcf2bf83d38c43cb426183ee190bdfd7106e"], "node": "11310a10bd417fabc00273f7f67e62266091ed5c", "parents": ["1d45ca167778ca5b7c88f237e8f604757f6145e5"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065285 - Run the media-capabilities test on Chrome. r=perftest-reviewers,sparky\n\nThe suite has only ever reported for Firefox, so its query latencies cannot be\ncompared against another browser. Nothing was blocking that beyond the app list:\nthe periodic perf cron already selects this kind for Chrome, which is why\nwebaudio reports it today.\n\nChromium-as-release is deliberately left out. It runs the same engine code for a\ncapability query, so it would roughly double the new signatures without adding\ninformation; it is worth having on metrics that move with real engine work\ninstead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320295\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/tests/benchmarks/media-capabilities.toml"], "git_node": "54b0efcb173510416622b474c9727eaaf26fa51a", "git_parents": ["c94b4bd4d93709182a35ed3447df01f371425f8b"], "node": "5cdd2c0f950b8d38a0dd3a6db50356c3c2657737", "parents": ["11310a10bd417fabc00273f7f67e62266091ed5c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065656 - Make the whole TabMetricsContext typedef visible to TypeScript. r=jsudiaman,tabbrowser-reviewers\n\nTypeScript's JSDoc parser reads the indented `@see` as the start of a new block tag and stops collecting `@property` tags there, so `isDecomposed` was not part of the type. jsdoc itself is unaffected either way, so the rendered documentation does not change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320644\n", "files": ["browser/components/tabbrowser/TabMetrics.sys.mjs"], "git_node": "c707859293365be4c7d97b513e3a14c4c6502358", "git_parents": ["54b0efcb173510416622b474c9727eaaf26fa51a"], "node": "d889f28d73af2570d6bb6ca4f435cead17a326e8", "parents": ["5cdd2c0f950b8d38a0dd3a6db50356c3c2657737"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065668 - Enable TypeScript for the tabbrowser modules that already pass. r=jsudiaman,tabbrowser-reviewers\n\nThis gates AsyncTabSwitcher, NewTabPagePreloading, OpenInTabsUtils, TabMetrics and TabUnloader; the exclude list is that set's complement, so the set itself is not visible in the diff.\n\nDropping the argument to AsyncTabSwitcher's zero-parameter onTabRemovedImpl is what takes that module to zero; the argument was ignored, so it is behaviour-neutral.\n\nGroupsList.sys.mjs is one error from joining them: it reads `saved` off a SavedTabGroupStateData, a typedef TypeScript truncates to a bare alias so the property is invisible, and that fix belongs in sessionstore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320599\n", "files": ["browser/components/tabbrowser/AsyncTabSwitcher.sys.mjs", "browser/components/tabbrowser/tsconfig.json", "taskcluster/kinds/source-test/mozlint.yml", "tools/lint/typescript.yml"], "git_node": "2d09f542b5daaf3c200dc485abf84b6a06de8bb1", "git_parents": ["c707859293365be4c7d97b513e3a14c4c6502358"], "node": "8b2f57ce256e8fd4c998d95ff6eda9a711382378", "parents": ["d889f28d73af2570d6bb6ca4f435cead17a326e8"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2066169: Update fuzzy ranges for some already-very-fuzzy color-quads tests whose rendering changed on macOS recently. r=media-playback-reviewers,padenot\n\nThe fuzzy value adjustments here are to account for the fuzzy metrics in this\nrecent demonstrative test-failure-log:\nhttps://firefoxci.taskcluster-artifacts.net/dFTAeKpZTbCjTwSdmp7uzw/0/public/logs/live_backing.log\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320987\n", "files": ["dom/media/test/reftest/color_quads/reftest.list"], "git_node": "f7370d6aae9c4b90088a2cbf3087a82f8a5be8d7", "git_parents": ["2d09f542b5daaf3c200dc485abf84b6a06de8bb1"], "node": "bd06a57fd8eb6d85296b0999994586e7c2e8ad38", "parents": ["8b2f57ce256e8fd4c998d95ff6eda9a711382378"], "tags": []}, {"author": "John Oberhauser \u003cj.git@obez.io\u003e", "branch": "default", "desc": "Bug 2060384 - Creating automotive feature module r=android-reviewers,nalexander,sfamisa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316880\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/feature/automotive/README.md", "mobile/android/android-components/components/feature/automotive/build.gradle", "mobile/android/android-components/components/feature/automotive/lint-baseline.xml", "mobile/android/android-components/components/feature/automotive/proguard-rules.pro", "mobile/android/android-components/components/feature/automotive/src/main/AndroidManifest.xml", "mobile/android/android-components/components/feature/automotive/src/main/java/mozilla/components/feature/automotive/AndroidAutomotiveFeatureFlag.kt", "mobile/android/fenix/.buildconfig.yml", "mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/automotive/AndroidAutomotiveFeatureFlag.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/SearchFragmentStore.kt", "taskcluster/config.yml"], "git_node": "7338ee31784e93b1b7159430871c1fcfb53e75ba", "git_parents": ["f7370d6aae9c4b90088a2cbf3087a82f8a5be8d7"], "node": "21c73b8e9974f6cb6254ac24c095ffb8633f3f01", "parents": ["bd06a57fd8eb6d85296b0999994586e7c2e8ad38"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1861496 - Update Lit patches to lit@3.3.3 r=tgiles\n\nThe bundle-lit.sh script stopped working when we moved to git since it\nused `git patch`, this was now making the paths relative to the firefox\nsource root. It now moves the clone into a temp directory, makes that a\ngit repository and patches it. We could probably do this inline, but\nrunning `git init` in your firefox directory seemed like it could cause\nunwanted side effects if something goes wrong.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D192008\n", "files": ["toolkit/content/vendor/lit/0001-disable-terser-step.patch", "toolkit/content/vendor/lit/0002-use-DOMParser-not-innerHTML.patch", "toolkit/content/vendor/lit/0003-Disable-source-maps.patch", "toolkit/content/vendor/lit/0004-Remove-the-bundled-warning.patch", "toolkit/content/vendor/lit/0005-Bug-1808741-Do-not-set-style-attributes-when-using-s.patch", "toolkit/content/vendor/lit/0006-Don-t-modify-Symbol-for-Symbol.metadata-polyfill.patch", "toolkit/content/vendor/lit/README.md", "toolkit/content/vendor/lit/bundle-lit.sh"], "git_node": "b4da905af32eb549519de1208b606037668b89b7", "git_parents": ["7338ee31784e93b1b7159430871c1fcfb53e75ba"], "node": "17fed91d48ed4840c7386cc2be27a5b21c8c6c9d", "parents": ["21c73b8e9974f6cb6254ac24c095ffb8633f3f01"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1861496 - Update Lit to lit@3.3.3 r=tgiles,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D192009\n", "files": ["package-lock.json", "package.json", "toolkit/content/vendor/lit/moz.yaml", "toolkit/content/widgets/vendor/lit.all.mjs"], "git_node": "0eef60e2b9390618458e66a733eef73fcc85348d", "git_parents": ["b4da905af32eb549519de1208b606037668b89b7"], "node": "20d87c99ba0cb91ca06ae25a78c47ad73b2617a7", "parents": ["17fed91d48ed4840c7386cc2be27a5b21c8c6c9d"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1861496 - Fixes for Lit upgrade r=tabbrowser-reviewers,tgiles,nsharpley,omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319226\n", "files": ["browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_multistage_mr.js", "browser/components/preferences/tests/search/browser_searchChangedEngine.js", "browser/components/preferences/tests/search/browser_search_userEngineDialog.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_tab_interactions_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_about_opentabs.js", "taskcluster/scripts/misc/vendor-verify-expected-fail.yml"], "git_node": "db1e9666708f694a4bedddc0448a5b2b56375083", "git_parents": ["0eef60e2b9390618458e66a733eef73fcc85348d"], "node": "eed94c9fc351292fcb6e4b9d7eb814595708237f", "parents": ["20d87c99ba0cb91ca06ae25a78c47ad73b2617a7"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2045765 - Add crashtest for multi-channel audio through SoundTouch time-stretcher r=media-playback-reviewers,aosmond\n\nExercises the multi-channel FIR filter path through the SoundTouch rate\ntransposer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305461\n", "files": ["dom/media/test/crashtests/2045765.html", "dom/media/test/crashtests/crashtests.list", "dom/media/test/crashtests/wav_utils.js"], "git_node": "e639507e8bdecd872141007ccd4efea93efdc65e", "git_parents": ["db1e9666708f694a4bedddc0448a5b2b56375083"], "node": "d25ac003b2d462e74a5ff0d5686431b8fff45b62", "parents": ["eed94c9fc351292fcb6e4b9d7eb814595708237f"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052270 - Add telemetry for url bar share button. r=jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319620\n", "files": ["browser/components/sharing/SharePageAction.sys.mjs", "browser/components/sharing/metrics.yaml", "browser/components/sharing/tests/browser/browser.toml", "browser/components/sharing/tests/browser/browser_testSharePanelSendToDevice.js", "browser/components/sharing/tests/browser/browser_testSharePanelTelemetry.js", "browser/components/sharing/tests/browser/head.js"], "git_node": "2207097f5c57aac87e0c43cea0868c8833dd1567", "git_parents": ["e639507e8bdecd872141007ccd4efea93efdc65e"], "node": "66a90f2e4c428c78c5c336f034229aeefe901274", "parents": ["d25ac003b2d462e74a5ff0d5686431b8fff45b62"], "tags": []}, {"author": "Tiaan Louw \u003ctlouw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065110 - Remove the layout.css.contrast-color.enabled pref r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320389\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "servo/components/style/values/specified/color.rs"], "git_node": "1c9d1af315122958a4ffe054979571ad6df75fc7", "git_parents": ["2207097f5c57aac87e0c43cea0868c8833dd1567"], "node": "e2224b164eefa5d56709070ecb3a4b5ca343bbc7", "parents": ["66a90f2e4c428c78c5c336f034229aeefe901274"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2066174 - Create pref for autocomplete dropdown record removal work. r=mtigley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320992\n", "files": ["browser/app/profile/firefox.js"], "git_node": "cb2fa705dbeac33fad88885cdd51eb7d9a53a8c6", "git_parents": ["1c9d1af315122958a4ffe054979571ad6df75fc7"], "node": "70dce978fb0419356f049ff09f917115bccb8efd", "parents": ["e2224b164eefa5d56709070ecb3a4b5ca343bbc7"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055613 - Prepare telemetry/addons tests for legacy environment addons removal r=chutten,robwu\n\nRemoves activeAddons/theme/GMPlugins test coverage from TelemetryEnvironment and\nAddonManager tests, ahead of removing the environment addons properties as part\nof the child revision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317632\n", "files": ["toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js", "toolkit/mozapps/extensions/test/xpcshell/test_EnvironmentAddonBuilder_telemetry.js", "toolkit/mozapps/extensions/test/xpcshell/test_amo_stats_telemetry.js"], "git_node": "8be22887605524377b2efdb9c23b893d6d5f5803", "git_parents": ["cb2fa705dbeac33fad88885cdd51eb7d9a53a8c6"], "node": "8f10a945fa66bffe489c234a73a9cb200b754b89", "parents": ["70dce978fb0419356f049ff09f917115bccb8efd"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055613 - Remove activeAddons/theme/activeGMPlugins from the legacy Telemetry environment r=chutten,robwu,urlbar-reviewers,jteow\n\nRemoves environment.addons along with cleaning up about:telemetry and EnvironmentAddonBuilder from\nlogic that was mainly needed due to the legacy telemetry environment.\n\nAlso updates the docs and and decrements the arewegleanyet Legacy/Glean counters.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317633\n", "files": ["browser/components/urlbar/tests/unit/test_exposure.js", "mobile/android/app/geckoview-prefs.js", "toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/docs/data/main-ping.md", "toolkit/components/telemetry/tests/marionette/tests/client/test_subsession_management.py", "toolkit/components/telemetry/tests/unit/test_CoveragePing.js", "toolkit/components/telemetry/tests/unit/test_EventPing.js", "toolkit/components/telemetry/tests/unit/test_HealthPing.js", "toolkit/components/telemetry/tests/unit/test_MainPingDisablement.js", "toolkit/components/telemetry/tests/unit/test_MigratePendingPings.js", "toolkit/components/telemetry/tests/unit/test_PingAPI.js", "toolkit/components/telemetry/tests/unit/test_TelemetryClientID_reset.js", "toolkit/components/telemetry/tests/unit/test_TelemetryController_idle.js", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js", "toolkit/components/telemetry/tests/unit/test_TelemetrySession_activeTicks.js", "toolkit/components/telemetry/tests/unit/test_UsageReporting.js", "toolkit/content/aboutTelemetry.js", "toolkit/mozapps/extensions/AddonManager.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/test_EnvironmentAddonBuilder_telemetry.js", "toolkit/mozapps/extensions/test/xpcshell/test_addons_glean_ping.js", "toolkit/mozapps/extensions/test/xpcshell/test_provider_markSafe.js", "toolkit/mozapps/extensions/test/xpcshell/test_provider_shutdown.js", "toolkit/mozapps/extensions/test/xpcshell/test_provider_unsafe_access_shutdown.js", "toolkit/mozapps/extensions/test/xpcshell/test_provider_unsafe_access_startup.js", "toolkit/mozapps/extensions/test/xpcshell/test_shutdown_early.js", "toolkit/mozapps/extensions/test/xpcshell/test_types.js", "toolkit/mozapps/extensions/test/xpcshell/xpcshell.toml"], "git_node": "c7f5b0e32802ae9a3f7dfe5d9af528a8031bda15", "git_parents": ["8be22887605524377b2efdb9c23b893d6d5f5803"], "node": "589a05df4bacc7bfa625a3dec03959163ee722cd", "parents": ["8f10a945fa66bffe489c234a73a9cb200b754b89"], "tags": []}, {"author": "Alex G \u003cagain@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062352 - [Monitor Agent][Models] Record specific error codes on failed monitor runs r=ai-security-reviewers,tetchart,thasan\n\nFailed runs currently store only the raw error message, so the UI can't\ntell a page that was never fetched apart from a genuine no-match. Failures\nare now tagged with a code at the point where they happen (timeout,\ncanceled, interrupted, content_extraction_error, prompt_load_error,\nmodel/auth/rate limit/network from the inference call) and the code is\nstored on the history entry as errorCode, validated by the store, and\nreused as the telemetry error_code instead of re-deriving it from the\nmessage. Inference failures that carry an HTTP status (MLPA reports\nbudget, QPS, and upstream limits all as 429, often with only \"NNN status\ncode\" in the message) are mapped by status before any message sniffing.\n\ngetPageContent gains a structured variant that reports per-URL success so\nthe monitor can fail a run with content_extraction_error when none of the\nwatched pages could be read, instead of asking the model about error text.\nReads that mechanically succeed but yield no text count as failed reads.\nPartial failures still run the check with the pages that loaded. Mid-run\nteardown is split by intent: deleting the monitor records canceled, while\nshutdown and stale running entries reconciled at load time record\ninterrupted.\n\nMonitor tests that extract more than once per run (snapshot capture\nplus the run-time read) now serve pages with the persistent head.js\nserver, since the one-shot MLTestUtils fixtures can't be read twice and\nfailed reads now fail the run instead of reaching the model.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318768\n", "files": ["browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/agents/MonitorStore.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser.toml", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/components/aiwindow/models/tests/browser/browser_monitor_errors.js", "browser/components/aiwindow/models/tests/xpcshell/test_Tools_GetPageContent.js"], "git_node": "14f9b441db2e31881f3bc0fcbc764fa38457d3bd", "git_parents": ["c7f5b0e32802ae9a3f7dfe5d9af528a8031bda15"], "node": "a36af388064f58645176c11c5819ce69fb34d050", "parents": ["589a05df4bacc7bfa625a3dec03959163ee722cd"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052270 - Add telemetry for url bar share button. r=jprickett\" for causing TV and bc failures at testSharePanelTelemetry.js\n\nThis reverts commit 2207097f5c57aac87e0c43cea0868c8833dd1567.\n", "files": ["browser/components/sharing/SharePageAction.sys.mjs", "browser/components/sharing/metrics.yaml", "browser/components/sharing/tests/browser/browser.toml", "browser/components/sharing/tests/browser/browser_testSharePanelSendToDevice.js", "browser/components/sharing/tests/browser/browser_testSharePanelTelemetry.js", "browser/components/sharing/tests/browser/head.js"], "git_node": "224c0c097dab9265a02ce13c757013f05fc4ecc0", "git_parents": ["14f9b441db2e31881f3bc0fcbc764fa38457d3bd"], "node": "857fc4b49cca3871d4ff48ec1f5f309b80df63fb", "parents": ["a36af388064f58645176c11c5819ce69fb34d050"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2064534 - set window taskbar concealment more consistently r=win-reviewers,handyman\n\nI think our previous attempt to fix this in bug 1957069 was calling\nOnWindowMaximized() too early for windows that didn't adopt the\nPreXULSkeletonUI. Now we wait to call it until the window is shown. We\nalso call it if we're turning on the custom titlebar, which we know is\nwhen Windows has trouble figuring this out.\n\nAdditionally, add a pref to always clear NonRudeHWND for non-fullscreen\nwindows once they are showing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320225\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "widget/windows/nsWindow.cpp", "widget/windows/nsWindowTaskbarConcealer.cpp", "widget/windows/nsWindowTaskbarConcealer.h"], "git_node": "9349836256e519437f192c475e207935b8e43f6f", "git_parents": ["224c0c097dab9265a02ce13c757013f05fc4ecc0"], "node": "b09bd67f5557162b19a3f05919b15d2f3d1a1d49", "parents": ["857fc4b49cca3871d4ff48ec1f5f309b80df63fb"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063354 - upgrade NSS to 6ca13d99c4a3517d84a0b68a7a7132821d3e0591. r=nss-reviewers,keeler UPGRADE_NSS_RELEASE\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320968\n", "files": ["security/nss/automation/abi-check/expected-report-libssl3.so.txt", "security/nss/automation/abi-check/previous-nss-release", "security/nss/automation/clang-format/Dockerfile", "security/nss/automation/clang-format/apt.llvm.org.asc", "security/nss/automation/clang-format/llvm.sources", "security/nss/automation/clang-tidy/run_clang_tidy.py", "security/nss/automation/taskcluster/scripts/run_hacl.sh", "security/nss/cmd/certutil/ce