er_inspector_highlighter-rulers_03.js", "devtools/client/inspector/test/highlighter/browser_inspector_highlighter-viewport-size.js", "devtools/server/actors/highlighters/viewport-size.js", "dom/base/nsGlobalWindowInner.cpp", "dom/base/nsGlobalWindowInner.h", "dom/base/nsGlobalWindowOuter.cpp", "dom/base/nsGlobalWindowOuter.h", "dom/base/nsPIDOMWindow.h", "dom/documentpip/DocumentPictureInPicture.cpp", "dom/webidl/Window.webidl"], "git_node": "8f96294cf795b01ce6d66083b8c7d9c881539022", "git_parents": ["b0120a627591a80c59ef10b419d790bb120064e3"], "node": "f0657403f71ba5745c4a4b7a1e6b05e46197990b", "parents": ["664a1eed595e4e28568f3c459f5e53ac45b36ab5"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke.akatsuka@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2046646 - Apply high contrast syle to result menu and switcher for Nova r=desktop-theme-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312188\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/themes/shared/urlbar-searchbar.css", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/windows/browser.css"], "git_node": "3c9c608b87caee542e4466e6a0a8fd6062a93111", "git_parents": ["8f96294cf795b01ce6d66083b8c7d9c881539022"], "node": "61d3e1211bcb1ad0148dd37a8748fe4bdf951777", "parents": ["f0657403f71ba5745c4a4b7a1e6b05e46197990b"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940240 - Part 1: Centralize reduced-precision timestamp conversion on Performance. r=canova\n\nThis moves the precision reduction code into a place more appropriate for non-LCP users.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309591\n", "files": ["dom/performance/LargestContentfulPaint.cpp", "dom/performance/Performance.cpp", "dom/performance/Performance.h"], "git_node": "4a5e27625b3b6672b67bf2edc8a5bac62ef359d2", "git_parents": ["3c9c608b87caee542e4466e6a0a8fd6062a93111"], "node": "e57e7eab7130d92607214dc1628fce78ac558f66", "parents": ["61d3e1211bcb1ad0148dd37a8748fe4bdf951777"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940240 - Part 2: Compute rect and region areas in 64-bit to avoid overflow. r=gfx-reviewers,bradwerth,lsalzman\n\nBaseRect::Area(), BaseRectAbsolute::Area() and nsRegion::Area() multiplied width by height in 32-bit arithmetic, which overflows for large integer rects (well below screen-area sizes once expressed in app units). Widen to 64-bit before multiplying for integer coordinate types.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309592\n", "files": ["gfx/2d/BaseRect.h", "gfx/2d/RectAbsolute.h", "gfx/src/nsRegion.cpp", "gfx/tests/gtest/TestRect.cpp", "gfx/tests/gtest/TestRegion.cpp"], "git_node": "fa8c1a618efef05ea8af36545df18fe4b6b84758", "git_parents": ["4a5e27625b3b6672b67bf2edc8a5bac62ef359d2"], "node": "3a4d8c1cccf6c9918a42f3faf7ad8f81e28660b1", "parents": ["e57e7eab7130d92607214dc1628fce78ac558f66"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940240 - Part 3: Implement the Container Timing API behind a pref. r=smaug,webidl,saschanaz\n\nAdds the PerformanceContainerTiming interface and the processing model from the spec on PerformanceMainThread. Each element caches its nearest containertiming ancestor, so resolving an element's container roots at paint time is O(1).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309593\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/nsGlobalWindowInner.cpp", "dom/base/nsINode.cpp", "dom/base/nsPIDOMWindow.h", "dom/html/nsGenericHTMLElement.cpp", "dom/html/nsGenericHTMLElement.h", "dom/performance/PerformanceContainerTiming.cpp", "dom/performance/PerformanceContainerTiming.h", "dom/performance/PerformanceMainThread.cpp", "dom/performance/PerformanceMainThread.h", "dom/performance/PerformanceObserver.cpp", "dom/performance/moz.build", "dom/webidl/HTMLElement.webidl", "dom/webidl/PerformanceContainerTiming.webidl", "dom/webidl/moz.build", "modules/libpref/init/StaticPrefList.yaml", "xpcom/ds/StaticAtoms.py"], "git_node": "ee7499308379d8f9ddfda9f261820dc5f5f0e491", "git_parents": ["fa8c1a618efef05ea8af36545df18fe4b6b84758"], "node": "b6275ce31028aec63416eff602cabf72f5ca3014", "parents": ["3a4d8c1cccf6c9918a42f3faf7ad8f81e28660b1"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940240 - Part 4: Record container-timing paints from the layout paint pipeline. r=layout-reviewers,emilio\n\nCalls into ContainerTimingHelpers when images, backgrounds, text, canvas and video paint, and finalizes the accumulated entries at the end of each paint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309594\n", "files": ["layout/base/PresShell.cpp", "layout/generic/nsHTMLCanvasFrame.cpp", "layout/generic/nsImageFrame.cpp", "layout/generic/nsVideoFrame.cpp", "layout/painting/nsDisplayList.cpp", "layout/svg/SVGImageFrame.cpp"], "git_node": "a7e51be85879af949b892f7da4e49c833725475c", "git_parents": ["ee7499308379d8f9ddfda9f261820dc5f5f0e491"], "node": "516822ca6629226847ea22b7592157b2c36b64ac", "parents": ["b6275ce31028aec63416eff602cabf72f5ca3014"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940240 - Part 5: Enable container-timing web platform tests. r=canova\n\nEnables the dom.enable_container_timing pref for the upstream container-timing WPTs and adds Gecko tests for a number of scenarios and canvas/video containers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309595\n", "files": ["testing/web-platform/meta/container-timing/tentative/__dir__.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-and-ignore-on-img-itself.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-and-ignore-on-text-itself.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-body-with-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-img-already-loaded.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-img-itself.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-observe-after-paint-with-buffering.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-observe-after-paint-without-buffering.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-observe-no-paint.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-text-itself.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-two-overlapping-imgs.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-with-child-ignore-and-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-with-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-with-child-text.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-with-ignore-and-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/iframe-isolation-cross-origin.sub.html.ini", "testing/web-platform/meta/container-timing/tentative/iframe-isolation-same-origin.html.ini", "testing/web-platform/meta/container-timing/tentative/ignore-with-containertiming-and-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/img-not-child-of-container-timing.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-and-ignore-on-img.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-and-ignore-on-text.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-child-img-with-ignore.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-on-img-without-ignore.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-with-ignore.html.ini", "testing/web-platform/meta/container-timing/tentative/pseudo-background-image-before-in-container-timing.html.ini", "testing/web-platform/meta/container-timing/tentative/pseudo-with-image-content-in-container-timing.html.ini", "testing/web-platform/meta/container-timing/tentative/pseudo-with-text-content-in-container-timing.html.ini", "testing/web-platform/tests/container-timing/tentative/containertiming-attribute-reflection.html", "testing/web-platform/tests/container-timing/tentative/containertiming-clips-to-viewport.html", "testing/web-platform/tests/container-timing/tentative/containertiming-html-elements-only.html", "testing/web-platform/tests/container-timing/tentative/containertiming-large-container-size.html", "testing/web-platform/tests/container-timing/tentative/containertiming-last-painted-element.html", "testing/web-platform/tests/container-timing/tentative/containertiming-movebefore-preserves-region.html", "testing/web-platform/tests/container-timing/tentative/containertiming-reconnect-empties-region.html", "testing/web-platform/tests/container-timing/tentative/containertiming-repaint.html", "testing/web-platform/tests/container-timing/tentative/containertiming-shadow-tree-excluded.html", "testing/web-platform/tests/container-timing/tentative/containertiming-with-child-canvas.html", "testing/web-platform/tests/container-timing/tentative/containertiming-with-child-video.html"], "git_node": "5255804b60861944ab26c4e0ace3d221c311d74e", "git_parents": ["a7e51be85879af949b892f7da4e49c833725475c"], "node": "cd0baab8e5aa6af0a558d4d895caefe37