es/select.js", "devtools/client/debugger/src/actions/sources/stylesheets.js", "devtools/client/debugger/test/mochitest/browser_dbg-telemetry-stylesheets.js", "devtools/client/debugger/test/mochitest/browser_qz.toml", "devtools/client/framework/toolbox-options.html", "devtools/client/framework/toolbox-options.js", "devtools/client/framework/toolbox.js", "devtools/client/shared/metrics.yaml"], "git_node": "cf66f81abbe75da45f94838ec2b96cb0b39c35d7", "git_parents": ["597a343ffd7206dbb5ecee8bf9c7e3f2b3121fd9"], "node": "7e38952e037fe985b63180f6f728186cc914e32c", "parents": ["4aa7b525b72d0ff1e84bb18ba74a96a33688f55c"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2040597 - Get rid of the warning spam in `Selection::GetComposedRange()` r=jjaschke\n\nThese warnings were used for debugging a test failure at working on\nshadow DOM selection improvements.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318649\n", "files": ["dom/base/Selection.cpp"], "git_node": "14bba1eaeab1a4d7ddf62d4cf90ec9dda54862ad", "git_parents": ["cf66f81abbe75da45f94838ec2b96cb0b39c35d7"], "node": "be95dd4c14372c83b3f66c6c74863bfcc6cb97ab", "parents": ["7e38952e037fe985b63180f6f728186cc914e32c"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051742 - Extract shared logic/component for panel-list menus - r=maxx\n\nThis stack migrates the topsites, story-card, and in-content-ad context menus from the custom ContextMenu/LinkMenu component to the reusable panel-list component.\n\nThis is just moving the option-building logic and adding a presentational PanelListItems component so the later panel-list menus can reuse both.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311430\n", "files": ["browser/extensions/newtab/content-src/components/LinkMenu/LinkMenu.jsx", "browser/extensions/newtab/content-src/components/LinkMenu/PanelListItems.jsx", "bro