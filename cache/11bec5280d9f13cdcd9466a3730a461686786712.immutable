0c72ee8f7d4e41a82f6bf\nzh-TW -\u003e b82b7a344c63c8a21450c72ee8f7d4e41a82f6bf\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "9309664a2adc38212829c727f1ba0af01e8f25ab", "git_parents": ["4bf40b7cdb3cdb7c22edfe16a6031215e2720e1c"], "node": "5791545b2e9c3144f13c3d5b139ea2b107ebf7cc", "parents": ["8de97462f3d1600664b34646c52c15b1db665883"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2065996 - Disable SharedSurface_SurfaceTexture with ANGLE on Android r=gfx-reviewers,lsalzman\n\nAs in Bug 2065359, RenderAndroidSurfaceTextureHost usage breaks WebRender rendering with ANGLE GLES on Android.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320794\n", "files": ["gfx/gl/SharedSurface.cpp", "gfx/layers/CanvasRenderer.cpp"], "git_node": "cd06fa501703463b4adceaa1018e17ca4b01aad3", "git_parents": ["9309664a2adc38212829c727f1ba0af01e8f25ab"], "node": "63d8a807c98a29ea8edb9bf6b02e20eef8cacdb9", "parents": ["5791545b2e9c3144f13c3d5b139ea2b107ebf7cc"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2066011 - Mark TRR connectionEstablisher so its runnables get prioritized r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320878\n", "files": ["netwerk/protocol/http/ConnectionEstablisher.cpp"], "git_node": "236caf1cf61145356d4375c9f08f786aa66d0713", "git_parents": ["cd06fa501703463b4adceaa1018e17ca4b01aad3"], "node": "71faed8f3d3b5c7076865e46b32e46ba06055b59", "parents": ["63d8a807c98a29ea8edb9bf6b02e20eef8cacdb9"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2066011 - Make sure runnables dispatched to the socket thread don't lose their priority r=necko-reviewers,kershaw\n\nNS_DispatchToCurrentThread dispatches to the underlying nsThread, but the runnable\npriority queue is in nsSocketTransportService::Dispatch. In order for the runnable\npriority to not be ignored, we must make sure to always dispatch to the STS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320879\n", "files": ["netwerk/base/nsSocketTransportService2.cpp", "netwerk/base/nsSocketTransportService2.h", "netwerk/dns/TRRService.cpp", "netwerk/dns/TRRService.h", "netwerk/protocol/http/ConnectionEstablisher.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/Http2StreamTunnel.cpp", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3StreamTunnel.cpp", "netwerk/protocol/http/HttpBaseChannel.h", "netwerk/protocol/http/HttpConnectionUDP.cpp", "netwerk/protocol/http/TLSTransportLayer.cpp", "netwerk/protocol/http/TRRServiceChannel.cpp", "netwerk/protocol/http/nsHttpConnection.cpp", "netwerk/protocol/http/nsHttpConnectionMgr.cpp"], "git_node": "75dfc89c821dcbaf25bb0adf9d29b2e7f84a3ec9", "git_parents": ["236caf1cf61145356d4375c9f08f786aa66d0713"], "node": "2b5c6371003c89a523b42b13320da65599b3bbae", "parents": ["71faed8f3d3b5c7076865e46b32e46ba06055b59"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063769 - [Nova] Remove row-gap on urlbar wrap to match non-wrap spacing. r=daisuke,dao,desktop-theme-reviewers,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318871\n", "files": ["browser/themes/shared/urlbar/view-nova.css"], "git_node": "e6b5aa0fb479ef3b59e76298858d4dcadea2ef08", "git_parents": ["75dfc89c821dcbaf25bb0adf9d29b2e7f84a3ec9"], "node": "16d0f768524f25f289af35899dd7dd8bab97bfc6", "parents": ["2b5c6371003c89a523b42b13320da65599b3bbae"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2063170 - [Nova] Only wrap suggests whose URL is always visible r=desktop-theme-reviewers,dao,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319050\n", "files": ["browser/themes/shared/urlbar/view-nova.css"], "git_node": "0d831a62441aaad369cfb951f0fc2637fa3c4ed8", "git_parents": ["e6b5aa0fb479ef3b59e76298858d4dcadea2ef08"], "node": "1927c7f630d21ef653703c2f1298f2fd888adb17", "parents": ["16d0f768524f25f289af35899dd7dd8bab97bfc6"], "tags": []}, {"author": "Exploding Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1910664 - Remove unused code in PageThumbs.sys.mjs and delete the test file for it r=tabbrowser-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320744\n", "files": ["toolkit/components/thumbnails/PageThumbUtils.sys.mjs", "toolkit/components/thumbnails/PageThumbs.sys.mjs", "toolkit/components/thumbnails/test/browser.toml", "toolkit/components/thumbnails/test/browser_thumbnails_preserveAspectRatio.js"], "git_node": "ce3b30a9ce4b63ab31aca5d2d968a968a34860ea", "git_parents": ["0d831a62441aaad369cfb951f0fc2637fa3c4ed8"], "node": "5804574ff53799a5366ad4bb1ac6ee3e8d4d2150", "parents": ["1927c7f630d21ef653703c2f1298f2fd888adb17"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062211 - Let UrlbarInputBaseTestUtils run outside the parent process. r=urlbar-reviewers,mbeier\n\nBehavior-neutral for the two chrome targets: every hunk reaches the same value by another route, and the reasons sit beside each.\n\n`selectWithDoubleClick` now passes its window to `synthesizeMouse`, which it had left to EventUtils' own.\n\nOnly the input event's realm is on a path this stack exercises; the rest enables methods it does not forward yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321216\n", "files": ["browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs"], "git_node": "c5a6ac08d7121e448cd85cdada7735cd9edf890b", "git_parents": ["ce3b30a9ce4b63ab31aca5d2d968a968a34860ea"], "node": "f5b6620d6694fa66719701f3d1203b74af71033b", "parents": ["5804574ff53799a5366ad4bb1ac6ee3e8d4d2150"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062211 - Give UrlbarInputBaseTestUtils a scope binding bounded to one task. r=urlbar-reviewers,mbeier\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321217\n", "files": ["browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs"], "git_node": "19af6b0be0ab941a1a48a0c426651bca5d3f031c", "git_parents": ["c5a6ac08d7121e448cd85cdada7735cd9edf890b"], "node": "9edad9f709bd8f03118fdf9fa50a558ac207b3ef", "parents": ["f5b6620d6694fa66719701f3d1203b74af71033b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062211 - Let assertPickedResult be told which path the input took. r=urlbar-reviewers,mbeier\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321218\n", "files": ["browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs"], "git_node": "3ed5a3d17b6e081b86ba809a33d8b08ec7f63b2a", "git_parents": ["19af6b0be0ab941a1a48a0c426651bca5d3f031c"], "node": "052fc76a84ea145a40d624a3e6875dde804a7ab5", "parents": ["9edad9f709bd8f03118fdf9fa50a558ac207b3ef"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062211 - Add a newtab target for the urlbar test utils. r=urlbar-reviewers,mbeier\n\nThe listener hook is the only change the chrome targets see, and its base implementation is what they already did. Nothing consumes the target yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321219\n", "files": ["browser/components/urlbar/moz.build", "browser/components/urlbar/tests/NewtabSearchbarContentTestUtils.sys.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs"], "git_node": "cb9870e246d516eb69c579719dcd37898458a1ca", "git_parents": ["3ed5a3d17b6e081b86ba809a33d8b08ec7f63b2a"], "node": "0ec5a4025431dd8dba763aee9ef51c7b064fe276", "parents": ["052fc76a84ea145a40d624a3e6875dde804a7ab5"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066446 - Fix pref handling for HW video encoding in gfxPlatform::InitHardwareVideoConfig. r=gfx-reviewers,lsalzman\n\nThe prefs applied to the decoder feature rather than the encoder\nfeature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321241\n", "files": ["gfx/thebes/gfxPlatform.cpp"], "git_node": "a6aca02c2bbde4eaf55148c865c66d3c93f89379", "git_parents": ["cb9870e246d516eb69c579719dcd37898458a1ca"], "node": "cff6be8613316da53bfad667d374da81bc5dc3fa", "parents": ["0ec5a4025431dd8dba763aee9ef51c7b064fe276"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1776950 - Fix a race condition between blob promise handling for MediaRecorder and MediaEncoder. r=pehrsons\n\nPreviously, we dispatched in MediaEncoder::MaybeExtractOrGatherBlob\nto the encoder thread, which would dispatch again to the main\nthread, racing with MediaRecorder::Session::DoSessionEndTask which\ndispatches directly to the main thread. This would cause the blobs\nto arrive out of order.\n\nThis patch makes it so that we dispatch consistently to the main\nthread first.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321423\n", "files": ["dom/media/MediaRecorder.cpp", "dom/media/encoder/MediaEncoder.cpp"], "git_node": "bd0bc1e4257a9afb2ae0aa2d3d653af08ba4598a", "git_parents": ["a6aca02c2bbde4eaf55148c865c66d3c93f89379"], "node": "99f8283589ec0061187c6d450a59231985b5c3d5", "parents": ["cff6be8613316da53bfad667d374da81bc5dc3fa"], "tags": []}, {"author": "Julia Pagnucco \u003cjpagnucco@google.com\u003e", "branch": "default", "desc": "Bug 2065398 [wpt PR 62098] - [WebMCP] Implement consequentialHint annotation, a=testonly\n\nAutomatic update from web-platform-tests\n[WebMCP] Implement consequentialHint annotation\n\nThis change implements the consequentialHint annotation for WebMCP script tools (https://github.com/webmachinelearning/webmcp/issues/176), matching the existing untrustedContentHint implementation.\n\nWhen a tool is registered with consequentialHint: true, this hint is plumbed through Blink's script tool declarations, Mojom IPC annotations, the ScriptTool actor layer, and the Chrome DevTools Protocol (CDP) WebMCP domain. This allows the browser and DevTools to identify tools that perform consequential actions (e.g., booking flights, transferring money).\n\nBug: 520004016\nTest: ModelContextTest.* unit tests\n\nThis change implements the consequentialHint annotation for WebMCP script tools, matching the existing untrustedContentHint implementation.\n\nWhen a tool is registered with consequentialHint: true, this hint is plumbed through Blink's script tool declarations, Mojom IPC annotations, the ScriptTool actor layer, and the Chrome DevTools Protocol (CDP) WebMCP domain. This allows the browser and DevTools to identify tools that perform consequential actions (e.g., booking flights, transferring money).\n\nBug: 520004016\nTest: ModelContextTest.* unit tests\n\nThis change implements the consequentialHint annotation for WebMCP script tools, see: https://github.com/webmachinelearning/webmcp/issues/176.\n\nBug: 520004016\nTest: ModelContextTest.* unit tests\nChange-Id: I9afce4e86ef9f93f860b7ba80740cb08ed7c3f36\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7985884\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nReviewed-by: Daniel Cheng \u003cdcheng@chromium.org\u003e\nCommit-Queue: Julia Pagnucco \u003cjpagnucco@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1684148}\n\n--\n\nwpt-commits: dd831980ea563818741ff8fe4cd383bbf04be7f1\nwpt-pr: 62098\n", "files": ["testing/web-platform/tests/interfaces/webmcp.idl", "testing/web-platform/tests/webmcp/imperative/exposedTo-defaults-same-origin.https.html", "testing/web-platform/tests/webmcp/imperative/getTools-imperative-annotations.https.html", "testing/web-platform/tests/webmcp/imperative/resources/helpers.js"], "git_node": "8510fa3252a20cf5e1d59f180d61c9ee82db8915", "git_parents": ["bd0bc1e4257a9afb2ae0aa2d3d653af08ba4598a"], "node": "aed499c78867fc3ea9baf2ae6c50cc6fa750a844", "parents": ["99f8283589ec0061187c6d450a59231985b5c3d5"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2063796 [wpt PR 61963] - Make document named property exposure tests deterministic, a=testonly\n\nAutomatic update from web-platform-tests\nMake document named property exposure tests deterministic\n\nLoad supported HTML resources in the outer object elements and wait for the document load event before checking supported property names. This guarantees that the outer objects are exposed and that their nested object and embed elements have an exposed object ancestor.\n\nReplace the impossible parsed embed-inside-embed fixture with an embed inside an exposed object.\n\nCo-Authored-By: codex \u003ccodex@openai.com\u003e\n\n--\n\nwpt-commits: 14bf9f5580f75d4dc98c27f685a25dfec7554671\nwpt-pr: 61963\n", "files": ["testing/web-platform/tests/html/dom/documents/dom-tree-accessors/nameditem-names.html"], "git_node": "b9be14415e9155f9f7731b1f3c9311e77f5d476a", "git_parents": ["8510fa3252a20cf5e1d59f180d61c9ee82db8915"], "node": "0dbf882c3a647ee173abbc36adacefd08d5fadbe", "parents": ["aed499c78867fc3ea9baf2ae6c50cc6fa750a844"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063796 [wpt PR 61963] - Update wpt metadata, a=testonly\n\nwpt-pr: 61963\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/dom/documents/dom-tree-accessors/nameditem-names.html.ini"], "git_node": "bada72c8e62704dc0c17eeed020756c20af58cfe", "git_parents": ["b9be14415e9155f9f7731b1f3c9311e77f5d476a"], "node": "4488a27ae1b1ef316e144dc358c3a3911488770e", "parents": ["0dbf882c3a647ee173abbc36adacefd08d5fadbe"], "tags": []}, {"author": "Celeste Pan \u003ccelestepan@microsoft.com\u003e", "branch": "default", "desc": "Bug 2065378 [wpt PR 62094] - [Masonry] Don't move auto-placement cursor after placing explicitly placed items, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Don't move auto-placement cursor after placing explicitly placed items\n\nWe resolved in the CSSWG that we do not want to move the auto-placement\ncursor after placing explicitly-placed items [1]. This change implements\nthat behavior and fixes a couple of test references that assumed the old\nbehavior. For most of the tests, the changes involved explicitly placing\nnon-important items in the test files, and for others, they involved\nupdating the test references to match the expected behavior now that\nexplicitly-placed items don't move the auto-placement cursor.\n\n[1]\nhttps://github.com/w3c/csswg-drafts/issues/13987#issuecomment-5192487721\n\nBug: 343257585, 542961411\nChange-Id: I757b8fc68c0cf085f4041639a5b4ea40161b1bce\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8266931\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCommit-Queue: Celeste Pan \u003ccelestepan@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1684322}\n\n--\n\nwpt-commits: fa5393bb9f5f7d41cc16d1aeede1809ccd378ac0\nwpt-pr: 62094\n", "files": ["testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-014-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/dense-packing/column-fill-reverse-dense-packing-definite-size-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/dense-packing/column-fill-reverse-dense-packing-definite-size-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/dense-packing/column-fill-reverse-dense-packing-indefinite-size-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/dense-packing/column-fill-reverse-dense-packing-indefinite-size-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/dense-packing/row-fill-reverse-dense-packing-definite-size-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/dense-packing/row-fill-reverse-dense-packing-definite-size-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/dense-packing/row-fill-reverse-dense-packing-indefinite-size-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/dense-packing/row-fill-reverse-dense-packing-indefinite-size-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/grid-lanes-item-placement-002-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/grid-lanes-item-placement-002.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/grid-lanes-item-placement-004-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/grid-lanes-item-placement-005-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/track-sizing/auto-repeat/column-auto-repeat-014-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/track-sizing/auto-repeat/column-auto-repeat-021-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-013-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-019-ref.html"], "git_node": "5254d0a03c5f1ec640da26b59a093cce69b0b7db", "git_parents": ["bada72c8e62704dc0c17eeed020756c20af58cfe"], "node": "a6f3f214f15bef9613fc2b6049c5aef3e1c35a57", "parents": ["4488a27ae1b1ef316e144dc358c3a3911488770e"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2055019 [wpt PR 61287] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=319281, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=319281 (#61287)\n--\n\nwpt-commits: f74c10d044dd5d9eadbfde17dc1be29d2f69236f\nwpt-pr: 61287\n", "files": ["testing/web-platform/tests/css/css-grid/grid-definition/grid-template-columns-rows-resolved-values-002.html"], "git_node": "3a0f0b981ccf10343191bafd7f198df7bd5c4a86", "git_parents": ["5254d0a03c5f1ec640da26b59a093cce69b0b7db"], "node": "19ea86dc04cc5787674b037485317d0036233acd", "parents": ["a6f3f214f15bef9613fc2b6049c5aef3e1c35a57"], "tags": []}, {"author": "sideshowbarker \u003cmike@w3.org\u003e", "branch": "default", "desc": "Bug 2065807 [wpt PR 62144] - Yank myself from a bunch of META.yml files, a=testonly\n\nAutomatic update from web-platform-tests\nYank myself from a bunch of META.yml files\n\n--\n\nwpt-commits: 6763c9ecac28f1a7042559dc031c6e6e0f6020bc\nwpt-pr: 62144\n", "files": ["testing/web-platform/tests/accname/META.yml", "testing/web-platform/tests/core-aam/META.yml", "testing/web-platform/tests/docs/META.yml", "testing/web-platform/tests/graphics-aam/META.yml", "testing/web-platform/tests/html-aam/META.yml", "testing/web-platform/tests/notifications/META.yml", "testing/web-platform/tests/svg-aam/META.yml"], "git_node": "f4597dd7c9803bc38e012370c62bc79b73676dcc", "git_parents": ["3a0f0b981ccf10343191bafd7f198df7bd5c4a86"], "node": "b1da101b16af34c53cce2021ca95a07223d50bcd", "parents": ["19ea86dc04cc5787674b037485317d0036233acd"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2065799 [wpt PR 62141] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320233, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320233 (#62141)\n--\n\nwpt-commits: adc85ef53e5ebc9840b05be1e52b8f3a49d7dd48\nwpt-pr: 62141\n", "files": ["testing/web-platform/tests/css/css-grid/layout-algorithm/flexible-column-track-intrinsic-sizing-001-crash.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/flexible-column-track-intrinsic-sizing-002-crash.html", "testing/web-platform/tests/css/css-grid/layout-algorithm/flexible-co