003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\nta -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\nte -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\nth -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\ntl -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\ntr -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\ntrs -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\nuk -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\nur -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\nuz -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\nvi -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\nwo -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\nxh -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\nzam -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\nzh-CN -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\nzh-TW -\u003e 5850ddb03a0e52cb07b00bbb95c3ad6c1caa07a7\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "301c4bb8bee2a301ee5a77131daa69cf537dcf77", "git_parents": ["3cb6e651d1c864f534b4f97f56367418430c409d"], "node": "af92af4ab2070762d354887253d8eddd448a9530", "parents": ["36d5fec4c3e1f2e19f575858090c4999e76ecf22"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2065708. Never inline ComputeClipForMaskItem on Win32 to save stack space in nsIFrame::BuildDisplayListForStackingContext. r=layout-reviewers,emilio\n\nDisplay list building recurses through BuildDisplayListForStackingContext,\nBuildDisplayListForChild and nsBlockFrame::BuildDisplayList. On Win32 we only\nhave a 1.5MB stack, so gfx/tests/crashtests/1652750-deep-scene-stack.html sits\nright at the limit and any growth in those three frames pushes it over.\n\nThe clang 22 update in bug 1977771 grew all three, by 64, 96 and 32 bytes,\ntaking one level of recursion from 2496 to 2688 bytes. That drops how deep we\ncan go from around 630 levels to around 585, which was enough to start hitting\nstack overflows again. No layout code changed.\n\nThe compiler inlines ComputeClipForMaskItem into\nBuildDisplayListForStackingContext, 1727 bytes of code in the largest of the\nthree frames. Only masked frames ever reach that code, so never inlining it on\nWin32 costs us nothing. It takes the locals in\nBuildDisplayListForStackingContext from 1456 bytes down to 1104, which puts the\nper level cost back below where it was before the clang update. This is the\nsame trick as MaybeAddAccId in this file from bug 2025119.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320629\n", "files": ["layout/generic/nsIFrame.cpp"], "git_node": "a2cba817f1295c0c9b9f06b1667f0b1149c0a87d", "git_parents": ["301c4bb8bee2a301ee5a77131daa69cf537dcf77"], "node": "b95a028fbbda9302acbbfa7bb03534a3355236f1", "parents": ["af92af4ab2070762d354887253d8eddd448a9530"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2032017 - Clean up the switcher panel-list's styling. r=daleharvey,urlbar-reviewers\" for causing failures at browser_parsable_css.js.\n\nThis reverts commit 2e2c6a2ef40c44d7c15464f8b8499bf4a3a66027.\n\nRevert \"Bug 2032017 - Don't paint a panel-list's own surface inside a XUL panel. r=desktop-theme-reviewers,emilio\"\n\nThis reverts commit 948897db62e676fddb26a9c54a94260856edaf00.\n", "files": ["browser/themes/shared/urlbar.css", "toolkit/content/widgets/panel-list/panel-list.css"], "git_node": "f6e46bbe8771fdf4b7e93d7fa11e53c980bb5273", "git_parents": ["a2cba817f1295c0c9b9f06b1667f0b1149c0a87d"], "node": "5b2a6ba3dc9ac9dec22920e1bbb00cc8de5c29c0", "parents": ["b95a028fbbda9302acbbfa7bb03534a3355236f1"], "tags": []}, {"author": "Tiaan Louw \u003ctlouw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065112 - Remove the layout.css.light-dark.images.enabled pref r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320380\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "servo/components/style/values/specified/image.rs"], "git_node": "6fff4d1c56b63af931f7675aa7971e1647557d73", "git_parents": ["f6e46bbe8771fdf4b7e93d7fa11e53c980bb5273"], "node": "8e7a45cc5ca14c61ba24faa4d28c631c5850a89c", "parents": ["5b2a6ba3dc9ac9dec22920e1bbb00cc8de5c29c0"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2065649 - Build option list by deeply traversing select subtree r=emilio,firefox-style-system-reviewers,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320588\n", "files": ["browser/base/content/test/forms/browser.toml", "browser/base/content/test/forms/browser_selectpopup_option_in_div.js", "layout/forms/nsListControlFrame.cpp", "layout/reftests/forms/select/option-in-div-multiple-ref.html", "layout/reftests/forms/select/option-in-div-multiple.html", "layout/reftests/forms/select/option-in-div-notref.html", "layout/reftests/forms/select/option-in-div-ref.html", "layout/reftests/forms/select/option-in-div.html", "layout/reftests/forms/select/reftest.list", "layout/style/res/forms.css", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-size-multiple-new-content.html.ini", "toolkit/actors/SelectChild.sys.mjs"], "git_node": "629b57335e42325a49313236615cd788b715e2af", "git_parents": ["6fff4d1c56b63af931f7675aa7971e1647557d73"], "node": "defe3db6747554b5e7ef61770868a14f7a4b7176", "parents": ["8e7a45cc5ca14c61ba24faa4d28c631c5850a89c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065683 - Remove phf from selectors. r=nicoburns\n\nWe discussed this in D302243 but never measured. Turns out rustc is\npretty clever and plain matches!() is just faster (see linked godbolt),\nso simplify the code and remove the phf dependency from selectors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320612\n", "files": ["Cargo.lock", "servo/components/selectors/Cargo.toml", "servo/components/selectors/build.rs", "servo/components/selectors/parser.rs"], "git_node": "092b4be38e4fa42c638ff6700e3f833f71085fd2", "git_parents": ["629b57335e42325a49313236615cd788b715e2af"], "node": "949de4f3b9579f4c766c52bedeeb742f9af587de", "parents": ["defe3db6747554b5e7ef61770868a14f7a4b7176"], "tags": []}], "date": 1787521105, "git_changesets": ["caf78051221bbcf5aaa525b35920901888c15d2c", "709d85e1e19b6266b5f932c536061a44d6d3567b", "7a00d307058961d0cf9cae6a879457b61986d926", "948897db62e676fddb26a9c54a94260856edaf00", "2e2c6a2ef40c44d7c15464f8b8499bf4a3a66027", "49cb1667fe081ad5a5d1a59297780a2efa51e890", "3cb6e651d1c864f534b4f97f56367418430c409d", "301c4bb8bee2a301ee5a77131daa69cf537dcf77", "a2cba817f1295c0c9b9f06b1667f0b1149c0a87d", "f6e46bbe8771fdf4b7e93d7fa11e53c980bb5273", "6fff4d1c56b63af931f7675aa7971e1647557d73", "629b57335e42325a49313236615cd788b715e2af", "092b4be38e4fa42c638ff6700e3f833f71085fd2"], "user": "agoloman@mozilla.com"}, "45153": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE DONTBUILD\n", "files": ["browser/extensions/newtab/manifest.json"], "git_node": "153093eba12ff2c9e9b81a00c8a92fb2e5cd7f72", "git_parents": ["092b4be38e4fa42c638ff6700e3f833f71085fd2"], "node": "f7d07393995ef8e17338256d249df9b86204baf0", "parents": ["949de4f3b9579f4c766c52bedeeb742f9af587de"], "tags": []}], "date": 1787561621, "git_changesets": ["153093eba12ff2c9e9b81a00c8a92fb2e5cd7f72"], "user": "ffxbld@lando.moz.tools"}, "45154": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2063955. Add patch files for usrsctp's local changes, and drop two obsolete ones. r=bwc\n\nThree changes to the vendored usrsctp sources have no patch files behind them, so\nre-vendoring reverts them and the next update would too:\n\n  bug 2045773, the TSN gap check, in netinet/sctp_indata.c\n  bug 2029734, flushing inbound stream state before sctp_process_init(), in\n    netinet/sctp_input.c\n  bug 1947783, the SCTP_INTERLEAVING_SUPPORTED define, in usrsctp.h\n\nNone of the three are cosmetic, so silently reverting them is the case to avoid.\n\nThe two patches that were listed are no longer needed, and applying them is what stops\nvendoring reproducing the tree. Both were unified build workarounds, and moz.build now\ncompiles the three files they touch in SOURCES rather than UNIFIED_SOURCES:\n\n  win32-rands.patch adds the _CRT_RAND_S define to netinet/sctp_asconf.c and\n  user_environment.h, so that rand_s is available across a unified build, as its comment\n  says. rand_s is only used in user_environment.c, which defines _CRT_RAND_S itself ahead\n  of its own includes, so now that the file is compiled on its own the define is already\n  where it needs to be.\n\n  win32-free.patch renames FREE to SCTP_BSD_FREE in netinet/sctp_bsd_addr.c, because that\n  file redefines FREE and MALLOC and used to clash with the other files in its translation\n  unit. moz.build records that clash in a comment beside the file, which is why it is built\n  on its own now. The tree keeps upstream's definition of FREE, so there is nothing left to\n  rename.\n\nSo vendoring was producing three files that disagreed with the tree while dropping three\nreal changes. Replace the two with the three.\n\nThis does not touch any vendored source, only what vendoring produces from them. Nothing\nchecked that vendoring reproduced the tree until now.\n\nAlso point the moz.yaml at Core :: WebRTC: Networking rather than Core :: Networking, which\nis what moz.build says for this directory, where bug 1947783 was filed, and who its own\nupdatebot block already names. Updatebot files from the bugzilla block, so its update bugs\nwere going to the wrong component.\n\nWith this, `./mach vendor netwerk/sctp/src/moz.yaml -r\n1330843b6ffd0c5c2d7483b07050049eedda8077 --patch-mode check --force` reproduces the\ncommitted tree exactly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319000\n", "files": ["netwerk/sctp/src/flush-before-process-init.patch", "netwerk/sctp/src/interleaving-supported-define.patch", "netwerk/sctp/src/moz.yaml", "netwerk/sctp/src/tsn-gap-check.patch", "netwerk/sctp/src/win32-free.patch", "netwerk/sctp/src/win32-rands.patch", "taskcluster/scripts/misc/vendor-verify-expected-fail.yml"], "git_node": "192ec0b0c589f195e2a5bfa9a5cd16af791c1314", "git_parents": ["092b4be38e4fa42c638ff6700e3f833f71085fd2"], "node": "a4ad6551c8b7bc586d5f2e4242f32dd29e051e12", "parents": ["949de4f3b9579f4c766c52bedeeb742f9af587de"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2049938 - define and send new fxa personalization ping. r=mconley,data-stewards\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308432\n", "files": ["browser/app/profile/firefox.js", "browser/components/AccountsGlue.sys.mjs", "browser/components/StartupTelemetry.sys.mjs", "browser/components/metrics.yaml", "browser/components/tests/browser/browser.toml", "browser/components/tests/browser/browser_browserGlue_fxa_client_info_ping.js", "services/fxaccounts/metrics.yaml", "services/fxaccounts/pings.yaml"], "git_node": "995eddcd7d07fd34597c3ba7ad2d7ddd2893b05b", "git_parents": ["192ec0b0c589f195e2a5bfa9a5cd16af791c1314"], "node": "ca3932a4a4632fc0ccd0893db23de8d69c8e6699", "parents": ["a4ad6551c8b7bc586d5f2e4242f32dd29e051e12"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2060295 r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320633\n", "files": ["gfx/layers/composite/TextureHost.cpp", "gfx/layers/opengl/TextureHostOGL.cpp"], "git_node": "dfc601359983d4ffde5bb63aa53a137736d9a68c", "git_parents": ["995eddcd7d07fd34597c3ba7ad2d7ddd2893b05b"], "node": "4ff0ae7f291ca1100edab7d8440d60e837b5afac", "parents": ["ca3932a4a4632fc0ccd0893db23de8d69c8e6699"], "tags": []}, {"author": "Exploding Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1944206 - Remove unused code in services/crypto/modules/utils.sys.mjs r=arai,markh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320684\n", "files": ["services/crypto/modules/utils.sys.mjs"], "git_node": "58d6e0fbdebc083c660c48bb6d75e0a8851cd1f7", "git_parents": ["dfc601359983d4ffde5bb63aa53a137736d9a68c"], "node": "612b651cb940b620db437e2f1ee3a76bd005f21a", "parents": ["4ff0ae7f291ca1100edab7d8440d60e837b5afac"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2061048 - doc: keep the ipdl mermaid captions out of the diagrams r=ipc-reviewers,nika DONTBUILD\n\nMyST stops parsing directive options at the first line that does not start with\na colon, so the wrapped continuation lines of these ``:caption:`` values were\nnot part of the option, they were the start of the directive body. Mermaid then\nsaw prose ahead of ``sequenceDiagram``, failed to detect a diagram type and left\nthe raw markup on the page, and the captions were silently truncated to their\nfirst line.\n\nThis is a leftover from the reStructuredText conversion, where an indented\ncontinuation did belong to the option. Move the options of all four diagrams to\nthe YAML block form so the captions can stay wrapped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319798\n", "files": ["ipc/docs/ipdl.md"], "git_node": "c3ab64b113cb2c029bb22bc5c030ec271d60195c", "git_parents": ["58d6e0fbdebc083c660c48bb6d75e0a8851cd1f7"], "node": "71516d6706f16b032f271d25868d2ff4d8adf359", "parents": ["612b651cb940b620db437e2f1ee3a76bd005f21a"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Fir