ette/manifest.toml", "toolkit/xre/test/marionette/test_relaunch_dock_overlap.py"], "git_node": "fba1962190170ae41bc1cf31d02077b1e22d7b92", "git_parents": ["69a26acc1f6a89e4623dfbbb7911ead666a7bed9"], "node": "b927d26d930aea87e678fa455dca91c1da86bb61", "parents": ["7a750194ef3ebdb4ca9f6c42357cc7737dec9995"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054925 - Don't drop SERP engagements when the docshell swaps during a top level navigation - r=search-reviewers,scunnane\" for causing failures at browser_devtools-record-capture.js.\n\nThis reverts commit c11fd60695f8235ebe357a8dd23dffa6d32e4354.\n", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs"], "git_node": "9b8f5886433bdb22b9e4726d7ace596f64785c7b", "git_parents": ["fba1962190170ae41bc1cf31d02077b1e22d7b92"], "node": "aea8e865c6f41590b593df57235ac36b631065e4", "parents": ["b927d26d930aea87e678fa455dca91c1da86bb61"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065203 - Make the logins tests pass with the JSON storage backend (again) r=credential-management-reviewers,migration-reviewers,mtigley,mconley\n\nregressed by 2063993\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320175\n", "files": ["browser/components/migration/tests/marionette/test_refresh_firefox.py", "toolkit/components/passwordmgr/test/browser/browser_doorhanger_promptToChangePassword.js"], "git_node": "28779a11fa1e16c068994f71c3446a8263a61b95", "git_parents": ["9b8f5886433bdb22b9e4726d7ace596f64785c7b"], "node": "1bb5f7439510509c3dcb9ecb8a0b4bf084a70a98", "parents": ["aea8e865c6f41590b593df57235ac36b631065e4"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1861496 - Update Lit patches to lit@3.3.3 r=tgiles\n\nThe bundle-lit.sh script stopped working when we moved to git since it\nused `git patch`, this was now making the paths relative to the firefox\nsource root. It now moves the clone into a temp directory, makes that a\ngit repository and patches it. We could probably do this inline, but\nrunning `git init` in your firefox directory seemed like it could cause\nunwanted side effects if something goes wrong.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D192008\n", "files": ["toolkit/content/vendor/lit/0001-disable-terser-step.patch", "toolkit/content/vendor/lit/0002-use-DOMParser-not-innerHTML.patch", "toolkit/content/vendor/lit/0003-Disable-source-maps.patch", "toolkit/content/vendor/lit/0004-Remove-the-bundled-warning.patch", "toolkit/content/vendor/lit/0005-Bug-1808741-Do-not-set-style-attributes-when-using-s.patch", "toolkit/content/vendor/lit/0006-Don-t-modify-Symbol-for-Symbol.metadata-polyfill.patch", "toolkit/content/vendor/lit/README.md", "toolkit/content/vendor/lit/bundle-lit.sh"], "git_node": "94e453ac1479618be5da8a74d9c766977372546d", "git_parents": ["28779a11fa1e16c068994f71c3446a8263a61b95"], "node": "09c028c87e680635051e99a14ada267a83e46e1a", "parents": ["1bb5f7439510509c3dcb9ecb8a0b4bf084a70a98"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1861496 - Update Lit to lit@3.3.3 r=tgiles,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D192009\n", "files": ["package-lock.json", "package.json", "toolkit/content/vendor/lit/moz.yaml", "toolkit/content/widgets/vendor/lit.all.mjs"], "git_node": "2ecedebae1e1721993805b654c69cd5a57886ff9", "git_parents": ["94e453ac1479618be5da8a74d9c766977372546d"], "node": "b0e0b4c0453ce6fa2fd69de10bea412c07ce9a0e", "parents": ["09c028c87e680635051e99a14ada267a83e46e1a"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1861496 - Fixes for Lit upgrade r=tabbrowser-reviewers,tgiles,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319226\n", "files": ["browser/components/preferences/tests/search/browser_searchChangedEngine.js", "browser/components/preferences/tests/search/browser_search_userEngineDialog.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_tab_interactions_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_about_opentabs.js", "taskcluster/scripts/misc/vendor-verify-expected-fail.yml"], "git_node": "4f957e8709c75e0c1d3d4353c0957b05d85c1734", "git_parents": ["2ecedebae1e1721993805b654c69cd5a57886ff9"], "node": "58acb6fa77b4c653789501b692af6f58aae9dd7d", "parents": ["b0e0b4c0453ce6fa2fd69de10bea412c07ce9a0e"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064423 - Merge the gfxFontVariationValue type with gfxFontVariation (= mozilla::gfx::FontVariation). r=layout-reviewers,TYLin\n\nNo functional change; merging the types (which are equivalent) just avoids the confusion\nthat arises when we use one type internally in thebes and have a different one that is\nexposed to the Rust code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319617\n", "files": ["gfx/thebes/gfxFT2Utils.cpp", "gfx/thebes/gfxFontUtils.cpp", "gfx/thebes/gfxFontVariations.h", "layout/inspector/InspectorFontFace.cpp"], "git_node": "3f8001b571760b89782711dc4348e68601dd8f67", "git_parents": ["4f957e8709c75e0c1d3d4353c0957b05d85c1734"], "node": "86f6dacb2bd99635a2c35e8297eb71334f93eb2c", "parents": ["58acb6fa77b4c653789501b692af6f58aae9dd7d"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064423 - Make gfxFontEntry variations query APIs use Skrifa directly if available. r=AlaskanEmily,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319619\n", "files": ["gfx/fontations_glue/lib.rs", "gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/CoreTextFontList.h", "gfx/thebes/gfxD