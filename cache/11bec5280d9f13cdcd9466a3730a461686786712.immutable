0a273a0cdd4958"], "node": "3c0fcd4402edb8ebed4cee57e09f62ffe751d349", "parents": ["cfd134bb2c36e18a47ed332add0c5b90f1722a38"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058618: apply code formatting via Lando\" for causing lint failures\n\nThis reverts commit fc80e4d55a5affbbfbc8aff5eee90a2c1a911a25.\n\nRevert \"Bug 2058618 - Guard mCharacterMap with the gfxFontEntry's RWLock. r=gfx-reviewers,lsalzman\"\n\nThis reverts commit 9606294ac903ac9bc848c0d7ba1df20ea5b88653.\n\nRevert \"Bug 2058618 - Remove some obsolete stuff from gfxFontEntry. r=gfx-reviewers,lsalzman\"\n\nThis reverts commit f0a35a5588781c5a88a6f7166ff4411bf492a8b9.\n", "files": ["gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxHarfBuzzShaper.cpp", "gfx/thebes/gfxUserFontSet.cpp", "gfx/thebes/gfxUserFontSet.h"], "git_node": "5f9786a664a7b017cc892edb60890955a239eab5", "git_parents": ["eeb9ff0218fbdb5aaec35cf8efd568fee605d2e9"], "node": "532d1be14a64738e90a4aeff8781b9aea50c8533", "parents": ["3c0fcd4402edb8ebed4cee57e09f62ffe751d349"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063548 - Create the swapped-in tab's progress listener in its own window. r=jsudiaman,tabbrowser-reviewers\n\nTabProgressListener is declared inside the file's private block scope, so it\nnever was a property of the window and swapBrowsers threw a TypeError where it\nshould have restored the tab's progress listener. Asking the owning tabbrowser\nfor the listener keeps it in the realm of the window whose tab it serves, so it\nresolves that window's globals and doesn't keep the swapping window alive.\n\nThe test drives the swap through nsIBrowser::swapBrowsers, the path that reaches\nthis code, and checks both the listener's realm and that it notifies its own\nwindow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318690\n", "files": ["browser/components/tabbrowser/content/tabbrowser.js", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_swapBrowsers.js"], "git_node": "936ee9782c6ff012b0eba0d224e850547d47c582", "git_parents": ["5f9786a664a7b017cc892edb60890955a239eab5"], "node": "af0ec50a215ccb2c42a8366d2bdc52b427d837d1", "parents": ["532d1be14a64738e90a4aeff8781b9aea50c8533"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063548 - Cancel the adopted tab's soundplaying timer in its own window. r=jsudiaman,tabbrowser-reviewers\n\nThe timer was scheduled by the window the tab is adopted from, so clearing the\nid against the adopting window's timers leaves it pending and can cancel an\nunrelated timer of the same id.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318691\n", "files": ["browser/components/tabbrowser/content/tabbrowser.js"], "git_node": "914c5a4d038f423be79c54d019f4798ab2357b5c", "git_parents": ["936ee9782c6ff012b0eba0d224e850547d47c582"], "node": "cc05575d8e79118906c270915de1938f91236a95", "parents": ["af0ec50a215ccb2c42a8366d2bdc52b427d837d1"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063518 - Don't collapse the pinned tabs container when its contents can't be measured. r=kcochrane\n\nupdatePinnedTabsHeightOnResize() clamped the persisted height to a\ngetBoundsWithoutFlushing() measurement of the items wrapper, so a measurement\ntaken before the tab strip has computed layout stuck a permanent height: 0px on\nthe container, leaving only a splitter or tab drag to recompute it. It also\napplied a height with horizontal tabs, which a height persisted for vertical\ntabs has no business sizing. SidebarState.updatePinnedTabsHeight() handles the\nhorizontal case, so defer to it.\n\nAn unmeasurable wrapper now leaves the container's height alone rather than\napplying the stored height unclamped, which reopens the gap bug 2042880 fixed --\nthe test here catches a 200px one.\n\ntest_pinned_tabs_height_reclamped_on_visibility_change asks for a launcher width\nits grid fits in, which the resizing tasks above it otherwise leave to where a\nsynthesized drag landed, and waits for that grid before measuring heights. The\nwait logs the layout it sees, since a strip that never becomes a grid otherwise\nreads as a clamping failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318747\n", "files": ["browser/components/sidebar/SidebarState.sys.mjs", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/tests/browser/browser_resize_sidebar.js"], "git_node": "3898012b603e92b4651c6baab4ae3dc8b66d408f", "git_parents": ["914c5a4d038f423be79c54d019f4798ab2357b5c"], "node": "faa3973974a3c6678c9227e497aea3a23ec9052c", "parents": ["cc05575d8e79118906c270915de1938f91236a95"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move packaging inputs out of Make r=firefox-build-system-reviewers,sergesanspaille\n\nPackaging inputs decided during configure move to `moz.configure`. The package\nnames cannot move with them, because `PKG_BASENAME` depends on `AB_CD`, which\n`config/config.mk` documents as overridable on the make command line. Python\nequivalents live in `mozbuild/packaging.py`, and the legacy formulas and\n`LPROJ_ROOT` stay in Make.\n\nConfigure exports `MOZ_PKG_DIR_DEFAULT` and Make applies it with `?=`, because a\n`MOZ_PKG_DIR` set by configure would take precedence over the environment and\ndefeat the override `./mach repackage snap` relies on. `MOZ_PKG_DUPEFLAGS` stays\noverridable, since `comm-central` still sets it directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317228\n", "files": ["browser/installer/Makefile.in", "browser/moz.configure", "mobile/android/installer/Makefile.in", "mobile/android/moz.configure", "mobile/ios/installer/Makefile.in", "mobile/ios/moz.configure", "python/mozbuild/mozbuild/packaging.py", "python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_packaging.py", "toolkit/moz.configure", "toolkit/mozapps/installer/informulate.py", "toolkit/mozapps/installer/package-name.mk", "toolkit/mozapps/installer/packager.mk", "toolkit/mozapps/installer/upload-files.mk"], "git_node": "2fdd7a1279999b944b95f227da5e650dbc276c22", "git_parents": ["3898012b603e92b4651c6baab4ae3dc8b66d408f"], "node": "e1f815c2d72f272dd3f9017221291d8b982708f6", "parents": ["faa3973974a3c6678c9227e497aea3a23ec9052c"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2063580 - Fix RESULT_SOURCE.BOOKMARKS value r=adw,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318703\n", "files": ["browser/components/urlbar/tests/unit/test_UrlbarProviderTopSites.js"], "git_node": "59f2578b9b32fe769b1c0f3f4b46f6644cd19466", "git_parents": ["2fdd7a1279999b944b95f227da5e650dbc276c22"], "node": "36e62dbd65b67a20b6023fe6755a87ef2404382f", "parents": ["e1f815c2d72f272dd3f9017221291d8b982708f6"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2063521 [Linux] Use gfxVars::CanUseVulkanHardwareVideoDecoding() to check vulkan status r=jld,sandbox-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318671\n", "files": ["security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp"], "git_node": "f706a0b311b611584f1cf9b7d7d2bb7107d3b3a0", "git_parents": ["59f2578b9b32fe769b1c0f3f4b46f6644cd19466"], "node": "e6bca86256deb953ed28875935d982d6336e9dfd", "parents": ["36e62dbd65b67a20b6023fe6755a87ef2404382f"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063032 - update URL with new UTM params - r=lesleynorton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318479\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser.toml", "browser/base/content/test/sync/browser_fxa_cta_links.js"], "git_node": "485441bd2653a374b54da757d51a02df1d103993", "git_parents": ["f706a0b311b611584f1cf9b7d7d2bb7107d3b3a0"], "node": "15d4efe4a127a6d15c77fcfa2246ed81af87c3c5", "parents": ["e6bca86256deb953ed28875935d982d6336e9dfd"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063521 [Linux] Use gfxVars::CanUseVulkanHardwareVideoDecoding() to check vulkan status r=jld,sandbox-reviewers\" for causing build bustages\n\nThis reverts commit f706a0b311b611584f1cf9b7d7d2bb7107d3b3a0.\n", "files": ["security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp"], "git_node": "0f5deba013d8fbf9a94ef128a571b282bc321e81", "git_parents": ["485441bd2653a374b54da757d51a02df1d103993"], "node": "9215551f6f3dfdac078e4c3469a3c68937f9b85d", "parents": ["15d4efe4a127a6d15c77fcfa2246ed81af87c3c5"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062779 - Container site association UI r=desktop-theme-reviewers,tgiles,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317944\n", "files": ["browser/components/contextualidentity/content/container-select.css", "browser/components/contextualidentity/content/container-select.mjs", "browser/components/contextualidentity/jar.mn", "browser/components/preferences/config/containers.mjs", "browser/components/preferences/dialogs/containers.xhtml", "browser/components/preferences/dialogs/jar.mn", "browser/components/preferences/dialogs/siteContainer.js", "browser/components/preferences/dialogs/siteContainer.xhtml", "browser/components/preferences/preferences.js", "browser/components/preferences/preferences.xhtml", "browser/components/preferences/tests/privacy/browser-srd.toml", "browser/components/preferences/tests/privacy/browser.toml", "browser/components/preferences/tests/privacy/browser_container_select.js", "browser/components/preferences/tests/privacy/browser_containers_site_associations.js", "browser/locales/en-US/browser/preferences/containers.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/themes/shared/preferences/preferences.css", "browser/themes/shared/usercontext/container-editor.css"], "git_node": "6707bff8efb68fb515232b555770d07cdeb3dd02", "git_parents": ["0f5deba013d8fbf9a94ef128a571b282bc321e81"], "node": "3ae821d139ba2821173826697f050cdf4d217be1", "parents": ["9215551f6f3dfdac078e4c3469a3c68937f9b85d"], "tags": []}, {"author": "SaaSha Pina \u003csaasha@heysparkbox.com\u003e", "branch": "default", "desc": "Bug 2045878 - Give browser toolbars a solid background under Nova with vertical tabs. r=desktop-theme-reviewers,hjones\n\nExtend .browser-toolbar so bookmarks and notifications get --toolbar-background-color when vertical tabs would otherwise leave them transparent. Zero Nova infobar margins on #notifications-toolbar so borders span full width.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312829\n", "files": ["browser/themes/shared/browser-shared.css"], "git_node": "a7b7c9c19b8535e213c08cb0562165efcf9b9831", "git_parents": ["6707bff8efb68fb515232b555770d07cdeb3dd02"], "node": "a761b3694d29c238eb8aba32a8abf5c213c122b0", "parents": ["3ae821d139ba2821173826697f050cdf4d217be1"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058093 - Probe directory access using internal backupservice state. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318283\n", "files": ["browser/components/backup/actors/BackupUIChild.sys.mjs", "browser/components/backup/actors/BackupUIParent.sys.mjs", "browser/components/backup/content/turn-on-scheduled-backups.mjs", "browser/components/backup/tests/browser/browser_settings_turn_on_scheduled_backups.js"], "git_node": "c89eda214d99f271e7d66b69e7a0b3b424ae7741", "git_parents": ["a7b7c9c19b8535e213c08cb0562165efcf9b9831"], "node": "5e826019e563b445a93137285efa0e6161dbaf41", "parents": ["a761b3694d29c238eb8aba32a8abf5c213c122b0"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP - r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318822\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "c6e6c92023a4981aa26cbc1c2cc021d402945b13", "git_parents": ["c89eda214d99f271e7d66b69e7a0b3b424ae7741"], "node": "e0a8caa36ba5ed7f3ed10c09983c97f527085067", "parents": ["5e826019e563b445a93137285efa0e6161dbaf41"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063644 - Remove obsolete nsFrame references from comments. r=dshin\n\nWe removed `nsFrame` in bug 1630704. The code now lives in `nsIFrame`.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/329\n", "files": ["layout/generic/nsFirstLetterFrame.h", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "layout/xul/nsSliderFrame.cpp"], "git_node": "61ea736802d206acf46e03a861b62d00a4151155", "git_parents": ["c6e6c92023a4981aa26cbc1c2cc021d402945b13"], "node": "6a569bc16453d0943b123bb6673d331bb0ee9349", "parents": ["e0a8caa36ba5ed7f3ed10c09983c97f527085067"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2063669 - Mark a timed out xpcshell test done again so the scheduler stops waiting for it, r=ahal.\n\nA test process that gets killed on timeout often leaves a child process behind\nholding the stdout pipe the harness reads, so communicate() never sees EOF and\nrun_test() never returns. testTimeout used to set done itself, which let the\nscheduler abandon the blocked thread: join(1) times out, is_alive() is true, and\nthe test goes to the retry list. Bug 2052432 left done for run() to set, which\nthat thread will never reach, so the scheduler waits for the test forever and the\njob dies on mozharness's 1000 second output timeout without logging anything\nmore.\n\nSet it at the end of testTimeout rather than where it used to be, so the TIMEOUT\ntest_end is logged before a retry can interleave its test_start with our output.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318775\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "735d0dd6369cfb90a698df184625ae836309a22a", "git_parents": ["61ea736802d206acf46e03a861b62d00a4151155"], "node": "c0cb55447ced2706a3e12ee7e3381e152524b69a", "parents": ["6a569bc16453d0943b123bb6673d331bb0ee9349"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2063670 - Don't wait for a blocked test thread in the xpcshell sequential and retry phases, r=ahal.\n\nThe scheduler's parallel phase copes with a test whose thread can no longer finish\n(it joins with a timeout and moves on), but the sequential and retry phases join\nwithout one. A test that times out leaving a child process holding its stdout pipe\nopen never returns from communicate(), so those two loops wait for a thread that\nwill never exit and the job dies on mozharness's 1000 second output timeout.\n\nWait for the done flag rather than for the thread in both loops, and give exception\nand traceback a value up front, since a thread abandoned this way never reaches the\ncode in run() that assigns them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318776\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "8aa06bd4a33e771b3411ad335810862703955a99", "git_parents": ["735d0dd6369cfb90a698df184625ae836309a22a"], "node": "8f6a839c83d53f045371f1857210b29461274df1", "parents": ["c0cb55447ced2706a3e12ee7e3381e152524b69a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062572 - Activate the chatbot menu item from an open menu in browser_chat_sidebar.js, r=pdahiya.\n\nWaiting for the popup to be open before interacting with its contents. Its\ncontents are invisible to the accessibility APIs and not focusable before that,\nwhich is the intermittent \"Node is not focusable via the accessibility API\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318036\n", "files": ["browser/components/genai/tests/browser/browser_chat_sidebar.js"], "git_node": "d13b3b92d9ed214aab0e7991470939087f0bdaef", "git_parents": ["8aa06bd4a33e771b3411ad335810862703955a99"], "node": "8a4270ce37caea075b350c6fba937ba9ac0b8cfd", "parents": ["8f6a839c83d53f045371f1857210b29461274df1"], "tags": []}, {"author": "Titouan Thibaud \u003ctthibaud@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063438 - Fix baseline profile simulation job not running on android-fenix and android-frontend try presets r=android-reviewers,nalexander\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318585\n", "files": ["tools/tryselect/try_presets.yml"], "git_node": "642422fe1188b52440e378498165916ecd21f53a", "git_parents": ["d13b3b92d9ed214aab0e7991470939087f0bdaef"], "node": "08ce6f83f15fbb8d7efa697e3b246006f67cc4e3", "parents": ["8a4270ce37caea075b350c6fba937ba9ac0b8cfd"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062779 - Container site association UI r=desktop-theme-reviewers,tgiles,fluent-reviewers,bolsson\" for causing bc failures at nsContentSecurityUtils.cpp\n\nThis reverts commit 6707bff8efb68fb515232b555770d07cdeb3dd02.\n", "files": ["browser/components/contextualidentity/content/container-select.css", "browser/components/contextualidentity/content/container-select.mjs", "browser/components/contextualidentity/jar.mn", "browser/components/preferences/config/containers.mjs", "browser/components/preferences/dialogs/containers.xhtml", "browser/components/preferences/dialogs/jar.mn", "browser/components/preferences/dialogs/siteContainer.js", "browser/components/preferences/dialogs/siteContainer.xhtml", "browser/components/preferences/preferences.js", "browser/components/preferences/preferences.xhtml", "browser/components/preferences/tests/privacy/browser-srd.toml", "browser/components/preferences/tests/privacy/browser.toml", "browser/components/preferences/tests/privacy/browser_container_select.js", "browser/components/preferences/tests/privacy/browser_containers_site_associations.js", "browser/locales/en-US/browser/preferences/containers.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/themes/shared/preferences/preferences.css", "browser/themes/shared/usercontext/container-editor.css"], "git_node": "598cb493acae75e73adca2198513f9bd9ebd92b1", "git_parents": ["642422fe1188b52440e378498165916ecd21f53a"], "node": "1b03e2bd9adc3dbe6b51c8387c2a33e831dcccda", "parents": ["08ce6f83f15fbb8d7efa697e3b246006f67cc4e3"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056551: Adjust smart window switcher outline focus and hover state r=emilio\n\n**Issue/Cause**: Previously, we used outline as part of the window switcher hover state for Nova. However, this caused a very wide circle on keyboard focus.\n**Solution**: For the hover state we need a purple-ish circle around the switcher button, but it already has a border so I opted to use a pseudo element for it. I also added a variable to the toolbar button icon sizing to make it more robust and reuse for this pseudo element.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314084\n", "files": ["browser/themes/shared/browser-shared.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "9a4d9875f991336107018a0d467ba24e44d5dd35", "git_parents": ["598cb493acae75e73adca2198513f9bd9ebd92b1"], "node": "1de654b0fd0bc2c479966b00f758de21942762cd", "parents": ["1b03e2bd9adc3dbe6b51c8387c2a33e831dcccda"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2057382 - Part 1: Check whether scope is malformed r=asuth,ipc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314657\n", "files": ["dom/notification/NotificationHandler.cpp", "ipc/glue/BackgroundParentImpl.cpp", "testing/web-platform/mozilla/tests/notifications/simulate-click-handler.sub.https.window.js"], "git_node": "2c8c4343b49d44c4ab38ef5a2a044df3afc2ba07", "git_parents": ["9a4d9875f991336107018a0d467ba24e44d5dd35"], "node": "e7a22dc262b7a638a2e3a0299c38384e61556981", "parents": ["1de654b0fd0bc2c479966b00f758de21942762cd"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2057382 - Part 2: Adjust scope validation r=asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318753\n", "files": ["dom/notification/NotificationHandler.cpp", "dom/notification/NotificationParent.cpp"], "git_node": "158b465c7335a5b0c18132f85b014322f250a13a", "git_parents": ["2c8c4343b49d44c4ab38ef5a2a044df3afc2ba07"], "node": "ee4b8d32b3a1ab682ee1406a0c34eeafa7aba88d", "parents": ["e7a22dc262b7a638a2e3a0299c38384e61556981"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057646 - Mark user-supplied clock text as dir=auto. r=mconley\n\nCity names, zone abbreviations, nicknames and the time are locale-dependent\nstrings in a UI whose direction follows the browser locale. dir=auto lets the\nBiDi algorithm resolve each from its own text, so an RTL name in an LTR page\nno longer reorders its punctuation and digits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316352\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Clocks/ClocksRow.jsx", "browser/extensions/newtab/content-src/components/Widgets/Clocks/EditClocksPanel.jsx"], "git_node": "71ed217cbf1eac277dded9f500d8e93e56c9e5dd", "git_parents": ["158b465c7335a5b0c18132f85b014322f250a13a"], "node": "834515563202a558b12a55573e07300839ecabcc", "parents": ["ee4b8d32b3a1ab682ee1406a0c34eeafa7aba88d"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057646 - Localize World Clock city names from a curated registry. r=mconley\n\nClocks showed a city derived from the IANA zone id, always English and often\nnot the city the user meant (\"America/Los_Angeles\" for a San Francisco clock).\nA curated registry of 100 cities now holds each city's id, en-US name, zone\nand IATA code, and the display name resolves through Fluent so a saved clock\nfollows the browser locale.\n\nA clock persists a cityId, kept only while it is still in the registry, and\nfalls back to the stored city then the zone-derived name. Nothing creates one\nyet -- the add form does that in the next patch. A Jest test pairs every entry\nagainst its Fluent message so a missing string fails loudly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316353\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Clocks/ClockCityRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Clocks/Clocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Clocks/ClocksHelpers.mjs", "browser/extensions/newtab/content-src/components/Widgets/Clocks/ClocksRow.jsx", "browser/extensions/newtab/content-src/components/Widgets/Clocks/EditClocksPanel.jsx", "browser/extensions/newtab/content-src/components/Widgets/Clocks/useCuratedCityNames.jsx", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/test/jest/content-src/components/Widgets/ClockCityRegistry.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/ClocksHelpers.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/ClocksRow.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/useCuratedCityNames.test.jsx"], "git_node": "9958560b97ec2f36f6048d0abd011d8f58311852", "git_parents": ["71ed217cbf1eac277dded9f500d8e93e56c9e5dd"], "node": "289d4e6041427f0876cc32b8d3a9e0aa3139672b", "parents": ["834515563202a558b12a55573e07300839ecabcc"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057646 - Search cities and time zones in the World Clock add form. r=mconley\n\nThe form searched only the zone list, so \"San Francisco\" was unreachable.\nCurated cities and zones now share one index and one matcher: zones match on\nid, city, localized name, abbreviation or UTC offset, curated cities on names,\naliases or country. Ranking is exact, prefix, substring, then a typo pass,\nwith the tiers named instead of bare numbers. Punctuation folds away,\n\"st\"/\"ft\"/\"mt\" expand, and substring needs three characters.\n\nThe registry and Intl spell six zones differently depending on tzdata\n(Asia/Kolkata vs Asia/Calcutta and similar), so both sides resolve through\nIntl and a zone row is dropped when a matched curated city covers it --\n\"buenos aires\" was returning two identical rows.\n\nThis also drops the inert combobox ARIA: moz-input-search forwards only\naria-label, aria-describedby and aria-description to its shadow input, so\nrole=combobox and its IDREFs never reached assistive technology.\n\nAbbreviation search follows the current season, so \"PST\" finds nothing in\nJuly; indexing both halves is left for a follow-up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316354\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Clocks/AddClockForm.jsx", "browser/extensions/newtab/content-src/components/Widgets/Clocks/ClocksHelpers.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/AddClockForm.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Clocks.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/ClocksHelpers.test.jsx"], "git_node": "b94caf74ad63d40a15a6c7127a5d963ea1b5c13c", "git_parents": ["9958560b97ec2f36f6048d0abd011d8f58311852"], "node": "4a6e997834e912f36dc6a959140d97ddcdfd3aca", "parents": ["289d4e6041427f0876cc32b8d3a9e0aa3139672b"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057646 - Add a custom clock flow for cities that are not curated. r=mconley\n\nA query matching nothing was a dead end. It now becomes an actionable row --\nadd it as a custom clock -- shown below any partial matches and only when\nnothing matches exactly. The typed text becomes the city name and the zone\ncomes from the shared index filtered to zones, defaulting to the local zone.\n\nThis removes the last use of newtab-clock-widget-search-no-results.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316355\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Clocks/AddClockForm.jsx", "browser/extensions/newtab/content-src/components/Widgets/Clocks/_Clocks.scss", "browser/extensions/newtab/test/jest/content-src/components/Widgets/AddClockForm.test.jsx"], "git_node": "9e6d6e3e9777dbe33635712a21a9251042a15800", "git_parents": ["b94caf74ad63d40a15a6c7127a5d963ea1b5c13c"], "node": "5fa481583433b8928fe698307ee5b1974fd63282", "parents": ["4a6e997834e912f36dc6a959140d97ddcdfd3aca"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063533 - Turn on bugprone-bitwise-pointer-cast check r=sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318675\n", "files": ["tools/clang-tidy/config.yaml", "tools/clang-tidy/test/bugprone-bitwise-pointer-cast.cpp", "tools/clang-tidy/test/bugprone-bitwise-pointer-cast.json"], "git_node": "98ee5c9ec55c4e7f52e38f11b970add11865460a", "git_parents": ["9e6d6e3e9777dbe33635712a21a9251042a15800"], "node": "3dc3df2ac466df0d94563a3f608e1fecb93abc2a", "parents": ["5fa481583433b8928fe698307ee5b1974fd63282"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2063238 - doc: dedup contribution docs against docs/contributing r=overholt\n\nsetup/contributing_code.md independently re-explained how to pick a\nreviewer, how to ping a stalled review, how to respond to review\ncomments and how to request commit access. Each of those already has a\ndedicated page under docs/contributing/, and the copies had drifted.\n\nMake docs/contributing/ the source of truth and replace the copies with\ncross-references:\n\n- choosing a reviewer and the r= syntax -\u003e contributing/reviews.md\n- pinging a stalled review -\u003e contributing/reviews.md, Getting attention\n- responding to review comments -\u003e how_to_submit_a_patch.md\n- commit access levels 1 and 3 -\u003e contributing/levelling-up.md\n\nhow_to_submit_a_patch.md pointed at a \"previous 'Getting attention'\nsection\" that no longer exists in that file; it moved to reviews.md.\nSince autosectionlabel_maxdepth is 1, add explicit getting-attention and\naddressing-review-comments targets so the sections can be linked.\n\nThe \"Getting your code reviewed\" heading in contributing_code.md is kept\nbecause mentored-bugs.md deep-links to it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318422\n", "files": ["docs/contributing/how_to_submit_a_patch.md", "docs/contributing/reviews.md", "docs/setup/contributing_code.md"], "git_node": "3db2798b0c9672946b70901687201e572c62aeaa", "git_parents": ["98ee5c9ec55c4e7f52e38f11b970add11865460a"], "node": "d0f62df2a3a6893403a4ca008f8b5982ad973773", "parents": ["3dc3df2ac466df0d94563a3f608e1fecb93abc2a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2063238 - doc: define the cross-reference targets the contribution docs use r=overholt\n\nautosectionlabel_maxdepth is 1, so only page titles get an automatic\nlabel, and the label is the title lowercased with its spaces intact.\nsetup/contributing_code.md referenced hyphenated slugs that therefore\nmatched nothing, and a blanket suppression in docs/config.yml hid the\nresulting warnings.\n\nAdd the missing explicit targets on the pages that own them:\n\n- firefox-contributors-quick-reference: contribution_quickref.md\n- working-on-firefox: contributing/index.md\n- reviewer-checklist: contributing/reviewer_checklist.md\n- pushing-to-try: tools/tryselect/docs/index.md\n\nfirefox-contributors-quick-reference was also broken in\nsetup/{linux,macos,windows}_build.md, which are among the first pages a\nnew contributor reads.\n\npython/mach/docs/index.md needs no target: its title is the single word\n\"Mach\", so autosectionlabel already produces exactly \"mach\".\n\nsetup/contributing_code.md now builds without any undefined label, so\ndrop its suppression. The sibling setup/*_build.md suppressions stay:\nthey still hide unrelated missing labels such as build_hosts and\nunderstanding-artifact-builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318423\n", "files": ["docs/config.yml", "docs/contributing/contribution_quickref.md", "docs/contributing/index.md", "docs/contributing/reviewer_checklist.md", "tools/tryselect/docs/index.md"], "git_node": "e6be2fb60dedf9d2cf83ca7e22fe7f5fffc5d16c", "git_parents": ["3db2798b0c9672946b70901687201e572c62aeaa"], "node": "2c73554681985f317d09fcc7032be99539546887", "parents": ["d0f62df2a3a6893403a4ca008f8b5982ad973773"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2063238 - doc: refresh stale content in contributing_code.md r=firefox-source-docs-reviewers,ahal\n\n- \"the code in Mozilla-Central\" now points at the firefox repository on\n  GitHub, which is where the code actually lives.\n- Replace the mzl.la/2yBg3zB shortener for good first bugs with the\n  Bugzilla query it stands for, so the destination is visible from the\n  source.\n- Drop the \"we're in the process of improving information on this page\n  [...] we'll be integrating some information from these pages soon\"\n  preamble. It wrapped a single SpiderMonkey wiki link and had been\n  saying \"soon\" for years. Keep the link.\n- Fix two grammar slips in the surrounding prose.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318424\n", "files": ["docs/setup/contributing_code.md"], "git_node": "ec336a698012d10955dfa053e61ecf8161d7644f", "git_parents": ["e6be2fb60dedf9d2cf83ca7e22fe7f5fffc5d16c"], "node": "201d9836d25587ef8b51dc9f4cb3bfef46963fcb", "parents": ["2c73554681985f317d09fcc7032be99539546887"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2063238 - doc: clarify that review delays are in business days r=nalexander,overholt\n\n\"Getting attention\" quoted delays as \"a day or two\", \"two or three days\" and\n\"a week\" without saying which days count. Reviewers are spread across many time\nzones and countries, so weekends and public holidays made those numbers\nambiguous, and a patch submitted on a Friday looked overdue by Monday.\n\nSay business days explicitly, and note that a reviewer's non-working days may\nnot be the same as the submitter's.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318427\n", "files": ["docs/contributing/reviews.md"], "git_node": "0c1ffdf0bf47c14bba9174ab2436dc2cbe9ce465", "git_parents": ["ec336a698012d10955dfa053e61ecf8161d7644f"], "node": "e685d4d203ebc5ba8d0079f95bdd22a0c5aee928", "parents": ["201d9836d25587ef8b51dc9f4cb3bfef46963fcb"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2063238 - doc: fix the dead DevTools contribution workflow links r=devtools-reviewers,nchevobbe\n\ndevtools/docs/contributor/contributing.md described getting code into\nthe repository as three links: find-bugs.md, fixing-bugs.md and\nmaking-prs.md, under a ./contributing/ directory that does not exist.\nThey built to href=\"#./contributing/find-bugs.md\", so the whole \"Help\nwith code\" path silently went nowhere. Sphinx does not warn about it\nbecause a \"#\" fragment looks like a local anchor.\n\nPoint the three steps at the general documentation instead, which is\nwhat contributor/index.md already tells readers to do: it says this\nsection \"only contains technical information specific to Firefox\nDevTools\". Note that DevTools patches go to #devtools-reviewers.\n\nbugs-issues.md still split bugs across mozilla-central and the\ndevtools-html GitHub organisation. All DevTools code lives in\nmozilla-central now, so drop the dead organisation search links and\npoint at filing-good-bugs for how to write an actionable report.\n\nFor bugs to work on, point at the DevTools project on Codetribute\nrather than firefox-dev.tools, which no longer lists bugs itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318454\n", "files": ["devtools/docs/contributor/bugs-issues.md", "devtools/docs/contributor/contributing.md"], "git_node": "09ed896db1875bebcd2608776f4aee495ffc1c4c", "git_parents": ["0c1ffdf0bf47c14bba9174ab2436dc2cbe9ce465"], "node": "a4d6d5c5cd94a33dbf1b9624ed6c55838fefe4cf", "parents": ["e685d4d203ebc5ba8d0079f95bdd22a0c5aee928"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061846 - Debounce vpn toggle r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318804\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/ui/Modifier.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt"], "git_node": "c37f623bfb50b87d9343ceb1a72fa69ddf2ff8f9", "git_parents": ["09ed896db1875bebcd2608776f4aee495ffc1c4c"], "node": "f2b1bf47683291cc35dc60848130aa622b5cd7e9", "parents": ["a4d6d5c5cd94a33dbf1b9624ed6c55838fefe4cf"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061828 - Add support for Newtab five column content feed layouts r=ini\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318551\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/Base/_Grid.scss", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/CardSections/_CardSections.scss", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSCard/DSCard.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/_Widgets.scss", "browser/extensions/newtab/content-src/styles/nova/_CardSections.scss", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/DSCard.test.jsx"], "git_node": "6015e4413bf26ff5420faa6ffca3a9dcbb50431c", "git_parents": ["c37f623bfb50b87d9343ceb1a72fa69ddf2ff8f9"], "node": "ff6e95b1347f98f5ea4c767e186cfbd028b1e7b4", "parents": ["f2b1bf47683291cc35dc60848130aa622b5cd7e9"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063456 - Part 1: Make the \"any\" sentinel value work for AboutNewTabResourceMapping again. r=jbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318784\n", "files": ["browser/components/newtab/AboutNewTabResourceMapping.sys.mjs", "browser/components/newtab/test/xpcshell/test_AboutNewTabResourceMapping_entitledVersion.js", "browser/components/newtab/test/xpcshell/xpcshell.toml", "browser/extensions/newtab/docs/v2-system-addon/train_hopping.md"], "git_node": "8d53b503b6b03c0cd9e7322e283cc446e380df9d", "git_parents": ["6015e4413bf26ff5420faa6ffca3a9dcbb50431c"], "node": "3ed685cf0b97984191e85c82e2b85d0539ac5c24", "parents": ["ff6e95b1347f98f5ea4c767e186cfbd028b1e7b4"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063456 - Part 2: Update trainhop test jobs to add the new preference for the co-enrolling mode. r=ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318785\n", "files": ["taskcluster/test_configs/variants.yml"], "git_node": "e29e646b0a376be4b1277e38237fcb0f21374a0f", "git_parents": ["8d53b503b6b03c0cd9e7322e283cc446e380df9d"], "node": "539f313f51af8cba3000f96b6d06f668c800f621", "parents": ["3ed685cf0b97984191e85c82e2b85d0539ac5c24"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063657 - Stop the sports widget from rendering. r=Dre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318803\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamAdmin/DiscoveryStreamAdmin.jsx", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx"], "git_node": "02956042f9b2a81aeb43984970a2f382a20558b2", "git_parents": ["e29e646b0a376be4b1277e38237fcb0f21374a0f"], "node": "3801ec2da01a06494c3638ce77cc9cbccaa48a19", "parents": ["539f313f51af8cba3000f96b6d06f668c800f621"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062351 - Remove outer window gaps of floating chrome for nova r=desktop-theme-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317821\n", "files": ["browser/themes/shared/browser-shared.css", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/content-area.css", "devtools/client/debugger/test/mochitest/browser_dbg-editor-horizontal-scroll.js", "gfx/layers/apz/test/mochitest/helper_zoom_out_clamped_scrollpos.html", "testing/web-platform/meta/css/css-anchor-position/anchor-scroll-position-try-016.html.ini"], "git_node": "a5e0f6d0c6dffdf61ac6cfc36bec69d8b5a1a70d", "git_parents": ["02956042f9b2a81aeb43984970a2f382a20558b2"], "node": "d8b1075dbe5acfc4688a009b170267b46ab59531", "parents": ["3801ec2da01a06494c3638ce77cc9cbccaa48a19"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2063673 - Allowing getting language from children of non-hypertexts. r=morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318774\n", "files": ["accessible/ipc/RemoteAccessible.cpp", "accessible/tests/browser/e10s/browser_language.js", "accessible/tests/browser/e10s/doc_language.html"], "git_node": "224b6fa990eddf89537dcaa53983910ebdd2d160", "git_parents": ["a5e0f6d0c6dffdf61ac6cfc36bec69d8b5a1a70d"], "node": "f30644081f6218f7e015ffbdf02a183c03112654", "parents": ["d8b1075dbe5acfc4688a009b170267b46ab59531"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1813609 - Introduce locale spans in Android a11y strings. r=Jamie,geckoview-reviewers,m_kato\n\nThis allows TalkBack or other ATs to use the correct language voice for\na span of text that is not in the default locale.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318280\n", "files": ["accessible/android/SessionAccessibility.cpp", "accessible/ipc/RemoteAccessible.cpp", "accessible/ipc/RemoteAccessible.h", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-tree.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "90a4917fb3999850608f8592c1b2bf1f6df69176", "git_parents": ["224b6fa990eddf89537dcaa53983910ebdd2d160"], "node": "ba6edfc5cc6af41d777f313a7941d9752071488c", "parents": ["f30644081f6218f7e015ffbdf02a183c03112654"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1997506 - Apply resolution correctly to event scroll point. r=morgan\n\nWe implicitly cast the resolution from a float to an int and end up\nscaling by 0 on resultion factors that are les than 1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318589\n", "files": ["accessible/generic/DocAccessible.cpp", "accessible/tests/browser/events/browser_test_scrolling.js"], "git_node": "fcc91e615297110ea80aae7904ac00580cb50188", "git_parents": ["90a4917fb3999850608f8592c1b2bf1f6df69176"], "node": "4b6ffb0fb1c781d1953a83dda572795896a50d0f", "parents": ["ba6edfc5cc6af41d777f313a7941d9752071488c"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1901172 - Move by cluster and not byte characters in Android. r=Jamie,geckoview-reviewers,m_kato\n\nFrom current testing Chrome moves by byte characters and not clusters\nyet. Logically, we should also update character offsets that are\nreported back, but that would require changes to TextLeafRange taht I am\nnot sure we want.\n\nEither way TalkBack seems happy with this since the returned traversal\nrange allows it to process cluster boundaries correctly and does not\nexpect of delta of 1 between each character.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318278\n", "files": ["accessible/android/AccessibleWrap.cpp", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt"], "git_node": "7a75cd40ddb718d3de004446b9b4bde390d0598c", "git_parents": ["fcc91e615297110ea80aae7904ac00580cb50188"], "node": "5ec0610f195bcb6825248c25fabce81e0fb415a6", "parents": ["4b6ffb0fb1c781d1953a83dda572795896a50d0f"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2060489 - The Monitor Agent Create a task panel resets all fields when switching tabs r=yjamora\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318757\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "browser/components/aiwindow/ui/modules/ChatMessage.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_chat.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/xpcshell/test_ChatMessage.js"], "git_node": "3461857bb012e9f4cb2f9e306df32184a3238435", "git_parents": ["7a75cd40ddb718d3de004446b9b4bde390d0598c"], "node": "73581516287950b3e671277344c45e3f8e3958dc", "parents": ["5ec0610f195bcb6825248c25fabce81e0fb415a6"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2054640 - Reset CORS mode when aborting media loads r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313931\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp"], "git_node": "00fef1cb6705b521d5e2e14455bf3a037ddb5709", "git_parents": ["3461857bb012e9f4cb2f9e306df32184a3238435"], "node": "01d18a869c54413f7ef650ca37b92e72f29ab497", "parents": ["73581516287950b3e671277344c45e3f8e3958dc"], "tags": []}, {"author": "Chun-Min Chang 