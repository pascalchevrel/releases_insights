/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/HomeActivityTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/HomeDeepLinkIntentProcessorTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationHelperTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationReceiverTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorkerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportWorkerFactoryTest.kt"], "git_node": "d39603dcbe08704fe95f3c61afa2745b6c7f49ca", "git_parents": ["e8a4922ff2a88ad13b8dbd6b382ca7039fe200af"], "node": "3738fc7bc966eccc9231f35a027555c7546372a9", "parents": ["45b6485684480a396f48df291d0fe77c090b9c05"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065855 - Check for plaintext editor before design mode in HTMLEditor::IsStyleEditable. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320946\n", "files": ["editor/libeditor/HTMLEditor.cpp", "editor/libeditor/tests/mochitest.toml", "editor/libeditor/tests/test_plaintext_mail_in_design_mode.html"], "git_node": "f13aa80ee21250b932da97b97f96cd75406d5457", "git_parents": ["d39603dcbe08704fe95f3c61afa2745b6c7f49ca"], "node": "6ae2158d029276517d41b4470b13890b08222e81", "parents": ["3738fc7bc966eccc9231f35a027555c7546372a9"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065763 - Only include RemoteControlPanel.sys.mjs for NIGHTLY_BUILD r=firefox-desktop-core-reviewers ,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320856\n", "files": ["browser/components/remotecontrol/moz.build"], "git_node": "fbe6bb72f9ea66f5788acd3f6c0df1321e007221", "git_parents": ["f13aa80ee21250b932da97b97f96cd75406d5457"], "node": "4520d421c2402238087a62ae3886545d1fa4f097", "parents": ["6ae2158d029276517d41b4470b13890b08222e81"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "no bug - doc: recommend self-review before submitting a patch r=overholt DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318794\n", "files": ["docs/contributing/how_to_submit_a_patch.md"], "git_node": "6e5617ad64e9e8ef56ba450e464db11f6be441af", "git_parents": ["fbe6bb72f9ea66f5788acd3f6c0df1321e007221"], "node": "542a5b3c523cbd46bd915dba665fecbaa3d3aa9b", "parents": ["4520d421c2402238087a62ae3886545d1fa4f097"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050017 - Point the aiwindow browser tests at a local search engine r=Mardak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320303\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aichat_content_message_event.js", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "8fc23fc09af1a4b22f561fc589299a8e5b7d74cf", "git_parents": ["6e5617ad64e9e8ef56ba450e464db11f6be441af"], "node": "de75eca63e2e759607c4a57d0b966823f16de90e", "parents": ["542a5b3c523cbd46bd915dba665fecbaa3d3aa9b"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066172 - Test WebTaskSchedulingState inheritance more thoroughly r=smaug\n\nThese tests highlight the failed state of an optimization added in Bug 1960043\nand broken in Bug 1997192.\n\nThe important pieces of these test cases are\n\n1. Covering the jobs enqueued on an already settled promise\n2. Including reactions on promises greater than depth 1 (so a then on a promise then)\n\nThese alone will fail, however the tests are corrected by the child patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321137\n", "files": ["testing/web-platform/tests/scheduler/tentative/yield/yield-inherit-abort-across-settled-promises.any.js", "testing/web-platform/tests/scheduler/tentative/yield/yield-inherit-across-settled-promises.any.js"], "git_node": "ffab55ad6d7325acada2312324277f8104d82779", "git_parents": ["8fc23fc09af1a4b22f561fc589299a8e5b7d74cf"], "node": "12d6fcbacb2f82c75473178685ea5fe314398f82", "parents": ["de75eca63e2e759607c4a57d0b966823f16de90e"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066172 - Abandon incorrect 'optimized out' optimization for host defined data in JS engine r=arai\n\nThe optimization is incorrect for promise jobs enqueued after a promise has\nsettled, and recent architectural changes [1] mean its complexity no longer carries\nits weight. Always request both the incumbent global and optional host-defined\ndata.\n\n[1]: Bug 1983159 split the incumbent global and optional host-defined data into\nseparate slots, and Bug 2063731 additionally made the embedding lookup cheap\nwhen no WebTaskSchedulingState exists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321138\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "3452cb7a239527ff0fbc3da72b820d6126afb7f3", "git_parents": ["ffab55ad6d7325acada2312324277f8104d82779"], "node": "848d24bf1005f08e170a55de7b3ca64c2ed2de65", "parents": ["12d6fcbacb2f82c75473178685ea5fe314398f82"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2066172: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "4d88cf88f0eb315e49fea86c2c8c45696add1fe7", "git_parents": ["3452cb7a239527ff0fbc3da72b820d6126afb7f3"], "node": "a5e7f5242459b49ff88352ff1acbb5ef058076b5", "parents": ["848d24bf1005f08e170a55de7b3ca64c2ed2de65"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061785 - Allow regular heuristics to run on CVC fields. r=dimi,fluent-reviewers,flod\n\ncc-csc is already detected by the credit card heuristics so that credit card\nsections parse correctly, but it was special-cased out of the autofill\npipeline: shouldAutofillField() returned false for it, which both blocked\nfilling and kept the field out of the autocomplete popup, since\nsearchAutoCompleteEntries() calls the same gate.\n\nPut that early-return behind extensions.formautofill.creditCards.cvv.enabled\n(default false) so cc-csc can participate like any other credit card field,\nand mask the security code everywhere it would otherwise become visible:\n\n- The autocomplete entry is named after the field (\"CVC\") and identified by\n  the card's masked number. _getSecondaryLabel() returns the number\n  unconditionally for cc-csc rather than requiring a matching field in the\n  form, because a form asking for the security code on its own has no other\n  card field to build a secondary label from and the number is the only thing\n  that keeps the entries distinguishable.\n- preparePreviewProfile() replaces the value with mask characters, mirroring\n  the existing cc-number preview masking. The real value is still filled on\n  selection.\n\nWith the pref off nothing changes: shouldAutofillField() still returns false\nfor cc-csc, so searchAutoCompleteEntries() never returns entries for a focused\nsecurity code field and the labelling above is unreachable. That gate is the\nonly place the pref is consulted.\n\nStoring the security code is out of scope here: cc-csc is still absent from\nVALID_CREDIT_CARD_FIELDS and is still skipped when building a record to save,\nso this only takes effect for a record that already carries one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314157\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvv.js", "browser/extensions/formautofill/test/unit/test_profileAutocompleteResult.js", "modules/libpref/init/all.js", "toolkit/components/formautofill/FormAutofill.sys.mjs", "toolkit/components/formautofill/ProfileAutoCompleteResult.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillSection.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "8f1f08a923984b7fcf9a75152a42678c664489f8", "git_parents": ["4d88cf88f0eb315e49fea86c2c8c45696add1fe7"], "node": "049b5148756766ec60cbe7f1287fb42bbde3e88a", "parents": ["a5e7f5242459b49ff88352ff1acbb5ef058076b5"], "tags": []}, {"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065548 - Re-enable browser_partitionedMessaging.js r=emz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320460\n", "files": ["toolkit/components/antitracking/test/browser/browser.toml"], "git_node": "b4d8347c340e97dcb4b87a82f7676775ba592cbc", "git_parents": ["8f1f08a923984b7fcf9a75152a42678c664489f8"], "node": "d83f12a9acd123817c481214296eae7514ec49a3", "parents": ["049b5148756766ec60cbe7f1287fb42bbde3e88a"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2055174 - Do not set SO_REUSEADDR on Windows server sockets. r=necko-reviewers,Sasha,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321177\n", "files": ["netwerk/base/nsServerSocket.cpp", "netwerk/test/httpserver/test/test_start_stop.js", "netwerk/test/httpserver/test/test_start_stop_ipv6.js", "netwerk/test/unit/test_addr_in_use_error.js", "testing/marionette/harness/marionette_harness/tests/unit/test_marionette.py"], "git_node": "79a6c4aa9f750a7ad3d0684b408cf1af4947ddc2", "git_parents": ["b4d8347c340e97dcb4b87a82f7676775ba592cbc"], "node": "5ad765fc57e617d31669cbe02974e1749aa8e9e4", "parents": ["d83f12a9acd123817c481214296eae7514ec49a3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2066283 - Fix handling of passed_rightmost_selector. r=firefox-style-system-reviewers,dshin\n\nThis was uncovered by the discussion in D317358.\n\nThe fact that we reset this flag for nested lists to false is wrong.\n\nE.g. we end up treating for `:is(#foo) span` differently to `#foo span`:\nthe first one would end up with \"foo\" in mapped_ids, while the second\nwouldn't (and would end up being a revalidation selector instead).\n\nI think the `:is(#foo)` behavior ends up being better (it avoids sharing\nbetween two elements with the same id if that id is referenced from\nselectors, but in exchange it does a lot less revalidation of children).\n\nThis matches how we treat classes, for that matter.\n\nWe could remove the flag in this patch, but since we want to use it in\nD321095, I'm keeping it. Luckily it seems rustc isn't smart enough\nto -Werror about it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321094\n", "files": ["servo/components/style/stylist.rs"], "git_node": "5666c1393719a83f61df2a813db8540c6e4073be", "git_parents": ["79a6c4aa9f750a7ad3d0684b408cf1af4947ddc2"], "node": "d4a7fac5885645a98265ec76499fe343333c1b40", "parents": ["5ad765fc57e617d31669cbe02974e1749aa8e9e4"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050132 - Replace the segmented buttons in the print dialog with moz-segmented-control r=fluent-reviewers,desktop-theme-reviewers,flod,mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316851\n", "files": ["python/l10n/fluent_migrations/bug_2050132_print_orientation_control.py", "stylelint-rollouts.config.js", "toolkit/components/printing/content/print.css", "toolkit/components/printing/content/print.html", "toolkit/components/printing/content/print.js", "toolkit/components/printing/content/toggle-group.css", "toolkit/components/printing/jar.mn", "toolkit/components/printing/tests/browser_ui_labels.js", "toolkit/locales/en-US/toolkit/printing/printUI.ftl"], "git_node": "7ffa79ce8017972c0f4967863c46db9e4e996d45", "git_parents": ["5666c1393719a83f61df2a813db8540c6e4073be"], "node": "5ec688008949feaac34359fc3f2bb954640378c6", "parents": ["d4a7fac5885645a98265ec76499fe343333c1b40"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049732 - Implement label truncation with ellipsis in moz-segmented-control r=extension-reviewers,desktop-theme-reviewers,mstriemer,rpl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318135\n", "files": ["toolkit/content/tests/widgets/test_segmented_control.html", "toolkit/content/widgets/moz-button/moz-button.css", "toolkit/content/widgets/moz-segmented-control/moz-segmented-control.css", "toolkit/content/widgets/moz-segmented-control/moz-segmented-control.stories.mjs", "toolkit/mozapps/extensions/content/aboutaddons.css"], "git_node": "438243dc75e52bc28bdfa9f651d25a31eba25a50", "git_parents": ["7ffa79ce8017972c0f4967863c46db9e4e996d45"], "node": "badfb866e90414bad36133808ddee0012c6a66a0", "parents": ["5ec688008949feaac34359fc3f2bb954640378c6"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2022289 - Don't wrongly treat a percentage flex gap as definite. r=layout-reviewers,dshin\n\nIn the final reflow, the content box size is definite, but we shouldn't\nstart resolving the percentage gap to a non-zero value, because it would\ncause us to grow.\n\nThis matches Chromium and WebKit, and our behavior if we hit the \"final\nreflow optimization\", which would skip the final reflow and thus not\nre-resolve the gap.\n\nhttps://drafts.csswg.org/css-gaps-1/#gap-percent\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321113\n", "files": ["layout/generic/ReflowInput.h", "layout/generic/nsFlexContainerFrame.cpp", "testing/web-platform/tests/css/css-flexbox/gap-percentage-wrap.html"], "git_node": "b548ced3cb9c39d952512f8bead051dbe9dc7ee0", "git_parents": ["438243dc75e52bc28bdfa9f651d25a31eba25a50"], "node": "8bfe3a304f6a3f2c0e5ac3338a18ccc9a0da81d9", "parents": ["badfb866e90414bad36133808ddee0012c6a66a0"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065080 - Let AsyncShutdown's crash countdown run on wall clock and give it a wider margin over nsTerminator. r=xpcom-reviewers,nika\n\nnsTerminator is meant to be the backstop behind AsyncShutdown, but in practice\nit wins the race for the great majority of shutdown hangs, and we then lose the\nAsyncShutdownTimeout annotation that names the blockers we were waiting for.\n\nThe countdown leading to the AsyncShutdown crash resolved after a fixed number\nof delivered timer beats. Its timer is TYPE_REPEATING_PRECISE_CAN_SKIP, which\ndrops undelivered ticks instead of queuing them, so main thread jank, which is\na given during a shutdown hang, stretched the countdown well past the intended\n60 seconds of wall clock. Poll a monotonic deadline instead. A suspended\ncomputer does not advance that clock, so we keep tolerating suspend, but a busy\nmain thread no longer buys extra time. This cannot make us crash where we did\nnot before: the terminator already enforces the same deadline from its own\nthread.\n\nAsyncShutdown also arms its countdown later than the terminator arms its own.\nThe terminator's clock for a phase starts in AdvanceShutdownPhaseInternal,\nbefore KillClearOnShutdown and before any observer of the phase runs, and the\nAsyncShutdown spinner is one of those observers. Widen the terminator's\nadditional wait from 3 to 10 seconds, so that gap, the resolution of the\ncountdown and the time it takes to annotate the crash report all fit into the\nmargin.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320113\n", "files": ["toolkit/components/asyncshutdown/AsyncShutdown.sys.mjs", "toolkit/components/terminator/nsTerminator.cpp", "toolkit/crashreporter/test/unit/test_crash_AsyncShutdown.js"], "git_node": "b45d06edd186bbea3dc39518e1b26ef6d7d04c52", "git_parents": ["b548ced3cb9c39d952512f8bead051dbe9dc7ee0"], "node": "7fea2eedefa35ceb2b159655bd737ba9e161da53", "parents": ["8bfe3a304f6a3f2c0e5ac3338a18ccc9a0da81d9"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064452 - Hide retry on the initial PUWYLO assistant response r=pdahiya\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319936\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/chat-assistant-footer/assistant-message-footer.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_assistant_message_footer.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_chat_tool_ui.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js"], "git_node": "ccb9da77d015c33efec427987d40d51461e9933d", "git_parents": ["b45d06edd186bbea3dc39518e1b26ef6d7d04c52"], "node": "71cbde39f2f9f4cd4596696ea3518d1cba3a5372", "parents": ["7fea2eedefa35ceb2b159655bd737ba9e161da53"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065170 - Scope New Tab's panel-item padding to its own menus. r=ini,daleharvey,desktop-theme-reviewers,urlbar-reviewers,kcochrane\n\nThe class is opt-in, so a menu that shows icons keeps panel-item's own padding; the per-widget rules and the switcher override that restored it are no longer needed.\n\nSubmenus stay classless: panel-item moves a submenu's panel-list into its own shadow root, out of reach of a `::part()` selector in the document.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320250\n", "files": ["browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/AdBannerContextMenu/AdBannerContextMenu.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSLinkMenu/DSLinkMenu.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/SectionContextMenu/SectionContextMenu.jsx", "browser/extensions/newtab/content-src/components/TopSites/TopSite.jsx", "browser/extensions/newtab/content-src/components/Weather/Weather.jsx", "browser/extensions/newtab/content-src/components/Widgets/Clocks/Clocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Crossword/Crossword.jsx", "browser/extensions/newtab/content-src/components/Widgets/FocusTimer/FocusTimer.jsx", "browser/extensions/newtab/content-src/components/Widgets/Lists/Lists.jsx", "browser/extensions/newtab/content-src/components/Widgets/Lists/_Lists.scss", "browser/extensions/newtab/content-src/components/Widgets/PictureOfTheDay/PictureOfTheDay.jsx", "browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/content-src/components/Widgets/RecentSearches/RecentSearches.jsx", "browser/extensions/newtab/content-src/components/Widgets/SportsWidget/SportsWidget.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/_Stocks.scss", "browser/extensions/newtab/content-src/components/Widgets/Weather/Weather.jsx", "browser/extensions/newtab/content-src/components/Widgets/WeatherForecast/WeatherForecast.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/themes/shared/urlbar.css"], "git_node": "c0eadb5aab8982a52e1171c81c0ba7b7ce17355d", "git_parents": ["ccb9da77d015c33efec427987d40d51461e9933d"], "node": "5b026049a5b87df4f7d0288805fa5da9d2a7a3a2", "parents": ["71cbde39f2f9f4cd4596696ea3518d1cba3a5372"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2062324 - Skip the selector-matching non-link elements inside links whenever possible. r=firefox-style-system-reviewers,dshin\n\nOriginally in D317358, but this is the cleaned up version (I updated\nthat one instead, but then re-requesting review is a pain).\n\nThis patch tracks at the cascade-data level whether there are any\n:visited / :link selectors in non-subject position (which is rare), and\navoids the re-selector-matching on inside-link elements if so.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321095\n", "files": ["servo/components/style/style_resolver.rs", "servo/components/style/stylist.rs"], "git_node": "fa1266d46b9cb17d9018e1e424d3c645bcf61066", "git_parents": ["c0eadb5aab8982a52e1171c81c0ba7b7ce17355d"], "node": "063cf9ee8f04faee287fe16eca8c825ea79e93e1", "parents": ["5b026049a5b87df4f7d0288805fa5da9d2a7a3a2"], "tags": []}, {"author": "Rana Al-Khulaidi \u003cralkhulaidi@gmail.com\u003e", "branch": "default", "desc": "Bug 2060902 - Remove all non-legacyHeartbeat Normandy actions. r=nimbus-reviewers,beth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319219\n", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_disable_shield.js", "toolkit/components/normandy/Normandy.sys.mjs", "toolkit/components/normandy/NormandyMigrations.sys.mjs", "toolkit/components/normandy/actions/AddonRollbackAction.sys.mjs", "toolkit/components/normandy/actions/AddonRolloutAction.sys.mjs", "toolkit/components/normandy/actions/BaseStudyAction.sys.mjs", "toolkit/components/normandy/actions/BranchedAddonStudyAction.sys.mjs", "toolkit/components/normandy/actions/ConsoleLogAction.sys.mjs", "toolkit/components/normandy/actions/PreferenceExperimentAction.sys.mjs", "toolkit/components/normandy/actions/PreferenceRollbackAction.sys.mjs", "toolkit/components/normandy/actions/PreferenceRolloutAction.sys.mjs", "toolkit/components/normandy/actions/schemas/index.sys.mjs", "toolkit/components/normandy/content/AboutPages.sys.mjs", "toolkit/components/normandy/content/ShieldFrameChild.sys.mjs", "toolkit/components/normandy/content/ShieldFrameParent.sys.mjs", "toolkit/components/normandy/content/about-studies/about-studies.js", "toolkit/components/normandy/lib/ActionsManager.sys.mjs", "toolkit/components/normandy/lib/AddonStudies.sys.mjs", "toolkit/components/normandy/lib/NormandyAddonManager.sys.mjs", "toolkit/components/normandy/lib/ShieldPreferences.sys.mjs", "toolkit/components/normandy/test/browser/browser.toml", "toolkit/components/normandy/test/browser/browser_AddonStudies.js", "toolkit/components/normandy/test/browser/browser_NormandyAddonManager.js", "toolkit/components/normandy/test/browser/browser_ShieldPreferences.js", "toolkit/components/normandy/test/browser/browser_about_studies.js", "toolkit/components/normandy/test/browser/browser_actions_AddonRollbackAction.js", "toolkit/components/normandy/test/browser/browser_actions_AddonRolloutAction.js", "toolkit/components/normandy/test/browser/browser_actions_BranchedAddonStudyAction.js", "toolkit/components/normandy/test/browser/browser_actions_ConsoleLogAction.js", "toolkit/components/normandy/test/browser/browser_actions_PreferenceExperimentAction.js", "toolkit/components/normandy/test/browser/browser_actions_PreferenceRollbackAction.js", "toolkit/components/normandy/test/browser/browser_actions_PreferenceRolloutAction.js", "toolkit/components/normandy/test/unit/test_addon_unenroll.js", "toolkit/components/normandy/test/unit/xpcshell.toml"], "git_node": "608db5c24f0c4199ebe041c58fe16f0ef3a144fe", "git_parents": ["fa1266d46b9cb17d9018e1e424d3c645bcf61066"], "node": "ea043f78bf63de0506e7f7ad4c5e7909ed290229", "parents": ["063cf9ee8f04faee287fe16eca8c825ea79e93e1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065754 - Reduce the size of cssparser errors. r=firefox-style-system-reviewers,dshin,devtools-reviewers,supply-chain-reviewers\n\nHuge, but mostly mechanical change. Also brings in a phf\nupdate unfortunately, albeit a fairly low risk one.\n\nThis patch makes us stop carrying tokens and source locations the error\npath, which adds a lot of bloat to the generated code unnecessarily, for\na feature that is almost always off by default. The worst offender is\nthe Tokenizer::next() error, which starts getting passed by registers\nafter this change.\n\nInstead of carrying the location in the error, rule and declaration\nparsers hand out the source location of the start of the offending\ndeclaration, and that's what ParseErrorReporter gets.\n\nThis means the reported line / column numbers now change, which needs\ntests changes. The unprintables test also gets fixed and cleaned up now\nthat we don't have a ton of different codepaths to escape.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320989\n", "files": [".cargo/config.toml.in", "Cargo.lock", "Cargo.toml", "browser/base/content/test/static/browser_parsable_css.js", "build/workspace-hack/Cargo.toml", "devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_debug_console.js", "devtools/client/webconsole/test/browser/browser_console.js", "devtools/client/webconsole/test/browser/browser_webconsole_css_error_impacted_elements.js", "devtools/client/webconsole/test/browser/browser_webconsole_filters_persist.js", "devtools/client/webconsole/test/browser/browser_webconsole_location_styleeditor_link.js", "devtools/client/webconsole/test/node/components/css-warning.test.js", "devtools/client/webconsole/test/node/fixtures/stubs/cssMessage.js", "devtools/client/webconsole/test/node/store/messages.test.js", "devtools/client/webconsole/test/node/store/private-messages.test.js", "devtools/shared/commands/resource/tests/browser_resources_css_messages.js", "dom/locales/en-US/