dea90b283e727853c3c1bb2632179c56f59a01\npa-IN -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\npl -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\npt-BR -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\npt-PT -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nrm -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nro -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nru -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nsk -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nsl -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nson -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nsq -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nsr -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nsv-SE -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nta -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nte -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nth -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\ntl -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\ntr -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\ntrs -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nuk -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nur -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nuz -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nvi -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nwo -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nxh -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nzam -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nzh-CN -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\nzh-TW -\u003e 8ddea90b283e727853c3c1bb2632179c56f59a01\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "14c4be290f81c72e014aeb83c1b28ef4d598874f", "git_parents": ["3a45441febf9d264bd0b1a4a243a362d81a2a1e9"], "node": "214d02feec4df655534b7050e4b0e80dce9a0929", "parents": ["ae11db63d585a1c9cca598d7663a6223a2bd1e36"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062496 - Exempt the stale drag test's mouse release from a11y checks. r=tabbrowser-reviewers,jsudiaman\n\nThe press has to happen while moving-tab mode leaves #nav-bar inert, so it lands\non the toolbox, while the release that balances it lands on the urlbar input,\nrecovery having ended moving-tab mode by then. The click goes to the two\ntargets' common ancestor, which is the toolbox, and a11y-checks flags it for\nhaving no interactive accessible.\n\nVerified with --enable-a11y-checks, where the file fails the way it does in CI\nwithout this and passes with it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318407\n", "files": ["browser/components/tabbrowser/test/browser/dragdrop/browser_stale_drag_session.js"], "git_node": "600f3242f43eebdb205b92ce6d8e1fa8043feae4", "git_parents": ["14c4be290f81c72e014aeb83c1b28ef4d598874f"], "node": "c3db115f9cd9c3d9442a9636779655932be0f63b", "parents": ["214d02feec4df655534b7050e4b0e80dce9a0929"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061885 - Expand a dragged tab group from the group's own state. r=sthompson,tabbrowser-reviewers\n\nRe-expanding a group the drag collapsed hung off one call site, inside the\nmoveTabs closure, so a drop branch that moved nothing never expanded it. That is\nwhat bug 1969163 was, back when moveTabs was skipped for a drop with no\ndropElement. The dragend call that looks like a backstop wasn't one, because it\nkeyed off _dragData, which handle_drop deletes before dragend runs.\n\nThe group now records that a drag collapsed it, which is what the drop side\nactually wants to know, and the expand is hoisted out of moveTabs so every\nbranch reaches it. Since bug 1961577 the same _dragData field also gated the\nrelease of the reserved tab strip space, so that guard moves to the new state\ntoo.\n\nWorth checking that the flag outlives the expand: it is cleared when the tabs\nhave animated back to full size, not when the expand starts, so\n_resetTabsAfterDrop can't release the reservation from under the animation. That\nalso makes a second _expandGroupOnDrop call a no-op instead of a premature\nrelease, which matters because bug 2061864 adds a third caller in its stale\ndrag recovery.\n\nThe new test covers the bug 1969163 scenario, which had none. It passes before\nthis change too -- moveTabs is unconditional today, so there is no live symptom.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317205\n", "files": ["browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/content/tabgroup.js", "browser/components/tabbrowser/test/browser/dragdrop/browser.toml", "browser/components/tabbrowser/test/browser/dragdrop/browser_drag_tab_group_expand_on_drop.js"], "git_node": "68a651b6192a32b9bf90c396b5c442a775013f77", "git_parents": ["600f3242f43eebdb205b92ce6d8e1fa8043feae4"], "node": "960e685be60369fde829293b6ecadb29e9ef9932", "parents": ["c3db115f9cd9c3d9442a9636779655932be0f63b"], "tags": []}, {"author": "Robert Mader \u003crobert.mader@posteo.de\u003e", "branch": "default", "desc": "Bug 2056131 - Always prefer GLES over GL on Linux r=gfx-reviewers,ahale\n\nWhile both are in maintenance mode, GLES \u003e= 3.1 is the recommended API\n(by leading Mesa devs) for some time now. Performance gaps from the time\nof GLES 2.0 have been solved and a number features - such as native YUV\nsupport in drivers - were never ported to big GL.\n\nMaking GLES the default should thus be a win on pretty much all existing\nhardware. The remaining devices where that's not the case - from the\nGL(ES) 2.x era - already don't get HW accelerated rendering anyway.\n\nNote that for the same reasons a number of big projects have been making\nthe same step lately, including GTK4 and Gstreamer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219394\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "cc8d856a0b5d433d01c6fd54f9664eff8e7ec4f8", "git_parents": ["68a651b6192a32b9bf90c396b5c442a775013f77"], "node": "1c1423a02d8b6cc751fe04c6e2b1f60c70fe46ab", "parents": ["960e685be60369fde829293b6ecadb29e9ef9932"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2060788 - Test that Happy Eyeballs revalidates a stale DNS answer r=necko-reviewers,kershaw\n\nSeed a short-TTL A record by driving one connection through Happy\nEyeballs, let it age into the grace period, then answer the name with a\nworking address. The stale address is raced first and its connection is\nrefused; Happy Eyeballs revalidates with a cache-bypassing lookup, races\nthe address that comes back, and the request succeeds on it.\n\nServing a stale entry also makes the resolver renew it in the\nbackground, and that renewal alone is enough to reach the working\naddress: it updates the shared host record, so a lookup landing after it\nsees the new address, and the test would pass with or without the\nrevalidation. DNS therefore goes through the TRR server, whose answers\ncan be delayed: the revalidated answer is held back until Happy Eyeballs\nhas consumed the stale one and failed to connect to it. TRR_ONLY mode\nkeeps native resolution, which answers 127.0.0.1 for everything in TRR\ntests, out of the picture as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317011\n", "files": ["netwerk/test/unit/test_happy_eyeballs_optimistic_dns.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "ebf212a7c9e95210218881dd97aff9e093dabdfb", "git_parents": ["cc8d856a0b5d433d01c6fd54f9664eff8e7ec4f8"], "node": "7498ebcdb1d581111adb9751f516d23a49651161", "parents": ["1c1423a02d8b6cc751fe04c6e2b1f60c70fe46ab"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2060788 - Revalidate stale DNS answers in Happy Eyeballs r=necko-reviewers,kershaw\n\nFirefox already serves DNS answers from a cache entry's grace period\n(stale-while-revalidate). This teaches Happy Eyeballs to notice when an\nanswer was served stale and race it immediately while revalidating with\na fresh, cache-bypassing lookup, then race the revalidated answer too.\n\n- Expose nsIDNSAddrRecord::fromStaleCache and\n  nsIDNSByTypeRecord::fromStaleCache. The flag is captured at serve time:\n  the resolver sets it true only when it hands back a grace-period cache\n  hit, and false on every fresh resolution. Deriving it after the fact\n  from CheckExpiration == EXP_GRACE would misreport a freshly resolved\n  answer as stale whenever its TTL is short enough to land in the grace\n  window immediately (SetExpiration puts mGraceStart at now + ttl, so a\n  TTL of 0 is born in grace). The flag lives on the shared nsHostRecord\n  base, so AddrHostRecord and TypeHostRecord share it.\n- Plumb happy-eyeballs v0.11.0's stale/allow_stale API through the FFI\n  glue and the C++ driver. Output::SendDnsQuery carries allow_stale;\n  when the state machine revalidates a stale answer (allow_stale=false)\n  the driver adds RESOLVE_BYPASS_CACHE to force a fresh lookup. The stale\n  entry is left in place so concurrent consumers can keep using it while\n  the revalidation is in flight.\n- happy_eyeballs_process_dns_response_{a,aaaa,https} carry the stale flag\n  into Input::DnsResult, so both address and HTTPS/SVCB answers report\n  fromStaleCache and are revalidated when served stale. A cache-bypassing\n  revalidation never takes the cache-hit path, so its answer is always\n  reported fresh, upholding the state machine's invariant that a refresh\n  query is never answered from a stale entry.\n\nThe DNSRecord and IPCTypeRecord IPC structs carry the flag too, sampled\nwhen the lookup completes: the receiving side holds no expiration times of\nits own, so it cannot recompute grace status.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317012\n", "files": ["netwerk/dns/DNSByTypeRecord.h", "netwerk/dns/DNSRequestChild.cpp", "netwerk/dns/DNSRequestParent.cpp", "netwerk/dns/PDNSRequestParams.ipdlh", "netwerk/dns/nsDNSService2.cpp", "netwerk/dns/nsHostRecord.cpp", "netwerk/dns/nsHostRecord.h", "netwerk/dns/nsIDNSByTypeRecord.idl", "netwerk/dns/nsIDNSRecord.idl", "netwerk/protocol/http/ConnectionEstablisher.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.h", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs"], "git_node": "7da51d498b3ff1fb7533f59eae9134bdeb3be833", "git_parents": ["ebf212a7c9e95210218881dd97aff9e093dabdfb"], "node": "ab3116bc2472e70df1d9b53280de25bf16c93775", "parents": ["7498ebcdb1d581111adb9751f516d23a49651161"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2060788 - Surface stale and revalidation state in Happy Eyeballs profiler markers r=necko-reviewers,jesup\n\nThe Happy Eyeballs DNS profiler markers now record two facts introduced\nby Optimistic DNS: whether a query was a cache-bypassing revalidation of\na stale answer (allow_stale=false), and whether the answer it received\nwas served from a stale (past-TTL, grace-period) cache entry. This makes\nthe revalidation flow visible when profiling a connection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317089\n", "files": ["netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/protocol/http/happy_eyeballs_glue/src/profiler.rs"], "git_node": "c04c1c0003f5a5a6f522570f10afd92c92f20c45", "git_parents": ["7da51d498b3ff1fb7533f59eae9134bdeb3be833"], "node": "64700777366a8fdb6329858f813c7895ec5ea175", "parents": ["ab3116bc2472e70df1d9b53280de25bf16c93775"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059144 - Part 1: Validate principal and scope for push r=asuth,tschuster,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315347\n", "files": ["dom/base/MessageManagerCallback.h", "dom/base/ProcessMessageManager.cpp", "dom/base/ProcessMessageManager.h", "dom/chrome-webidl/MessageManager.webidl", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/InProcessImpl.cpp", "dom/ipc/nsIDOMProcessParent.idl", "dom/push/PushComponents.sys.mjs", "dom/push/test/xpcshell/test_service.js", "dom/push/test/xpcshell/test_service_child.js", "dom/push/test/xpcshell/test_service_parent.js", "dom/push/test/xpcshell/xpcshell.toml", "testing/web-platform/mozilla/meta/push-api/principal.https.window.js.ini", "testing/web-platform/mozilla/tests/push-api/principal.https.window.js"], "git_node": "3aafe29acbf70615358b593dfc75552da9771805", "git_parents": ["c04c1c0003f5a5a6f522570f10afd92c92f20c45"], "node": "89e62a758b26d749cb15a13169ee2bfe7e94b41e", "parents": ["64700777366a8fdb6329858f813c7895ec5ea175"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059144 - Part 2: Add ChromeUtils.validateServiceWorkerScope r=asuth,dom-worker-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316038\n", "files": ["dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/chrome-webidl/ChromeUtils.webidl", "dom/push/PushComponents.sys.mjs", "dom/serviceworkers/ServiceWorkerUtils.cpp", "dom/serviceworkers/ServiceWorkerUtils.h", "testing/web-platform/mozilla/tests/push-api/principal.https.window.js"], "git_node": "f825e0768804d427055b7970abfb314b5884da58", "git_parents": ["3aafe29acbf70615358b593dfc75552da9771805"], "node": "0f755f46d2de050e33c012bb1b44a44d203ac1a9", "parents": ["89e62a758b26d749cb15a13169ee2bfe7e94b41e"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059144 - Part 3: Add nsIPrincipal::IsAddonPrincipal r=robwu,asuth,dom-worker-reviewers,ckerschb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317509\n", "files": ["caps/BasePrincipal.cpp", "caps/BasePrincipal.h", "caps/nsIPrincipal.idl", "dom/serviceworkers/ServiceWorkerUtils.cpp"], "git_node": "8e15c85f5e7fca3b6bb4a5079a46fbbf49f25272", "git_parents": ["f825e0768804d427055b7970abfb314b5884da58"], "node": "2f6d2918a443dab9f84e9dde8fd4390a83680f20", "parents": ["0f755f46d2de050e33c012bb1b44a44d203ac1a9"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2059144: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/push/PushComponents.sys.mjs"], "git_node": "3d37ae759c9cacadd12c44b50f20c14b730e0a81", "git_parents": ["8e15c85f5e7fca3b6bb4a5079a46fbbf49f25272"], "node": "748aeb5a112971aecc272962ac9af6e619538600", "parents": ["2f6d2918a443dab9f84e9dde8fd4390a83680f20"], "tags": []}, {"author": "fatadel \u003cafatkhutdinov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059026 - Improve session handling and evidence rigor in the profiler-analysis skill. r=canova,ai4dev-reviewers,padenot\n\nUse named sessions consistently in SKILL.md and all ten walkthroughs, point at the\nnewer entry commands the walkthroughs predate, and fix the guide-reading,\nprofile-source and daemon-cleanup guidance.\n\nIn the font initialization pair, source the sample counts from commands whose\noutput is shown, and stop asserting mutex ownership that sampled stacks cannot\nestablish.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316239\n", "files": [".agents/skills/profiler-analysis/SKILL.md", ".agents/skills/profiler-analysis/references/firefox-macos-startup-font-initialization-cli.md", ".agents/skills/profiler-analysis/references/firefox-macos-startup-font-initialization.md", ".agents/skills/profiler-analysis/references/macos-extensions-hang-infinite-recursion-cli.md", ".agents/skills/profiler-analysis/references/macos-ipc-blob-url-accumulation-cli.md", ".agents/skills/profiler-analysis/references/resource-usage-linux-fat-aar-build-cli.md", ".agents/skills/profiler-analysis/references/simpleperf-non-rooted-fenix-sync-history-fetch-cli.md", ".agents/skills/profiler-analysis/references/simpleperf-non-rooted-firefox-startup-cli.md", ".agents/skills/profiler-analysis/references/windows-broken-stackwalk-jpeg-avx2-cli.md", ".agents/skills/profiler-analysis/references/windows-test-timeout-cross-process-race-cli.md", ".claude/skills/profiler-analysis/SKILL.md", ".claude/skills/profiler-analysis/references/firefox-macos-startup-font-initialization-cli.md", ".claude/skills/profiler-analysis/references/firefox-macos-startup-font-initialization.md", ".claude/skills/profiler-analysis/references/macos-extensions-hang-infinite-recursion-cli.md", ".claude/skills/profiler-analysis/references/macos-ipc-blob-url-accumulation-cli.md", ".claude/skills/profiler-analysis/references/resource-usage-linux-fat-aar-build-cli.md", ".claude/skills/profiler-analysis/references/simpleperf-non-rooted-fenix-sync-history-fetch-cli.md", ".claude/skills/profiler-analysis/references/simpleperf-non-rooted-firefox-startup-cli.md", ".claude/skills/profiler-analysis/references/windows-broken-stackwalk-jpeg-avx2-cli.md", ".claude/skills/profiler-analysis/references/windows-test-timeout-cross-process-race-cli.md"], "git_node": "b77a9b0fd0fa7afa5d5caab5d02d644311453200", "git_parents": ["3d37ae759c9cacadd12c44b50f20c14b730e0a81"], "node": "9ae86d447b06863ca040b86d44def2a29d1efdf3", "parents": ["748aeb5a112971aecc272962ac9af6e619538600"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056131 - Always prefer GLES over GL on Linux r=gfx-reviewers,ahale\" for causing gl failures in test_EXT_shader_texture_lod.html.\n\nThis reverts commit cc8d856a0b5d433d01c6fd54f9664eff8e7ec4f8.\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "6698fbc9d0b6dc800a3cf7458c8ad4756b387ec9", "git_parents": ["b77a9b0fd0fa7afa5d5caab5d02d644311453200"], "node": "2c08d45615297aad5d4fda300b1a498ddd16991e", "parents": ["9ae86d447b06863ca040b86d44def2a29d1efdf3"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060788 - Surface stale and revalidation state in Happy Eyeballs profiler markers r=necko-reviewers,jesup\" for causing wpt failures in video_dynamic_poster_absolute.htm.\n\nThis reverts commit c04c1c0003f5a5a6f522570f10afd92c92f20c45.\n\nThis reverts commit 7da51d498b3ff1fb7533f59eae9134bdeb3be833.\n\nThis reverts commit ebf212a7c9e95210218881dd97aff9e093dabdfb.\n", "files": ["netwerk/dns/DNSByTypeRecord.h", "netwerk/dns/DNSRequestChild.cpp", "netwerk/dns/DNSRequestParent.cpp", "netwerk/dns/PDNSRequestParams.ipdlh", "netwerk/dns/nsDNSService2.cpp", "netwerk/dns/nsHostRecord.cpp", "netwerk/dns/nsHostRecord.h", "netwerk/dns/nsIDNSByTypeRecord.idl", "netwerk/dns/nsIDNSRecord.idl", "netwerk/protocol/http/ConnectionEstablisher.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.h", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/protocol/http/happy_eyeballs_glue/src/profiler.rs", "netwerk/test/unit/test_happy_eyeballs_optimistic_dns.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "2fcba59e9c8f07e6364758261293db85a7380d18", "git_parents": ["6698fbc9d0b6dc800a3cf7458c8ad4756b387ec9"], "node": "403c71c8f2b129e2c0ed3b67ba161006d5899b18", "parents": ["2c08d45615297aad5d4fda300b1a498ddd16991e"], "tags": []}, {"author": "Ruhollah Majdoddin \u003cr.majdodin@gmail.com\u003e", "branch": "default", "desc": "Bug 1938769 - Don't apply related-tab chaining when insertRelatedAfterCurrent is false. r=dao,tabbrowser-reviewers\n\nWith browser.tabs.insertRelatedAfterCurrent=false and\nbrowser.tabs.insertAfterCurrent=true, #insertTabAtIndex still read\n#lastRelatedTabMap, so consecutive related tabs chained left to right\nbehind their opener even though the related-tab feature was disabled.\nGate the map's placement use on the pref: a demoted related tab is\nthen placed like any other tab, immediately after its opener\n(bug 1485683 comment 3). Owner bookkeeping is untouched, and behavior\nwith both prefs true is unchanged.\n\nThis pref pair is exactly what browserSettings.newTabPosition\n\"afterCurrent\" sets (ext-browserSettings.js), so the fix also applies\nto extensions using that value. The firefox.js pref comments are\nupdated to match the new semantics.\n\nExtends browser_new_tab_insert_position.js with, per permutation: a\nsecond consecutive related open, owner assertions for both related\ntabs, an unrelated tab interleaved before a third related open (the\ntab switch resets the chain), and consecutive related opens from a\npinned opener.\n\nThis work was done with AI assistance; I have reviewed and can explain\nevery line.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315779\n", "files": ["browser/app/profile/firefox.js", "browser/components/tabbrowser/content/tabbrowser.js", "browser/components/tabbrowser/test/browser/tabs/browser_new_tab_insert_position.js"], "git_node": "45e5e078f302d33444758993429201550e0509f6", "git_parents": ["2fcba59e9c8f07e6364758261293db85a7380d18"], "node": "9536c3f0853cdd40f11c34ac96119e8c27b96eed", "parents": ["403c71c8f2b129e2c0ed3b67ba161006d5899b18"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063335 - [devtools] Fix treeherder link in devtools backward compat test docs r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318601\n", "files": ["devtools/docs/contributor/tests/backward-compat-tests.md"], "git_node": "d7fb14939ceaecdfa4e2eb92a4efd1103c41c9d1", "git_parents": ["45e5e078f302d33444758993429201550e0509f6"], "node": "51fc3a2c1a182e58bd0ec8ec2f7f86f6f06ee407", "parents": ["9536c3f0853cdd40f11c34ac96119e8c27b96eed"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063457 - [Nova] Remove min-width on `.urlbarView-row-body-top-no-wrap` so titles don't overflow too early. r=dao,desktop-theme-reviewers,urlbar-reviewers\n\nRemove `.urlbarView-row-body-top-no-wrap { min-width: 0 }` so titles don't\noverflow too early.\n\nThat rule doesn't seem to be necessary. The width and overflow state of\n`.urlbarView-row-body-top-no-wrap` and its descendents still work correctly. It\ndates all the way back to best-match rows in D137097 bug 1752251 [1]. Best-match\nrows became rich-suggestion rows which became the standard row in Nova.\n\n[1] https://searchfox.org/firefox-main/rev/79d36728c2a8fc232aa953744aa31cdb4cf1503c/browser/themes/shared/urlbarView.inc.css#718\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318639\n", "files": ["browser/themes/shared/urlbar/view-nova.css"], "git_node": "796c4c6ba6b3b1b855d45a826c7d15be3ac71c80", "git_parents": ["d7fb14939ceaecdfa4e2eb92a4efd1103c41c9d1"], "node": "bd167906b67e1ac56facf3c43b771111422bca10", "parents": ["51fc3a2c1a182e58bd0ec8ec2f7f86f6f06ee407"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057457 - Ensure we don't lose atom references for symbol weak edges r=sfink\n\nThe problem is that our efforts to refine the atom references effectively by\ndelaying marking atoms referenced by uncollected zones until after refining the\natom reference bitmaps means that we throw away refernces to live atoms that\nare only weakly referenced by collecting zones.\n\nThis is the same problem we've fixed several times in the weak map marking\ncode.\n\nThe fix adds a common way to handle marking weakly refereneced atoms and uses\nit in both cases. This allows us to remove two previous attempts to patch up\nthis problem. It is similar to what we do for weak map edges: mark weakly\nreferenced atoms that are referenced by uncollected zones eagarly. Thes means\nthey are marked when we refine the reference bitmaps for collected zones so\nexisting references are preserved and not thrown away.\n\nThe patch does the marking manually since we can be in the sweep state by this\ntime and the marking machinery doesn't allow any more marking.\n\nThis moves updating the reference bitmaps until the end of sweeping so that it\ncan see marking done by tracing weak edges. Deferred gray marking checks are\ndone after this happens.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316060\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/GCRuntime.h", "js/src/gc/Marking.cpp", "js/src/gc/Sweeping.cpp", "js/src/gc/WeakMap-inl.h", "js/src/gc/WeakMap.cpp", "js/src/jit-test/tests/gc/bug-1997896.js", "js/src/jit-test/tests/gc/bug-2042465.js"], "git_node": "1321127afb4d656010b13eb1028f1ec03107678e", "git_parents": ["796c4c6ba6b3b1b855d45a826c7d15be3ac71c80"], "node": "6b1dbb63496732dc41fd88280ffbb9707b8c37eb", "parents": ["bd167906b67e1ac56facf3c43b771111422bca10"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057457 - Add testcase r=sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316061\n", "files": ["js/src/jit-test/tests/gc/bug-2057457.js"], "git_node": "edbc9bf6222385896e0bb2973aeb568bdc6f5eb6", "git_parents": ["1321127afb4d656010b13eb1028f1ec03107678e"], "node": "af38adadc841f7426521b3f7a08a27e668663f3c", "parents": ["6b1dbb63496732dc41fd88280ffbb9707b8c37eb"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2063394 - Detect whether the path has a browser subdirectory r=geckodriver-reviewers,jgraham\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318535\n", "files": ["testing/mozbase/rust/mozrunner/src/runner.rs"], "git_node": "8af44a7b62f8a5ad380506c6149b96e5062247d6", "git_parents": ["edbc9bf6222385896e0bb2973aeb568bdc6f5eb6"], "node": "3e111f335ef01c7146d0ff7d1482ffaa48c955b7", "parents": ["af38adadc841f7426521b3f7a08a27e668663f3c"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055445 - [devtools] Display higher precision width and height in ViewportSize highlighter. r=emilio,devtools-reviewers,layout-reviewers,webidl,ochameau\n\nWe add a NeedsCallerType annotation on Window#inner(Width|Height) and use it\nto avoid rounding in nsGlobalWindowOuter::GetInnerSize when this is a system call.\n\nSince the ViewportSize highlighter calls Window#inner(Width|Height) as a system\ncall, we're getting non rounded values.\nWe then display the size with a single decimal, as it should be precise enough.\n\nAlso remove unused nsPIDOMWindowOuter nsresult GetInnerWidth|Height and their\nnsGlobalWindowOuter overrides.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318182\n", "files": ["devtools/client/inspector/test/highlighter/browser_inspector_highlighter-rulers_03.js", "devtools/client/inspector/test/highlighter/browser_inspector_highlighter-viewport-size.js", "devtools/server/actors/highlighters/viewport-size.js", "dom/base/nsGlobalWindowInner.cpp", "dom/base/nsGlobalWindowInner.h", "dom/base/nsGlobalWindowOuter.cpp", "dom/base/nsGlobalWindowOuter.h", "dom/base/nsPIDOMWindow.h", "dom/documentpip/DocumentPictureInPicture.cpp", "dom/html/test/browser_ImageDocument_svg_zoom.js", "dom/webidl/Window.webidl"], "git_node": "e640c9ef21472f3e7f71e1541c9b0c8dadebb715", "git_parents": ["8af44a7b62f8a5ad380506c6149b96e5062247d6"], "node": "cb13c9bc31db466035d019b085849aeaf1c2991c", "parents": ["3e111f335ef01c7146d0ff7d1482ffaa48c955b7"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058860 - Defer removal of undeletable files during rollback. r=application-update-reviewers,cdupuis\n\nThis patch improves non-staged updates rollback success rate by trying a\nrename-based strategy when deletion fails. On Windows a file can be locked\nagainst deletion while still being renamable, which is typically the case\nfor a binary that is currently mapped executable by a running program.\nPreviously the locked file was left with its new version contents, leaving\nthe installation in an inconsistent, partially updated state.\n\nThis strategy is already used by backup_discard, so we recycle it into a\nWindows-only remove_on_reboot() helper that moves an undeletable file into\nthe deletion directory and schedules it for removal on the next OS reboot,\nfreeing up the original path so the backup can be restored.\n\nAs a drive-by fix, we ensure that NS_tremove() failures end up with a\nwell-define updater status WRITE_ERROR_DELETE_FILE.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314881\n", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": "92cd500ec700ac6f44f08b4e487c42b4ae0b484e", "git_parents": ["e640c9ef21472f3e7f71e1541c9b0c8dadebb715"], "node": "6279e7f662340a4f4326f3dbf0d5dc06d1a9e578", "parents": ["cb13c9bc31db466035d019b085849aeaf1c2991c"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058860 - Add updater rollback test for a file locked against deletion. r=application-update-reviewers,cdupuis\n\nAdds marRollbackFileLockedForDeletePartial[Zucchini]_win.js which reproduces\nthe condition addressed by the rollback fix on Windows: a new-version file\nthat is locked against deletion but can still be renamed, as happens with an\nin-use library or running executable.\n\nThe test injects the failure in TEST_UPDATER builds, making ensure_remove\npretend that removing the file named by MOZ_TEST_ENSURE_REMOVE_FAIL failed.\nThe hook sits in ensure_remove rather than in the rollback code so that the\nwhole rename_file fallback gets exercised.\n\nAlso adds checkToBeDeletedFileCount to the test harness. Since relocated files\nare named after a UUID, it returns them so that a test can check which file was\nrelocated, here by comparing contents with the new version of 0/0exe0.exe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314882\n", "files": ["toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/tests/unit_update_binary/marRollbackFileLockedForDeletePartialZucchini_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marRollbackFileLockedForDeletePartial_win.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "4a6b09cbec331be69652f08c4c8e0c0873de7488", "git_parents": ["92cd500ec700ac6f44f08b4e487c42b4ae0b484e"], "node": "9f60decb0ed5dc5b3e169ade51e83c0bb70e2e38", "parents": ["6279e7f662340a4f4326f3dbf0d5dc06d1a9e578"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060275 - Factor out updater helpers in preparation for a new update phase. r=application-update-reviewers,cdupuis\n\nBoth AddFile::Execute and PatchFile::Prepare open-code the conversion of the\narchive item path to UTF-8 on Windows before handing it to the archive reader.\nMove that to extract_file and extract_file_to_stream, and let PatchFile write\nthe result of the patch to a destination that its caller selects through\nApplyPatchTo.\n\nThis is a pure refactoring, in preparation for a new phase that writes the new\ncontents of a file somewhere else than its final location.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317576\n", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": "c9c3b096ec5d16011fa8acc228cd1d1c1ae66b19", "git_parents": ["4a6b09cbec331be69652f08c4c8e0c0873de7488"], "node": "85d0d7535a0414de022853683d2cdeb093af0181", "parents": ["9f60decb0ed5dc5b3e169ade51e83c0bb70e2e38"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060275 - Split the Execute phase of non-staged updates into Draft and Execute. r=application-update-reviewers,cdupuis\n\nNon-staged updates used to compute the new contents of a file and move it into\nplace in a single Execute step, so a failure partway through the action list\nleft part of the installation already replaced and recovery depended entirely\non restoring backups.\n\nAdd a Draft phase between Prepare and Execute. It writes the contents produced\nby every add and patch action to a .moz-draft file next to the destination,\nwithout replacing any installed file. Execute then only creates the backup and\nrenames the draft into place, so the installation is inconsistent only across a\nseries of renames rather than across decompression and patch application.\nStaged updates write into their own directory during Execute and have nothing\nto do during Draft.\n\nDrafts left behind by a crashed updater are removed before a new one is\nwritten if listed in the update manifest, and Finish discards any draft\nthat was never committed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317577\n", "files": ["toolkit/mozapps/update/common/updatedefines.h", "toolkit/mozapps/update/docs/Implementation.md", "toolkit/mozapps/update/docs/Troubleshooting.md", "toolkit/mozapps/update/tests/data/complete_log_success_mac", "toolkit/mozapps/update/tests/data/complete_log_success_win", "toolkit/mozapps/update/tests/data/partial_log_failure_mac", "toolkit/mozapps/update/tests/data/partial_log_failure_win", "toolkit/mozapps/update/tests/data/partial_log_success_mac", "toolkit/mozapps/update/tests/data/partial_log_success_win", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "9833a00ed0cdbdb1b4d810b64ceb3af135127bf7", "git_parents": ["c9c3b096ec5d16011fa8acc228cd1d1c1ae66b19"], "node": "eb1f7b39176c0f7c344f15c0d7468c73f82425c3", "parents": ["85d0d7535a0414de022853683d2cdeb093af0181"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060275 - Test that the updater removes stale draft files. r=application-update-reviewers,cdupuis\n\nAdd marSuccessPartialStaleDraft.js, which seeds the installation directory with\n.moz-draft files as a crashed updater instance would have left them behind, and\nchecks that a successful update gets rid of them.\n\nAdd marSuccessPartialStaleDraftLockedForDelete{Add,Patch}_win.js, which make the\nremoval of the stale draft fail so that the updater has to move it out of the way\ninstead, once for each of the two callers of draft_discard. Both assert that the\nfile that ended up in the tobedeleted directory is the stale draft, by comparing\nits contents.\n\nAdd marStageSuccessPartialStaleDraft.js, which checks that a staged update never\ncopies a stale draft into the directory that replaces the installation. Staging\nlegitimately leaves the pre-staging installation directory alone, so the test\nremoves the seeded draft from it by hand before the checks that require that no\ntemporary file is left behind there.\n\nAlso make the check for temporary files that every updater binary test performs\nafter an update cover draft files, not just backup files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317578\n", "files": ["toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/tests/unit_update_binary/marStageSuccessPartialStaleDraft.js", "toolkit/mozapps/update/tests/unit_update_binary/marSuccessPartialStaleDraft.js", "toolkit/mozapps/update/tests/unit_update_binary/marSuccessPartialStaleDraftLockedForDeleteAdd_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marSuccessPartialStaleDraftLockedForDeletePatch_win.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_service.toml"], "git_node": "93c6ece3b7b0c2788bf6d99562796c3faa0dcdc5", "git_parents": ["9833a00ed0cdbdb1b4d810b64ceb3af135127bf7"], "node": "1c2979a646ed810b6eeef16ec6d7969bda987ca9", "parents": ["eb1f7b39176c0f7c344f15c0d7468c73f82425c3"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063303 - Migrate 3 TabbedBrowsingTest UI tests to the efficiency framework r=jajohnson\n\nConverts three @SmokeTest methods of org.mozilla.fenix.ui.TabbedBrowsingTest onto\nthe ui/efficiency framework:\n\n- verifyCloseAllPrivateTabsNotificationTest (TestRail 903592)\n- shareTabsFromTabsTrayTest (TestRail 903598)\n- verifyTheSearchTabsFunctionalityTest (TestRail 3968085)\n\nHarness additions (conversion-supporting; no BasePage/framework-primitive changes):\n- TabDrawerSelectors: tab-search handles (open button, input field, clear button,\n  no-results title/subtitle, TAB_SEARCH_RESULT-by-text) and select/share handles\n  (SELECT_TABS_SHARE_BUTTON, SELECTION_COUNTER).\n- TabDrawerPage: selectTabsForSharing/shareSelectedTabs and\n  openTabSearch/typeInTabSearch/clearTabSearch helpers.\n- ShareOverlaySelectors.SHARED_SITE_LIST + ShareOverlayPage.verifyShareTabsOverlay.\n- NotificationPage private-tabs notification helpers (Android 14 defers the\n  private-session foreground-service notification from display, so it is verified\n  with a longer timeout).\n\nThe legacy methods are annotated @Converted and continue to run until the\nreplacements have been green on main for the configured cadence.\n\nThe UI test successfully passed 25x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=78770  | Try ]]\nAll efficiency UI test successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=78769  | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318537\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/TabbedBrowsingTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/NotificationPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/ShareOverlayPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/TabDrawerPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ShareOverlaySelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/TabDrawerSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TabbedBrowsingTest.kt"], "git_node": "4373a704fa9699d10a6ed280cc692b0874ae58e1", "git_parents": ["93c6ece3b7b0c2788bf6d99562796c3faa0dcdc5"], "node": "453cf29f3285aef122cf1d356947714e14025258", "parents": ["1c2979a646ed810b6eeef16ec6d7969bda987ca9"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063396 - Migrate 4 TextSelectionTest UI tests to the efficiency framework r=jajohnson\n\nConvert the four @SmokeTest TextSelectionTest cases onto the ui/efficiency\nframework:\n- verifySelectAllTextOptionTest (TestRail 2326832)\n- verifyPrivateSearchTextTest (TestRail 2326831)\n- verifyCopyPDFTextOptionTest (TestRail 243839)\n- verifySearchPDFTextOptionTest (TestRail 2326836)\n\nAll four are faithful ports; every legacy verify* has a counterpart, so no\nassertions were dropped. The legacy methods are annotated @Converted and keep\nrunning alongside the replacements.\n\nHarness extensions added in service of these tests (all reusable):\n- BrowserPage: web-content long-click + text-selection floating-menu item\n  helpers, display-mode toolbar long-click + paste, tab-counter verify, and a\n  select-then-search helper that confirms a new tab opened.\n- SearchBarComponent: clear button, placeholder verify, edit-mode long-click +\n  paste, and verifyTypedToolbarText (whitespace-normalized, reading both the\n  Text and EditableText semantics of the edit-mode toolbar).\n- HomePage: switchToPrivateBrowsingMode (toggle-and-confirm; robust to a\n  private-mode state leak across tests/runs).\n- Selectors: text-selection context-menu item, display-mode toolbar menu item,\n  a UiObject2 clear button, and Compose content-description tab-counter variants.\n\nThe tab counter is asserted via the Compose content-description rather than the\nUIAutomator accessibility tree: after a text-selection Search opens a new tab\nthe UIAutomator tree lags the Compose tree by several seconds (Compose already\nreads \"Tabs Open: 2\" while UIAutomator still reads 1), which made a\nUIAutomator-based assertion flaky. This mirrors the legacy\nBrowserRobot.verifyTabCounter, which read the counter via Compose.\n\nThe UI tests successfully passed 25x on Firebase.: https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=78881\nAll efficiency UI tests successfully passed 1x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=78880\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318538\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/TextSelectionTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BrowserPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/HomePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SearchBarComponent.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SearchBarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ToolbarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TextSelectionTest.kt"], "git_node": "d868655d031556db39e929b870b9d22927f6eeec", "git_parents": ["4373a704fa9699d10a6ed280cc692b0874ae58e1"], "node": "da3d1cdd2bf6b8b9b431dcf7575fa71ba3b586ad", "parents": ["453cf29f3285aef122cf1d356947714e14025258"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056873 - gn_processor.py: generate separate configs for macOS and iOS. r=glandium\n\nStill passing target_os = \"mac\" to `gn gen` for the iOS configurations\nelse it will fail, but this allows different options to be set for macOS\nand iOS respectively.\n\nIn particular, this allows ANGLE to build different targets with\ndifferent enabled backends for macOS and iOS.\n\nIn addition to the `CONFIG[\"OS_TARGET\"] == \"Darwin\"` conditions emitted\nin the generated moz.build files, `CONFIG[\"TARGET_OS\"] == \"OSX\"` and\n`CONFIG[\"TARGET_OS\"] == \"iOS\"` conditions are emitted where appropriate.\n\nThis allows us to remove the hack in gfx/angle/moz.yaml we previously\nused to ensure ANGLE's libEGL and libGLESv2 targets weren't built for\niOS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313443\n", "files": ["build/gn_processor.py", "gfx/angle/moz.yaml", "third_party/angle/angle_program_version_id_gn/ANGLEShaderProgramVersion.h-38b92a81b146c9a5.rsp.in", "third_party/angle/angle_program_version_id_gn/moz.build", "third_party/angle/moz.build", "third_party/angle/translator_gn/moz.build"], "git_node": "915a45750cd3afcb27f2afb518be3351162ca0f8", "git_parents": ["d868655d031556db39e929b870b9d22927f6eeec"], "node": "2d1c274df23b7a6f29f870d61797bf523d2f1345", "parents": ["da3d1cdd2bf6b8b9b431dcf7575fa71ba3b586ad"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058982 - Quota manager: check for inconsistencies (underflows, mismatch) when loading an origin and trigger a full rescan if there one. r=dom-storage-reviewers,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316002\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/CommonMetadata.cpp", "dom/quota/CommonMetadata.h", "dom/quota/OriginInfo.cpp", "dom/quota/OriginInfo.h", "dom/quota/test/gtest/TestQuotaManager.cpp", "dom/quota/test/xpcshell/test_underflowedCacheRescan.js", "dom/quota/test/xpcshell/xpcshell.toml"], "git_node": "741db9a941f7472bd8e92f5fee20a9fef370a6f7", "git_parents": ["915a45750cd3afcb27f2afb518be3351162ca0f8"], "node": "e985e1aa0c1970d0a14faa26c4e42f708502a464", "parents": ["2d1c274df23b7a6f29f870d61797bf523d2f1345"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053404 - Cleanup default state for static-analysis on Windows / chrome part r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311064\n", "files": ["chrome/nsChromeRegistryChrome.h"], "git_node": "4e895c558fac73a75900ce01f1951c02b0158830", "git_parents": ["741db9a941f7472bd8e92f5fee20a9fef370a6f7"], "node": "7f52be61242e2f94424c35ddb949a5f325ea98f6", "parents": ["e985e1aa0c1970d0a14faa26c4e42f708502a464"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053404 - Cleanup default state for static-analysis on Windows / browser part r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311065\n", "files": ["browser/components/shell/nsWindowsShellService.cpp", "browser/components/shell/nsWindowsShellService.h"], "git_node": "8d26413b2a76b285d5aa46cf7694a9732ba79e79", "git_parents": ["4e895c558fac73a75900ce01f1951c02b0158830"], "node": "e4c2debdcf730a396b78aa6f678b301d6f9c14a7", "parents": ["7f52be61242e2f94424c35ddb949a5f325ea98f6"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053404 - Cleanup default state for static-analysis on Windows / docshell part r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311066\n", "files": ["docshell/base/BaseHistory.cpp", "docshell/base/BaseHistory.h"], "git_node": "39fba6dc61560de9296ea2e77fc9f58031d80eff", "git_parents": ["8d26413b2a76b285d5aa46cf7694a9732ba79e79"], "node": "de68674e62328bd82cc28b4153273ed38ecb45be", "parents": ["e4c2debdcf730a396b78aa6f678b301d6f9c14a7"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059199 - Reject NUL bytes in chunked trailer and chunk-size lines r=necko-reviewers,valentin\n\nA trailer field line whose first byte is NUL would look empty to the\nend-of-trailer check, ending the trailer section early. We would then stop\nreading the body before the server (or a shared proxy) does, and disagree\nwith them about where the response ends.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317742\n", "files": ["netwerk/protocol/http/nsHttpChunkedDecoder.cpp"], "git_node": "56484cfaf5d5621ed989e743ebfcb7efb33038fe", "git_parents": ["39fba6dc61560de9296ea2e77fc9f58031d80eff"], "node": "5766d224d7c0f365782064f3b1765254f5093b88", "parents": ["de68674e62328bd82cc28b4153273ed38ecb45be"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063276 - Fix incorrect use of `std::forward` where `std::move` should be used r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318459\n", "files": ["js/src/vm/JSONParser.h"], "git_node": "57567957a905c7d51dca7bed6ac7e86b1fbbfd24", "git_parents": ["56484cfaf5d5621ed989e743ebfcb7efb33038fe"], "node": "b7a92f3879c3d9ba660886f3f3a4ec4ffd010b97", "parents": ["5766d224d7c0f365782064f3b1765254f5093b88"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062619 - Replace mention of XP_ANDROID define by ANDROID r=tjr\n\nXP_ANDROID does not exist in the first place. Android systems live under\nXP_LINUX, with ANDROID also being defined.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317815\n", "files": ["gfx/tests/gtest/TestFontOverlapPrevention.cpp", "toolkit/components/resistfingerprinting/nsRFPService.cpp"], "git_node": "2fc01b03e60c69de3cf535f8fe80eb3a025ab0a3", "git_parents": ["57567957a905c7d51dca7bed6ac7e86b1fbbfd24"], "node": "15a094a9caace80388ee832fc7c88e63a14a1995", "parents": ["b7a92f3879c3d9ba660886f3f3a4ec4ffd010b97"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2063296 - Update Mozsearch Clang plugin with Clang 22 fixes. r=asuth\n\nThis brings in changes related to qualified name handling in Clang 22,\nsee https://github.com/mozsearch/mozsearch/pull/1130 for details and\ntests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318476\n", "files": ["build/clang-plugin/mozsearch-plugin/MozsearchIndexer.cpp"], "git_node": "289464f61a5d2c4bfc4c46261589687c8b4f7d6f", "git_parents": ["2fc01b03e60c69de3cf535f8fe80eb3a025ab0a3"], "node": "6e896adbebcfec5f32224f1037e049dbdc114ae1", "parents": ["15a094a9caace80388ee832fc7c88e63a14a1995"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2063535: Fix spelling: porcess -\u003e process r=valentin,necko-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318673\n", "files": ["dom/media/webspeech/synth/cocoa/OSXSpeechSynthesizerService.mm", "dom/media/webspeech/synth/windows/SapiService.cpp", "netwerk/ipc/PSocketProcess.ipdl", "netwerk/ipc/SocketProcessChild.cpp", "netwerk/ipc/SocketProcessChild.h", "netwerk/ipc/SocketProcessHost.cpp"], "git_node": "6cb06427f41e8821ad6d936ce4fb5fa26a26bdd5", "git_parents": ["289464f61a5d2c4bfc4c46261589687c8b4f7d6f"], "node": "8f242ee479c2cf41479a89a8306c8b1635a0b28c", "parents": ["6e896adbebcfec5f32224f1037e049dbdc114ae1"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2051235 - Build Searchfox Rust SCIP index using latest rust-analyzer release. r=glandium\n\nThis add a new rust-analyzer toolchain which fetches and repacks the\nlatest upstream binary release.\n\nThis is meant to get Emilio's patch so that rust-analyzer uses and\nindexes our vendored crates[1] and to allow updating rust-analyzer more\nfrequently than the complete Rust toolchain.\n\n[1] https://github.com/rust-lang/rust-analyzer/pull/22679\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315641\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/searchfox/kind.yml", "taskcluster/kinds/toolchain/kind.yml", "taskcluster/kinds/toolchain/rust-analyzer.yml", "taskcluster/scripts/misc/repack-rust-analyzer.sh", "toolkit/mozapps/installer/packager.mk"], "git_node": "226e7115753c29ff7960af406f299aa094e8b13a", "git_parents": ["6cb06427f41e8821ad6d936ce4fb5fa26a26bdd5"], "node": "dc1b29c8bd166d28f83f3af751f36c2ede3f069b", "parents": ["8f242ee479c2cf41479a89a8306c8b1635a0b28c"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2063109 - Remove some more old telemetry probes from Histograms.json and elsewhere: ORB, ForgetSkippable, SessionStore, r=farre,janerik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318322\n", "files": ["browser/components/sessionstore/metrics.yaml", "dom/metrics.yaml", "netwerk/protocol/http/metrics.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml"], "git_node": "8c19ad58a317e4b4fcf8f8a89cab86e82c8769f3", "git_parents": ["226e7115753c29ff7960af406f299aa094e8b13a"], "node": "151632b40ffd5d76876dd03e581e8c1e2761527a", "parents": ["dc1b29c8bd166d28f83f3af751f36c2ede3f069b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062186 - Fix the intermittent stale about:preferences tab in browser_ext_url_overrides_newtab.js, r=extension-reviewers,rpl.\n\nThe test clicked the doorhanger's Manage button while its New Tab page was still\nloading. openPreferences() does not reuse a loading tab, so about:preferences\nopened in a new one that the test never closed. Wait for the load, and assert\nwhich tab the preferences page lands in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317525\n", "files": ["browser/components/extensions/test/browser/browser-search-and-settings.toml", "browser/components/extensions/test/browser/browser_ext_url_overrides_newtab.js"], "git_node": "77d86cf9a34118d7535b9f23f706fec6a21a2a9a", "git_parents": ["8c19ad58a317e4b4fcf8f8a89cab86e82c8769f3"], "node": "df78899b28e0404325b27bd14ee50ffe0392f6a6", "parents": ["151632b40ffd5d76876dd03e581e8c1e2761527a"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063109 - Remove some more old telemetry probes from Histograms.json and elsewhere: ORB, ForgetSkippable, SessionStore, r=farre,janerik\" for causing python failures.\n\nThis reverts commit 8c19ad58a317e4b4fcf8f8a89cab86e82c8769f3.\n", "files": ["browser/components/sessionstore/metrics.yaml", "dom/metrics.yaml", "netwerk/protocol/http/metrics.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml"], "git_node": "9009d7cc4e651259b9ca20e4ed9914a20fb10a45", "git_parents": ["77d86cf9a34118d7535b9f23f706fec6a21a2a9a"], "node": "8224e464bb6b1900e49a440ce0de956437095465", "parents": ["df78899b28e0404325b27bd14ee50ffe0392f6a6"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2057605 - Keep urlbar row highlighted while resultmenu open. r=dao,desktop-theme-reviewers,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316761\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-results/browser_result_menu.js", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "188b60e5a0391fe9e5b1e82e236026e8a0b0d323", "git_parents": ["9009d7cc4e651259b9ca20e4ed9914a20fb10a45"], "node": "8194ca80514bcf3c21fa839cf91112110d632187", "parents": ["8224e464bb6b1900e49a440ce0de956437095465"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063453 - Update metadata for clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-on-self-origin-by-permissions-policy.tentative.https.sub.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318683\n", "files": ["testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-on-self-origin-by-permissions-policy.tentative.https.sub.html.ini"], "git_node": "229a1437f5fc025a38b496fcc632c009708b1d7e", "git_parents": ["188b60e5a0391fe9e5b1e82e236026e8a0b0d323"], "node": "169694fa8b84dc64b013684110d80c7dd09a3098", "parents": ["8194ca80514bcf3c21fa839cf91112110d632187"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2063109 - Remove some more old telemetry probes from Histograms.json and elsewhere: ORB, ForgetSkippable, SessionStore, r=farre,janerik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318322\n", "files": ["browser/components/sessionstore/metrics.yaml", "dom/metrics.yaml", "netwerk/protocol/http/metrics.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml"], "git_node": "b87adf10d662a17e554eea2b689ff6c9200fda10", "git_parents": ["229a1437f5fc025a38b496fcc632c009708b1d7e"], "node": "6c9e35ae4cbb081bebe3148d09d3b2e1b850bd75", "parents": ["169694fa8b84dc64b013684110d80c7dd09a3098"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055445 - [devtools] Display higher precision width and height in ViewportSize highlighter. r=emilio,devtools-reviewers,layout-reviewers,webidl,ochameau\" for causing Android webdriver failures.\n\nThis reverts commit e640c9ef21472f3e7f71e1541c9b0c8dadebb715.\n", "files": ["devtools/client/inspector/test/highlighter/browser_inspector_highlighter-rulers_03.js", "devtools/client/inspector/test/highlighter/browser_inspector_highlighter-viewport-size.js", "devtools/server/actors/highlighters/viewport-size.js", "dom/base/nsGlobalWindowInner.cpp", "dom/base/nsGlobalWindowInner.h", "dom/base/nsGlobalWindowOuter.cpp", "dom/base/nsGlobalWindowOuter.h", "dom/base/nsPIDOMWindow.h", "dom/documentpip/DocumentPictureInPicture.cpp", "dom/html/test/browser_ImageDocument_svg_zoom.js", "dom/webidl/Window.webidl"], "git_node": "37696b91017b80fd07bdd844d8bdc91d08e361ce", "git_parents": ["b87adf10d662a17e554eea2b689ff6c9200fda10"], "node": "53701978037f3efc93f6144049ca30dbd6853725", "parents": ["6c9e35ae4cbb081bebe3148d09d3b2e1b850bd75"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063269 - Pass waitForMutationCondition's message as the option it expects. r=firefox-desktop-core-reviewers ,places-reviewers,urlbar-reviewers,Standard8,mossop\n\nThese call sites pass their message as a bare fourth argument, which the helper\ndestructures as `{ msg }`, so `msg` comes out undefined and the wait reports the\ngenerated fallback label instead. Wrap each one. The strings were dead before\ntoo, back when the fourth argument was unused.\n\nMechanical throughout, every message carried over verbatim; the reflowed\ntemplate literals in the datetime tests are prettier's doing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318473\n", "files": ["browser/components/extensions/test/browser/browser_ext_sidebarAction.js", "browser/components/places/tests/browser/head.js", "browser/components/sidebar/tests/browser/browser_sidebar_escape_collapse.js", "browser/components/sidebar/tests/browser/browser_sidebar_expand_on_hover.js", "browser/components/sidebar/tests/browser/browser_syncedtabs_sidebar.js", "browser/components/sidebar/tests/browser/browser_tools_overflow.js", "browser/components/sidebar/tests/browser/head.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_about_opentabs.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_alt_click.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_contextmenu.js", "browser/components/urlbar/tests/browser-quickactions/browser_mute.js", "dom/events/test/clipboard/browser_navigator_clipboard_clickjacking.js", "dom/events/test/clipboard/browser_navigator_clipboard_contextmenu_suppression.js", "dom/events/test/clipboard/browser_navigator_clipboard_contextmenu_suppression_ext.js", "dom/events/test/clipboard/browser_navigator_clipboard_readText_multiple.js", "dom/events/test/clipboard/head.js", "toolkit/content/tests/browser/datetime/browser_datetime_datepicker_focus.js", "toolkit/content/tests/browser/datetime/browser_datetime_datepicker_keynav.js", "toolkit/content/tests/browser/datetime/browser_datetime_datepicker_prev_next_month.js", "toolkit/content/tests/browser/datetime/browser_datetime_timepicker.js", "toolkit/content/tests/browser/datetime/browser_datetime_timepicker_keynav.js", "toolkit/content/tests/browser/datetime/browser_spinner_keynav.js"], "git_node": "e7fe37123b55f9b3640aa540e436380c003b2839", "git_parents": ["37696b91017b80fd07bdd844d8bdc91d08e361ce"], "node": "4d9f1acfaffcaec5f066d72f60f43b2088aaf51d", "parents": ["53701978037f3efc93f6144049ca30dbd6853725"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1892091 - Click BTP test links with a synthesized mouse event. r=timhuang\n\nnavigateLinkClick faked user activation and called link.click() because\ndriving the click from the parent with\nBrowserTestUtils.synthesizeMouseAtCenter was intermittent. That helper\nneeds a second IPC round trip after the link is inserted, which can race\nthe insertion (Bug 1743857). It resolves the selector in the content\nprocess and, when the selector does not match, only dumps a message and\ndispatches the click at (0, 0). That lands in the body margin and hits\nthe root element, which is what the intermittent failures looked like.\n\nInsert and click the link in the same content task instead, using\nContentTaskUtils.getEventUtils. The link is pinned to the top left\ncorner above any other content so the click always hits it, and the\nhelper now asserts that it did rather than silently clicking nothing.\n\nA real click grants transient user activation via EventStateManager and\nmarks the document as interacted with, which reaches\nBounceTrackingProtection::RecordUserActivation through\nDocument::SetUserHasInteracted. The explicit\nnotifyUserGestureActivation and userInteractionForTesting calls are\ntherefore no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318165\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/test/browser/head.js"], "git_node": "203de8d131478149ea33620e04e93d6d24688fdb", "git_parents": ["e7fe37123b55f9b3640aa540e436380c003b2839"], "node": "3a7cfc34eca1e24ea5858ed69ef2cebc014871ab", "parents": ["4d9f1acfaffcaec5f066d72f60f43b2088aaf51d"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033039 - Update PBM app icons for nova. r=hsohaney\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300080\n", "files": ["browser/branding/aurora/PrivateBrowsing_150.png", "browser/branding/aurora/PrivateBrowsing_70.png", "browser/branding/aurora/pbmode.ico", "browser/branding/nightly/PrivateBrowsing_150.png", "browser/branding/nightly/PrivateBrowsing_70.png", "browser/branding/nightly/pbmode.ico", "browser/branding/official/PrivateBrowsing_150.png", "browser/branding/official/PrivateBrowsing_70.png", "browser/branding/official/pbmode.ico", "browser/branding/unofficial/PrivateBrowsing_150.png", "browser/branding/unofficial/PrivateBrowsing_70.png", "browser/branding/unofficial/pbmode.ico"], "git_node": "55e784d4a4aea6ad8cde651510ada4546fae7db6", "git_parents": ["203de8d131478149ea33620e04e93d6d24688fdb"], "node": "308e4b943853299d554964e6406c7c77b6ab7d8c", "parents": ["3a7cfc34eca1e24ea5858ed69ef2cebc014871ab"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2015004 - Don't hide bookmarks toolbar items using a stale visible-item count, r=places-reviewers,Standard8.\n\nAn item added to the bookmarks toolbar can be hidden although it fits, because\nthe visibility update applies a count measured before the item existed. A hidden\nitem is not hit-testable, so clicks aimed at it fall through to the toolbar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317524\n", "files": ["browser/components/places/content/browserPlacesViews.js"], "git_node": "2e9dedda36bcb7c5564fb39420505908b86a359c", "git_parents": ["55e784d4a4aea6ad8cde651510ada4546fae7db6"], "node": "32affa6924e16f228e38d8a402996188d1bfa6fa", "parents": ["308e4b943853299d554964e6406c7c77b6ab7d8c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2062197 - Update hover state on pointer events as well as mouse events. r=smaug\n\nWe need to do it on both because we have some synthesized mouse events\nwhich don't generate pointer events.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318502\n", "files": ["dom/events/EventStateManager.cpp", "dom/events/test/mochitest.toml", "dom/events/test/test_hover_mouseleave.html", "testing/web-platform/tests/css/selectors/hover-boundary-events.html"], "git_node": "ff53f33899d08f8ecad25bcb8a810166b47997ca", "git_parents": ["2e9dedda36bcb7c5564fb39420505908b86a359c"], "node": "b948da78565f12bf503fe06045b2a423817d0144", "parents": ["32affa6924e16f228e38d8a402996188d1bfa6fa"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053650 - Replace AccountScopeAccessor with the FxaClient / FxaAccount variant r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317423\n", "files": ["mobile/android/android-components/components/concept/sync/src/main/java/mozilla/components/concept/sync/OAuthAccount.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/FirefoxAccount.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/AccountScopeAccessor.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/FxaAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaAccountManagerTest.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/manager/AccountScopeAccessorTest.kt", "mobile/android/android-components/components/service/firefox-relay/src/test/java/mozilla/components/service/fxrelay/FxRelayTest.kt", "mobile/android/android-components/components/service/firefox-relay/src/test/java/mozilla/components/service/fxrelay/eligibility/RelayFeatureTest.kt"], "git_node": "39e88b3b81794cda342ed5cc63323abdb76d5bd0", "git_parents": ["ff53f33899d08f8ecad25bcb8a810166b47997ca"], "node": "11d2ccb6ea704e58026fae6a97d4dbe6b19d19d4", "parents": ["b948da78565f12bf503fe06045b2a423817d0144"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2063537 - Simplify Maybe usage r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318693\n", "files": ["dom/svg/SVGFragmentIdentifier.cpp", "dom/svg/SVGGeometryElement.cpp", "dom/svg/SVGPathElement.cpp", "dom/svg/SVGPathSegUtils.cpp", "dom/svg/SVGSVGElement.h", "dom/svg/SVGTests.cpp", "layout/svg/FilterInstance.cpp", "layout/svg/SVGContextPaint.h", "layout/svg/SVGGeometryFrame.cpp", "layout/svg/SVGGradientFrame.cpp", "layout/svg/SVGIntegrationUtils.cpp"], "git_node": "288cc902d3e25b4b85bbe872e077382ace3db840", "git_parents": ["39e88b3b81794cda342ed5cc63323abdb76d5bd0"], "node": "4c8dbe114e223562b52ae27e71f7c8e1abfe6284", "parents": ["11d2ccb6ea704e58026fae6a97d4dbe6b19d19d4"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021276 - Preserve links when the SmartBlock embed container is itself an \u003ca\u003e element. r=webcompat-reviewers,timhuang,twisniewski\n\nUse outerHTML instead of innerHTML when extracting safe content for the SmartBlock embed placeholder, since innerHTML drops the element's own tag, losing the href when the matched embed element is itself an \u003ca\u003e rather than a wrapper containing one. No behavior change for wrapper containers, since the Sanitizer already unwraps those regardless of\nwhich serialization is used.\n\nAdds a regression test (browser_smartblockembeds_link_preservation.js)\ncovering the case where the matched container element is the link itself, using a new fixture page (smartblock_embed_link_container_test.html).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318397\n", "files": ["browser/extensions/webcompat/lib/smartblock_embeds_helper.js", "browser/extensions/webcompat/tests/browser/browser.toml", "browser/extensions/webcompat/tests/browser/browser_smartblockembeds_link_preservation.js", "browser/extensions/webcompat/tests/browser/head.js", "browser/extensions/webcompat/tests/browser/smartblock_embed_link_container_test.html"], "git_node": "fbd28db0bba672d5a923209e8db2ec16440cadcc", "git_parents": ["288cc902d3e25b4b85bbe872e077382ace3db840"], "node": "da3b6a3471deb028d71b1b6c0feb0d9e702f340e", "parents": ["4c8dbe114e223562b52ae27e71f7c8e1abfe6284"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063581 - Use the correct value in metadata for /fetch/local-network-access/service-worker.tentative.https.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318710\n", "files": ["testing/web-platform/meta/fetch/local-network-access/service-worker.tentative.https.html.ini"], "git_node": "ce6988e577dd7ab298ea0b4d6dfd1921b4d5cea8", "git_parents": ["fbd28db0bba672d5a923209e8db2ec16440cadcc"], "node": "753e3eb715686937259323374a399fb63fa11c7a", "parents": ["da3b6a3471deb028d71b1b6c0feb0d9e702f340e"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062197 - Update hover state on pointer events as well as mouse events. r=smaug\" for causing mochitest failures @ test_group_touchevents-6.html\n\nThis reverts commit ff53f33899d08f8ecad25bcb8a810166b47997ca.\n", "files": ["dom/events/EventStateManager.cpp", "dom/events/test/mochitest.toml", "dom/events/test/test_hover_mouseleave.html", "testing/web-platform/tests/css/selectors/hover-boundary-events.html"], "git_node": "303e4b8e5131edc70584162e5e9e172c6d9ebf87", "git_parents": ["ce6988e577dd7ab298ea0b4d6dfd1921b4d5cea8"], "node": "2a0066ab695c1d1bf201bdfd1fc410cb3d4f4068", "parents": ["753e3eb715686937259323374a399fb63fa11c7a"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030812 - Pre 1: Add desktop_launcher_helpers.nsh to TEST_STUB_INSTALLER_DEPS. r=aborondo,browser-installer-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312155\n", "files": ["browser/installer/windows/nsis/Makefile.in"], "git_node": "df62a01d0f85ad627794d28d04476f658955c2b0", "git_parents": ["303e4b8e5131edc70584162e5e9e172c6d9ebf87"], "node": "c4f7b4c005ac023c3dff46179eb96c480808a890", "parents": ["2a0066ab695c1d1bf201bdfd1fc410cb3d4f4068"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030812 - Pre 2: Check that the /DesktopLauncher argument is provided on non-enterprise installations. r=aborondo,browser-installer-reviewers,application-update-reviewers\n\nAdditionally, adds infrastructure to let this be mocked out more easily.\n\nThe upcoming marPostUpdateTarget.js tests the enterprise case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313892\n", "files": ["toolkit/mozapps/update/tests/TestAUSHelper.cpp", "toolkit/mozapps/update/tests/unit_update_binary/marPostUpdateDesktopLauncher.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_service.toml", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "b4e598adad8db5eaebd864e375845805206d9f92", "git_parents": ["df62a01d0f85ad627794d28d04476f658955c2b0"], "node": "5215c2f7b4bd3e23409c4869a6f2376e4617b0b7", "parents": ["c4f7b4c005ac023c3dff46179eb96c480808a890"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030812 - Part 1: Indicate to the post-updater whether it is running for one user or the whole installation. r=browser-installer-reviewers,application-update-reviewers,nrishel,aborondo\n\nI think the longer-term goal should be to never call the post-updater\nwith 'currentuser' in the first place---it only runs for the user who\nhappens to start the update, which means that it won't run much in\nenterprise scenarios or on some multi-user machines. I think logic\nrunning at startup in the application itself (maybe written in\nJavaScript) is the way to go for per-user changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D278328\n", "files": ["toolkit/mozapps/update/tests/unit_update_binary/marPostUpdateDesktopLauncher.js", "toolkit/mozapps/update/tests/unit_update_binary/marPostUpdateTarget.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_service.toml", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "6ea673c21267916e806766659fd4de50c3c711f6", "git_parents": ["b4e598adad8db5eaebd864e375845805206d9f92"], "node": "356dec45e605dadffdd097b1120f384dccd2ab3a", "parents": ["5215c2f7b4bd3e23409c4869a6f2376e4617b0b7"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030812 - Part 2: Call a different post-update function depending on /PostUpdateTarget. r=browser-installer-reviewers,aborondo\n\nLater commits in the stack will move functionality that's currently in\nPostUpdateInstallation into other functions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295084\n", "files": ["browser/installer/windows/nsis/postupdate_helper.nsh", "browser/installer/windows/nsis/test_stub.nsi", "browser/installer/windows/nsis/uninstaller_helpers.nsh"], "git_node": "85e71f455cd29c93331e2a47597f3e78a3d04c41", "git_parents": ["6ea673c21267916e806766659fd4de50c3c711f6"], "node": "5266c2e18598d586a9db7179392401f04c5614f8", "parents": ["356dec45e605dadffdd097b1120f384dccd2ab3a"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030812 - Part 3: Separate some post-update tasks that need HKLM into PostUpdateElevated. r=aborondo,browser-installer-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309462\n", "files": ["browser/installer/windows/nsis/uninstaller_helpers.nsh"], "git_node": "7163533b46bc90d8e4af7ca61a3bb83615d25fa9", "git_parents": ["85e71f455cd29c93331e2a47597f3e78a3d04c41"], "node": "e36fbb4626722cfebdef71150cc5cc423765bd12", "parents": ["5266c2e18598d586a9db7179392401f04c5614f8"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030812 - Part 4: Extract some post-update tasks that need HKCU into PostUpdateNonElevated. r=aborondo,browser-installer-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309463\n", "files": ["browser/installer/windows/nsis/uninstaller_helpers.nsh"], "git_node": "d75ebf41e678167b0d3485314734bbb2be7f681f", "git_parents": ["7163533b46bc90d8e4af7ca61a3bb83615d25fa9"], "node": "a2ca2139157fa9b8a7be15959aa9aae3b0b9c91d", "parents": ["e36fbb4626722cfebdef71150cc5cc423765bd12"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030812 - Part 5: Reorganize shortcut updating and related post-update tasks. r=browser-installer-reviewers,aborondo\n\nFor shortcut updating, this will do it twice for non-elevated\ninstallations, but (a) that shouldn't matter much, and (b) it will no\nlonger 'clean up' the system account's files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295085\n", "files": ["browser/installer/windows/nsis/uninstaller_helpers.nsh"], "git_node": "9aab4da505a659d963b086c4a424e1cb3270c97b", "git_parents": ["d75ebf41e678167b0d3485314734bbb2be7f681f"], "node": "703c9f45e582af3c14aad077794484a817ddcff1", "parents": ["a2ca2139157fa9b8a7be15959aa9aae3b0b9c91d"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030812 - Part 6: Copy remaining PostUpdateInstallation contents into PostUpdateCurrentUser. r=browser-installer-reviewers,aborondo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295086\n", "files": ["browser/installer/windows/nsis/uninstaller_helpers.nsh"], "git_node": "00a83348c97b0d97feb033529c85555c6eae5594", "git_parents": ["9aab4da505a659d963b086c4a424e1cb3270c97b"], "node": "bbdc5fa965c0920abfbece3b1a5b4a89a37bbacf", "parents": ["703c9f45e582af3c14aad077794484a817ddcff1"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030812 - Post: Update documentation to include new command-line argument usage and explain how to integrate with it. r=aborondo,browser-installer-reviewers,application-update-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313893\n", "files": ["browser/installer/windows/docs/Helper.md", "toolkit/mozapps/update/docs/Implementation.md"], "git_node": "26ce4044fdff1c15c6f251107bfc33169af9346f", "git_parents": ["00a83348c97b0d97feb033529c85555c6eae5594"], "node": "445c62500e3cdb8fccb05a8f4bf10df1a0c04c34", "parents": ["bbdc5fa965c0920abfbece3b1a5b4a89a37bbacf"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063549 - [devtools] Early ok() in devtools-backward-compat tests when release channel is lagging by 1 version r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318689\n", "files": ["devtools/client/aboutdebugging/test/browser/helper-backward-compat.js"], "git_node": "37c917924c7e2e16a845978729514cd2e247ddbd", "git_parents": ["26ce4044fdff1c15c6f251107bfc33169af9346f"], "node": "cd1152d6f0ea916634ac2c8db6105b0d4057a3c6", "parents": ["445c62500e3cdb8fccb05a8f4bf10df1a0c04c34"], "tags": []}, {"author": "lola_t \u003cltokhtamuradova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2022880 - Add url and one line title for all blocked trackers screens r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318413\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/header/SubmenuHeader.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/TrustPanelFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/TrackerCategoryDetailsPanel.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/TrackersBlockedPanel.kt"], "git_node": "84b31b68de664596f68c0954a33603ba3a70033e", "git_parents": ["37c917924c7e2e16a845978729514cd2e247ddbd"], "node": "3132f570b496721f374f3a2ce6b94107b2f19559", "parents": ["cd1152d6f0ea916634ac2c8db6105b0d4057a3c6"], "tags": []}, {"author": "lola_t \u003cltokhtamuradova@mozilla.com\u003e", "branch": "default", "desc": "Bug 1969533 - Fix KDoc for WebCompatReporterRetrievalService r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317816\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/middleware/WebCompatReporterRetrievalService.kt"], "git_node": "7f2b54698b6348035244e7af000571560c3a2125", "git_parents": ["84b31b68de664596f68c0954a33603ba3a70033e"], "node": "95b4ab223bbbe3d577e94cb56e6de3ea88594df1", "parents": ["3132f570b496721f374f3a2ce6b94107b2f19559"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063534 - Replace error-prone memcpy with equivalent std::copy calls r=xpcom-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318674\n", "files": ["xpcom/ds/nsDeque.cpp", "xpcom/io/nsSegmentedBuffer.cpp"], "git_node": "befc0205f0a35221f19d414fda9c1788f3d38372", "git_parents": ["7f2b54698b6348035244e7af000571560c3a2125"], "node": "8d7e4b4cfa4fdf20de4287139458ef2bacb394bf", "parents": ["95b4ab223bbbe3d577e94cb56e6de3ea88594df1"], "tags": []}, {"author": "nirmaladvani \u003cnirmaladvani@live.com\u003e", "branch": "default", "desc": "Bug 2059350 - Turn needTracing into a local variable in WebRequest.sys.mjs's addOrRemove. r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316366\n", "files": ["toolkit/components/extensions/webrequest/WebRequest.sys.mjs"], "git_node": "48d5ab5d64630e6c0f68a74fa7a555c3efa6838a", "git_parents": ["befc0205f0a35221f19d414fda9c1788f3d38372"], "node": "8539be7b0dc41c48f6441a452d825716554cb8d1", "parents": ["8d7e4b4cfa4fdf20de4287139458ef2bacb394bf"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059130 - Save pending exception across promise creation in WasmPromisingFunction. r=jpages\n\nWhen a promising wasm call fails synchronously, the wrapper converts the\nfailure into a rejected promise. Creating that promise runs NewPromiseObject,\nwhich fires the Debugger onNewPromise hook -- debugger-supplied JS that must\nnot run while an exception is pending (debug builds assert\n!cx-\u003eisExceptionPending()). Lift the exception off the context across promise\ncreation (JS::AutoSaveExceptionState), then reject with it via the existing\nRejectPromiseWithPendingError, which preserves the captured stack.\n\nThe hook is only an allocation-observation hook that cannot alter the promise\nand requires an attached Debugger, so practical risk is low.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315363\n", "files": ["js/src/jit-test/tests/wasm/js-promise-integration/promising-sync-reject-onnewpromise.js", "js/src/wasm/WasmPI.cpp"], "git_node": "0c3db91aa3e94d899acf60c5472b739fc78a48c8", "git_parents": ["48d5ab5d64630e6c0f68a74fa7a555c3efa6838a"], "node": "f7658623bb2ec2c79d9f6adb72f1af6611a36bd5", "parents": ["8539be7b0dc41c48f6441a452d825716554cb8d1"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2063262 - Migrate the remaining credit card autofill related UI tests to the efficiency framework r=jajohnson\n\nBoth UI tests successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318717\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/CreditCardAutofillTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BrowserPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsAutofillSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/CreditCardAutofillTest.kt"], "git_node": "76372ab5a3e755fd63147a53a9b7d32766f535cf", "git_parents": ["0c3db91aa3e94d899acf60c5472b739fc78a48c8"], "node": "ed7fb56e69f4cb2272dc5ec2b5a958834cbee36f", "parents": ["f7658623bb2ec2c79d9f6adb72f1af6611a36bd5"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062637 - Pass in head_git_ref when cloning from Github, r=taskgraph-reviewers,releng-reviewers,bhearsum\n\nPassing in the head ref can make clone times faster.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317828\n", "files": ["taskcluster/docs/parameters.md", "taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/parameters.py", "taskcluster/gecko_taskgraph/transforms/job/common.py", "taskcluster/test/params/autoland-cron-android-l10n-import.yml", "taskcluster/test/params/autoland-cron-l10n-bumper.yml", "taskcluster/test/params/autoland-onpush-backstop.yml", "taskcluster/test/params/autoland-onpush.yml", "taskcluster/test/params/mb-cron-android-l10n-sync.yml", "taskcluster/test/params/mb-onpush.yml", "taskcluster/test/params/mb-promote-android.yml", "taskcluster/test/params/mb-promote-devedition-partials.yml", "taskcluster/test/params/mb-promote-devedition.yml", "taskcluster/test/params/mb-promote-firefox-partials.yml", "taskcluster/test/params/mb-promote-firefox.yml", "taskcluster/test/params/mb-push-android.yml", "taskcluster/test/params/mb-push-devedition.yml", "taskcluster/test/params/mb-push-firefox-partials.yml", "taskcluster/test/params/mb-push-firefox.yml", "taskcluster/test/params/mb-ship-android.yml", "taskcluster/test/params/mb-ship-devedition.yml", "taskcluster/test/params/mb-ship-firefox-partials.yml", "taskcluster/test/params/mb-ship-firefox.yml", "taskcluster/test/params/mb-to-release-merge-automation.yml", "taskcluster/test/params/mc-android-nightly.yml", "taskcluster/test/p