fxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging ee9f2b2aedc3c58347d66ca8d7b9f92ef1df3f53 with FIREFOX_140_14_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "669ce68a336aece070d05d187f2c4ddd8919b66b", "git_parents": ["68f678ef0f9963d73e019b1667331af61436e54b"], "node": "515205c91e216de5f3c9b9c427f34fe52b3237f0", "parents": ["2ba5fc26a431945c20d5a8fba4cc4d7a716240c4"], "tags": []}], "date": 1787055683, "git_changesets": ["669ce68a336aece070d05d187f2c4ddd8919b66b"], "user": "ffxbld@lando.moz.tools"}, "45117": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 5d7f4d5bc4ccf389b904e3d6b7d839075ffc0a00 with FIREFOX_115_39_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "a5a08b924b55ce909406c25baa7f3872759c4875", "git_parents": ["669ce68a336aece070d05d187f2c4ddd8919b66b"], "node": "5c77d1124aee7799fc34aa2206b5fb03ac2c2dbd", "parents": ["515205c91e216de5f3c9b9c427f34fe52b3237f0"], "tags": []}], "date": 1787055792, "git_changesets": ["a5a08b924b55ce909406c25baa7f3872759c4875"], "user": "ffxbld@lando.moz.tools"}, "45118": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging bdb74c45c2e1e3fe593fbf3c5ca6d2ab2046ef08 with FIREFOX_153_1_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "d5be31dd912f8d14fcc433d86fd56fb92e10c0e5", "git_parents": ["a5a08b924b55ce909406c25baa7f3872759c4875"], "node": "f8fda507c7c037caf2ce524036a42045c684d709", "parents": ["5c77d1124aee7799fc34aa2206b5fb03ac2c2dbd"], "tags": []}], "date": 1787056192, "git_changesets": ["d5be31dd912f8d14fcc433d86fd56fb92e10c0e5"], "user": "ffxbld@lando.moz.tools"}, "45119": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 9ce1ee6baeb9a3c326dbd180bdece65d8fc2eadc with FIREFOX_154_0_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "1d2d56c4d476fa7435d5828a0d77b03eb2c433e1", "git_parents": ["d5be31dd912f8d14fcc433d86fd56fb92e10c0e5"], "node": "7aced139b3f02ff82064152d94b05c6b8fb25729", "parents": ["f8fda507c7c037caf2ce524036a42045c684d709"], "tags": []}], "date": 1787056555, "git_changesets": ["1d2d56c4d476fa7435d5828a0d77b03eb2c433e1"], "user": "ffxbld@lando.moz.tools"}, "45120": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 71302855625d5bfc0352ff18192d1cd0c6d95553 with FIREFOX-ANDROID_154_0_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "255e8dbcceee161d36fb1a786c50fe0374002b8f", "git_parents": ["1d2d56c4d476fa7435d5828a0d77b03eb2c433e1"], "node": "395f822db1c0390d316ff493243717112be0fb2c", "parents": ["7aced139b3f02ff82064152d94b05c6b8fb25729"], "tags": []}], "date": 1787056618, "git_changesets": ["255e8dbcceee161d36fb1a786c50fe0374002b8f"], "user": "ffxbld@lando.moz.tools"}, "45121": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062486. Add a source-test job that verifies gfx/cairo reconstructs cleanly from upstream. r=ahal,taskgraph-reviewers\n\nWhen cairo-related files change, re-vendor gfx/cairo at the revision pinned in its\nmoz.yaml (`./mach vendor gfx/cairo/moz.yaml -r \u003crev\u003e --patch-mode check --force`)\nand fail if the result does not match what is committed -- catching changes to the\nvendored sources or patch files that were not re-vendored properly. Correctness\nrelies on the working tree being clean afterwards rather than mach vendor's\n(inverted) exit code, and the script emits TEST-UNEXPECTED-ERROR lines so the\nreason shows in the Treeherder failure summary rather than a bare \"exit status 1\".\n\nThis is a stepping stone to the next patch and chunks of this get removed or replaced in the next patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317700\n", "files": ["taskcluster/config.yml", "taskcluster/kinds/source-test/vendor.yml", "taskcluster/scripts/misc/verify-vendored-library.py"], "git_node": "b6eddd52b914947e8cdba48e51d8256598d09952", "git_parents": ["f9eecdfcaa0411cfb516a33e588649282057073a"], "node": "6bd29303337178318719556e732b11824edfa8f5", "parents": ["3f50d4c04fb08299ffaa5d9a831550364cb9d09b"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062486. Verify all moz.yaml-vendored libraries re-vendor cleanly in CI. r=ahal,taskgraph-reviewers,firefox-build-system-reviewers,sergesanspaille\n\nCover every vendored moz.yaml (one with a `vendoring:` section, non-rust) with a\nvendoring source-test job. taskcluster/kinds/source-test/vendor-verify.yml defines one task\nper function-based group, each listing the libraries it checks in `members`, plus a\n`coverage` task that turns the tree orange if a newly added vendored library is not in any\nof them.\n\nA transform in source_test.py builds each task's command and files-changed from its\n`members`, since neither can be expressed in the yaml: the command has to join the list,\nand the triggers need each library's moz.yaml read to find its vendor-directory, so a group\nonly runs when one of its own libraries changes.\n\nLibraries that do not re-vendor cleanly yet are annotated in\ntaskcluster/scripts/misc/vendor-verify-expected-fail.yml, alongside the script that reads\nit. Those are inverted: a failure is expected and green, and an unexpected pass turns the\njob orange so the annotation gets removed, after which the library is a hard requirement.\nThe script re-vendors each library in turn, restoring the whole working tree between\nlibraries, because some libraries write files outside their own vendor-directory.\n\nThe tasks run as code-review:False. Making them code-review:True would trip\nremove_optimization_on_central and run every group unconditionally on mozilla-central. With\nthe code-review bot off, the issues.json / vcs-diff artifacts it consumes are dead weight,\nso this drops that plumbing from the script and the task command; failures still surface\nthrough the TEST-UNEXPECTED-ERROR log lines.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317702\n", "files": ["taskcluster/config.yml", "taskcluster/gecko_taskgraph/transforms/source_test.py", "taskcluster/kinds/source-test/kind.yml", "taskcluster/kinds/source-test/vendor-verify.yml", "taskcluster/kinds/source-test/vendor.yml", "taskcluster/scripts/misc/check-vendor-coverage.py", "taskcluster/scripts/misc/vendor-verify-expected-fail.yml", "taskcluster/scripts/misc/verify-vendored-library.py"], "git_node": "7bd488ee806da4b4d7ac86d1613e1c8f767b8948", "git_parents": ["b6eddd52b914947e8cdba48e51d8256598d09952"], "node": "367ae7df437da3a59497307a26da482531d30738", "parents": ["6bd29303337178318719556e732b11824edfa8f5"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062862. Fetch the gn, node and rust toolchains for the vendoring verification jobs. r=ahal,taskgraph-reviewers\n\nSome libraries cannot be re-vendored without tooling the task image does not have.\ngfx/angle's update-actions run gn_processor, which needs gn, and\ndom/webgpu/tests/cts runs cargo, which in turn shells out to npm. Fetching gn also\nstops the build system from trying to bootstrap it at runtime, which fails in a task\nthat sets no UPLOAD_DIR.\n\nFetch these for every group rather than tracking which library needs which tool. The\nlibraries that need tooling are spread across most of the groups, so being selective\nbuys little, and only the group whose files changed actually runs. The coverage task\nis excluded because it only reads moz.yaml files, and it is the most frequently\ntriggered of them. That exclusion is done in the transform rather than the yaml,\nbecause fetches inherited from task-defaults merge additively, so neither `fetches: {}`\nnor an empty toolchain list clears them.\n\ngfx/angle, dom/webgpu/tests/cts and third_party/js/PKI.js all re-vendor cleanly\nwith this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318021\n", "files": ["taskcluster/gecko_taskgraph/transforms/source_test.py", "taskcluster/kinds/source-test/vendor-verify.yml"], "git_node": "2e67e2fc149be24000316469022ad784dec07961", "git_parents": ["7bd488ee806da4b4d7ac86d1613e1c8f767b8948"], "node": "4171a5236d67adb0f3ae11c8a510a459486ab780", "parents": ["367ae7df437da3a59497307a26da482531d30738"], "tags": []}, {"author": "Benjamin Peterson \u003cbenjamin@python.org\u003e", "branch": "default", "desc": "Bug 2064117 - Remove empty mozIAppServicesLogger.idl and mozIServicesLogSink.idl. r=markh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319165\n", "files": ["services/interfaces/mozIAppServicesLogger.idl", "services/interfaces/mozIServicesLogSink.idl"], "git_node": "3590d51e6a9d4fa3a11d24e53de076c8869a602f", "git_parents": ["2e67e2fc149be24000316469022ad784dec07961"], "node": "dfe3b9303aeacd44d0ad8c5ad6e7bef0e10bd465", "parents": ["4171a5236d67adb0f3ae11c8a510a459486ab780"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1991126 - Null-check streamErrorCode before unwrapping in BuildErrorStatus r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318890\n", "files": ["dom/streams/UnderlyingSinkCallbackHelpers.cpp", "dom/streams/gtest/TestUnderlyingSinkCallbackHelpers.cpp"], "git_node": "ff8392875c461e0744e750134a0ae1a68cff0280", "git_parents": ["3590d51e6a9d4fa3a11d24e53de076c8869a602f"], "node": "5c358047f034eaa76819a037bbe569ee4faa2fbc", "parents": ["dfe3b9303aeacd44d0ad8c5ad6e7bef0e10bd465"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063739 - Assign rather than OR the flags word in CacheIndexEntryUpdate::ApplyUpdate r=necko-reviewers,valentin\n\nCacheIndexRecord::mFlags packs the entry's file size in kB into its low 23 bits\nalongside nine boolean flags, so merging an update into it with |= is wrong in\nboth directions, and the two branches get it wrong in opposite ways.\n\nThe kFileSizeUpdated branch ORs the whole word, so it ORs the two file sizes\ntogether instead of replacing: a destination of 5kB merged with an update of 3kB\nyields 7kB. That value feeds CacheIndexStats::mSize and mSizeByType, so it\ncorrupts the reported cache size and the over-limit eviction threshold. Being a\npure OR it also cannot clear any flag, so an update applied to an entry marked\nremoved leaves kRemovedMask set - the entry stays invisible to\nCacheIndexEntryAutoManage::FindEntry() and is silently lost at the next index\nwrite. That is also one mechanism for the bookkeeping desync in bug 2063744.\n\nThe other branch masks the destination down to kFileSizeMask, which clears\nkHasAltDataMask along with everything else, so the toggle immediately above it is\ndiscarded and the alt-data bit is always lost.\n\nExpress both cases as one assignment: keep the destination's alt-data bit, which\nthe toggle has already set correctly, keep its file size only when the update\ndoes not carry one, and take every other bit from the update.\n\nThe three added tests were negative-controlled against the original code, where\nthey fail with exactly the predicted values: 7 for a 5kB entry updated to 3kB, 15\nfor a 7kB entry updated to 9kB, and kRemovedMask still set.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318856\n", "files": ["netwerk/cache2/CacheIndex.h", "netwerk/test/gtest/TestCacheIndex.cpp"], "git_node": "5466b0d413878c7ded70adb200ad849d3ad30b97", "git_parents": ["ff8392875c461e0744e750134a0ae1a68cff0280"], "node": "ca3295a0d8d2159b97e841af01e677c91dc33a76", "parents": ["5c358047f034eaa76819a037bbe569ee4faa2fbc"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2062673 - Only clamp the raster scale of perspective surfaces to a minimum of one r=gfx-reviewers,lsalzman\n\ncoplanar_scale_factors() also succeeds for a non-perspective mapping, so the\nclamp from bug 2060361 applied to every nested surface, growing the raster\narea of any that was minified. Keep the exact, unclamped scale factors off\nthe perspective path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318263\n", "files": ["gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/spatial_tree.rs"], "git_node": "45a592a5dce6d84088d73e9320f2693c0b6ada55", "git_parents": ["5466b0d413878c7ded70adb200ad849d3ad30b97"], "node": "5ccfd87f26e2ac96b393515d8c01c16dd0a3ded4", "parents": ["ca3295a0d8d2159b97e841af01e677c91dc33a76"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063207 - Hide the Privacy widget on profiles that record no history, and show the zero state when no sites were visited. r=nina-py\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319290\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/content-src/components/Widgets/Privacy/_Privacy.scss", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/PrivacyFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/PrivacyMessages.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Privacy.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/Widgets/PrivacyMessages.test.js", "browser/extensions/newtab/test/unit/lib/PrefsFeed.test.js", "browser/extensions/newtab/test/xpcshell/test_PrivacyFeed.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "b4230e7ab14b2c83a2231f595ccfa8149e8c11ff", "git_parents": ["45a592a5dce6d84088d73e9320f2693c0b6ada55"], "node": "53e3421d50c99a21a29d1eda7d5ab4bbd90c3b4e", "parents": ["5ccfd87f26e2ac96b393515d8c01c16dd0a3ded4"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056379 - Add discription to unavailable locations r=android-reviewers,android-l10n-reviewers,gmalekpour,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318513\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocations.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "27918d3fb62350da829d33a9262c4566ba38adf7", "git_parents": ["b4230e7ab14b2c83a2231f595ccfa8149e8c11ff"], "node": "dd8feef8b8784ecee9bab7df028aa5f00de90663", "parents": ["53e3421d50c99a21a29d1eda7d5ab4bbd90c3b4e"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2064290. Add mozglue/misc/decimal/moz.yaml to vendor verify job.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319381\n", "files": ["taskcluster/kinds/source-test/vendor-verify.yml"], "git_node": "e529163190749e7a0829b0dc2343faaffbdf619b", "git_parents": ["27918d3fb62350da829d33a9262c4566ba38adf7"], "node": "5983194d8e40c93e05e56b1461782e1e0728a54c", "parents": ["dd8feef8b8784ecee9bab7df028aa5f00de90663"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2034838 Make MediaEncoder::RemoveMediaStreamTrack() private r=media-playback-reviewers,padenot\n\nThe public API is Stop()/Cancel()/DisconnectTracks().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318656\n", "files": ["dom/media/encoder/MediaEncoder.h"], "git_node": "ddabbba33ab34b9fb2000976f45a4d27a6dfab21", "git_parents": ["e529163190749e7a0829b0dc2343faaffbdf619b"], "node": "bf35e954f93e19504dd5b7c13b874144da7fd934", "parents": ["5983194d8e40c93e05e56b1461782e1e0728a54c"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2034838 Remove unused AudioTrackListener direct listener methods r=media-playback-reviewers,padenot\n\nThe listener was not being added as a direct listener\nand had no NotifyRealtimeTrackData() method.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318657\n", "files": ["dom/media/encoder/MediaEncoder.cpp"], "git_node": "1796393847e005ef07f3601bf3546c47ecfcf03e", "git_parents": ["ddabbba33ab34b9fb2000976f45a4d27a6dfab21"], "node": "861ea6396a583b483cab0968044a004b811ae6a0", "parents": ["bf35e954f93e19504dd5b7c13b874144da7fd934"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2034838 Update incorrect DirectMediaTrackListener comment to indicate usage with video tracks r=pehrsons\n\nAt least MediaEncoder, PipelineListener, and VideoOutput use\nDirectMediaTrackListener with video tracks.\nAlso CaptureTask, which is not enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318658\n", "files": ["dom/media/MediaTrackListener.h"], "git_node": "f89a7da35830ed64e3b534cd9252690837f125a4", "git_parents": ["1796393847e005ef07f3601bf3546c47ecfcf03e"], "node": "68d56f4bde9d6de69c142cee183690ffe3495ed7", "parents": ["861ea6396a583b483cab0968044a004b811ae6a0"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2034838 Make DirectMediaTrackListener::NotifyRealtimeTrackData() pure virtual r=pehrsons\n\nA client that uses only the installed/uninstalled methods seems unlikely.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318659\n", "files": ["dom/media/MediaTrackListener.h"], "git_node": "8be80d968461428201016c538c332854714d3b86", "git_parents": ["f89a7da35830ed64e3b534cd9252690837f125a4"], "node": "38c124a618ceb23fca45b00c8997ef1ec32593fd", "parents": ["68d56f4bde9d6de69c142cee183690ffe3495ed7"], "tags": []}, {"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2054624 - WebRTC backport: Video capture: cap resolution and null-check header metadata r=pehrsons\n\nReject video dimensions that could overflow frame size calculations.\nHandle missing SPA_META_Header which is optional.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: 01455efea7797cff42c5228b14c85ab3cdb4bdac\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319163\n", "files": ["third_party/libwebrtc/modules/video_capture/linux/video_capture_pipewire.cc", "third_party/libwebrtc/moz-patch-stack/01455efea7.no-op-cherry-pick-msg"], "git_node": "31d48f71c8edf109a7a4cbb26b0d428857ec43f9", "git_parents": ["8be80d968461428201016c538c332854714d3b86"], "node": "582ab1bf7371ba83dfa2ed7d186a22ef744aaf2e", "parents": ["38c124a618ceb23fca45b00c8997ef1ec32593fd"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2061292 - Ensure scrolled content is in the same doc. r=layout-reviewers,hiro\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319156\n", "files": ["layout/base/PresShell.cpp", "testing/web-platform/tests/css/css-contain/content-visibility/crashtests/scroll-into-view-target-moved-to-other-document.html"], "git_node": "73031977237731361982ee6ba8a3ac85ed1ebfd3", "git_parents": ["31d48f71c8edf109a7a4cbb26b0d428857ec43f9"], "node": "85d4f06329e04aa1bc10791300846924842cc203", "parents": ["582ab1bf7371ba83dfa2ed7d186a22ef744aaf2e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062572 - Wait for the doorhanger panel to be open in waitForDoorhanger, r=credential-management-reviewers,mtigley.\n\nWaiting for the popup to be open before interacting with its contents. Its\ncontents are invisible to the accessibility APIs and not focusable before that,\nwhich is the intermittent \"Node is not focusable via the accessibility API\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318041\n", "files": ["toolkit/components/passwordmgr/test/browser/head.js"], "git_node": "f53a36dcef5e12639e1e6be939d1785aa2da9360", "git_parents": ["73031977237731361982ee6ba8a3ac85ed1ebfd3"], "node": "b6449cd0111da79838dbc13ddf2fc7fecb224702", "parents": ["85d4f06329e04aa1bc10791300846924842cc203"], "tags": []}, {"author": "Sebastian Zartner \u003csebastianzartner@gmail.com\u003e", "branch": "default", "desc": "Bug 2063851 - [devtools] Updated documentation of Rules View to include Emulation Panel. r=nchevobbe,devtools-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318910\n", "files": ["devtools/docs/user/landingpage_pageinspector.png", "devtools/docs/user/page_inspector/how_to/examine_and_edit_css/add_rule_button.png", "devtools/docs/user/page_inspector/how_to/examine_and_edit_css/emulation_panel.png", "devtools/docs/user/page_inspector/how_to/examine_and_edit_css/index.md", "devtools/docs/user/page_inspector/how_to/examine_and_edit_css/rules_panel.png", "devtools/docs/user/page_inspector/how_to/examine_and_edit_css/rules_view.png", "devtools/docs/user/page_inspector/how_to/examine_and_edit_css/rules_view_buttons.png", "devtools/docs/user/page_inspector/how_to/examine_and_edit_css/rules_view_buttons_fx_72.png", "devtools/docs/user/page_inspector/how_to/examine_and_edit_css/rules_view_ff_87.png"], "git_node": "19977f3e537516206d4ab07da1b8db95f4d49152", "git_parents": ["f53a36dcef5e12639e1e6be939d1785aa2da9360"], "node": "5f5f5b28eec12dec78b07151b28cc8b9c545b3a3", "parents": ["b6449cd0111da79838dbc13ddf2fc7fecb224702"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2034838 Delay track listener creation until they can be added to their track r=pehrsons,media-playback-reviewers,padenot\n\nThis means that the listener \u003c-\u003e encoder strong reference cycle is not created\nuntil the listener is registered for NotifyRemoved() to break the cycle and\nresolve mShutdownPromise.\n\nmAudioListener and mVideoListener are not reset because the lambda of\nVideoTrackListener::NotifyQueuedChanges() can later dereference\nmVideoListener.  That already implied that a single listener cannot be used on\nmore than one track (serially).  The same was also implied by NotifyRemoved()\nresolving a single shutdown promise for each listener.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318660\n", "files": ["dom/media/encoder/MediaEncoder.cpp", "dom/media/encoder/MediaEncoder.h"], "git_node": "9d4a5b3c9a15e832e2137293cb31153287c33b13", "git_parents": ["19977f3e537516206d4ab07da1b8db95f4d49152"], "node": "92134f3b10da84a284ca4ec7ff76db0672c44fc1", "parents": ["5f5f5b28eec12dec78b07151b28cc8b9c545b3a3"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2034838 Remove unused aTrackRate parameter for MediaEncoder constructor r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318661\n", "files": ["dom/media/encoder/MediaEncoder.cpp", "dom/media/encoder/MediaEncoder.h"], "git_node": "bcf601e37aa684ee1025efdd1d4bbba5460e6e61", "git_parents": ["9d4a5b3c9a15e832e2137293cb31153287c33b13"], "node": "bde06c57c733b0ce65ce899c9ed179fd7f7094c8", "parents": ["92134f3b10da84a284ca4ec7ff76db0672c44fc1"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2034838: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/media/encoder/MediaEncoder.cpp"], "git_node": "ae11e81554f02c7b82ae7af96ea33a2d6f76dc69", "git_parents": ["bcf601e37aa684ee1025efdd1d4bbba5460e6e61"], "node": "f0ce6a0738fa43864e9009c06928ff6a19fa74d9", "parents": ["bde06c57c733b0ce65ce899c9ed