it_parents": ["de1b5358cdc62a6be9609d086fb77fe42fb478b5"], "node": "e302b9a94fd7430d9da9e8e9429e4a9aa8b053db", "parents": ["a79fa42b9e7a745d9005dc16f90b6b418be771f3"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2015828 - Refactor selection code out of DirectionalityUtils Slot methods. r=jjaschke,dom-core-reviewers,keithamus\" for causing process crashes.\n\nThis reverts commit 1f72d25f77c57f51ba0582af23c6d8edaacb174f.\n\nRevert \"Bug 2015828 - Update directionality when slot assigned nodes are cleared. r=jjaschke,keithamus,dom-core-reviewers,smaug\"\n\nThis reverts commit 4a51125558ab565ca87b63701746c3b9aa6f418a.\n", "files": ["dom/base/AbstractRange.h", "dom/base/DirectionalityUtils.cpp", "dom/base/DirectionalityUtils.h", "dom/html/HTMLSlotElement.cpp", "dom/html/HTMLSlotElement.h", "testing/web-platform/tests/html/dom/elements/global-attributes/dir-shadow-utils.js", "testing/web-platform/tests/html/dom/elements/global-attributes/dir-slots-directionality.html"], "git_node": "68293ee7b08631d8919028fdea8b7ccffa5a97cc", "git_parents": ["64ce0a0adfcb31069d0ae7e835acfb8d7fdf7c0d"], "node": "caf3d4eed37a99fffb937ee901f6fc9776e6c283", "parents": ["e302b9a94fd7430d9da9e8e9429e4a9aa8b053db"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054645 - Restrict DMABuf import to hardware GL rendering. r=stransky,gtk-reviewers,Thinker\n\nDMABuf surfaces are only used with hardware GL rendering. Do not import\na DMABuf surface into a GL texture when software rendering is in use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313682\n", "files": ["widget/gtk/DMABufSurface.cpp"], "git_node": "ddc79cd6d4bda2d14c07bd0d682722f691f6b287", "git_parents": ["68293ee7b08631d8919028fdea8b7ccffa5a97cc"], "node": "48d4a5101a1277898b3ff4c2d8370992a9d71256", "parents": ["caf3d4eed37a99fffb937ee901f6fc9776e6c283"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064369 - Show the macOS services menu in the chrome text context menu. r=daleharvey\n\nmoz-input-box's popup already sets this, so the address bar has the services submenu while every input served by this popup doesn't.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319494\n", "files": ["toolkit/content/editMenuOverlay.js"], "git_node": "02bd6717f8dc03f5434ba88168cc99d55b48056f", "git_parents": ["ddc79cd6d4bda2d14c07bd0d682722f691f6b287"], "node": "8a07eb08a0ea8ba882be9049951e941e19a055d9", "parents": ["48d4a5101a1277898b3ff4c2d8370992a9d71256"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065501 - Start the nightly 156 development cycle. r=android-reviewers,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320440\n", "files": ["mobile/android/android-components/components/feature/search/src/main/assets/search/search_telemetry_v2.json", "mobile/android/android-components/docs/changelog.md"], "git_node": "5525f18ec0015eaf3cb0c16c3cc9e1cf98ffebcf", "git_parents": ["02bd6717f8dc03f5434ba88168cc99d55b48056f"], "node": "53cb6a04122aeab06fb906cc29ecb7d7959a2dd5", "parents": ["8a07eb08a0ea8ba882be9049951e941e19a055d9"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2065069 - Open the Library's context menu before activating an item in browser_library_telemetry.js, r=places-reviewers,daisuke.\n\nThe test looked its menu items up with document.getElementById, which resolves\nin the browser window rather than in the Library.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320294\n", "files": ["browser/components/places/tests/browser/browser_library_telemetry.js"], "git_node": "93f4ac28f8dfa78d753dd2d1d3fedfb9f9f0f824", "git_parents": ["5525f18ec0015eaf3cb0c16c3cc9e1cf98ffebcf"], "node": "023297980d2a785d3bf9876e9b3e0359cc3cfde8", "parents": ["53cb6a04122aeab06fb906cc29ecb7d7959a2dd5"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2032977 - Use synthesizeClickOnSelectedTreeCell to open the context menu in browser_forgetthissite.js, r=places-reviewers,daisuke.\n\nThe hand-rolled coordinates are computed before the freshly opened Library\nwindow's tree has a non-zero width, so the right-click misses the tree and the\ncontext menu never opens. Bug 2029541 added that wait to the shared helper.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320348\n", "files": ["browser/components/places/tests/browser/browser_forgetthissite.js"], "git_node": "22598deb7560ad7baef8c8f5082dcfc1e92efd54", "git_parents": ["93f4ac28f8dfa78d753dd2d1d3fedfb9f9f0f824"], "node": "ebbc8065667b64de4786095ba78e58da9d2a4a60", "parents": ["023297980d2a785d3bf9876e9b3e0359cc3cfde8"], "tags": []}], "date": 1787348243, "git_changesets": ["3b5584d435a66fd52324d9994a75a44dbc1f29d8", "d10134975f8fc503add0ca84a2ab873bd5755cb6", "78a90b63dff7e39c3865c6a63ce4b0f072972f68", "eacc117f3f45133dc3976bfbf5aff2ffaa870255", "d745a7782fbeb97be009a49698f48bf6e6b608dc", "d75db545a2d6c8256bf5aeeaee04c026bf33f74d", "a4b451e58d54f844119908a346a26f770b168b5a", "e6fa743cf560e57f2b1dd49868e0476c5bcffa1f", "2e2af16af65a39341734f6e8d4e55556e4918099", "f9883a5d01b8e928ecec5e3800809da7f1098d4c", "14cea8d18b7c8ed7ac944f9caa9deadf44e2fe7b", "922be3dfe6a4c9c0995deb448419249f606faef6", "bdcf4362363e479956f8196b522ca442c0cd093c", "02f9fd970cad7becb20458896d7608824d657c3c", "4a3c2eaad8a29b01223903f349d026e58e9b5eaf", "3257cd2fdb31fa80cb159e0a8e318c64a6041e56", "05351559d994a57be196ecb8563ec1c13ef98274", "05e1580f99ea25b9c60d49609a4a59a4bcc3b1cc", "d2407e1e7763dfbd504e04658b3eb71c085d2096", "54fe51ebb17dded21d8e85e72c7e9b4214552c36", "20435ce479617e3c88b631b561dde686797a2c8c", "2b1fcbf5fca9ffb95acdc7766833f93aeee35c21", "079a730afd38389e68468048d7456afc865796f6", "4786bfed601bf96191bfc95f08f2eb9134454fed", "8c7f6a3b2a6f2a30b150cceb23e6d262e3ab2ead", "1d142ed760fe5f835fed8d89dcd8905ca97141ac", "6f1a348e95a4accc0825a016600c9fd3d8f92547", "99ca36ffcb7fd3e02678cae000aa0ff4b2ff0e69", "26241d6989d7d9c539c50ff05b7dfccde9c1e31e", "1aaa68e21bac97aafec4bb742865975b265abc5c", "f394de524959d3ca5e8440cb523ba1d2c08c01bc", "360318a79763b046db69d2668210f57a22b0bae0", "4a51125558ab565ca87b63701746c3b9aa6f418a", "1f72d25f77c57f51ba0582af23c6d8edaacb174f", "ffc36a58584a7919922cde8fdf0d943e0de418cf", "01ec240a85b5950f0f87a7b428732bdff2796217", "0ea83da1cdd3ddd49b6f5abb17346a23a5678d60", "2d8cd11a584a260626c273abae1fc54db72cd268", "de1b5358cdc62a6be9609d086fb77fe42fb478b5", "64ce0a0adfcb31069d0ae7e835acfb8d7fdf7c0d", "68293ee7b08631d8919028fdea8b7ccffa5a97cc", "ddc79cd6d4bda2d14c07bd0d682722f691f6b287", "02bd6717f8dc03f5434ba88168cc99d55b48056f", "5525f18ec0015eaf3cb0c16c3cc9e1cf98ffebcf", "93f4ac28f8dfa78d753dd2d1d3fedfb9f9f0f824", "22598deb7560ad7baef8c8f5082dcfc1e92efd54"], "user": "pstanciu@mozilla.com"}, "45148": {"changesets": [{"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054929 - additional usecounters for Sanitizer entry points r=emilio,webidl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320439\n", "files": ["dom/base/UseCounters.conf", "dom/base/test/browser_use_counters.js", "dom/base/use_counter_metrics.yaml", "dom/webidl/Document.webidl", "dom/webidl/Element.webidl", "dom/webidl/ShadowRoot.webidl"], "git_node": "2891790e3ebc19f7a0e96cacdd0f67df06d72e9b", "git_parents": ["22598deb7560ad7baef8c8f5082dcfc1e92efd54"], "node": "05906cb6faa2fd297435686ba5e7f1f0434cdc84", "parents": ["ebbc8065667b64de4786095ba78e58da9d2a4a60"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 1655525 - Show a fallback for embedded PDFs when PDF.js is disabled. r=fluent-reviewers,bolsson,farre\n\nWhen PDF.js is disabled, 'object' and 'embed' loads cannot invoke the configured PDF handler, so the element only renders its own fallback content and the PDF is silently dropped.\nRegister a dedicated PdfEmbedFallbackStreamConverter for those loads. It serves a script-free resource://pdf.js page for TYPE_OBJECT requests and cancels the unused PDF download once that page has loaded, or as soon as the frame is torn down if that happens first.\nActivating its button sends a request to PdfEmbedFallbackParent, which reloads the fallback document's PDF URI in its browsing context. The parent takes the URI from the fallback's WindowGlobalParent and the triggering principal from the embedder's WindowGlobalParent; the stream converter forwards only the original request's referrer. The parent must start the load because the fallback is served on the PDF's own channel, so site isolation displays it in the PDF site's process, which cannot use the embedder's principal to initiate the load. The reload arrives as TYPE_SUBDOCUMENT, which the fallback converter declines, so the PDF goes through the usual handler selection.\nThat selection cannot honor \"Open in Firefox\", which is the action stored for PDFs by default and the one the viewer restores whenever it runs: nsExternalAppHandler treats nsIMIMEInfo::handleInternally as an action it knows how to perform, so it does not ask the user, and nsIMIMEInfo::LaunchWithFile then has no application to launch, leaving a local PDF on the launch error path. Ask the user what to do instead when a PDF would be handled internally while the viewer is disabled. Top-level loads reach the same dead end, so they are fixed as well.\nBecause the stream converter contract is now creatable while the viewer is disabled, nsContentUtils::IsPDFJSEnabled() reads the pdfjs.disabled pref instead of trying to create a converter, and PDF is treated as a document for object/embed when either the viewer or the fallback is enabled. Both converters now reject a missing channel explicitly, since they cannot decide how the PDF must be handled without one.\nTreating it as a document also overrides the fallback content the author provided: an 'object' with a PDF and its own children now shows this page instead of them. The trade-off is deliberate: that content is meant for browsers which cannot open the PDF at all, while this page still offers to. Setting pdfjs.embedFallback to false restores it.\nThe whole feature is gated on pdfjs.embedFallback, mirrored to StaticPrefs since nsContentUtils reads it as well. The page is built on the in-content design system, which is desktop-only, so the pref defaults to false on Android, where neither the converter nor the actor is registered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316050\n", "files": ["dom/base/nsContentUtils.cpp", "modules/libpref/init/StaticPrefList.yaml", "toolkit/components/pdfjs/content/PdfEmbedFallbackParent.sys.mjs", "toolkit/components/pdfjs/content/PdfEmbedFallbackStreamConverter.sys.mjs", "toolkit/components/pdfjs/content/PdfStreamConverter.sys.mjs", "toolkit/components/pdfjs/content/embedFallback.css", "toolkit/components/pdfjs/content/embedFallback.html", "toolkit/components/pdfjs/jar.mn", "toolkit/components/pdfjs/pdfjs.sys.mjs", "toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_disabled_handle_internally.js", "toolkit/components/pdfjs/test/browser_pdfjs_embed_fallback.js", "toolkit/components/pdfjs/test/file_pdfjs_embed.html", "toolkit/components/pdfjs/test/file_pdfjs_embed_cross_site.html", "toolkit/components/pdfjs/test/file_pdfjs_embed_referrer.html", "toolkit/components/pdfjs/test/file_pdfjs_embed_short.html", "toolkit/components/pdfjs/test/file_pdfjs_embed_slow.html", "toolkit/components/pdfjs/test/file_pdfjs_referrer.sjs", "toolkit/components/pdfjs/test/file_pdfjs_slow.sjs", "toolkit/components/pdfjs/test/test_pdf_file_in_object.html", "toolkit/locales/en-US/toolkit/pdfviewer/embedFallback.ftl", "toolkit/modules/ActorManagerParent.sys.mjs", "uriloader/exthandler/nsExternalHelperAppService.cpp"], "git_node": "55f52ae46f696e7f5e5e4c15baa65cf8b02c452e", "git_parents": ["2891790e3ebc19f7a0e96cacdd0f67df06d72e9b"], "node": "537b54553796458987f8696ead3239797f51ebdd", "parents": ["05906cb6faa2fd297435686ba5e7f1f0434cdc84"], "tags": []}, {"author": "Jens Manuel Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054250 - Initialize SMTC event tokens and register events before updating buttons so media keys register reliably on Windows. r=win-reviewers,gstoll\n\nWindowsSMTCProvider::mButtonPressedToken and mSeekRegistrationToken were declared without an initializer, so EventRegistrationToken::value was indeterminate at construction. EnableKey(Seekto) gates the SeekTo control on `mSeekRegistrationToken.value != 0`, and Open() called UpdateButtons() (which invokes EnableKey(Seekto)) before RegisterEvents() populated the token. When the uninitialized memory happened to be 0, UpdateButtons() failed, Open() returned false, and the whole SMTC provider failed to register, so no media keys worked until restart. This matches the reporter's diagnosis.\n\nFix:\n- Value-initialize both tokens to zero in the header, so `.value` is never read while indeterminate (EnableKey(Seekto) and UnregisterEvents() both treat a zero token as \"not registered\").\n- Reorder Open() to call RegisterEvents() before UpdateButtons(), so EnableKey(Seekto) observes the valid token set by add_PlaybackPositionChangeRequested(). RegisterEvents() only depends on mControls (from InitDisplayAndControls()), so the reorder is safe.\n\nZero-init alone would be insufficient: with the token zeroed, EnableKey(Seekto) before RegisterEvents() would return 0 != 0 == false every time and Open() would fail deterministically. Both changes are needed together.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315230\n", "files": ["widget/windows/WindowsSMTCProvider.cpp", "widget/windows/WindowsSMTCProvider.h"], "git_node": "7ae622ea047abf66147f6c729fbf15d20c622607", "git_parents": ["55f52ae46f696e7f5e5e4c15baa65cf8b02c452e"], "node": "91732d821f9ea5818e7c22dd5dc01871801ccb63", "parents": ["537b54553796458987f8696ead3239797f51ebdd"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059196 - Set the ongoing navigation to the navigation ID also for javascript: URLs. r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320058\n", "files": ["docshell/base/nsDocShell.cpp", "testing/web-platform/tests/navigation-api/precommit-handler/precommitHandler-javascript-url-before-commit.html"], "git_node": "5f6d0d470030ec8f2b94b977ab88f3d594335e2e", "git_parents": ["7ae622ea047abf66147f6c729fbf15d20c622607"], "node": "92b7c2bd11d1f30563edb4f788d7ba66f2f0ee97", "parents": ["91732d821f9ea5818e7c22dd5dc01871801ccb63"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055837 - mozinfo: derive apple_silicon from the target processor. r=sergesanspaille\n\napple_silicon was computed from platform.uname().processor of the harness\ninterpreter, so it was wrongly False when tests run under a fetched x86_64\npython on Apple silicon (breaking every fuzzy-if(appleSilicon,...) reftest\nannotation on those workers).  Derive it from the (merged) target processor\ninstead, and recompute it in sanitize() so build mozinfo.json updates it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320373\n", "files": ["testing/mozbase/mozinfo/mozinfo/mozinfo.py", "testing/mozbase/mozinfo/tests/test.py"], "git_node": "308ae3ea26727b0161581cc5824204f8692c2d76", "git_parents": ["5f6d0d470030ec8f2b94b977ab88f3d594335e2e"], "node": "4b7ac64c73d2e54f8ce412bc41e14ffa2ba6a779", "parents": ["92b7c2bd11d1f30563edb4f788d7ba66f2f0ee97"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 1995237 - Copy Clean Link: Expand wprov parameter to all MediaWiki sites r=manuel\n\nReplace the per-subdomain wikipedia.org/wikimedia.org/mediawiki.org origins\nwith schemelessSites entries so wprov is stripped on every language edition\nand sister site, not just the hardcoded ones.\n\nAlso drop a leftover debug printf_stderr in OnStripOnShareUpdate that would\notherwise start firing now that the list actually contains schemeless rules.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320431\n", "files": ["toolkit/components/antitracking/StripOnShareLists/MPL2/StripOnShare.json", "toolkit/components/antitracking/URLQueryStringStripper.cpp"], "git_node": "91cf4d6febbd1350be4c328d1eb255b44b45cfbb", "git_parents": ["308ae3ea26727b0161581cc5824204f8692c2d76"], "node": "c8363167cb7e7450a9e01252830b665e186d87f3", "parents": ["4b7ac64c73d2e54f8ce412bc41e14ffa2ba6a779"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2065138 - Honor checkDefaultBrowser pref for campaign set default actions r=omc-reviewers,mviar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320232\n", "files": ["browser/components/aboutwelcome/actors/AboutWelcomeParent.sys.mjs", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_campaign_actions.js"], "git_node": "cb8819b6b6168d1a915bd32b70c99f750f79a390", "git_parents": ["91cf4d6febbd1350be4c328d1eb255b44b45cfbb"], "node": "c18a404c06a5ebbbc1d98dcab277e27219ed1879", "parents": ["c8363167cb7e7450a9e01252830b665e186d87f3"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2065138 - Enforce setDefaultBrowser policy in ShellService r=nalexander\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320233\n", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_default_browser_setting.js", "browser/components/shell/ShellService.sys.mjs"], "git_node": "579d85cd16005841eb2a0216377a5118dadf177d", "git_parents": ["cb8819b6b6168d1a915bd32b70c99f750f79a390"], "node": "0de1c7cb1036c8e0196a7d9d3e86af44b6e632e2", "parents": ["c18a404c06a5ebbbc1d98dcab277e27219ed1879"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059205 - Use the origin of the final URL for EventSource message events. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320456\n", "files": ["dom/base/EventSource.cpp", "testing/web-platform/tests/eventsource/eventsource-cross-origin-redirect-origin.any.js"], "git_node": "7e7e9f9c1a4b3d66b83711141cdb5f8973fed958", "git_parents": ["579d85cd16005841eb2a0216377a5118dadf177d"], "node": "1c6ff539cbc470627e9bd2d3ee3835b19369e7ff", "parents": ["0de1c7cb1036c8e0196a7d9d3e86af44b6e632e2"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2065182 - Update Mozsearch Clang plugin with Clang 23 build fix. r=asuth\n\nThis brings in https://github.com/mozsearch/mozsearch/pull/1131.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320151\n", "files": ["build/clang-plugin/mozsearch-plugin/MozsearchIndexer.cpp"], "git_node": "ca9f49c4f960b9d84d98d38bd2d60de6d4b63cdd", "git_parents": ["7e7e9f9c1a4b3d66b83711141cdb5f8973fed958"], "node": "bbf53f59a750faae74a3cfdce7c38af3e40568f1", "parents": ["1c6ff539cbc470627e9bd2d3ee3835b19369e7ff"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064358 - Allow font style & group caches to coexist. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320359\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp"], "git_node": "19a34a75531d10e89247f8b2189e266973d3b270", "git_parents": ["ca9f49c4f960b9d84d98d38bd2d60de6d4b63cdd"], "node": "7efd58a4e281c6836799ecad23ff4f5f278daa2d", "parents": ["bbf53f59a750fa