ge existing public annotations to ping scope r=gsvelto\"\n\nThis reverts commit cf1c0831dbdc0aec3a6404eec577ddaaba9153c5.\n", "files": ["mobile/android/android-components/components/lib/crash/src/androidTest/java/mozilla/components/lib/crash/service/GleanCrashReporterServiceTest.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/Crash.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/service/GleanCrashReporterService.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/service/MozillaSocorroService.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/service/MozillaSocorroServiceTest.kt", "toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/crashping/src/lib.rs", "toolkit/crashreporter/nsExceptionHandler.cpp", "toolkit/crashreporter/nsExceptionHandler.h", "toolkit/crashreporter/test/browser/browser_required_annotations.js", "toolkit/xre/nsAppRunner.cpp", "xpcom/base/nsSystemInfo.cpp"], "git_node": "f98e788379028d46cc2942a344c85278b101dc7a", "git_parents": ["edd370e2373d3df3e5adec58492e8fe2cfa96f45"], "node": "24ca9ba66a52d4ab62fd6dcb7c89f80818b5ba2a", "parents": ["880b0d4b5b439ea1dcef741cfd8e8a2dea8f7194"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052270 - Add telemetry for url bar share button. r=jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319620\n", "files": ["browser/components/sharing/SharePageAction.sys.mjs", "browser/components/sharing/metrics.yaml", "browser/components/sharing/tests/browser/browser.toml", "browser/components/sharing/tests/browser/browser_testSharePanelQRCode.js", "browser/components/sharing/tests/browser/browser_testSharePanelScreenshot.js", "browser/components/sharing/tests/browser/browser_testSharePanelSendToDevice.js", "browser/components/sharing/tests/browser/browser_testSharePanelTelemetry.js", "browser/components/sharing/tests/browser/head.js"], "git_node": "f99ed07255d063796bb401f150f241efa2440c3f", "git_parents": ["f98e788379028d46cc2942a344c85278b101dc7a"], "node": "1c1bfbb279ef4a2fba3e3198aac0a63709560a5f", "parents": ["24ca9ba66a52d4ab62fd6dcb7c89f80818b5ba2a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2066502 - Avoid un-throttling animations from reflow callbacks. r=layout-reviewers,boris\n\nThis saves some work that we don't need, specially if we're already\ndoing an interruptible reflow.\n\nThe original flush should've done that if required.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321303\n", "files": ["layout/base/PresShell.cpp"], "git_node": "842b8109572e4554db80e98e6563fd42525027a1", "git_parents": ["f99ed07255d063796bb401f150f241efa2440c3f"], "node": "ff8acd005c7edd1e8e2d792b0d1c2ae192962744", "parents": ["1c1bfbb279ef4a2fba3e3198aac0a63709560a5f"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045109 - Add an aarch64 macOS config to mozperftest. r=aglavic,mozperftest-reviewers\n\nAll of our macOS mozperftest tests have been running on the really old\nmacOS 10.15 in CI. It probably was missed for the 14.7 upgrade a little\nbit ago (which is also x64). But we are moving entirely to aarch64 macOS\nso we might as well skip 10.15-\u003e14.7 and go straight to 10.15\n\n10.15 will run for 2 additional weeks before fully porting over, just\nuntil we have enough arm64 data for regression detection, the 10.15 will\nserve as a stopgap.\n\nThis patch also updates the config to use system python as previously\nthe 3.9.x toolchain was being pulled in and causing rosetta related\nfailures in some of the ML tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321068\n", "files": ["python/mozperftest/mozperftest/mach_commands.py", "taskcluster/kinds/perftest/kind.yml", "taskcluster/kinds/perftest/macosx-aarch64.yml", "taskcluster/kinds/source-test/python.yml"], "git_node": "3fa26cea51ff17a3474a4cc251ec1862de69e266", "git_parents": ["842b8109572e4554db80e98e6563fd42525027a1"], "node": "dea46e224fb376041eb2e1cb45c2488a6e07f991", "parents": ["ff8acd005c7edd1e8e2d792b0d1c2ae192962744"], "tags": []}, {"author": "Dennis Jackson \u003cgit@dennis-jackson.uk\u003e", "branch": "default", "desc": "Bug 2063354 - upgrade NSS to NSS_3_128_BETA1. r=nss-reviewers,jschanck UPGRADE_NSS_RELEASE\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321330\n", "files": ["security/nss/TAG-INFO", "security/nss/automation/abi-check/expected-report-libssl3.so.txt", "security/nss/automation/abi-check/previous-nss-release", "security/nss/automation/clang-format/Dockerfile", "security/nss/automation/clang-format/run_clang_format.sh", "security/nss/automation/clang-tidy/run_clang_tidy.py", "security/nss/automation/taskcluster/scripts/run_hacl.sh", "security/nss/cmd/certutil/certutil.c", "security/nss/cmd/certutil/keystuff.c", "security/nss/cmd/crlutil/crlgen_lex.c", "security/nss/cmd/dbck/dbck.c", "security/nss/cmd/lib/moreoids.c", "security/nss/cmd/lib/pk11table.c", "security/nss/cmd/lib/secutil.c", "security/nss/cmd/modutil/lex.Pk11Install_yy.c", "security/nss/cmd/pk11importtest/pk11importtest.c", "security/nss/cmd/shlibsign/shlibsign.c", "security/nss/cmd/ssltap/ssltap.c", "security/nss/cmd/vfyserv/vfyserv.c", "security/nss/coreconf/Linux.mk", "security/nss/cpputil/dummy_io.cc", "security/nss/cpputil/dummy_io.h", "security/nss/cpputil/dummy_io_fwd.cc", "security/nss/doc/src/releases/index.md", "security/nss/doc/src/releases/nss_3_126_1.md", "security/nss/gtests/certdb_gtest/alg1485_unittest.cc", "security/nss/gtests/common/gtests-util.cc", "security/nss/gtests/common/gtests.cc", "security/nss/gtests/common/json_re