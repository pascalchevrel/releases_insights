tup_invalid_session.js", "browser/components/sessionstore/test/unit/test_startup_session_async.js", "browser/components/sidebar/SidebarCollapsedWindows.sys.mjs", "browser/components/sidebar/SidebarManager.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tab-hover-preview.mjs", "browser/components/tabbrowser/content/tabgroup-menu.js", "browser/components/tabbrowser/test/TabGroupTestUtils.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_bug_1387976_restore_lazy_tab_browser_muted_state.js", "browser/components/tabbrowser/test/browser/tabs/browser_discarded_tab_move.js", "browser/components/tabbrowser/test/browser/tabs/browser_new_tab_insert_position.js", "browser/components/tabbrowser/test/browser/tabs/browser_restore_isAppTab.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_detach_restore.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_group_menu.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_list.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_tabContextMenu.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_tab_interactions_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_manager_close.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_manager_groups.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_move_to_new_window_reload.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_preview.js", "browser/components/urlbar/ActionsProviderTabGroups.sys.mjs", "browser/components/urlbar/SmartbarMentionsPanelSearch.sys.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_sessionStore.js", "browser/components/urlbar/tests/browser/browser_aboutHomeLoading.js", "browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcuts.mjs", "browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/ContentCrashHandlers.sys.mjs", "browser/modules/test/browser/browser_UsageTelemetry_private_and_restore.js", "docshell/test/browser/browser_bug2004165.js", "docshell/test/browser/browser_bug2007897.js", "dom/base/test/browser_newtab_session_history.js", "dom/documentpip/tests/browser/browser_sessionstore_ignore_dpip.js", "netwerk/base/nsNetUtil.cpp", "services/sync/tps/extensions/tps/resource/tps.sys.mjs", "testing/talos/talos/startup_test/sessionrestore/addon/api.js", "testing/talos/talos/talos-powers/api.js", "toolkit/components/httpsonlyerror/tests/browser/browser_errorpage.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_restore_session.js", "toolkit/components/thumbnails/test/head.js", "toolkit/content/widgets/browser-custom-element.mjs", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "adc7fd1ba540e9202eabc7ccb7b4a94872340826", "git_parents": ["d03dea60cb3072b54fd4cd9586b1e26fd2cc5718"], "node": "6e5d12c3ad1b60c31b8fd4b813a1ef73f9d9e13a", "parents": ["5b003e3b0670a14a4490514723f014ec5f84ca85"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2060642 - Support newer Speedometer completion state API r=mstange,perftest-reviewers,kshampur\n\nNewer Speedometer revisions use hasFinished() instead of _isRunning to\nreport completion. Support both APIs so both old and new versions can be\nrun. This is required by the next patch, which adds\nspeedometer-experimental from a newer revision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319139\n", "files": ["testing/raptor/browsertime/speedometer3.js"], "git_node": "cbca34677129d726640f2a6f58482154d5cd5a56", "git_parents": ["adc7fd1ba540e9202eabc7ccb7b4a94872340826"], "node": "8327394dd1a879f053fca783d8710ff1d3fc66ea", "parents": ["6e5d12c3ad1b60c31b8fd4b813a1ef73f9d9e13a"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2060642 - Add sp-exp jobs for experimental Speedometer workloads r=mstange,perftest-reviewers,kshampur\n\nSpeedometer 4 development has started adding new workloads to\nWebKit/Speedometer, some marked experimental on the main branch and some\nstill behind WIP pull requests, and we would like to track Firefox\nperformance on them. No single upstream revision contains all of them,\nso the new speedometer-experimental test clones Speedometer from a\nbranch of a fork at runtime rather than using the in-tree vendored copy.\n\nIt loads the benchmark with tags=experimental so it only measures the\nexperimental workloads; the default ones are already covered by\nspeedometer3. The jobs run on the same branches and platforms as\nspeedometer3, at tier 3.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319140\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/raptor.py", "taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor-metrics.md", "testing/perfdocs/generated/raptor.md", "testing/raptor/browsertime/support-scripts/browsertime_benchmark.py", "testing/raptor/raptor/output.py", "testing/raptor/raptor/perfdocs/config.yml", "testing/raptor/raptor/tests/benchmarks/speedometer-desktop.toml"], "git_node": "12bacfaecf705f42de2dc25abcf78bf6d24ccaeb", "git_parents": ["cbca34677129d726640f2a6f58482154d5cd5a56"], "node": "b2398ab6b8ba8fc995dca64542026e4a2e4af335", "parents": ["8327394dd1a879f053fca783d8710ff1d3fc66ea"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062145 - Report tests that leave a panel or menupopup open at the end of the test file, r=Gijs.\n\nA leaked popup covers the browser for the next test file, which then gets\nblamed for the failures it causes, and isGloballyBlockingOpenPopup makes\nopenPopup() refuse outright while one is open.\n\nThe check ends any hover with a synthesized mousecancel first: there is no\ninert point in the browser window to move the pointer to, and mouseout is\nrewritten into a mousemove at the given point, which left tab previews open.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317411\n", "files": ["remote/shared/listeners/test/browser/browser_DownloadListener.js", "testing/mochitest/browser-test.js"], "git_node": "df85e986bfd6f77538111ca7a23e16621af5ac8d", "git_parents": ["12bacfaecf705f42de2dc25abcf78bf6d24ccaeb"], "node": "8d2bb8983a3a6db3edc0a8f1a10c5ca0a0383eda", "parents": ["b2398ab6b8ba8fc995dca64542026e4a2e4af335"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063763 - Update opus to 03647f524a40b05a1898522e92033810b58103c7 r=kinetik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318869\n", "files": ["media/libopus/moz.build", "media/libopus/moz.yaml", "media/libopus/silk/fixed/burg_modified_FIX.c", "media/libopus/silk/fixed/x86/burg_modified_FIX_sse4_1.c", "media/libopus/silk/float/burg_modified_FLP.c"], "git_node": "e3fda14b67331c8ad6ae0fb6854f6b3f11c61465", "git_parents": ["df85e986bfd6f77538111ca7a23e16621af5ac8d"], "node": "7d7f8092164e701ceccbd780819b3d6ae65a11e5", "parents": ["8d2bb8983a3a6db3edc0a8f1a10c5ca0a0383eda"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064470 - Add SW Agent Watch kit.svg r=ngrato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319607\n", "files": ["browser/components/aiwindow/ui/assets/agent-watch-kit.svg"], "git_node": "f36c36336697190d601f184cdbd884af8b1f29b8", "git_parents": ["e3fda14b67331c8ad6ae0fb6854f6b3f11c61465"], "node": "d71015da8ef5561fc6363ef501fa86783f459e08", "parents": ["7d7f8092164e701ceccbd780819b3d6ae65a11e5"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2063717, part 1 - Replace uses of services::GetIOService(), ::GetChromeRegistry() and ::GetPermissionManager(). r=xpcom-reviewers,media-playback-reviewers,emilio,padenot\n\nThe new method is more threadsafe, but it will acquire a lock. Hopefully none of\nthis is super hot code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318838\n", "files": ["chrome/nsChromeProtocolHandler.cpp", "dom/fetch/FetchService.cpp", "dom/media/mediacontrol/MediaStatusManager.cpp", "js/xpconnect/loader/URLPreloader.cpp", "startupcache/StartupCacheUtils.cpp", "uriloader/exthandler/nsExternalHelperAppService.cpp", "xpcom/components/ManifestParser.cpp"], "git_node": "87135e278c890bfb2e3e0e66135990528206fa8e", "git_parents": ["f36c36336697190d601f184cdbd884af8b1f29b8"], "node": "62d44ee95ddf04a8f274fcf0c8fa06ddfbb32bb1", "parents": ["d71015da8ef5561fc6363ef501fa86783f459e08"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2063717, part 2 - Replace uses of services::GetAsyncShutdownService(). r=xpcom-reviewers,webrtc-reviewers,places-reviewers,media-playback-reviewers,emilio,padenot,pehrsons,Standard8\n\nAs with the prior patch, the new function is more threadsafe, but it needs to\nacquire a lock. Hopefully none of this is too performance sensitive.\n\nThis one is a bit funkier because one gtest does a reset thing, so we need to make the\ncomponent overridable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318839\n", "files": ["dom/base/Document.cpp", "dom/clients/manager/ClientManagerService.cpp", "dom/file/uri/BlobURLProtocolHandler.cpp", "dom/fs/child/FileSystemShutdownBlocker.cpp", "dom/ipc/ContentParent.cpp", "dom/media/gtest/TestAudioTrackGraph.cpp", "dom/media/systemservices/MediaUtils.cpp", "dom/serviceworkers/Servic