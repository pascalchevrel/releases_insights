nts": ["c4531b1ed49c9d491dbbdd71bbef3297b739a8c6"], "tags": []}], "date": 1787325883, "git_changesets": ["c044c583d86b371b2c479c9c4db545a92d8b8234"], "user": "ffxbld@lando.moz.tools"}, "45144": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064950 - Make the looseTimer callback an arrow function. r=sfoster\n\nnsITimer calls the callback with an unbound this, so the debug line throws before the timed_out counter increments and before the deferred resolves. The marionette test blocks a content process so the flush cannot finish, which is what lets the timer win the race and log the timeout.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320004\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_shutdown_flush_timeout.py"], "git_node": "761563428e99793d0b9f12b21f125bf49f251c02", "git_parents": ["cedeceacee1d2f8f63eb02bbc1da2ce8c04e55d7"], "node": "f0e8d9045d8b5424485c2da58a593f9352736ac1", "parents": ["e81b9e5c2f39b9eb81d139e63f832cb6002b5d6c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1892761 - Turn SessionStore into a JS class. r=sfoster\n\nA mechanical conversion, with Prettier rewrapping the signatures that now fit on one line. The methods move from own enumerable properties to the prototype, and nothing in the tree enumerates them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318435\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs"], "git_node": "4067e8dff8cc21d906b8bafcee69f42cffb41cef", "git_parents": ["761563428e99793d0b9f12b21f125bf49f251c02"], "node": "77462d5ee2c05503029a93b7d5f819ddbe6b9d22", "parents": ["f0e8d9045d8b5424485c2da58a593f9352736ac1"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1892761 - Make SessionStore's underscore-prefixed members private. r=sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318436\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs"], "git_node": "4428ff0c1f6e8746d0b641838897313131dffb74", "git_parents": ["4067e8dff8cc21d906b8bafcee69f42cffb41cef"], "node": "b6647beaafc3acb2ffcb92453e8f9af939ad43e3", "parents": ["77462d5ee2c05503029a93b7d5f819ddbe6b9d22"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1892761 - Make SessionStore's remaining internals private. r=extension-reviewers,sfoster,robwu\n\nWhat's left public is exactly what the shell object used to expose. The tab-taking restoreTabContent takes the #restoreTabContent name, so the browser-taking one becomes #restoreTabContentForBrowser, and windowToFocus, which was cleared with delete, is assigned null instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318437\n", "files": ["browser/components/extensions/test/browser/browser_ext_tabs_events.js", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/SessionStoreTestUtils.sys.mjs", "browser/components/sessionstore/test/browser_restoreLastActionCorrectOrder.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "63ee3e53699d0b2746f6b96ad4bdbbccbab1acf3", "git_parents": ["4428ff0c1f6e8746d0b641838897313131dffb74"], "node": "6cfbbbec4c76c178572d7674d4e861ae99737a74", "parents": ["b6647beaafc3acb2ffcb92453e8f9af939ad43e3"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063576 part 1 - Remove unused LoopControl::stackDepth_. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319692\n", "files": ["js/src/frontend/BytecodeControlStructures.cpp", "js/src/frontend/BytecodeControlStructures.h"], "git_node": "8f96ebe293b969c484af436c1ffe1697a3e84236", "git_parents": ["63ee3e53699d0b2746f6b96ad4bdbbccbab1acf3"], "node": "943de22dbba4cf188e4b2d6d7b44027ae7ad0e50", "parents": ["6cfbbbec4c76c178572d7674d4e861ae99737a74"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063576 part 2 - Change NonLocalExitControl::emitNonLocalJump to support expression stack values. r=arai\n\n`emitNonLocalJump` assumed the JS expression stack was empty. This is true for normal\n`break`/`continue`/`return` because they're statements, but not for a forced\ngenerator return for a `yield` expression (emitted in a later part).\n\nThis patch stores the expected depth in `NestableControl` and uses it in\n`NonLocalExitControl::emitNonLocalJump`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319693\n", "files": ["js/src/frontend/BytecodeControlStructures.cpp", "js/src/frontend/BytecodeControlStructures.h", "js/src/frontend/ForInEmitter.cpp", "js/src/frontend/ForOfEmitter.cpp", "js/src/frontend/ForOfLoopControl.cpp", "js/src/frontend/TryEmitter.cpp"], "git_node": "6ab75967427e4c43d04c558738d4303f5679ed31", "git_parents": ["8f96ebe293b969c484af436c1ffe1697a3e84236"], "node": "727f64243e889875ad8dd0a8f71f39ed0d062bd6", "parents": ["943de22dbba4cf188e4b2d6d7b44027ae7ad0e50"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063576 part 3 - Factor out BytecodeEmitter::emitDestructuringIteratorClose. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319694\n", "files": ["js/src/frontend/BytecodeEmitter.cpp", "js/src/frontend/BytecodeEmitter.h"], "git_node": "25b83d7c2c25fff7263f01908bb182ff1b0e749f", "git_parents": ["6ab75967427e4c43d04c558738d4303f5679ed31"], "node": "54fcdd2fc9762b7707a634ae4f730865e9cac55c", "parents": ["727f64243e889875ad8dd0a8f71f39ed0d062bd6"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063576 part 4 - Add DestructuringControl for array destructuring. r=arai\n\nDestructuring patterns can contain `yield` expressions so for forced-return bytecode we\nneed to emit code to close the iterator, similar to what we do for `finally` blocks.\n\nIn the common case (no `yield` inside the destructuring) we don't emit this extra\nbytecode.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319695\n", "files": ["js/src/frontend/BytecodeControlStructures.cpp", "js/src/frontend/BytecodeControlStructures.h", "js/src/frontend/BytecodeEmitter.cpp", "js/src/frontend/SharedContext.h"], "git_node": "3ff392bcd94f9fad4f93881b60d568e53a039412", "git_parents": ["25b83d7c2c25fff7263f01908bb182ff1b0e749f"], "node": "4423dcb9208d045fa7667a12615c96c948aca609", "parents": ["54fcdd2fc9762b7707a634ae4f730865e9cac55c"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063576 part 5 - Desugar the resume kind check for |await|. r=arai\n\nAn `await` is only resumed by a promise reaction, so its resume kind is either\nNext or Throw, never Return. We now assert this when resuming a generator.\n\nThe bytecode will be simplified a bit in a later patch when we remove the\ngenerator stack value.\n\n`JSOp::Throw` in WarpBuilder has a resume-after resume point but the op never\nfalls through and we never use this resume point for resuming at the next op.\nWe have to fix the debug assertion in `AssertBailoutStackDepth` to account for\nthis case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319696\n", "files": ["js/src/frontend/BytecodeEmitter.cpp", "js/src/frontend/BytecodeEmitter.h", "js/src/jit/BaselineBailouts.cpp", "js/src/vm/Interpreter.cpp"], "git_node": "c3680ae54b8c5f23d855eec29e91eb699260ab94", "git_parents": ["3ff392bcd94f9fad4f93881b60d568e53a039412"], "node": "09736a10c5d798c2fee03c5556f7622240b52f6b", "parents": ["4423dcb9208d045fa7667a12615c96c948aca609"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063576 part 6 - Desugar the resume kind check for |yield|. r=arai\n\nThis emits more bytecode for `yield` ops but simplifies the `Generator.prototype.return`\nimplementation. We no longer need the `JS_GENERATOR_CLOSING` magic value because we now\nemit an explicit return in the frontend.\n\nThe generator now reaches the final yield in all cases, so `GeneratorReturn` can\npass the raw value instead of an iterator-result object for it. `yield*` no longer\nhas to wrap/unwrap either.\n\nThis is much faster than the exception handler version. Some `return` micro-benchmarks\nare \u003e 2x faster and JetStream's lazy-collections test improves by 4-5%.\n\nThe patch also fixes `emitPopN` to handle arguments exceeding `UINT16_MAX` correctly.\nThis case is tested by `forced-return-expression-stack-large.js`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319697\n", "files": ["js/src/builtin/Generator.js", "js/src/frontend/BytecodeControlStructures.h", "js/src/frontend/BytecodeEmitter.cpp", "js/src/frontend/BytecodeEmitter.h", "js/src/jit-test/tests/debug/bug1368736.js", "js/src/jit-test/tests/generators/forced-return-expression-stack-large.js", "js/src/jit-test/tests/generators/forced-return-expression-stack.js"], "git_node": "f9d1bf960fe35bd0b33bd28ca2d5d1e8d90ed63e", "git_parents": ["c3680ae54b8c5f23d855eec29e91eb699260ab94"], "node": "f8873b4cf30891777692a92a7a79f9179c1f3221", "parents": ["09736a10c5d798c2fee03c5556f7622240b52f6b"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063576 part 7 - Remove JSOp::CheckResumeKind and JSOp::IsGenClosing. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319698\n", "files": ["js/src/debugger/Script.cpp", "js/src/frontend/ForOfLoopControl.cpp", "js/src/frontend/ForOfLoopControl.h", "js/src/frontend/UsingEmitter.cpp", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/Jit.cpp", "js/src/jit/Lowering.cpp", "js/src/jit/MIROps.yaml", "js/src/jit/VMFunctionList-inl.h", "js/src/jit/VMFunctions.cpp", "js/src/jit/VMFunctions.h", "js/src/jit/WarpBuilder.cpp", "js/src/jit/WarpOracle.cpp", "js/src/vm/AsyncFunction.h", "js/src/vm/AsyncIteration.h", "js/src/vm/BytecodeUtil.cpp", "js/src/vm/GeneratorObject.cpp", "js/src/vm/GeneratorObject.h", "js/src/vm/Interpreter.cpp", "js/src/vm/Opcodes.h", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "7b1b366c7826c85b79e68a922fa1ebaf72fe13ce", "git_parents": ["f9d1bf960fe35bd0b33bd28ca2d5d1e8d90ed63e"], "node": "ac50041d40c188d662c1480ae6d8412b6ae0b4bf", "parents": ["f8873b4cf30891777692a92a7a79f9179c1f3221"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063576 part 8 - Remove JS_GENERATOR_CLOSING and JSContext::isClosingGenerator. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319699\n", "files": ["js/public/Value.h", "js/src/jit/JitFrames.cpp", "js/src/vm/Interpreter.cpp", "js/src/vm/Interpreter.h", "js/src/vm/Iteration.cpp", "js/src/vm/JSContext.cpp", "js/src/vm/JSContext.h", "js/src/vm/Value.cpp"], "git_node": "dfb7b934de9091ac6f11ffed305727f2eb1e7550", "git_parents": ["7b1b366c7826c85b79e68a922fa1ebaf72fe13ce"], "node": "859ebf91170aa2cfc8d59f7338db9973a72a10bd", "parents": ["ac50041d40c188d662c1480ae6d8412b6ae0b4bf"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063576 part 9 - Stop pushing the generator object for JSOp::AfterYield. r=arai\n\nWe no longer need to have the generator object on the stack after the `AfterYield`\nop. This lets us simplify the bytecode a bit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319700\n", "files": ["js/src/frontend/BytecodeEmitter.cpp", "js/src/jit-test/tests/debug/breakpoint-dot-generator.js", "js/src/jit-test/tests/debug/bug1368736.js", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/WarpBuilder.cpp", "js/src/vm/AsyncFunction.h", "js/src/vm/AsyncIteration.h", "js/src/vm/BytecodeUtil.cpp", "js/src/vm/GeneratorObject.cpp", "js/src/vm/Interpreter.cpp", "js/src/vm/Opcodes.h", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "46dc31c21f0058998a3d8af5b5a8f29ab905e52c", "git_parents": ["dfb7b934de9091ac6f11ffed305727f2eb1e7550"], "node": "c83cf6209f8f83e0f4629e68b2a8d149854d78ef", "parents": ["859ebf91170aa2cfc8d59f7338db9973a72a10bd"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063576 part 10 - Support resuming in Ion for generator-return. r=iain\n\nNow that Return no longer goes through the exception handler, we should let it\nresume directly in Ion similar to Next. This is a small additional speedup for\n`Generator.prototype.return`.\n\nOnly Throw still resumes in Baseline, for performance reasons.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319701\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/Ion.cpp", "js/src/jit/Jit.cpp", "js/src/jit/Lowering.cpp", "js/src/jit/MIROps.yaml", "js/src/jit/WarpBuilder.cpp"], "git_node": "07fe3eb1f6fc4ddcf3ed72af71eb2207c0ef8540", "git_parents": ["46dc31c21f0058998a3d8af5b5a8f29ab905e52c"], "node": "8f1d81d2b66324f28eb893a51ddbfac87659cf9c", "parents": ["c83cf6209f8f83e0f4629e68b2a8d149854d78ef"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2065123 - Show the name of the shader in compile shader profile rmarkers. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320137\n", "files": ["gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/profiler.rs"], "git_node": "8053db31570ebbfeeaeff5805a5ee62e72f9b045", "git_parents": ["07fe3eb1f6fc4ddcf3ed72af71eb2207c0ef8540"], "node": "42319326dcb22b185eed46939cd0412459339c34", "parents": ["8f1d81d2b66324f28eb893a51ddbfac87659cf9c"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064321 - Emit repetitions for the surface's needs, not the tile cache dirty rect. r=gw\n\nprepare_repeatable_quad's \"repeat by duplicating the primitive\" path enumerated\nrepetitions against frame_state.current_dirty_region(), which is the picture\ncache tile's dirty region: push_dirty_region only happens for\nPictureCompositeMode::TileCache. Inside an intermediate surface that samples\noutside of its own footprint, the repetitions falling in that surface's\ninflation margin were dropped, so a blur read missing content and the wrong\nresult was baked into the picture cache tile with nothing left to invalidate it.\n\nCull against the current surface's clipping_rect instead. For a primitive drawn\nstraight onto a picture cache slice that is the dirty region (push_surface is\npassed surface_local_dirty_rect), so the optimisation is preserved; inside a\nfilter surface it is surface_rects.clipped_local, the inflated region that\nsurface needs. This is also the rect prepare_quad_impl already uses to decide\nwhat to draw, so the two now agree.\n\nprepare_image_quads' tiled path had the same bug, from the same\ncompute_conservative_visible_rect(current_dirty_region()) call. It is worse\nthere: that rect culls the repetitions and, within each repetition, the\nindividual texture cache tiles, so even a plain non-repeating tiled image loses\nthe tiles that fall in the blur's margin, and those tiles are never requested\nfrom the resource cache at all. Both callers now share\ncompute_surface_visible_rect, and compute_conservative_visible_rect goes away\nwith its last caller.\n\nThe reftests put a repeating gradient, a repeating tiled image and a plain tiled\nimage inside a horizontally blurred surface that straddles the x=1024 picture\ncache tile boundary, and invalidate only the tiles on one side of it so that the\ndirty region ends mid-surface. Each reference needs a first frame that\ninvalidates every tile: the harness renders the reference into the same wrench\ninstance right after the test, so a reference display list identical to the\ntest's last frame invalidates nothing and merely re-composites the test's own\ntiles, reproducing whatever the test got wrong.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319789\n", "files": ["gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/wrench/reftests/tiles/dirty-rect-blur-repeat-gradient-ref.yaml", "gfx/wr/wrench/reftests/tiles/dirty-rect-blur-repeat-gradient.yaml", "gfx/wr/wrench/reftests/tiles/dirty-rect-blur-repeat-tiled-image-ref.yaml", "gfx/wr/wrench/reftests/tiles/dirty-rect-blur-repeat-tiled-image.yaml", "gfx/wr/wrench/reftests/tiles/dirty-rect-blur-tiled-image-ref.yaml", "gfx/wr/wrench/reftests/tiles/dirty-rect-blur-tiled-image.yaml", "gfx/wr/wrench/reftests/tiles/reftest.list"], "git_node": "300754d1d96fc2185952e8a08ac30b49cce3a8db", "git_parents": ["8053db31570ebbfeeaeff5805a5ee62e72f9b045"], "node": "c423e0bf521f7a8674d8f09f2c674c5c1bb9e418", "parents": ["42319326dcb22b185eed46939cd0412459339c34"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062904 - Fix overflow row not settling r=Mardak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318425\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-overflow-row/SmartwindowOverflowRow.mjs"], "git_node": "ea002934184c32080e305c0a11ba4b09fe5203fa", "git_parents": ["300754d1d96fc2185952e8a08ac30b49cce3a8db"], "node": "92beb0fd9db4c505250c20d55157720e39c3af19", "parents": ["c423e0bf521f7a8674d8f09f2c674c5c1bb9e418"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064609, Bug 2064671 - Pass automationtest intent extra by default for Fenix launches r=geckodriver-reviewers,whimboo\" for causing build bustages.\n\nThis reverts commit cedeceacee1d2f8f63eb02bbc1da2ce8c04e55d7.\n\nRevert \"Bug 2064671 - Support automationtest intent extra to bypass Fenix onboarding for WebDriver r=android-reviewers,sfamisa\"\n\nThis reverts commit ba6a22e280048c822814e5af3c5f22ff9bf59ecb.\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/automation/AutomatedLaunch.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/Performance.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/PerformanceLogger.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/StartupReportFullyDrawn.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/StrictModeManager.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/ThreadPenaltyDeathWithIgnoresListener.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/automation/AutomatedLaunchTest.kt", "testing/geckodriver/src/capabilities.rs"], "git_node": "ed1143e39bfb49283208cdff200dbb2f7b9e831c", "git_parents": ["ea002934184c32080e305c0a11ba4b09fe5203fa"], "node": "e8ea9f02376638cc6b85045a7e25dfc4bb45ae4f", "parents": ["92beb0fd9db4c505250c20d55157720e39c3af19"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065145 - Only enable the address autofill all-regions rollout on pre-release channels. r=joschmidt\n\nBug 2035232 set extensions.formautofill.addresses.supported to \"on\" for\nall desktop channels, so address autofill became available in every\nregion rather than only on Nightly as that change intended.\n\nGate the pref on the update channel, mirroring the existing\nextensions.formautofill.useml gate: Nightly, Dev Edition and Beta keep\n\"on\", while Release and ESR fall back to \"detect\" and region-based\navailability.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320342\n", "files": ["modules/libpref/init/all.js"], "git_node": "19068043ad2afccaef9833968c10ede8b3241dd4", "git_parents": ["ed1143e39bfb49283208cdff200dbb2f7b9e831c"], "node": "9820aa6cbd23bda075dbf2331ffcaee08c6c9115", "parents": ["e8ea9f02376638cc6b85045a7e25dfc4bb45ae4f"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065029 - Fix modernize-use-bool-literals static-analysis regression r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320005\n", "files": ["gfx/thebes/gfxFontEntry.cpp"], "git_node": "f9908a8fd7e3aa0b86603d47ae1b97fd3c7c6acb", "git_parents": ["19068043ad2afccaef9833968c10ede8b3241dd4"], "node": "0678f440bf2de3c64d40749d9f088b4ff6b6e87c", "parents": ["9820aa6cbd23bda075dbf2331ffcaee08c6c9115"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065029 - Use NOLINTNEXTLINE instead of NOLINT r=ahochheiden\n\nOtherwise clang-format puts the NOLINT command on the wrong line, and\nthe linter ignore them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320142\n", "files": ["dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserParent.cpp", "dom/media/ExternalEngineStateMachine.cpp"], "git_node": "469d3a2a2495945be54133de6c70a29eb4c74a53", "git_parents": ["f9908a8fd7e3aa0b86603d47ae1b97fd3c7c6acb"], "node": "e9bd0e2633165f52315d4ccb47303ae91a0c103d", "parents": ["0678f440bf2de3c64d40749d9f088b4ff6b6e87c"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060764 part 3: Remove parent document argument to PDocAccessible constructor and PBrowserBridge::SetEmbedderAccessible. r=eeejay,nika\" for causing dt failures @DocAccessibleParent.cpp.\n\nThis reverts commit 8aa5c4642a70765a93a071a98b5a40ba09c6d9a4.\n\nRevert \"Bug 2060764 part 2: Ensure the correct same-process embedder when adding a child doc. r=eeejay,nika\"\n\nThis reverts commit f5254a4541c389f91524bbbde0655563c6c69bb9.\n\nRevert \"Bug 2060764 part 1: Make PDocAccessible managed by PWindowGlobal instead of PBrowser. r=eeejay,nika\"\n\nThis reverts commit 99640d30438827e5d4c9546d25cd22f04ae5dc43.\n", "files": ["accessible/android/SessionAccessibility.cpp", "accessible/base/FocusManager.cpp", "accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp", "accessible/generic/OuterDocAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "accessible/ipc/PDocAccessible.ipdl", "accessible/ipc/RemoteAccessible.cpp", "accessible/pdf/PdfStructTreeBuilder.cpp", "accessible/xul/XULComboboxAccessible.cpp", "dom/ipc/BrowserBridgeChild.h", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserBridgeParent.h", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/PBrowser.ipdl", "dom/ipc/PBrowserBridge.ipdl", "dom/ipc/PWindowGlobal.ipdl", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalChild.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/ipc/moz.build"], "git_node": "468aa5538fc4a1eb1f87f2b7b02d4ed09d4d16d2", "git_parents": ["469d3a2a2495945be54133de6c70a29eb4c74a53"], "node": "3c26b3f2094693a7929e7979647fecf132011f88", "parents": ["e9bd0e2633165f52315d4ccb47303ae91a0c103d"], "tags": []}, {"author": "Sam Weinig \u003csam@webkit.org\u003e", "branch": "default", "desc": "Bug 2063408 [wpt PR 61925] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321003, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=321003 (#61925)\n--\n\nwpt-commits: 3ed2d920362796593900adf2c4e1551474a0563b\nwpt-pr: 61925\n", "files": ["testing/web-platform/tests/scroll-animations/scroll-timelines/scroll-timeline-range-with-zoom.html", "testing/web-platform/tests/web-animations/interfaces/Animation/animation-range-invalid.html"], "git_node": "4deea892af2ae236e7ba1e375cfcce6526024b37", "git_parents": ["468aa5538fc4a1eb1f87f2b7b02d4ed09d4d16d2"], "node": "412a1ac1ff3eaa072e0dd080ce153464fd765fea", "parents": ["3c26b3f2094693a7929e7979647fecf132011f88"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063408 [wpt PR 61925] - Update wpt metadata, a=testonly\n\nwpt-pr: 61925\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/scroll-animations/scroll-timelines/scroll-timeline-range-with-zoom.html.ini"], "git_node": "84ad013e6b6ba12c655877da3a2806d83513488a", "git_parents": ["4deea892af2ae236e7ba1e375cfcce6526024b37"], "node": "1f29911e327e3225d2299df418bc1a193bb6d228", "parents": ["412a1ac1ff3eaa072e0dd080ce153464fd765fea"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2064139 [wpt PR 61987] - Fix some streaming-sanitizer/adoption-agency edge cases, a=testonly\n\nAutomatic update from web-platform-tests\nFix some streaming-sanitizer/adoption-agency edge cases\n\nSanitization should take place while performing the adoption agency\nalgorithm, otherwise some nodes can be missed.\n\nSince adoption agency often adds an intermediate element,\nthe ReplaceWithChildren directive essentially negates it,\nwhile Remove reparents the children into the intermediate\nelement and removes all of them.\n\nThis is in line with spec changes made as part of\nhttps://github.com/whatwg/html/pull/12756\n\nBug: 498272014\nChange-Id: Ieb755555635e197f8ed7daf06a08679a0f2d38c3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8250959\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1680770}\n\n--\n\nwpt-commits: 4409cc231d390712ee52ffb5529177ebb0cd0da3\nwpt-pr: 61987\n", "files": ["testing/web-platform/tests/sanitizer-api/sanitizer-in-adoption-agency.html", "testing/web-platform/tests/sanitizer-api/sanitizer-in-adoption-agency.sub.dat"], "git_node": "1d29f21b163be466aaf73b08dfceef5e5501c896", "git_parents": ["84ad013e6b6ba12c655877da3a2806d83513488a"], "node": "e9b568c0f6dd53969ab9e49e4f4ac5b89015ce1d", "parents": ["1f29911e327e3225d2299df418bc1a193bb6d228"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064139 [wpt PR 61987] - Update wpt metadata, a=testonly\n\nwpt-pr: 61987\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/sanitizer-api/sanitizer-in-adoption-agency.html.ini"], "git_node": "529c71e452b6dbcdc5274a590c61f1934b635164", "git_parents": ["1d29f21b163be466aaf73b08dfceef5e5501c896"], "node": "3e391939d53b10d51f12572b1dcd7796f66f9929", "parents": ["e9b568c0f6dd53969ab9e49e4f4ac5b89015ce1d"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2064157 [wpt PR 61992] - [html-in-canvas] Support inline drawables with inline-block, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Support inline drawables with inline-block\n\nThis patch updates the style adjuster to support inline drawables by\nmaking them inline-blocks rather than blocks. Inline-block is required\nso that the drawable elements can be containing blocks for fixed.\nDirect children of a \u003ccanvas layoutsubtree\u003e continue to blockify.\n\nBug: 532229486\nChange-Id: If978000bcf4beab40920b858568ce4aaa4afc706\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8261102\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1680813}\n\n--\n\nwpt-commits: 01af755cb072a07302e07cd12662b49b7f78ba79\nwpt-pr: 61992\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/inline-drawable-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/inline-drawable.tentative.html"], "git_node": "787f4826b195b6b413cecbce094b52a93a1d1f34", "git_parents": ["529c71e452b6dbcdc5274a590c61f1934b635164"], "node": "2ca449d8126aa13009115737a5fb29c41b915b21", "parents": ["3e391939d53b10d51f12572b1dcd7796f66f9929"], "tags": []}, {"author": "mark a. foltz \u003cmfoltz@chromium.org\u003e", "branch": "default", "desc": "Bug 2064186 [wpt PR 61995] - [WebMCP] Check for null ExecutionContext in ModelContext constructor., a=testonly\n\nAutomatic update from web-platform-tests\n[WebMCP] Check for null ExecutionContext in ModelContext constructor.\n\nWhen accessing document.modelContext on a detached Document (for\nexample, from an iframe removed from the DOM),\ndocument.GetExecutionContext() returns nullptr.\n\nAlso adds a regression test for this case.\n\nFixed: 539142491\nChange-Id: I4bc1a145e8b3919549b3db9e36a70dbbb7cd7a19\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8265765\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCommit-Queue: Mark Foltz \u003cmfoltz@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1680846}\n\n--\n\nwpt-commits: 40524f2437e7f34f77934bf1d9b48aa60edbbc3d\nwpt-pr: 61995\n", "files": ["testing/web-platform/tests/webmcp/imperative/detached-frame-modelContext.https.html"], "git_node": "9bc3aa0e91abd0b3bcb27a17b6d8527bbb8a8622", "git_parents": ["787f4826b195b6b413cecbce094b52a93a1d1f34"], "node": "c3365c34a75e5e61299a9dd602387cfaa88f37fa", "parents": ["2ca449d8126aa13009115737a5fb29c41b915b21"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064186 [wpt PR 61995] - Update wpt metadata, a=testonly\n\nwpt-pr: 61995\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/imperative/detached-frame-modelContext.https.html.ini"], "git_node": "8f91cd603c6c26590e34bbee4fe4beee31e13769", "git_parents": ["9bc3aa0e91abd0b3bcb27a17b6d8527bbb8a8622"], "node": "56f2b76365cb83574035e6756981cc60be1a5552", "parents": ["c3365c34a75e5e61299a9dd602387cfaa88f37fa"], "tags": []}, {"author": "Brandon Walderman \u003cbrwalder@microsoft.com\u003e", "branch": "default", "desc": "Bug 2064163 [wpt PR 61993] - [css-mixins] Fix !important parser bug and add tests, a=testonly\n\nAutomatic update from web-platform-tests\n[css-mixins] Fix !important parser bug and add tests\n\nCSSWG resolved that !important invalidates declarations in function\nbodies, function and mixin arguments, and private/local blocks. It\nremains valid in mixin result declarations, where normal cascading\napplies.\n\nBlink mostly implements the currently supported parts of this behavior.\nThere was a bug in css_variable_parser.cc in ConsumeCustomFunction. In\nthe case where a CSS value was wrapped in braces, parsing a valid CSS\nvalue would potentially leave tokens (such as `!important`) unconsumed\nwithin the braces.\n\nAdding WPT coverage for function descriptors and conditional bodies,\nfunction and mixin arguments, mixin parameter defaults and locals, and\nvalid !important in mixin results. Coverage for the bug fix is also\nincluded.\n\nBug: 542582974\nChange-Id: I1a6c299c0a0f9a51999e99aec892c3169d8cbe23\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8259575\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Brandon Walderman \u003cbrwalder@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1680865}\n\n--\n\nwpt-commits: 29f6ff4d0818ea88c6438e60e5da399dadf6f8e7\nwpt-pr: 61993\n", "files": ["testing/web-platform/tests/css/css-mixins/functions/at-function-cssom.html", "testing/web-platform/tests/css/css-mixins/functions/dashed-function-parsing.html", "testing/web-platform/tests/css/css-mixins/mixins/important.html", "testing/web-platform/tests/css/css-mixins/mixins/mixin-locals.html"], "git_node": "67006d3b810599aaab592a87be11afbe1167a300", "git_parents": ["8f91cd603c6c26590e34bbee4fe4beee31e13769"], "node": "89ba0d5e41affeac8ea3524bfb3915b14b27e4fc", "parents": ["56f2b76365cb83574035e6756981cc60be1a5552"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064163 [wpt PR 61993] - Update wpt metadata, a=testonly\n\nwpt-pr: 61993\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-mixins/functions/at-function-cssom.html.ini", "testing/web-platform/meta/css/css-mixins/mixins/important.html.ini", "testing/web-platform/meta/css/css-mixins/mixins/mixin-locals.html.ini"], "git_node": "e451f8d8c0e78eede428a6c7e7dbace9e59f489a", "git_parents": ["67006d3b810599aaab592a87be11afbe1167a300"], "node": "be1ae36435f868fee530f5c68f4107bd18a81a96", "parents": ["89ba0d5e41affeac8ea3524bfb3915b14b27e4fc"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2064024 [wpt PR 61984] - Fix explicit inheritance for all length properties, a=testonly\n\nAutomatic update from web-platform-tests\nFix explicit inheritance for all length properties\n\nMark zoom-sensitive properties and add coverage ensuring explicitly\ninherited computed lengths remain unchanged across zoom levels.\n\nBug: 420443621\nChange-Id: I422476d70a3db3d0119ad568f84045cab11b91ed\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8249138\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1680891}\n\n--\n\nwpt-commits: c7c7a1b2641777d1f5f3934705ddde645eb82116\nwpt-pr: 61984\n", "files": ["testing/web-platform/tests/css/css-viewport/zoom/explicit-inherit/all-length-properties.html"], "git_node": "e94a7c27d3dcecefa600efb864805b8720fa2dfd", "git_parents": ["e451f8d8c0e78eede428a6c7e7dbace9e59f489a"], "node": "76fd499c2d6a2798d75487745cda9d725bcf11f3", "parents": ["be1ae36435f868fee530f5c68f4107bd18a81a96"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064024 [wpt PR 61984] - Update wpt metadata, a=testonly\n\nwpt-pr: 61984\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-viewport/zoom/explicit-inherit/all-length-properties.html.ini"], "git_node": "127c62d1adab3559c1ca0ac88be50ed1a06bff53", "git_parents": ["e94a7c27d3dcecefa600efb864805b8720fa2dfd"], "node": "412132dca2e388dd63cf3b0df736ae4904d38ce4", "parents": ["76fd499c2d6a2798d75487745cda9d725bcf11f3"], "tags": []}, {"author": "Kai Ninomiya \u003ckainino@chromium.org\u003e", "branch": "default", "desc": "Bug 2064261 [wpt PR 62005] - Fix incorrectly copying row padding in command buffer clients, a=testonly\n\nAutomatic update from web-platform-tests\nFix incorrectly copying row padding in command buffer clients\n\nVideoFrame::copyTo() is supposed to copy only the pixels and not the\npadding bytes between rows. Doing so requires one memcpy per row instead\nof one big memcpy.\n\n- RasterImplementation::ReadbackImagePixelsINTERNAL and\n  RasterImplementation::OnAsyncARGBReadbackDone:\n  accessible via VideoFrame::copyTo.\n  - There are many other codepaths reachable from VideoFrame::copyTo().\n    The others seem to be correct.\n- RasterImplementation::AsyncYUVReadbackRequest::CopyYUVPlane and\n  GLES2Implementation::ReadbackARGBImagePixelsINTERNAL:\n  also seemed to do this wrong, but I have not looked into exactly how\n  they're used, so I'm not certain they're important or whether they\n  have a security impact. I'm only guessing they are important based on\n  the similar comments that said they write into JS-visible memory\n  (which is how I stumbled on them).\n\nTests:\n- raster_implementation_unittest tests generated using Gemini, but\n  manually verified that each of the four tests fails when the fix it\n  targets is reverted (e.g. see how the first three were tested in\n  patchset 4: https://crrev.com/c/8255469/4).\n  - Manual drive-by fix some of the initialization sites of\n    MockTransferBuffer::ExpectedMemoryInfo, so that the spanified form\n    can be used instead of raw pointers in the new test.\n- content/test/data/gpu/webcodecs/copyTo.html test also generated using\n  Gemini, but manually verified that it hits the bug in\n  RasterImplementation::ReadbackImagePixelsINTERNAL. It doesn't seem to\n  hit any of the others on my device (Pixel 3).\n- WPT test for copyTo() on VideoFrames that are CPU-backed (which was\n  already fine) and texture-backed (which is what this fixes).\n  Unfortunately this test does not seem to catch the issue on CQ, but\n  the texture-backed one does at least catch it locally on my Mac.\n\nFixed: 543707066\nChange-Id: Iea2e75cdb75175f250ab5472a22c2f46819e6e84\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8255469\nReviewed-by: Eugene Zemtsov \u003ceugene@chromium.org\u003e\nCommit-Queue: Kai Ninomiya \u003ckainino@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1680958}\n\n--\n\nwpt-commits: 890e1092681e3800333bdf06ec1526c39f4bcaaa\nwpt-pr: 62005\n", "files": ["testing/web-platform/tests/webcodecs/videoFrame-copyTo.any.js"], "git_node": "34855657a1890d4f09d2b33bb63601147d25851a", "git_parents": ["127c62d1adab3559c1ca0ac88be50ed1a06bff53"], "node": "094da00eeda97037b595bb4255b74d0815e8bc2c", "parents": ["412132dca2e388dd63cf3b0df736ae4904d38ce4"], "tags": []}, {"author": "Jacques Newman \u003cjanewman@microsoft.com\u003e", "branch": "default", "desc": "Bug 2064264 [wpt PR 62006] - [focusgroupV2] Test feed keyboard navigation, a=testonly\n\nAutomatic update from web-platform-tests\n[focusgroupV2] Test feed keyboard navigation\n\nAdd WPT coverage for Focusgroup V2 feed navigation, including arrow\nnavigation, hard boundaries, reading-flow order, dynamic updates, nested\nfeeds, and noitemcontrols.\n\nExplainer: https://open-ui.org/components/focusgroup-v2.explainer/#feed-focusgroups\nBug: 445992558\nAX-Relnotes: n/a.\nChange-Id: Ia7a835d9f5d9952f0be2db2b266cb10ff5bdba96\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8246500\nCommit-Queue: Jacques Newman \u003cjanewman@microsoft.com\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681000}\n\n--\n\nwpt-commits: 5df2337c6b23c4e841f066d0c5d8259c47a59d57\nwpt-pr: 62006\n", "files": ["testing/web-platform/tests/html/interaction/focus/focusgroup/tentative/feed-navigation.html"], "git_node": "d93ca08cbefa34a080658762d849cea8a8b68297", "git_parents": ["34855657a1890d4f09d2b33bb63601147d25851a"], "node": "83a3c0a232a50a3dd5a34e8a583bf79181814a00", "parents": ["094da00eeda97037b595bb4255b74d0815e8bc2c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064264 [wpt PR 62006] - Update wpt metadata, a=testonly\n\nwpt-pr: 62006\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/interaction/focus/focusgroup/tentative/feed-navigation.html.ini"], "git_node": "5ad76fa4c51a645d34d083ad11e8dd57478ba0ef", "git_parents": ["d93ca08cbefa34a080658762d849cea8a8b68297"], "node": "bd2fdec97e73e6926826d798f5676cfb50103a98", "parents": ["83a3c0a232a50a3dd5a34e8a583bf79181814a00"], "tags": []}, {"author": "Yanling Wang \u003cyanlingwang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2064246 [wpt PR 62000] - [Masonry] Add initial tests for grid-lanes as a subgrid, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Add initial tests for grid-lanes as a subgrid\n\nThis CL adds basic tests for grid-lanes subgridded to grid-lanes/grid.\nThey mirror the existing grid-subgridded-to-grid-lanes suite, covering\nexplicit and auto-placed subgrids, independent formatting contexts, and\ntrack sizing. Alignment, baseline, line-name and auto-repeat coverage\nwill follow as the functionality lands, with the goal of eventually\nmatching the grid-subgridded-to-grid-lanes suite in both scenarios.\n\nThe tests are expected to fail and are marked in TestExpectations.\n\nBug: 343257585\nChange-Id: I7abb0cdbc7aa75486ab8b44034b562033c062de0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8252617\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCommit-Queue: Yanling Wang \u003cyanlingwang@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1681031}\n\n--\n\nwpt-commits: 53969d336a0e8dda02b9614b18a8ec160804569d\nwpt-pr: 62000\n", "files": ["testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-independent-formatting-context-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/column/grid-lanes-subgrid-001a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/column/grid-lanes-subgrid-001a.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/column/grid-lanes-subgrid-002a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/column/grid-lanes-subgrid-002a.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/column/independent-formatting-context.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-001a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-001a.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-002a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-002a.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/independent-formatting-context.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/column/grid-lanes-subgrid-001a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/column/grid-lanes-subgrid-001a.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/column/grid-lanes-subgrid-002a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/column/grid-lanes-subgrid-002a.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/column/independent-formatting-context.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/row/grid-lanes-subgrid-001a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/row/grid-lanes-subgrid-001a.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/row/grid-lanes-subgrid-002a-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/row/grid-lanes-subgrid-002a.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/row/independent-formatting-context.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/track-sizing/grid-lanes-subgrid-flex-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/track-sizing/grid-lanes-subgrid-flex.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/track-sizing/grid-lanes-subgrid-intrinsic-sizing-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/track-sizing/grid-lanes-subgrid-intrinsic-sizing.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/track-sizing/grid-lanes-subgrid-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/track-sizing/grid-lanes-subgrid.html"], "git_node": "45f1993c9022d55e0c054eddd2d0df59bfd5dd41", "git_parents": ["5ad76fa4c51a645d34d083ad11e8dd57478ba0ef"], "node": "55cac5d3e4242c300a2005555732b6d6c117e151", "parents": ["bd2fdec97e73e6926826d798f5676cfb50103a98"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064246 [wpt PR 62000] - Update wpt metadata, a=testonly\n\nwpt-pr: 62000\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/column/grid-lanes-subgrid-001a.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/column/grid-lanes-subgrid-002a.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/column/independent-formatting-context.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-001a.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/grid-lanes-subgrid-002a.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid-lanes/row/independent-formatting-context.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/column/grid-lanes-subgrid-001a.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/column/grid-lanes-subgrid-002a.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/column/independent-formatting-context.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/row/grid-lanes-subgrid-001a.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/row/grid-lanes-subgrid-002a.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/row/independent-formatting-context.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/track-sizing/grid-lanes-subgrid-flex.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/track-sizing/grid-lanes-subgrid-intrinsic-sizing.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-lanes-subgridded-to-grid/track-sizing/grid-lanes-subgrid.html.ini"], "git_node": "55bd45b6d9aad81d4c1719876ecd16af6fb5927e", "git_parents": ["45f1993c9022d55e0c054eddd2d0df59bfd5dd41"], "node": "20919390f9f298e21de3beda917de20421a03ebd", "parents": ["55cac5d3e4242c300a2005555732b6d6c117e151"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2064272 [wpt PR 62007] - Fix popover CHECK crashes from beforetoggle and loseinterest handlers, a=testonly\n\nAutomatic update from web-platform-tests\nFix popover CHECK crashes from beforetoggle and loseinterest handlers\n\nDuring HidePopoverInternal(), event handlers for beforetoggle and\nloseinterest can synchronously mutate the popover's state, such as\nchanging its type, removing it, or showing other popovers. This caused\ntwo CHECK crashes due to stale stack assumptions:\n\n- If a closing beforetoggle handler changed the popover's type to\n  manual and showed another auto popover, the nested hide already\n  transitioned the popover to hidden, but the outer hide evaluated the\n  stack check and hit CHECK(PopoverType() == kAuto || PopoverType() ==\n  kHint) with kManual. Moving IsPopoverReady() before the stack check\n  ensures we exit early when the popover was already hidden.\n\n- If a loseinterest handler showed a child hint popover, the child was\n  pushed onto hint_stack above the hiding popover. The stack removal\n  logic checked stack_top == this to identify hint_stack, failed, fell\n  into the auto_stack branch, and hit CHECK(!auto_stack.empty()). We\n  now re-hide popovers opened during loseinterest, select the stack via\n  hint_stack.Contains(this), and assert that this is at the top of its\n  stack upon removal.\n\nFixed: 494293277,494294069\nChange-Id: I76cdfa5be020555d09bc01943e66eec9ccfbf8b8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8261789\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Mason Freed \u003cmasonf@chromium.org\u003e\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681043}\n\n--\n\nwpt-commits: d213f64f2267a79bae642cfe2acd6480ad55b035\nwpt-pr: 62007\n", "files": ["testing/web-platform/tests/html/semantics/popovers/popover-beforetoggle-change-type-crash.html", "testing/web-platform/tests/html/semantics/popovers/popover-hint-loseinterest-show-child.html"], "git_node": "f2e7aa3cbe45e9a1e0e4955f5b1e5a627d47c870", "git_parents": ["55bd45b6d9aad81d4c1719876ecd16af6fb5927e"], "node": "b27a892eaeb4b402d79cf0d6d520b00fda4a7a9b", "parents": ["20919390f9f298e21de3beda917de20421a03ebd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064272 [wpt PR 62007] - Update wpt metadata, a=testonly\n\nwpt-pr: 62007\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/popovers/popover-hint-loseinterest-show-child.html.ini"], "git_node": "a71e0c77d8b935ba68e8ddda126271a70343e898", "git_parents": ["f2e7aa3cbe45e9a1e0e4955f5b1e5a627d47c870"], "node": "46288161920e1a8cecf21665eddce44c4e425e5d", "parents": ["b27a892eaeb4b402d79cf0d6d520b00fda4a7a9b"], "tags": []}, {"author": "Jacques Newman \u003cjanewman@microsoft.com\u003e", "branch": "default", "desc": "Bug 2064253 [wpt PR 62001] - [focusgroupV2] Infer feed owner and item roles, a=testonly\n\nAutomatic update from web-platform-tests\n[focusgroupV2] Infer feed owner and item roles\n\nMap the V2 feed behavior to its feed minimum owner role and article\nminimum item role, and apply both the owner and item role inference at\naccessibility serialization time so a generic feed focusgroup and its\nitems expose their implied ARIA roles.\n\nOwner inference gives a generic feed focusgroup owner the feed role\nwhile preserving explicit and native roles. Item inference gives feed\nitems the article role only when the item still has generic semantics\nand the owner role matches the behavior minimum, leaving explicit ARIA\nand richer native semantics untouched.\n\nExplainer: https://open-ui.org/components/focusgroup-v2.explainer/#supported-behaviors-and-role-inference\nBug: 445992558\nChange-Id: I95c42adf0a3eb3d7c4234281aa2baffe6c0746ed\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8246501\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Jacques Newman \u003cjanewman@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1681061}\n\n--\n\nwpt-commits: 8ab3fa7d69a667018e8d8f51c15700991c9dda1d\nwpt-pr: 62001\n", "files": ["testing/web-platform/tests/html/interaction/focus/focusgroup/tentative/feed-role-inference-item.html", "testing/web-platform/tests/html/interaction/focus/focusgroup/tentative/feed-role-inference-owner.html"], "git_node": "3274be76bec0f3b1847b5fda942301db51fdae16", "git_parents": ["a71e0c77d8b935ba68e8ddda126271a70343e898"], "node": "ddc15396830cd92cba0fc176e1bfadc629723dab", "parents": ["46288161920e1a8cecf21665eddce44c4e425e5d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064253 [wpt PR 62001] - Update wpt metadata, a=testonly\n\nwpt-pr: 62001\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/interaction/focus/focusgroup/tentative/feed-role-inference-item.html.ini", "testing/web-platform/meta/html/interaction/focus/focusgroup/tentative/feed-role-inference-owner.html.ini"], "git_node": "d6783b26fd37deb6741d31b855e857f0960dd350", "git_parents": ["3274be76bec0f3b1847b5fda942301db51fdae16"], "node": "8aae095785686c288013acd38f20ff6b797561a4", "parents": ["ddc15396830cd92cba0fc176e1bfadc629723dab"], "tags": []}, {"author": "Hoch Hochkeppel (HE/HIM) \u003cmhochk@microsoft.com\u003e", "branch": "default", "desc": "Bug 2064275 [wpt PR 62008] - Invalidate top-level UA styles when leaving the top-level, a=testonly\n\nAutomatic update from web-platform-tests\nInvalidate top-level UA styles when leaving the top-level\n\nWhen removing a dialog or popover from the top-level, styles controlled\nby `:-internal-popover-in-top-layer` and\n`:-internal-dialog-in-top-layer` selectors were not being invalidated.\nThis change adds a simple invalidation targeted for these 2, as well as\na WPT to validate the fix (passes in Firefox and Safari, but fails in\nChromium without this fix).\n\nFixed: 546181653\nChange-Id: Idd336a3f6bb3c6ef97b2fcc27e5d169d775b546d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8254004\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1681064}\n\n--\n\nwpt-commits: 34415055c41544ff415fc9ddaebe4d4b18809af8\nwpt-pr: 62008\n", "files": ["testing/web-platform/tests/html/semantics/interactive-elements/the-dialog-element/top-layer-removal-invalidates-ua-styles.html"], "git_node": "9f64dbd1b88aa65a89805cbfb1874c6ca53e99b3", "git_parents": ["d6783b26fd37deb6741d31b855e857f0960dd350"], "node": "7755b0e4db4e2fac11319a5e4ca5c39482a11255", "parents": ["8aae095785686c288013acd38f20ff6b797561a4"], "tags": []}, {"author": "Koji Ishii \u003ckojii@chromium.org\u003e", "branch": "default", "desc": "Bug 2064288 [wpt PR 62010] - [text-spacing-trim] Fix when the last char is trimmed, a=testonly\n\nAutomatic update from web-platform-tests\n[text-spacing-trim] Fix when the last char is trimmed\n\nThis patch fixes `ShapingLineBreaker` to take the line end\nresult into account when:\n* The last character of a line is closing.\n* The last character must be trimmed to fit into the line.\n\nNot taking the line end result can cause incorrect line break\nwhen the line has inline boxes.\n\nFixed: 542686223\nChange-Id: Ie73848a9e75c9adf1162b505b33d7c282ebc550f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8264049\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: Kent Tamura \u003ctkent@chromium.org\u003e\nAuto-Submit: Koji Ishii \u003ckojii@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681082}\n\n--\n\nwpt-commits: e76551e297725c137eb696a5f6258a59adee5999\nwpt-pr: 62010\n", "files": ["testing/web-platform/tests/css/css-text/text-spacing-trim/text-spacing-trim-end-span-001-ref.html", "testing/web-platform/tests/css/css-text/text-spacing-trim/text-spacing-trim-end-span-001.html"], "git_node": "35be8af046dd37b2153a41e5d699ae36a4c9bc60", "git_parents": ["9f64dbd1b88aa65a89805cbfb1874c6ca53e99b3"], "node": "fbbee906aa3d4f605e9c99d684a86f7f270c1912", "parents": ["7755b0e4db4e2fac11319a5e4ca5c39482a11255"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064288 [wpt PR 62010] - Update wpt metadata, a=testonly\n\nwpt-pr: 62010\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-text/text-spacing-trim/text-spacing-trim-end-span-001.html.ini"], "git_node": "60b849bd6b955dcbe6be23deb8c8d732c6b06b3c", "git_parents": ["35be8af046dd37b2153a41e5d699ae36a4c9bc60"], "node": "2dbcbe3bdb5eef220b3f6a76e9c45130c716ab4e", "parents": ["fbbee906aa3d4f605e9c99d684a86f7f270c1912"], "tags": []}, {"author": "Takashi Toyoshima \u003ctoyoshim@chromium.org\u003e", "branch": "default", "desc": "Bug 2064280 [wpt PR 62009] - OOR-CORS: Use opaque origin as preflight cache key for tainted requests, a=testonly\n\nAutomatic update from web-platform-tests\nOOR-CORS: Use opaque origin as preflight cache key for tainted requests\n\nPreviously, PreflightController used the raw request_initiator as the\ncache key for both cache insertion and lookup without checking the\ntainted origin flag. As a result, a preflight response allowed for\n'Origin: null' after a cross-origin redirect was cached under the\nrequest initiator's origin, which incorrectly allowed subsequent\nuntainted requests to skip preflight (and vice-versa).\n\nThis CL updates PreflightController to use an opaque origin\n(url::Origin()) as the cache key when the request origin is tainted.\nThis isolates tainted preflight cache entries from untainted requests\nand matches the behavior of WebKit and Gecko.\n\nA killswitch feature (kCorsPreflightCacheKeyTaintedOrigin) is added\nand enabled by default.\n\nBug: 543464436\nChange-Id: I0cfa366c26a20d9abee172d6cd4e8b05402ff891\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8260150\nReviewed-by: Kenichi Ishibashi \u003cbashi@chromium.org\u003e\nCommit-Queue: Takashi Toyoshima \u003ctoyoshim@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681108}\n\n--\n\nwpt-commits: d520278782f288a273563d81fcf300108046852b\nwpt-pr: 62009\n", "files": ["testing/web-platform/tests/fetch/api/cors/cors-preflight-cache-tainted.any.js"], "git_node": "7aa8262a9c517f1ef4e423fbf9101a7d644934fd", "git_parents": ["60b849bd6b955dcbe6be23deb8c8d732c6b06b3c"], "node": "511e2e8f0c1800a9ba1707606072d832eb478717", "parents": ["2dbcbe3bdb5eef220b3f6a76e9c45130c716ab4e"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2064301 [wpt PR 62011] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321024, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=321024 (#62011)\n--\n\nwpt-commits: c314e40fba32820aa067b428b800dcce06d64cb9\nwpt-pr: 62011\n", "files": ["testing/web-platform/tests/css/css-grid/subgrid/subgridded-axis-content-distribution-001.html"], "git_node": "b8020f928916982fb0563fdb0bf15525444d0b48", "git_parents": ["7aa8262a9c517f1ef4e423fbf9101a7d644934fd"], "node": "1a3470f01242da48f62f41fffa1dff4a052a9eba", "parents": ["511e2e8f0c1800a9ba1707606072d832eb478717"], "tags": []}, {"author": "Psychpsyo (Cameron) \u003c60073468+Psychpsyo@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064207 [wpt PR 61998] - script: Make inserttext handle surrogate pairs correctly., a=testonly\n\nAutomatic update from web-platform-tests\nscript: Make inserttext handle surrogate pairs correctly.\n\nSigned-off-by: Psychpsyo (Cameron) \u003c60073468+Psychpsyo@users.noreply.github.com\u003e\n\n--\n\nwpt-commits: fbce6980ae26eca1129d120c7f1f60fe91223f25\nwpt-pr: 61998\n", "files": ["testing/web-platform/tests/editing/other/insert-text-with-surrogate-pairs.html"], "git_node": "c8f2b59889134d3c7cb25c340acf9b323f28d30b", "git_parents": ["b8020f928916982fb0563fdb0bf15525444d0b48"], "node": "668f6efbe221dea0df071ef8e03c448737887fd0", "parents": ["1a3470f01242da48f62f41fffa1dff4a052a9eba"], "tags": []}, {"author": "Javier Fern\u00e1ndez Garc\u00eda-Boente \u003cjfernandez@igalia.com\u003e", "branch": "default", "desc": "Bug 2063760 [wpt PR 61951] - [Typed OM] Support \u003ccustom-ident\u003e in StylePropertyMap.set(), a=testonly\n\nAutomatic update from web-platform-tests\n[Typed OM] Support \u003ccustom-ident\u003e in StylePropertyMap.set()\n\nset() could not set a \u003ccustom-ident\u003e on any property.\nCSSOMKeywords::ValidKeywordForProperty only knows the keywords a\nproperty enumerates in css_properties.json5 and rejected anything else,\nso set('animation-name', new CSSKeywordValue('slide')) threw \"Invalid\ntype for property\" while element.style.animationName = 'slide' worked.\nSame for container-name and page.\n\nAdd a json5 flag, typedom_custom_ident, on the three properties whose\ngrammar takes a \u003ccustom-ident\u003e. An enumerated table cannot decide\nvalidity for them, since a \u003ccustom-ident\u003e excludes only the CSS-wide\nkeywords, 'default' and whatever the property itself reserves. So rather\nthan reimplement each grammar in generated code, ValidKeywordForProperty\naccepts any identifier for these properties and StyleValueToCSSValue\nparses the value against the property's own grammar. set() now throws\nexactly when the CSS parser rejects the value, for both the\nCSSKeywordValue and the string overload.\n\nParsing also yields the CSSValue shape each property stores, so only\ncontainer-name needs more than the flag: it keeps a single name in a\nspace-separated list, so reification unwraps a one-element list back\ninto a CSSKeywordValue. Properties without the flag are unaffected.\n\nBug: 40682424\nChange-Id: Ieecb04cc68d0d5883f246c63f4df300cb372e691\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8196029\nReviewed-by: Anders Hartvoll Ruud \u003candruud@chromium.org\u003e\nCommit-Queue: Javier Fernandez \u003cjfernandez@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1681204}\n\n--\n\nwpt-commits: e60759c7112790471cd068685668897d5b56f2b4\nwpt-pr: 61951\n", "files": ["testing/web-platform/tests/css/css-typed-om/the-stylepropertymap/properties/animation-name.html", "testing/web-platform/tests/css/css-typed-om/the-stylepropertymap/properties/container-name.html", "testing/web-platform/tests/css/css-typed-om/the-stylepropertymap/properties/page.html", "testing/web-platform/tests/css/css-typed-om/the-stylepropertymap/properties/resources/testsuite.js"], "git_node": "55ec2a30f1267387cd088866651b5e7fdabd02b2", "git_parents": ["c8f2b59889134d3c7cb25c340acf9b323f28d30b"], "node": "931329d94b4510dc8f3a69348d73400c94674704", "parents": ["668f6efbe221dea0df071ef8e03c448737887fd0"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2064254 [wpt PR 62002] - Don't fire lifecycle events for streamHTML fragment parser, a=testonly\n\nAutomatic update from web-platform-tests\nDon't fire lifecycle events for streamHTML fragment parser\n\nSpec-wise, this parser is run in a separate document, so the current\ndocument should not change state due to it finishing.\n\nThis fixes a crash.\n\nAdded multiple tests around streaming script executions to cover\nadjacent issues and prevent future crashes in this area.\n\nBug: 545823947\nChange-Id: Ibb85a5a47f121fdce95794947717a4d139ac17c8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8264070\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1681220}\n\n--\n\nwpt-commits: 599b541ef45bc3747f439bec71490c725b832423\nwpt-pr: 62002\n", "files": ["testing/web-platform/tests/domparsing/tentative/stream-html-defer-async-script.html", "testing/web-platform/tests/domparsing/tentative/stream-html-parser-blocking-script.html"], "git_node": "423309ee5c47294e538de6350593f9486766b8c8", "git_parents": ["55ec2a30f1267387cd088866651b5e7fdabd02b2"], "node": "56560f10b3dfc90a0f0bc17279f2916d72dfdc2c", "parents": ["931329d94b4510dc8f3a69348d73400c94674704"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064254 [wpt PR 62002] - Update wpt metadata, a=testonly\n\nwpt-pr: 62002\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/tentative/stream-html-defer-async-script.html.ini", "testing/web-platform/meta/domparsing/tentative/stream-html-parser-blocking-script.html.ini"], "git_node": "bed0b66bc0f46f3d03f84169a61e8e4e4ab8f860", "git_parents": ["423309ee5c47294e538de6350593f9486766b8c8"], "node": "7c68575970574e1a91b72fa48f9c0aca7beb1b60", "parents": ["56560f10b3dfc90a0f0bc17279f2916d72dfdc2c"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2064257 [wpt PR 62003] - Reland: Fragment includes with \u003ctemplate for=\"...\" src\u003e, a=testonly\n\nAutomatic update from web-platform-tests\nReland: Fragment includes with \u003ctemplate for=\"...\" src\u003e\n\nWhen \u003ctemplate for=\"...\" has a src attribute, its content is fetched and\napplied at the template's destination location.\n\nIt respects fetching modifiers\n(nonce/integrity/crossorigin/referrerpolicy), though cannot be\ndowngraded to no-cors.\n\nAtm, \u003ctemplate src\u003e cannot be parser blocking.\n\nFix flakiness in\nexternal/wpt/html/dom/partial-updates/tentative/fragment/src-buffered.sub.html\nby using stash/uuids instead of timeouts.\n(this was the cause of previous revert)\n\nBug: 535664974\nChange-Id: I16483c16a37294771d48a2101494d29ecf6da096\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8250902\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681221}\n\n--\n\nwpt-commits: b6aa9c2470eb25c7a4f59b4036b46c16cbdc60a4\nwpt-pr: 62003\n", "files": ["testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/empty-for-streaming.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/src-buffered.sub.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/src-cancel.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/src-csp-cors.sub.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/src-csp.sub.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/src-nonce.sub.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/src-nonce.sub.html.headers", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/src-parser-blocking.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/src-referrerpolicy.sub.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/src-sri.sub.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/src-streaming.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/resources/chunked-html.py"], "git_node": "2c14a8d3e12d847352effa3dccc65e81cb311f22", "git_parents": ["bed0b66bc0f46f3d03f84169a61e8e4e4ab8f860"], "node": "570f9150fda886b43d1575dd7c9df565d826019c", "parents": ["7c68575970574e1a91b72fa48f9c0aca7beb1b60"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064257 [wpt PR 62003] - Update wpt metadata, a=testonly\n\nwpt-pr: 62003\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/src-buffered.sub.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/src-csp-cors.sub.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/src-nonce.sub.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/src-parser-blocking.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/src-referrerpolicy.sub.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/src-sri.sub.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/src-streaming.html.ini"], "git_node": "27d9474782b9f7b3dacd74d436a9777eb0ffd42a", "git_parents": ["2c14a8d3e12d847352effa3dccc65e81cb311f22"], "node": "708b250c7bb671876b699d6698d362024248c479", "parents": ["570f9150fda886b43d1575dd7c9df565d826019c"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2056080 [wpt PR 61396] - Test foster parenting into a Document with an element child, a=testonly\n\nAutomatic update from web-platform-tests\nTest foster parenting into a Document with an element child\n\nWhen the HTML parser's adjusted insertion location is a Document that already\nhas an element child, the foster-parented node is dropped on the floor:\n\"insert an element at the adjusted insertion location\" aborts, and \"insert a\ncharacter\" likewise for text. This is reachable when script reparents an\non-stack \u003ctable\u003e to be a Document's document element.\n\n- resources/scripted_foster01.dat: same-document element and text cases.\n- foster-parenting-into-document-with-element-child.html: the multi-document\n  case, where the foster target is a separate Document.\n\nSee https://github.com/whatwg/html/issues/1706\n\n--\n\nwpt-commits: 34178abdb6c7d9b74d3e8958448ddab0f6b1caee\nwpt-pr: 61396\n", "files": ["testing/web-platform/tests/html/syntax/parsing/foster-parenting-into-document-with-element-child.html", "testing/web-platform/tests/html/syntax/parsing/html5lib_url.html", "testing/web-platform/tests/html/syntax/parsing/html5lib_write.html", "testing/web-platform/tests/html/syntax/parsing/html5lib_write_single.html", "testing/web-platform/tests/html/syntax/parsing/resources/scripted_foster01.dat"], "git_node": "c7ad4bb76143cddac105d8aeca81db53beeb5bd6", "git_parents": ["27d9474782b9f7b3dacd74d436a9777eb0ffd42a"], "node": "01d92b3e9d76c5f9f1e6a79ac571eac8ff9cef6d", "parents": ["708b250c7bb671876b699d6698d362024248c479"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056080 [wpt PR 61396] - Update wpt metadata, a=testonly\n\nwpt-pr: 61396\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/syntax/parsing/foster-parenting-into-document-with-element-child.html.ini"], "git_node": "6ef555ffc89fe08bdf0d106a4528833103e1f09f", "git_parents": ["c7ad4bb76143cddac105d8aeca81db53beeb5bd6"], "node": "8d22d6d386603d86084170aafec580395908c71a", "parents": ["01d92b3e9d76c5f9f1e6a79ac571eac8ff9cef6d"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2056083 [wpt PR 61398] - Test the adoption agency when script reparents nodes during parsing, a=testonly\n\nAutomatic update from web-platform-tests\nTest the adoption agency when script reparents nodes during parsing\n\nThe adoption agency algorithm moves existing nodes (the furthest block and its\nancestors up to the common ancestor), assuming the DOM tree still matches the\nstack of open elements. An inline \u003cscript\u003e that runs before the misnested end\ntag can reparent those nodes first \u2014 detaching them, moving them into another\nDocument, or nesting them so that a subsequent move would create a cycle.\n\nadoption-agency-reparenting.html covers the well-formed cases (detach, adopt into\nanother Document, foster-parented common ancestor); these are interoperable\nacross engines. The cycle-inducing cases are split into separate files\n(adoption-agency-reparenting-cycle.html and -inner-loop-cycle.html) so a crash in\none does not hide the others.\n--\n\nwpt-commits: ed37f83e79426194b075cfc29a5454894ae6f36f\nwpt-pr: 61398\n", "files": ["testing/web-platform/tests/html/syntax/parsing/adoption-agency-reparenting-cycle.html", "testing/web-platform/tests/html/syntax/parsing/adoption-agency-reparenting-document-target.html", "testing/web-platform/tests/html/syntax/parsing/adoption-agency-reparenting-inner-loop-cycle.html", "testing/web-platform/tests/html/syntax/parsing/adoption-agency-reparenting-pagehide.tentative.html", "testing/web-platform/tests/html/syntax/parsing/adoption-agency-reparenting-shadow-cycle.html", "testing/web-platform/tests/html/syntax/parsing/adoption-agency-reparenting-template-cycle.html", "testing/web-platform/tests/html/syntax/parsing/adoption-agency-reparenting.html", "testing/web-platform/tests/html/syntax/parsing/resources/adoption-agency-reparenting.js"], "git_node": "0eafd66a5c8e53477ed0799e198ff4a3624c4c0c", "git_parents": ["6ef555ffc89fe08bdf0d106a4528833103e1f09f"], "node": "0ede9c434afb33d4c46f3df8d959a5bd8d18980d", "parents": ["8d22d6d386603d86084170aafec580395908c71a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056083 [wpt PR 61398] - Update wpt metadata, a=testonly\n\nwpt-pr: 61398\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/syntax/parsing/adoption-agency-reparenting-document-target.html.ini", "testing/web-platform/meta/html/syntax/parsing/adoption-agency-reparenting-shadow-cycle.html.ini", "testing/web-platform/meta/html/syntax/parsing/adoption-agency-reparenting-template-cycle.html.ini"], "git_node": "e09d771c9950bb96f8c10724cec5ea979f44c845", "git_parents": ["0eafd66a5c8e53477ed0799e198ff4a3624c4c0c"], "node": "c47387d07d7bda6e5f91cb6857569c0e2c46e505", "parents": ["0ede9c434afb33d4c46f3df8d959a5bd8d18980d"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2064259 [wpt PR 62004] - Tighten streamHTML WPT coverage, a=testonly\n\nAutomatic update from web-platform-tests\nTighten streamHTML WPT coverage\n\nThis CL expands web-platform-test coverage for HTML streaming partial\nupdates (`streamHTML`, `streamAppendHTML`, `streamPrependHTML`,\n`streamBeforeHTML`, `streamAfterHTML`, `streamReplaceWithHTML`, and\nunsafe variants) based on feedback in wpt/pull/61748:\n1. Tokenizer Contexts: Added tests for context-dependent tokenizer\n   initialization (`\u003ctitle\u003e`/`\u003ctextarea\u003e` RCDATA, `\u003cstyle\u003e` RAWTEXT,\n   `\u003cplaintext\u003e` PLAINTEXT, `\u003cscript\u003e` Script data, and `\u003cnoscript\u003e`\n   in scripting-enabled vs. scripting-disabled documents) across write\n   chunk splits.\n2. SVG `\u003cscript\u003e`: Added tests verifying safe streaming methods\n   targeting SVG `\u003cscript\u003e` elements do not execute scripts.\n3. Fragment Parsing Contexts: Added tests for table-family (`\u003ctable\u003e`,\n   `\u003ctbody\u003e`, `\u003ctr\u003e`), select-family (`\u003cselect\u003e`, `\u003coption\u003e`), and\n   SVG/MathML foreign content contexts.\n4. Resource Fetch Prevention: Added server-observable stash tests\n   verifying that sanitizing `src` on `\u003cimg\u003e` prevents network requests.\n5. Customized Built-ins: Added tests verifying that sanitizing `is`\n   on `\u003cbutton is=\"x-button\"\u003e` blocks custom element construction.\n6. Trusted Types Typo: Fixed a string concatenation syntax error in\n   `stream-html-with-trusted-types-runScripts-off.html`.\n\nBug: 491743369\nChange-Id: I39735ab2d739f772b3801534c755ed7639dd2608\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8252459\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1681255}\n\n--\n\nwpt-commits: 569354118f684360d3f16b45d119ff0aead00f4e\nwpt-pr: 62004\n", "files": ["testing/web-platform/tests/domparsing/tentative/stream-fragment-context.html", "testing/web-platform/tests/domparsing/tentative/stream-html-script-safe.html", "testing/web-platform/tests/domparsing/tentative/stream-html-with-trusted-types-runScripts-off.html", "testing/web-platform/tests/domparsing/tentative/stream-sanitizer-customized-builtins.html", "testing/web-platform/tests/domparsing/tentative/stream-sanitizer-resource-fetch.html", "testing/web-platform/tests/domparsing/tentative/stream-tokenizer-context.html"], "git_node": "c5fb62074f40c2d664bec4660dbcae5f5a334e96", "git_parents": ["e09d771c9950bb96f8c10724cec5ea979f44c845"], "node": "d9184daf7fb221a62c8dc4d6f3ea6bcae80a82bd", "parents": ["c47387d07d7bda6e5f91cb6857569c0e2c46e505"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064259 [wpt PR 62004] - Update wpt metadata, a=testonly\n\nwpt-pr: 62004\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/tentative/stream-fragment-context.html.ini", "testing/web-platform/meta/domparsing/tentative/stream-sanitizer-customized-builtins.html.ini", "testing/web-platform/meta/domparsing/tentative/stream-sanitizer-resource-fetch.html.ini", "testing/web-platform/meta/domparsing/tentative/stream-tokenizer-context.html.ini"], "git_node": "d9e87577eee23696c64caecc36e1e822a4617945", "git_parents": ["c5fb62074f40c2d664bec4660dbcae5f5a334e96"], "node": "d3b40805eccd8ed318841992b426b295d89b9b97", "parents": ["d9184daf7fb221a62c8dc4d6f3ea6bcae80a82bd"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2053634 [wpt PR 61155] - Add MutationObserver replaceChildren childList tests, a=testonly\n\nAutomatic update from web-platform-tests\nAdd MutationObserver replaceChildren childList tests\n\nCover the case where replaceChildren() receives a node that is already a child. Unlike replaceChild()'s \"replace\" algorithm, \"replace all\" does not adopt the argument before removing the existing children, so an already-present argument is folded into the single record rather than producing a separate removal record.\n\nSee https://github.com/whatwg/dom/issues/814.\n\n--\n\nwpt-commits: 728cee2ea40f85a8d6c37bca1ff71ecdf4dd829d\nwpt-pr: 61155\n", "files": ["testing/web-platform/tests/dom/nodes/MutationObserver-childList.html"], "git_node": "c89202b37decc4f1c66a0c31f0b4e108d461ebbb", "git_parents": ["d9e87577eee23696c64caecc36e1e822a4617945"], "node": "6b651b54d225d8b5dd45bd8a84463409df6ad0a7", "parents": ["d3b40805eccd8ed318841992b426b295d89b9b97"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@google.com\u003e", "branch": "default", "desc": "Bug 2064422 [wpt PR 62019] - Remove tests for disallowed owed-crossorigin simple dialogs, a=testonly\n\nAutomatic update from web-platform-tests\nRemove tests for disallowed owed-crossorigin simple dialogs\n\nThese tests cover a feature that was never shipped.\n\nSee https://github.com/whatwg/html/pull/12794\n\n--\n\nwpt-commits: abd18a776a4180f7570617af8e26d2e2a6590023\nwpt-pr: 62019\n", "files": ["testing/web-platform/tests/html/webappapis/user-prompts/cannot-show-simple-dialogs/WEB_FEATURES.yml", "testing/web-platform/tests/html/webappapis/user-prompts/cannot-show-simple-dialogs/confirm-different-origin-frame.sub.html", "testing/web-platform/tests/html/webappapis/user-prompts/cannot-show-simple-dialogs/prompt-different-origin-frame.sub.html", "testing/web-platform/tests/html/webappapis/user-prompts/cannot-show-simple-dialogs/support/confirm.html", "testing/web-platform/tests/html/webappapis/user-prompts/cannot-show-simple-dialogs/support/prompt.html"], "git_node": "fce9f4f702c6701fe9d04e2361d1859c294d9060", "git_parents": ["c89202b37decc4f1c66a0c31f0b4e108d461ebbb"], "node": "a8fd43f9ffe27b8d4145c42591cc46b23b2c8f9b", "parents": ["6b651b54d225d8b5dd45bd8a84463409df6ad0a7"], "tags": []}, {"author": "Josh Matthews \u003cjosh@joshmatthews.net\u003e", "branch": "default", "desc": "Bug 2064180 [wpt PR 61994] - Update stylo for clip-path damage change., a=testonly\n\nAutomatic update from web-platform-tests\nUpdate stylo for clip-path damage change.\n\nSigned-off-by: Josh Matthews \u003cjosh@joshmatthews.net\u003e\n\n--\n\nwpt-commits: 7b4ed9fa6c53369585e1e9592ac304b0cb674155\nwpt-pr: 61994\n", "files": ["testing/web-platform/tests/css/css-masking/clip-path/clip-path-change-ref.html", "testing/web-platform/tests/css/css-masking/clip-path/clip-path-change.html"], "git_node": "aca9f95475ed4d613ddb193d41af03daf8af9cc7", "git_parents": ["fce9f4f702c6701fe9d04e2361d1859c294d9060"], "node": "db250a21b762c9f0e702a8261eb5c30cfe87345f", "parents": ["a8fd43f9ffe27b8d4145c42591cc46b23b2c8f9b"], "tags": []}, {"author": "Yoav Weiss \u003cyoavweiss@chromium.org\u003e", "branch": "default", "desc": "Bug 2064393 [wpt PR 62016] - Trim the fallback of an env() function, a=testonly\n\nAutomatic update from web-platform-tests\nTrim the fallback of an env() function\n\nenv()'s argument grammar is\n\n  env( \u003ccustom-ident\u003e \u003cinteger [0,\u221e]\u003e*, \u003cdeclaration-value\u003e? )\n\nso the whitespace following the comma separates the grammar's components\nand is not part of the \u003cdeclaration-value\u003e that gets substituted. We were\nsubstituting it along with the fallback:\n\n  --a: env(unknown-name, 10px);   /* computed to \" 10px\" */\n\nResolveEnvInto() was the only fallback path that neither skipped the\nwhitespace after the comma nor went through AppendFallback(), so it also\nkept the trailing whitespace and comments that var() trims:\n\n  --a: env(unknown-name, 10px   ) 5px;  /* computed to \"10px    5px\" */\n\nFix by resolving the fallback through AppendDataWithFallback(), which is\nwhat var() uses.\n\nBesides producing wrong computed values, the leading whitespace could\ncrash us: if such a value ends up first in a var() fallback,\nAppendFallback() hits the DCHECK in\nStripTrailingWhitespaceAndComments() that the value has no leading\nwhitespace.\n\nCo-Authored-By: AI (Claude Opus 5 via Pi) \u003cnoreply@pi.dev\u003e\nBug: 543070692\nChange-Id: I44779352fbbd2ec022821769f3097a9da72f2ccf\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8263272\nReviewed-by: Anders Hartvoll Ruud \u003candruud@chromium.org\u003e\nCommit-Queue: Yoav Weiss (@Shopify) \u003cyoavweiss@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681375}\n\n--\n\nwpt-commits: f329e2d17a6d07e71a0dab908a49f80757d2ecc1\nwpt-pr: 62016\n", "files": ["testing/web-platform/tests/css/css-env/env-fallback-substitution.html"], "git_node": "adab3253ee767fda16ee797b8d977bd095bb1f7c", "git_parents": ["aca9f95475ed4d613ddb193d41af03daf8af9cc7"], "node": "845bd8c95334a40f2aafd0812faf1c9f36b68429", "parents": ["db250a21b762c9f0e702a8261eb5c30cfe87345f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064393 [wpt PR 62016] - Update wpt metadata, a=testonly\n\nwpt-pr: 62016\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-env/env-fallback-substitution.html.ini"], "git_node": "ee3cc249140107ff5753acf9551a4dbb7b250c9c", "git_parents": ["adab3253ee767fda16ee797b8d977bd095bb1f7c"], "node": "1222d2a5720b40d59d728067eb138eb67d033e97", "parents": ["845bd8c95334a40f2aafd0812faf1c9f36b68429"], "tags": []}, {"author": "Stephen McGruer \u003csmcgruer@chromium.org\u003e", "branch": "default", "desc": "Bug 2057334 [wpt PR 61502] - Add initial Payment Method Manifest WPT test directory and a basic test, a=testonly\n\nAutomatic update from web-platform-tests\nAdd initial Payment Method Manifest directory and a basic test (#61502)\n\nThis PR is the first in a series adding testing coverage for the [Payment Method Manifest](https://w3c.github.io/payment-method-manifest) specification. Previously that specification was partially tested by the tests in `web-based-payment-handler`, but those tests both did not fully exercise the Payment Method Manifest spec and also obviously relied on Web-Based Payment Handlers being supported.\n\nTo test the Payment Method Manifest specification, which is largely about processing manifests hosted by payment app providers, this test suite relies on a set of test servers that can produce output for the user agent under test to process. Requests are logged to a stash for latest verification against expectations.\n\nThis first PR adds:\n\n- A README.md and META.yml file for the directory\n- A `resources/payment-method-identifier.py` server for handling the initial HEAD request to the payment method identifier passed to Payment Request.\n- A `resources/payment-method-manifest.py` server for handling the subsequent GET request for the payment method manifest.\n- A `resources/stash-query.py` server for tests to query for server logs when making assertions\n- A `resources/helpers.js`file with helpers to create a payment method identifier URL pointing at the server, and to retrieve logs from the stash server.\n- A basic test of payment method manifest fetching/processing, `link-header-basic-success.https.window.js\u200e`.\n\nFuture PRs will add more thorough tests, develop the servers for more functionality, and add a server for the web-app manifest fetches.\n--\n\nwpt-commits: 4a7fc8bcef76d5e807b9ac31349fc2cac6050a5b\nwpt-pr: 61502\n", "files": ["testing/web-platform/tests/payment-method-manifest/META.yml", "testing/web-platform/tests/payment-method-manifest/README.md", "testing/web-platform/tests/payment-method-manifest/link-header-basic-success.https.window.js", "testing/web-platform/tests/payment-method-manifest/resources/helpers.js", "testing/web-platform/tests/payment-method-manifest/resources/payment-method-identifier.py", "testing/web-platform/tests/payment-method-manifest/resources/payment-method-manifest.py", "testing/web-platform/tests/payment-method-manifest/resources/server_constants.py", "testing/web-platform/tests/payment-method-manifest/resources/stash-query.py"], "git_node": "54166e28613de05658de512dff348917693eab90", "git_parents": ["ee3cc249140107ff5753acf9551a4dbb7b250c9c"], "node": "585cd7b6abff9531499fe6d6d3d42cdda50a47bb", "parents": ["1222d2a5720b40d59d728067eb138eb67d033e97"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057334 [wpt PR 61502] - Update wpt metadata, a=testonly\n\nwpt-pr: 61502\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/payment-method-manifest/link-header-basic-success.https.window.js.ini"], "git_node": "aa29bfaf1d9859a0f87a08141d58b227a47a2f5d", "git_parents": ["54166e28613de05658de512dff348917693eab90"], "node": "1a26caf17429fc271f3fcba0c106cfd28e87966f", "parents": ["585cd7b6abff9531499fe6d6d3d42cdda50a47bb"], "tags": []}, {"author": "Simon Binder \u003coss@simonbinder.eu\u003e", "branch": "default", "desc": "Bug 2062232 [wpt PR 61829] - Web locks: Test that refreshing a window owning a worker holding a lock releases the lock, a=testonly\n\nAutomatic update from web-platform-tests\nWeb locks: Test that refreshing a window owning a worker holding a lock releases the lock (#61829)\n\n* Test locks in worker in refreshed windows\n\n* Simplify, rely on timeouts\n\n* comment change\n\n---------\n\nCo-authored-by: Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e\n--\n\nwpt-commits: ce5d9e7e28b27528213bceea40d9e78462487105\nwpt-pr: 61829\n", "files": ["testing/web-platform/tests/web-locks/resources/window.html", "testing/web-platform/tests/web-locks/windows.https.window.js"], "git_node": "7575208ea4ce7f5b8af78213e423be87c7babd43", "git_parents": ["aa29bfaf1d9859a0f87a08141d58b227a47a2f5d"], "node": "e6768951eded39d5dae5f17f4117130a0847625c", "parents": ["1a26caf17429fc271f3fcba0c106cfd28e87966f"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2064219 [wpt PR 61999] - vt: Update view transition rounding logic for subpixel offsets, a=testonly\n\nAutomatic update from web-platform-tests\nvt: Update view transition rounding logic for subpixel offsets\n\nPreviously we were rounding and flooring things in cc, because the scale\nis baked into the captured texture. This is still true, but we also need\nto consider when the transform of the vt-new and old themselves are\ntranslated independently, so we need to do the original offset tracking\nand snapping at the time that we actually replace the quad in viz.\n\nThis patch does that.\n\nR=khushalsagar@chromium.org\n\nBug: 542873382\nChange-Id: Ibbc83118fa422061b4b058f2c232e7216a32d2f1\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8250499\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681405}\n\n--\n\nwpt-commits: 6f63ce724f551e47ece301b2fed37d091abd72c0\nwpt-pr: 61999\n", "files": ["testing/web-platform/tests/css/css-view-transitions/fractional-translation-from-transform-old.html", "testing/web-platform/tests/css/css-view-transitions/new-content-subpixel-last-frame-ref.html", "testing/web-platform/tests/css/css-view-transitions/new-content-subpixel-last-frame.html"], "git_node": "2c379e3668ff63ee4d6717509f215ae59831653f", "git_parents": ["7575208ea4ce7f5b8af78213e423be87c7babd43"], "node": "41c51c958b9b2b43922b5aefbbf52efd604f0ea7", "parents": ["e6768951eded39d5dae5f17f4117130a0847625c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064219 [wpt PR 61999] - Update wpt metadata, a=testonly\n\nwpt-pr: 61999\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-view-transitions/pseudo-element-animations-rerun.html.ini"], "git_node": "958e608cb0c6c644121e0f10c64381beecb6aa0a", "git_parents": ["2c379e3668ff63ee4d6717509f215ae59831653f"], "node": "f4ac040b205f0a48aca5c772625339013c54642b", "parents": ["41c51c958b9b2b43922b5aefbbf52efd604f0ea7"], "tags": []}, {"author": "Morten Stenshorne \u003cmstensho@chromium.org\u003e", "branch": "default", "desc": "Bug 2064146 [wpt PR 61989] - [RouteMatching] Support @navigation in @function., a=testonly\n\nAutomatic update from web-platform-tests\n[RouteMatching] Support @navigation in @function.\n\nImplement @navigation in FlattenFunctionBody().\n\nTAG=agy\nCONV=4e9f32d8-6b97-49c5-b84d-a6d73dd77ee4\n\nBug: 493044687, 436805487\nChange-Id: Ib498aa026422ac171921d0d257db684c656d22ba\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8256405\nCommit-Queue: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681439}\n\n--\n\nwpt-commits: ccc841397962793461779fde1f05c816a4517b75\nwpt-pr: 61989\n", "files": ["testing/web-platform/tests/css/css-navigation/tentative/function-001.html", "testing/web-platform/tests/css/css-navigation/tentative/function-002.html"], "git_node": "bd4efd29e74489babc6f5f67d69ae4eea0d9a1f7", "git_parents": ["958e608cb0c6c644121e0f10c64381beecb6aa0a"], "node": "27d865de3b0541b1a13e29e95ac992b3d2e0a0d9", "parents": ["f4ac040b205f0a48aca5c772625339013c54642b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064146 [wpt PR 61989] - Update wpt metadata, a=testonly\n\nwpt-pr: 61989\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-navigation/tentative/function-001.html.ini", "testing/web-platform/meta/css/css-navigation/tentative/function-002.html.ini"], "git_node": "d95fe0ba286532609651b9686394238355b3104b", "git_parents": ["bd4efd29e74489babc6f5f67d69ae4eea0d9a1f7"], "node": "b589ea04dba86a63bfcc1fd9cf06a365f902709c", "parents": ["27d865de3b0541b1a13e29e95ac992b3d2e0a0d9"], "tags": []}, {"author": "Morten Stenshorne \u003cmstensho@chromium.org\u003e", "branch": "default", "desc": "Bug 2064406 [wpt PR 62018] - [RouteMatching] @location and url-pattern() serialization., a=testonly\n\nAutomatic update from web-platform-tests\n[RouteMatching] @location and url-pattern() serialization.\n\nAlso make CSSURLPatternValue::TraceAfterDispatch() inline. This\noverride is needed due to manual dispatch in CSSValue::Trace().\n\nTAG=agy\nCONV=cd19c5fd-09c5-497f-ad15-b36c7cc8df11\n\nBug: 436805487\nChange-Id: I0883581cb7a5ca2289121ed2aacc47d1cb7e9d6e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8266802\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCommit-Queue: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681440}\n\n--\n\nwpt-commits: ac735f750a7bd5d7312675d963f68239ed31ce76\nwpt-pr: 62018\n", "files": ["testing/web-platform/tests/css/css-navigation/tentative/parsing/location-valid.html"], "git_node": "ab32b45ba3ab1f1433b8500f961dd349ed675c98", "git_parents": ["d95fe0ba286532609651b9686394238355b3104b"], "node": "26937f41d4c2a9599f9704c6129f84087bdac091", "parents": ["b589ea04dba86a63bfcc1fd9cf06a365f902709c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064406 [wpt PR 62018] - Update wpt metadata, a=testonly\n\nwpt-pr: 62018\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-navigation/tentative/parsing/location-valid.html.ini"], "git_node": "da21aa32171ee5d716f31a746564fd5b24faa8f7", "git_parents": ["ab32b45ba3ab1f1433b8500f961dd349ed675c98"], "node": "b19b1b310e0dbcc8c61238b55454319dbedc7a15", "parents": ["26937f41d4c2a9599f9704c6129f84087bdac091"], "tags": []}, {"author": "Joanne Pan \u003c71951015+J0pan@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2063522 [wpt PR 61934] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321702, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=321702 (#61934)\n--\n\nwpt-commits: 9d29b5b89e268e0099058eac9cf41e5496fbbb15\nwpt-pr: 61934\n", "files": ["testing/web-platform/tests/css/css-values/random-item-computed.html"], "git_node": "34402c00ce99fd8c76f3b4b84619d63ee9b53cb6", "git_parents": ["da21aa32171ee5d716f31a746564fd5b24faa8f7"], "node": "9d879f6f0cdbd8a5559a142cc365e0448b55e4f3", "parents": ["b19b1b310e0dbcc8c61238b55454319dbedc7a15"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063522 [wpt PR 61934] - Update wpt metadata, a=testonly\n\nwpt-pr: 61934\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/random-item-computed.html.ini"], "git_node": "5df624d5ddf337c43c410bda0b16210564c83a0e", "git_parents": ["34402c00ce99fd8c76f3b4b84619d63ee9b53cb6"], "node": "05e59da6647ea978683dc4574e14e6b62a7ba031", "parents": ["9d879f6f0cdbd8a5559a142cc365e0448b55e4f3"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2064488 [wpt PR 62022] - Fix infinite iframe recursion in form-submit-action.html, a=testonly\n\nAutomatic update from web-platform-tests\nFix infinite iframe recursion in form-submit-action.html\n\nform-submit-action.html tests submitting forms to the document's own\nURL inside targeted iframes, which causes the test script to re-execute\nin subframes recursively.\n\nGuard test execution to the top frame and ignore the initial about:blank\nload event.\n\nFixed: 543940216\nChange-Id: Iea8a7a3d0c672839dd5dec267682352d12285775\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8252930\nReviewed-by: David Grogan \u003cdgrogan@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681508}\n\n--\n\nwpt-commits: 1d3050ab9127c140943246cb537a6a400dd04c91\nwpt-pr: 62022\n", "files": ["testing/web-platform/tests/html/semantics/forms/form-submission-0/form-submit-action.html"], "git_node": "b2f890b349c6841fc741d3544da1e6c2f0102d97", "git_parents": ["5df624d5ddf337c43c410bda0b16210564c83a0e"], "node": "88340be96271151fe54edb79b38dbc7a2a0a04c0", "parents": ["05e59da6647ea978683dc4574e14e6b62a7ba031"], "tags": []}, {"author": "Shubham Gupta \u003cshubhamg13.work@gmail.com\u003e", "branch": "default", "desc": "Bug 2063221 [wpt PR 61911] - layout: Consider Text as LCP candidate, a=testonly\n\nAutomatic update from web-platform-tests\nAdd check for paintTime in observe-text.html\n\nSigned-off-by: Shubham Gupta \u003cshubhamg13.work@gmail.com\u003e\n\n--\nUse t.step_func to make failures explicit\n\nSigned-off-by: Shubham Gupta \u003cshubhamg13.work@gmail.com\u003e\n\n--\n\nwpt-commits: 1716d10cae23bece5c93efd77d4b4a34a3d4777d, d4383219be314d2276af51af90249022440c267b\nwpt-pr: 61911\n", "files": ["testing/web-platform/tests/largest-contentful-paint/larger-text.html", "testing/web-platform/tests/largest-contentful-paint/observe-text.html", "testing/web-platform/tests/largest-contentful-paint/text-fragment-union.html"], "git_node": "c404f8d9ee3bf4855f566fb2e54e2fbb90fd0e0a", "git_parents": ["b2f890b349c6841fc741d3544da1e6c2f0102d97"], "node": "e508d5a1ecb449b26b95126196ba804d6556a1ac", "parents": ["88340be96271151fe54edb79b38dbc7a2a0a04c0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063221 [wpt PR 61911] - Update wpt metadata, a=testonly\n\nwpt-pr: 61911\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/largest-contentful-paint/text-fragment-union.html.ini"], "git_node": "3114f59d88261f06dab6b8de2fe5cd7303ecb85d", "git_parents": ["c404f8d9ee3bf4855f566fb2e54e2fbb90fd0e0a"], "node": "53f04a1ed384623d25eda1534585c041b08b598d", "parents": ["e508d5a1ecb449b26b95126196ba804d6556a1ac"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2063643 [wpt PR 61939] - Update CODEOWNERS, a=testonly\n\nAutomatic update from web-platform-tests\nAutomated update of CODEOWNERS\n\n--\n\nwpt-commits: 6ee2197aca7ef1cd1061147070f06ef751f7dc7f\nwpt-pr: 61939\n", "files": ["testing/web-platform/tests/CODEOWNERS"], "git_node": "4192eb11ff48f601e4b176a38d00483bb318ac03", "git_parents": ["3114f59d88261f06dab6b8de2fe5cd7303ecb85d"], "node": "af4dbcb4d155b89812d25bef89ec914f967fb6fc", "parents": ["53f04a1ed384623d25eda1534585c041b08b598d"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2064539 [wpt PR 62023] - [html-in-canvas] Add DrawElementOptions, auto transform updates, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Add DrawElementOptions, auto transform updates\n\nThis patch adds DrawElementOptions and implements automatic updating of\nthe element's canvas transform for the Element variant of\ndrawElementImage, leaving the ElementImage variant for a followup.\nDevelopers can disable automatic updating by using:\n  drawElementImage(..., { updateGeometry = false; });\n\nAutomatically updating the canvas element transform exposed an issue\nwhere canvas element transform changes would invalidate layout which\nwould always cause a repaint. This patch switches to directly updating\nthe PaintLayer transform in Element::SetCanvasTransformInternal, except\nwhen a layout is needed.\n\nBug: 532229486\nChange-Id: If1d53a1c1f37b927ddf50c8f23d918b40adc1c47\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8251458\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681768}\n\n--\n\nwpt-commits: 23c8d15f50d69ff8ef86563b3a066c8189a57358\nwpt-pr: 62023\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/canvas-transform-update.tentative.html"], "git_node": "daea8ba62d093914618effe4487b4d04645b28ee", "git_parents": ["4192eb11ff48f601e4b176a38d00483bb318ac03"], "node": "d8b5d8da155b0ab6653fa64127cb0e4a1b7e5224", "parents": ["af4dbcb4d155b89812d25bef89ec914f967fb6fc"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064539 [wpt PR 62023] - Update wpt metadata, a=testonly\n\nwpt-pr: 62023\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/canvas-transform-update.tentative.html.ini"], "git_node": "0c28adc64f9c8e93166c4d618cb910ba22166a6e", "git_parents": ["daea8ba62d093914618effe4487b4d04645b28ee"], "node": "458278ed0a554f1fbdb1895a849d3b6cae6af2eb", "parents": ["d8b5d8da155b0ab6653fa64127cb0e4a1b7e5224"], "tags": []}, {"author": "Kiet Ho \u003ckiet.ho@apple.com\u003e", "branch": "default", "desc": "Bug 2064581 [wpt PR 62030] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320705, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320705\n\n--\n\nwpt-commits: abfcb5653e9a92eb08687c6f43fea826e5bad168\nwpt-pr: 62030\n", "files": ["testing/web-platform/tests/css/css-conditional/at-supports-named-feature-001.html"], "git_node": "761993923558a2c0d8cfa700da73904cbb36376c", "git_parents": ["0c28adc64f9c8e93166c4d618cb910ba22166a6e"], "node": "1fdf54921eb850dd59e31b2f6439562a00a0ce21", "parents": ["458278ed0a554f1fbdb1895a849d3b6cae6af2eb"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064581 [wpt PR 62030] - Update wpt metadata, a=testonly\n\nwpt-pr: 62030\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-conditional/container-queries/whitespace-update-after-removal.html.ini"], "git_node": "dc7d99850528e59a0640b6f7de2a129735c5881e", "git_parents": ["761993923558a2c0d8cfa700da73904cbb36376c"], "node": "7750885dd16ed7dbcb4d9eda6e81e6d91b1ad1f9", "parents": ["1fdf54921eb850dd59e31b2f6439562a00a0ce21"], "tags": []}, {"author": "Stephen Chenney \u003cschenney@chromium.org\u003e", "branch": "default", "desc": "Bug 2064558 [wpt PR 62024] - [HiC] Verify we do not paint visited links when used with ::selection, a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Verify we do not paint visited links when used with ::selection\n\nIt is possible to set ::selection styling on visited and unvisited\nlink state. Make sure that the selection does not reveal visited\nstatus. It does not, we always draw the selection as if unvisited.\n\nBug: 518814556\nChange-Id: I3a002c04bc919a004deafbace6de144f011abdad\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8259101\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nAuto-Submit: Stephen Chenney \u003cschenney@chromium.org\u003e\nCommit-Queue: Stephen Chenney \u003cschenney@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681802}\n\n--\n\nwpt-commits: d0e979b57958f7b51ef9179f904706882c2db9b6\nwpt-pr: 62024\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/visited-link/visited-link-custom-selection-color-ignored.tentative.html"], "git_node": "d2d6fff36309f68b6821cb7a65d54399ae3e1642", "git_parents": ["dc7d99850528e59a0640b6f7de2a129735c5881e"], "node": "840de7f439943d0a77e2775259be2dfbfce372a7", "parents": ["7750885dd16ed7dbcb4d9eda6e81e6d91b1ad1f9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064558 [wpt PR 62024] - Update wpt metadata, a=testonly\n\nwpt-pr: 62024\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/visited-link/visited-link-custom-selection-color-ignored.tentative.html.ini"], "git_node": "4d86ba47fa1d73f66039212a767cc2e417d1d9cd", "git_parents": ["d2d6fff36309f68b6821cb7a65d54399ae3e1642"], "node": "e56ba6fbec0453653effc945f380db636487a5c2", "parents": ["840de7f439943d0a77e2775259be2dfbfce372a7"], "tags": []}, {"author": "Stephen Chenney \u003cschenney@chromium.org\u003e", "branch": "default", "desc": "Bug 2064562 [wpt PR 62025] - [HiC] Privacy protection for pseudo elements, a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Privacy protection for pseudo elements\n\nProtect private content in pseudo elements by setting IsInCanvasSubtree\nfor all pseudo elements. Add tests to cover the following:\n::first-line\n::first-letter\n::before and ::after\n::marker\n::details-content\n::details-content::after (to test nested pseudos)\n\nThere are still more to test but land this first and then add more,\nto get the protection in sooner. Testing everything will require\nseveral more days.\n\nFixed: 532904047\nChange-Id: I859b78904b7ac8980c548db593274c009c16fdb2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8253249\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Stephen Chenney \u003cschenney@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681817}\n\n--\n\nwpt-commits: acdcefd933cad53ed0df048d57d2c5bb6ad3e88e\nwpt-pr: 62025\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/pseudos/before-after-images-ignored.tentative