it_node": "35c02c4e1c8a5bc7454dfcc1dbc7b55c36d44f20", "git_parents": ["9942249b9330c81e8c2fc7024c0a29bf95938391"], "node": "3bcc3042297065c6e7c2d0cdc98e7bd2a510e3e6", "parents": ["d1510a65604aa77296c94b074e66bbba557f9c30"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2065965 -  Tolerate quoted booleans and per-entry errors in policy validation. r=bsmth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320759\n", "files": ["browser/components/enterprisepolicies/tests/xpcshell/test_PolicySchemaValidator.js", "browser/components/enterprisepolicies/tests/xpcshell/test_extensionsettings.js", "browser/components/enterprisepolicies/tests/xpcshell/test_preferences.js", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/PolicySchemaValidator.sys.mjs"], "git_node": "618ad267c49d0151572d9faa8557faee02fd9c44", "git_parents": ["35c02c4e1c8a5bc7454dfcc1dbc7b55c36d44f20"], "node": "1d88962cb6736348453e65761e2bbda948cb62ab", "parents": ["3bcc3042297065c6e7c2d0cdc98e7bd2a510e3e6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066095 - Swap kcochrane and sfoster in the theme triage owner rotation. r=kcochrane,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320892\n", "files": ["browser/themes/triage.json"], "git_node": "7eb745d1c0904f0b5d2da8210589791aecc5f726", "git_parents": ["618ad267c49d0151572d9faa8557faee02fd9c44"], "node": "df870056389ed0b86068fd1bc93fb7e9d8e17b75", "parents": ["1d88962cb6736348453e65761e2bbda948cb62ab"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2065678 - ./mach test-info: detect main branch if Git repository used. r=ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320976\n", "files": ["testing/testinfo.py"], "git_node": "b74d980eb1e335bf57858e4227167f518e474c9f", "git_parents": ["7eb745d1c0904f0b5d2da8210589791aecc5f726"], "node": "d8a89d3b5bd5fa7232a5350dfba118395254e3bc", "parents": ["df870056389ed0b86068fd1bc93fb7e9d8e17b75"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063731 - Don't leave a stale WebTaskSchedulingState behind when WebTask::Run bails out early r=dom-core-reviewers,smaug\n\nWebTask::Run sets the global's scheduling state before AutoJSAPI::Init, so if\nInit fails it returns without the matching clear at the end of the function,\nleaving the state set for whatever runs next. Nothing needs the state before\nInit, so set it after.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318861\n", "files": ["dom/webscheduling/WebTaskScheduler.cpp"], "git_node": "583e5200686f2c3a93908accb1c92542ef9fe44c", "git_parents": ["b74d980eb1e335bf57858e4227167f518e474c9f"], "node": "15aa8a4b3f1a11c52ced00f35c82871ae198de53", "parents": ["d8a89d3b5bd5fa7232a5350dfba118395254e3bc"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063731 - Move WebTaskSchedulingState to nsIGlobalObject r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318863\n", "files": ["dom/base/nsGlobalWindowInner.cpp", "dom/base/nsGlobalWindowInner.h", "dom/base/nsIGlobalObject.cpp", "dom/base/nsIGlobalObject.h", "dom/promise/tests/chrome.toml", "dom/promise/tests/test_scheduling_state_incumbent_hop.html", "dom/workers/WorkerScope.cpp", "dom/workers/WorkerScope.h"], "git_node": "8db863ae7fa366699911907535867700ac35f177", "git_parents": ["583e5200686f2c3a93908accb1c92542ef9fe44c"], "node": "d30049cae8fbe6d72d49acbdaa15ec5995fea450", "parents": ["15aa8a4b3f1a11c52ced00f35c82871ae198de53"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063731 - Don't walk the script settings stack for a WebTaskSchedulingState that isn't there r=smaug\n\nGetWebTaskSchedulingState() is called for every promise job that needs host\ndefined data, and each call walks the script settings stack for the entry global\nand does a principal check, even though almost nothing uses\nscheduler.postTask():\n\nHave CycleCollectedJSContext count how many of its globals currently have a\nWebTaskSchedulingState, so that getHostDefinedData - the only hot caller - can\nanswer the common case with a member load instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320168\n", "files": ["dom/base/nsIGlobalObject.cpp", "dom/script/ScriptSettings.h", "xpcom/base/CycleCollectedJSContext.cpp", "xpcom/base/CycleCollectedJSContext.h"], "git_node": "70cece730642f8c6e0884ea3837db0e34fe37ef3", "git_parents": ["8db863ae7fa366699911907535867700ac35f177"], "node": "ded8c5dd37ab3c9d9e1b9eb246f82ad5f4cb99e2", "parents": ["d30049cae8fbe6d72d49acbdaa15ec5995fea450"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2063731: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/workers/WorkerScope.h"], "git_node": "8eeaa1114f1e4eadf7dd121e0b2e6d965c49455d", "git_parents": ["70cece730642f8c6e0884ea3837db0e34fe37ef3"], "node": "52ec1ba5d2bcf7b608ba33e6597824738f9b9346", "parents": ["ded8c5dd37ab3c9d9e1b9eb246f82ad5f4cb99e2"], "tags": []}, {"author": "iain holmes \u003ciholmes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065022: Fix incorrect platform check in LaunchOnLogin code. r=hsohaney,firefox-desktop-core-reviewers ,mconley\n\nCorrect the platform gate around the check for LaunchOnLogin to support any supported platform, not just Windows. Correct the typo inverting the subsequent check in StartupOSIntegration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320582\n", "files": ["browser/base/content/test/performance/browser_startup.js", "browser/components/BrowserGlue.sys.mj