s/tests/xpcshell/xpcshell.toml", "browser/locales-preview/aiWindow.ftl", "toolkit/components/ml/content/EngineProcess.sys.mjs"], "git_node": "8546fa5ba0aaec5d7b21d4f48360ac77065e34ea", "git_parents": ["b2fef5652899090bd94f41b1d2d47da7a2900f31"], "node": "341e1e6fca519c4252dafe10304b3a9a3892a61e", "parents": ["fc2a1645e16fa95d0906386e104d66f717c53820"], "tags": []}, {"author": "Logan Rosen \u003cloganrosen@gmail.com\u003e", "branch": "default", "desc": "Bug 1499145 - Make mach bootstrap offer to enable sccache r=glandium\n\nmach bootstrap downloads sccache via auto_bootstrap() but never adds --with-ccache=sccache to the generated mozconfig. The downloaded binary therefore sits unused unless users configure it manually.\n\nOffer to enable sccache for non-artifact builds, while leaving non-interactive configuration opt-in. Run the configuration hook from the shared private-package bootstrap path inside its non-artifact branch so both normal and --no-system-changes flows are covered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286577\n", "files": ["python/mozboot/mozboot/bootstrap.py", "python/mozboot/mozboot/test/python.toml", "python/mozboot/mozboot/test/test_bootstrap.py"], "git_node": "9960904f109f273b8f1c981915b6d5fd926801ac", "git_parents": ["8546fa5ba0aaec5d7b21d4f48360ac77065e34ea"], "node": "d7f818ac38474ad6172549525277f216ca440d03", "parents": ["341e1e6fca519c4252dafe10304b3a9a3892a61e"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2063806. Add WPT that a lazy loaded image gets no image data from an out of band load of the same URL. r=emilio\n\nlazy-out-of-band-load.html only asserted that no load or error event fires on the\nlazy image. Chromium passes that while still handing the lazy image its natural\ndimensions, which is the behaviour the site in bug 2062220 depends on, so nothing\ntested it. Assert that the lazy image's current request stays unavailable: not\ncomplete, and no natural dimensions.\n\nAlso test the below-viewport placement alongside display:none, since that is the\nshape sites actually hit.\n\nFirefox passes all 8 subtests. Chromium fails the 4 green.png ones on the natural\nwidth, with .complete still false, and passes the not-found ones. WebKit fails all\n8 earlier, on the load and error events.\n\nhttps://github.com/whatwg/html/issues/10671\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318878\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/update-the-image-data/lazy-out-of-band-load.html"], "git_node": "2eea070e987d37dec87602b07380f31ef2549d20", "git_parents": ["9960904f109f273b8f1c981915b6d5fd926801ac"], "node": "00efc2cf380460eb49ce12b54b70f7ae477e6b89", "parents": ["d7f818ac38474ad6172549525277f216ca440d03"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039389 - Remove use counters for generators and Ion compilation of generators. r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318704\n", "files": ["dom/base/UseCounters.conf", "dom/base/use_counter_metrics.yaml", "js/public/friend/UsageStatistics.h", "js/src/jit-test/tests/generators/generator-telemetry.js", "js/src/jit/Ion.cpp", "js/src/vm/GeneratorObject.cpp", "js/xpconnect/src/XPCJSRuntime.cpp"], "git_node": "7f8273547843600263296f7b44155a9321ce1d79", "git_parents": ["2eea070e987d37dec87602b07380f31ef2549d20"], "node": "2912d9195eadad03b4125e8a191202da61ede4f4", "parents": ["00efc2cf380460eb49ce12b54b70f7ae477e6b89"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2058385 - change all FxA signin entrypoints to make \"service\" a required param. r=skhamis,credential-management-reviewers,fxview-reviewers,sync-reviewers,omc-reviewers,ip-protection-reviewers,mconley,yjamora,dimi,jprickett,nsharpley,aminomancer\n\nThe \"service\" param used to be technically optional, but required in practice.\nMoving FxA to using a refresh token and other FxA signin improvements makes this\nparam required, so the API is changing to better reflect it is mandatory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314573\n", "files": ["browser/base/content/browser-sync.js", "browser/components/firefoxview/firefox-view-tabs-setup-manager.sys.mjs", "browser/components/preferences/config/account-sync.mjs", "browser/components/preferences/main.js", "browser/components/preferences/sync.js", "browser/components/uitour/UITour.sys.mjs", "browser/components/uitour/test/browser_UITour_sync.js", "services/fxaccounts/FxAccountsConfig.sys.mjs", "services/fxaccounts/FxAccountsOAuth.sys.mjs", "services/fxaccounts/tests/xpcshell/test_accounts_config.js", "services/fxaccounts/tests/xpcshell/test_oauth_flow.js", "services/sync/tps/extensions/tps/resource/auth/fxaccounts.sys.mjs", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_relay_signup_flow_showToAllBrowsers.js", "toolkit/components/satchel/integrations/FirefoxRelay.sys.mjs"], "git_node": "98ad6e40fc2587ec4cc94137badcf09215915d3f", "git_parents": ["7f8273547843600263296f7b44155a9321ce1d79"], "node": "a82218db5946cf417a76eb039b8cc64d16e2adb9", "parents": ["2912d9195eadad03b4125e8a191202da61ede4f4"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2013739 - testcase.  r=rhunt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282337\n", "files": ["js/src/jit-test/tests/wasm/regress/bug2013739.js"], "git_node": "70eb3ed5fc262ce17684b3a265d10f09beba93bf", "git_parents": ["98ad6e40fc2587ec4cc94137badcf09215915d3f"], "node": "aa04376b00c3afe01096b1777af1588396f6cbae", "parents": ["a82218db5946cf417a76eb039b8cc64d16e2adb9"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2015253 - Only return a container frame top level docs during print preview. r=tnikkel,layout-reviewers\n\nThis matches the pre-regression logic, and fixes the coordinate system\nof the slicing fragmentation fallback.\n\nUnfortunately testing this is kind of a PITA, because the obvious way to\ndo it would be WPT print reftests, but that requires e10s. Regular\nreftests don't have any print stuff that would reliably test the\nfragmentation fallback I think?\n\nI can try to come up with something tho...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318966\n", "files": ["layout/printing/nsPrintJob.cpp"], "git_node": "70e5c548972612db6354fc5c25a70949c29ff742", "git_parents": ["70eb3ed5fc262ce17684b3a265d10f09beba93bf"], "node": "53b4c94ac15a2ba7465513f4a75f3b51a227c3e1", "parents": ["aa04376b00c3afe01096b1777af1588396f6cbae"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\naf -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nan -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nar -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nast -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\naz -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nbe -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nbg -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nbn -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nbo -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nbqi -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nbr -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nbrx -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nbs -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nca -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\nca-valencia -\u003e 376431cd87f22c07c124858e58c7074f9629ec48\ncak -\u003e 376431cd87f22c07c124858e58c7074f9629ec