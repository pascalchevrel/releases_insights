rotectionSnackbarBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocationsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/snackbar/SnackbarBinding.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionSnackbarMiddlewareTest.kt"], "git_node": "4430321b2426109a27463c1ae937166b44149d85", "git_parents": ["b25b3179abe9139e1c156df0f37a297c8409b154"], "node": "e1e0a704ff695daaa46a33134e2898a3ad0156c7", "parents": ["7c7a45f187aa59991f18e6a89a7ec6574e83fa3e"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049039 - Part 3: Remove cached location code when user logs out r=android-reviewers,sfamisa,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318004\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddleware.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddlewareTest.kt"], "git_node": "8c1c52f5eb6b106a6c43126da74999fcd3b272a1", "git_parents": ["4430321b2426109a27463c1ae937166b44149d85"], "node": "571cb89871ecde7b53a89163f7da213116f11274", "parents": ["e1e0a704ff695daaa46a33134e2898a3ad0156c7"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061058 - Replace activate Boolean with a data class r=android-reviewers,Roger,sfamisa\n\nThe previous `activate: Boolean?` did not allow for switching between\nlocations: the `true` flag would result in an activation, but clearing\nonly happened when the proxy reported a change in state from `ready` to\n`active`. In case of a location switch, proxy would not report any new data,\nso there was a need to help the observer (IPProtectionFeature) to\nreact to activation request even if the flag was not cleared.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317922\n", "files": ["mobile/android/android-components/components/feature/ipprotection/build.gradle", "mobile/android/android-components/components/feature/ipprotection/lint-baseline.xml", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/debug/IPProtectionStateDebug.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/res/values/static_strings.xml", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/debug/IPProtectionStateDebugTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt"], "git_node": "5afa80dc0f73b1880a0b1e2eb7b974629fc95527", "git_parents": ["8c1c52f5eb6b106a6c43126da74999fcd3b272a1"], "node": "0cf9c251e3037b492675544e3709a53657befa3d", "parents": ["571cb89871ecde7b53a89163f7da213116f11274"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2065925 - Don't bind the metric in the codegen'd Lazy unless its size is measured. r=TravisLong\" for causing source-test-python failures in test_glean_parser_rust.py\n\nThis reverts commit b8f665fc0c39ce7e9b5dcf8e4aad5160d2575d70.\n", "files": ["toolkit/components/glean/build_s