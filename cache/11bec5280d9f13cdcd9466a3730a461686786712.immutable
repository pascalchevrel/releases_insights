66054afabafd55351d6861789392e599dc9", "git_parents": ["c0ef9638922596e0855ebfb5ccae536a2a5ac253"], "node": "322dcdb44607e1120fb7164f1c5bdf254cc83813", "parents": ["9ea69a239bf5c09edd696b96e4343398bb42694d"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2066686 - Part 3: Use MacroAssembler::nor32 in EmitInitDependentStringBase. r=jandem\n\nThis can eliminate one instruction on Loong64.\n\nBefore:\n\n        addi.w $t6, $zero, -9\n        or $t4, $s0, $t6\n        nor $t4, $t4, $zero\n        slli.w $t4, $t4, 11\n\nAfter:\n\n        addi.w $t6, $zero, -9\n        nor $t4, $s0, $t6\n        slli.w $t4, $t4, 11\n\nThis is found by LoongLint on the JitDump file produced by running\nARES-6 with --strict-benchmark-mode.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321472\n", "files": ["js/src/jit/CodeGenerator.cpp"], "git_node": "b4af06879eed4ebbd5e2031b108806d6a9ac79fe", "git_parents": ["8aca466054afabafd55351d6861789392e599dc9"], "node": "812cb7c0c9358fbaceb6b8f421dc5de4d09900b6", "parents": ["322dcdb44607e1120fb7164f1c5bdf254cc83813"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066670 - Update android nightly application-services version bump to 7674e0cf977272c746eebee7c145c982e06cc6c4 r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321462\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "216c287aa277558d499ac512dfc85d3f1c2a420d", "git_parents": ["b4af06879eed4ebbd5e2031b108806d6a9ac79fe"], "node": "07203fc9ffee7112527baaf90d2e21d7cfffaf53", "parents": ["812cb7c0c9358fbaceb6b8f421dc5de4d09900b6"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064816: add new module for listen to page feature r=android-reviewers,moyin\" for busting gecko decision task.\n\nThis reverts commit 44109129fa1124df6a0a4c167b6987b16a8c4cde.\n", "files": ["gradle/libs.versions.toml", "mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/feature/listentopage/README.md", "mobile/android/android-components/components/feature/listentopage/build.gradle", "mobile/android/android-components/components/feature/listentopage/lint-baseline.xml", "mobile/android/android-components/components/feature/listentopage/proguard-rules.pro", "mobile/android/android-components/components/feature/listentopage/src/main/AndroidManifest.xml"], "git_node": "832c24a3c2a310068dcdbad7f2cd6e51705207f0", "git_parents": ["216c287aa277558d499ac512dfc85d3f1c2a420d"], "node": "575d3adf14b8526f80bed10c734d1853b7731ef5", "parents": ["07203fc9ffee7112527baaf90d2e21d7cfffaf53"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066401 - Default the results view to hidden. r=daleharvey\n\nThe newtab view kept painting after it closed: the in-page rule asserted `display` for a popover, which it always is. It is hidden unless a bar is open and broken out, which the `:not()` arms negated. A window-modal dialog revokes breakout with the view open, so `[breakout]` keeps the results off it.\n\nThe view becomes a flex column for every bar, with one rule for its block-start gap in a page and in the chrome; geometry is unchanged, and the hidden one-offs lose a margin the padding doubles. `:where()` lets the smartbar set that gap itself and keep its row budget with `box-sizing`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321416\n", "files": ["browser/components/urlbar/tests/NewtabSearchbarContentTestUtils.sys.mjs", "browser/components/urlbar/tests/NewtabSearchbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_blur.js", "browser/components/urlbar/tests/browser-newtab/browser_escape.js", "browser/themes/shared/smartbar.css", "browser/themes/shared/urlbar.css", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "f01f86068f500c1ab8b3117c3b4a9114f1e7305d", "git_parents": ["832c24a3c2a310068dcdbad7f2cd6e51705207f0"], "node": "3d76986a42c6fe274b2983bbec2d300a141b871a", "parents": ["575d3adf14b8526f80bed10c734d1853b7731ef5"], "tags": []}], "date": 1787760326, "git_changesets": ["98fabe8ed067f2c34d60d27f5f86a4c20e3a44be", "3cfde82d35831e5590a58585851e62125300da01", "aa5d6aef70eea0fd5b7a512ad6c8030d1dcc3be1", "4bf40b7cdb3cdb7c22edfe16a6031215e2720e1c", "9309664a2adc38212829c727f1ba0af01e8f25ab", "cd06fa501703463b4adceaa1018e17ca4b01aad3", "236caf1cf61145356d4375c9f08f786aa66d0713", "75dfc89c821dcbaf25bb0adf9d29b2e7f84a3ec9", "e6b5aa0fb479ef3b59e76298858d4dcadea2ef08", "0d831a62441aaad369cfb951f0fc2637fa3c4ed8", "ce3b30a9ce4b63ab31aca5d2d968a968a34860ea", "c5a6ac08d7121e448cd85cdada7735cd9edf890b", "19af6b0be0ab941a1a48a0c426651bca5d3f031c", "3ed5a3d17b6e081b86ba809a33d8b08ec7f63b2a", "cb9870e246d516eb69c579719dcd37898458a1ca", "a6aca02c2bbde4eaf55148c865c66d3c93f89379", "bd0bc1e4257a9afb2ae0aa2d3d653af08ba4598a", "8510fa3252a20cf5e1d59f180d61c9ee82db8915", "b9be14415e9155f9f7731b1f3c9311e77f5d476a", "bada72c8e62704dc0c17eeed020756c20af58cfe", "5254d0a03c5f1ec640da26b59a093cce69b0b7db", "3a0f0b981ccf10343191bafd7f198df7bd5c4a86", "f4597dd7c9803bc38e012370c62bc79b73676dcc", "06f576ef481e1a34e07a8974cf56715a6fc12432", "43833eaa7063a39a7e0fa1effc3e6de73068a149", "b24ebb1293fa2fd716dd8b186bc6c6bd7fab76d6", "cbd41324f4317a68f483b070b6d5231c6aa1dc03", "66ec53fcd56103ad3235472d50506cdf1608da15", "d9913d8c37955cf240e3147e207d5071011c08d3", "238d103e1e353e0e704d4ebeebe1c808718df1f6", "981d2c54ae41ba9d510f0fcb382f706e69bf988f", "65cdfbdddf50fe9a54f2725a504788f2707aec57", "b6a8dba2130ffe33f768bec1c7a8e4c82c915285", "83bd60dd470