586bc47d350f71e2eda5940bd3c3c2\nzh-CN -\u003e 9993a507e2586bc47d350f71e2eda5940bd3c3c2\nzh-TW -\u003e 9993a507e2586bc47d350f71e2eda5940bd3c3c2\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "041ba0206f4517f057847a04f181f775ec946b66", "git_parents": ["b0443589155c5db526b599548c089f8a20447939"], "node": "fcdd2cf44770783e2945da884a280e9ed6c32f5f", "parents": ["42165c0776e0b5bdd6787ddd10e497860b6359ad"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057453 - Set gray marking state to invalid at the end of prebarrier verification r=spidermonkey-reviewers,sfink\n\nPre-barrier verification turns on pre-barriers to check that targets of removed\nGC edges are marked black but it doesn't mark through these edges as would\nhappen in a normal GC. Instead it clears simply the mark stack at the end.\n\nThis means that gray unmarking that otherwise would have happened is skipped\nleaving the gray marking state invalid.\n\nThe patch set a flag after verification so that gray marking checks will be\nskipped until the state becomes valid after a full GC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318700\n", "files": ["js/src/gc/Verifier.cpp", "js/src/jit-test/tests/gc/bug-2057453.js"], "git_node": "91d11128a6b5489e4ef1077242187278b3cbf510", "git_parents": ["041ba0206f4517f057847a04f181f775ec946b66"], "node": "0826fe4842282cc427120f32ddc7c0a9b56f440a", "parents": ["fcdd2cf44770783e2945da884a280e9ed6c32f5f"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064120 - Use default operator equal implementation for mfbt/ r=nika\n\nNo code generation impact expected, just easier maintenance.\n\nIn a few case, the spaceship operator could be used, but that's out of\nscope for this patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319166\n", "files": ["mfbt/Array.h", "mfbt/BitSet.h", "mfbt/Char16.h", "mfbt/CompactPair.h", "mfbt/DoublyLinkedList.h", "mfbt/EnumeratedRange.h", "mfbt/IntegerRange.h", "mfbt/LinkedList.h", "mfbt/Opaque.h", "mfbt/Saturate.h", "mfbt/ThreadSafeWeakPtr.h", "mfbt/UniquePtrExtensions.h"], "git_node": "bd2b690f10f9eda60fccc70d3527e87f960e5284", "git_parents": ["91d11128a6b5489e4ef1077242187278b3cbf510"], "node": "c1d8be47d81139621fedbe4bdf23592cf8a28a13", "parents": ["0826fe4842282cc427120f32ddc7c0a9b56f440a"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063976 - Fix performance-unnecessary-copy-initialization warning in ipc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319015\n", "files": ["ipc/chromium/src/base/command_line.cc", "ipc/glue/BackgroundUtils.cpp", "ipc/glue/ProtocolUtils.cpp"], "git_node": "450b7b833f80491a5c8161a9454ac7720b7c7051", "git_parents": ["bd2b690f10f9eda60fccc70d3527e87f960e5284"], "node": "9e01fa2c077a9522c1b464cd2e23bd3c7219d745", "parents": ["c1d8be47d81139621fedbe4bdf23592cf8a28a13"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063976 - Fix performance-unnecessary-copy-initialization warning in toolkit r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319016\n", "files": ["toolkit/components/sessionstore/SessionStoreChangeListener.cpp", "toolkit/components/sessionstore/SessionStoreUtils.cpp", "toolkit/components/url-classifier/ProtocolParser.cpp"], "git_node": "05daa39e5a297b574365a0eca67155634d428e18", "git_parents": ["450b7b833f80491a5c8161a9454ac7720b7c7051"], "node": "ff2889c446a370fd77013b01c91d3bee20f5a709", "parents": ["9e01fa2c077a9522c1b464cd2e23bd3c7219d745"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063976 - Fix performance-unnecessary-copy-initialization warning in xpcom r=xpcom-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319017\n", "files": ["xpcom/base/nsSystemInfo.cpp", "xpcom/build/LateWriteChecks.cpp"], "git_node": "367776d92da7dac78a68eae48dc35cf9fede659a", "git_parents": ["05daa39e5a297b574365a0eca67155634d428e18"], "node": "ed2ed4852fdc9385bea00451a801fda0f21da1cb", "parents": ["ff2889c446a370fd77013b01c91d3bee20f5a709"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063976 - Fix performance-unnecessary-copy-initialization warning in uriloader r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319018\n", "files": ["uriloader/exthandler/ContentHandlerService.cpp"], "git_node": "d4f9b342e8d8075ba439cfd2e2cbee49b797e091", "git_parents": ["367776d92da7dac78a68eae48dc35cf9fede659a"], "node": "10620cafe7f6dfd55290ca172a2c2d1e04f5c702", "parents": ["ed2ed4852fdc9385bea00451a801fda0f21da1cb"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064120 - Use default operator equal implementation for mfbt/ r=nika\" for causing SM bustages in Array.h.\n\nThis reverts commit bd2b690f10f9eda60fccc70d3527e87f960e5284.\n", "files": ["mfbt/Array.h", "mfbt/BitSet.h", "mfbt/Char16.h", "mfbt/CompactPair.h", "mfbt/DoublyLinkedList.h", "mfbt/EnumeratedRange.h", "mfbt/IntegerRange.h", "mfbt/LinkedList.h", "mfbt/Opaque.h", "mfbt/Saturate.h", "mfbt/ThreadSafeWeakPtr.h", "mfbt/UniquePtrExtensions.h"], "git_node": "7f1cfb5cfa31048e8322fb8b713bf000ad5a8203", "git_parents": ["d4f9b342e8d8075ba439cfd2e2cbee49b797e091"], "node": "6f8374c7bfbf09d77b5a5f10c202e6023199a020", "parents": ["10620cafe7f6dfd55290ca172a2c2d1e04f5c702"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2062967 - Use a lower timeout for DoH requests on Android (doh-rollout only) r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318104\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/dns/TRRService.cpp"], "git_node": "4a7338f124f7c9678c8905494213e139e5bc7f4a", "git_parents": ["7f1cfb5cfa31048e8322fb8b713bf000ad5a8203"], "node": "e651a0d5bfe45a7f9ee3c208beea125221c592e3", "parents": ["6f8374c7bfbf09d77b5a5f10c202e6023199a020"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060220 - Unintentional drop of member in LoadInfo during clone r=smaug,necko-reviewers,valentin\n\nDuring re-direct LoadInfo gets copied and the snapshot of \u003ciframe\nreferrerpolicy=foo\u003e got lost in that copy. This fixes that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317781\n", "files": ["netwerk/base/LoadInfo.cpp"], "git_node": "dd9b3249ab06ce800c6c4a4574fa5f4934efb4bc", "git_parents": ["4a7338f124f7c9678c8905494213e139e5bc7f4a"], "node": "8e3a7d799cea191db29b44f3e2fa4a54319e5d79", "parents": ["e651a0d5bfe45a7f9ee3c208beea125221c592e3"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060220 - Add WPT that test redirected iframes maintain ancestorOrigins masking r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318069\n", "files": ["testing/web-platform/tests/html/browsers/history/the-location-interface/location-ancestor-origins-redirect-still-mask.sub.html"], "git_node": "22c54abb528d62305d070e4dd8ce38e365f74d19", "git_parents": ["dd9b3249ab06ce800c6c4a4574fa5f4934efb4bc"], "node": "f5a2462b4fed2b995f7019bad0bb475482674c9c", "parents": ["8e3a7d799cea191db29b44f3e2fa4a54319e5d79"], "tags": []}, {"author": "Vincent Tunru \u003cgit@vincenttunru.com\u003e", "branch": "default", "desc": "Bug 2057267 - Count how often Firefox shows that it blocked trackers. r=urlbar-reviewers,daisuke\n\nAnd make sure refreshes/tab switches are not counted as new first\nvisits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313753\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/controlcenter/metrics.yaml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js"], "git_node": "cdc2ae16ccd40c17b07687f3de45fc356648c518", "git_parents": ["22c54abb528d62305d070e4dd8ce38e365f74d19"], "node": "3a43be556c78dd3b6410c7e90e70300b4a16a69d", "parents": ["f5a2462b4fed2b995f7019bad0bb475482674c9c"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064225 - Add more sites into layout.css.fake-webkit-scrollbar.enabled-domains. r=layout-reviewers,dholbert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319320\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "94cc696699ed7dc1a30f3cf2c6e852f1569fa276", "git_parents": ["cdc2ae16ccd40c17b07687f3de45fc356648c518"], "node": "6c1c11f71f64a10e941c52ee05ab1e3f27de7ebe", "parents": ["3a43be556c78dd3b6410c7e90e70300b4a16a69d"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2063384 - No-Vary-Search writes revalidation to wrong cache key r=necko-reviewers,kershaw\n\nThis patch makes sure avoids writing to a cache entry when that entry was\nreturned due to no-vary-search header matching.\nWhen that happens, and the channel needs to truncate, revalidate or reopen\nthe entry, we will use the channel's URL instead of writing to the returned\ncache entry, as that may have different query parameters.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318681\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h", "netwerk/test/unit/test_no_vary_search_revalidation.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "a0a3f54ab5513a08d0c3c138321874ab71ca5af3", "git_parents": ["94cc696699ed7dc1a30f3cf2c6e852f1569fa276"], "node": "e5e8a8aceed3241e441d2a69dc7cb9ab9be842dc", "parents": ["6c1c11f71f64a10e941c52ee05ab1e3f27de7ebe"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2063384 - Avoid appending duplicate keys to mNoVarySearchIndex r=necko-reviewers,kershaw\n\nDoing so could make the array grow with every revalidation.\nInstead we only add it when the key is not already present in the array.\nA call to Contains is fine, as the number of elements in the array is normally a just a handful,\nso we don't need to worry about performance here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318682\n", "files": ["netwerk/cache2/CacheStorage.h"], "git_node": "21d304af5aeb48361dc22eef07d092d799343025", "git_parents": ["a0a3f54ab5513a08d0c3c138321874ab71ca5af3"], "node": "31212d3bba02cf79dde3ff31be8686c48aa0febe", "parents": ["e5e8a8aceed3241e441d2a69dc7cb9ab9be842dc"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2042810 - use nsIURI through internal cache APIs to eliminate string-based URI reparsing r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318701\n", "files": ["netwerk/cache2/CacheEntry.cpp", "netwerk/cache2/CacheEntry.h", "netwerk/cache2/CacheStorage.cpp", "netwerk/cache2/CacheStorage.h", "netwerk/cache2/CacheStorageService.cpp", "netwerk/cache2/CacheStorageService.h"], "git_node": "7ba2ff363c87fd9cf12272f477bcbb0a0c0be153", "git_parents": ["21d304af5aeb48361dc22eef07d092d799343025"], "node": "76b731830a7921f06dc2bcef8d92f2338185bcb2", "parents": ["31212d3bba02cf79dde3ff31be8686c48aa0febe"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064221 - [devtools] Extend backward compatibility window to allow 3 versions of gap r=devtools-reviewers,nchevobbe\n\nTemplate is updated and attached to https://bugzilla.mozilla.org/show_bug.cgi?id=1704796\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319287\n", "files": ["devtools/client/aboutdebugging/test/browser/helper-backward-compat.js", "devtools/client/inspector/rules/rules.js", "devtools/client/shared/remote-debugging/test/xpcshell/test_version_checker.js", "devtools/client/shared/remote-debugging/version-checker.js", "devtools/docs/contributor/release.md"], "git_node": "df0fd0c8548554e18834eba3fbcb88b328b6626b", "git_parents": ["7ba2ff363c87fd9cf12272f477bcbb0a0c0be153"], "node": "5317d97260794af8ed50f2bba3a705a15cb50b06", "parents": ["76b731830a7921f06dc2bcef8d92f2338185bcb2"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064221 - [devtools] Update incorrect backward compat comments from Bug 2002637 r=devtools-reviewers,nchevobbe\n\nbug 2002637 landed in 154, even though review started in 151/152...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319289\n", "files": ["devtools/client/shared/thread-utils.js", "devtools/server/actors/thread-configuration.js"], "git_node": "cca5cf2721ee8c71fd11f295c232a8dc33e3140f", "git_parents": ["df0fd0c8548554e18834eba3fbcb88b328b6626b"], "node": "ac0f1fabde6342265e8b8fccd162950bf2e5c343", "parents": ["5317d97260794af8ed50f2bba3a705a15cb50b06"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054670 - Check target for session store updates. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319099\n", "files": ["toolkit/components/sessionstore/SessionStoreParent.cpp", "toolkit/components/sessionstore/SessionStoreParent.h"], "git_node": "6087fa3421edf635c44b967d156c48ce0c2451d6", "git_parents": ["cca5cf2721ee8c71fd11f295c232a8dc33e3140f"], "node": "06a1c37457f277e83b32da42f78a9a96770b9011", "parents": ["ac0f1fabde6342265e8b8fccd162950bf2e5c343"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2055621 - Watch all in-tree dependencies for nimbus-fml and embedded-uniffi-bindgen toolchain builds. r=markh\n\nBug 2055621 was caused by an indirect change in the nimbus-fml\ndependency tree: viaduct added a dependency to rusqlite3, which caused\nthe static nimbus-fml toolchain build to fail because the build worker\ndoes not have the required gcc musl toolchain.\n\nThis was not caught at first because the only change was in\nthird_party/application-services/components/viaduct, which is not\nwatched by the nimbus-fml task. The build error only triggered later\nwhen touching the underlying Rust toolchain.\n\nThis adds the relevant paths to the toolchain build task resources to\nensure this kind of mistake is caught ealier in the future, as well as\nCargo.lock which should cover all crates.io-sourced dependencies.\n\nIdeally a lint task would check that:\n```\nyq -r '.[\"task-defaults\"].run.resources[2:].[]' taskcluster/kinds/toolchain/nimbus-fml.yml\n```\nis the same as\n```\ncargo tree -p nimbus-fml | grep -oP '(?\u003c='$(pwd)'/)[^)]+' | sort | uniq\n```\n(and similar for embedded-uniffi-bindgen)\n\nbut I'm not sure where/how to add that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318750\n", "files": ["build/sparse-profiles/taskgraph", "taskcluster/kinds/toolchain/embedded-uniffi-bindgen.yml", "taskcluster/kinds/toolchain/nimbus-fml.yml"], "git_node": "87ec14535afe49676f7f91c8e16612ba013f38df", "git_parents": ["6087fa3421edf635c44b967d156c48ce0c2451d6"], "node": "63efad667a1ad2a5d563caab08daebbb3356ea4e", "parents": ["06a1c37457f277e83b32da42f78a9a96770b9011"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2062940 - Remove mirroring for zero_byte_load probes r=necko-reviewers,chumphreys,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318440\n", "files": ["modules/libjar/metrics.yaml", "modules/libjar/test/unit/test_empty_jar_telemetry.js", "toolkit/components/telemetry/Events.yaml"], "git_node": "54427f99736fd17fb8e29092d50acea7bb58dbbf", "git_parents": ["87ec14535afe49676f7f91c8e16612ba013f38df"], "node": "ec40f8906ff58918d04752f39b3641efcfce3dc9", "parents": ["63efad667a1ad2a5d563caab08daebbb3356ea4e"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2062940 - Remove telemetry mirroring for various necko probes r=necko-reviewers,chumphreys,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318441\n", "files": ["netwerk/dns/metrics.yaml", "netwerk/protocol/http/metrics.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml", "toolkit/components/telemetry/histogram-allowlists.json"], "git_node": "889c212817802944ba00ff5936fccc6f136e5c69", "git_parents": ["54427f99736fd17fb8e29092d50acea7bb58dbbf"], "node": "69f01bd818fd2db0e83fcb105376757f60d764d3", "parents": ["ec40f8906ff58918d04752f39b3641efcfce3dc9"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2062940 - Update metrics comments to remove references to legacy telemetry r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318442\n", "files": ["netwerk/cache2/metrics.yaml", "netwerk/dns/metrics.yaml", "netwerk/metrics.yaml"], "git_node": "01eeed9d6836514bd30c635d4034d2341aa95b07", "git_parents": ["889c212817802944ba00ff5936fccc6f136e5c69"], "node": "e474a15cdb7f8f81e1d044e9a68ae58d7fae3a5c", "parents": ["69f01bd818fd2db0e83fcb105376757f60d764d3"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2062940 - remove some http metrics mirroring r=necko-reviewers,chumphreys,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318443\n", "files": ["netwerk/protocol/http/metrics.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/histogram-allowlists.json"], "git_node": "22606827b18908f207438b269bdc624c6a500287", "git_parents": ["01eeed9d6836514bd30c635d4034d2341aa95b07"], "node": "f97fe219d7437ea6a4032306fd6e4e8824c9acb9", "parents": ["e474a15cdb7f8f81e1d044e9a68ae58d7fae3a5c"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2062940 - remove references to legacy telemetry from metric descriptions r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318444\n", "files": ["netwerk/protocol/http/metrics.yaml"], "git_node": "cea5354620e335f8756edd0867120b53e91a0422", "git_parents": ["22606827b18908f207438b269bdc624c6a500287"], "node": "1146dd7b316f377158f553df8b5b96ecedbccf84", "parents": ["f97fe219d7437ea6a4032306fd6e4e8824c9acb9"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2062940 - Remove mirroring for HTTP_PAGELOAD_IS_SSL, HTTP_TRANSACTION_IS_SSL and HTTP_PAGE_TLS_HANDSHAKE r=necko-reviewers,chumphreys,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318445\n", "files": ["netwerk/protocol/http/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "9749549f615f438d65ac5556199655970053e384", "git_parents": ["cea5354620e335f8756edd0867120b53e91a0422"], "node": "2181e4faeec579b2b47e8eb4b2b6b309fa61234b", "parents": ["1146dd7b316f377158f553df8b5b96ecedbccf84"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2062940 - Remove ORB telemetry mirrioring from http metrics r=necko-reviewers,chumphreys,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318446\n", "files": ["netwerk/protocol/http/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "c6c7afa8c7104789b9bb5d4ce4e2daf23c52e108", "git_parents": ["9749549f615f438d65ac5556199655970053e384"], "node": "4061774639a43368431719e2094b1cc061cc0ccf", "parents": ["2181e4faeec579b2b47e8eb4b2b6b309fa61234b"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2064209 - Fix DeviceResetDetectPlace r=gfx-reviewers,aosmond\n\nFix regression by  Bug 2063174.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319307\n", "files": ["gfx/2d/Types.h"], "git_node": "a6b2a45d71689dda843585c32981c7b550e899b0", "git_parents": ["c6c7afa8c7104789b9bb5d4ce4e2daf23c52e108"], "node": "1e7783dd843fa542e5afc1c71ab92b18c58845c0", "parents": ["4061774639a43368431719e2094b1cc061cc0ccf"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2063612 - Remove deprecated `DomainAutoCompleteProvider` class r=android-reviewers,jonalmeida\n\nThis removes the deprecated `DomainAutoCompleteProvider` class and its associated tests from the `browser-domains` component.\n\nUsers should migrate to using `ShippedDomainsProvider` or `CustomDomainsProvider` instead.\nThe documentation and changelog have been updated to reflect this breaking change and provide updated usage examples.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319081\n", "files": ["mobile/android/android-components/components/browser/domains/README.md", "mobile/android/android-components/components/browser/domains/src/main/java/mozilla/components/browser/domains/DomainAutoCompleteProvider.kt", "mobile/android/android-components/components/browser/domains/src/test/java/mozilla/components/browser/domains/DomainAutoCompleteProviderTest.kt", "mobile/android/android-components/config/detekt-baseline.xml", "mobile/android/android-components/docs/changelog.md"], "git_node": "a608b34a211bb14c98d4405f87139cebf78e63c9", "git_parents": ["a6b2a45d71689dda843585c32981c7b550e899b0"], "node": "3066c3f038a8b228fcc3207a687ef21fba7b8e3e", "parents": ["1e7783dd843fa542e5afc1c71ab92b18c58845c0"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064256 - Update metadata for web-extensions/browser.storage.extension.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319407\n", "files": ["testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini"], "git_node": "565fd3072ff73794c9c84c7c37329532b5f5dace", "git_parents": ["a608b34a211bb14c98d4405f87139cebf78e63c9"], "node": "6baba80201036b0cf70964c39ae9cb3a0682d4c8", "parents": ["3066c3f038a8b228fcc3207a687ef21fba7b8e3e"], "tags": []}, {"author": "Exploding Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 2003000 - Copy Clean Link: Strip more query parameters from audible r=manuel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319222\n", "files": ["toolkit/components/antitracking/StripOnShareLists/MPL2/StripOnShare.json"], "git_node": "f780360f85897f3acfe011e534043d9dfcc6f121", "git_parents": ["565fd3072ff73794c9c84c7c37329532b5f5dace"], "node": "b8c9d3b532bb2935b62cab196e4ced463a97a87d", "parents": ["6baba80201036b0cf70964c39ae9cb3a0682d4c8"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064013 - Resolve button type to button when child of select r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319090\n", "files": ["dom/html/HTMLButtonElement.cpp", "dom/html/HTMLButtonElement.h", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-button-behaviors.html.ini"], "git_node": "d32a8e4448247ee106872dda3582ca62e133cc62", "git_parents": ["f780360f85897f3acfe011e534043d9dfcc6f121"], "node": "6197d4859142ae0a58f5b93975a2bb55d3e67d28", "parents": ["b8c9d3b532bb2935b62cab196e4ced463a97a87d"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047627 - Fix uninitialized corner shape values in theme drawing. r=gfx-reviewers,nical\n\nFollowing the first implementation of CSS corner shape rendering (see bug 2035317),\nthe struct wr::BorderRadius now has four new fields for the corner shapes, which\nwere left uninitialized here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317056\n", "files": ["widget/ThemeDrawing.cpp"], "git_node": "b4b4ae7aceef86837af776d29c7556543480a22e", "git_parents": ["d32a8e4448247ee106872dda3582ca62e133cc62"], "node": "39beb85b674c52612590003d5dd684e3f2cda25a", "parents": ["6197d4859142ae0a58f5b93975a2bb55d3e67d28"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047627 - Improve superellipse normal approximation. r=gfx-reviewers,nical\n\nFix normal discontinuity when shape approaches 1 (round). Both normal approximations\nnow correctly converge towards axis-aligned normals when reaching a round shape, which\nmatches the preexisting implementation of ellipses for border radii, ensuring a smooth\ntransition between the two and no jumps when animating the shape parameter.\n\nThe new version of compute_superellipse_half_corner(), with the correction applied\nwith a quadratic falloff, actually becomes almost linear. Thus, a much cheaper linear\napproximation has been implemented, and is now used by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317057\n", "files": ["gfx/wr/webrender/res/ellipse.glsl", "gfx/wr/wrench/reftests/boxshadow/box-shadow-spread-shape.png", "gfx/wr/wrench/reftests/clip/clip-superellipse.png", "gfx/wr/wrench/reftests/mask/shaped-corners-inset.png", "gfx/wr/wrench/reftests/mask/shaped-corners-outset.png"], "git_node": "dc23350913a53c7e20f2b7c8ef5b0b5d0f67909c", "git_parents": ["b4b4ae7aceef86837af776d29c7556543480a22e"], "node": "9302754502b571e0bdff74ad45fa698934601ea7", "parents": ["39beb85b674c52612590003d5dd684e3f2cda25a"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047627 - Add support for CSS corner-shape in borders. r=gfx-reviewers,nical\n\nAdd support for corner-shape for most types of borders. The same shader is also\nused for outlines, and sometimes to draw rounded rects (see bug 1694269).\n\nAll border types are supported exept dotted and dashed. These are left as\nfuture work.\n\nSome other extreme edge cases (such as when corners overlap) are also not\nhandled correctly yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317058\n", "files": ["gfx/wr/webrender/res/border_shared.glsl", "gfx/wr/webrender/res/cs_border_segment.glsl", "gfx/wr/webrender/res/cs_border_solid.glsl", "gfx/wr/wrench/reftests/border/border-shape-2.png", "gfx/wr/wrench/reftests/border/border-shape-2.yaml", "gfx/wr/wrench/reftests/border/border-shape-3.png", "gfx/wr/wrench/reftests/border/border-shape-3.yaml", "gfx/wr/wrench/reftests/border/border-shape-4.png", "gfx/wr/wrench/reftests/border/border-shape-4.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/border-shape-inset.yaml", "gfx/wr/wrench/reftests/border/border-shape.png", "gfx/wr/wrench/reftests/border/border-shape.yaml", "gfx/wr/wrench/reftests/border/reftest.list", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-superellipse.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-100.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-inf.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini"], "git_node": "98200f5ebe94672a1f393e9eec9ff414ca0e2772", "git_parents": ["dc23350913a53c7e20f2b7c8ef5b0b5d0f67909c"], "node": "434bf2e745541528510dff62d485aa383fadc614", "parents": ["9302754502b571e0bdff74ad45fa698934601ea7"], "tags": []}, {"author": "Kana \ud83d\udc20 \u003crekanacoding@gmail.com\u003e", "branch": "default", "desc": "Bug 2062133 - properly wait for all promises when closing tabs in test_reset_action_closes_pinned_and_selected_tabs r=timhuang\n\nPreviously, this logic awaited an array, instead of an actual Promise. In JavaScript, awaiting an array does not wait for the promises it contains. The risk here is that the test could continue before all tabs had closed.\n\nNow, we properly await with `Promise.all(...)` which actually only resolves once every promise in that array resolves.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319310\n", "files": ["browser/components/privatebrowsing/test/browser/browser_privatebrowsing_resetPBM.js"], "git_node": "7285c06220938ed26fcb521e596303dd64ab7161", "git_parents": ["98200f5ebe94672a1f393e9eec9ff414ca0e2772"], "node": "157cd04c4caaab981fdd3b7a0a418be2aea0d184", "parents": ["434bf2e745541528510dff62d485aa383fadc614"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge Mozilla-central to autoland\n", "files": [], "git_node": "99c3ed9b8a6a06eb2d57356b7b79ca116b91e12f", "git_parents": ["7285c06220938ed26fcb521e596303dd64ab7161", "b0bc20aac45f7cb55b18adbf4d2313457659d140"], "node": "8680b3431cf2d722b490d4792432353beca3867e", "parents": ["157cd04c4caaab981fdd3b7a0a418be2aea0d184", "75b411853549cc53f7e6abd6661416f6e60e8e39"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2063994. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319068\n", "files": ["image/decoders/nsJXLDecoder.cpp"], "git_node": "1dbc9c50f7e41ec82d0fb5a126ec6e52e32a010d", "git_parents": ["99c3ed9b8a6a06eb2d57356b7b79ca116b91e12f"], "node": "40815b95e3ad098762ed2805d02b0f97f0e95d63", "parents": ["8680b3431cf2d722b490d4792432353beca3867e"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063997 - Don't assume dir=auto for input type change. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319053\n", "files": ["dom/html/HTMLInputElement.cpp", "testing/web-platform/tests/html/dom/elements/global-attributes/dir-auto-dynamic-changes.window.js"], "git_node": "92a3e9eb31deed81629c1bfde48b81a1a90b6571", "git_parents": ["1dbc9c50f7e41ec82d0fb5a126ec6e52e32a010d"], "node": "72c226931d91a8a5d81df57b255b8bf1275c0679", "parents": ["40815b95e3ad098762ed2805d02b0f97f0e95d63"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047627 - Add support for CSS corner-shape in borders. r=gfx-reviewers,nical\" for causing failures at corner-shape-squircle.html.\n\nThis reverts commit 98200f5ebe94672a1f393e9eec9ff414ca0e2772.\n\nRevert \"Bug 2047627 - Improve superellipse normal approximation. r=gfx-reviewers,nical\"\n\nThis reverts commit dc23350913a53c7e20f2b7c8ef5b0b5d0f67909c.\n\nRevert \"Bug 2047627 - Fix uninitialized corner shape values in theme drawing. r=gfx-reviewers,nical\"\n\nThis reverts commit b4b4ae7aceef86837af776d29c7556543480a22e.\n", "files": ["gfx/wr/webrender/res/border_shared.glsl", "gfx/wr/webrender/res/cs_border_segment.glsl", "gfx/wr/webrender/res/cs_border_solid.glsl", "gfx/wr/webrender/res/ellipse.glsl", "gfx/wr/wrench/reftests/border/border-shape-2.png", "gfx/wr/wrench/reftests/border/border-shape-2.yaml", "gfx/wr/wrench/reftests/border/border-shape-3.png", "gfx/wr/wrench/reftests/border/border-shape-3.yaml", "gfx/wr/wrench/reftests/border/border-shape-4.png", "gfx/wr/wrench/reftests/border/border-shape-4.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/border-shape-inset.yaml", "gfx/wr/wrench/reftests/border/border-shape.png", "gfx/wr/wrench/reftests/border/border-shape.yaml", "gfx/wr/wrench/reftests/border/reftest.list", "gfx/wr/wrench/reftests/boxshadow/box-shadow-spread-shape.png", "gfx/wr/wrench/reftests/clip/clip-superellipse.png", "gfx/wr/wrench/reftests/mask/shaped-corners-inset.png", "gfx/wr/wrench/reftests/mask/shaped-corners-outset.png", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-superellipse.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-100.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-inf.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini", "widget/ThemeDrawing.cpp"], "git_node": "6e8203c862bd109c1352963fdf7ca7bf462bf935", "git_parents": ["92a3e9eb31deed81629c1bfde48b81a1a90b6571"], "node": "3e747ca1a23e68dfb53d9eab9dc0d5b0b68c1f3c", "parents": ["72c226931d91a8a5d81df57b255b8bf1275c0679"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064014 - Commit Option value on mouse event for base select r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319091\n", "files": ["dom/html/HTMLSelectElement.cpp", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-events-2.optional.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-mouse-behavior.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-mousedown-slot-mutation.optional.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/switch-picker-appearance.html.ini"], "git_node": "ac447ee7cac922b09dc07f2936b5e2034390efc9", "git_parents": ["6e8203c862bd109c1352963fdf7ca7bf462bf935"], "node": "46fe3d1e45e2e1f081d9b7d5cc88a3b097c3e8e2", "parents": ["3e747ca1a23e68dfb53d9eab9dc0d5b0b68c1f3c"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2018913 - Part 4: Update custom element registry during cross-document adoption r=edgar\n\nImplement the adoption steps from\nhttps://dom.spec.whatwg.org/#concept-node-adopt for scoped custom element\nregistries. When elements are adopted across documents, their custom element\nregistry is updated:\n\n- Elements with a global registry get the new document's effective global\n  registry.\n- Elements with null registry get the new document's effective global\n  registry, unless they are inside a shadow root with\n  keepCustomElementRegistryNull set (per https://github.com/whatwg/dom/issues/1429).\n- Elements with a scoped registry retain their registry.\n- Unassigned (lazy) elements follow the same logic, checking their\n  containing shadow root.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313457\n", "files": ["dom/base/ShadowRoot.cpp", "dom/base/ShadowRoot.h", "dom/base/nsContentUtils.cpp", "dom/base/nsINode.cpp", "testing/web-platform/meta/custom-elements/registries/Element-customElementRegistry.html.ini", "testing/web-platform/meta/custom-elements/registries/adoption.window.js.ini", "testing/web-platform/meta/custom-elements/registries/scoped-registry-append.html.ini", "testing/web-platform/meta/custom-elements/registries/scoped-registry-define-upgrade-order.html.ini", "testing/web-platform/meta/custom-elements/registries/scoped-registry-effective-global-registry.html.ini", "testing/web-platform/meta/custom-elements/registries/template.window.js.ini"], "git_node": "fcf913f9a8b4851189168558911dda3ee568f197", "git_parents": ["ac447ee7cac922b09dc07f2936b5e2034390efc9"], "node": "f52630abd1fe0a6f759ec5be3df9f19a78145669", "parents": ["46fe3d1e45e2e1f081d9b7d5cc88a3b097c3e8e2"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063336 - Cap the cookie database WAL size in bytes instead of pages r=cookie-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319294\n", "files": ["netwerk/cookie/CookiePersistentStorage.cpp"], "git_node": "ee44e183587b76e6446111ac8dc9fc6825f90c29", "git_parents": ["fcf913f9a8b4851189168558911dda3ee568f197"], "node": "5aca58788aeeea00c2fca713816c607327e7b8a8", "parents": ["f52630abd1fe0a6f759ec5be3df9f19a78145669"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062779 - Container site association UI r=desktop-theme-reviewers,tgiles,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317944\n", "files": ["browser/components/contextualidentity/content/container-select.css", "browser/components/contextualidentity/content/container-select.mjs", "browser/components/contextualidentity/jar.mn", "browser/components/preferences/config/containers.mjs", "browser/components/preferences/dialogs/containers.xhtml", "browser/components/preferences/dialogs/jar.mn", "browser/components/preferences/dialogs/siteContainer.js", "browser/components/preferences/dialogs/siteContainer.xhtml", "browser/components/preferences/preferences.js", "browser/components/preferences/preferences.xhtml", "browser/components/preferences/tests/privacy/browser-srd.toml", "browser/components/preferences/tests/privacy/browser.toml", "browser/components/preferences/tests/privacy/browser_container_select.js", "browser/components/preferences/tests/privacy/browser_containers_site_associations.js", "browser/locales/en-US/browser/preferences/containers.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/themes/shared/preferences/preferences.css", "browser/themes/shared/usercontext/container-editor.css", "toolkit/content/widgets/moz-select/moz-select.mjs"], "git_node": "a080f825d709da9c3befb436ce6970415b103417", "git_parents": ["ee44e183587b76e6446111ac8dc9fc6825f90c29"], "node": "6ea66f451a607b121f237c376e6b950f1b93d67b", "parents": ["5aca58788aeeea00c2fca713816c607327e7b8a8"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052769 - Replace MRU small atom cache with a direct-mapped cache for short Latin1 strings. r=emilio,smaug,dom-core-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311524\n", "files": ["xpcom/ds/nsAtomTable.cpp"], "git_node": "fc25f826efda857c26366f92445eee370c3d6ca1", "git_parents": ["a080f825d709da9c3befb436ce6970415b103417"], "node": "d4bb0d431806c059fa89ffa3d99514a0680e1739", "parents": ["6ea66f451a607b121f237c376e6b950f1b93d67b"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052769 - Make ShortAtomCache set-associative. r=smaug,dom-core-reviewers\n\nBy using a 4-way set associative cache, we can reduce the cache miss rate\nand trade some of that to halve the overall cache size. Local sp3 profiling\nindicates this gets us to a near-perfect hit rate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316998\n", "files": ["xpcom/ds/nsAtomTable.cpp", "xpcom/tests/gtest/TestAtoms.cpp"], "git_node": "2a97c8bedcb7c1a82de81efc5788639fd491386f", "git_parents": ["fc25f826efda857c26366f92445eee370c3d6ca1"], "node": "89e895cca222c077f2d1ede2e9fb4e5508182240", "parents": ["d4bb0d431806c059fa89ffa3d99514a0680e1739"], "tags": []}, {"author": "Tim Elliott \u003ctle@holymonkey.com\u003e", "branch": "default", "desc": "Bug 2064153 - Enable image.jpeg.dct-scaling.enabled by default. r=tnikkel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319240\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "ee29b5c4e8622c1f89691a7b64de341ea1d6c1e5", "git_parents": ["2a97c8bedcb7c1a82de81efc5788639fd491386f"], "node": "f25149222b089e32d75431743b81926e558c7a66", "parents": ["89e895cca222c077f2d1ede2e9fb4e5508182240"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060129 - Cache SVG stroked bounds r=emilio\" for not having the desired performance effect\n\nThis reverts commit 940ab81bc72d2c096a36d9c19bbbc0fd3f0ca665.\n", "files": ["dom/svg/SVGGeometryElement.cpp", "dom/svg/SVGGeometryElement.h", "dom/svg/test/mochitest.toml", "dom/svg/test/test_stroked-bbox-caching.xhtml", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "9a6e481f4caf16f6296140c1a6aa94e5ab10be42", "git_parents": ["ee29b5c4e8622c1f89691a7b64de341ea1d6c1e5"], "node": "451c42157628c5643c89089a13400de4334b937c", "parents": ["f25149222b089e32d75431743b81926e558c7a66"], "tags": []}, {"author": "Jan-Erik Rediger \u003cjrediger@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063989 - Implement TestShutdownFOG to shutdown FOG in tests r=chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319044\n", "files": ["toolkit/components/glean/src/init/mod.rs", "toolkit/components/glean/xpcom/FOG.cpp", "toolkit/components/glean/xpcom/FOG.h", "toolkit/components/glean/xpcom/nsIFOG.idl"], "git_node": "58790d49c1280ea772782274c37f6ffdb72b20f5", "git_parents": ["9a6e481f4caf16f6296140c1a6aa94e5ab10be42"], "node": "9afebc15b0c172a9110c585e81eb8e350fc7cd8b", "parents": ["451c42157628c5643c89089a13400de4334b937c"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052769 - Make ShortAtomCache set-associative. r=smaug,dom-core-reviewers\" for causing bustages in nsAtomTable.cpp.\n\nThis reverts commit 2a97c8bedcb7c1a82de81efc5788639fd491386f.\n\nRevert \"Bug 2052769 - Replace MRU small atom cache with a direct-mapped cache for short Latin1 strings. r=emilio,smaug,dom-core-reviewers\"\n\nThis reverts commit fc25f826efda857c26366f92445eee370c3d6ca1.\n", "files": ["xpcom/ds/nsAtomTable.cpp", "xpcom/tests/gtest/TestAtoms.cpp"], "git_node": "6015e1547e7d9f2eb665b63545ecfb2fb1f43fc8", "git_parents": ["58790d49c1280ea772782274c37f6ffdb72b20f5"], "node": "bb78783dbe110b2c8d05135b2849fb790af73f4e", "parents": ["9afebc15b0c172a9110c585e81eb8e350fc7cd8b"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1882163 - Retry removing directory if it fails due to readonly file r=necko-reviewers,kershaw\n\nIt's not clear if this is the cause a small number of users\n(~50 on nightly, ~250K on release) fail to remove the old cache2\nfolders.\n\nThis attempts to retry the removal by after removing the readonly\nattribute from the file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316623\n", "files": ["netwerk/cache2/CacheFileIOManager.cpp", "netwerk/test/browser/browser_purgeCache_idle_daily.js", "netwerk/test/unit/test_cache2-43-purge-residual-folder.js", "netwerk/test/unit/xpcshell.toml", "xpcom/ioutils/IOUtils.h"], "git_node": "f890b9da44600cb5d31697e6041264ddf53678c5", "git_parents": ["6015e1547e7d9f2eb665b63545ecfb2fb1f43fc8"], "node": "4e6782fb5674a7a1eca0dbaca79278851c24e4ac", "parents": ["bb78783dbe110b2c8d05135b2849fb790af73f4e"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2051970 - Sandbox policy for the HWInference utility process. r=haik,sandbox-reviewers,ai-platform-reviewers,ipc-reviewers,nika\n\nThis is essentially a copy-paste of the GPU process policy, trimmed down\nto removed everything that wasn't needed. One thing that has been added\nis read/write permissions to the `/plugincontainer` directory so shader\ncompilation caching works.\n\nWe have discussed changing the executable name on macOS to relinquish\nallowing executable page, this hasn't been implemented, this is future\nwork, and will only be useful if non of the inference backend JIT (we've\nseen video decoders JIT code).\n\nAlso improves LlamaRuntimeLinker's load-failure logging (checks whether the\nfile exists, logs GetLastError() on Windows) to help diagnose load failures\nunder the new sandbox.\n\ntoolkit/moz.configure gains a quoted set_define(\"MOZ_CHILD_PROCESS_BUNDLEID\",\n...) that the new macOS sandbox code consumes as a string literal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268412\n", "files": ["ipc/glue/UtilityProcessSandboxing.h", "security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp", "security/sandbox/linux/broker/SandboxBrokerPolicyFactory.h", "security/sandbox/mac/Sandbox.mm", "security/sandbox/mac/SandboxPolicyHWInference.h", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.cpp", "toolkit/moz.configure"], "git_node": "bcc7c27b3e5c0a09e74ef31b995b5384e41b6931", "git_parents": ["f890b9da44600cb5d31697e6041264ddf53678c5"], "node": "56742e925f81c7b14205d665bbd6d5e62815d754", "parents": ["4e6782fb5674a7a1eca0dbaca79278851c24e4ac"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2051970 - Allow the HWInference utility process to load mozinference.dll on Windows. r=bobowen,sandbox-reviewers,ipc-reviewers\n\nThe Windows sandbox for HW_INFERENCE inherited UtilitySandboxProps'\ndefaults, which blocked loading our vendored, non-Microsoft-signed\nmozinference.dll: Code Integrity Guard (MITIGATION_FORCE_MS_SIGNED_BINS)\nrejects loading any binary that isn't Microsoft-signed.\n\nCIG is applied as a delayed mitigation, taking effect only once\nStartSandbox() lowers the sandbox, the same way winmm.dll and the WMF\nlibraries are preloaded before that call to work around it. So instead\nof disabling CIG for HW_INFERENCE, preload mozinference.dll via\nLlamaRuntimeLinker::Init() before StartSandbox() in\nUtilityProcessImpl::Init(), and use the generic utility sandbox policy\n(GenericUtilitySandboxProps) otherwise. No bin-dir file-access rule is\nneeded: the preload happens before the sandbox is lowered, so the\nLoadLibrary call still has full file access, and dynamic backend loading\nis disabled.\n\nmozinference.dll only loads a library and resolves symbols at that\npoint (no dynamic code generation/JIT), and Mozilla's build doesn't\nuse ggml's dynamic backend-plugin loading (GGML_BACKEND_DL is not\ndefined), so there is no dynamic-code or later LoadLibrary concern.\n\nVerified with MOZ_LOG=LlamaRuntimeLinker:5 on try: mozinference.dll now\nloads and links successfully in the sandboxed process, and\nmochitest-speech-recognition is green on Windows, Linux, and macOS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311101\n", "files": ["ipc/glue/UtilityProcessImpl.cpp", "security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp"], "git_node": "fb63707bd614b878b7eb0b0f7a5a6e32cb85ea9d", "git_parents": ["bcc7c27b3e5c0a09e74ef31b995b5384e41b6931"], "node": "fa3f3a4aaea072c9efd130b33cb7a602e5f386e5", "parents": ["56742e925f81c7b14205d665bbd6d5e62815d754"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2051970 - Introduce the HWInference utility process. r=gerard-majax,ipc-reviewers,fluent-reviewers,nika,ai-platform-reviewers,flod,sandbox-reviewers,gregtatum\n\nThe HWInference process is a new type of process, that is created from a\ncontent process (e.g. to implement a Web API), but can also talk to the\nmain process (e.g. to interact with ModelHub and acquire ML models).\n\nIt doesn't run script. It has a dedicated sandbox policy (in a\nsubsequent patch), that is roughly similar to the GPU process policy,\nwith everything related to graphics rendering removed (connection to the\ndisplay server, access to fonts, misc system calls and privileges,\netc.), as it is just for hardware accelerated computations.\n\nThis patch only contains the scaffolding, and the first actor\n(PSpeechRecognition) will be introduced in another patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268403\n", "files": ["dom/chrome-webidl/ChromeUtils.webidl", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "ipc/glue/PUtilityProcess.ipdl", "ipc/glue/UtilityProcessChild.cpp", "ipc/glue/UtilityProcessChild.h", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessManager.cpp", "ipc/glue/UtilityProcessManager.h", "ipc/glue/test/gtest/TestUtilityProcess.cpp", "security/sandbox/linux/Sandbox.cpp", "toolkit/components/aboutprocesses/content/aboutProcesses.js", "toolkit/components/ml/ipc/HWInferenceChild.cpp", "toolkit/components/ml/ipc/HWInferenceChild.h", "toolkit/components/ml/ipc/HWInferenceManagerChild.cpp", "toolkit/components/ml/ipc/HWInferenceManagerChild.h", "toolkit/components/ml/ipc/HWInferenceManagerParent.cpp", "toolkit/components/ml/ipc/HWInferenceManagerParent.h", "toolkit/components/ml/ipc/HWInferenceParent.cpp", "toolkit/components/ml/ipc/HWInferenceParent.h", "toolkit/components/ml/ipc/PHWInference.ipdl", "toolkit/components/ml/ipc/PHWInferenceManager.ipdl", "toolkit/components/ml/ipc/moz.build", "toolkit/components/ml/moz.build", "toolkit/components/processtools/ProcInfo_common.cpp", "toolkit/locales/en-US/toolkit/about/aboutProcesses.ftl", "toolkit/locales/en-US/toolkit/global/processTypes.ftl", "toolkit/modules/ProcessType.sys.mjs"], "git_node": "3c981492fc46cb58248e99bca32aac02a9692a9d", "git_parents": ["fb63707bd614b878b7eb0b0f7a5a6e32cb85ea9d"], "node": "c5c2c38183e2683ac96e217a85bad82c413e0e45", "parents": ["fa3f3a4aaea072c9efd130b33cb7a602e5f386e5"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2051970 - Let consumers decide the HWInference process lifetime. r=ipc-reviewers,ai-platform-reviewers,valentinp,nika\n\nOnce launched, a utility process lives until browser shutdown.\n\nUtilityProcessManager::LaunchProcessWithKeepAlive() launches an instance and\nhands back the single refcounted UtilityProcessKeepAlive for it, CleanShutdown()ing\nthat instance when the last consumer drops it. Nothing about it is HWInference\nspecific: a SandboxingKind opts into this policy by having its consumers come\nthrough here, and keeps the current behaviour by not doing so. The keep-alive\nholds the ProcessFields rather than the instance key, so one that outlives its\ninstance is inert instead of shutting down whatever replaced it. HW_INFERENCE\nneeds that, having two instances, \"content\" and \"browser\", which are separate\nprocesses with independent lifetimes.\n\nIt has no policy of its own: speech recognition holds a keep-alive across a burst\nof calls, a consumer that wants the process gone immediately just drops it.\n\nThe keep-alive lives in the parent because that is where UtilityProcessManager\nis: HWInferenceManagerParent runs in the utility process and cannot shut its own\nprocess down. WINDOWS_FILE_DIALOG does the same with sOpenDialogActors.\n\nContent processes go through PContent, which gains ReleaseHWInferenceConnection.\nHWInferenceManagerChild sends one per RequestHWInferenceConnection, whether or\nnot it binds the endpoint it gets back (a concurrent request may have connected\nfirst). ContentParent collapses its connections into a single keep-alive, dropped\nin ActorDestroy so a crashed process cannot pin the utility process.\n\ngtests cover consumers sharing a keep-alive, the two instances not affecting each\nother, and a keep-alive outliving its process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314420\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "ipc/glue/UtilityProcessManager.cpp", "ipc/glue/UtilityProcessManager.h", "ipc/glue/test/gtest/TestUtilityProcess.cpp", "toolkit/components/ml/ipc/HWInferenceManagerChild.cpp", "toolkit/components/ml/ipc/HWInferenceManagerChild.h"], "git_node": "8cdea25f49e5b826e397adb425f51a47803d7b5e", "git_parents": ["3c981492fc46cb58248e99bca32aac02a9692a9d"], "node": "c8ea8bf093c2bc50ccd161fb60feb726d395d772", "parents": ["c5c2c38183e2683ac96e217a85bad82c413e0e45"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2051970 - Add an XPCOM interface to ModelHub.sys.mjs, add isModelAvailable() to ModelHub. r=beth,ai-platform-reviewers,gregtatum\n\nThis allows calling into ModelHub from native code. This also adds a\ncouple testing facilities, and a little bit of formatting fixes.\n\nThe testing facilities allow almost end-to-end testing of some\nWeb Speech API feature, testing all the IPC, but sidestepping the very\nlast part about having an _actual_ model.\n\nOnly the facilities SpeechRecognition needs are exposed via this small\nXPCOM component: check availability, download a model, with progress\ncallbacks, and getting an fd for a model file stored in ModelHub.\n\nThis is intended to be called from the Utility process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268408\n", "files": ["toolkit/components/ml/MLModelHubService.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/components.conf", "toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/moz.build", "toolkit/components/ml/nsIMLModelHub.idl", "toolkit/components/ml/tests/browser/browser_ml_cache.js"], "git_node": "ad16c36ee2d0406fc255e2a9eb67252e5e7656a1", "git_parents": ["8cdea25f49e5b826e397adb425f51a47803d7b5e"], "node": "4b1566881bb7ddf4bb66cf3c9ef6b9e36b0e5199", "parents": ["c8ea8bf093c2bc50ccd161fb60feb726d395d772"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2051970 - Add generic IsModelAvailable IPC message to PHWInference. r=ipc-reviewers,ai-platform-reviewers,nika,gregtatum\n\nThe HWInference process doesn't really know much about the models. It\ncan request a model spec, for now an opaque id.\n\nMore constraints will follow, we can imagine requesting based on\navailable compute, ability to perform hardware accelerated inference, or\nvarious domain-specific characteristics (e.g. for speach recognition, it\ncould be \"A model that can recognize french, optimized for low latency,\nsuitable for hardware accelerated inference\").\n\nA \"task\" (speech recognition, summarization, etc.) can register an\nnsIMLModelResolver that maps from this model spec to an entry in model\nhub. This abstracts models away from the HWUtility process, so that no\ninfo leak out of the parent.\n\nThis is between HWUtility and Parent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309866\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "toolkit/components/ml/ipc/HWInferenceChild.cpp", "toolkit/components/ml/ipc/HWInferenceChild.h", "toolkit/components/ml/ipc/HWInferenceParent.cpp", "toolkit/components/ml/ipc/HWInferenceParent.h", "toolkit/components/ml/ipc/PHWInference.ipdl", "toolkit/components/ml/moz.build", "toolkit/components/ml/nsIMLModelResolver.idl"], "git_node": "65ee90ff8f2a6f64852fc7441976ec0da6a048f1", "git_parents": ["ad16c36ee2d0406fc255e2a9eb67252e5e7656a1"], "node": "a624029f63d0fd73608e71bc520372fe5f495813", "parents": ["4b1566881bb7ddf4bb66cf3c9ef6b9e36b0e5199"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Add isModelInstalled to ModelHub to check the local model cache. r=ai-platform-reviewers,valentinp\n\nisModelAvailable also reports true for a model that is not cached but merely\ndownloadable from the hub (it does a HEAD request), which is not what Web Speech\nneeds: it must know whether a download is required, to decide whether to prompt\nthe user.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313971\n", "files": ["toolkit/components/ml/MLModelHubService.sys.mjs", "toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/nsIMLModelHub.idl"], "git_node": "86dd616ad44b14479681e4323454a7989d202e70", "git_parents": ["65ee90ff8f2a6f64852fc7441976ec0da6a048f1"], "node": "76a91a8b51b535c4112fbc034e947d1273fecb7c", "parents": ["a624029f63d0fd73608e71bc520372fe5f495813"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2051970 - Add generic InstallModel/IsModelInstalled IPC messages to PHWInference. r=ipc-reviewers,ai-platform-reviewers,nika,gregtatum\n\nRecvInstallModel/SendInstallModel carry the requesting browsing-context\n(if coming from content) id, the utility-stamped content-process id and\na progress token, and route through nsIMLModelHub::DownloadModel with\nprogress and completion XPCOM callback adapters. A task may register an\nnsIMLModelDownloadGate (contract id\n\"@mozilla.org/ml/model-download-gate;1?task=\u003ctask\u003e\"); when one exists\nthe download proceeds only if the gate authorizes it, otherwise it\ndownloads unconditionally.\n\nThis is between HWUtility and Parent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309867\n", "files": ["toolkit/components/ml/ipc/HWInferenceChild.cpp", "toolkit/components/ml/ipc/HWInferenceChild.h", "toolkit/components/ml/ipc/HWInferenceManagerParent.h", "toolkit/components/ml/ipc/HWInferenceParent.cpp", "toolkit/components/ml/ipc/HWInferenceParent.h", "toolkit/components/ml/ipc/PHWInference.ipdl", "toolkit/components/ml/nsIMLModelHub.idl"], "git_node": "4fbbf84dfd839d26d61ea24b9fc6b8fb50f40187", "git_parents": ["86dd616ad44b14479681e4323454a7989d202e70"], "node": "4738cfcf61a686b6206f98c9587fa8645cc16b2e", "parents": ["76a91a8b51b535c4112fbc034e947d1273fecb7c"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2051970 - Allow getting a Blob of a model file in the HWInference process, cross-process, without copies. r=ipc-reviewers,nika,ai-platform-reviewers,gregtatum\n\nThis is be later used when initializing the speech recognition backend.\nThe files range from a hundreds megabyte to multiple gigabytes\n(depending on the quality and how many languages they can handle), so we\nreally need to avoid a copy here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268411\n", "files": ["toolkit/components/ml/ipc/HWInferenceChild.cpp", "toolkit/components/ml/ipc/HWInferenceChild.h", "toolkit/components/ml/ipc/HWInferenceParent.cpp", "toolkit/components/ml/ipc/HWInferenceParent.h", "toolkit/components/ml/ipc/PHWInference.ipdl"], "git_node": "27eff32504fe1e2a77766ccf66d22f24370148c4", "git_parents": ["4fbbf84dfd839d26d61ea24b9fc6b8fb50f40187"], "node": "b6c1f3457ae200601a4f7c479e8456af3f09dbc0", "parents": ["4738cfcf61a686b6206f98c9587fa8645cc16b2e"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2051970 - Add HWInference architecture and security documentation. r=ai-platform-reviewers,valentinp\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313816\n", "files": ["toolkit/components/ml/docs/HWInference.md", "toolkit/components/ml/docs/index.md"], "git_node": "52c6c6d4773d2400d46a8b04a596ac9018a6b136", "git_parents": ["27eff32504fe1e2a77766ccf66d22f24370148c4"], "node": "7a4e3a181bf1d329716708d58b52bb6bc96c2eca", "parents": ["b6c1f3457ae200601a4f7c479e8456af3f09dbc0"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062987 - Read the platform through a content-safe module. r=mbeier,urlbar-reviewers\n\n`AppConstants` is a system module, so a content-realm input can't import it, and\nunlike the rest of them the platform is needed outside the address bar. This\nmirrors `UrlbarContentPrefs`: privileged realms read `AppConstants`, a content\nrealm asks the actor. Reading it on first use rather than on import matters,\nsince a content realm has no port until the actor publishes one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319205\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarContentUtils.mjs", "browser/components/urlbar/content/UrlbarEventBufferer.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/jar.mn", "tools/@types/generated/tspaths.json"], "git_node": "eb9b275bf943a814c4a2337731733da8ae9f6317", "git_parents": ["52c6c6d4773d2400d46a8b04a596ac9018a6b136"], "node": "5ed25ca66dfce26ce0e1f37199a65a5f8e70a383", "parents": ["7a4e3a181bf1d329716708d58b52bb6bc96c2eca"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064014 - Commit Option value on mouse event for base select r=dom-core-reviewers,jjaschke\" for causing wpt failures in elect-click-drag-option.optional.html\n\nThis reverts commit ac447ee7cac922b09dc07f2936b5e2034390efc9.\n", "files": ["dom/html/HTMLSelectElement.cpp", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-events-2.optional.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-mouse-behavior.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-mousedown-slot-mutation.optional.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/switch-picker-appearance.html.ini"], "git_node": "bba821f1dc76d9e637878316c5435355b201dbb6", "git_parents": ["eb9b275bf943a814c4a2337731733da8ae9f6317"], "node": "f3080d4326be06ed717c72a6db42a315fffa0687", "parents": ["5ed25ca66dfce26ce0e1f37199a65a5f8e70a383"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2061110, handle popover hiding in a bit more consistent way, r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319204\n", "files": ["dom/base/Document.cpp"], "git_node": "bb55a98c530f70e661452cd897d4f5d5c42971e2", "git_parents": ["bba821f1dc76d9e637878316c5435355b201dbb6"], "node": "c00bff990c6c6811f55c7a459399701c3cf1cce2", "parents": ["f3080d4326be06ed717c72a6db42a315fffa0687"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063539 - Always resolve special target names, r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318844\n", "files": ["dom/base/nsGlobalWindowOuter.cpp"], "git_node": "b1523944cf73cd659ed4eea1a3e901bcf4505fe2", "git_parents": ["bb55a98c530f70e661452cd897d4f5d5c42971e2"], "node": "624da29702829328a91e987d7b4aae4ea4f3313c", "parents": ["c00bff990c6c6811f55c7a459399701c3cf1cce2"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2062527 - Respect the disable-extension policy in the add-ons sync engine. r=sync-reviewers,markh\n\nThe install path needs a check of its own: at onInstallStarted the add-on is\nnot in the database yet, so the AddonManager enforcement later in this stack\ndoes not cover it.\n\nIncoming records are skipped rather than failed, so this client keeps\ndisagreeing with the server record and will later upload enabled: true,\nre-enabling the add-on on clients that are not under policy. That is preferred\nto failing the record and retrying it on every sync.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318136\n", "files": ["services/sync/modules/addonutils.sys.mjs", "services/sync/modules/engines/addons.sys.mjs", "services/sync/tests/unit/test_addon_utils.js", "services/sync/tests/unit/test_addons_store.js"], "git_node": "f896c1af3767eb49ee09f5341d6b67835a302288", "git_parents": ["b1523944cf73cd659ed4eea1a3e901bcf4505fe2"], "node": "6d5c6e226299b5469b11130283d60fe5d05fe6cf", "parents": ["624da29702829328a91e987d7b4aae4ea4f3313c"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2062527 - Hide the disable-extension button for policy-locked extensions. r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318137\n", "files": ["browser/components/preferences/extensionControlled.js", "browser/components/preferences/tests/chrome/test_setting_control_extension_controlled.html", "browser/components/preferences/widgets/setting-control/setting-control.mjs", "browser/components/preferences/widgets/setting-control/setting-control.stories.mjs", "toolkit/content/preferences/Setting.mjs"], "git_node": "b3a420c966146097ad73cf7ed6c01c347048a255", "git_parents": ["f896c1af3767eb49ee09f5341d6b67835a302288"], "node": "8690d5e2af0f0cad262688198f846ed533658107", "parents": ["6d5c6e226299b5469b11130283d60fe5d05fe6cf"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2062527 - Enforce the disable-extension policy in the Add-ons Manager. r=extension-reviewers,robwu\n\nmanagement.setEnabled tests the policy directly instead of PERM_CAN_DISABLE.\nThat permission bit is also missing for appDisabled add-ons, already-disabled\nadd-ons and the default theme, so relying on it would throw for calls that used\nto do nothing.\n\nThe tab-hide doorhanger is not shown at all for a locked add-on, since disabling\nis the only action it offers. This matches the existing handling of\ndistribution-installed add-ons.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318138\n", "files": ["browser/components/enterprisepolicies/tests/xpcshell/test_extensions.js", "browser/components/extensions/ExtensionControlledPopup.sys.mjs", "browser/components/extensions/test/browser/browser_ext_tabs_hide.js", "toolkit/components/extensions/parent/ext-management.js", "toolkit/components/extensions/test/xpcshell/test_ext_management_policy.js", "toolkit/mozapps/extensions/internal/XPIDatabase.sys.mjs"], "git_node": "279259ae28bb56292144d8451cced0b6cbb48705", "git_parents": ["b3a420c966146097ad73cf7ed6c01c347048a255"], "node": "2a590afe5e9441a77dd9e151a8b1d4c9e4ebc3b2", "parents": ["8690d5e2af0f0cad262688198f846ed533658107"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062987 - Gate the urlbar content modules' privileged imports on ChromeUtils. r=mbeier,urlbar-reviewers\n\nThese modules load into a content realm as soon as `\u003cmoz-urlbar\u003e` does, where\n`ChromeUtils` is undefined, so a module-scope dereference of it throws before any\ngetter is read. What the declarations name is address-bar-only, so a content\nrealm never needs one.\n\n`declareLazy` returns a new object rather than populating one, which doesn't fit\ninside the gate, so the input's XPCOM services move to\n`defineLazyServiceGetters`. Their iids have to stay `Ci` interfaces -- passing the\ninterface name as a string fails at `getService` -- and the gate is what keeps\nthat off a content realm's path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319206\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/content/UrlbarTelemetryUtils.mjs", "browser/components/urlbar/content/UrlbarView.mjs"], "git_node": "f5862035e34cbac47447140cae9f88b24a9b7b37", "git_parents": ["279259ae28bb56292144d8451cced0b6cbb48705"], "node": "54bcb829c8ab103837c58d1398fb48a7d9c114f4", "parents": ["2a590afe5e9441a77dd9e151a8b1d4c9e4ebc3b2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064185 - Remove the bare ChromeUtils uses in urlbar content code. r=mbeier,urlbar-reviewers\n\n`SearchModeSwitcher`'s `QueryInterface` is dead -- nothing registers it with the\nobserver service anymore, and `Cu.getWeakReference`, which is what\n`UrlbarPrefs.addObserver` uses, works on a plain object. `UrlbarInputBase`'s\nobserver was a field initializer, so it ran `generateQI` for every input;\nbuilding it where it's registered keeps it in the branch that needs the observer\nservice anyway.\n\nThe telemetry `event.timeStamp || ChromeUtils.now()` fallback is unreachable:\nevery caller passes a DOM event, and even the undispatched `CustomEvent` the\ntab-switch path constructs carries a timeStamp. Both copies drop it. It read from\na different clock than `event.timeStamp` does, so it would have been off by the\nwindow's time origin had it ever fired.\n\nThe two `encodeURIForSrcset` calls stay: they build XUL, so a content realm never\nreaches them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319249\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarChildTelemetry.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "6fc6b8b803563f87a4131ce3568d292b2ae2e93f", "git_parents": ["f5862035e34cbac47447140cae9f88b24a9b7b37"], "node": "df9ba132e2a0c08f2c57ff8f32a992486c8862b6", "parents": ["54bcb829c8ab103837c58d1398fb48a7d9c114f4"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062987 - Read the window and its privateness without chrome-only APIs. r=mbeier,urlbar-reviewers\n\nFound by loading \u003cmoz-urlbar\u003e into about:newtab's content process: these are the\nfirst two constructor lines that run there. More chrome-only accesses remain\nfurther in (UrlbarView's documentGlobal uses, the windowUtils bounds helper).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319330\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/content/UrlbarContentUtils.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "1f835b24028a9360b71554d0000e2dc411cc18ce", "git_parents": ["6fc6b8b803563f87a4131ce3568d292b2ae2e93f"], "node": "90bd063d22d2c5d0c7c6f52f59e115bc1882c94b", "parents": ["df9ba132e2a0c08f2c57ff8f32a992486c8862b6"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047627 - Fix uninitialized corner shape values in theme drawing. r=gfx-reviewers,nical\n\nFollowing the first implementation of CSS corner shape rendering (see bug 2035317),\nthe struct wr::BorderRadius now has four new fields for the corner shapes, which\nwere left uninitialized here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317056\n", "files": ["widget/ThemeDrawing.cpp"], "git_node": "e6acc9c991ba54fde3fc4f1b3b7fb21264ec5c0e", "git_parents": ["1f835b24028a9360b71554d0000e2dc411cc18ce"], "node": "17086b9c0a4291cd88ac4ebe314d2688b2a0681e", "parents": ["90bd063d22d2c5d0c7c6f52f59e115bc1882c94b"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047627 - Improve superellipse normal approximation. r=gfx-reviewers,nical\n\nFix normal discontinuity when shape approaches 1 (round). Both normal approximations\nnow correctly converge towards axis-aligned normals when reaching a round shape, which\nmatches the preexisting implementation of ellipses for border radii, ensuring a smooth\ntransition between the two and no jumps when animating the shape parameter.\n\nThe new version of compute_superellipse_half_corner(), with the correction applied\nwith a quadratic falloff, actually becomes almost linear. Thus, a much cheaper linear\napproximation has been implemented, and is now used by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317057\n", "files": ["gfx/wr/webrender/res/ellipse.glsl", "gfx/wr/wrench/reftests/boxshadow/box-shadow-spread-shape.png", "gfx/wr/wrench/reftests/clip/clip-superellipse.png", "gfx/wr/wrench/reftests/mask/shaped-corners-inset.png", "gfx/wr/wrench/reftests/mask/shaped-corners-outset.png"], "git_node": "23f33fdf60c6dbbaa5b55f38559266f87e8edefd", "git_parents": ["e6acc9c991ba54fde3fc4f1b3b7fb21264ec5c0e"], "node": "8c8a5f38b7108c4b0fcf530e0ba5a3f59b6fc87c", "parents": ["17086b9c0a4291cd88ac4ebe314d2688b2a0681e"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047627 - Add support for CSS corner-shape in borders. r=gfx-reviewers,nical\n\nAdd support for corner-shape for most types of borders. The same shader is also\nused for outlines, and sometimes to draw rounded rects (see bug 1694269).\n\nAll border types are supported exept dotted and dashed. These are left as\nfuture work.\n\nSome other extreme edge cases (such as when corners overlap) are also not\nhandled correctly yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317058\n", "files": ["gfx/wr/webrender/res/border_shared.glsl", "gfx/wr/webrender/res/cs_border_segment.glsl", "gfx/wr/webrender/res/cs_border_solid.glsl", "gfx/wr/wrench/reftests/border/border-shape-2.png", "gfx/wr/wrench/reftests/border/border-shape-2.yaml", "gfx/wr/wrench/reftests/border/border-shape-3.png", "gfx/wr/wrench/reftests/border/border-shape-3.yaml", "gfx/wr/wrench/reftests/border/border-shape-4.png", "gfx/wr/wrench/reftests/border/border-shape-4.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/border-shape-inset.yaml", "gfx/wr/wrench/reftests/border/border-shape.png", "gfx/wr/wrench/reftests/border/border-shape.yaml", "gfx/wr/wrench/reftests/border/reftest.list", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-superellipse.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-squircle.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-concave.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-convex.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-100.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-inf.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-squircle.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini"], "git_node": "52b13de2b56ab849cca1d19c1a4fd4b06ce536b6", "git_parents": ["23f33fdf60c6dbbaa5b55f38559266f87e8edefd"], "node": "2041eb21fd84392e7bef81c100610206b13f7851", "parents": ["8c8a5f38b7108c4b0fcf530e0ba5a3f59b6fc87c"], "tags": []}, {"author": "Ruhollah Majdoddin \u003cr.majdodin@gmail.com\u003e", "branch": "default", "desc": "Bug 1695881 - Recompute scrollbar marks after find highlighting completes. r=NeilDeakin\n\nWhen \"Highlight All\" is toggled, the findbar sends\nFinder:HighlightAllChange before Finder:Highlight. On toggle-on the\nscroll marks update therefore runs from onHighlightAllChange while the\nfind selection is still empty, and the toggle-off pass has already\nremoved the marks and their listener, so it writes nothing. The\nhighlight pass that follows repopulates the selection, but nothing\nrecomputes the marks afterwards: the scrollbar stays empty until the\nnext search.\n\nRecompute the marks in Finder.highlight once highlighter.highlight()\nhas resolved and highlighting is on. Skip the recompute if the find\niterator is running again at that point: highlighter.highlight() can\nresolve without having finished its own iteration (isAlreadyRunning\nshort-circuit, concurrent stop or reset), and then the newer operation\nupdates the marks on its own path.\n\nFinder.highlight is not used by regular finds; it is reached from the\nfindbar's Highlight All checkbox, the GenAI page assist, and tests.\nThe message and its reply are unchanged. Comment 2 suggested making\nFinderParent.highlight send Finder:UpdateHighlightAndMatchCount\ninstead, which regresses browser_Finder.js: FinderHighlighter.update()\nnever reports found, so that reply loses the found flag that\nhighlight() preserves.\n\nThe new test toggles Highlight All off and back on without a new\nsearch and waits for find-scrollmarks-changed after each toggle;\nwithout the fix, the toggle-on wait times out.\n\nThis work was done with AI assistance; I have reviewed and can explain\nevery line.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317587\n", "files": ["toolkit/content/tests/browser/browser_findbar_marks.js", "toolkit/modules/Finder.sys.mjs"], "git_node": "65d20bd92fcd12408ac0723c42478986972c03db", "git_parents": ["52b13de2b56ab849cca1d19c1a4fd4b06ce536b6"], "node": "82eec5f29b18a05d66790fc473dabdfc88e1b236", "parents": ["2041eb21fd84392e7bef81c100610206b13f7851"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023603 - Emit raw HTML links in ETP matrix pref table to avoid MyST multi-param query bug. r=manuel\n\nWhen a URL contains multiple query parameters MyST-Parser mis-encodes\nthe ampersand, producing broken links in the Privacy Capabilities\nOverview table.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319444\n", "files": ["docs/_addons/etp_matrix.py"], "git_node": "e7fc67dc6b8d600bb8c3c36fde532e85a4888127", "git_parents": ["65d20bd92fcd12408ac0723c42478986972c03db"], "node": "16c54fbafa22d3fabd80362c316986c22c30d061", "parents": ["82eec5f29b18a05d66790fc473dabdfc88e1b236"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061488 - Stop recording SEARCH_SUGGESTIONS_LATENCY_MS to legacy telemetry and for non-configuration engines. r=search-reviewers,TravisLong,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316929\n", "files": ["toolkit/components/search/SearchSuggestionController.sys.mjs", "toolkit/components/search/metrics.yaml", "toolkit/components/search/tests/xpcshell/test_searchSuggest.js", "toolkit/components/telemetry/Histograms.json"], "git_node": "a00a0ef38bc3b68bea7f14a2d70e755bcb61b89c", "git_parents": ["e7fc67dc6b8d600bb8c3c36fde532e85a4888127"], "node": "740f59c611d9c5762e749ffcecaa4d70204bd250", "parents": ["16c54fbafa22d3fabd80362c316986c22c30d061"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058729 - Guard accessing searchProviderInfo - r=search-reviewers,scunnane\n\nIt's possible for onLocationChange to trigger a call to updateTrackingStatus\nwhich could eventually call _searchProviderInfo which may not be populated\nwith information yet due to awaiting the data from Remote Settings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319159\n", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs"], "git_node": "7cd2d9a358ae27819d6585c6d53f7cc714d5f5a4", "git_parents": ["a00a0ef38bc3b68bea7f14a2d70e755bcb61b89c"], "node": "0da8f2f12e55d8938f7f39c98f92d7577832547b", "parents": ["740f59c611d9c5762e749ffcecaa4d70204bd250"], "tags": []}, {"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2058627 - WebRTC backport: Screen capture: check n_datas before accessing buffer data planes r=pehrsons\n\nReturn early from ProcessBuffer when spa_buffer-\u003en_datas is zero\nto avoid out-of-bounds access on metadata-only buffers that carry\nno data planes.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: 3ce78cdbd865ad8837d1ffae21553791e8ec491d\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319390\n", "files": ["third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream.cc", "third_party/libwebrtc/moz-patch-stack/3ce78cdbd8.no-op-cherry-pick-msg"], "git_node": "01a6baa010f0fed30ef3797a458f3bc74e5a5e69", "git_parents": ["7cd2d9a358ae27819d6585c6d53f7cc714d5f5a4"], "node": "939417654223c4bbd9a8465cb96c6b01d80cf092", "parents": ["0da8f2f12e55d8938f7f39c98f92d7577832547b"], "tags": []}, {"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2055703 - WebRTC backport: Screen capture: reject negative videocrop position values r=pehrsons\n\nValidate that SPA_META_VideoCrop position coordinates are\nnon-negative before using them as offsets into the frame buffer.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: f93c4fefee56b60876629d03df1ad01e203cc8c3\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319398\n", "files": ["third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream.cc", "third_party/libwebrtc/moz-patch-stack/f93c4fefee.no-op-cherry-pick-msg"], "git_node": "a87b67fc99ea56e38f38990a96530539bf4b03c8", "git_parents": ["01a6baa010f0fed30ef3797a458f3bc74e5a5e69"], "node": "c814c6d6515563ed9e53d7ad0cc7968fab42353a", "parents": ["939417654223c4bbd9a8465cb96c6b01d80cf092"], "tags": []}, {"author": "Hugo Osvaldo Barrera \u003chugo@whynothugo.nl\u003e", "branch": "default", "desc": "Bug 2063808 Fix build failure with --with-system-av1 r=padenot DONTBUILD\n\nWhen building with --with-system-av1 tries to link a statically-compiled\nlibgkcodecs, which doesn't exist since we're using the system shared\nobject.\n\nAdd a guard following the same pattern established by all the other\n--with-system-XXX flags.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319414\n", "files": ["config/external/gkcodecs/gkcodecs.symbols", "config/external/gkcodecs/moz.build"], "git_node": "42142c2a7b14e83be4e20114eb2b490b2dcb3eb3", "git_parents": ["a87b67fc99ea56e38f38990a96530539bf4b03c8"], "node": "e3cf086bbee8f52198633acca3f8c8179792cc54", "parents": ["c814c6d6515563ed9e53d7ad0cc7968fab42353a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062572 - Wait for the notification panel to be open in the add-on install helpers, and re-enable the tests that were skipped for it, r=extension-reviewers,rpl.\n\nWaiting for the popup to be open before interacting with its contents. Its\ncontents are invisible to the accessibility APIs and not focusable before that,\nwhich is the intermittent \"Node is not focusable via the accessibility API\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318040\n", "files": ["dom/midi/tests/browser.toml", "toolkit/mozapps/extensions/test/browser/browser.toml", "toolkit/mozapps/extensions/test/browser/browser_html_list_view_recommendations.js", "toolkit/mozapps/extensions/test/xpinstall/helpers_addons_install_dialogs.js"], "git_node": "08e8281df12b92e1e82459ea4ce5266a706cf47f", "git_parents": ["42142c2a7b14e83be4e20114eb2b490b2dcb3eb3"], "node": "1044d4f1980aa4dca98bcb18de2531876278cd63", "parents": ["e3cf086bbee8f52198633acca3f8c8179792cc54"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064350 - Fix dom/media/webcodecs/test_encoding_process(_gpu).html when prefs disabled. r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319448\n", "files": ["dom/media/webcodecs/test/encoding_process.js"], "git_node": "bb9de290c077aa21e4c36a3dee66de9e2aae43ef", "git_parents": ["08e8281df12b92e1e82459ea4ce5266a706cf47f"], "node": "10680c05d4b70528483b7fef29ab49a866bd177d", "parents": ["1044d4f1980aa4dca98bcb18de2531876278cd63"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064120 - Use default operator equal implementation for mfbt/ r=nika\n\nNo code generation impact expected, just easier maintenance.\n\nIn a few case, the spaceship operator could be used, but that's out of\nscope for this patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319166\n", "files": ["mfbt/Array.h", "mfbt/BitSet.h", "mfbt/Char16.h", "mfbt/CompactPair.h", "mfbt/DoublyLinkedList.h", "mfbt/EnumSet.h", "mfbt/EnumeratedRange.h", "mfbt/IntegerRange.h", "mfbt/LinkedList.h", "mfbt/Opaque.h", "mfbt/Saturate.h", "mfbt/ThreadSafeWeakPtr.h", "mfbt/UniquePtrExtensions.h", "mfbt/tests/TestCumulativeAverage.cpp", "mfbt/tests/TestRollingMean.cpp"], "git_node": "77506ffd42d5fda270779a57e39f43a25b795106", "git_parents": ["bb9de290c077aa21e4c36a3dee66de9e2aae43ef"], "node": "90e1e65b3e9c3446e52108eef43583ab3237398e", "parents": ["10680c05d4b70528483b7fef29ab49a866bd177d"], "tags": []}, {"author": "calixteman \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2057889 - Make waitForPdfJS tolerant of cancelled page renders r=sylvestre\n\nOpening the PDF outline sidebar can change the auto zoom and cancel an in-flight page render. Since waitForPdfJS paired pagerender and textlayerrendered events, the missing textlayerrendered left its counter unbalanced and tests timed out.\n\nWait for loaded pages to have complete text layers instead, and re-enable browser_pdfjs_js.js.\n\nAlso fixes bug 2028655.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316033\n", "files": ["toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_js.js", "toolkit/components/pdfjs/test/head.js"], "git_node": "0c511165506a5b725a44f674a332c5400b115744", "git_parents": ["77506ffd42d5fda270779a57e39f43a25b795106"], "node": "160a16d1b0af280aa2a2b9f529171685c16208ee", "parents": ["90e1e65b3e9c3446e52108eef43583ab3237398e"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055837 - use uv in reftest tasks. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312752\n", "files": ["taskcluster/kinds/reftest/kind.yml"], "git_node": "e1440e47be128a89c1d3a8ec2bb7cee6f5c7670f", "git_parents": ["0c511165506a5b725a44f674a332c5400b115744"], "node": "41a801c2357d6916b755fc9095cec0f0202d0465", "parents": ["160a16d1b0af280aa2a2b9f529171685c16208ee"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2064188 - Ensure Nimbus update timer is set during init r=nimbus-reviewers,emcminn\n\nIn bug 1941963, side effects were removed from\nRemoteSettingsExperimentLoader.sys.mjs, making it safe to import without\ntriggering the creation of a global RemoteSettingsExperimentLoader.\nHowever, that patch also gated setting the update timer based on the\nRemoteSettingsExperimentLoader's enabled state. Unfortunately,\nthe timer was registered *before* the enabled flag was set, which meant\nthat the timer was never actually registered.\n\nWe now ensure that we set the enable state before registering the timer.\nThis behaviour is tracked by a new test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319282\n", "files": ["toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_timer.js", "toolkit/components/nimbus/test/unit/xpcshell.toml"], "git_node": "93b3cf0ca22fc0cd12b058304c6d7ddcc98ac128", "git_parents": ["e1440e47be128a89c1d3a8ec2bb7cee6f5c7670f"], "node": "d86f51147a1cc64ba2f5538d5b9157aea7a516cc", "parents": ["41a801c2357d6916b755fc9095cec0f0202d0465"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047627 - Add support for CSS corner-shape in borders. r=gfx-reviewers,nical\" for causing failures at browser_aboutCertError_coop.js.\n\nThis reverts commit 52b13de2b56ab849cca1d19c1a4fd4b06ce536b6.\n\nRevert \"Bug 2047627 - Improve superellipse normal approximation. r=gfx-reviewers,nical\"\n\nThis reverts commit 23f33fdf60c6dbbaa5b55f38559266f87e8edefd.\n\nRevert \"Bug 2047627 - Fix uninitialized corner shape values in theme drawing. r=gfx-reviewers,nical\"\n\nThis reverts commit e6acc9c991ba54fde3fc4f1b3b7fb21264ec5c0e.\n", "files": ["gfx/wr/webrender/res/border_shared.glsl", "gfx/wr/webrender/res/cs_border_segment.glsl", "gfx/wr/webrender/res/cs_border_solid.glsl", "gfx/wr/webrender/res/ellipse.glsl", "gfx/wr/wrench/reftests/border/border-shape-2.png", "gfx/wr/wrench/reftests/border/border-shape-2.yaml", "gfx/wr/wrench/reftests/border/border-shape-3.png", "gfx/wr/wrench/reftests/border/border-shape-3.yaml", "gfx/wr/wrench/reftests/border/border-shape-4.png", "gfx/wr/wrench/reftests/border/border-shape-4.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/border-shape-inset.yaml", "gfx/wr/wrench/reftests/border/border-shape.png", "gfx/wr/wrench/reftests/border/border-shape.yaml", "gfx/wr/wrench/reftests/border/reftest.list", "gfx/wr/wrench/reftests/boxshadow/box-shadow-spread-shape.png", "gfx/wr/wrench/reftests/clip/clip-superellipse.png", "gfx/wr/wrench/reftests/mask/shaped-corners-inset.png", "gfx/wr/wrench/reftests/mask/shaped-corners-outset.png", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-superellipse.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-squircle.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-concave.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-convex.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-100.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-inf.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-squircle.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini", "widget/ThemeDrawing.cpp"], "git_node": "ca84de6915a48ae8ccdb510bf776e5d949ae68c7", "git_parents": ["93b3cf0ca22fc0cd12b058304c6d7ddcc98ac128"], "node": "3aa8b8f324457ebd3e3b547e78f68cb2f6833545", "parents": ["d86f51147a1cc64ba2f5538d5b9157aea7a516cc"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064120 - Use default operator equal implementation for mfbt/ r=nika\" for causing SM bustages in shell.js.\n\nThis reverts commit 77506ffd42d5fda270779a57e39f43a25b795106.\n", "files": ["mfbt/Array.h", "mfbt/BitSet.h", "mfbt/Char16.h", "mfbt/CompactPair.h", "mfbt/DoublyLinkedList.h", "mfbt/EnumSet.h", "mfbt/EnumeratedRange.h", "mfbt/IntegerRange.h", "mfbt/LinkedList.h", "mfbt/Opaque.h", "mfbt/Saturate.h", "mfbt/ThreadSafeWeakPtr.h", "mfbt/UniquePtrExtensions.h", "mfbt/tests/TestCumulativeAverage.cpp", "mfbt/tests/TestRollingMean.cpp"], "git_node": "0972179421945ba953a0b6b48c29ed906bc64686", "git_parents": ["ca84de6915a48ae8ccdb510bf776e5d949ae68c7"], "node": "52b01961b6bb4c3f9f95d83846fa9c5029cf357c", "parents": ["3aa8b8f324457ebd3e3b547e78f68cb2f6833545"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056718 - Fix Reversing Tabs in Split View Permanently Breaks Ctrl+F r=tabbrowser-reviewers,nsharpley,tgiles\n\nRoot Cause: MozTabpanels.setSplitViewActive() uses moveBefore() to reorder panels in DOM order. The default behavior of a custom element, when reparented, is to fire off a disconnectedCallback() -\u003e connectedCallback() sequence. This means that reordering a split view causes unnecessary destroying and rebuilding the findbar.\n\nFix: Define connectedMoveCallback() to be a no-op, so that moveBefore() completes without unintended side effects. Similar to the fix for Bug 2007742.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318144\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_findbar.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_tab_order.js", "browser/components/tabbrowser/test/browser/tabs/head.js", "toolkit/content/widgets/findbar.js"], "git_node": "2a20f8f055345b37ef00f0aee41cc36778d5a085", "git_parents": ["0972179421945ba953a0b6b48c29ed906bc64686"], "node": "8b56bb62e11037453c704fe0441336fb9d865b9e", "parents": ["52b01961b6bb4c3f9f95d83846fa9c5029cf357c"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038955 - Rename gfxFontEntry::GetSkrifaFontFace to GetSkrifaFont, and attempt to initialize the Skrifa font on first use. r=AlaskanEmily\n\nThis introduces an InitSkrifaFontFace() virtual method that is called by GetSkrifaFont\nif the ref has not yet been initialized. Subclasses should implement this to create the\nSkrifa reference and assign it using SetSkrifaFont.\n\nThis will allow the Skrifa font ref to be created on demand, rather than having to\nunconditionally initialize it before we know for sure it's going to be used.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319119\n", "files": ["gfx/thebes/gfxFontEntry.h"], "git_node": "d8cc73bc0f34795293a94f1cd9f56c13b905db3e", "git_parents": ["2a20f8f055345b37ef00f0aee41cc36778d5a085"], "node": "c525fb71ac51b522446661bc478303a9c568fcd7", "parents": ["8b56bb62e11037453c704fe0441336fb9d865b9e"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038955 - Use Skrifa font, if present, to implement RealFaceName. r=AlaskanEmily\n\nAs a temporary hack, in nightly builds (only), we append \"(skrifa)\" to the name\nso that the devtools Fonts panel will reveal whether a given font has a Skrifa face\nin use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319124\n", "files": ["gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h"], "git_node": "bcc550ed0ebc7b5b7765da0f4ea1421a3b6506f1", "git_parents": ["d8cc73bc0f34795293a94f1cd9f56c13b905db3e"], "node": "ccf063ce6fba64fe23cbb9241e80ad4ee0e7fe25", "parents": ["c525fb71ac51b522446661bc478303a9c568fcd7"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040362 - Use Skrifa font, if available, to implement gfxFontEntry::GetFontTable. r=AlaskanEmily\n\nThis means that when a skrifa face is present, we can bypass the per-platform versions\nof GetFontTable/CopyFontTable and the gfxFontEntry table cache.\n\nNote that platforms which currently override GetFontTable will need to explicitly\ncall the base implementation if they want to use this. (Maybe to be re-architected\nin due course.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319125\n", "files": ["gfx/thebes/gfxFontEntry.cpp"], "git_node": "d5e4a5f164c7325ab8aa1ab9e4ac8846108cb4f0", "git_parents": ["bcc550ed0ebc7b5b7765da0f4ea1421a3b6506f1"], "node": "11870f2184d3f8c891257fd810626006aee65a41", "parents": ["ccf063ce6fba64fe23cbb9241e80ad4ee0e7fe25"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040362 - Move platform overrides of GetFontTable to GetFontTableInternal, and make public gfxFontEntry::GetFontTable API a non-virtual function. r=AlaskanEmily\n\nThis means that for the case where we have a Skrifa font ref (eventually the standard case),\nGetFontTable no longer involves a virtual call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319127\n", "files": ["gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/CoreTextFontList.h", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h"], "git_node": "1c8c9f303d3d8b6b8b6d4e3f6879aedb17f34cf5", "git_parents": ["d5e4a5f164c7325ab8aa1ab9e4ac8846108cb4f0"], "node": "867b8770df769d303b6d5ddbe1f2a9931baab396", "parents": ["11870f2184d3f8c891257fd810626006aee65a41"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038956 - Create a Skrifa font ref for downloaded webfonts. r=AlaskanEmily\n\nOwnership of the FontData record is passed to the gfxUserFontData attached to\nthe platform font entry, to ensure the reference persists as long as the font\nthat's using it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319129\n", "files": ["gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxUserFontSet.cpp", "gfx/thebes/gfxUserFontSet.h"], "git_node": "81a80ae3c96a0d8d8066a88ac437387b324c09ab", "git_parents": ["1c8c9f303d3d8b6b8b6d4e3f6879aedb17f34cf5"], "node": "bb0eaaf0a2dba22ac887ea0aa76adb0d5e495c62", "parents": ["867b8770df769d303b6d5ddbe1f2a9931baab396"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040363 - Use gecko's gfxFontVariation type in fontations_glue, rather than defining a new type for the interface. r=AlaskanEmily\n\nTo get metrics, we need to tell Skrifa the variation coordinates in question.\nThe original glue code defined its own type for this, but we have an equivalent one\nthat is already exposed to rust, so we should simply use that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319130\n", "files": ["Cargo.lock", "gfx/fontations_glue/Cargo.toml", "gfx/fontations_glue/lib.rs"], "git_node": "9f74f4f7917a203559f07ca18353e08b324d9250", "git_parents": ["81a80ae3c96a0d8d8066a88ac437387b324c09ab"], "node": "42ba51c8ef5316fa01a11c853e12e5d07dcec918", "parents": ["bb0eaaf0a2dba22ac887ea0aa76adb0d5e495c62"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040363 - Have skrifa_font_get_metrics() return zero rather than NaN for unavailable metrics. r=AlaskanEmily\n\nThis integrates more easily with existing code that will \"sanitize\" the metrics\nretrieved from the font, which includes replacing unexpected zeroes with fallback\nvalues. There's no need for us to distinguish \"missing\" from \"present but zero\"\nfor any of these, and returning NaN would force the caller to do an extra check\nin each case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319132\n", "files": ["gfx/fontations_glue/lib.rs"], "git_node": "5a79446528d38e991df87e91ced684a905db16ab", "git_parents": ["9f74f4f7917a203559f07ca18353e08b324d9250"], "node": "226f87867bbb5a8bad20b4230984a868f22e3843", "parents": ["42ba51c8ef5316fa01a11c853e12e5d07dcec918"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040363 - Implement an InitMetricsFromSkrifa method in gfxFont. r=AlaskanEmily\n\nThis doesn't immediately do anything; for now it's up to each platform implementation\nto call this if it wants to use the skrifa-derived metrics.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319177\n", "files": ["gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h"], "git_node": "6fb3b3345a7e44f0917a62d3fe23b7d66dc22409", "git_parents": ["5a79446528d38e991df87e91ced684a905db16ab"], "node": "49705424e7cd161465ed3a9316129ff67cf1120d", "parents": ["226f87867bbb5a8bad20b4230984a868f22e3843"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040372 - Try to use skrifa for installed Core Text fonts. r=AlaskanEmily\n\nI think there may be cases where we won't be able to get a path to a font file from\na Core Text/Core Graphics font reference, in which case we'll need an alternative\ncode path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319179\n", "files": ["gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/CoreTextFontList.h"], "git_node": "19ed1a0558ec17565a791e4875ca288d47b4c77c", "git_parents": ["6fb3b3345a7e44f0917a62d3fe23b7d66dc22409"], "node": "9320cefd99b6d4425c16f6e5757b9273b548a038", "parents": ["49705424e7cd161465ed3a9316129ff67cf1120d"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040372 - Prefer to use InitMetricsFromSkrifa in gfxMacFont if available. r=AlaskanEmily\n\ngfxMacFont already has a couple of alternative paths for metrics initialization,\nso adding in InitMetricsFromSkrifa as the first preference is a simple change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319180\n", "files": ["gfx/thebes/gfxMacFont.cpp"], "git_node": "544c9d5ef8f47c523841d357793a6ce285695ac7", "git_parents": ["19ed1a0558ec17565a791e4875ca288d47b4c77c"], "node": "28f4216c5f95c1c262a004dd0537bec3b49cb3d8", "parents": ["9320cefd99b6d4425c16f6e5757b9273b548a038"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2038955, 2038956, 2040362, 2040363, 2040372: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxUserFontSet.cpp"], "git_node": "3ddf5277a4be6dcc0f8cf1d995d025884f335d8a", "git_parents": ["544c9d5ef8f47c523841d357793a6ce285695ac7"], "node": "f99492689fb67be5318a747e65434d35e20c16f2", "parents": ["28f4216c5f95c1c262a004dd0537bec3b49cb3d8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062448 - Drop the AI Window tests' hand-rolled bounded mutation wait. r=flozia\n\nwaitForMutationBounded raced BrowserTestUtils.waitForMutationCondition against a\ntimer because the helper itself could not fail. It can now, so ask it for the\nbound directly. Its sole caller keeps the same 15s budget and the same label in\nthe failure message.\n\nWorth noting: when the race timed out it abandoned the underlying promise, so the\nMutationObserver stayed connected for the rest of the test; the helper disconnects\non every exit path.\n\nspawnBounded stays as it is - it bounds a SpecialPowers.spawn, and the content-side\nContentTaskUtils.waitForMutationCondition still has no timeout of its own.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317818\n", "files": ["browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "b9ddc0ae9da7e04a1330addf27740b1731b88e10", "git_parents": ["3ddf5277a4be6dcc0f8cf1d995d025884f335d8a"], "node": "faf2215348033c3f51c47a3e2bcd1c4cb07dbe69", "parents": ["f99492689fb67be5318a747e65434d35e20c16f2"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035045 - Convert the date picker min and max dates to midnight UTC r=android-reviewers,lmccracken\n\nMaterialDatePicker represents its dates in UTC milliseconds and asks its validator about each day as midnight UTC. DateValidatorPointForward.from() and DateValidatorPointBackward.before() need to use the same UTC representation. The min and max dates were passed in the device timezone instead, so each bound was a moment in time rather than a day.\n\nAs a consequence:\n- The max day was greyed out in timezones ahead of UTC\n- The min day was greyed out in timezones behind UTC\n- The min day was greyed out in every timezone when the min date had a time of day\n\ntoLocalDayStartAsUtcMillis() drops the time of day rather than shifting it by the offset and returns midnight UTC on that day. For max=\"2018-12-31\" in Paris, the Date is 2018-12-30T23:00Z. toLocalDayStartAsUtcMillis() reads this date as 2018-12-31 in Parisand returns 2018-12-31T00:00Z. Before this change, this max date would remain 2018-12-30T23:00Z, making 2018-12-31 an invalid date on the calendar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318497\n", "files": ["mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/dialog/TimePickerDialogFragment.kt", "mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/ext/Calendar.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/dialog/TimePickerDialogFragmentTest.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/ext/CalendarTest.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/ext/EpochMillis.kt"], "git_node": "a43defbbe84c8f523839e5aa0446f93ed14d3ca8", "git_parents": ["b9ddc0ae9da7e04a1330addf27740b1731b88e10"], "node": "c0367a804c440a8eba1bffc56e42f1081184d8e0", "parents": ["faf2215348033c3f51c47a3e2bcd1c4cb07dbe69"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062145 - Report tests that leave a panel or menupopup open at the end of the test file, r=Gijs.\n\nA leaked popup covers the browser for the next test file, which then gets\nblamed for the failures it causes, and isGloballyBlockingOpenPopup makes\nopenPopup() refuse outright while one is open.\n\nThe check ends any hover with a synthesized mousecancel first: there is no\ninert point in the browser window to move the pointer to, and mouseout is\nrewritten into a mousemove at the given point, which left tab previews open.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317411\n", "files": ["testing/mochitest/browser-test.js"], "git_node": "0936b518d50dcd6f6265e31d1b1c56ad6428ccb9", "git_parents": ["a43defbbe84c8f523839e5aa0446f93ed14d3ca8"], "node": "e924989b1ab9296c0780cb25bf2edce0f779bb4c", "parents": ["c0367a804c440a8eba1bffc56e42f1081184d8e0"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1980036: Park the OS pointer away from the tab strip in browser_tab_preview.js r=sthompson,tabbrowser-reviewers\n\nThe root cause of some of the issues on this intermittent seem to be\nthat the OS pointer placement is interfering with the synthesized\nevents. This moves the OS pointer out of the way at the start of each\ntest and removes the more brittle retry mechanism that landed in\nhttps://phabricator.services.mozilla.com/D317870.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319464\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser_tab_preview.js"], "git_node": "52f9e52dd67f658b261a4f99098d5abeb88b3429", "git_parents": ["0936b518d50dcd6f6265e31d1b1c56ad6428ccb9"], "node": "fa09f4d30284e0dcd1026e7c1ded879c3f14efc1", "parents": ["e924989b1ab9296c0780cb25bf2edce0f779bb4c"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2024918 - wasm: Add test. r=jseward\n\nDifferential Revision: https://phabricator.services.mozilla.com/D288999\n", "files": ["js/src/jit-test/tests/wasm/regress/bug2024918.js"], "git_node": "bdc273a75d37e0796141d5d95f8284fe93bdecb0", "git_parents": ["52f9e52dd67f658b261a4f99098d5abeb88b3429"], "node": "4c542e93014e0e4d009fb86aa6f9fa924bb23853", "parents": ["fa09f4d30284e0dcd1026e7c1ded879c3f14efc1"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 1987624 - wasm: Add test. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D264479\n", "files": ["js/src/jit-test/tests/wasm/regress/bug1987624.js"], "git_node": "78364d6fc63dd0faeead748883877eea8e0d5e10", "git_parents": ["bdc273a75d37e0796141d5d95f8284fe93bdecb0"], "node": "3336444c1dd526183c0b64299fa455a70b883d65", "parents": ["4c542e93014e0e4d009fb86aa6f9fa924bb23853"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064014 - Commit Option value on mouse event for base select r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319091\n", "files": ["dom/html/HTMLSelectElement.cpp", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-click-drag-option.optional.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-events-2.optional.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-mouse-behavior.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-mousedown-slot-mutation.optional.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/switch-picker-appearance.html.ini"], "git_node": "94d0194f9a11b670c1546fd1fba511ca7416e593", "git_parents": ["78364d6fc63dd0faeead748883877eea8e0d5e10"], "node": "db85aeac7ad89b26bb4172ab1e54f6a528809c4d", "parents": ["3336444c1dd526183c0b64299fa455a70b883d65"], "tags": []}, {"author": "Benjamin Peterson \u003cbenjamin@python.org\u003e", "branch": "default", "desc": "Bug 2064234 - Drop empty js/src/wasm/test.js file. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319285\n", "files": ["js/src/wasm/test.js"], "git_node": "c74641605a9a30e91540180c43346ce2c9614c8b", "git_parents": ["94d0194f9a11b670c1546fd1fba511ca7416e593"], "node": "bca1acec6ab29db567dc7da77a34a71ca657393d", "parents": ["db85aeac7ad89b26bb4172ab1e54f6a528809c4d"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064292 - Include Assembler-arm.h in MoveEmitter-arm.h to fix ARM non-unified build. r=spidermonkey-reviewers,jandem\n\nMoveEmitter-arm.h uses InvalidReg, which is declared in\njit/arm/Assembler-arm.h, but the header did not include it. In a unified\nbuild, another file in the same unified chunk supplies the declaration,\nso the omission is not visible. When the chunk boundaries move, the\nheader fails to compile on its own:\n\njs/src/jit/arm/MoveEmitter-arm.h:35:26: error: use of undeclared identifier 'InvalidReg'; did you mean 'Invalid'?\n   35 |   Register spilledReg_ = InvalidReg;\n      |                          ^~~~~~~~~~\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319385\n", "files": ["js/src/jit/arm/MoveEmitter-arm.h"], "git_node": "72ff7d60a8abcc775da31e710f070123928be515", "git_parents": ["c74641605a9a30e91540180c43346ce2c9614c8b"], "node": "682dff9175f87e71bb87d57837bb2d207cd644bd", "parents": ["bca1acec6ab29db567dc7da77a34a71ca657393d"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1695881 - Recompute scrollbar marks after find highlighting completes. r=NeilDeakin\" for causing failures at test_bug1566783.html.\n\nThis reverts commit 65d20bd92fcd12408ac0723c42478986972c03db.\n", "files": ["toolkit/content/tests/browser/browser_findbar_marks.js", "toolkit/modules/Finder.sys.mjs"], "git_node": "f49070959859668d38e125a09a153cfd4fd1bcbf", "git_parents": ["72ff7d60a8abcc775da31e710f070123928be515"], "node": "fa40b53429361af256f530f00613e5b453bae4df", "parents": ["682dff9175f87e71bb87d57837bb2d207cd644bd"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062145 - Report tests that leave a panel or menupopup open at the end of the test file, r=Gijs.\" for causing failures at browser_DownloadListener.js\n\nThis reverts commit 0936b518d50dcd6f6265e31d1b1c56ad6428ccb9.\n", "files": ["testing/mochitest/browser-test.js"], "git_node": "ddfc292177c0ce255910511e17f313ea144f8e24", "git_parents": ["f49070959859668d38e125a09a153cfd4fd1bcbf"], "node": "84e6bc1249e98f08f7ce76eda3c8128cf046343d", "parents": ["fa40b53429361af256f530f00613e5b453bae4df"], "tags": []}, {"author": "Gregory Mierzwinski \u003cgmierz1@live.ca\u003e", "branch": "default", "desc": "Bug 2064021 - Force new condprof profiles to be generated. r=kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319465\n", "files": ["taskcluster/kinds/condprof/kind.yml", "testing/condprofile/condprof/scenarii/full.py"], "git_node": "d3c6e4b70f09f7bfa395e2919f36b452d263a449", "git_parents": ["ddfc292177c0ce255910511e17f313ea144f8e24"], "node": "988a7b6d2d1ae0913a10d40c5dcd436f358c4edc", "parents": ["84e6bc1249e98f08f7ce76eda3c8128cf046343d"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057858 - skip browser_524745.js on Linux 22.04 r=nsharpley\n\nThis test fails when waiting for sizemodechange after minimizing a window. It fails consistently in the following configurations:\n\n- opt and debug\n- Nova enabled and Nova disabled\n\nThe most likely cause is that we aren't getting a signal from Wayland about a minimizing window. Don't know the root cause, but it's consistently occurring on Linux 22.04 Wayland.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318330\n", "files": ["browser/components/sessionstore/test/browser_oldformat.toml"], "git_node": "fab1d78900dfa1b95850c800eb2fdf3b57ec2e7b", "git_parents": ["d3c6e4b70f09f7bfa395e2919f36b452d263a449"], "node": "3c01ea20f2b1eea19f40e3f7fcf118d97fee3aa4", "parents": ["988a7b6d2d1ae0913a10d40c5dcd436f358c4edc"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2062426 - Add Darkest theme option to the Customize Settings r=android-reviewers,android-l10n-reviewers,parker,npoon\n\n- This only adds the theme option to the Customize Setting, and does not wire up to changes the theme option to utilize the OLED theme colors.\n- Figma: https://www.figma.com/design/TBCUJRlJuFnu5bygUvrzWY/OLED-Theme?node-id=2171-4227&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319406\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/CustomizationFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/customization_preferences.xml"], "git_node": "9d0a7dfb2d7b747dc33c211b657f2f096b2f7d7b", "git_parents": ["fab1d78900dfa1b95850c800eb2fdf3b57ec2e7b"], "node": "f2a39abaa2f95c777cbd0abc4931299b2ec3e19c", "parents": ["3c01ea20f2b1eea19f40e3f7fcf118d97fee3aa4"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058450 - Add new illustration for the extensions panel \"disabled extensions\" and \"private browsing\" empty states. r=robwu,desktop-theme-reviewers,mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317123\n", "files": ["browser/base/content/browser-addons.js", "browser/components/customizableui/content/panelUI.inc.xhtml", "browser/components/extensions/test/browser/browser_unified_extensions_empty_panel.js", "browser/themes/shared/addons/extensions-panel-empty-illustration.svg", "browser/themes/shared/addons/extensions-panel-empty-onboarding.svg", "browser/themes/shared/addons/extensions-panel-empty.svg", "browser/themes/shared/addons/unified-extensions.css", "browser/themes/shared/jar.inc.mn"], "git_node": "4099150629525658215b97dd9862c3b16302aa49", "git_parents": ["9d0a7dfb2d7b747dc33c211b657f2f096b2f7d7b"], "node": "4c8afdf041d5966dd2bbf72703efa22b4f42049d", "parents": ["f2a39abaa2f95c777cbd0abc4931299b2ec3e19c"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2063677 - Be more consistent with nsObserverService valid call checking. r=xpcom-reviewers,emilio\n\n* Release assert that we're on the main thread in Create. In RemoveObserver,\n  do the assert before we access the field.\n\n* Use a release assert in EnsureValidCall instead of the weird return that\n  never happens.\n\n* Assert that we're on the main thread in CollectReports, Shutdown and HasObservers.\n  These have a limited number of callers and are always done on the main thread.\n\n* The thread safety assertions are done with the ones defined in MainThreadUtils.\n  This loses the special message but it should be easy enough to figure it out.\n\n* Use default member initialization for mShuttingDown, and then the default\n  ctor.\n\n* Move mShuttingDown to the end to improve packing.\n\n* Make the ctor private. This should always be created through Create.\n\n* Get rid of the ancient void argument to the dtor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318781\n", "files": ["xpcom/ds/nsObserverService.cpp", "xpcom/ds/nsObserverService.h"], "git_node": "972bd3d3fec878694dae94a0410d7c43ea93e33d", "git_parents": ["4099150629525658215b97dd9862c3b16302aa49"], "node": "159d56b8761a342efb0f1ecd55c4dc5cf6d80d48", "parents": ["4c8afdf041d5966dd2bbf72703efa22b4f42049d"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062795 - tweak checkbox and radio styles for Nova r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319284\n", "files": ["widget/Theme.cpp"], "git_node": "e569a414e67f010d6042f162f3da7b7ddcb43e6b", "git_parents": ["972bd3d3fec878694dae94a0410d7c43ea93e33d"], "node": "e3e936686982a67afe1a33f86d28dc0e686dce77", "parents": ["159d56b8761a342efb0f1ecd55c4dc5cf6d80d48"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052769 - Replace MRU small atom cache with a direct-mapped cache for short Latin1 strings. r=emilio,smaug,dom-core-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311524\n", "files": ["xpcom/ds/nsAtomTable.cpp"], "git_node": "fe60da4e2c055894b689aebe5d4f51b56bd877b4", "git_parents": ["e569a414e67f010d6042f162f3da7b7ddcb43e6b"], "node": "a3aa83cfb13b34f438c0f785389b59745e5405c7", "parents": ["e3e936686982a67afe1a33f86d28dc0e686dce77"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052769 - Make ShortAtomCache set-associative. r=smaug,dom-core-reviewers\n\nBy using a 4-way set associative cache, we can reduce the cache miss rate\nand trade some of that to halve the overall cache size. Local sp3 profiling\nindicates this gets us to a near-perfect hit rate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316998\n", "files": ["xpcom/ds/nsAtomTable.cpp", "xpcom/tests/gtest/TestAtoms.cpp"], "git_node": "c4ee2239797fcb131af3e0b570735fbfaf10cbf6", "git_parents": ["fe60da4e2c055894b689aebe5d4f51b56bd877b4"], "node": "2f8e1d689585127589e85bfce29f07319eb47b84", "parents": ["a3aa83cfb13b34f438c0f785389b59745e5405c7"], "tags": []}, {"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062695 - Improve Precision for Clusters for Auto Tab Grouping. r=jlewis,tabbrowser-reviewers,dao\n\nThis patch adds the missed tab title preprocessing that was present in Smart Tab Grouping.\nIt also reduces false positives in clusters so groups have higher cohesion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319192\n", "files": ["browser/app/profile/firefox.js", "browser/components/tabbrowser/SmartTabGrouping.sys.mjs", "browser/components/tabbrowser/test/xpcshell/smarttabgrouping/test_text_preprocessing.js"], "git_node": "284be27450723815297f44fcb9c4162416b1660c", "git_parents": ["c4ee2239797fcb131af3e0b570735fbfaf10cbf6"], "node": "d03c49a02c94c3241a2a2b4bacbf25fdb05b63d4", "parents": ["2f8e1d689585127589e85bfce29f07319eb47b84"], "tags": []}, {"author": "Christopher DiPersio \u003ccdipersio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063727 - PUWYLO v0 Fast Follow : Reduce mismatch between follow up message and links contained in preview r=cmurray\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319187\n", "files": ["browser/components/aiwindow/models/ConversationSuggestions.sys.mjs", "browser/components/aiwindow/models/SearchBrowsingHistory.sys.mjs", "browser/components/aiwindow/models/memories/MemoriesHistorySource.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_conversation_starters.js"], "git_node": "f14236574a1e68c66a65c0f86570ab95caeafe2b", "git_parents": ["284be27450723815297f44fcb9c4162416b1660c"], "node": "7aebaf74e50636bffba6b129085770b3858a673f", "parents": ["d03c49a02c94c3241a2a2b4bacbf25fdb05b63d4"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063921 - Add the Translations Companion icon to the Translate QuickAction r=desktop-theme-reviewers,urlbar-reviewers,kcochrane,daleharvey\n\nThis commit introduces the newly designed icon for the `about:translations`\npage, as well as configures the Translate URL-bar QuickAction to utilize\nthe new icon.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318953\n", "files": ["browser/components/urlbar/QuickActionsLoaderDefault.sys.mjs", "browser/themes/shared/icons/translations-companion.svg", "browser/themes/shared/jar.inc.mn"], "git_node": "e4f49b121649a0477f7c020d85e316aefbb7d442", "git_parents": ["f14236574a1e68c66a65c0f86570ab95caeafe2b"], "node": "89aaa23dd758d1550ea244ad25f573eed83afc23", "parents": ["7aebaf74e50636bffba6b129085770b3858a673f"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064014 - Commit Option value on mouse event for base select r=dom-core-reviewers,jjaschke\" for causing wpt failures @select-click-drag-option.optional.html.\n\nThis reverts commit 94d0194f9a11b670c1546fd1fba511ca7416e593.\n", "files": ["dom/html/HTMLSelectElement.cpp", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-click-drag-option.optional.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-events-2.optional.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-mouse-behavior.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-mousedown-slot-mutation.optional.html.ini", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/switch-picker-appearance.html.ini"], "git_node": "eeef583e02da7a78f2beebb3e5ef7f519730426a", "git_parents": ["e4f49b121649a0477f7c020d85e316aefbb7d442"], "node": "18bd261350fba8d03bc29bf46acf5331500ee8be", "parents": ["89aaa23dd758d1550ea244ad25f573eed83afc23"], "tags": []}, {"author": "Exploding Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 2000658 - Copy Clean Link: Strip the rcm parameter on linkedin r=manuel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319541\n", "files": ["toolkit/components/antitracking/StripOnShareLists/MPL2/StripOnShare.json"], "git_node": "b67c6bcc8876f8616172fefb067e862b1d05dc30", "git_parents": ["eeef583e02da7a78f2beebb3e5ef7f519730426a"], "node": "e4968a38b0504913d510e9e48863dfc9fb4cac64", "parents": ["18bd261350fba8d03bc29bf46acf5331500ee8be"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064271 Part 1 - Remove redundant operator!= in layout/. r=layout-reviewers,firefox-style-system-reviewers,boris\n\nSince C++20, `a != b` is rewritten as `!(a == b)` when no viable\n`operator!=` is found, so declaring one is redundant whenever the\nclass has an `operator==`. It doesn't matter whether that `operator==`\nis `=default` or defined manually.\n\nNote on the removal of `StyleBox\u003cT\u003e::operator!=` in\n`ServoStyleConstsForwards.h`: it was implemented using `T::operator!=`, not the\nplain negation of `StyleBox\u003cT\u003e::operator==`. However, every T it wraps has a\ncbindgen-generated `T::operator==`, and the `T::operator!=` it used was either\n`!(*this == other)` or `a != b` for every member variable, so it is fine to\nremove `StyleBox\u003cT\u003e::operator!=`.\n\nThis patch doesn't change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319375\n", "files": ["layout/base/AnchorPositioningUtils.h", "layout/base/ScrollStyles.h", "layout/base/nsCSSFrameConstructor.h", "layout/generic/AspectRatio.h", "layout/generic/ReflowOutput.h", "layout/generic/RubyUtils.h", "layout/generic/ScrollGeneration.cpp", "layout/generic/ScrollGeneration.h", "layout/generic/WritingModes.h", "layout/generic/nsBlockFrame.cpp", "layout/generic/nsFrameList.h", "layout/generic/nsIFrame.h", "layout/generic/nsLineBox.h", "layout/generic/nsTextFrame.h", "layout/mathml/nsMathMLChar.h", "layout/painting/DisplayItemClip.h", "layout/painting/nsDisplayList.h", "layout/style/CSSPropertyId.h", "layout/style/ServoStyleConstsForwards.h", "layout/style/ServoStyleConstsInlines.h", "layout/style/StyleAnimationValue.cpp", "layout/style/StyleAnimationValue.h", "layout/style/nsCSSValue.h", "layout/style/nsStyleAutoArray.h", "layout/style/nsStyleStruct.h", "layout/svg/SVGImageContext.h", "servo/ports/geckolib/cbindgen.toml"], "git_node": "42c66872154a562cf0e6bcdc1afe9a10fe0797b2", "git_parents": ["b67c6bcc8876f8616172fefb067e862b1d05dc30"], "node": "fcc9012e567e50d755e16a6d14ef6ba8bb1a24d8", "parents": ["e4968a38b0504913d510e9e48863dfc9fb4cac64"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064271 Part 2 - Use C++20 defaulted operator== in layout/. r=layout-reviewers,firefox-style-system-reviewers,boris\n\nAll the `operator==` converted was implemented via comparing all the member\nvariables, so they can be implemented using `=default`.\n\nDrop the inaccurate comment for `nsStyleImageLayers::Layers::operator==` since\nthe `mImage` was compared using plain `==`.\n\nThis patch doesn't change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319376\n", "files": ["layout/style/nsStyleAutoArray.h", "layout/style/nsStyleStruct.cpp", "layout/style/nsStyleStruct.h", "layout/xul/tree/nsTreeStyleCache.cpp", "layout/xul/tree/nsTreeStyleCache.h"], "git_node": "db551c4afc279c68eba83ac624c47fc6be08f85a", "git_parents": ["42c66872154a562cf0e6bcdc1afe9a10fe0797b2"], "node": "f34170e2ab3b0cfffd32714b5ff36df05d4a5988", "parents": ["fcc9012e567e50d755e16a6d14ef6ba8bb1a24d8"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064271 Part 3 - Use C++20 defaulted operator\u003c=\u003e for ScrollGeneration. r=botond\n\n`ScrollGeneration`'s only member is a `uint64_t`, so a defaulted `operator\u003c=\u003e`\nadds all the comparison operators, making one caller less awkward.\n\nAdd `#include \u003ccompare\u003e` for the defaulted `operator\u003c=\u003e` return value, i.e.\n`std::strong_ordering`.\n\nThis patch doesn't change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319377\n", "files": ["gfx/layers/apz/src/AsyncPanZoomController.cpp", "layout/generic/ScrollGeneration.cpp", "layout/generic/ScrollGeneration.h"], "git_node": "fe383e1f43f14aeab180fce2c270fb4ef368eac1", "git_parents": ["db551c4afc279c68eba83ac624c47fc6be08f85a"], "node": "5c47c7d96e5a25acc525aa5287128148e869543f", "parents": ["f34170e2ab3b0cfffd32714b5ff36df05d4a5988"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064271 Part 4 - Stop generating operator!= in cbindgen for style system types. r=layout-reviewers,firefox-style-system-reviewers,boris\n\nThis patch drops ~650 `operator!=` definitions in the generated\n`ServoStyleConsts.h`, and does not change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319378\n", "files": ["servo/ports/geckolib/cbindgen.toml"], "git_node": "fd62c1a9f4507dd71a44a31a6f87da83a43e2e91", "git_parents": ["fe383e1f43f14aeab180fce2c270fb4ef368eac1"], "node": "3726b2ba9601b95eb6ce4f5dec41a677ab2b2587", "parents": ["5c47c7d96e5a25acc525aa5287128148e869543f"], "tags": []}, {"author": "Jeff Boek \u003cj@jboek.com\u003e", "branch": "default", "desc": "Bug 2064238 - Adds support for a new wallpaper section r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319293\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/wallpaper/WallpaperSettings.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/wallpapers/Wallpaper.kt", "mobile/android/fenix/app/src/main/res/values/static_strings.xml"], "git_node": "56cfd3c9b81d5132d59ae234ec5c1fce4ee3418f", "git_parents": ["fd62c1a9f4507dd71a44a31a6f87da83a43e2e91"], "node": "63824bb402a04b76fa510b365b93d8b5849e8bca", "parents": ["3726b2ba9601b95eb6ce4f5dec41a677ab2b2587"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064156 - Consolidate referral entry points to one metric r=akulyk,fterdal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319203\n", "files": ["browser/base/content/aboutDialog.js", "browser/base/content/browser-sets.js", "browser/base/content/browser-sync.js", "browser/base/content/utilityOverlay.js", "browser/components/preferences/config/account-sync.mjs", "browser/components/referrals/Referrals.sys.mjs", "browser/components/referrals/metrics.yaml", "browser/components/referrals/tests/browser/browser_referralsAccountMenu.js", "browser/components/referrals/tests/browser/browser_referralsAppMenu.js"], "git_node": "f1e042148533dbd1def226a5cf367150bb8a0766", "git_parents": ["56cfd3c9b81d5132d59ae234ec5c1fce4ee3418f"], "node": "e5693bc6b5f47df1b9db8e922f8a55dd552768b0", "parents": ["63824bb402a04b76fa510b365b93d8b5849e8bca"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057975 - reset security info when retrying auth r=kershaw,necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319306\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/unit/test_proxy_auth_securityInfo.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "bd45848060b74fa148e6362b045b46decba16b1b", "git_parents": ["f1e042148533dbd1def226a5cf367150bb8a0766"], "node": "5aee7c03cf84d270a63967c74802b9f7766bc866", "parents": ["e5693bc6b5f47df1b9db8e922f8a55dd552768b0"], "tags": []}, {"author": "Vanessa Prema \u003cvprema@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058632 - feat(pbw): add Relay promo to private browsing new tab r=omc-reviewers,credential-management-reviewers,fluent-reviewers,mtigley,flod,aminomancer,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314812\n", "files": ["browser/app/profile/firefox.js", "browser/components/asrouter/content-src/schemas/MessagingExperiment.schema.json", "browser/components/asrouter/content-src/templates/PBNewtab/NewtabPromoMessage.schema.json", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs", "browser/components/privatebrowsing/content/assets/relay-promo.svg", "browser/locales/en-US/browser/aboutPrivateBrowsing.ftl", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "a0ff51602a21b7fc7f267d73f9757ba2b786f14f", "git_parents": ["bd45848060b74fa148e6362b045b46decba16b1b"], "node": "ebf8db295597