649572c", "bda2a76f166a0a2ea9ddd583edb71743b61f08d7", "a78c19fc079139f972d1f702bd0e84f4da5f0ff6", "c156d165a5c37d33fd5773b47ec51954700745fe", "f11531fae578466ad75e432d2cb5af3d4323e6a9", "8e0541ad69e1014994c4af2dbb853419c4ef052b", "f8dac7e03668267f81717277e7a6297e91b34cb2", "07f1c6dd6b7b489bf08b89bafb0ffa5eadfa89b0", "618b568868878a6c6ebe9524e7906adf70990c1a", "1fc4d7d7e8a337deeb51477dd569a2c9ef0f001a", "ddcf0313ee3be07a68e999a516649bab581d7398", "76a25d2aa71512184f21cf42cb722aff0c68258e", "243bcf3eacf35c6862460359315579f081d05249", "180c49b8190a1cfcaff0c264d3caf41fece064fb", "4e169894cd98555e453ee87efcffdc472ca286fa", "f90cfe4c48878eea15dfcf65ce0920dd02fb5bb1", "453b62c065a2a34f07bac6d094d6fb47625b5826", "9695df7f043bd6ba44b8ee9102374898a5a22af8", "9885aaec6c273a5ccfc6fe1cb6d75a6f90d067b7", "6e5f2a2d89870ee9bb50b722977ae0f91da0fc58", "f52049b5e77c940770a0de2f5e68853d6d086c66", "f230660e3d38e350a10673b2e79826ef6f0e974e", "999b6f7f98225d7fe8ea085b6b1edd88a970d30d", "39532fe5a7a63cf58953e0ce2e2e264c94313b12"], "user": "ctuns@mozilla.com"}, "45175": {"changesets": [{"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2061357 - Add tab selector dialog to when clicking the Smart Form Fill autocomplete row edit button r=mlucks,fluent-reviewers,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317241\n", "files": ["browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.css", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.stories.mjs", "browser/components/aiwindow/ui/content/smartformfill-tab-select.css", "browser/components/aiwindow/ui/content/smartformfill-tab-select.html", "browser/components/aiwindow/ui/content/smartformfill-tab-select.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/SmartFormFillAutocomplete.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillConstants.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_tab_selector.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "0b2d329d6686460525c3149ba2619a981d8f9f62", "git_parents": ["39532fe5a7a63cf58953e0ce2e2e264c94313b12"], "node": "a52d63d58820def6f579cf1e8f5cde63a5d21710", "parents": ["3a948d4f4a4cede74d7ebc0776ce4a70d5636e4e"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065480 - Quota manager: perform integrity check on storage.sqlite, and recreate it if corrupted. r=dom-storage-reviewers,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321374\n", "files": ["dom/indexedDB/ActorsParent.cpp", "dom/quota/ActorsParent.cpp", "dom/quota/QuotaCommon.cpp", "dom/quota/QuotaCommon.h", "dom/quota/test/xpcshell/test_corruptStorageSqlite.js", "dom/quota/test/xpcshell/xpcshell.toml"], "git_node": "83809fafd06d83187a5a9d3ea0c5af8f6bde53cd", "git_parents": ["0b2d329d6686460525c3149ba2619a981d8f9f62"], "node": "b9af82a8ad4a48a0da74c0795c58583e1c3cb522", "parents": ["a52d63d58820def6f579cf1e8f5cde63a5d21710"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062392 - Add newtab.dwell_time metric to the newtab ping. r=thecount\n\nMeasures how long a user was actually using a new tab page, as opposed to how long it sat open, and sends that number in the newtab ping when the tab closes.\n\nIt works by listening for the same \"the user is doing something\" signal Firefox already uses for active-ticks, and running a stopwatch that only ticks while this particular newtab is the selected tab of the frontmost window.\n\nThat signal is only sampled every five seconds, so every start and stop is rounded to the nearest sample, which means a tab you open and immediately abandon can still record about five seconds, and the number is fuzzy by up to one interval in either direction at each transition.\n\nOn top of that, two situations lose the time entirely rather than just blurring it. For one, a newtab that's still open when Firefox shuts down reports nothing at all. And second, dragging a tab into another window stops its stopwatch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320307\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/browser/browser_newtab_ping.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "f6c5e2a6584a17e9f02c36966966501e9989f85b", "git_parents": ["83809fafd06d83187a5a9d3ea0c5af8f6bde53cd"], "node": "2700d8da081f37ef5d252fd5f966d4a06415c87f", "parents": ["b9af82a8ad4a48a0da74c0795c58583e1c3cb522"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2062877 - Snap border radii that drive a corner segment to whole device pixels r=gfx-reviewers,nical\n\nA rounded border corner is rasterized into a cached texture sized to the whole\ndevice pixels of its corner box, then stretched onto that box. When the box has\na fractional device size the composite resamples the cached arc, so a hairline\ncurve loses contrast against the straight sides, which are grid snapped and\nfully opaque. The curve then reads as thinner than the sides, and a radius whose\nfractional part is below a half is drawn a whole pixel too large because the\ntask size rounds while the rasterized geometry rounded up.\n\nThe corner box is max(radius, width), so snap a radius that exceeds its border\nwidth to a whole device pixel, matching what is already done for the widths.\nThat makes the corner composite exact, which in turn lets the rasterized arc use\nthe requested radius and thickness rather than rounding both up. A hairline side\nkeeps a texel of its own in the corner task so it cannot drop out of the arc.\n\nMeasured against an ideal supersampled arc, a fractional-radius corner goes from\n0.027 RMSE and 0.23 peak error to 0.010 and 0.09, matching what a whole-pixel\nradius already rendered, and the mean peak coverage along the curve rises from\n0.66 to 0.75.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319658\n", "files": ["gfx/layers/apz/test/reftest/reftest.list", "gfx/wr/webrender/src/border.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/wrench/reftests/border/border-corner-fractional-radius-ref.yaml", "gfx/wr/wrench/reftests/border/border-corner-fractional-radius.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/border-shape.png", "gfx/wr/wrench/reftests/border/reftest.list", "layout/reftests/bugs/reftest.list"], "git_node": "1d6dee808228bd101f4de898359fc772b7e26a0f", "git_parents": ["f6c5e2a6584a17e9f02c36966966501e9989f85b"], "node": "ff32b9f5e35dc2259e673536d9d2e372cc782e71", "parents": ["2700d8da081f37ef5d252fd5f966d4a06415c87f"], "tags": []}, {"author": "Ruhollah Majdoddin \u003cr.majdodin@gmail.com\u003e", "branch": "default", "desc": "Bug 1695881 - Recompute scrollbar marks after find highlighting completes. r=NeilDeakin\n\nWhen \"Highlight All\" is toggled, the findbar sends\nFinder:HighlightAllChange before Finder:Highlight. On toggle-on the\nscroll marks update therefore runs from onHighlightAllChange while the\nfind selection is still empty, and the toggle-off pass has already\nremoved the marks and their listener, so it writes nothing. The\nhighlight pass that follows repopulates the selection, but nothing\nrecomputes the marks afterwards: the scrollbar stays empty until the\nnext search.\n\nRecompute the marks in Finder.highlight once highlighter.highlight()\nhas resolved and highlighting is on. Skip the recompute if the find\niterator is running again at that point: highlighter.highlight() can\nresolve without having finished its own iteration (isAlreadyRunning\nshort-circuit, concurrent stop or reset), and then the newer operation\nupdates the marks on its own path.\n\nFinder.highlight is not used by regular finds; it is reached from the\nfindbar's Highlight All checkbox, the GenAI page assist, and tests.\nThe message and its reply are unchanged. Comment 2 suggested making\nFinderParent.highlight send Finder:UpdateHighlightAndMatchCount\ninstead, which regresses browser_Finder.js: FinderHighlighter.update()\nnever reports found, so that reply loses the found flag that\nhighlight() preserves.\n\nThe new test toggles Highlight All off and back on without a new\nsearch and waits for find-scrollmarks-changed after each toggle;\nwithout the fix, the toggle-on wait times out.\n\nThis work was done with AI assistance; I have reviewed and can explain\nevery line.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317587\n", "files": ["toolkit/content/tests/browser/browser_findbar_marks.js", "toolkit/modules/Finder.sys.mjs"], "git_node": "76b3a7af9442bad8aa2c5df876ca50f6ab5eba7c", "git_parents": ["1d6dee808228bd101f4de898359fc772b7e26a0f"], "node": "53351a761858aad0b47fb352aeca5c6954da78c5", "parents": ["ff32b9f5e35dc2259e673536d9d2e372cc782e71"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061357 - Add tab selector dialog to when clicking the Smart Form Fill autocomplete row edit button r=mlucks,fluent-reviewers,flod\" for causing failures at browser_smartwindow_smartformfill_telemetry.js.\n\nThis reverts commit 0b2d329d6686460525c3149ba2619a981d8f9f62.\n", "files": ["browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.css", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.stories.mjs", "browser/components/aiwindow/ui/content/smartformfill-tab-select.css", "browser/components/aiwindow/ui/content/smartformfill-tab-select.html", "browser/components/aiwindow/ui/content/smartformfill-tab-select.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/SmartFormFillAutocomplete.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillConstants.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_tab_selector.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "6ee0c6dd26b7de4ca9f97cf1336c3d2408b3d088", "git_parents": ["76b3a7af9442bad8aa2c5df876ca50f6ab5eba7c"], "node": "ac387426ad571bfc29b20796cbbb0504ea4215d5", "parents": ["53351a761858aad0b47fb352aeca5c6954da78c5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066644 - Update DAGP to version 3.19.1. r=android-reviewers,adhingra\n\nThis picks up 3.19.0, the first release built and tested against Gradle 9.7.1, which is the version our\nwrapper uses.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321436\n", "files": ["gradle/libs.versions.toml"], "git_node": "fc6fcac9ee2079d91b26c7f2b0892f9a66307a8f", "git_parents": ["6ee0c6dd26b7de4ca9f97cf1336c3d2408b3d088"], "node": "0bc2720e516721c1f94b299dc5c0aa4189e7624f", "parents": ["ac387426ad571bfc29b20796cbbb0504ea4215d5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066644 - Update jsoup to version 1.23.2. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321437\n", "files": ["gradle/libs.versions.toml"], "git_node": "6b2a2c8271b83a46eaa0de4cc6774c7a290f79d3", "git_parents": ["fc6fcac9ee2079d91b26c7f2b0892f9a66307a8f"], "node": "a868d9829b258084475f831f15fea46f3ebae036", "parents": ["0bc2720e516721c1f94b299dc5c0aa4189e7624f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066644 - Update Google Play Services FIDO to version 21.3.1. r=android-reviewers,adhingra\n\nThe AAR raises minSdkVersion from 23 to 24, well below our floor of 26.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321438\n", "files": ["gradle/libs.versions.toml"], "git_node": "e2dea085b2ecf5f62bb6bdcafc53b28e820670c5", "git_parents": ["6b2a2c8271b83a46eaa0de4cc6774c7a290f79d3"], "node": "868698948072c7a351c4a4400b7f0e10e9ac3715", "parents": ["a868d9829b258084475f831f15fea46f3ebae036"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2061357 - Add tab selector dialog to when clicking the Smart Form Fill autocomplete row edit button r=mlucks,fluent-reviewers,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317241\n", "files": ["browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.css", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.stories.mjs", "browser/components/aiwindow/ui/content/smartformfill-tab-select.css", "browser/components/aiwindow/ui/content/smartformfill-tab-select.html", "browser/components/aiwindow/ui/content/smartformfill-tab-select.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/SmartFormFillAutocomplete.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillConstants.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_tab_selector.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "bfbbe846d6dbb54730cc0426d1e4cec5b1572f4c", "git_parents": ["e2dea085b2ecf5f62bb6bdcafc53b28e820670c5"], "node": "a99e5a4b46123205985f9bff8d378f8c923e0fc8", "parents": ["868698948072c7a351c4a4400b7f0e10e9ac3715"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066535 - Adapt the wasi build to the clang 22 libc++. r=firefox-build-system-reviewers,ahochheiden\n\nlibc++ 22 applies [[nodiscard]] to std::atomic::load (llvm/llvm-project#173962); the acquire-only load in\nRefCounted.h discards its result on purpose.\n\nIt also drops _LIBCPP_EXPORTED_FROM_ABI from the forward declaration of error_condition while keeping it\non the definition (llvm/llvm-project#132602), so the two disagree under the hidden visibility\nconfig/gcc_hidden.h pushes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321338\n", "files": ["build/moz.configure/toolchain.configure", "mfbt/RefCounted.h"], "git_node": "b1cc897f6ae501da435edf3764016e24cf8114a1", "git_parents": ["bfbbe846d6dbb54730cc0426d1e4cec5b1572f4c"], "node": "5265c50572b495e281e2c04ec984b32fad5d0fe8", "parents": ["a99e5a4b46123205985f9bff8d378f8c923e0fc8"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066535 - Move the wasi sysroot toolchain alias to clang 22. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321339\n", "files": ["taskcluster/kinds/toolchain/sysroot.yml"], "git_node": "316220d121facb3b8f1e1d3c3c3148d2d22f8d68", "git_parents": ["b1cc897f6ae501da435edf3764016e24cf8114a1"], "node": "d33e898b0fbcf69c8a2157609d930b2bc1f31b2f", "parents": ["5265c50572b495e281e2c04ec984b32fad5d0fe8"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064289: Stop using ManualDealloc for PDocAccessible. r=eeejay,nika\n\nThis involved making DocAccessibleChild be reference counted.\nDocAccessibleParent was already reference counted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319979\n", "files": ["accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h", "accessible/ipc/DocAccessibleChild.h", "accessible/ipc/PDocAccessible.ipdl", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalChild.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h"], "git_node": "c9c17696d7733500942846e5616ed0c9f70512ed", "git_parents": ["316220d121facb3b8f1e1d3c3c3148d2d22f8d68"], "node": "386fcc3433bf48ac280163cc558424f82ef1959d", "parents": ["d33e898b0fbcf69c8a2157609d930b2bc1f31b2f"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061357 - Add tab selector dialog to when clicking the Smart Form Fill autocomplete row edit button r=mlucks,fluent-reviewers,flod\" for causing bc failures in browser_smartformfill_tab_selector.js\n\nThis reverts commit bfbbe846d6dbb54730cc0426d1e4cec5b1572f4c.\n", "files": ["browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.css", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-sele