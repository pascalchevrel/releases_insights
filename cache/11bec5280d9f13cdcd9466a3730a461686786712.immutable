f/SignatureType.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsContentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationGleanTest.kt"], "git_node": "b863c5f2878bc9c764484c6377d5b69e2629e229", "git_parents": ["5a001fce88edd90d3c832d8b370edd7459fc4bad"], "node": "702612b6f48576c7715e1d4ea80012de166dc209", "parents": ["63e3369f5062a678b58f07cb57f4232bf96dccfb"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066858 - Make the pref 'media.audio.reuse-stream-on-seek' only true by default on Nightly. r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321578\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "9f6164eefcf22744f208152952f2718e3f48d1cf", "git_parents": ["b863c5f2878bc9c764484c6377d5b69e2629e229"], "node": "60ca476937d33e12d2e08fc71646bfb2cf0d7bed", "parents": ["702612b6f48576c7715e1d4ea80012de166dc209"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050533 - Use correct HCM colors for primary button r=desktop-theme-reviewers,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318514\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/content/widgets/moz-visual-picker/moz-visual-picker-item.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/button.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json"], "git_node": "f0ca9418a90d7eeb2afe369e85ba46cbee1e8de2", "git_parents": ["9f6164eefcf22744f208152952f2718e3f48d1cf"], "node": "9aa07226c38dc788a2084e5543694f2485f9cbab", "parents": ["60ca476937d33e12d2e08fc71646bfb2cf0d7bed"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046615 - Ship remote media platform encoders to release. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317673\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "8ca4269a6226446c12e06e5455faff4f3dd3ae10", "git_parents": ["f0ca9418a90d7eeb2afe369e85ba46cbee1e8de2"], "node": "c81b760a891b12c0c8c07d08a3a90f26530ab4f8", "parents": ["9aa07226c38dc788a2084e5543694f2485f9cbab"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 1968068 - Add an associatedWindow option to Cu.Sandbox. r=smaug\n\nA sandbox created with a null principal and no sandboxPrototype cannot be\nmapped to a DOM window, so the interrupt callback bails out and the scripts\nrunning in it are never reported as slow ones.\n\nAdd an associatedWindow option: the window is held weakly on the SandboxPrivate\nand is only read back by the interrupt callback, when the existing lookups\nfailed. It is never exposed to the code running in the sandbox, hence the\nsandbox keeps its principal and still has no access to the window. It is\nignored for system-principal scripts, which must stay out of the user's reach.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321526\n", "files": ["js/xpconnect/idl/xpccomponents.idl", "js/xpconnect/src/Sandbox.cpp", "js/xpconnect/src/SandboxPrivate.h", "js/xpconnect/src/XPCJSContext.cpp", "js/xpconnect/src/XPCJSRuntime.cpp", "js/xpconnect/src/xpcprivate.h", "js/xpconnect/src/xpcpublic.h", "js/xpconnect/tests/unit/test_sandbox_associated_window.js", "js/xpconnect/tests/unit/xpcshell.toml"], "git_node": "8c49b3bc1e5be8a513908467b915e91040ffb892", "git_parents": ["8ca4269a6226446c12e06e5455faff4f3dd3ae10"], "node": "552ebd7af9d526325170451117517dfabf8a7337", "parents": ["c81b760a891b12c0c8c07d08a3a90f26530ab4f8"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 1968068 - Report slow scripts in the PDF.js sandbox. r=smaug\n\nPass the viewer window as the associatedWindow of the scripting sandbox, so a\nPDF looping forever gets the slow-script notification instead of freezing the\nviewer without giving the user any way to stop it.\n\nThe scripts coming from a PDF are evaluated on behalf of the pdf.scripting.mjs\nbundle, so classify the hangs they trigger as content hangs and not as browser\nones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321527\n", "files": ["browser/modules/ProcessHangMonitor.sys.mjs", "toolkit/components/pdfjs/content/PdfSandbox.sys.mjs", "toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_slow_script.js", "toolkit/components/pdfjs/test/file_pdfjs_slow_script.html", "toolkit/components/pdfjs/test/file_pdfjs_slow_script.pdf"], "git_node": "e7f0d291755ef185f0077d0aa9923b3efdba5270", "git_parents": ["8c49b3bc1e5be8a513908467b915e91040ffb892"], "node": "11a4b71663f8b348960192446ec72ede38aebfc0", "parents": ["552ebd7af9d526325170451117517dfabf8a7337"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066196 - Hide share with os button in sharing panel for now. r=jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321031\n", "files": ["browser/components/sharing/SharePageAction.sys.mjs", "browser/components/sharing/tests/browser/browser_testSharePanelButtonVisibility.js", "browser/components/sharing/tests/browser/browser_testSharePanelTelemetry.js"], "git_node": "43a20f8c5eb9d03e664dea177b1aa45545129d8c", "git_parents": ["e7f0d291755ef185f0077d0aa9923b3efdba5270"], "node": "74b1714b289cdc88fccd78b50b6cee3fad9b0d53", "parents": ["11a4b71663f8b348960192446ec72ede38aebfc0"], "tags": []}, {"author": "Tzu-An Liu \u003ctliu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052359 - Stop rewriting the whole conversation on every streamed chunk. r=ai-security-reviewers,bjohns,echa\n\nhandleChunk persisted per chunk, and updateConversation re-serializes and\nrewrites every message plus its tool results and stats the database file. At\nroughly seventy chunks a second that is dozens of full-conversation writes per\nsecond, costed by conversation size rather than by the text that arrived.\n\nA chunk can only dirty the streaming message's content, memoriesApplied and\nwebSearchQueries, which is what MESSAGE_INSERT already updates on conflict.\npersistStreamingMessage writes in full on the first chunk for a message, so\nthe narrow write's foreign keys are satisfied, then coalesces later chunks\nonto a one second DeferredTask that rewrites only that row. No schema change.\n\nendStreamingWrites retires the pending write; receiveResponse disarms it\nbefore its own full write and flushes when the stream throws, and the delete\nand connection close paths flush too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320523\n", "files": ["browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/modules/ChatStore.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_ChatStoreStreaming.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml"], "git_node": "68b5e7a13a97ba342bfc7bfdf23c92717591fdc7", "git_parents": ["43a20f8c5eb9d03e664dea177b1aa45545129d8c"], "node": "5acc52a7126d49dc2eb02b32eb629856b6cb9d5a", "parents": ["74b1714b289cdc88fccd78b50b6cee3fad9b0d53"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 0133e9e90fca2c40750a9e4579394