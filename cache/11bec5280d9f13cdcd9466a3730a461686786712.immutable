aunchOnLogin that calls the correct OS version.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313482\n", "files": ["browser/components/shell/nsIMacShellService.idl", "browser/components/shell/nsMacShellService.mm", "toolkit/modules/WindowsLaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/LaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/MacOSLaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/UnsupportedLaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/WindowsLaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/moz.build", "toolkit/modules/moz.build", "tools/@types/generated/lib.gecko.darwin.d.ts"], "git_node": "aa211bf945ad0aa32f3408586c33dd0f704733bd", "git_parents": ["817f7c8e6c1afbb519f4c8fab4f952ed114b8565"], "node": "66ab5a32d5c176bffc0ffef17d12f35e61524314", "parents": ["da27f4d57d7d85e1cd119bd261be8c9a6c6466c2"], "tags": []}, {"author": "iain holmes \u003ciholmes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053447: Part 2 - Port the existing LaunchOnLogin code.r=hsohaney\n\nPort the WindowsDefaultLaunchOnLogin to use the new generic LaunchOnLogin interface\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313483\n", "files": ["browser/app/profile/firefox.js", "browser/components/BrowserComponents.manifest", "browser/components/defaultlaunchonlogin/DefaultLaunchOnLogin.sys.mjs", "browser/components/defaultlaunchonlogin/moz.build", "browser/components/defaultlaunchonlogin/tests/test_DefaultLaunchOnLogin.js", "browser/components/defaultlaunchonlogin/tests/xpcshell.toml", "browser/components/defaultwindowslaunchonlogin/DefaultWindowsLaunchOnLogin.sys.mjs", "browser/components/defaultwindowslaunchonlogin/moz.build", "browser/components/defaultwindowslaunchonlogin/tests/test_DefaultWindowsLaunchOnLogin.js", "browser/components/defaultwindowslaunchonlogin/tests/xpcshell.toml", "browser/components/moz.build"], "git_node": "e0da50d116b24ddc269d8c49abb7fdd8a1ac2dd5", "git_parents": ["aa211bf945ad0aa