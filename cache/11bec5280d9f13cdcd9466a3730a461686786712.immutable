fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorker.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "b187adb78c33a37dce1dd2c37ece705eac909fdb", "git_parents": ["d4947cf74c53922f6a8ebbc83aef20015104b533"], "node": "322c7d5adcf621134df9108ddee5804ff98b5ed9", "parents": ["d4bb39e4295c5891600ebb75966fadec7cfe8158"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1968904 - Update HostLoadImportedModule impl in the js shell. r=jonco\n\nMerge static imports and dynamic imports in HostLoadImportedModule in the js\nshell.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320966\n", "files": ["js/src/shell/ModuleLoader.cpp", "js/src/shell/ModuleLoader.h", "js/src/vm/Modules.cpp"], "git_node": "2498d27670c29ac0c60831e526da05e210b31ce0", "git_parents": ["b187adb78c33a37dce1dd2c37ece705eac909fdb"], "node": "ad2868452ae6f90f6248bff692966341d9e6638b", "parents": ["322c7d5adcf621134df9108ddee5804ff98b5ed9"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1968904 - Add jit-test to verify dynamic import is evaluated async. r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320967\n", "files": ["js/src/jit-test/modules/dynamic-import-side-effect.js", "js/src/jit-test/tests/modules/dynamic-import-async.js"], "git_node": "58519a665700015847240b09cac5a6d2b42f812b", "git_parents": ["2498d27670c29ac0c60831e526da05e210b31ce0"], "node": "d4e0bf8dd590e870ae57cb6a54895688ffc8a00c", "parents": ["ad2868452ae6f90f6248bff692966341d9e6638b"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061674 - Remove the Legacy Telemetry mirror of contentblocking.cookie_behavior r=emz,janerik\n\nOnly the Legacy Telemetry mirror is removed. The Glean metric\ncontentblocking.cookie_behavior is left in place, so what Firefox collects is\nunchanged. StartupTelemetry.contentBlocking() already records exclusively\nthrough Glean, so no instrumentation changes are needed.\n\nBoth sides of the mirror have to go in the same commit: test_mirrors.py asserts\nevery telemetry_mirror resolves to an existing probe, and also that every\nhistogram in Histograms.json has a mirroring metric, so removing either side\nalone fails.\n\nNo test asserted on the legacy histogram, so unlike the other probes in this\nseries there is nothing to convert to Glean here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317244\n", "files": ["toolkit/components/antitracking/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "8e4dfa6f978b962b947cfc7dc8012d0ac1280c22", "git_parents": ["58519a665700015847240b09cac5a6d2b42f812b"], "node": "434edf076895d4e428f198239fd87ab9a2c43c0c", "parents": ["d4e0bf8dd590e870ae57cb6a54895688ffc8a00c"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062676 - Remove the Legacy Telemetry mirrors of the security.ui.protections VPN events r=emz,janerik\n\nOnly the Legacy Telemetry mirrors are removed. The Glean events are left in\nplace, so what Firefox collects is unchanged.\n\nBoth sides of each mirror have to go in the same commit. test_mirrors.py asserts\nthat every telemetry_mirror resolves to an existing probe, and separately that\nevery event probe has a mirroring metric, so removing either side alone fails.\n\nBoth probes survive with a reduced object list: security.ui.protections#show\nkeeps protection_report, and #click keeps vpn_app_link_android and\nvpn_app_link_ios, which still mirror. The sentence about the VPN banner is\ndropped from the #show description, since it only described vpn_banner.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317860\n", "files": ["browser/components/protections/metrics.yaml", "toolkit/components/telemetry/Events.yaml"], "git_node": "b8ecaa068299c0de6d3101e45d3c2e349306b6c6", "git_parents": ["8e4dfa6f978b962b947cfc7dc8012d0ac1280c22"], "node": "daa560938add8ac8cf6440061a2ce86a984c38be", "parents": ["434edf076895d4e428f198239fd87ab9a2c43c0c"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061377 - Remove the Legacy Telemetry mirrors of storage_access_remaining_days and storage_access_api_ui r=emz,janerik\n\nOnly the Legacy Telemetry mirrors are removed. The Glean metrics\ncontentblocking.storage_access_remaining_days and dom.storage_access_api_ui are\nleft in place, so what Firefox collects is unchanged.\nContentBlockingTelemetryService.cpp and dom/base/Document.cpp already record\nexclusively through Glean, so no instrumentation changes are needed.\n\nBoth sides of each mirror have to go in the same commit: test_mirrors.py asserts\nevery telemetry_mirror resolves to an existing probe, and also that every\nhistogram in Histograms.json has a mirroring metric, so removing either side\nalone fails.\n\nstorage_access_granted_count, which this bug originally also covered, is\ndeliberately left alone and moved to bug 2061972. Deployed Redash queries still\nread its Legacy Telemetry histogram directly out of the main ping, so removing\nthat mirror would break them.\n\nThat split has consequences for browser_contentBlockingTelemetry.js, which\nasserts on both probes. Only the storage_access_remaining_days assertions are\nconverted here. The metric is a linear custom distribution over 0..60 with a\nbucket per day, so the expected day count is also its bucket index and the\nassertion translates directly. TelemetryTestUtils was used only by that\nassertion and its import is removed.\n\nThe rest of the file stays on Legacy Telemetry on purpose. The\ngetSnapshotForHistograms call in clearTelemetry, the toolkit.telemetry.ipcBatchTimeout\npref and the aProbeInParent parameter of testTelemetry all exist to serve\nSTORAGE_ACCESS_GRANTED_COUNT and only become dead once bug 2061972 lands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317262\n", "files": ["dom/metrics.yaml", "toolkit/components/antitracking/metrics.yaml", "toolkit/components/antitracking/test/browser/browser_contentBlockingTelemetry.js", "toolkit/components/telemetry/Histograms.json"], "git_node": "262d11b43cea2beeaaddf615343eb2f3e130e878", "git_parents": ["b8ecaa068299c0de6d3101e45d3c2e349306b6c6"], "node": "bcee1dd2959e8639afa1b95e57212e3680ae1565", "parents": ["daa560938add8ac8cf6440061a2ce86a984c38be"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065756 - Move the tab unloading docs under the tabbrowser docs. r=firefox-source-docs-reviewers,sylvestre\n\nTabUnloader.sys.mjs lives in browser/components/tabbrowser/, and about:unloads too is part of Tabbed Browser as per browser/components/tabunloader/moz.build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320648\n", "files": ["browser/components/tabbrowser/docs/fullmode.png", "browser/components/tabbrowser/docs/index.md", "browser/components/tabbrowser/docs/lightmode.png", "browser/components/tabbrowser/docs/tab-unloading.md", "browser/components/tabunloader/content/aboutUnloads.html", "browser/components/tabunloader/docs/fullmode.png", "browser/components/tabunloader/docs/index.md", "browser/components/tabunloader/docs/lightmode.png", "browser/components/tabunloader/moz.build", "browser/docs/index.md", "docs/config.yml"], "git_node": "1877d4bf829b9ae10aec04c6c6c67df756780ff8", "git_parents": ["262d11b43cea2beeaaddf615343eb2f3e130e878"], "node": "7130bfbb595788084f42c97ec95ad81647a23855", "parents": ["bcee1dd2959e8639afa1b95e57212e3680ae1565"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039978 - Remove browser.contentblocking.reject-and-isolate-cookies.preferences.ui.enabled r=manuel,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317991\n", "files": ["browser/app/profile/firefox.js", "browser/components/preferences/privacy.js", "browser/components/preferences/tests/etp/browser_contentblocking.js"], "git_node": "dddd3ebf8c01bcbf38c5ba24812e9df1ea6fff8a", "git_parents": ["1877d4bf829b9ae10aec04c6c6c67df756780ff8"], "node": "494156cdf7872160a27087121e7d2cab1f08c3a1", "parents": ["7130bfbb595788084f42c97ec95ad81647a23855"], "tags": []}], "date": 1787673391, "git_changesets": ["2c64f95f241f4697c3dde082ae60ba626918ad64", "5d53c509fd7c127e83deb29e92d045c706cd5c25", "840db7ebcba1b1b40c61343c02ceb543988c642d", "c15a091628d5198098b17d5be05955c2076709ee", "87662995efd4966d1464f2bf616f67e65e4c0c5c", "8309eb8265b478255a3545c8dd99273bb959cdaf", "f7b57856f171f3f0332adaaf18cfd687d52ee6d3", "6971df0263510189e7908d0b10dd67038d8282a7", "30de3682f9cd93b814888c7de9f7494128ffd639", "da1d35f90d3c73bffd786bd17016dfc758b4afcb", "73ca42436b543fbce81492ad9e17dd789dde2ec8", "44015b94cab9f158c87ccf595e560d6fcb59cf19", "3207706c35381a999f423d9c6dac6df2417bc559", "2025c3119bbfa9674a05e5e27952c9635312cfd2", "5cf6d919f5424219948e54b49e4c33ba80f872c6", "a9cd67bcc8e1adb36d011113c7cd531a855005fa", "9db6608cc89ad010a8b56961b5d7bab2a9d312f2", "22b6ab6ecf9eaf2cb45fef9fcf484df956394fae", "0a09c8a1ed33349b946348bfdae9a6aa856e942a", "03e110c4216eeee990bdc6caa5ff06330d749509", "0d1e719c1900eea432c5c4fd5b945b5b5ff0ffaa", "73a0e34b337e3e9851f3ca5c909f62eee12eeb44", "0e30d68a37012fe62b4c83701177a74caf700992", "81f70b17b9034bbc980b17a448945eec57892828", "ab850c277bfe83fb44011ca323870d64802bbb9a", "83178f7ed836505890f0854410dea7c1444c1262", "83035c18b7159cf7ecd36d17de6105b0589f0f66",