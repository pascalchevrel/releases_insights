er/browser_asrouter_bug1761522.js", "browser/components/asrouter/tests/browser/browser_asrouter_experimentsAPILoader.js", "browser/components/asrouter/tests/browser/browser_asrouter_group_frequency.js", "browser/components/asrouter/tests/browser/browser_asrouter_group_userprefs.js", "browser/components/asrouter/tests/browser/browser_asrouter_infobar.js", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js", "browser/components/asrouter/tests/browser/browser_asrouter_universal_infobar.js", "browser/components/asrouter/tests/browser/browser_trigger_messagesLoaded.js", "browser/components/asrouter/tests/browser/browser_trigger_nimbusUpdate.js", "browser/components/asrouter/tests/unit/templates/ExtensionDoorhanger.test.jsx", "browser/components/asrouter/tests/xpcshell/test_remoteExperiments.js", "toolkit/components/messaging-system/schemas/index.md"], "git_node": "d6932e8bd90c9257926fb8a8853b033abbaea7b7", "git_parents": ["7fb7b68580dad3ba3e6263e380c10821b8e36277"], "node": "c66a8b1162323f89d9bf46d85bd008d3149ddd95", "parents": ["e74d0e9692e7abbf9d6a271898313abc0de8cb2f"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2041980 - Move ASRouter tests off CFR message templates. r=omc-reviewers,andhuang\" for causing lint failure @ browser_asrouter_infobar.js\n\nThis reverts commit d6932e8bd90c9257926fb8a8853b033abbaea7b7.\n", "files": ["browser/components/asrouter/bin/import-rollouts.js", "browser/components/asrouter/content-src/schemas/make-schemas.py", "browser/components/asrouter/content-src/templates/CFR/templates/InfoBar.schema.json", "browser/components/asrouter/content-src/templates/InfoBar/InfoBar.schema.json", "browser/components/asrouter/docs/infobars.md", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/moz.build", "browser/components/asrouter/tests/browser/browser_asrouter_bug1761522.js", "browser/components/asrouter/tests/browser/browser_asrouter_experimentsAPILoader.js", "browser/components/asrouter/tests/browser/browser_asrouter_group_frequency.js", "browser/components/asrouter/tests/browser/browser_asrouter_group_userprefs.js", "browser/components/asrouter/tests/browser/browser_asrouter_infobar.js", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js", "browser/components/asrouter/tests/browser/browser_asrouter_universal_infobar.js", "browser/components/asrouter/tests/browser/browser_trigger_messagesLoaded.js", "browser/components/asrouter/tests/browser/browser_trigger_nimbusUpdate.js", "browser/components/asrouter/tests/unit/templates/ExtensionDoorhanger.test.jsx", "browser/components/asrouter/tests/xpcshell/test_remoteExperiments.js", "toolkit/components/messaging-system/schemas/index.md"], "git_node": "9fe074309fc6aec20a0418fa0ab0fe21691711a6", "git_parents": ["d6932e8bd90c9257926fb8a8853b033abbaea7b7"], "node": "74267d855b7de4ff84a3bfdbafc8a315571880fc", "parents": ["c66a8b1162323f89d9bf46d85bd008d3149ddd95"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062213 - Stop the newtab tests racing a preloaded about:newtab.\" for causing bc failures at escapeWalksBackOut\n\nThis reverts commit f3afdf82dcae9cf01bbff5bb4806b77b3880a925.\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/head.js"], "git_node": "dd4ec057405786ef10481fe490c1ca6b73c24a13", "git_parents": ["9fe074309fc6aec20a0418fa0ab0fe21691711a6"], "node": "2e247a9cab02595f10dbae21e23385d053aa00b5", "parents": ["74267d855b7de4ff84a3bfdbafc8a315571880fc"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1764233. Enable scroll wheel acceleration on mac on nightly builds. r=mstange\n\nValues come from https://bugzilla.mozilla.org/show_bug.cgi?id=1764233#c12 which I also tested and they feel about the same as Chrome.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151485\n", "files": ["dom/events/test/test_bug422132.html", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "6b91c2f68c21b920507fb9ef5e0606dbb0766e7e", "git_parents": ["dd4ec057405786ef10481fe490c1ca6b73c24a13"], "node": "0ca336b5d0cba272f133b8c99fe4ca86e5264cc7", "parents": ["2e247a9cab02595f10dbae21e23385d053aa00b5"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065645 - Don't format newtab-menu-content-tooltip without a $title. r=ini\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320618\n", "files": ["browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/SectionContextMenu/SectionContextMenu.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/SectionContextMenu.test.jsx"], "git_node": "ec8ddf36d503a019c715a3edbf1f349f9f2815dd", "git_parents": ["6b91c2f68c21b920507fb9ef5e0606dbb0766e7e"], "node": "2ee801abaf0b3250dcf5aac645c37ba904371365", "parents": ["0ca336b5d0cba272f133b8c99fe4ca86e5264cc7"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2059620 - Pt 1 - Move the unsnapped prim rect back into the interning key and template r=gfx-reviewers,nical\n\nReverts the move onto PrimitiveInstance from the fractional snapping work, which\nturned out not to be needed, and gets us closer to dropping PrimitiveInstance in\nfavour of template plus draw instance(s).\n\nSafe because the display-list builder normalizes the external scroll offset away\nin whole app units, so the rect does not change when the scroll position does.\nThat has to stay exact: unlike the quarter-device-pixel raster corners beside it,\na uid compare during invalidation is bit-exact.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315510\n", "files": ["gfx/wr/example-compositor/compositor/src/main.rs", "gfx/wr/webrender/src/invalidation/cached_surface.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/prim_store/gradient/mod.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/prim_store/line_dec.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/prim_store/rectangle.rs", "gfx/wr/webrender/src/prim_store/text_run.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/webrender_api/src/key_types.rs"], "git_node": "2d1438376db385d273082f81b9cfd22ba65bc712", "git_parents": ["ec8ddf36d503a019c715a3edbf1f349f9f2815dd"], "node": "760364d2e17a9a54a8fd3a13c655e67b84485910", "parents": ["2ee801abaf0b3250dcf5aac645c37ba904371365"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2059620 - Pt 2 - Only run the app-unit round trip on an axis the scroll offset moves r=gfx-reviewers,nical\n\nThe zero-offset skip was per point, so a y-only scroll offset still rounded x\nonto the app-unit grid: the same unshifted coordinate stored one value in an\nunscrolled frame and another in a scrolled one. That is below the quarter-device-\npixel raster corners, but a uid compare is bit-exact, so with the rect in the key\nevery tile invalidated at every scroll offset.\n\nGecko's coordinates are whole app units, so the round trip was already\nbit-identical for them and nothing changes there. Guarded by offgrid_repaint_1/2.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316372\n", "files": ["gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/wrench/invalidation/invalidation.list", "gfx/wr/wrench/invalidation/offgrid_repaint_1.yaml", "gfx/wr/wrench/invalidation/offgrid_repaint_2.yaml"], "git_node": "d71cf58127ffd4f1a28806dfb113ad0284c220ea", "git_parents": ["2d1438376db385d273082f81b9cfd22ba65bc712"], "node": "58c4a810f422d6510ab6a862168df5a4a1180980", "parents": ["760364d2e17a9a54a8fd3a13c655e67b84485910"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2059620 - Pt 3 - Compute an over-thick border's interior split once r=gfx-reviewers,nical\n\nA rounded fill drawn as an over-thick border - how the non-native theme draws\nscrollbar thumbs, see ThemeDrawing::PaintRoundedRectWithRadius and bug 1694269 -\nis four corner segments with no edges, each clipped to its own quadrant and\nmeeting at the rect's midpoint. The clips spelled that midpoint two ways: min\nplus the leading non-overlapping width for one neighbour, max minus the trailing\none for the other. Equal mathematically, one ULP apart in f32.\n\nEach segment rounds its device bounds on its non-antialiased edges, and the\nshared quadrant edge is non-antialiased for both, so at a half-pixel midpoint the\nULP sends the two roundings opposite ways - 253.49998 to 253, 253.5 to 254 - and\na whole device pixel row drops out of the shape. Evaluate each split once, and\nonly where the widths overlap: elsewhere the two expressions are genuinely\ndifferent boundaries.\n\nThe reftest reference is a PNG because two yamls of the same shape at the same\ndevice position intern to one uid with identical raster corners, so the second\nrender reuses the first one's tile and the comparison passes vacuously.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316373\n", "files": ["gfx/wr/webrender/src/border.rs", "gfx/wr/wrench/reftests/border/border-overlap-split.png", "gfx/wr/wrench/reftests/border/border-overlap-split.yaml", "gfx/wr/wrench/reftests/border/reftest.list"], "git_node": "06dfa2cf965afeb3a74db61c6c72b943c18130cf", "git_parents": ["d71cf58127ffd4f1a28806dfb113ad0284c220ea"], "node": "210ee627e011a224fad5a2351b8942938d50803d", "parents": ["58c4a810f422d6510ab6a862168df5a4a1180980"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2014026 - Include private flag in ShareData r=Roger,markh,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289084\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/prompt/GeckoPromptDelegate.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/prompt/ShareData.kt", "mobile/android/android-components/components/concept/engine/src/test/java/mozilla/components/concept/engine/prompt/ShareDataTest.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/PromptFeatureTest.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/share/DefaultShareDelegateTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarkFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/EditBookmarkFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/Utils.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuNavigationMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/CustomTabBrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/intent/HomeDeepLinkIntentProcessor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sessioncontrol/SessionControlController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/HistoryFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/historymetadata/controller/HistoryMetadataGroupController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/recentlyclosed/RecentlyClosedController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/share/ShareController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/share/ShareFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/controller/TabManagerController.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/ShareSheetLauncherTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/usecases/ShareUseCasesTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/library/historymetadata/controller/HistoryMetadataGroupControllerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/library/recentlyclosed/DefaultRecentlyClosedControllerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/share/ShareControllerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/controller/DefaultTabManagerControllerTest.kt"], "git_node": "ddb9bb409495c9712a6c53f94051d0bb40bb92e1", "git_parents": ["06dfa2cf965afeb3a74db61c6c72b943c18130cf"], "node": "cf3300f6db76279db88ec380ca106a8cd0bc5b98", "parents": ["210ee627e011a224fad5a2351b8942938d50803d"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2014026 - Simplify the tests for ShareTab#toTabData r=Roger,markh,android-reviewers\n\nThe test added was more verbose than they needed to be because of\nwhere the static functions were location, so I took this opportunity\nto clean that up, which also meant cleaning up the other two tests\nas well.\n\nI'm also open to abandoning this patch for this bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289085\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/share/ShareController.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/share/ShareControllerTest.kt"], "git_node": "990335c1d14e4a0aba2dbd52817bd84208788168", "git_parents": ["ddb9bb409495c9712a6c53f94051d0bb40bb92e1"], "node": "4831351a6d521bbafe68a40012669265636c4ec7", "parents": ["cf3300f6db76279db88ec380ca106a8cd0bc5b98"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2064312 - Disable SharedSurface_EGLImage with ANGLE on Android r=gfx-reviewers,nical\n\nWhen ANGLE GL backend is used, WebRender need to use different EGLDisplay. Then RenderEGLImageTextureHost does not work with ANGLE.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320788\n", "files": ["gfx/gl/SharedSurface.cpp", "gfx/layers/CanvasRenderer.cpp"], "git_node": "28d2c0d2f6d2667364302972513616476069e134", "git_parents": ["990335c1d14e4a0aba2dbd52817bd84208788168"], "node": "b6b278203fe91b334d2a5a4b5c77cc93403fda29", "parents": ["4831351a6d521bbafe68a40012669265636c4ec7"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049659 - Don't clip the focus indicator on the sidebar launcher's buttons - r=desktop-theme-reviewers,sfoster\n\nThis fixes a visual bug in the focus state of the bottom buttons on the sidebar.\n\nThe buttons sit flush against the top edge of a container that clips anything painted outside it, so the focus indicator, which paints 4px beyond the button's edge, gets clipped at the top.\n\nExtending that container's clip rect fixes it without moving anything, although because `overflow: clip` is not a scroll container the way `overflow: hidden` is, the list also needs an explicit `min-height: 0` so it can still shrink away and leave just the chevron when the launcher is collapsed\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316914\n", "files": ["browser/components/sidebar/sidebar-main.css", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_sidebar_expand_on_hover.js", "browser/components/sidebar/tests/browser/browser_sidebar_focus_ring.js"], "git_node": "886011a1ee79468aba8a999a9d9dec193af86f37", "git_parents": ["28d2c0d2f6d2667364302972513616476069e134"], "node": "11a00835bdfe10fca02083ebbf61df7b96001344", "parents": ["b6b278203fe91b334d2a5a4b5c77cc93403fda29"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2035363 - open the Downloads settings page in test_download_folder_change. r=gtk-reviewers,emilio\n\nabout:preferences opens on the Accounts and sync page, and the download folder\ncontrol is only in the document once the Downloads page is selected, so the\ntest times out waiting for #chooseFolder. The #downloads hash selects that\npage; Firefox versions without it treat the hash as an unknown category and\nopen their default page, where their own control is.\n\nThe control takes its value from an asynchronous lookup of the download\ndirectory, so the fallback to the older #downloadFolder now happens only after\nwaiting for a value rather than on the first empty read.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319932\n", "files": ["taskcluster/docker/snap-coreXX-build/snap-tests/qa_tests.py"], "git_node": "edd1927484e98b163bcfceb104109e15d5be1626", "git_parents": ["886011a1ee79468aba8a999a9d9dec193af86f37"], "node": "4f1a5aa65be27197dd68c5d16593e4c8c9a79dc8", "parents": ["11a00835bdfe10fca02083ebbf61df7b96001344"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2058664 - Give WaylandMonitor one owner instead of one per callback. r=gtk-reviewers,emilio\n\nWaylandMonitor gives a raw pointer to four Wayland listeners, and three of them\nkeep it alive: each takes a reference that its own callback releases when it\nruns. Finish() destroys the wp_image_description_v1 one of those listeners is\nattached to, which cancels its callback. A cancelled callback never runs, so it\nnever releases its reference, and the monitor is never freed.\n\nNo misbehaviour is needed to hit this. When a display profile changes, the\ncompositor tells us the output's colour setup changed\n(image_description_changed). Firefox answers by starting a fresh screen\nenumeration, which finishes the previous one. Finishing destroys the image\ndescription that monitor is still waiting on, so the reply never arrives and\nthe reference taken to wait for it is never released. Sending the colour change\nbefore the reply reproduces it: the monitor's destructor never runs.\n\nTwo objects are also never destroyed at all: the one\nwp_image_description_v1_get_information() returns, which ImageDescriptionReady()\ndrops, and the wl_callback from wl_display_sync(), which Finish() drops. Each\nleaks once per monitor per screen enumeration. Each also leaves a listener\npointing at the monitor after it is gone, so a malicious or broken compositor\nthat sends an event after done writes through a stale pointer.\n\nGive the monitor a single owner. mWaylandMonitors holds it, and every listener\nthat does work on it takes a scoped reference for as long as it runs, so no\ncallback can outlive what it is using. Finish() destroys every object a listener is\nattached to, so nothing can reach a monitor the getter is about to release.\n\nThat makes the reference Finish() took redundant. It covered the same window -\na callback on the stack when ScreenGetterGtk::Finish() clears mWaylandMonitors\n- by holding the monitor until a compositor round-trip completed. The\nwl_display.sync goes with it, and so does the wl_callback it was leaking.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320580\n", "files": ["widget/gtk/ScreenHelperGTK.cpp"], "git_node": "6370a0ced6df576ab0af74162f81533ada54ff55", "git_parents": ["edd1927484e98b163bcfceb104109e15d5be1626"], "node": "ba6e7c4f10c5f8a6760610ca2f494314e2884ac4", "parents": ["4f1a5aa65be27197dd68c5d16593e4c8c9a79dc8"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066013 - image: Default-initialize nsAVIFDecoder's UniquePtr members for C++23 compatibility. r=tnikkel\n\nIn C++23 mode, libc++ instantiates the UniquePtr member destructors in\nthe inline nullptr initializers when AVIFParser and AVIFDecoderInterface\nare still incomplete.\n\nRemove the redundant inline initializers and let nsAVIFDecoder's\nout-of-line constructor default-initialize the members where both types\nare complete. Default-constructed UniquePtrs are still null.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320833\n", "files": ["image/decoders/nsAVIFDecoder.h"], "git_node": "5f8a8ac2377ff9f45bcbc6552181874f16bd3044", "git_parents": ["6370a0ced6df576ab0af74162f81533ada54ff55"], "node": "137034314a79ee97b524dd39d3017a763df5f419", "parents": ["ba6e7c4f10c5f8a6760610ca2f494314e2884ac4"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2064899 - Support blurred card background for center-large layout r=omc-reviewers,jprickett,fterdal\n\nUpdate center-large content background to a blurred oval (see [[ https://www.figma.com/design/MPYRmdy1F5sLL0cyhkmAAs/NPO-Experiments-2026?node-id=3855-135704&t=sMxOcmvMso5EuNNz-4 | Figma ]])\n\n{F77816330}\n\n{F77816353}\n\n{F77816360}\n\n{F77816366}\n\n{F77816379}\n\n{F77816393}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319925\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_configurable_ui.js", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "64d718c32115595ad11b33547efecfc9b0e1801e", "git_parents": ["5f8a8ac2377ff9f45bcbc6552181874f16bd3044"], "node": "27c83cede1a307f3487b7b68d7efb27a5f3ff759", "parents": ["137034314a79ee97b524dd39d3017a763df5f419"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066139 - Expose the fetched macOS SDK under Chromium's output directory for custom CaR builds. r=aglavic\n\nUpstream changed sdk_inputs guard in BUILD.gn from default_toolchain to\nhost_toolchain. The CaR build's sed workaround stopped applying as a\nresult, and GN rejected the fetched SDK because its path was outside of\nroot_build_dir.\n\nInstead, symlink the in-tree SDK toolchain into out/Default and pass\nthat output directory path as mac_sdk_path. The build continues using\n$MOZ_FETCHES_DIR/MacOSX26.5.sdk as its sysroot.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321004\n", "files": ["taskcluster/scripts/misc/build-custom-car.sh"], "git_node": "9855992a9ccebeb7e59e8b26ed769ed19ef2f2ef", "git_parents": ["64d718c32115595ad11b33547efecfc9b0e1801e"], "node": "e18c0011e648904950736eb82320ecdb58524036", "parents": ["27c83cede1a307f3487b7b68d7efb27a5f3ff759"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061030 - Hide Smart Window shortcuts based on CW newtab settings r=ngrato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320584\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_topsites.js"], "git_node": "bc9fcfd94fffda2b0e57023406e7ed5bcbc22611", "git_parents": ["9855992a9ccebeb7e59e8b26ed769ed19ef2f2ef"], "node": "fb526b72b634c1de03f8887a33995e1863ec6f75", "parents": ["e18c0011e648904950736eb82320ecdb58524036"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063789 - hide split views explicitly, not based on tab visibility r=sclements,kpatenio,tabbrowser-reviewers\n\nThe fix in bug 2038951 marked split views as hidden based on their tabs' visibility. That worked for most cases, but it meant that split views can get accidentally hidden when they are in collapsed tab groups. This patch ensures that split views' hidden state is tied only the the tabs' hidden state.\n\nIt would have been fine to keep the existing approach where the split view wrapper observes for `hidden` attribute changes on its child tabs, but I don't think that very flexible and indirect approach is necessary. All of the tab hiding logic currently flows through Tabbrowser, so Tabbrowser can keep the split views in sync with its tabs at the same time it's already operating on the tabs. I hope that keeping things in Tabbrowser will make it easier to work with tab hiding code because it will be colocated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320306\n", "files": ["browser/components/sessionstore/test/marionette/manifest.toml", "browser/components/sessionstore/test/marionette/test_splitview_hidden.py", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tabsplitview.js", "browser/components/tabbrowser/test/browser/dragdrop/browser_drag_splitview.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview.js"], "git_node": "a2bea15c3bd3408d764e4fd8681d19382a4a4dec", "git_parents": ["bc9fcfd94fffda2b0e57023406e7ed5bcbc22611"], "node": "1fe1ed301ea5ff3e977decfcd9d064823fcdb123", "parents": ["fb526b72b634c1de03f8887a33995e1863ec6f75"], "tags": []}, {"author": "Jeff Boek \u003cj@jboek.com\u003e", "branch": "default", "desc": "Bug 2047013 - Allows rating of summarizations r=android-reviewers,android-l10n-reviewers,matt-tighe,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317863\n", "files": ["mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationAction.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationMiddleware.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationReducer.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationScreen.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationState.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/ui/SummaryContentLoaded.kt", "mobile/android/android-components/components/feature/summarize/src/main/res/values/strings.xml", "mobile/android/android-components/components/feature/summarize/src/test/java/mozilla/components/feature/summarize/SummarizationStoreTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/summarization/SummarizationTelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/summarization/SummarizationTelemetryMiddlewareTest.kt"], "git_node": "9764b4daf3bb1bc5b68148f2a5e3bf8afa515717", "git_parents": ["a2bea15c3bd3408d764e4fd8681d19382a4a4dec"], "node": "a7d9ed4faa6966cb5cfdd5c5f63735037bc7f563", "parents": ["1fe1ed301ea5ff3e977decfcd9d064823fcdb123"], "tags": []}, {"author": "fmasalha \u003cfmasalha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061457 - Added more address capture telemetry inline with other prompts r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316906\n", "files": ["mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/address/AddressSaveDialogFragment.kt", "mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/facts/AddressAutofillDialogFacts.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/address/AddressSaveDialogFragmentTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/MetricController.kt"], "git_node": "7ffb0dbbb0aaf9f7ac5f78f907f70a56e98750a6", "git_parents": ["9764b4daf3bb1bc5b68148f2a5e3bf8afa515717"], "node": "86698c12a6fe76b62ff889ec6f720b4a52949c0e", "parents": ["a7d9ed4faa6966cb5cfdd5c5f63735037bc7f563"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064485 - remove the \u2018Pick up\u2019 prefix from PUWYLO tab group title r=pdahiya\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319594\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js"], "git_node": "005f406beb8fe42104abef8681a76f9a1ecf37fe", "git_parents": ["7ffb0dbbb0aaf9f7ac5f78f907f70a56e98750a6"], "node": "7197d8ef1bc72ca3aac8a1a9c886ae3d33416c8d", "parents": ["86698c12a6fe76b62ff889ec6f720b4a52949c0e"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060764 part 1: Make PDocAccessible managed by PWindowGlobal instead of PBrowser. r=eeejay,nika\n\nA PDocAccessible is tied to a single DOM document only.\nConversely, PBrowser encompasses an entire document tree within a content process; i.e. a tab and all its in-process iframes, or an OOP iframe and all its nested in-process iframes.\nTherefore, it is a better fit for PDocAccessible to be managed by PWindowGlobal, which is also associated one to one with a single DOM document.\n\nThis patch largely moves code and changes calls in order to switch to the new manager.\nHowever, there are a few noteworthy changes:\n\n1. PDocAccessible's constructor no longer takes a BrowsingContext.\n  This isn't necessary now because a PWindowGlobal is associated with a single BrowsingContext, so we can get the BrowsingContext from there.\n2. Use Manager() in DocAccessibleParent::RecvPrinting to get the window context, rather than going via the BrowsingContext.\n  Now that PDocAccessible is managed by PWindowGlobal, we don't need the indirection, and going directly is more precise.\n3. Remove handling for the case that the manager is being destroyed in RecvPDocAccessibleConstructor.\n  Unlike BrowserParent, WindowGlobalParent doesn't have an intermediate \"destroying\" state.\n  it's either alive or it isn't, and if it isn't, it can't receive IPDL messages.\n4. In RecvPDocAccessibleConstructor, change the code which cleans up a previous top level DocAccessibleParent so that it walks the BrowsingContext's WindowContexts rather than using BrowserParent::GetTopLevelDocAccessible.\n  Because DOM keeps the current WindowContext up to date and PDocAccessible is tied to WindowContext, GetTopLevelDocAccessible now only always returns the current top level actor, so it would return null in this case and the previous top level actor wouldn't be found, making the previous code a no-op.\n  This code is now only necessary for Android because Android strictly requires that there only be a single top level DocAccessibleParent at any given time.\n5. Clear any queued cache updates on DocAccessible when a DocAccessibleChild is prematurely destroyed.\n  Previously, this couldn't happen because PBrowser lives for the life of the tab or OOP iframe.\n  In contrast, PWindowGlobal's lifetime ends with its document.\n  That means that if the document is being torn down, the actor will be too, and that sometimes happens a little before the DocAccessible is shut down.\n6. Previously, BrowserBridgeParent::RecvSetEmbedderAccessible compared the manager of the parent doc and the child doc.\n  It can't do that any more because two DocAccessibleParents will now always have different managers.\n7. BrowserParent::GetTopLevelDocAccessible has been significantly rewritten for the new actor relationship, since it no longer has to deal with a single actor managing multiple PDocAccessibles.\n8. BrowserParent::Destroy no longer destroys the top level DocAccessibleParent.\n  BrowserParent doesn't own DocAccessibleParent any more, so we leave this to WindowGlobalParent actor teardown.\n  Also, by the time Browserparent::Destroy is called, there might not even be a current WindowGlobal any more, which means we couldn't get the DocAccessibleParent anyway.\n9. Changed various checks of IsTopLevelInContentProcess to assertions, since this is now inherently true because we get the precise WindowGlobalParent we are interested in and a PWindowGlobal only manages one PDocAccessible.\n10. A PWindowGlobal should only ever have a single PDocAccessible.\n  We enforce that in RecvPDocAccessibleConstructor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318677\n", "files": ["accessible/android/SessionAccessibility.cpp", "accessible/base/FocusManager.cpp", "accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "accessible/ipc/PDocAccessible.ipdl", "accessible/ipc/RemoteAccessible.cpp", "accessible/pdf/PdfStructTreeBuilder.cpp", "accessible/xul/XULComboboxAccessible.cpp", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/PBrowser.ipdl", "dom/ipc/PWindowGlobal.ipdl", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalChild.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/ipc/moz.build"], "git_node": "b172b09dfbe0afabf04f5ae37e90e68e323544c0", "git_parents": ["005f406beb8fe42104abef8681a76f9a1ecf37fe"], "node": "969e80e90d282af18e24c8ad8792366881799496", "parents": ["7197d8ef1bc72ca3aac8a1a9c886ae3d33416c8d"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060764 part 2: Ensure the correct same-process embedder when adding a child doc. r=eeejay,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318678\n", "files": ["accessible/ipc/DocAccessibleParent.cpp"], "git_node": "787cdd108cf004ca62ae6e26605d496fc8c9ab86", "git_parents": ["b172b09dfbe0afabf04f5ae37e90e68e323544c0"], "node": "8343662282f64b68cf8593b06b95c8234c498e1f", "parents": ["969e80e90d282af18e24c8ad8792366881799496"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060764 part 3: Remove parent document argument to PDocAccessible constructor and PBrowserBridge::SetEmbedderAccessible. r=eeejay,nika\n\nWe can now get the parent document using the PWindowGlobal tree instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319427\n", "files": ["accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp", "accessible/generic/OuterDocAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "dom/ipc/BrowserBridgeChild.h", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserBridgeParent.h", "dom/ipc/PBrowserBridge.ipdl", "dom/ipc/PWindowGlobal.ipdl", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalChild.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h"], "git_node": "bd2dcae484eeef7e607f3b7957031a413c8744de", "git_parents": ["787cdd108cf004ca62ae6e26605d496fc8c9ab86"], "node": "66f539db4d05e876d6703c3238975d59b461332b", "parents": ["8343662282f64b68cf8593b06b95c8234c498e1f"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1978133: Ignore construction of a DocAccessibleParent for a discarded BrowsingContext. r=eeejay\n\nSuch a document is about to die; its content process just hasn't caught up yet.\nIt will possibly be replaced before it is fully destroyed.\nThis is particularly important on Android because we must never have more than one active DocAccessible there.\nif we do, they may try to register with the same id and collide.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320007\n", "files": ["dom/ipc/WindowGlobalParent.cpp"], "git_node": "de89896f534d2ec730ce2afbe48b43edd66a0dd0", "git_parents": ["bd2dcae484eeef7e607f3b7957031a413c8744de"], "node": "3f805eac062895b5db9fbe275fdd39b097478af7", "parents": ["66f539db4d05e876d6703c3238975d59b461332b"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["browser/components/asrouter/content-src/templates/CFR/templates/InfoBar.schema.json", "gfx/wr/wrench/reftests/text/bug2055145-ref.yaml", "gfx/wr/wrench/reftests/text/bug2055145.yaml", "js/src/irregexp/imported/property-sequences.cc", "js/src/irregexp/imported/property-sequences.h", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/automotive/AndroidAutomotiveFeatureFlag.kt", "netwerk/test/browser/browser_bug1535877.js", "security/nss/gtests/pk11_gtest/json_reader.cc", "security/nss/gtests/pk11_gtest/json_reader.h", "security/nss/lib/freebl/verified/eurydice_glue.h", "security/nss/lib/freebl/verified/internal/libcrux_core.h", "security/nss/lib/freebl/verified/internal/libcrux_mlkem_portable.h", "security/nss/lib/freebl/verified/internal/libcrux_sha3_internal.h", "security/nss/lib/freebl/verified/libcrux_core.c", "security/nss/lib/freebl/verified/libcrux_core.h", "security/nss/lib/freebl/verified/libcrux_mlkem768.h", "security/nss/lib/freebl/verified/libcrux_mlkem768_portable.c", "security/nss/lib/freebl/verified/libcrux_mlkem7