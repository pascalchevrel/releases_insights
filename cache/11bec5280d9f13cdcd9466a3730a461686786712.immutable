rce.h", "third_party/libwebrtc/media/base/video_adapter.h", "third_party/libwebrtc/media/base/video_broadcaster.h", "third_party/libwebrtc/media/base/video_common.h", "third_party/libwebrtc/media/rtc_media_base_gn/moz.build", "third_party/libwebrtc/modules/rtp_rtcp/source/frame_transformer_factory_unittest.cc", "third_party/libwebrtc/modules/video_coding/timing/default_video_jitter_timing.cc", "third_party/libwebrtc/modules/video_coding/timing/default_video_jitter_timing.h", "third_party/libwebrtc/modules/video_coding/timing/default_video_jitter_timing_gn/moz.build", "third_party/libwebrtc/modules/video_coding/timing/default_video_jitter_timing_unittest.cc", "third_party/libwebrtc/modules/video_coding/timing/frame_delay_variation_kalman_filter.cc", "third_party/libwebrtc/modules/video_coding/timing/frame_delay_variation_kalman_filter.h", "third_party/libwebrtc/modules/video_coding/timing/frame_delay_variation_kalman_filter_gn/moz.build", "third_party/libwebrtc/modules/video_coding/timing/frame_delay_variation_kalman_filter_unittest.cc", "third_party/libwebrtc/modules/video_coding/timing/inter_frame_delay_variation_calculator.cc", "third_party/libwebrtc/modules/video_coding/timing/inter_frame_delay_variation_calculator.h", "third_party/libwebrtc/modules/video_coding/timing/inter_frame_delay_variation_calculator_gn/moz.build", "third_party/libwebrtc/modules/video_coding/timing/inter_frame_delay_variation_calculator_unittest.cc", "third_party/libwebrtc/modules/video_coding/timing/jitter_estimator.cc", "third_party/libwebrtc/modules/video_coding/timing/jitter_estimator.h", "third_party/libwebrtc/modules/video_coding/timing/jitter_estimator_gn/moz.build", "third_party/libwebrtc/modules/video_coding/timing/jitter_estimator_unittest.cc", "third_party/libwebrtc/modules/video_coding/timing/rtt_filter.cc", "third_party/libwebrtc/modules/video_coding/timing/rtt_filter.h", "third_party/libwebrtc/modules/video_coding/timing/rtt_filter_gn/moz.build", "third_party/libwebrtc/modules/video_coding/timing/rtt_filter_unittest.cc", "third_party/libwebrtc/modules/video_coding/timing/timestamp_extrapolator.cc", "third_party/libwebrtc/modules/video_coding/timing/timestamp_extrapolator.h", "third_party/libwebrtc/modules/video_coding/timing/timestamp_extrapolator_gn/moz.build", "third_party/libwebrtc/modules/video_coding/timing/timestamp_extrapolator_unittest.cc", "third_party/libwebrtc/moz-patch-stack/5ecea90550.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/6395da1ed7.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/bf6f744d19.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/p0002.patch", "third_party/libwebrtc/moz-patch-stack/p0003.patch", "third_party/libwebrtc/rtc_base/unique_id_generator_gn/moz.build", "third_party/libwebrtc/sdk/objc/unittests/main.mm"], "git_node": "37c3bb40a9ddb2c3b02202a7e5a77f0299c89b8a", "git_parents": ["a5febabbb94200291df1bca00dc6d06406528a38", "98f1235b79c19a808e3101160efb7810b71a75d7"], "node": "6eae735a6a8e925f654c42d5d9e2ab597ff437be", "parents": ["54cd4c62c282c7e80889aac4365e0d393a716225", "808fcc0ee37e67dcaa23da3de4c0569b3372d35d"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2051956. Treat a CRC error in a critical png chunk as a recoverable error so we keep the rows we already decoded. r=gfx-reviewers,jrmuizel\n\nerror_callback keeps a list of libpng error messages we treat as recoverable. If\nwe hit one of those after a frame has been started, ReadPNGData terminates\nsuccessfully instead of failing, and we keep the rows we already decoded. Bug\n1873422 added that for invalid chunk types. CRC errors were not on the list, so\na wrong CRC threw the whole image away.\n\nlibpng hands us IDAT data as zlib produces it and only verifies the chunk CRC\nwhen it reaches the end of the chunk, which is what the spec recommends for\nstreaming decoders. So by the time the error arrives every row of a single IDAT\nchunk has already been written and we display the whole image. A CRC error\nbefore we have a frame, in IHDR or PLTE, still fails, because there is nothing\nto salvage.\n\nChrome and Safari both keep going here as well. Neither of them uses the data of\nthe chunk with the bad CRC, they stop at that chunk and paint the rows they\nalready had, and they don't fire an error event. Both of them reject a bad CRC\non IHDR or PLTE. A bad CRC on an ancillary chunk still discards just that chunk,\nwhich is what they do too.\n\nThe site in this bug uses a 1x1 transparent png with a wrong IDAT CRC as the src\nof every gallery image until it scrolls into view. The error event makes their\ncomponent replace the img with a fallback icon, and that img is the\nIntersectionObserver target, so the real image url never gets set and the slide\nstays blank.\n\nThe png spec allows either behaviour. It says that a CRC mismatch may be\nregarded as a fatal error, and that on a fatal condition a decoder should\noptionally continue displaying any image data already visible to the user.\n\nThe reftest and the wpt added here both load a png whose only defect is a bad\nIDAT CRC and whose rows all decode before that CRC is checked, so before this\nchange they fail and after it they render the same as the identical file with a\ncorrect CRC.\n\nTwo existing tests needed changes. createImageBitmap rejects with\nInvalidStateError when a decode failed, and images/undecodable.png only failed\nbecause its IDAT chunk has a bad CRC. The zlib stream in it is invalid as well,\nbut libpng treats that as a benign error, so with this change the file decodes\nto a blank image and createImageBitmap stops rejecting. Replace it with a file\nwhose only defect is a zero length IDAT, so the signature and IHDR are still\nvalid and the image still has an intrinsic size, but the zlib datastream its\nIDAT chunks form is empty and there is nothing to decode at all. Chrome rejects\nthe new file too. Safari decodes the old one and the new one, so it fails that\nsubtest either way.\n\ncss/css-flexbox/inline-flex-column-image-load.html came in from a WebKit export\nin bug 2033389 and was marked expected: FAIL when it was imported. The data url\nit loads is a mangled copy of a png that several other tests use, with a bad\nIDAT CRC, so we threw the image away and the inline-flex column had no intrinsic\nsize to size itself to. That was never a flexbox problem. It passes with this\nchange, so remove the expectation, and replace the data url with a correctly\nencoded 100x100 transparent png so the test no longer depends on how a decoder\nhandles a bad CRC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318709\n", "files": ["image/decoders/nsPNGDecoder.cpp", "image/test/reftest/png/green10-badidatcrc.png", "image/test/reftest/png/reftest.list", "testing/web-platform/meta/css/css-flexbox/inline-flex-column-image-load.html.ini", "testing/web-platform/tests/css/css-flexbox/inline-flex-column-image-load.html", "testing/web-platform/tests/html/canvas/element/manual/imagebitmap/createImageBitmap-invalid-args.html", "testing/web-platform/tests/images/undecodable.png", "testing/web-platform/tests/png/errors/idat-crc-error-recovery.html", "testing/web-platform/tests/png/errors/support/bad-idat-crc.png"], "git_node": "9898f7310d65a86c12cd17d9ee0a5d8f8fd1e6f4", "git_parents": ["37c3bb40a9ddb2c3b02202a7e5a77f0299c89b8a"], "node": "b692ab518b627cfccc17fb7452af2b50302714f2", "parents": ["6eae735a6a8e925f654c42d5d9e2ab597ff437be"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063799 - Update android nightly application-services version bump to 71d8b70bf62e6911d9d439a559aab56d8bef38b9 r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318877\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.k