: ["126961cecc9bd9689a502e0e9e56b94f01a2d467"], "tags": []}], "date": 1787326382, "git_changesets": ["b1565fed0a733e5cae8b5160e2759f991d8b9c9b"], "user": "ffxbld@lando.moz.tools"}, "45146": {"changesets": [{"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2033123, Bug 2030831, Bug 2035575 - Extract `libsForTests` native libraries for JVM unit tests r=nalexander,geckoview-reviewers\" for causing Bug 2065509.\n\nThis reverts commit 88a848b4b851e9372c675074cd2305c05c735df3.\n\nRevert \"Bug 2035575 - Include NSS runtime dependencies in megazord extra archive for desktop `libsForTests` r=nalexander,firefox-build-system-reviewers\"\n\nThis reverts commit 2ee56ae7d616bafa9b130c57d3725e11b4a47367.\n\nRevert \"Bug 2035575 - Normalize app-services groupId and gate subproject inclusion on dependency-download context r=nalexander,android-reviewers\"\n\nThis reverts commit cc9172f8ccfbc350bbf37cac3f5bcc460a0ba6f5.\n\nRevert \"Bug 2030831 - Relax `a-s` version ping on try r=nalexander,android-reviewers\"\n\nThis reverts commit dcfb1ab7d8c5f055e7e7bfdf5c69b12427ea3f58.\n\nRevert \"Bug 2035575 - Integrate megazord AAR into fat AAR pipeline alongside geckoview r=nalexander,geckoview-reviewers\"\n\nThis reverts commit 0a9b29deab780fb3d92f46e92133c180ec08ee90.\n\nRevert \"Bug 2035575 - Stage `libmegazord.so` under appservices destdir for `libsForTests` gradle tasks r=nalexander,firefox-build-system-reviewers,geckoview-reviewers,sergesanspaille\"\n\nThis reverts commit cfefd2d06bc5dda15227679232e1f92f25c84433.\n\nRevert \"Bug 2035575 - Package `libmegazord.so` as an extra archive for downstream consumers r=nalexander,firefox-build-system-reviewers\"\n\nThis reverts commit 8d5e2d55eb2de329a7702b95853561083f3f9e75.\n\nRevert \"Bug 2033123 - Improve `./mach uniffi generate` output r=nalexander,firefox-build-system-reviewers\"\n\nThis reverts commit a3a6c0b9eeb18f673b92fdb5a907bd3bdb65ee2a.\n", "files": ["gradle/libs.versions.toml", "mobile/android/android-components/plugins/dependencies/src/main/java/DependenciesPlugin.kt", "mobile/android/android-components/settings.gradle", "mobile/android/fenix/settings.gradle", "mobile/android/focus-android/settings.gradle", "mobile/android/gradle.configure", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt", "mobile/android/installer/package-manifest.in", "python/mozbuild/mozbuild/action/fat_aar.py", "python/mozbuild/mozbuild/action/package_libmegazord_artifacts.py", "taskcluster/kinds/build/macosx.yml", "taskcluster/kinds/toolchain/android.yml", "third_party/application-services/megazords/fenix-dylib/moz.build", "third_party/application-services/megazords/full/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/mach_commands.py", "toolkit/moz.configure", "toolkit/mozapps/installer/package-name.mk", "toolkit/mozapps/installer/packager.mk", "toolkit/mozapps/installer/upload-files.mk"], "git_node": "a5cb276dab2bed92fc3440e204cabcea40141ce0", "git_parents": ["770dfa82b61162d6b5c6f4338db0d40c897596da"], "node": "a33c90571e92de766016d68eb74994cec1c0a75e", "parents": ["30f625ca8f6f23afecc7411fd1f77444e85a2e4e"], "tags": []}], "date": 1787326597, "git_changesets": ["a5cb276dab2bed92fc3440e204cabcea40141ce0"], "user": "csabou@mozilla.com"}, "45147": {"changesets": [{"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064761 - update wpt metadata for interactive-content.html.\n", "files": ["testing/web-platform/meta/html/semantics/interactive-elements/the-summary-element/interactive-content.html.ini"], "git_node": "3b5584d435a66fd52324d9994a75a44dbc1f29d8", "git_parents": ["770dfa82b61162d6b5c6f4338db0d40c897596da"], "node": "995104473f2a6f4b6917c636f1e7b5d8e05455a4", "parents": ["30f625ca8f6f23afecc7411fd1f77444e85a2e4e"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065382 - Update PDF.js to 9aea8e2dfb142ad7c4e3a2595e8052e5dc8ce160 r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320341\n", "files": ["toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "d10134975f8fc503add0ca84a2ab873bd5755cb6", "git_parents": ["3b5584d435a66fd52324d9994a75a44dbc1f29d8"], "node": "76d75133275c58f67d75e2bac39e3c3a16f7c34c", "parents": ["995104473f2a6f4b6917c636f1e7b5d8e05455a4"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2064233 - Add moz-src to broken chrome URL detection. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320360\n", "files": ["netwerk/base/nsNetUtil.cpp"], "git_node": "78a90b63dff7e39c3865c6a63ce4b0f072972f68", "git_parents": ["d10134975f8fc503add0ca84a2ab873bd5755cb6"], "node": "f5d818b8bf7b21c32b853de1e76e34f08b2a4870", "parents": ["76d75133275c58f67d75e2bac39e3c3a16f7c34c"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060836 - Changing u8 to u16 for trust_anchors subject length r=keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316519\n", "files": ["security/manager/ssl/pdf_trust_anchors/src/trust_anchors.rs", "security/manager/ssl/qwac_trust_anchors/src/trust_anchors.rs", "security/manager/ssl/trust-anchor-build-util/src/lib.rs"], "git_node": "eacc117f3f45133dc3976bfbf5aff2ffaa870255", "git_parents": ["78a90b63dff7e39c3865c6a63ce4b0f072972f68"], "node": "b817f7fc3fad8803274262d5a09e634c5ce9f5f0", "parents": ["f5d818b8bf7b21c32b853de1e76e34f08b2a4870"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062593 - Remove the Legacy Telemetry mirrors of the security.ui.certerror click events r=timhuang,chumphreys\n\nOnly the Legacy Telemetry mirrors are removed. The nine Glean events\nsecurity.ui.certerror.click_* are left in place, so what Firefox collects is\nunchanged. Recording is already Glean-exclusive: both call sites, aboutNetError.mjs\nand the felt-privacy net-error-card.mjs, build the metric name from the clicked\nelement's data-telemetry-id and funnel through recordSecurityUITelemetry, which\nrecords via RPMRecordGleanEvent only.\n\nBoth sides of each mirror have to go in the same commit. test_mirrors.py asserts\nthat every telemetry_mirror resolves to an existing probe, and separately that\nevery event probe has a mirroring metric, so removing either side alone fails.\n\nThe security.ui.certerror#load probe and its mirror are untouched.\n\nAlso drop security.ui.certerror#click from WEAKER_EVENT_COMPATIBILITY_PROBES,\nwhich is dead once the probe is gone. It was needed because the Legacy Telemetry\nevent declared a panel_open extra key that the Glean events do not list, which\nthe strict extra-key comparison rejects. panel_open was not recorded anywhere.\n\nbrowser_aboutCertError_telemetry.js read the legacy click event out of\nServices.telemetry.snapshotEvents, so it is converted to assert through\nGlean.securityUiCerterror instead. The legacy read relied on a destructive\nsnapshot to isolate iterations; Glean's testGetValue accumulates, and the\nfelt-privacy path clicks advancedButton as setup for other objects, so the test\nnow calls testResetFOG per iteration. The load-event assertion still reads Legacy\nTelemetry, since that probe is out of scope here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317810\n", "files": ["browser/base/content/test/about/browser_aboutCertError_telemetry.js", "toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/tests/python/test_mirrors.py", "toolkit/content/metrics.yaml"], "git_node": "d745a7782fbeb97be009a49698f48bf6e6b608dc", "git_parents": ["eacc117f3f45133dc3976bfbf5aff2ffaa870255"], "node": "05dfecb4cd9e0f03551be89bec9da058d18fa1af", "parents": ["b817f7fc3fad8803274262d5a09e634c5ce9f5f0"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065381 - Update android nightly application-services version bump to 6cc5bdeba5cea3166d089d61b7a147f9f01cbc6a r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320340\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "d75db545a2d6c8256bf5aeeaee04c026bf33f74d", "git_parents": ["d745a7782fbeb97be009a49698f48bf6e6b608dc"], "node": "e7825d77f7d903009104a501afcc26a2c79b3382", "parents": ["05dfecb4cd9e0f03551be89bec9da058d18fa1af"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062210 - Record the newtab searchbar as its own search access point. r=mbeier,search-reviewers,scunnane,Standard8\n\nSearches from it were dropped as an unknown source. It gets a browser.engagement.navigation metric of its own and joins the group whose action the search bars break down. The semi-legacy browser.search.content, .withads and .adclicks probes don't break it out, so SearchSERPTelemetry still has to stop routing the source to them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319855\n", "files": ["browser/components/search/BrowserSearchTelemetry.sys.mjs", "browser/components/search/docs/telemetry.md", "browser/components/search/metrics.yaml", "browser/components/search/test/browser/telemetry/browser.toml", "browser/components/search/test/browser/telemetry/browser_search_telemetry_sap_newtab_searchbar.js"], "git_node": "a4b451e58d54f844119908a346a26f770b168b5a", "git_parents": ["d75db545a2d6c8256bf5aeeaee04c026bf33f74d"], "node": "8619baea4d7d0083d91b642991ac0529b337750d", "parents": ["e7825d77f7d903009104a501afcc26a2c79b3382"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2065452 - Fix verifyUpdatedLoginIsSavedTest efficiency UI test r=jajohnson\n\nWhen the test opens the saved-passwords screen, Firefox pops up a \"Secure your saved passwords\" dialog.\nThis dialog appears a split-second after the screen loads and sits on top of everything.\nThe test tried to dismiss it at a fixed moment during navigation, but because the popup is late and unpredictable, it usually wasn't there yet when the test looked, the dialog stayed up covering the screen, and the test couldn't find the elements it needed.\n\nInstead of trying to click the dialog away at one fixed moment, the dialog is now registered as a known \"blocking overlay,\" and the page-load wait was changed so that if the screen doesn't appear, it dismisses any such dialog (tapping \"Later\") and checks again, reliably clearing the late popup no matter when it shows up.\n\nThe UI test successfully passed 50x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320394\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/OverlayRegistry.kt"], "git_node": "e6fa743cf560e57f2b1dd49868e0476c5bcffa1f", "git_parents": ["a4b451e58d54f844119908a346a26f770b168b5a"], "node": "26c6fe89f5b3c52bd160d5ad54891f59bf3b7757", "parents": ["8619baea4d7d0083d91b642991ac0529b337750d"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061673 - Remove the Legacy Telemetry mirror of cryptominers_blocked_count r=timhuang,janerik\n\nOnly the Legacy Telemetry mirror is removed. The Glean metric\ncontentblocking.cryptominers_blocked_count is left in place, so what Firefox\ncollects is unchanged. cryptominersHistogramAdd in browser-siteProtections.js\nalready records exclusively through Glean, so no instrumentation changes are\nneeded.\n\nBoth sides of the mirror have to go in the same commit: test_mirrors.py asserts\nevery telemetry_mirror resolves to an existing probe, and also that every\nhistogram in Histograms.json has a mirroring metric, so removing either side\nalone fails.\n\nbrowser_protectionsUI_cryptominers.js asserted on the legacy categorical\nhistogram only, so those assertions are converted to Glean rather than dropped.\nThe categorical indices the old snapshot indexed into map onto the labeled\ncounter's labels: 0 is pageLoad, 1 is blocked and 2 is allowed. The cmHistogram\nglobal and its getHistogramById lookup are now unused and removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317115\n", "files": ["browser/base/content/test/protectionsUI/browser_protectionsUI_cryptominers.js", "toolkit/components/antitracking/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "2e2af16af65a39341734f6e8d4e55556e4918099", "git_parents": ["e6fa743cf560e57f2b1dd49868e0476c5bcffa1f"], "node": "53e4be5e9feba090a8880e01581f285eb3555536", "parents": ["26c6fe89f5b3c52bd160d5ad54891f59bf3b7757"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061382 - Remove the Legacy Telemetry mirrors of the privacy.ui.fpp click events r=timhuang,chumphreys,hjones\n\nOnly the Legacy Telemetry mirrors are removed. The Glean events\nprivacy.ui.fpp.click.checkbox and privacy.ui.fpp.click.menu are left in place,\nso what Firefox collects is unchanged. Both about:preferences call sites,\nprivacy.js and config/privacy.mjs, already record exclusively through Glean, so\nno instrumentation changes are needed.\n\nBoth sides of each mirror have to go in the same commit. test_mirrors.py asserts\nthat every telemetry_mirror resolves to an existing probe, and separately that\nevery event probe has a mirroring metric, so removing either side alone fails.\n\nUnlike the other probes in this series there are no test changes:\nbrowser_contentblocking.js and browser_etp_customize_3.js already assert through\nGlean.privacyUiFppClick, and nothing outside Events.yaml read the legacy event.\n\nAlso drop privacy.ui.fpp#click from WEAKER_EVENT_COMPATIBILITY_PROBES in\ntest_mirrors.py, which is dead once the probe is gone. It was needed because the\nGlean menu event declares a `value` extra key that the Legacy Telemetry event\ndid not list among its extras, which the strict extra-key comparison rejects.\nWith the probe removed there is nothing left to compare.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317257\n", "files": ["browser/components/preferences/metrics.yaml", "toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/tests/python/test_mirrors.py"], "git_node": "f9883a5d01b8e928ecec5e3800809da7f1098d4c", "git_parents": ["2e2af16af65a39341734f6e8d4e55556e4918099"], "node": "4577577913a22ebd6195067c1cf01bc44f914047", "parents": ["53e4be5e9feba090a8880e01581f285eb3555536"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061372 - Remove the Legacy Telemetry mirror of datasanitization.session_permission_exceptions r=timhuang,chutten\n\nThe Glean metric datasanitization.session_permission_exceptions is the only\nrecorder of this data; StartupTelemetry.dataSanitization() already sets it\ndirectly and nothing reads the Legacy Telemetry scalar.\n\nBoth sides of the mirror have to go in the same commit: test_mirrors.py\nasserts every telemetry_mirror resolves to an existing probe, and also that\nevery scalar in Scalars.yaml has a mirroring metric, so removing either side\nalone fails.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317100\n", "files": ["browser/components/metrics.yaml", "toolkit/components/telemetry/Scalars.yaml"], "git_node": "14cea8d18b7c8ed7ac944f9caa9deadf44e2fe7b", "git_parents": ["f9883a5d01b8e928ecec5e3800809da7f1098d4c"], "node": "82648be4ab12d45987709dbe65aa2892ae251553", "parents": ["4577577913a22ebd6195067c1cf01bc44f914047"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064778 - Provide character bounds in EditContext eSetSelection test. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319876\n", "files": ["dom/events/IMEContentObserver.cpp", "editor/libeditor/tests/edit-context/test_editcontext_set_selection.html"], "git_node": "922be3dfe6a4c9c0995deb448419249f606faef6", "git_parents": ["14cea8d18b7c8ed7ac944f9caa9deadf44e2fe7b"], "node": "b9c3343fdc14d5ffcf27c63fa6dc14979b4117c0", "parents": ["82648be4ab12d45987709dbe65aa2892ae251553"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065420 - Divert counts of newer browser.search.* probes into the unknown source bucket. r=dao\n\nThe current mirroing to legacy telemetry means that the smart window probes are not being recorded in legacy telemetry. We are not adding new legacy probes at the time, so divert these into the unknown bucket which is recorded in legacy telemetry.\n\nWe have sap.counts and serp.impression events for analysing the sources in Glean.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320357\n", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/docs/telemetry.md", "browser/components/search/metrics.yaml"], "git_node": "bdcf4362363e479956f8196b522ca442c0cd093c", "git_parents": ["922be3dfe6a4c9c0995deb448419249f606faef6"], "node": "cbe0d46e91a7f95f69c3e78c35204b74d0c584eb", "parents": ["b9c3343fdc14d5ffcf27c63fa6dc14979b4117c0"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065212 - Make the length parameter of crypto.subtle.deriveBits [EnforceRange] r=webidl,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320402\n", "files": ["dom/webidl/SubtleCrypto.webidl"], "git_node": "02f9fd970cad7becb20458896d7608824d657c3c", "git_parents": ["bdcf4362363e479956f8196b522ca442c0cd093c"], "node": "8a5a46f8b418664c5b16bc1287f11bac2fceb468", "parents": ["cbe0d46e91a7f95f69c3e78c35204b74d0c584eb"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1983196 - Add OS version to About screen and fix VCS hash display. r=android-reviewers,giorga\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320406\n", "files": ["mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/about/AboutFragment.kt"], "git_node": "4a3c2eaad8a29b01223903f349d026e58e9b5eaf", "git_parents": ["02f9fd970cad7becb20458896d7608824d657c3c"], "node": "9ff74f5a7ecb124d06c220616ee970ab22114f11", "parents": ["8a5a46f8b418664c5b16bc1287f11bac2fceb468"], "tags": []}, {"author": "Dennis Jackson \u003cdjackson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039802 - Lower SSLTokensCache brotli quality from 5 to 1. r=necko-reviewers,valentin,leggert\n\nRecords are compressed on the socket thread inside the handshake that produced\nthem, where profiling 1200 handshakes showed BrotliEncoderCompress taking 18.7%\nof socket thread CPU. On realistic payloads quality 1 encodes 3.1x to 3.7x\nfaster than quality 5 for 4% to 6% larger output. The cache is bounded in bytes\nrather than entries, so the worse ratio costs a few percent of cached sessions\nrather than memory. Quality 2 to 4 are not a middle ground; they compress this\ndata worse than quality 1 for no speed gain.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320405\n", "files": ["netwerk/base/SSLTokensCache.cpp"], "git_node": "3257cd2fdb31fa80cb159e0a8e318c64a6041e56", "git_parents": ["4a3c2eaad8a29b01223903f349d026e58e9b5eaf"], "node": "5111d38957a228dcb6228850bb78265c51424f98", "parents": ["9ff74f5a7ecb124d06c220616ee970ab22114f11"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes ct-logs - r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320423\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin.meta.json", "services/settings/dumps/blocklists/gfx.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/newtab-wallpapers-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "05351559d994a57be196ecb8563ec1c13ef98274", "git_parents": ["3257cd2fdb31fa80cb159e0a8e318c64a6041e56"], "node": "979916733334ac6397788067d863446b167d103a", "parents": ["5111d38957a228dcb6228850bb78265c51424f98"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065029 - Setup taskcluster task to check status of static analysis r=jcristau\n\nOnly to be triggered manually given its currently prohibitive duration\ntime.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320006\n", "files": ["taskcluster/kinds/source-test/clang-tidy.yml", "taskcluster/kinds/source-test/kind.yml"], "git_node": "05e1580f99ea25b9c60d49609a4a59a4bcc3b1cc", "git_parents": ["05351559d994a57be196ecb8563ec1c13ef98274"], "node": "7f5af2614dda429a9e422908a3c88dfa126078fe", "parents": ["979916733334ac6397788067d863446b167d103a"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2044289 - Add test for nsCompressConv OMT with JS listener r=necko-reviewers,kershaw\n\nSKIP_BMO_CHECK\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304032\n", "files": ["netwerk/test/unit/test_compressConv_offmainthread_js_listener.js", "netwerk/test/unit/xpcshell.toml", "netwerk/test/unit_ipc/test_compressConv_offmainthread_js_listener_wrap.js", "netwerk/test/unit_ipc/xpcshell.toml"], "git_node": "d2407e1e7763dfbd504e04658b3eb71c085d2096", "git_parents": ["05e1580f99ea25b9c60d49609a4a59a4bcc3b1cc"], "node": "3b2638c4db54ffa6ce628d6391812a6708412109", "parents": ["7f5af2614dda429a9e422908a3c88dfa126078fe"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065404 - bump minidump-stackwalk to 0.27 r=afranchuk\n\nAmong other things, it has fixes needed to symbolicate from debuginfo on\nWindows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320350\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "54fe51ebb17dded21d8e85e72c7e9b4214552c36", "git_parents": ["d2407e1e7763dfbd504e04658b3eb71c085d2096"], "node": "9477c1aa913155bbfea02e4e435d0da63bdff12b", "parents": ["3b2638c4db54ffa6ce628d6391812a6708412109"], "tags": []}, {"author": "Benjamin Peterson \u003cbenjamin@python.org\u003e", "branch": "default", "desc": "Bug 2065293 - Finish removing AttachShadowInternal. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320274\n", "files": ["dom/base/Element.h"], "git_node": "20435ce479617e3c88b631b561dde686797a2c8c", "git_parents": ["54fe51ebb17dded21d8e85e72c7e9b4214552c36"], "node": "5d32911082f0d190ff88e93ba0c187fc7f35169a", "parents": ["9477c1aa913155bbfea02e4e435d0da63bdff12b"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063294 - Remove inner window gaps of floating chrome for Nova r=desktop-theme-reviewers,tabbrowser-reviewers,dao,sclements,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319297\n", "files": ["browser/base/content/test/maximized/browser_maximized_decoration.js", "browser/themes/shared/browser-shared.css", "browser/themes/shared/customizableui/customizeMode.css", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "2b1fcbf5fca9ffb95acdc7766833f93aeee35c21", "git_parents": ["20435ce479617e3c88b631b561dde686797a2c8c"], "node": "2db077e3ec4622cf983afca36fa7362be21037cc", "parents": ["5d32911082f0d190ff88e93ba0c187fc7f35169a"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058417 - Use the normalized format consistently in DataTransfer::SetDataAtInternal. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320206\n", "files": ["dom/events/DataTransfer.cpp"], "git_node": "079a730afd38389e68468048d7456afc865796f6", "git_parents": ["2b1fcbf5fca9ffb95acdc7766833f93aeee35c21"], "node": "42fe308c861d8bfb3a346a8dd9bd7a5c532b5d4a", "parents": ["2db077e3ec4622cf983afca36fa7362be21037cc"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2065491 - Temporarily disable network.http.http3.apple_fast_datapath r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320424\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "4786bfed601bf96191bfc95f08f2eb9134454fed", "git_parents": ["079a730afd38389e68468048d7456afc865796f6"], "node": "96a23e4d6f4308373862d2b89d3bcf0b628388ad", "parents": ["42fe308c861d8bfb3a346a8dd9bd7a5c532b5d4a"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053256 - Inform editor that composition has ended if node was removed from document. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311150\n", "files": ["dom/events/TextComposition.cpp", "editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorEventListener.cpp", "editor/libeditor/tests/mochitest.toml", "editor/libeditor/tests/test_remove_during_composition.html"], "git_node": "8c7f6a3b2a6f2a30b150cceb23e6d262e3ab2ead", "git_parents": ["4786bfed601bf96191bfc95f08f2eb9134454fed"], "node": "4c0d5a00375abec4846a4dfb442047315edcdee4", "parents": ["96a23e4d6f4308373862d2b89d3bcf0b628388ad"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1983837: Don't skip test262/staging/top-level-await/tla-hang-entry.js. r=jonco\n\nThe test originally had a bug on the specifiers, and it is fixed by now.\n\nhttps://github.com/tc39/test262/commit/a6f910b8ab9b46e9fcb4432bcbdd34a85c4be64f\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320420\n", "files": ["js/src/tests/jstests.list"], "git_node": "1d142ed760fe5f835fed8d89dcd8905ca97141ac", "git_parents": ["8c7f6a3b2a6f2a30b150cceb23e6d262e3ab2ead"], "node": "cfdab59558c8a0ea30f4a49b98923c690df05e90", "parents": ["4c0d5a00375abec4846a4dfb442047315edcdee4"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065425 - Don't stretch with indefinite block-size in GenerateFlexItemsForChild. r=layout-reviewers,dshin\n\nThe key here is not so much the fact that we don't use Stretch() (it\nwouldn't get used anyhow), but that it causes us to call\nResolveStretchedCrossSize() below, even if the resulting cross-size ends\nup being non-indefinite.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320407\n", "files": ["layout/generic/nsFlexContainerFrame.cpp", "testing/web-platform/tests/css/css-flexbox/flex-basis-014.html"], "git_node": "6f1a348e95a4accc0825a016600c9fd3d8f92547", "git_parents": ["1d142ed760fe5f835fed8d89dcd8905ca97141ac"], "node": "4c0d2d018641238226e1db60c98426158ec84750", "parents": ["cfdab59558c8a0ea30f4a49b98923c690df05e90"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065190 - Warn when enrolling with a stale sign-in watcher r=ip-protection-reviewers,apopov\n\nIn order to call enroll() you must have been signed in, i've noticed not on every path the\nsignIn-Watcher was notified so adding some warning and a telemetry ping for that, in case.\n(The call will fail if the user is not really signed in, anyway)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320169\n", "files": ["toolkit/components/ipprotection/fxa/IPPFxaActivateAuthProvider.sys.mjs"], "git_node": "99ca36ffcb7fd3e02678cae000aa0ff4b2ff0e69", "git_parents": ["6f1a348e95a4accc0825a016600c9fd3d8f92547"], "node": "b4ef5a40f5c974a5a0ed8b5396ebae5d5447fceb", "parents": ["4c0d2d018641238226e1db60c98426158ec84750"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065190 - Announce signin before enrolling r=android-reviewers,jonalmeida\n\nSo i have noticed that the ProxyManager activate() and enroll() functions\nare beeing called before announcing that the User has now signed in.\n\nGiven that we auto-activate after the successfull enrol() and enrolling implies\nthe user has to be signed in to succeed, let's make sure we tell toolkit that before actually enrolling.\n\nOtherwise, enrolling will succeed but the activation after that is guaranteed to fail.\nProxyManager, [[ https://searchfox.org/firefox-main/source/toolkit/components/ipprotection/IPPProxyManager.sys.mjs#341 | will check whether it was told about the signin ]] and fail if it thinks you are signed out.\n\nOn the 2nd activation it seems the\n```\nAccountStatus.TryAgain -\u003e {\n                            handler?.notifyAccountStatus(true)\n                        }\n```\nbranch is called first, at least at that time ProxyManager has noticed the sign-in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320170\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt"], "git_node": "26241d6989d7d9c539c50ff05b7dfccde9c1e31e", "git_parents": ["99ca36ffcb7fd3e02678cae000aa0ff4b2ff0e69"], "node": "8290b9c612fdafca7ab506beb3051024effb67a1", "parents": ["b4ef5a40f5c974a5a0ed8b5396ebae5d5447fceb"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065190 - Add a test to assert signedIn == true is passed before attempting to enroll r=android-reviewers,jonalmeida\n\nI was not sure if that behavior should have a test, given i could not found anything about ipprotectionfeature, so made this in an extra commit so i can abandon in case we don't need it :)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320171\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/IPProtectionFeatureTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/TestHelpers.kt"], "git_node": "1aaa68e21bac97aafec4bb742865975b265abc5c", "git_parents": ["26241d6989d7d9c539c50ff05b7dfccde9c1e31e"], "node": "286deeb53bae744b691784ca5aeb83cf2e8f478f", "parents": ["8290b9c612fdafca7ab506beb3051024effb67a1"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063780 - Early return when session history should do nothing. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319133\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "f394de524959d3ca5e8440cb523ba1d2c08c01bc", "git_parents": ["1aaa68e21bac97aafec4bb742865975b265abc5c"], "node": "e7ccd74c98542e4a6c33eb42ec67ad77e4727e05", "parents": ["286deeb53bae744b691784ca5aeb83cf2e8f478f"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055028 - Don't perform unnecessary reload. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319134\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "360318a79763b046db69d2668210f57a22b0bae0", "git_parents": ["f394de524959d3ca5e8440cb523ba1d2c08c01bc"], "node": "994c346eafa89d390678bdded113e416b094fd95", "parents": ["e7ccd74c98542e4a6c33eb42ec67ad77e4727e05"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015828 - Update directionality when slot assigned nodes are cleared. r=jjaschke,keithamus,dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320335\n", "files": ["dom/html/HTMLSlotElement.cpp", "testing/web-platform/tests/html/dom/elements/global-attributes/dir-shadow-utils.js", "testing/web-platform/tests/html/dom/elements/global-attributes/dir-slots-directionality.html"], "git_node": "4a51125558ab565ca87b63701746c3b9aa6f418a", "git_parents": ["360318a79763b046db69d2668210f57a22b0bae0"], "node": "f4f4a7e2bf93208691b2b53181e86b9e95b3a4e0", "parents": ["994c346eafa89d390678bdded113e416b094fd95"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015828 - Refactor selection code out of DirectionalityUtils Slot methods. r=jjaschke,dom-core-reviewers,keithamus\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320336\n", "files": ["dom/base/AbstractRan