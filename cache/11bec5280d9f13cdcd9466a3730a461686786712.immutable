l/hw-support.c", "security/nss/nss-tool/nss_tool.cc", "security/nss/taskcluster/docker/acvp/acvp-rust.patch", "security/nss/tests/cert/cert.sh", "security/nss/tests/common/certsetup.sh", "security/nss/tests/ssl/ssl.sh", "security/nss/tests/ssl/sslauth.txt", "security/nss/tests/ssl/sslcov.txt", "security/nss/tests/ssl_gtests/ssl_gtest_db.sh", "security/nss/tests/tools/ietf-ml-dsa-44-both.p12", "security/nss/tests/tools/ietf-ml-dsa-44-key.p12", "security/nss/tests/tools/ietf-ml-dsa-65-both.p12", "security/nss/tests/tools/ietf-ml-dsa-65-key.p12", "security/nss/tests/tools/ietf-ml-dsa-87-both.p12", "security/nss/tests/tools/ietf-ml-dsa-87-key.p12", "security/nss/tests/tools/openssl-ml-dsa-44.p12", "security/nss/tests/tools/openssl-ml-dsa-65.p12", "security/nss/tests/tools/openssl-ml-dsa-87.p12", "security/nss/tests/tools/tools.sh"], "git_node": "42823af0750b6f352dcd1b21ef4984079eeafc88", "git_parents": ["9349836256e519437f192c475e207935b8e43f6f"], "node": "57707c3b1144d2763d3ef086df0afef33aa4881e", "parents": ["b09bd67f5557162b19a3f05919b15d2f3d1a1d49"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2057151 - Skip browser_aiwindow_ai_action_result.js under test-verify r=jlewis\n\nThe test intermittently hits a no-output timeout under test-verify (seen on macosx-aarch64 and linux Wayland). The hang is not in the test body (which passes); it is the harness's post-test focus step (SimpleTest.promiseFocus) awaiting a focus event that is not reliably delivered in headless CI, with no timeout. test-verify runs the file 10x in one browser, turning the intermittent focus race into a near-perma timeout.\n\nThis is one of a cluster of aiwindow test-verify timeouts handled the same way before (bugs 2060705, 2056717). Skip under test-verify as a stopgap until the underlying harness focus issue is fixed centrally.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320589\n", "files": ["browser/components/aiwindow/ui/test/browser/browser.toml"], "git_node": "d15a0740c096a8696addec0825dfaa92f9e41beb", "git_parents": ["42823af0750b6f352dcd1b21ef4984079eeafc88"], "node": "6aaaff12acfe1408d46a33486b51e702ee1a640a", "parents": ["57707c3b1144d2763d3ef086df0afef33aa4881e"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2060810 - mots.yaml: module URLs are not clickable in the exported documentation r=zeid\n\nThe mots export renders meta.url verbatim into docs/mots/index.md. Since\nthat export switched from reStructuredText to Markdown, a bare URL is no\nlonger turned into a link by the parser, so the URL column of every module\nrendered as plain text. Wrapping the values in \u003c\u003e makes them autolinks\nagain.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316516\n", "files": ["mots.yaml"], "git_node": "9f5d54a1961404151536657af0e0733f28d5e1d9", "git_parents": ["d15a0740c096a8696addec0825dfaa92f9e41beb"], "node": "a64ae6b49105a3f51fc122c852708d814584fe2a", "parents": ["6aaaff12acfe1408d46a33486b51e702ee1a640a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2060811 - mots.yaml: add the review groups documented in docs/contributing/reviews.md r=shtrom\n\nSeveral review groups listed in the reviews documentation had no\nreview_group entry in mots.yaml, so tools that map a path to its reviewer\ngroup (Phabricator's reviewer selector, mach file-info reviewers) had\nnothing to suggest for those modules. Add the groups whose documented\nownership names the module or its path:\n\n  Core: Build Config              firefox-build-system-reviewers\n  Core: Firefox Source Doc.       firefox-source-docs-reviewers\n  Core: I18N Library              platform-i18n-reviewers\n  Tabbed Browser                  tabbrowser-reviewers\n  UI Widgets                      reusable-components-reviewers\n  Mozbase                         mozbase\n  Remote Protocol                 webdriver-reviewers\n  geckodriver                     webdriver-reviewers\n  Marionette Client & Harness     webdriver-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316517\n", "files": ["mots.yaml"], "git_node": "99d6dfa3f393a3a678667fbc7625fbec58faf4f2", "git_parents": ["9f5d54a1961404151536657af0e0733f28d5e1d9"], "node": "4476c86d9c98c409796c2922a9251adabcaaa13a", "parents": ["a64ae6b49105a3f51fc122c852708d814584fe2a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2060808 - file-info reviewers: also use mots.yaml as input r=shtrom\n\nThe Herald rules only cover part of the tree, and where they do not match,\nthe command fell back to walking the version control history. mots.yaml\nknows which module owns a path and which reviewer group reviews it, so use\nit as a second source: on a 1500-file sample it supplies a reviewer group\nfor 394 paths that had no matching Herald rule, and adds a group Herald\nmissed on 69 more.\n\nOnly meta.review_group is suggested. meta.group is a mailing list rather\nthan a Phabricator group, and owners and peers are individuals, which this\ncommand does not suggest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317553\n", "files": ["python/mozbuild/mozbuild/frontend/mach_commands.py", "python/mozbuild/mozbuild/test/frontend/test_file_info_reviewers.py"], "git_node": "cebc5c31e1cdd7afd14108cf3c07994771951326", "git_parents": ["99d6dfa3f393a3a678667fbc7625fbec58faf4f2"], "node": "228303da7069ad10d6b8df4e3889ee49e9939959", "parents": ["4476c86d9c98c409796c2922a9251adabcaaa13a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2060808 - docs: document mach file-info reviewers r=firefox-source-docs-reviewers,ahal\n\nPoint contributors at `mach file-info reviewers` as the first thing to try when\nlooking for a reviewer, in both the quickref and the reviews page, and describe\nthe three kinds of suggestion it reports. The version control history remains\ndocumented as the fallback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317554\n", "files": ["docs/contributing/contribution_quickref.md", "docs/contributing/reviews.md"], "git_node": "c8128c027a9c5da3b5a5a5f04260d071179fe4dd", "git_parents": ["cebc5c31e1cdd7afd14108cf3c07994771951326"], "node": "6627f227b878177b0c61f43c4cf94b0a862ffe89", "parents": ["228303da7069ad10d6b8df4e3889ee49e9939959"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2060808 - file-info reviewers: move the reviewer suggestion logic to its own file r=shtrom\n\nmach_commands.py now holds only the mach plumbing; the Herald, mots and\nversion control history lookups live in mozbuild/frontend/reviewers.py.\nPure code move: the functions become module API and lose their leading\nunderscore, with no behaviour change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319436\n", "files": ["python/mozbuild/mozbuild/frontend/mach_commands.py", "python/mozbuild/mozbuild/frontend/reviewers.py", "python/mozbuild/mozbuild/test/frontend/test_file_info_reviewers.py"], "git_node": "5eebd2ca16f9dacaf28f9f8f10bc3a96794f29ee", "git_parents": ["c8128c027a9c5da3b5a5a5f04260d071179fe4dd"], "node": "7685423fef3870799112905a7efebfb8b407647a", "parents": ["6627f227b878177b0c61f43c4cf94b0a862ffe89"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058137: Prevent double event consumption on buttons in the list all tabs menu r=tabbrowser-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319473\n", "files": ["browser/components/tabbrowser/TabsList.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_list_all_tabs_menu_items.js"], "git_node": "4322fbf73ba6b22f26005c696a922d43087899f7", "git_parents": ["5eebd2ca16f9dacaf28f9f8f10bc3a96794f29ee"], "node": "031148770e94ea51849917719695ee9c9dd69238", "parents": ["7685423fef3870799112905a7efebfb8b407647a"], "tags": []}, {"author": "Finn Terdal \u003cfterdal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060248 - FRO Template Updates for Terms of Service r=omc-reviewers,emcminn\n\nAdds support for a pre-onboarding screen that prompts the user to make\nFirefox the default browser and adds Firefox to the taskbar. Also\nhandles the Terms of Use acceptance, and a link to manage telemetry\ndata. Note that currently the link to Manage diagnostic and interactive\ndata doesn't do anything, which will be handled in a future ticket.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317535\n", "files": ["browser/base/content/test/static/browser_all_files_referenced.js", "browser/components/aboutwelcome/assets/kit-sit-look-up.svg", "browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aboutwelcome/jar.mn", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_configurable_ui.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_multiselect.js", "browser/components/asrouter/content-src/components/LinkParagraph.jsx", "browser/components/asrouter/content-src/components/MultiSelect.jsx", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/docs/feature-callout.md", "browser/components/asrouter/tests/unit/content-src/components/LinkParagraph.test.jsx", "browser/components/asrouter/tests/unit/content-src/components/MultiSelect.test.jsx"], "git_node": "e84634735170164c024c0e3155f1592aca1ef8f9", "git_parents": ["4322fbf73ba6b22f26005c696a922d43087899f7"], "node": "a1613de1dab119e6ddf7cd5ca0763cd489483bdb", "parents": ["031148770e94ea51849917719695ee9c9dd69238"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2062720 - Don't allow CreateInstance for singleton XPCOM components. r=nika,necko-reviewers,valentin\n\nThis patch tracks which XPCOM components are singletons at runtime, and\nthrows an error if you attempt to call createInstance for a singleton.\nThe motivation here is that many singleton XPCOM components only expect\nto be created once, via do_GetService(), and calling do_CreateInstance()\nmultiple times could result in races or memory corruption, which we'd like\nto avoid.\n\nThe system principal is implemented as a singleton, but it isn't a service,\nand calls to createInstance with it far outnumber the calls to getService.\nFurthermore, you have to be able to createInstance it to work with\nnsBinaryStream. For these reasons, the patch changes the 'singleton' property\nfor it to False. The nsBinaryStream behavior is tested in\ntest_binarystream_systemprincipal.js.\n\nThe test browser_bug1535877.js was testing that you can safely createInstance\nthe eTLD service, but now it simply throws. That aspect is maintained by XPCOM\nand not the eTLD service itself, so I've moved the test into test_create_single.js\nand updated it for the new behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320728\n", "files": ["layout/build/components.conf", "netwerk/test/browser/browser.toml", "netwerk/test/browser/browser_bug1535877.js", "xpcom/components/StaticComponents.h", "xpcom/components/gen_static_components.py", "xpcom/components/nsComponentManager.cpp", "xpcom/components/nsComponentManager.h", "xpcom/tests/unit/test_binarystream_systemprincipal.js", "xpcom/tests/unit/test_create_single.js", "xpcom/tests/uni