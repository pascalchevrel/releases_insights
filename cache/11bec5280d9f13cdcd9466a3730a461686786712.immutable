 unnecessary includes from nsComponentManager. r=xpcom-reviewers,emilio\n\nAlso remove some unused definitions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320941\n", "files": ["xpcom/components/nsComponentManager.cpp", "xpcom/components/nsComponentManager.h"], "git_node": "9f7d07037cb2e1f848fa319811b30ceecfe67305", "git_parents": ["1753ff86a2ba6365e247afe641551a680a0dd30e"], "node": "dc64ab338f6af2f11853fe953baff6d6a676b626", "parents": ["17952621186e451cd33c4f3769a68e0a9817cc43"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066536 - Remove the clang 21 toolchains. r=firefox-build-system-reviewers,ahochheiden\n\nAlso removes the patches and workarounds that are no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321340\n", "files": ["build/build-clang/D146664.patch", "build/build-clang/clang-21.json", "build/build-clang/llvmorg-18-init-8471-g160e8eb44961.patch", "build/build-clang/llvmorg-19-init-7654-gc23135c5488f.patch", "build/build-clang/llvmorg-22-init-11861-gfbcd82aab5ff.patch", "build/build-clang/llvmorg-22-init-14349-g7d5c11f6e926.patch", "build/build-clang/llvmorg-22-init-14556-g6a8943942335.patch", "build/build-clang/llvmorg-22-init-1937-g2672719a09cf.patch", "build/build-clang/llvmorg-22-init-2380-gd9971be83e5d.patch", "build/build-clang/revert-llvmorg-16-init-11301-g163bb6d64e5f_clang_17.patch", "build/build-clang/revert-llvmorg-16-init-11301-g163bb6d64e5f_clang_21.patch", "build/build-clang/sanitizer_deadlock_suppression.patch", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/clang.yml", "taskcluster/kinds/toolchain/compiler-rt.yml", "taskcluster/kinds/toolchain/libunwind.yml", "taskcluster/kinds/toolchain/llvm-symbolizer.yml", "taskcluster/kinds/toolchain/sysroot.yml", "taskcluster/scripts/misc/build-clang-mingw.sh", "taskcluster/scripts/misc/build-cmake.sh", "taskcluster/scripts/misc/mingw-libunwind-seh.patch"], "git_node": "bf76bce22e5b54e4f11e71042843e77c8188e2e8", "git_parents": ["9f7d07037cb2e1f848fa319811b30ceecfe67305"], "node": "a2aa16df8bdcb168418a3a7ec780a3638d973675", "parents": ["dc64ab338f6af2f11853fe953baff6d6a676b626"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066560 - Hide the menu when clicking on the sync status (sync your data/ sync is off) button r=sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321355\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser_sync.js"], "git_node": "351b1d2d3a4b41256db20dc0fb79fe9c64527710", "git_parents": ["bf76bce22e5b54e4f11e71042843e77c8188e2e8"], "node": "e84c657b19f7821e01f0075f7f8dc1165a5fe661", "parents": ["a2aa16df8bdcb168418a3a7ec780a3638d973675"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066134 - Fix non-unified build bustage.\n", "files": ["xpcom/components/nsCategoryManager.cpp"], "git_node": "6ba022ce909d0e7289fd07a541c8ef6dc89d77c8", "git_parents": ["351b1d2d3a4b41256db20dc0fb79fe9c64527710"], "node": "a6b3523ec9058dc0173a0d656ae74e4c1697e9ba", "parents": ["e84c657b19f7821e01f0075f7f8dc1165a5fe661"], "tags": []}, {"author": "yazan \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062309 - Prefer exact URL match over title/label match when resolving %triggeredTabBookmark%. r=omc-reviewers,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317656\n", "files": ["browser/components/asrouter/modules/FeatureCallout.sys.mjs", "browser/components/asrouter/tests/browser/browser_feature_callout_in_chrome.js"], "git_node": "c49e5b6fe473c58be2ec39eb71e89a2457d52154", "git_parents": ["6ba022ce909d0e7289fd07a541c8ef6dc89d77c8"], "node": "b5f3a24de895e042d50946e3ff8401af84039147", "parents": ["a6b3523ec9058dc0173a0d656ae74e4c1697e9ba"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062613 - Show that sync is in progress or complete when animations are disabled with \"Syncing...\" label r=skhamis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321056\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser_sync.js", "browser/components/customizableui/test/browser_synced_tabs_menu.js"], "git_node": "208aee2c6673c95b00e3a5b976a7ded169c5eeaa", "git_parents": ["c49e5b6fe473c58be2ec39eb71e89a2457d52154"], "node": "c4a057737fdcbe00c6df59b7205023dcc425d076", "parents": ["b5f3a24de895e042d50946e3ff8401af84039147"], "tags": []}, {"author": "Bryan Thrall \u003cbthrall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058658 - Report OOM and fix memory leak. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321378\n", "files": ["js/src/frontend/Stencil.cpp", "js/src/jit-test/tests/bug2058658.js"], "git_node": "dabaa0ae328f359398d722d46a553e4d92630e1e", "git_parents": ["208aee2c6673c95b00e3a5b976a7ded169c5eeaa"], "node": "76e9abc5359b40f2f78bd03a459661a4a6a98b37", "parents": ["c4a057737fdcbe00c6df59b7205023dcc425d076"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2047643 - Add connection closer on port 8888 for test_session_resumption.js r=manuel\n\nOn windows, the connection might not immediately fail with NS_ERROR_CONNECTION_REFUSED\nwhen there is nothing listeneing on the port. That seems to cause the test to go over the\n30 second limit.\n\nWe can fix this by increasing that limit (adding requesttimeoutfactor = 2 to the xpcshell.toml)\nor by adding a listener to port 8888 that immediately closes the connection.\nThat made the test go from 36 seconds to 12 seconds on my machine.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321508\n", "files": ["security/manager/ssl/tests/unit/test_session_resumption.js"], "git_node": "e45ecb46461f32b49518861ac2a4f66dc24d751e", "git_parents": ["dabaa0ae328f359398d722d46a553e4d92630e1e"], "node": "e170fe447beb94662c933588fac7d75a55b9c593", "parents": ["76e9abc5359b40f2f78bd03a459661a4a6a98b37"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066184 - Part 1: Add navigate property to Notification. r=saschanaz,webidl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320994\n", "files": ["dom/ipc/DOMTypes.ipdlh", "dom/notification/Notification.cpp", "dom/notification/Notification.h", "dom/notification/NotificationParent.cpp", "dom/webidl/Notification.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/notifications/idlharness.https.any.js.ini", "toolkit/components/alerts/AlertNotification.cpp", "toolkit/components/alerts/AlertNotification.h", "toolkit/components/alerts/nsIAlertsService.idl"], "git_node": "e75fc51c16fd7345492126771521f2cedbd5ef1a", "git_parents": ["e45ecb46461f32b49518861ac2a4f66dc24d751e"], "node": "3e4e15b0844c5a641fafdfc07f6b1ce356dcd80c", "parents": ["e170fe447beb94662c933588fac7d75a55b9c593"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066184 - Part 2: Add navigate to NotificationStorage. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321317\n", "files": ["dom/interfaces/notification/nsINotificationStorage.idl", "dom/notification/NotificationUtils.cpp", "testing/web-platform/mozilla/meta/notifications/simulate-click-handler.sub.https.window.js.ini", "testing/web-platform/mozilla/tests/notifications/simulate-click-handler-sw.js", "testing/web-platform/mozilla/tests/notifications/simulate-click-handler.sub.https.window.js"], "git_node": "03531562b70431b44fe5559b2d357f9047e6b135", "git_parents": ["e75fc51c16fd7345492126771521f2cedbd5ef1a"], "node": "a9b598e8ab85bc606e4cc21d97fcba6b465bea11", "parents": ["3e4e15b0844c5a641fafdfc07f6b1ce356dcd80c"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066184 - Part 3: Navigate to Notification or action's navigation URL on click. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320995\n", "files": ["dom/notification/NotificationHandler.cpp", "dom/notification/NotificationHandler.h", "dom/notification/NotificationParent.cpp", "testing/web-platform/mozilla/meta/notifications/navigate.https.window.js.ini", "testing/web-platform/mozilla/tests/notifications/navigate-sw.js", "testing/web-platform/mozilla/tests/notifications/navigate.https.window.js", "testing/web-platform/mozilla/tests/notifications/resources/broadcast-when-opened.html"], "git_node": "c7572d318c0dcb13e84791c12b2b4374f4f4f75e", "git_parents": ["03531562b70431b44fe5559b2d357f9047e6b135"], "node": "a1528fbc802639a77eeda3f3bb6b0e12dd1f71a1", "parents": ["a9b598e8ab85bc606e4cc21d97fcba6b465bea11"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064651 - Test the newtab search bar's search mode switcher with scotch bonnet off. r=mbeier,urlbar-reviewers\n\nEverything the shared utils touch here has to work in a content process, where a custom element's events are untrusted and the search service is out of reach.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321250\n", "files": ["browser/components/urlbar/tests/NewtabSearchbarTestUtils.sys.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_searchModeSwitcher.js"], "git_node": "7980bec1c624972f041ae5bdd6b4e00ddf1ba97d", "git_parents": ["c7572d318c0dcb13e84791c12b2b4374f4f4f75e"], "node": "6e45d4bd567f982efcb34480d2c23add571cc0cb", "parents": ["a1528fbc802639a77eeda3f3bb6b0e12dd1f71a1"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066403 - Leave the host element's overflow alone when the panel-list is a popover. r=mbeier,tgiles\n\nThe clamp is behavior-neutral for a popover: it is restored before `showPopover()`, so it never covers the one paint the panel contributes overflow to the host on, and during the window it does cover, the panel contributes none.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321212\n", "files": ["browser/components/urlbar/tests/NewtabSearchbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_resultMenu.js", "browser/components/urlbar/tests/browser-newtab/head.js", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "5bf0f62b6f9635874ff27cf4450729710ded7363", "git_parents": ["7980bec1c624972f041ae5bdd6b4e00ddf1ba97d"], "node": "88ffbdb92530fddb93d6057ee59570409fa6287d", "parents": ["6e45d4bd567f982efcb34480d2c23add571cc0cb"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062212 - Turn the newtab feature gate off in the tests that drive the handoff bar. r=daleharvey,search-reviewers,urlbar-reviewers\n\nThe next commit makes the gate default on for Nightly, which supersedes the handoff bar and leaves these tests waiting for markup that is no longer there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321040\n", "files": ["browser/components/search/test/browser/browser_contentSearchUI_default.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_sources.js", "browser/components/urlbar/tests/browser-engagementTelemetry/head-sap.js", "browser/components/urlbar/tests/browser-telemetry/browser_handoff.js", "browser/components/urlbar/tests/browser/browser_suppressFocusBorder.js", "browser/components/urlbar/tests/unit/test_UrlbarNewTabComponentRegistrant.js", "browser/extensions/newtab/test/browser/browser_as_render.js"], "git_node": "a8ca1eac0bb4788bc783dab7bca241e59fbb4ace", "git_parents": ["5bf0f62b6f9635874ff27cf4450729710ded7363"], "node": "540bd3cda62fd69f9e38ed8053d938a5aeed21c0", "parents": ["88ffbdb92530fddb93d6057ee59570409fa6287d"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048237 - Harden remote encoding state machine in RemoteMediaDataEncoderParent. r=media-playback-reviewers,padenot\n\nBecause RemoteMediaDataEncoderParent is where the process boundary\nbetween content and the RDD/GPU process, we need to be more careful\nto validate our input and message ordering.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307416\n", "files": ["dom/media/ipc/RemoteMediaDataEncoderParent.cpp", "dom/media/ipc/RemoteMediaDataEncoderParent.h"], "git_node": "905f143c459d20de719b1f439d965d7e47d85c2e", "git_parents": ["a8ca1eac0bb4788bc783dab7bca241e59fbb4ace"], "node": "efb9d0f2feed3844e5638288724adb61d1b35ffe", "parents": ["540bd3cda62fd69f9e38ed8053d938a5aeed21c0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2064930 - Make image icons work in native menubar. r=mac-reviewers,mkennedy,bradwerth\n\nMove the native menubar items out of the \"tools\" menu, since they don't\nneed to be, and menus connect their menuitems lazily, which would\nprevent potential styling with e.g. context fill.\n\nIf we wanted to support that of course we'd need to load menu.css and co\nin the hidden window, but...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321011\n", "files": ["browser/base/content/browser-menubar.inc.xhtml", "layout/reftests/xul/menuitem-key-ref.xhtml", "toolkit/content/widgets/menu.js", "widget/cocoa/nsMenuBarX.h", "widget/cocoa/nsMenuBarX.mm"], "git_node": "00f1683533041a3c88d7e9a30d706b436d841890", "git_parents": ["905f143c459d20de719b1f439d965d7e47d85c2e"], "node": "e5f01090fc17062b674b9f53f9175e1ab10eff1e", "parents": ["efb9d0f2feed3844e5638288724adb61d1b35ffe"], "tags": []}, {"author": "@Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065292: Change order of autocomplete row items for external providers like SFF r=credential-management-reviewers,dimi\n\nFigma: https://www.figma.com/design/sIgXsbSFZjKIcfErMoBgLr/Smart-Window-Q3?node-id=12022-11842&p=f&m=dev\n\nChange order or autocomplete row items so smart form fill and any other external provider row is displayed above the footer (manage addresses).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320441\n", "files": ["browser/extensions/formautofill/test/browser/browser_autocomplete_footer.js", "browser/extensions/formautofill/test/unit/test_profileAutocompleteResult.js", "toolkit/components/formautofill/ProfileAutoCompleteResult.sys.mjs"], "git_node": "b0e52bee2c4e84a19664eeb5129dc9084d9cc073", "git_parents": ["00f1683533041a3c88d7e9a30d706b436d841890"], "node": "2a6f01b8017b9cba911b70b1c7a0585fa0bf4707", "parents": ["e5f01090fc17062b674b9f53f9175e1ab10eff1e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065803 - Record the surface multi-selected tabs were pinned from. r=mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320685\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_pin_unpin.js"], "git_node": "6a22871ac112bd49bf6f0818cef6788c3ed7cc4b", "git_parents": ["b0e52bee2c4e84a19664eeb5129dc9084d9cc073"], "node": "fa4e4bf7bc9ba70ce78de67e8b83c2848208ef02", "parents": ["2a6f01b8017b9cba911b70b1c7a0585fa0bf4707"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1780998 - Exit fullscreen in windows.update() when the widget already reports another state, and re-enable browser_ext_windows_update.js on mac Intel, r=extension-reviewers,emilio,robwu.\n\nBug 1780876 made Window.setState() clear window.fullScreen when the widget and the\nDOM disagree about being fullscreen, but that guard is unreachable for the request it\nwas written for: when the widget reports STATE_NORMAL while the DOM still has\nfullScreen set, the \"expectedState == initialState\" fast path above it returns first,\nso windows.update({state: \"normal\"}) did nothing and the window stayed fullscreen.\n\nThe fast path now also requires the DOM to agree about being fullscreen. Making the\ncondition simply \"&& !window.fullScreen\" would instead have sent an update to\n\"fullscreen\" on an already-fullscreen window through the guard below, exiting\nfullscreen and immediately re-entering it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318270\n", "files": ["browser/components/extensions/parent/ext-browser.js", "browser/components/extensions/test/browser/browser-windows.toml"], "git_node": "e028c1b3f1e560b1479a0eb931af26a6420eedc3", "git_parents": ["6a22871ac112bd49bf6f0818cef6788c3ed7cc4b"], "node": "760c14ac886d1c6fb87ae2856927aad390764462", "parents": ["fa4e4bf7bc9ba70ce78de67e8b83c2848208ef02"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066601 - Make AutoNoJSAPI use AutoHideScriptedCaller r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321389\n", "files": ["dom/script/ScriptSettings.cpp", "dom/script/ScriptSettings.h"], "git_node": "b192c039a1212f063f1289082651b033b6c2514c", "git_parents": ["e028c1b3f1e560b1479a0eb931af26a6420eedc3"], "node": "5c8f9114e8a24cb503901733eae707246e3a40fd", "parents": ["760c14ac886d1c6fb87ae2856927aad390764462"], "tags": []}, {"author": "Harshit \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064540 - Schedule the default browser agent as a WinRT background task on MSIX. r=nrishel,firefox-desktop-core-reviewers ,aborondo,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319618\n", "files": ["browser/components/BrowserComponents.manifest", "browser/components/moz.build", "toolkit/mozapps/defaultagent/BackgroundTask_defaultagent.sys.mjs", "toolkit/mozapps/defaultagent/DefaultAgentScheduler.sys.mjs", "toolkit/mozapps/defaultagent/moz.build", "toolkit/mozapps/defaultagent/tests/xpcshell/test_default_agent_scheduler.js", "toolkit/mozapps/defaultagent/tests/xpcshell/xpcshell.toml"], "git_node": "089b8156937f7ba002ea937a457a52e48171c080", "git_parents": ["b192c039a1212f063f1289082651b033b6c2514c"], "node": "624dbfa337cee023e90a0e634020979c392c4358", "parents": ["5c8f9114e8a24cb503901733eae707246e3a40fd"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2064601 - Improve processing of feConvolveMatrix kernelMatrix r=ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320032\n", "files": ["gfx/2d/FilterNodeSoftware.cpp"], "git_node": "894aa6a96122d64cab66f3c9470e9a6e35430c19", "git_parents": ["089b8156937f7ba002ea937a457a52e48171c080"], "node": "e3685333ec1af7e65202db8464a5eef8e2587393", "parents": ["624dbfa337cee023e90a0e634020979c392c4358"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055837 - use taskcluster-built python for test tasks. r=taskgraph-reviewers,bhearsum,perftest-reviewers,sparky\n\nThis was meant to have happened in bug 1888131.  Better late than never.\n\nHowever:\n- keep using system python on android-hw: as the scripts we run there rely on\n  it\n- keep using system python on mac: our python toolchain is x86_64, and using it\n  for the test harness on arm64 workers causes both it and the firefox it\n  spawns to run under rosetta, which is not good\n- keep using system python for awsy and talos: both fetch their pagesets via\n  the vendored external_tools/tooltool.py during download-and-extract, before\n  the virtualenv exists, so tooltool runs under the bare fetched python.  On\n  Windows that client imports certifi (bug 1829775), which the fetched CI\n  python doesn't provide, so the fetch fails with ModuleNotFoundError.\n- use 3.11 instead of the default 3.9 for windows gtests, because of\n  https://searchfox.org/firefox-main/rev/7d438b99e58d16388e4327f2460d14ad4c8be075/browser/app/desktop-launcher/tests/gtest/DesktopLauncherDownloaderTest.cpp#38\n  (3.9's http.server doesn't have --protocol, https://docs.python.org/3/library/http.server.html#cmdoption-http.server-p).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312746\n", "files": ["taskcluster/kinds/test/awsy.yml", "taskcluster/kinds/test/compiled.yml", "taskcluster/kinds/test/kind.yml", "taskcluster/kinds/test/misc.yml", "taskcluster/kinds/test/talos.yml", "taskcluster/kinds/test/xpcshell.yml"], "git_node": "2335ca1ef867628eafb5ff89d2400c17d965583a", "git_parents": ["894aa6a96122d64cab66f3c9470e9a6e35430c19"], "node": "e3af831b38b0a79f96ae5c2ce12a5f1669aca581", "parents": ["e3685333ec1af7e65202db8464a5eef8e2587393"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052772 - Part 1: Port module initialization in _schedulePerWindowIdleTasks to use category-manager invocation r=Gijs,frontend-codestyle-reviewers,mossop\n\nMove the per-window idle inits in gBrowserInit._schedulePerWindowIdleTasks to a\nnew browser-window-idle-tasks category, continuing Bug 2036714, Bug 2039199 and\nBug 2045665. The category is invoked with idleDispatch: true.\n\ncallModulesFromCategory now drops a consumer when its jsGlobal is a window that\nhas closed by the time the idle task runs. Without this, a window that closes\nbefore its idle inits run gets re-initialized after its unload teardown and\nleaks (browser_windowclose.js / browser_tabdetach.js).\n\nTeardown moves to the browser-window-unload categories, and the download init\nmoves into DownloadsCommon.initializeForWindow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310625\n", "files": ["browser/base/content/browser-gestureSupport.js", "browser/base/content/browser-init.js", "browser/base/content/browser.js", "browser/base/content/browser.js.globals", "browser/base/content/test/general/browser_gestureSupport.js", "browser/components/BrowserComponents.manifest", "browser/components/downloads/DownloadsCommon.sys.mjs", "browser/docs/BrowserStartup.md", "browser/modules/test/browser/browser_taskbar_preview.js", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/tests/xpcshell/test_BrowserUtils.js"], "git_node": "854379309b4f2e997b0623d2d8d4e24710d29840", "git_parents": ["2335ca1ef867628eafb5ff89d2400c17d965583a"], "node": "572b1a4bce942b9bddaaa23398d832885bed182e", "parents": ["e3af831b38b0a79f96ae5c2ce12a5f1669aca581"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052772 - Part 2: Allowlist the pre-existing urlbar focus-ring startup flicker exposed by the idle-task port r=Gijs\n\nInvoking browser-window-idle-tasks with idleDispatch changes when\nbrowser-startup-idle-tasks-finished fires, so the urlbar focus-ring settle now\nsometimes lands inside the window that browser_startup_flicker.js records. The\nflicker is pre-existing and intermittent (~15% on linux debug); add a targeted\nallowlist entry matching the urlbar box, and track removal in a follow-up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321518\n", "files": ["browser/base/content/test/performance/browser_startup_flicker.js"], "git_node": "7bc824ce462ab723c4cccb949e112544db9eaab0", "git_parents": ["854379309b4f2e997b0623d2d8d4e24710d29840"], "node": "0ee36b4e45e9ec394c34cef10be7ef1b9486fc4c", "parents": ["572b1a4bce942b9bddaaa23398d832885bed182e"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2048722 - Part 1: Add Google Lens to Firefox homescreen widget r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308320\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/AndroidManifest.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/search/SearchWidgetMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/intent/LensResultIntentProcessor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/VoiceSearchAIControlFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/search/SearchEngineFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/widget/LensSearchActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/gecko/search/SearchWidgetProvider.kt", "mobile/android/fenix/app/src/main/res/layout/activity_lens_search.xml", "mobile/android/fenix/app/src/main/res/layout/search_widget_large.xml", "mobile/android/fenix/app/src/main/res/layout/search_widget_medium.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/search/SearchWidgetMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/LensResultIntentProcessorTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/search/SearchEngineFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/widget/LensSearchActivityTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/widget/SearchWidgetProviderTest.kt"], "git_node": "bc0a1525813541c986b8eea7f059bda0f1d349be", "git_parents": ["7bc824ce462ab723c4cccb949e112544db9eaab0"], "node": "7cf0a93dfbb01db64c8f04c6df1ede19565ffbd0", "parents": ["0ee36b4e45e9ec394c34cef10be7ef1b9486fc4c"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2048722 - Part 2: Add confirmation dialog to QR scan in LensCameraActivity.kt r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319288\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/QrScanConfirmation.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/QrScanFenixFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/widget/LensSearchActivity.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/widget/LensSearchActivityTest.kt"], "git_node": "6beb51a5721f4b0cd5fabb64a3dfdc59a866d6e5", "git_parents": ["bc0a1525813541c986b8eea7f059bda0f1d349be"], "node": "5617da61011eb3206734ebe6ce001acf1719a710", "parents": ["7cf0a93dfbb01db64c8f04c6df1ede19565ffbd0"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041438 - screen reader reads error message on add search engine popup. r=Standard8,mkennedy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319185\n", "files": ["browser/components/preferences/tests/search/browser_search_engineList.js", "browser/components/preferences/tests/search/browser_search_userEngineDialog.js", "browser/components/preferences/tests/search/browser_search_userEngineDialog_xul.js", "browser/components/search/content/addEngine.css", "browser/components/search/content/addEngine.js", "browser/components/search/content/addEngine.xhtml"], "git_node": "b66b1854a46d5cf6a42c5f98d3675ac208ce1830", "git_parents": ["6beb51a5721f4b0cd5fabb64a3dfdc59a866d6e5"], "node": "76287ba2aa8ba852ba8e72537671c5b3f035e3ed", "parents": ["5617da61011eb3206734ebe6ce001acf1719a710"], "tags": []}, {"author": "RebecaTudor \u003crebecatudor273@gmail.com\u003e", "branch": "default", "desc": "Bug 2061757 - Fix private tabs unlock navigation loop. r=android-reviewers,gmalekpour\n\nThe issue is not limited to Android 8 and 9. On these Android versions,\n it is easier to observe because of another issue\n (https://bugzilla.mozilla.org/show_bug.cgi?id=2042118).\n However, it can be reproduced on all Android versions by configuring\n only credential authentication (pattern, PIN, etc.).\n\n Issue:\n When `enableHomepageAsNewTab` is enabled, switching to private mode by\n tapping \"Private browsing\" button from home screen, creates an\n about:home tab. If the app is locked, the security flow navigates to\n unlockPrivateTabsFragment, but `AboutHomeBinding` does not recognize this fragment\n as a valid destination for `about:home` and navigates back to `homeFragment`.\n This causes the security and homepage navigation flows to repeatedly redirect\n between the unlock and home screens.\n\n Fix:\n Add `unlockPrivateTabsFragment` to the `AboutHomeBinding` exclusion list so homepage\n navigation does not interfere with the private tab unlock flow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319150\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/AboutHomeBinding.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/AboutHomeBindingTest.kt"], "git_node": "ebb77485d7f899feb37486d666389597b6b90927", "git_parents": ["b66b1854a46d5cf6a42c5f98d3675ac208ce1830"], "node": "da12d7f307d4d6f85f9d9aca8e95c5a4da9a3c73", "parents": ["76287ba2aa8ba852ba8e72537671c5b3f035e3ed"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2066271 - Persist install referral code after initial ping in Debug Drawer r=android-reviewers,cbect,Roger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321096\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/ReferralAttribution.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/distributions/DistributionTools.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/InstallReferrerWorkerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/ReferralAttributionTest.kt"], "git_node": "17449997884f9c894472f4bf02c9357e7fb9ff52", "git_parents": ["ebb77485d7f899feb37486d666389597b6b90927"], "node": "98776697eca4f9d5f16be9a39f829827225bf1ce", "parents": ["da12d7f307d4d6f85f9d9aca8e95c5a4da9a3c73"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059763 - Ensure current device is  excluded from the fxa menu's connected devices list. r=skhamis,nsharpley,sync-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319643\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser_sync.js"], "git_node": "286e4b5eb02dd0b2a091d097e6bba3f535891ac3", "git_parents": ["17449997884f9c894472f4bf02c9357e7fb9ff52"], "node": "17a8042b446c1d4d5c2ce8216f26e10377f3ad8e", "parents": ["98776697eca4f9d5f16be9a39f829827225bf1ce"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062212 - Enable new tab search bar in Nightly. r=mbeier\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321017\n", "files": ["browser/app/profile/firefox.js"], "git_node": "59854278ebabe56131e45369b6a8e018db790d7c", "git_parents": ["286e4b5eb02dd0b2a091d097e6bba3f535891ac3"], "node": "70ae344e0fd37807d3806e937d9ea8490045fbbf", "parents": ["17a8042b446c1d4d5c2ce8216f26e10377f3ad8e"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2066694 - Silence clang 23 -Wunused-template in vendored abseil-cpp r=webrtc-reviewers,sandbox-reviewers,bobowen,bwc\n\nclang 23 enables -Wunused-template by default, which fires on the vendored\nabseil sources:\n\n    third_party/abseil-cpp/absl/strings/internal/str_format/float_conversion.cc:1146:6:\n    error: unused function template 'RoundUp' [-Werror,-Wunused-template]\n\nAdd -Wno-unused-template next to the existing -Wno-comma suppression in\nabsl.gni (and to the abseil gn config's mozilla_flags, plus the generated\nmoz.build files). security/sandbox also compiles a subset of the abseil\nsources directly with our own warning flags, so float_conversion.cc needs\nthe per-file flag there too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321474\n", "files": ["dom/media/webrtc/third_party_build/gn-configs/abseil.json", "security/sandbox/linux/moz.build", "security/sandbox/moz.build", "third_party/abseil-cpp/absl.gni", "third_party/abseil-cpp/absl/base/base_gn/moz.build", "third_party/abseil-cpp/absl/base/cpu_detect_gn/moz.build", "third_party/abseil-cpp/absl/base/hardening_gn/moz.build", "third_party/abseil-cpp/absl/base/log_severity_gn/moz.build", "third_party/abseil-cpp/absl/base/malloc_internal_gn/moz.build", "third_party/abseil-cpp/absl/base/raw_logging_internal_gn/moz.build", "third_party/abseil-cpp/absl/base/spinlock_wait_gn/moz.build", "third_party/abseil-cpp/absl/base/strerror_gn/moz.build", "third_party/abseil-cpp/absl/base/throw_delegate_gn/moz.build", "third_party/abseil-cpp/absl/base/tracing_internal_gn/moz.build", "third_party/abseil-cpp/absl/container/hashtablez_sampler_gn/moz.build", "third_party/abseil-cpp/absl/container/raw_hash_set_gn/moz.build", "third_party/abseil-cpp/absl/crc/crc32c_gn/moz.build", "third_party/abseil-cpp/absl/crc/crc_cord_state_gn/moz.build", "third_party/abseil-cpp/absl/crc/crc_internal_gn/moz.build", "third_party/abseil-cpp/absl/debugging/debugging_internal_gn/m