ement/manual/draw-element-image/privacy/pseudos/marker-visited-link-currentcolor-ignored.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/visited-link-slotted-color-ignored.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/visited-link-svg-use-outside-subtree-ignored.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/visited-link/visited-link-slotted-color-ignored.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/visited-link/visited-link-svg-use-outside-subtree-ignored.tentative.html.ini"], "git_node": "89fb958e3e7e5eb73f5b29dd27afac5dcf01470d", "git_parents": ["9accef9e3541732b75500007b0bf8ac93f9d4d62"], "node": "e123e75dec62b679c7f26fd9e58ece7bf7394787", "parents": ["9e71f365c4a65ca6c0152632286a7763835c2596"], "tags": []}, {"author": "Navoda Munasinha \u003cnavoda.munasinha@codimite.com\u003e", "branch": "default", "desc": "Bug 2063597 [wpt PR 61936] - Editing: Report only deleted code points in getTargetRanges(), a=testonly\n\nAutomatic update from web-platform-tests\nEditing: Report only deleted code points in getTargetRanges()\n\ngetTargetRanges() on deleteContentBackward covered the whole grapheme\ncluster behind the caret, while Backspace deletes only a part of it.\nFor the Thai word \"\u0e17\u0e35\u0e48\" it reported all three code points although only\nU+0E48 was deleted.\n\nMove the narrowing that TypingCommand already does into\nediting_utilities as NarrowSelectionToBackwardDeletionUnit() and\nuse it for the reported range too, so both are computed the same way.\n\nFixed: 539754135\nChange-Id: I64cca87d84abb3e40fc618ebe6db38672f42784a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8192494\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Kent Tamura \u003ctkent@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681902}\n\n--\n\nwpt-commits: 04067ce9c7c2165e71ad7d0dde10a4c5cb394a83\nwpt-pr: 61936\n", "files": ["testing/web-platform/tests/input-events/input-events-get-target-ranges-backspace.tentative.html"], "git_node": "12bc7ebde9100b1fcc32abce39b9e62c3ec55134", "git_parents": ["89fb958e3e7e5eb73f5b29dd27afac5dcf01470d"], "node": "1bd09378e284b03842fa9ab63e27fbef77598d3d", "parents": ["e123e75dec62b679c7f26fd9e58ece7bf7394787"], "tags": []}, {"author": "Joone Hur \u003cjoonehur@microsoft.com\u003e", "branch": "default", "desc": "Bug 2064610 [wpt PR 62033] - Add Blink support for DownloadURL-list drag type, a=testonly\n\nAutomatic update from web-platform-tests\nAdd Blink support for DownloadURL-list drag type\n\nDefine the DownloadURL-list drag type and the DragAndDropDownloadURLList\nBlink runtime feature.\n\nTreat DownloadURL-list as a drag-only format and exclude it from custom\nclipboard data.\n\nBrowser-side parsing and multi-download execution will be added in\nfollow-up changes.\n\nTest: third_party/blink/tools/run_web_tests.py -t release_x64 external/wpt/clipboard-apis/downloadurl-list-custom-clipboard-data.tentative.https.html\nBug: 40736398\nChange-Id: Idbcb56195f88e03b5a9fbe87a9752774f0bc6719\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8260186\nReviewed-by: Dan Clark \u003cdaniec@microsoft.com\u003e\nCommit-Queue: Joone Hur \u003cjoonehur@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1681954}\n\n--\n\nwpt-commits: 782f4cab99004be5fb81ba45d5b06804ce8a5dec\nwpt-pr: 62033\n", "files": ["testing/web-platform/tests/clipboard-apis/downloadurl-list-custom-clipboard-data.tentative.https.html"], "git_node": "524a2932b2f6fcfe48d338e246d7536a8316cc02", "git_parents": ["12bc7ebde9100b1fcc32abce39b9e62c3ec55134"], "node": "cbee54feb8eb29d6ab351c73eee36495c7c84aaf", "parents": ["1bd09378e284b03842fa9ab63e27fbef77598d3d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064610 [wpt PR 62033] - Update wpt metadata, a=testonly\n\nwpt-pr: 62033\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/clipboard-apis/async-unsanitized-plaintext-formats-write-read.tentative.https.html.ini", "testing/web-platform/meta/clipboard-apis/clipboard-copy-selection-line-break.https.html.ini", "testing/web-platform/meta/clipboard-apis/downloadurl-list-custom-clipboard-data.tentative.https.html.ini"], "git_node": "abb7ce812d0f93d93f7da3400edd722817a3ed1a", "git_parents": ["524a2932b2f6fcfe48d338e246d7536a8316cc02"], "node": "566f90f3b7edd6d8f4f1d6bc2f13d0eb245a4ce2", "parents": ["cbee54feb8eb29d6ab351c73eee36495c7c84aaf"], "tags": []}, {"author": "Seokho Song \u003cseokho@chromium.org\u003e", "branch": "default", "desc": "Bug 2064391 [wpt PR 62015] - Add ContainerQueryList.query and support query lists, a=testonly\n\nAutomatic update from web-platform-tests\nAdd ContainerQueryList.query and support query lists\n\nElement.matchContainer() previously parsed its argument as a single\n\u003ccontainer-condition\u003e.\n\nPer the spec PR below, the argument is now parsed as a\n\u003ccontainer-query-list\u003e, a comma-separated list of\n\u003ccontainer-condition\u003es. ContainerQueryList holds the parsed\nContainerQuerySet instead of a single ContainerQuery and matches when\nany query in the list matches, resolving the query container for each\nquery individually.\n\nAlso expose a readonly \"query\" attribute on ContainerQueryList that\nreturns the serialization of the parsed container query list.\n\nRemove ResolveContainer function that already calculated same thing in\nEvalAndAdd function.\n\nSpec PR: https://github.com/w3c/csswg-drafts/pull/13551\n\nBug: 40887402\nChange-Id: I50903a651baa32d5aed3ba1d08c5eba5dfb73175\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8142321\nReviewed-by: Anders Hartvoll Ruud \u003candruud@chromium.org\u003e\nCommit-Queue: Seokho Song \u003cseokho@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1681983}\n\n--\n\nwpt-commits: 550efd4a2f1f14877d424b5668fbb6e63d5f6165\nwpt-pr: 62015\n", "files": ["testing/web-platform/tests/css/css-conditional/match-container.tentative.html"], "git_node": "c055b84a891d26be643571e497dad8c65b65bdb9", "git_parents": ["abb7ce812d0f93d93f7da3400edd722817a3ed1a"], "node": "3f06b1e027eca6548f9b9425ac73af742dfcedf2", "parents": ["566f90f3b7edd6d8f4f1d6bc2f13d0eb245a4ce2"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064391 [wpt PR 62015] - Update wpt metadata, a=testonly\n\nwpt-pr: 62015\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-conditional/match-container.tentative.html.ini"], "git_node": "780e5c02d08ae27dd6f28fc97ec6281a637cb793", "git_parents": ["c055b84a891d26be643571e497dad8c65b65bdb9"], "node": "15aff1894a292c3c9e9239d8b1f84106f5dec34c", "parents": ["3f06b1e027eca6548f9b9425ac73af742dfcedf2"], "tags": []}, {"author": "Hyowon Kim \u003chyowon@igalia.com\u003e", "branch": "default", "desc": "Bug 2064675 [wpt PR 62039] - Migrate MSE endofstream-invaliderror tests to WPT, a=testonly\n\nAutomatic update from web-platform-tests\nMigrate MSE endofstream-invaliderror tests to WPT\n\nAdd InvalidStateError cases for endOfStream()/(\"decode\")/(\"network\")\nwhen readyState is already \"ended\" to external/wpt/media-source/.\n\nBug: 485677942\nChange-Id: I6be781059f1fc9cfb69663faa987a1955fe84e9a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8129277\nReviewed-by: Brian Sheedy \u003cbsheedy@chromium.org\u003e\nCommit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1682039}\n\n--\n\nwpt-commits: 6f80c1d4fe8c4e5e2d7d1c5444062a44a50ad6f5\nwpt-pr: 62039\n", "files": ["testing/web-platform/tests/media-source/mediasource-endofstream-invaliderror.html"], "git_node": "f45149c449059ebf72600fa41475a5264966b399", "git_parents": ["780e5c02d08ae27dd6f28fc97ec6281a637cb793"], "node": "1007a104c3fbfdbddaffc4d95af2c71081801a91", "parents": ["15aff1894a292c3c9e9239d8b1f84106f5dec34c"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2064443 [wpt PR 62020] - Test parser insertions into a Document that script left non-empty, a=testonly\n\nAutomatic update from web-platform-tests\nTest parser insertions into a Document that script left non-empty\n\ndocument.open() empties the Document and returns the parser to the \"initial\"\ninsertion mode, so script can add children before the next document.write(). The\nDOCTYPE token and the \"html\" start tag then append directly to the Document, which\nthe DOM does not allow when it already has a doctype child or an element child, so\nthose nodes have to be dropped on the floor.\n\nSee https://github.com/whatwg/html/pull/12708 for context.\n--\n\nwpt-commits: 0223c368b7231439182d15744db306e48834b966\nwpt-pr: 62020\n", "files": ["testing/web-platform/tests/html/syntax/parsing/insert-into-nonempty-document.html"], "git_node": "6e7f0d735c8074f661719cd161f3c4b9dfd94f18", "git_parents": ["f45149c449059ebf72600fa41475a5264966b399"], "node": "39861bb670b8638aa490cd1bc0c51b6ff6189def", "parents": ["1007a104c3fbfdbddaffc4d95af2c71081801a91"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064443 [wpt PR 62020] - Update wpt metadata, a=testonly\n\nwpt-pr: 62020\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/syntax/parsing/insert-into-nonempty-document.html.ini"], "git_node": "bfbef1a1185a3f1cd134c60a93000db7d9e14869", "git_parents": ["6e7f0d735c8074f661719cd161f3c4b9dfd94f18"], "node": "f047a0c497338d3acf370b1ea2989499129d77f9", "parents": ["39861bb670b8638aa490cd1bc0c51b6ff6189def"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2063801 [wpt PR 61965] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321526, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=321526 (#61965)\n--\n\nwpt-commits: f138075ae3c27ab7958c102f8c0567c64f298fc2\nwpt-pr: 61965\n", "files": ["testing/web-platform/tests/navigation-api/navigate-event/navigate-multiple-nested-navigateerror.html"], "git_node": "0e6fc79a9c0898753e181613aadd81fd517189c7", "git_parents": ["bfbef1a1185a3f1cd134c60a93000db7d9e14869"], "node": "403ca6a7d85c66309e2a1e05cbe8a0d32c5ad7c4", "parents": ["f047a0c497338d3acf370b1ea2989499129d77f9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064761 - [wpt-sync] Update web-platform-tests to f138075ae3c27ab7958c102f8c0567c64f298fc2, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: f138075ae3c27ab7958c102f8c0567c64f298fc2\nwpt-type: landing\n", "files": ["testing/web-platform/meta/clipboard-apis/clipboard-copy-selection-line-break.https.html.ini", "testing/web-platform/meta/compute-pressure/compute_pressure_timestamp_continuously_increasing.https.window.js.ini", "testing/web-platform/meta/cookiestore/cookieStore_get_arguments.https.any.js.ini", "testing/web-platform/meta/cookiestore/cookieStore_set_arguments.https.any.js.ini", "testing/web-platform/meta/css/css-conditional/container-queries/whitespace-update-after-removal.html.ini", "testing/web-platform/meta/css/css-navigation/tentative/parsing/location-valid.html.ini", "testing/web-platform/meta/css/css-text/text-transform/text-transform-upperlower-108.html.ini", "testing/web-platform/meta/document-picture-in-picture/requires-width-and-height-to-both-be-specified.https.html.ini", "testing/web-platform/meta/dom/events/scrolling/scrollend-event-fires-for-repeat-key-ending-after-scroll-container-end-is-reached.html.ini", "testing/web-platform/meta/encoding/legacy-mb-japanese/iso-2022-jp/iso2022jp-decode-csiso2022jp.html.in