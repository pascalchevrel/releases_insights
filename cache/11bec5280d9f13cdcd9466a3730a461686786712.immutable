r/components/tabbrowser/content/tab-context-menu.js"], "git_node": "6ef1a7f9ecc016781d0c3a80e68a62e8b3d155d8", "git_parents": ["368f27b5c27b7a8ca24ea02687dd07ef7cbc224b"], "node": "0f9a4a129102050f12da5d964ccf22d7615e5b1a", "parents": ["510e86e72ee66f9a35009f510d4136b0f27db9f1"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063946 - More glean events for the Containers UI - part 5 - Places r=places-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318993\n", "files": ["browser/base/content/main-popupset.js", "browser/components/places/PlacesUIUtils.sys.mjs", "browser/components/places/tests/browser/browser_library_container_menu.js"], "git_node": "dd9ab3b38b043f2c7704dc379a05ce15a811e4fc", "git_parents": ["6ef1a7f9ecc016781d0c3a80e68a62e8b3d155d8"], "node": "53bafa233fb0c9fe8bd8a2e5a7d2690073b25f9a", "parents": ["0f9a4a129102050f12da5d964ccf22d7615e5b1a"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063946 - More glean events for the Containers UI - part 6 - Bookmarks r=sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318994\n", "files": ["browser/components/sidebar/sidebar-bookmarks.mjs", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar_glean.js"], "git_node": "99838687577731f7c088be1abc2e09642fc49173", "git_parents": ["dd9ab3b38b043f2c7704dc379a05ce15a811e4fc"], "node": "3c327730126356c2dee632151ce116d3dc81476f", "parents": ["53bafa233fb0c9fe8bd8a2e5a7d2690073b25f9a"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063946 - More glean events for the Containers UI - part 7 - Sync tabs menu r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318995\n", "files": ["browser/base/content/main-popupset.js", "browser/components/syncedtabs/TabListView.sys.mjs", "browser/components/syncedtabs/test/browser/browser_sidebar_syncedtabslist.js"], "git_node": "eef63a9e957551e2cad9cca45c6d9deec84177a2", "git_parents": ["99838687577731f7c088be1abc2e09642fc49173"], "node": "6e726dfa9f1d43b7390fba6a8674b4fd6c5fde31", "parents": ["3c327730126356c2dee632151ce116d3dc81476f"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063946 - More glean events for the Containers UI - part 8 - URLBar r=urlbar-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318996\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js"], "git_node": "1276332aa825abe41c79f892f71848cc44870797", "git_parents": ["eef63a9e957551e2cad9cca45c6d9deec84177a2"], "node": "8bbad11b4734c76a3980bfe4dd8103aa467c022e", "parents": ["6e726dfa9f1d43b7390fba6a8674b4fd6c5fde31"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065222 - Import UrlbarContentUtils as a namespace in the Urlbar actor. r=mbeier\n\n`ChromeUtils.defineESModuleGetters` resolves an export named for its key, and the module exports only individual functions, so `lazy.UrlbarContentUtils` was undefined and every handler on the actor port threw on first use. Only an unprivileged `\u003cmoz-urlbar\u003e` reaches those handlers, so nothing in tree calls them yet; making the message-path pref reach them is the rest of this bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320212\n", "files": ["browser/actors/UrlbarChild.sys.mjs"], "git_node": "0e27f40679c36354e8a76b45c8aa54a8f6112bba", "git_parents": ["1276332aa825abe41c79f892f71848cc44870797"], "node": "56d9cdc8abad5722e0cb276df53a0dda8c2caf75", "parents": ["8bbad11b4734c76a3980bfe4dd8103aa467c022e"], "tags": []}, {"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060047. r=gfx-reviewers,lsalzman,ErichDonGubler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319639\n", "files": ["gfx/ipc/CanvasManagerParent.cpp"], "git_node": "17df8e4ffb17f0f0b1aab01a93c72bd4f68b7f5e", "git_parents": ["0e27f40679c36354e8a76b45c8aa54a8f6112bba"], "node": "18c10d672f5d0635c0d3170ca89d65df668d81ec", "parents": ["56d9cdc8abad5722e0cb276df53a0dda8c2caf75"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057118 - Add a gtest for picture-rectangle handling when building a video frame. r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314548\n", "files": ["dom/media/gtest/TestVideoData.cpp"], "git_node": "89ff75ffe77dde6697e52fab34ec50cd3dc1ae11", "git_parents": ["17df8e4ffb17f0f0b1aab01a93c72bd4f68b7f5e"], "node": "ed58a1167bb6bef8e3fd99668a169799a61d86fa", "parents": ["18c10d672f5d0635c0d3170ca89d65df668d81ec"], "tags": []}, {"author": "Chun-Min Chang \u003ccchang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050150 - Require an NV12 destination stride that can hold a chroma row. r=media-playback-reviewers,alwu\n\nAn interleaved chroma row is 2 * ceil(width / 2) bytes, so a stride equal to the\nwidth is not wide enough at odd widths, and nothing downstream checks it.\n\nWidening the chroma stride instead would not work: Media Foundation shares one\npitch between both planes and MF_MT_DEFAULT_STRIDE is never set, so the pitch is\ninferred from the width and a wider chroma stride would be read as a sheared\npicture.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317994\n", "files": ["dom/media/ImageConversion.cpp", "dom/media/ImageConversion.h"], "git_node": "11398bfa55c51aa4369a8b2cc1318ef76ca2b083", "git_parents": ["89ff75ffe77dde6697e52fab34ec50cd3dc1ae11"], "node": "b124a08307ed9a0e4ea7ade42bb39a2291f4854c", "parents": ["ed58a1167bb6bef8e3fd99668a169799a61d86fa"], "tags": []}, {"author": "Chun-Min Chang \u003ccchang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050150 - Decline odd-width configs in the WMF encoder module. r=media-playback-reviewers,padenot\n\nRefusing inside ConvertToNV12 fails the encode per frame with no fallback.\nDeclining the config instead lets PEMFactory reach ffvpx, so VP8 and VP9 -- which\ncan express an odd width -- keep working in software. H.264 cannot express one\nand is already declined by CanLikelyEncode.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317995\n", "files": ["dom/media/platforms/wmf/WMFDataEncoderUtils.cpp", "dom/media/platforms/wmf/WMFDataEncoderUtils.h", "dom/media/platforms/wmf/WMFEncoderModule.cpp"], "git_node": "cc4b52c57717d77bc50976eef8283764920412fa", "git_parents": ["11398bfa55c51aa4369a8b2cc1318ef76ca2b083"], "node": "eab41c0e0604224943637e4d4f51532ff7c10040", "parents": ["b124a08307ed9a0e4ea7ade42bb39a2291f4854c"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064969 - Extend probe expiration dates to Fx 169: browser.searchinit.*_opensearch_*. r=search-reviewers,Standard8\" for causing python failures in test_no_expired_probes.py\n\nThis reverts commit 5b14a0e0b22f9195016d1dc477c3d645c6d8719f.\n", "files": ["toolkit/components/search/metrics.yaml"], "git_node": "3a1fc60d8edf691392b882f8550121befecc7839", "git_parents": ["cc4b52c57717d77bc50976eef8283764920412fa"], "node": "1402c4b09d2d397e47c7f4dd9408595ff5879ab7", "parents": ["eab41c0e0604224943637e4d4f51532ff7c10040"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064969 - Extend probe expiration dates to Fx 169: browser.searchinit.*_opensearch_*. r=search-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320203\n", "files": ["toolkit/components/search/metrics.yaml"], "git_node": "07c2e1400a61fcd53be27651e9ce3c85863d8c68", "git_parents": ["3a1fc60d8edf691392b882f8550121befecc7839"], "node": "09966cd20d8cd997f6f2fe26a6d9a4ffcd3fe9ca", "parents": ["1402c4b09d2d397e47c7f4dd9408595ff5879ab7"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052266 - Add send to device button to share panel r=niklas,fluent-reviewers,desktop-theme-reviewers,dao,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318391\n", "files": ["browser/base/content/browser-sync.js", "browser/components/sharing/SharePageAction.sys.mjs", "browser/components/sharing/SharingUtils.sys.mjs", "browser/components/sharing/tests/browser/browser.toml", "browser/components/sharing/tests/browser/browser_testSharePanelSendToDevice.js", "browser/locales/en-US/browser/sharePanel.ftl", "browser/themes/shared/sharePanel.css"], "git_node": "ef2fe192ed496c6bcfe7577cc17861bbf2d89f46", "git_parents": ["07c2e1400a61fcd53be27651e9ce3c85863d8c68"], "node": "5d7b245535e340cbff091fa550ed5356ed9d7d20", "parents": ["09966cd20d8cd997f6f2fe26a6d9a4ffcd3fe9ca"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064410 - restore full AITab schema for user testing r=cdipersio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319484\n", "files": ["browser/components/aiwindow/models/aitab/component_schema.json"], "git_node": "33eccf9aece491cda60615264b9b6a16ba02548f", "git_parents": ["ef2fe192ed496c6bcfe7577cc17861bbf2d89f46"], "node": "9c5b6561d4a8ecc7f0db6c9b513595cd9aa45c77", "parents": ["5d7b245535e340cbff091fa550ed5356ed9d7d20"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2062812 - Drop virtual from nsIWidget::(Start|Stop)AsyncAutoscroll. r=hiro\n\nStartAsyncAutoscroll and StopAsyncAutoscroll don't have to be virtual.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320260\n", "files": ["widget/nsIWidget.h"], "git_node": "ee4e4cae921db44e39e5d4a1392a550acce21fdc", "git_parents": ["33eccf9aece491cda60615264b9b6a16ba02548f"], "node": "24ecff047496162f92475d8dcdd1da275c85a088", "parents": ["9c5b6561d4a8ecc7f0db6c9b513595cd9aa45c77"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062184 - Re-enable tests in browser/components/extensions/test/browser whose skip conditions try shows are no longer needed, r=extension-reviewers,robwu.\n\nThe conditions removed here either passed on try with every flakiness annotation\nin this folder removed, or name Windows versions that no longer run\nbrowser-chrome.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317512\n", "files": ["browser/components/extensions/test/browser/browser-contentscript.toml", "browser/components/extensions/test/browser/browser-tabs.toml", "browser/components/extensions/test/browser/browser-tabstrip.toml", "browser/components/extensions/test/browser/browser-windows.toml"], "git_node": "e61b29877b9397117338935fb6d16cf9a5030d51", "git_parents": ["ee4e4cae921db44e39e5d4a1392a550acce21fdc"], "node": "4ae385458c96eeefdc9a5b1203a0f29a10e1150d", "parents": ["24ecff047496162f92475d8dcdd1da275c85a088"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062184 - Re-enable five tests on macOS 15.30 aarch64, r=extension-reviewers,robwu.\n\nNone of these five conditions came out of an investigation. The three \"bleedover\"\nones claim the tests pass in \"failures\" jobs, but nothing consumes the bleedover\ntag, --run-failures matches skip-if text rather than tags, and mac has had no\nbrowser-chrome failures job since 2021. The other two were added by a macOS 15.30\ngreenup that recorded no data, labelled with each test's per-file tracking bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318264\n", "files": ["browser/components/extensions/test/browser/browser-action.toml", "browser/components/extensions/test/browser/browser-menus.toml"], "git_node": "7d7790f73b385075f0be0bca7b591aab522c3107", "git_parents": ["e61b29877b9397117338935fb6d16cf9a5030d51"], "node": "fe123a07922592931821567fd3afa6989d21d594", "parents": ["4ae385458c96eeefdc9a5b1203a0f29a10e1150d"], "tags": []}, {"author": "Stephen King \u003csking@thunderbird.net\u003e", "branch": "default", "desc": "Bug 2064906 - Add optional update_clobber_file to landoscript schemas. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nThis allows the clobber file to be optional for all lando-script merge\nautomation tasks.\n\nThis is particularly helpful for Thunderbird, which has no clobber file\nbut uses these merge automation actions\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319934\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "84078c5ebd3676bfaaf082eb21fe94eb5b503b35", "git_parents": ["7d7790f73b385075f0be0bca7b591aab522c3107"], "node": "01cd3782828280d6ca868c0f7d3e9574276089e7", "parents": ["fe123a07922592931821567fd3afa6989d21d594"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057458 - Remove assertion that depends on marking only a single object for testing r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316392\n", "files": ["js/src/gc/GC.cpp", "js/src/jit-test/tests/gc/bug2057458.js"], "git_node": "23949aa423637291ac60cad61f151b9c7fc60581", "git_parents": ["84078c5ebd3676bfaaf082eb21fe94eb5b503b35"], "node": "28ecdf29256792788d98b29dcf88b43a4736f105", "parents": ["01cd3782828280d6ca868c0f7d3e9574276089e7"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065011 - Add the Recent Searches widget scaffold r=fluent-reviewers,bolsson,Dre\n\nAdd the Recent Searches widget scaffold, using the same registry-based pattern\nas the other New Tab widgets: an empty card with a context menu (change size,\nmove, hide, learn more) and an enable toggle in the Customize Panel and\nabout:preferences#home. It's off by default until the widget prefs are turned\non.\n\nA stubbed RecentSearchesFeed broadcasts an empty result set so the parent to\ncontent data path is wired end to end.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320079\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.jsx", "browser/extensions/newtab/content-src/components/Widgets/RecentSearches/RecentSearches.jsx", "browser/extensions/newtab/content-src/components/Widgets/RecentSearches/_RecentSearches.scss", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetsComponentRegistry.jsx", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/lib/AboutPreferences.sys.mjs", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/Widgets/RecentSearchesFeed.sys.mjs", "browser/extensions/newtab/test/jest/common/Reducers.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/RecentSearches.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/Widgets.test.jsx", "browser/extensions/newtab/test/xpcshell/test_RecentSearchesFeed.js", "browser/extensions/newtab/test/xpcshell/xpcshell.toml", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "c4794c7a7e68a36a2e9b1f909da59a4c603fe236", "git_parents": ["23949aa423637291ac60cad61f151b9c7fc60581"], "node": "60aea006d7c56738839e44abe49e17ce520b6ebb", "parents": ["28ecdf29256792788d98b29dcf88b43a4736f105"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063024 - Add a onnxruntime native availability telemetry probe r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318531\n", "files": ["browser/app/profile/firefox.js", "browser/components/BrowserComponents.manifest", "testing/profiles/base/user.js", "toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/metrics.yaml", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_native_ort_availability_probe.js"], "git_node": "0152245041eb23eb3808bb376f7a063b7cd685f8", "git_parents": ["c4794c7a7e68a36a2e9b1f909da59a4c603fe236"], "node": "f549ad79e0eacdd985c04ffb96ec4c106c10185f", "parents": ["60aea006d7c56738839e44abe49e17ce520b6ebb"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060764 part 1: Make PDocAccessible managed by PWindowGlobal instead of PBrowser. r=eeejay,nika\n\nA PDocAccessible is tied to a single DOM document only.\nConversely, PBrowser encompasses an entire document tree within a content process; i.e. a tab and all its in-process iframes, or an OOP iframe and all its nested in-process iframes.\nTherefore, it is a better fit for PDocAccessible to be managed by PWindowGlobal, which is also associated one to one with a single DOM document.\n\nThis patch largely moves code and changes calls in order to switch to the new manager.\nHowever, there are a few noteworthy changes:\n\n1. PDocAccessible's constructor no longer takes a BrowsingContext.\n  This isn't necessary now because a PWindowGlobal is associated with a single BrowsingContext, so we can get the BrowsingContext from there.\n2. Use Manager() in DocAccessibleParent::RecvPrinting to get the window context, rather than going via the BrowsingContext.\n  Now that PDocAccessible is managed by PWindowGlobal, we don't need the indirection, and going directly is more precise.\n3. Remove handling for the case that the manager is being destroyed in RecvPDocAccessibleConstructor.\n  Unlike BrowserParent, WindowGlobalParent doesn't have an intermediate \"destroying\" state.\n  it's either alive or it isn't, and if it isn't, it can't receive IPDL messages.\n4. In RecvPDocAccessibleConstructor, change the code which cleans up a previous top level DocAccessibleParent so that it walks the BrowsingContext's WindowContexts rather than using BrowserParent::GetTopLevelDocAccessible.\n  Because DOM keeps the current WindowContext up to date and PDocAccessible is tied to WindowContext, GetTopLevelDocAccessible now only always returns the current top level actor, so it would return null in this case and the previous top level actor wouldn't be found, making the previous code a no-op.\n  This code is now only necessary for Android because Android strictly requires that there only be a single top level DocAccessibleParent at any given time.\n5. Clear any queued cache updates on DocAccessible when a DocAccessibleChild is prematurely destroyed.\n  Previously, this couldn't happen because PBrowser lives for the life of the tab or OOP iframe.\n  In contrast, PWindowGlobal's lifetime ends with its document.\n  That means that if the document is being torn down, the actor will be too, and that sometimes happens a little before the DocAccessible is shut down.\n6. Previously, BrowserBridgeParent::RecvSetEmbedderAccessible compared the manager of the parent doc and the child doc.\n  It can't do that any more because two DocAccessibleParents will now always have different managers.\n7. BrowserParent::GetTopLevelDocAccessible has been significantly rewritten for the new actor relationship, since it no longer has to deal with a single actor managing multiple PDocAccessibles.\n8. BrowserParent::Destroy no longer destroys the top level DocAccessibleParent.\n  BrowserParent doesn't own DocAccessibleParent any more, so we leave this to WindowGlobalParent actor teardown.\n  Also, by the time Browserparent::Destroy is called, there might not even be a current WindowGlobal any more, which means we couldn't get the DocAccessibleParent anyway.\n9. Changed various checks of IsTopLevelInContentProcess to assertions, since this is now inherently true because we get the precise WindowGlobalParent we are interested in and a PWindowGlobal only manages one PDocAccessible.\n10. A PWindowGlobal should only ever have a single PDocAccessible.\n  We enforce that in RecvPDocAccessibleConstructor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318677\n", "files": ["accessible/android/SessionAccessibility.cpp", "accessible/base/FocusManager.cpp", "accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "accessible/ipc/PDocAccessible.ipdl", "accessible/ipc/RemoteAccessible.cpp", "accessible/pdf/PdfStructTreeBuilder.cpp", "accessible/xul/XULComboboxAccessible.cpp", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/PBrowser.ipdl", "dom/ipc/PWindowGlobal.ipdl", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalChild.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/ipc/moz.build"], "git_node": "99640d30438827e5d4c9546d25cd22f04ae5dc43", "git_parents": ["0152245041eb23eb3808bb376f7a063b7cd685f8"], "node": "8659d918f1535a97f844db42d8c71372cbdc9197", "parents": ["f549ad79e0eacdd985c04ffb96ec4c106c10185f"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060764 part 2: Ensure the correct same-process embedder when adding a child doc. r=eeejay,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318678\n", "files": ["accessible/ipc/DocAccessibleParent.cpp"], "git_node": "f5254a4541c389f91524bbbde0655563c6c69bb9", "git_parents": ["99640d30438827e5d4c9546d25cd22f04ae5dc43"], "node": "e0a5b4bb7673b9b305d2664ad35326b35234f6c1", "parents": ["8659d918f1535a97f844db42d8c71372cbdc9197"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060764 part 3: Remove parent document argument to PDocAccessible constructor and PBrowserBridge::SetEmbedderAccessible. r=eeejay,nika\n\nWe can now get the parent document using the PWindowGlobal tree instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319427\n", "files": ["accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp", "accessible/generic/OuterDocAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "dom/ipc/BrowserBridgeChild.h", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserBridgeParent.h", "dom/ipc/PBrowserBridge.ipdl", "dom/ipc/PWindowGlobal.ipdl", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalChild.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h"], "git_node": "8aa5c4642a70765a93a071a98b5a40ba09c6d9a4", "git_parents": ["f5254a4541c389f91524bbbde0655563c6c69bb9"], "node": "1971d0cf8ca4539a54a14017e654abf50eea8ec3", "parents": ["e0a5b4bb7673b9b305d2664ad35326b35234f6c1"], "tags": []}, {"author": "Exploding Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 2059911 - Clean up unused XUL label @value text leaf code r=accessibility-platform-reviewers,Jamie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319868\n", "files": ["accessible/base/nsAccessibilityService.cpp", "accessible/base/nsAccessibilityService.h", "accessible/xul/XULElementAccessibles.cpp", "accessible/xul/XULElementAccessibles.h"], "git_node": "4fcf47b00c17c6fe8714d3467714ea393119761f", "git_parents": ["8aa5c4642a70765a93a071a98b5a40ba09c6d9a4"], "node": "e4a23e4337ebbd79437ef2100b0897ee81580a8a", "parents": ["1971d0cf8ca4539a54a14017e654abf50eea8ec3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065136 - SVG text shouldn't allow generated content. r=dshin\n\nRestores pre-regression and interoperable behavior.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/342\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "testing/web-platform/tests/svg/text/crashtests/abspos-pseudo.html"], "git_node": "b9537570d78577ed7f170bd85395c1034bb5ec76", "git_parents": ["4fcf47b00c17c6fe8714d3467714ea393119761f"], "node": "eb12e80b6c5cd8340aa47bf40131e062bb95907f", "parents": ["e4a23e4337ebbd79437ef2100b0897ee81580a8a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2064683 - Remove CHROME_SCROLLBARS. r=dom-core-reviewers,sthompson,smaug,firefox-desktop-core-reviewers ,layout-reviewers,mkennedy,mossop,dshin,robwu,dholbert\n\nContent can't set it anymore (CHROME_MINIMAL_POPUP includes the bit).\n\nWe only override it for the gfx sanity check, but that doesn't need it\n(it doesn't overflow anyway).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319752\n", "files": ["browser/base/content/browser-profiles.js", "browser/base/content/browser.js", "browser/components/BrowserGlue.sys.mjs", "browser/components/preferences/main.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_nonbrowser.js", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser_495495.js", "browser/components/sessionstore/test/browser_restored_window_features.js", "browser/components/sessionstore/test/marionette/session_store_test_case.py", "browser/components/taskbartabs/TaskbarTabsWindowManager.sys.mjs", "docshell/test/chrome/test_bug321671.xhtml", "docshell/test/chrome/test_bug360511.xhtml", "docshell/test/navigation/test_bug430723.html", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/ipc/BrowserChild.cpp", "editor/libeditor/tests/test_bug586662.html", "layout/generic/test/test_bug514732-2.xhtml", "toolkit/components/browser/nsIWebBrowserChrome.idl", "toolkit/components/extensions/parent/ext-identity.js", "toolkit/components/gfx/SanityTest.sys.mjs", "toolkit/components/windowwatcher/nsWindowWatcher.cpp", "toolkit/components/windowwatcher/test/browser_new_content_window_chromeflags.js", "toolkit/components/windowwatcher/test/head.js", "widget/android/nsWindow.cpp", "widget/uikit/nsWindow.mm", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/AppWindow.h"], "git_node": "deb01f2848cade29e74c8b291400758b312b8a88", "git_parents": ["b9537570d78577ed7f170bd85395c1034bb5ec76"], "node": "f19e7bcd82a13a27da6426f000ba3e4289f8481a", "parents": ["eb12e80b6c5cd8340aa47bf40131e062bb95907f"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063024 - Add a onnxruntime native availability telemetry probe r=nordzilla,ai-platform-reviewers\" for causing build bustages.\n\nThis reverts commit 0152245041eb23eb3808bb376f7a063b7cd685f8.\n", "files": ["browser/app/profile/firefox.js", "browser/components/BrowserComponents.manifest", "testing/profiles/base/user.js", "toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/metrics.yaml", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_native_ort_availability_probe.js"], "git_node": "3c30bfac13929906c2a83648391e51d300665c00", "git_parents": ["deb01f2848cade29e74c8b291400758b312b8a88"], "node": "9c2b75e7b6fb54df6c4037ae5aadad6183c3d970", "parents": ["f19e7bcd82a13a27da6426f000ba3e4289f8481a"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064149 - Opt the autocomplete popup into the design system panel border radius. r=dimi,desktop-theme-reviewers,Juliana\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319327\n", "files": ["browser/themes/shared/autocomplete.css"], "git_node": "e547f5a3129b5af9ea10560d5d5692f508f3758d", "git_parents": ["3c30bfac13929906c2a83648391e51d300665c00"], "node": "490c86439f64c2f9ba73dbfc364781179375ea95", "parents": ["9c2b75e7b6fb54df6c4037ae5aadad6183c3d970"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2062332 - Make MruCache 2-way associative. r=layout-reviewers,jfkthame\n\nSo that we can at least hold two elements at a time with the same high\nhash bits. Otherwise if you get unlucky you get trashing in reasonable\ntest-cases like the thai-reflow.html perftest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320099\n", "files": ["dom/canvas/CanvasRenderingContext2D.h", "gfx/thebes/FontPaletteCache.h", "gfx/thebes/gfxHarfBuzzShaper.h", "gfx/thebes/gfxTextRun.cpp", "intl/lwbrk/LineBreakCache.h", "layout/painting/nsImageRenderer.cpp", "mfbt/MruCache.h", "netwerk/dns/nsEffectiveTLDService.h", "xpcom/tests/gtest/TestMruCache.cpp"], "git_node": "64742f509393d6d1fa070658c750618c6c912a0b", "git_parents": ["e547f5a3129b5af9ea10560d5d5692f508f3758d"], "node": "24cbab93ec2b1e753458f7b4c9a0f50d55a868e5", "parents": ["490c86439f64c2f9ba73dbfc364781179375ea95"], "tags": []}, {"author": "Gregory Pappas \u003cgp3033@protonmail.com\u003e", "branch": "default", "desc": "Bug 1978211 - Remove layout.css.moz-broken.content.enabled pref r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D257929\n", "files": ["layout/reftests/bugs/315920-18d.html", "layout/reftests/bugs/315920-18g.html", "layout/reftests/bugs/reftest.list", "layout/reftests/image/reftest.list", "layout/tools/reftest/jar.mn", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/gecko/selector_parser.rs"], "git_node": "4113f017011792ae6e8d9cbe6f271957864c1b7c", "git_parents": ["64742f509393d6d1fa070658c750618c6c912a0b"], "node": "ca862b7f50e6a49edf2576b772a85ad9459d72ad", "parents": ["24cbab93ec2b1e753458f7b4c9a0f50d55a868e5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065068 - Remove media pseudo-clases pref. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320048\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "servo/components/style/gecko/selector_parser.rs", "testing/web-platform/meta/css/css-shadow/part/pseudo-classes-after-part.html.ini", "testing/web-platform/meta/css/selectors/invalidation/media-loading-pseudo-classes-in-has.sub.html.ini", "testing/web-platform/meta/css/selectors/invalidation/media-pseudo-classes-in-has.html.ini", "testing/web-platform/meta/css/selectors/media/sound-state.html.ini"], "git_node": "81f5e0e01c9694e0ed7ee75df8588fa5a7be0f10", "git_parents": ["4113f017011792ae6e8d9cbe6f271957864c1b7c"], "node": "10afbd0a0e1f2c6a20e8d9a38f6b170121eac950", "parents": ["ca862b7f50e6a49edf2576b772a85ad9459d72ad"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2063757 - Make `PresShell::CompleteMove` ignore native anonymous subtrees r=emilio,layout-reviewers\n\nThe content nodes in a UA shadow is not accessible via Selection API\neven though they are selectable by user's operation (e.g., dragging\ntext of the default `\u003csummary\u003e`). Therefore, `Selection::Modify` should\nnot move caret into UA shadow.\n\nWhen `Selection::Modify` cannot find next or previous line when the\namount is \"line\", it falls back to `PresShell::CompleteMove`. However,\n`PresShell::CompleteMove` allows to move selection into native anonymous\nsubtree even though the selection in them may not be managed by the\ndocument level selection.\n\nSo, `PresShell::CompleteMove` should call\n`nsIFrame::GetExtremeCaretPosition` with\n`nsIFrame::IGNORE_NATIVE_ANONYMOUS_SUBTREE`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320083\n", "files": ["dom/base/Selection.cpp", "layout/base/PresShell.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "testing/web-platform/tests/selection/crashtests/selection-modify-line-from-optgroup-in-video-to-details-without-summary.html"], "git_node": "d2037c5fc8ad5352af8fbc2ed23bbafcc0a534a1", "git_parents": ["81f5e0e01c9694e0ed7ee75df8588fa5a7be0f10"], "node": "a068ff39a17093090a7f352f31467ee2d37ae9ba", "parents": ["10afbd0a0e1f2c6a20e8d9a38f6b170121eac950"], "tags": []}, {"author": "Dan Schomburg \u003cdschomburg@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062477 - Add the pairing v2 web-channel commands and pref r=markh,Roger,android-reviewers\n\nAdds the fxaccounts:pair_oauth_start and fxaccounts:pair_oauth_finish\nweb-channel commands, gated on a new identity.fxaccounts.pairing.version\npref that is advertised to FxA as capabilities.pairingVersion.\n\nActing as the supplicant, the pair_oauth_start command begins an OAuth\nflow and responds with the parameters: state, scope, code_challenge,\nand keys_jwk. Note the code verifier never leaves the browser, and that\nthese parameters were all previously exposed on the /pair/supp/allow url.\n\nActing as the authority, the pair_oauth_finish command grants an\nauthorization code for a supplicant's parameters. The\n_authorizeOAuthCode and the createKeysJWE methods move out of\nFxAccountsPairing and into FxAccountsOAuth, so the channel-server\npairing flow and the new web-channel command can share one\nimplementation. It\u2019s also worth noting that these methods represent\noperations that are part of the oauth process and therefore are a better\nfit for the FxAccountsOAuth module anyways.\n\nOn Android, FxaCapability.PAIRING_V2 advertises pairingVersion and\nenables fxaccounts:pair_oauth_start, and the fxaccounts:pair_oauth_start\nhas been wired up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319867\n", "files": ["browser/app/profile/firefox.js", "mobile/android/android-components/components/feature/accounts/src/main/java/mozilla/components/feature/accounts/FxaWebChannelFeature.kt", "mobile/android/android-components/components/feature/accounts/src/test/java/mozilla/components/feature/accounts/FxaWebChannelFeatureTest.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/accounts/FxaWebChannelIntegration.kt", "services/fxaccounts/FxAccounts.sys.mjs", "services/fxaccounts/FxAccountsCommon.sys.mjs", "services/fxaccounts/FxAccountsOAuth.sys.mjs", "services/fxaccounts/FxAccountsPairing.sys.mjs", "services/fxaccounts/FxAccountsWebChannel.sys.mjs", "services/fxaccounts/tests/xpcshell/test_oauth_flow.js", "services/fxaccounts/tests/xpcshell/test_pairing.js", "services/fxaccounts/tests/xpcshell/test_web_channel.js"], "git_node": "1f9b20c2ee364d65557089fd6993f1224aae3329", "git_parents": ["d2037c5fc8ad5352af8fbc2ed23bbafcc0a534a1"], "node": "fb284bb7c3b0ead3643b88c3e12897bd68463e30", "parents": ["a068ff39a17093090a7f352f31467ee2d37ae9ba"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2064596 - Exclude border/padding when applying text-box-trim to inline boxes. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319661\n", "files": ["layout/generic/nsLineLayout.cpp", "testing/web-platform/meta/css/css-inline/text-box-trim/text-box-trim-inline-box-005.html.ini", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-004-ref.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-004.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-005-ref.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-005.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-006-ref.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-006.html"], "git_node": "38e7600e47da36fe6846fea8b710ab9f7f2c5099", "git_parents": ["1f9b20c2ee364d65557089fd6993f1224aae3329"], "node": "30683496c93069f520107b4805fc46bfeee37263", "parents": ["fb284bb7c3b0ead3643b88c3e12897bd68463e30"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063893 - Check childAvailableSize is constrained before using it. r=layout-reviewers,dshin\n\nSee bug 2063893 comment 6 for an analysis.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319883\n", "files": ["layout/generic/nsGridContainerFrame.cpp"], "git_node": "e33f852a206430eba0bd5b7575507bbf75cfe6b1", "git_parents": ["38e7600e47da36fe6846fea8b710ab9f7f2c5099"], "node": "2102012beb240acf0607e94f0f3b57c25a5626a8", "parents": ["30683496c93069f520107b4805fc46bfeee37263"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063893 - Add a WPT crashtest. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319884\n", "files": ["testing/web-platform/tests/css/css-grid/firefox-bug-2063893-crash.html"], "git_node": "15141ec5e3f4c2133cb6d6a472eec8c345ba153b", "git_parents": ["e33f852a206430eba0bd5b7575507bbf75cfe6b1"], "node": "cfd94289e11a96c7e2e3ba25100c3acd4b235840", "parents": ["2102012beb240acf0607e94f0f3b57c25a5626a8"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062975. Add a patch file for pywebsocket3's SSLContext change. r=jgraham\n\nBug 1874602 replaced the deprecated ssl.wrap_socket with ssl.SSLContext.wrap_socket in\nwebsocket_server.py, but applied it straight to the vendored copy without adding a patch\nfile, so re-vendoring pywebsocket3 did not reapply it. ssl.wrap_socket was removed in\nPython 3.12, so the next update of pywebsocket3 would have reintroduced a call that no\nlonger exists and broken the mochitest websocket server.\n\nCapture it as sslcontext.patch and add it to the patches list.\n\nWith this, `./mach vendor testing/mochitest/pywebsocket3/moz.yaml -r\n50602a14f1b6da17e0b619833a13addc6ea78bc2 --patch-mode check --force` reproduces the\ncommitted tree exactly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318109\n", "files": ["taskcluster/scripts/misc/vendor-verify-expected-fail.yml", "testing/mochitest/pywebsocket3/moz.yaml", "testing/mochitest/pywebsocket3/sslcontext.patch"], "git_node": "fd3f07c074f7b0da9e02b5ddd092257be178cbe8", "git_parents": ["15141ec5e3f4c2133cb6d6a472eec8c345ba153b"], "node": "e0604724fb649702a2e9cbf866d9ff6f4d0b8dd8", "parents": ["cfd94289e11a96c7e2e3ba25100c3acd4b235840"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055507 - pt 1. Make arena_t::mSpare a list r=glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312576\n", "files": ["memory/build/Arena.h", "memory/build/mozjemalloc.cpp"], "git_node": "f0e5503ddff87a25c5ab0e8c8199247c76897ab9", "git_parents": ["fd3f07c074f7b0da9e02b5ddd092257be178cbe8"], "node": "a7058f6242d008656cef66c374a05b64b13d04fe", "parents": ["e0604724fb649702a2e9cbf866d9ff6f4d0b8dd8"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055507 - pt 2. Add DoublyLinkedList::isSingle() r=sergesanspaille\n\nDifferential Revision: ht