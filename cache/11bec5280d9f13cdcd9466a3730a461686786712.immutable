.mozilla.com/D320732\n", "files": ["toolkit/components/glean/build_scripts/glean_parser_ext/templates/rust.jinja2"], "git_node": "b8f665fc0c39ce7e9b5dcf8e4aad5160d2575d70", "git_parents": ["f54181e69218689d62e9fd89e9d49c253ac43469"], "node": "2044e7a8bc97b5b55001ec6a15b0065a038a411d", "parents": ["e646a5a4261fc792c04f0f809a7cf722ecdee915"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064179 - Move debouncedToggleable modifier to Android Components r=android-reviewers,gmalekpour\n\nMove Modifier.debouncedToggleable into Android Components alongside Modifier.debouncedClickable, keeping the related debounced interaction modifiers together and making the implementation reusable across apps.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320433\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/modifier/Modifier.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/ui/Modifier.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt"], "git_node": "ad80c97f0d853ee5b480c1c8de78438ec0cf2504", "git_parents": ["b8f665fc0c39ce7e9b5dcf8e4aad5160d2575d70"], "node": "cd6233b4c54c2c000e6824e5fa474d48226d75f0", "parents": ["2044e7a8bc97b5b55001ec6a15b0065a038a411d"], "tags": []}, {"author": "kycn \u003c35106533+kycn@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064671 - Support automationtest intent extra to bypass Fenix onboarding for WebDriver r=android-reviewers,sfamisa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319742\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/automation/AutomatedLaunch.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/Performance.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/PerformanceLogger.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/StartupReportFullyDrawn.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/StrictModeManager.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/ThreadPenaltyDeathWithIgnoresListener.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/automation/AutomatedLaunchTest.kt"], "git_node": "1bb5ef5fb842bb55b51f6bb604bd511bc88cf2ad", "git_parents": ["ad80c97f0d853ee5b480c1c8de78438ec0cf2504"], "node": "284cb080f4f905a848a655f053fd9819cd5f71fd", "parents": ["cd6233b4c54c2c000e6824e5fa474d48226d75f0"], "tags": []}, {"author": "kycn \u003c35106533+kycn@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064609 - Pass automationtest intent extra by default for Fenix launches r=geckodriver-reviewers,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319758\n", "files": ["testing/geckodriver/src/capabilities.rs"], "git_node": "aa07bf034b58f2bd9762641cd99e41d4b7a4cbee", "git_parents": ["1bb5ef5fb842bb55b51f6bb604bd511bc88cf2ad"], "node": "ccf4b18e02605aa504a8820634d3808a1c842674", "parents": ["284cb080f4f905a848a655f053fd9819cd5f71fd"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061633 - Revert Bug 2022527, fix an issue in browser_tokenAlias.js and adjust browser_searchbar_new.js. r=urlbar-reviewers,dao\n\nThis reverts commit f19cee519d9c4a951986d8e96a5a7ee78be7e59a.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317572\n", "files": ["accessible/tests/browser/tree/browser_searchbar_new.js", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "browser/components/urlbar/tests/browser/browser_tokenAlias.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_customizing_nobreakout.js"], "git_node": "e766c55165a24d2c9b8682b3634873511442ae96", "git_parents": ["aa07bf034b58f2bd9762641cd99e41d4b7a4cbee"], "node": "16420a18c0aaa39974c59446ba53c33fbed23b23", "parents": ["ccf4b18e02605aa504a8820634d3808a1c842674"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2062671 - Don't clear internal keys in CustomKeys.clearAll(). r=Jamie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320571\n", "files": ["browser/components/customkeys/CustomKeys.sys.mjs", "browser/components/customkeys/tests/browser/browser_CustomKeys.js"], "git_node": "74c67c2f68eafdd63590d477d0a6938d6493595e", "git_parents": ["e766c55165a24d2c9b8682b3634873511442ae96"], "node": "9df86ebfad0bd22b2e06e9a9c63661e39e7153c1", "parents": ["16420a18c0aaa39974c59446ba53c33fbed23b23"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062660 - Copy Clean Link: Add missing Amazon and Audible storefronts r=manuel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317934\n", "files": ["toolkit/components/antitracking/StripOnShareLists/LGPL/StripOnShareLGPL.json", "toolkit/components/antitracking/StripOnShareLists/MPL2/StripOnShare.json"], "git_node": "cbbcd7f983f61699531fb97780f398709d35cdaf", "git_parents": ["74c67c2f68eafdd63590d477d0a6938d6493595e"], "node": "8b88242e565d7c0bc57dee7b42cf182e153f7201", "parents": ["9df86ebfad0bd22b2e06e9a9c63661e39e7153c1"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066029 - Subscribe to InitPluginEvent before starting the GMP encoder init in gtests. r=pehrsons\n\nThe tests called InitEncode() and only then connected a listener via\nWaitFor(*InitPluginEvent()). GmpInitDone_g notifies on the GMP thread and\nMediaEventSource does not replay, so the notification is lost if the init\nfinishes first, and SpinEventLoopUntil then spins until the harness'\nno-output watchdog kills the process.\n\nOnly the fixture's first init launches the plugin process and is slow enough\nto be safe. Every later init is served from a GMPContentParent that is still\nalive and completes on the GMP thread without touching the main thread, which\nis why the tests with bugs on file are the later ones rather than InitEncode.\nTake the listener first, as TestWebrtcCodecFactory already does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320871\n", "files": ["dom/media/gtest/TestWebrtcGmpCodec.cpp"], "git_node": "a0325ae980fc031ccff414c51da080040e4a0bcf", "git_parents": ["cbbcd7f983f61699531fb97780f398709d35cdaf"], "node": "62103f5640cbfabcc3242a45994adf8be7fbf6d6", "parents": ["8b88242e565d7c0bc57dee7b42cf182e153f7201"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066038 - Shut down the encoder in TestWebrtcGmpVideoEncoder's TearDown. r=pehrsons\n\nDropping the RefPtr does not destroy the encoder: GMPVideoEncoderParent holds\nit as its callback and it holds a ref on the actor, so the cycle survives\nuntil GMP service shutdown at the end of the process. Meanwhile the encoder\nkeeps a raw encode-complete callback pointing at a MockEncodedImageCallback\nowned by a test body that has long returned, which any late Encoded() or\nDropped() would use after free.\n\nShutdown() clears that callback and closes the actor, which breaks the cycle.\nEvery encoder is then destroyed right after its own test rather than in a\nbatch after the suite, and none is left holding a stale callback. The\nsurviving actors were also what kept the GMP plugin warm for subsequent tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320872\n", "files": ["dom/media/gtest/TestWebrtcGmpCodec.cpp"], "git_node": "adb9c41f8a4a6faa69e521d76980bb32abea41bd", "git_parents": ["a0325ae980fc031ccff414c51da080040e4a0bcf"], "node": "c45174570a31df419975936c2f0e213132a2470e", "parents": ["62103f5640cbfabcc3242a45994adf8be7fbf6d6"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2064233 - Add moz-src to broken chrome URL detection. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320360\n", "files": ["netwerk/base/nsNetUtil.cpp"], "git_node": "b6cd25700aa389bf9ec493763711b8fd1d8cc2d3", "git_parents": ["adb9c41f8a4a6faa69e521d76980bb32abea41bd"], "node": "ca2e2544b6f8fe03d4e6dcf3a7562c2c8a855b31", "parents": ["c45174570a31df419975936c2f0e213132a2470e"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063539 - Add popup blocker test for _parent targets, r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319318\n", "files": ["browser/base/content/test/popups/browser.toml", "browser/base/content/test/popups/browser_popup_blocker_parent_target.js", "browser/base/content/test/popups/popup_blocker_parent_target.html"], "git_node": "7dfa59fa04f210cc3d9304c9924c4213cb2ff4bc", "git_parents": ["b6cd25700aa389bf9ec493763711b8fd1d8cc2d3"], "node": "972fc4fd81044f797edf14392a1635ed896c85d0", "parents": ["ca2e2544b6f8fe03d4e6dcf3a7562c2c8a855b31"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065499 - Quota manager: turn global storage usage into a signed integer, to prevent underflow to wrap to very big unsigned integer and make the storage unusable. r=dom-storage-reviewers,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320454\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/CanonicalQuotaObject.cpp", "dom/quota/OriginInfo.cpp", "dom/quota/QuotaManager.h"], "git_node": "61ed14bf240e24f7ff93dd058de207b4116f067c", "git_parents": ["7dfa59fa04f210cc3d9304c9924c4213cb2ff4bc"], "node": "e542e96b428dc13d074f210231334eb28d2d4b75", "parents": ["972fc4fd81044f797edf14392a1635ed896c85d0"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065222 - Follow the actor port rather than the realm in UrlbarContentUtils. r=mbeier\n\nThe helpers branched on `typeof ChromeUtils`, so a chrome window on the message path took the privileged side and never reached the port, leaving its handlers unexercised by the pref that exists to exercise them. They now follow the port the actor publishes, and the actor publishes one whenever the message path is in use.\n\nEach helper reads the port off its own global, which is what keeps the actor's handlers from re-entering: the instance they import has no `window`, so they take the direct branch. The two that take a window must still read their own port, not that window's, or the actor hands its window straight back.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320223\n", "files": ["browser/components/urlbar/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/content/UrlbarContentUtils.mjs"], "git_node": "601716929bccd8293e63a48559ff4326c9b266b8", "git_parents": ["61ed14bf240e24f7ff93dd058de207b4116f067c"], "node": "e8ca104191f70e60ceee5c7bd09c4437efc2172a", "parents": ["e542e96b428dc13d074f210231334eb28d2d4b75"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064439 - Take a rich suggestion's icon unwrapped where a content process renders it. r=mbeier,mconley,freddyb\n\nThe trusted-scheme check compared `url.protocol`, which carries a trailing colon, so nothing ever counted as trusted and the browser's own icons went through the wrapper too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319711\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProviderSearchSuggestions.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/moz.build", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_resultIcon.js", "browser/components/urlbar/tests/browser-newtab/head.js", "browser/components/urlbar/tests/browser-newtab/richSuggestionEngine.sjs", "browser/components/urlbar/tests/unit/test_UrlbarUtils_getRemoteIconUrl.js", "browser/components/urlbar/tests/unit/xpcshell.toml"], "git_node": "10be013cdf0d7c1f2552d2fcf494e738ccfc3fe3", "git_parents": ["601716929bccd8293e63a48559ff4326c9b266b8"], "node": "20d5e9c99530d0973eaaa6ae3cfa10cf7c38f269", "parents": ["e8ca104191f70e60ceee5c7bd09c4437efc2172a"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2024840 - Remove mach static-analysis autotest subcommand r=sylvestre\n\nThis test harness is meant to make sure the upstream clang-tidy passes\nwe use still work as documented.\n\nIt only matters when we upgrade clang, and even in that condition it is\nvery unlikely to catch anything. Indeed existing autotests are very\nsimple and are not comparable to upstream tests in terms of coverage.\n\nThose tests also consume resources and add an extra step when adding\nsupport for a new pass.\n\nInstead, we setup a task in Bug 2065029 that runs all clang static\nanalysis on the whole tree and checks we don't regress.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320205\n", "files": ["docs/code-quality/static-analysis/existing.md", "python/mozbuild/mozbuild/code_analysis/mach_commands.py", "taskcluster/docs/kinds.md", "taskcluster/kinds/static-analysis-autotest/kind.yml", "taskcluster/test/params/mc-desktop-nightly.yml", "taskcluster/test/params/mc-nightly-all.yml", "taskcluster/test/test_autoland.py", "testing/mozharness/mozharness/mozilla/building/buildbase.py", "testing/mozharness/scripts/fx_desktop_build.py", "tools/clang-tidy/config.yaml", "tools/clang-tidy/test/bugprone-argument-comment.cpp", "tools/clang-tidy/test/bugprone-argument-comment.json", "tools/clang-tidy/test/bugprone-assert-side-effect.cpp", "tools/clang-tidy/test/bugprone-assert-side-effect.json", "tools/clang-tidy/test/bugprone-bitwise-pointer-cast.cpp", "tools/clang-tidy/test/bugprone-bitwise-pointer-cast.json", "tools/clang-tidy/test/bugprone-bool-pointer-implicit-conversion.cpp", "tools/clang-tidy/test/bugprone-bool-pointer-implicit-conversion.json", "tools/clang-tidy/test/bugprone-forward-declaration-namespace.cpp", "tools/clang-tidy/test/bugprone-forward-declaration-namespace.json", "tools/clang-tidy/test/bugprone-forwarding-reference-overload.cpp", "tools/clang-tidy/test/bugprone-forwarding-reference-overload.json", "tools/clang-tidy/test/bugprone-incorrect-roundings.cpp", "tools/clang-tidy/test/bugprone-incorrect-roundings.json", "tools/clang-tidy/test/bugprone-integer-division.cpp", "tools/clang-tidy/test/bugprone-integer-division.json", "tools/clang-tidy/test/bugprone-macro-parentheses.cpp", "tools/clang-tidy/test/bugprone-macro-parentheses.json", "tools/clang-tidy/test/bugprone-macro-repeated-side-effects.cpp", "tools/clang-tidy/test/bugprone-macro-repeated-side-effects.json", "tools/clang-tidy/test/bugprone-misplaced-widening-cast.cpp", "tools/clang-tidy/test/bugprone-misplaced-widening-cast.json", "tools/clang-tidy/test/bugprone-move-forwarding-reference.cpp", "tools/clang-tidy/test/bugprone-move-forwarding-reference.json", "tools/clang-tidy/test/bugprone-multiple-statement-macro.cpp", "tools/clang-tidy/test/bugprone-multiple-statement-macro.json", "tools/clang-tidy/test/bugprone-redundant-branch-condition.cpp", "tools/clang-tidy/test/bugprone-redundant-branch-condition.json", "tools/clang-tidy/test/bugprone-sizeof-expression.cpp", "tools/clang-tidy/test/bugprone-sizeof-expression.json", "tools/clang-tidy/test/bugprone-string-constructor.cpp", "tools/clang-tidy/test/bugprone-string-constructor.json", "tools/clang-tidy/test/bugprone-string-integer-assignment.cpp", "tools/clang-tidy/test/bugprone-string-integer-assignment.json", "tools/c