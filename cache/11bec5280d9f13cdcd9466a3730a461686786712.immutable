["c9dbfc3f47868747e5d4d65ed983e6e2b0d41f0f"], "node": "5ca732d0dc5ae5853abe9da3f230f8234f6a6972", "parents": ["c255d37e26f91ef8f388efcc775e62bbb9c89ea5"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063406 - Apply mozilla patches for libvpx r=chunmin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318544\n", "files": ["media/libvpx/libvpx/vp8/vp8_cx_iface.c", "media/libvpx/libvpx/vp9/vp9_cx_iface.c", "media/libvpx/libvpx/vpx_ports/aarch64_cpudetect.c", "media/libvpx/libvpx/vpx_util/vpx_pthread.h"], "git_node": "6d751cf5d0af4b7fcc1b232b6c2ba0551afabe1d", "git_parents": ["48a068a49520d52a5329919b1ff7c6731355fd2d"], "node": "169ddaae128b7f0d08fdeef33afbde8bf6cde620", "parents": ["5ca732d0dc5ae5853abe9da3f230f8234f6a6972"], "tags": []}], "date": 1786829929, "git_changesets": ["7b86195861d0dadb4ab95c7e0fa252320e8b45b1", "f242986e96efc4c81a651cf07bbe79c1472c1815", "3038fe22199be4a61fead5fbb110e59914ca6f32", "207a1809509a65ef8f503ff18d1981d6ecaf13e3", "a3142e89318e68a16d089d952451a4b0fd23692a", "f46c66817a049cfc5bb9e13415b6012ba50cebcb", "d68f3455fcf635e332a59b3969f07d9000240d49", "0d07e742b4e1e6e839bf377f880f0a25969de7c9", "d6f0f8073826663bd7a620436da7afd2621ba978", "690ae3ac28eef49b59f9ba1de6f746fa323b446f", "a5febabbb94200291df1bca00dc6d06406528a38", "37c3bb40a9ddb2c3b02202a7e5a77f0299c89b8a", "9898f7310d65a86c12cd17d9ee0a5d8f8fd1e6f4", "c9dbfc3f47868747e5d4d65ed983e6e2b0d41f0f", "48a068a49520d52a5329919b1ff7c6731355fd2d", "6d751cf5d0af4b7fcc1b232b6c2ba0551afabe1d"], "user": "abutkovits@mozilla.com"}, "45103": {"changesets": [{"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2032536 - Implement cont.new/resume/suspend with params and results. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299220\n", "files": ["js/src/jit-test/tests/wasm/stack-switching/cont-params.js", "js/src/jit-test/tests/wasm/stack-switching/cont-result-reg-clobber.js", "js/src/jit-test/tests/wasm/stack-switching/ensureballast-contparams.js", "js/src/jit-test/tests/wasm/stack-switching/errors.js", "js/src/jit-test/tests/wasm/stack-switching/gc-cont-params.js", "js/src/jit/CodeGenerator.cpp", "js/src/jit/LIROps.yaml", "js/src/jit/Lowering.cpp", "js/src/jit/MIR-wasm.cpp", "js/src/jit/MIR-wasm.h", "js/src/jit/MIROps.yaml", "js/src/jit/shared/LIR-shared.h", "js/src/wasm/WasmBuiltins.cpp", "js/src/wasm/WasmCode.h", "js/src/wasm/WasmGenerator.cpp", "js/src/wasm/WasmGenerator.h", "js/src/wasm/WasmInstance.cpp", "js/src/wasm/WasmInstance.h", "js/src/wasm/WasmInstanceData.h", "js/src/wasm/WasmIonCompile.cpp", "js/src/wasm/WasmMetadata.h", "js/src/wasm/WasmSerialize.cpp", "js/src/wasm/WasmStacks.cpp", "js/src/wasm/WasmStacks.h", "js/src/wasm/WasmStubs.cpp", "js/src/wasm/WasmStubs.h"], "git_node": "a13dd1cae76d351a6dacfb996d73a655e59ccc9c", "git_parents": ["6d751cf5d0af4b7fcc1b232b6c2ba0551afabe1d"], "node": "79f5997e83ebb04df457cc1cd6230f908c98623b", "parents": ["169ddaae128b7f0d08fdeef33afbde8bf6cde620"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2063669 - Mark a timed out xpcshell test done again so the scheduler stops waiting for it, r=ahal.\n\nA test process that gets killed on timeout often leaves a child process behind\nholding the stdout pipe the harness reads, so communicate() never sees EOF and\nrun_test() never returns. testTimeout used to set done itself, which let the\nscheduler abandon the blocked thread: join(1) times out, is_alive() is true, and\nthe test goes to the retry list. Bug 2052432 left done for run() to set, which\nthat thread will never reach, so the scheduler waits for the test forever and the\njob dies on mozharness's 1000 second output timeout without logging anything\nmore.\n\nSet it at the end of testTimeout rather than where it used to be, so the TIMEOUT\ntest_end is logged before a retry can interleave its test_start with our output.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318775\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "43cac79ba7cdb6f9636a10ee74443693a4f608cb", "git_parents": ["a13dd1cae76d351a6dacfb996d73a655e59ccc9c"], "node": "7bcb091f20d503ecea5b5b14c8cea9eb67066ace", "parents": ["79f5997e83ebb04df457cc1cd6230f908c98623b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2063670 - Don't wait for a blocked test thread in the xpcshell sequential and retry phases, r=ahal.\n\nThe scheduler's parallel phase copes with a test whose thread can no longer finish\n(it joins with a timeout and moves on), but the sequential and retry phases join\nwithout one. A test that times out leaving a child process holding its stdout pipe\nopen never returns from communicate(), so those two loops wait for a thread that\nwill never exit and the job dies on mozharness's 1000 second output timeout.\n\nWait for the done flag rather than for the thread in both loops, and give exception\nand traceback a value up front, since a thread abandoned this way never reaches the\ncode in run() that assigns them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318776\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "f14963d00236e7ccff2916fd49f66afc424bc55e", "git_parents": ["43cac79ba7cdb6f9636a10ee74443693a4f608cb"], "node": "a488b3c55e714e031b3e7cae834eeda459af4e40", "parents": ["7bcb091f20d503ecea5b5b14c8cea9eb67066ace"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050591 - Setup ktfmt for android linting r=ahochheiden,sfamisa,geckoview-reviewers,android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308868\n", "files": ["build.gradle", "gradle/libs.versions.toml", "mobile/android/android-components/build.gradle", "mobile/android/fenix/app/build.gra