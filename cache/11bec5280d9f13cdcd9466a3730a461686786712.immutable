bwebrtc/DEPS", "third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "b6794ae9535420d3bdcf1b6d23eaa0a75fa9f843", "git_parents": ["4016d0fbfc0789e30f4d748629dc159452e95b1e"], "node": "30c92206c79bc03c7add1e5e725ee85449055214", "parents": ["857dd43644b97c1d1a4c02f169174645c922e0ab"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058693 - Vendor libwebrtc from 303a5dd4f5\n\nUpstream commit: https://webrtc.googlesource.com/src/+/303a5dd4f5840ca0c9fbd7385d4cd630438d316f\n    Update WebRTC code version (2026-07-04T04:05:36).\n\n    Bug: None\n    Change-Id: I63a9299cad67e35cd600e1d12c3db2943ee82dba\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/487680\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48155}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "9bb63be068a1de3682ada44aaaa43d89f3679ebe", "git_parents": ["b6794ae9535420d3bdcf1b6d23eaa0a75fa9f843"], "node": "351356326d63db722253291c88d6b303da79578c", "parents": ["30c92206c79bc03c7add1e5e725ee85449055214"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058693 - Vendor libwebrtc from 6db252a550\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6db252a55022a2bebe6dd77f8876eae5d2f34395\n    sdp munging: detect rejection by munging\n\n    which should not be used. If needed stop the transceiver to reject.\n\n    Bug: webrtc:414284082\n    Change-Id: Ie84f89e45e2bb29d4db87c9225730c945e5d358e\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/485520\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48156}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/uma_metrics.h", "third_party/libwebrtc/pc/peer_connection_integrationtest.cc", "third_party/libwebrtc/pc/peer_connection_interface_unittest.cc", "third_party/libwebrtc/pc/sdp_munging_detector.cc", "third_party/libwebrtc/pc/sdp_munging_detector_unittest.cc"], "git_node": "91540715632fc00f7ff32d147e46cc019a319cca", "git_parents": ["9bb63be068a1de3682ada44aaaa43d89f3679ebe"], "node": "154d9ce6f792d1ecedd8be970d060b36ffa8c26e", "parents": ["351356326d63db722253291c88d6b303da79578c"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058693 - Vendor libwebrtc from 669c3cf5c3\n\nUpstream commit: https://webrtc.googlesource.com/src/+/669c3cf5c3e1ef8bac511d2a89c02a61f2005bbd\n    Enable non-sender RTT from negotiated rcvr-rtt; report video RTT\n\n    Drive RRTR/DLRR enablement from the negotiated receive_non_sender_rtt\n    flag (set by the SDP layer from either rtcp-xr:rcvr-rtt or the legacy\n    rtcp-fb rrtr) instead of HasRrtr, for both the audio and video receive\n    channels. Enablement uses SetReceiveNonSenderRttEnabled on each receive\n    channel: receive streams can be created before the receive parameters\n    are finalized (e.g. a recvonly endpoint creates them while processing\n    the offer), so the value cannot reliably be set at stream construction\n    and must be applied via the setter, as the voice channel already does.\n\n    Also surfaces the computed video non-sender RTT into\n    RTCRemoteOutboundRtpStreamStats (GetNonSenderRttStats -\u003e\n    VideoReceiveStream2::Stats -\u003e VideoReceiverInfo), resolving the\n    long-standing TODO(bugs.webrtc.org/12529).\n\n    Bug: webrtc:516205747\n    Change-