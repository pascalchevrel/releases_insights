": ["4ca55412e35d32ddf4deb96f57274b7f70386e46"], "node": "bf998a84b281215a1b427cd2432c1bdefa433d32", "parents": ["afb5ae1ecbc5a1e063605b505db5ceabcb6ed66d"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058693 - Vendor libwebrtc from 9c0ef038b5\n\nUpstream commit: https://webrtc.googlesource.com/src/+/9c0ef038b51a69b1b4b07a7e8b293823bcaf5470\n    Remove NetworkEstimate::bwe_period and estimators\n\n    NetworkEstimate::bwe_period is deprecated and unused. This removes the\n    field from NetworkEstimate as well as GetExpectedBwePeriod() and\n    GetExpectedBandwidthPeriod() from DelayBasedBwe and AimdRateControl.\n\n    Bug: webrtc:442860748\n    Change-Id: I1f9165f645ecf0e1e0117a34f9b7a41b6c3b49d4\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/486581\n    Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48121}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/transport/network_types.h", "third_party/libwebrtc/modules/congestion_controller/goog_cc/delay_based_bwe.cc", "third_party/libwebrtc/modules/congestion_controller/goog_cc/delay_based_bwe.h", "third_party/libwebrtc/modules/congestion_controller/goog_cc/delay_based_bwe_unittest.cc", "third_party/libwebrtc/modules/congestion_controller/goog_cc/goog_cc_network_control.cc", "third_party/libwebrtc/modules/congestion_controller/pcc/pcc_network_controller.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_network_controller.cc", "third_party/libwebrtc/modules/remote_bitrate_estimator/aimd_rate_control.cc", "third_party/libwebrtc/modules/remote_bitrate_estimator/aimd_rate_control.h", "third_party/libwebrtc/modules/remote_bitrate_estimator/aimd_rate_control_unittest.cc"], "git_node": "c3174acdd8a90fa1ef88cafcba62fd4578dda7b2", "git_parents": ["be6ea83410c2a8390793dca33b22288e68978fb5"], "node": "29f2742455f329f1b1d6cd3a3678680af7d770d0", "parents": ["bf998a84b281215a1b427cd2432c1bdefa433d32"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058693 - Vendor libwebrtc from 8acefd4f50\n\nEssentially a no-op since we're going to see this change\nreverted when we vendor in c125d002da.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8acefd4f5076e0c371f9b891e4bfcf477af13929\n    Use GetTimestamp in encoded frame clone functions.\n\n    Mock frames in Chromium tests do not overload the new\n    GetRtpTimestampInfo() and fail.\n\n    Bug: chromium:524901718\n    Change-Id: I67ce2478b1b096ed82e22d72c88d0bdd41848c5a\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/486860\n    Commit-Queue: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Commit-Queue: Leonardo Evi \u003cevil@chromium.org\u003e\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48122}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/c125d002da.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/p0002.patch", "third_party/libwebrtc/moz-patch-stack/p0003.patch", "third_party/libwebrtc/moz-patch-stack/p0004.patch"], "git_node": "f6453022960ff269ac411f83ced7dd4c28238eed", "git_parents": ["c3174acdd8a90fa1ef88cafcba62fd4578dda7b2"], "node": "e97ce8eb366dee21df64a3999896dde00d6739bc", "parents": ["29f2742455f329f1b1d6cd3a3678680af7d770d0"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058693 - Vendor libwebrtc from 7152128a62\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7152128a62c74f661646878ffbcbb263efa0a6cf\n    Attempt to deflake CcFbSendRateAdaptation tests\n\n    Increase packet_queue_length from 8 to 20 and simulation duration\n    from 10s to 15s in RtcpRateIncreaseWhenAudioStopSending to prevent\n    test flakiness on slow/constrained link emulations.\n\n    Bug: None\n    Change-Id: I7e8288fd2f040e117aec501a902a171d80490354\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/486900\n    Auto-Submit: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Reviewed-by: Diep Bui \u003cdiepbp@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Commit-Queue: Diep Bui \u003cdiepbp@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48123}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/test/peer_scenario/bwe_integration_tests/l4s_test.cc"], "git_node": "bf59464725c0b92a4e1f9e10c65a8a1e5d0e6b51", "git_parents": ["f6453022960ff269ac411f83ced7dd4c28238eed"], "node": "554601497d68541df7a440611e2345f1ec08f879", "parents": ["e97ce8eb366dee21df64a3999896dde00d6739bc"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058693 - Vendor libwebrtc from dd669b0686\n\nUpstream commit: https://webrtc.googlesource.com/src/+/dd669b068640934756c397c1bddbda5cef4230a1\n    Roll chromium_revision bf238ef034..77820b7023 (1654562:1654714)\n\n    Change log: https://chromium.googlesource.com/chromium/src/+log/bf238ef034..77820b7023\n    Full diff: https://chromium.googlesource.com/chromium/src/+/bf238ef034..77820b7023\n\n    Changed dependencies\n    * src/build: https://chromium.googlesource.com/chromium/src/build/+log/209acdce39..7ee2d04aa2\n    * src/ios: https://chromium.googlesource.com/chromium/src/ios/+log/669f87826e..27a8243354\n    * src/testing: https://chromium.googlesource.com/chromium/src/testing/+log/b971ae67bb..1aa8adae7c\n    * src/third_party: https://chromium.googlesource.com/chromium/src/third_party/+log/caef865ee0..06f12dc1d0\n    * src/third_party/boringssl/src: https://boringssl.go