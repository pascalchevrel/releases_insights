/webdriver/tests/bidi/browsing_context/fragment_navigated/user_context_tentative.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/load/load.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/load/user_context_tentative.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/navigation_failed/__dir__.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/traverse_history/context.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/traverse_history/delta.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/traverse_history/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/combined/multiple_emulations.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_scripting_enabled/contexts.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_scripting_enabled/enabled.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_scripting_enabled/enabled_tentative.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_scripting_enabled/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_scripting_enabled/user_contexts.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_timezone_override/contexts.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_timezone_override/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_timezone_override/timezone.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/file_dialog_opened/file_dialog_opened.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/file_dialog_opened/tentative/show_open_file_picker.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/file_dialog_opened/user_context_tentative.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/integration/parallel_execution/browsing_context_print.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/network/combined/network_events.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/script/remove_preload_script/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/script/remove_preload_script/remove_preload_script.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/script/remove_preload_script/sandbox.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/session/status/status.py.ini", "testing/web-platform/meta/webdriver/tests/classic/dismiss_alert/dismiss.py.ini", "testing/web-platform/meta/webdriver/tests/classic/get_window_handles/get.py.ini", "testing/web-platform/meta/webdriver/tests/classic/get_window_handles/user_prompts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/create_alwaysMatch.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/create_firstMatch.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/default_values.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/merge.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/page_load_strategy.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/response.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/timeouts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/unhandled_prompt_behavior.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/websocket_url.py.ini", "testing/web-platform/meta/webdriver/tests/classic/send_alert_text/send.py.ini", "testing/web-platform/meta/webdriver/tests/classic/switch_to_window/alerts.py.ini", "testing/web-platform/meta/webdriver/tests/classic/switch_to_window/switch.py.ini", "testing/web-platform/meta/webdriver/tests/classic/take_element_screenshot/iframe.py.ini"], "git_node": "2df1c436608bd6d826b076c23b3c434b5b1f578a", "git_parents": ["c8dffd4badc0b4cb3af9f4e7ca6a69b095156918"], "node": "227e5c620d39743fcc8f393a6e56ef3f8445da7c", "parents": ["6455ba8722524b77f9bcf870917b35d890293552"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2066413 - Port ssltunnel off NSPR's PRThreadPool. r=necko-reviewers,valentin\n\nssltunnel is the last consumer of PR_CreateThreadPool in the tree; nothing\nelse uses nsprpub/pr/src/misc/prtpool.c at all. It never used the pool as a\nwork queue over a bounded set of workers, though: every job is long-lived,\none per listening server plus one per accepted client connection. A thread\nper job is therefore equivalent, and PR_CreateThread expresses it directly.\n\nThe threads are unjoinable on purpose. StartServer parks in PR_Accept with\nno timeout and only re-checks shutdown_server at the top of its loop, so\nwaiting for one to finish can block indefinitely. PR_JoinThreadPool had that\nsame hazard, which means the graceful shutdown path could already hang; it is\nonly reachable when a server fails to start, since the harness kills this\nprocess rather than asking it to exit.\n\nGuards shutdown_condvar with a shutdown_requested predicate. SignalShutdown\nonly notified, so a shutdown signalled before main reached PR_WaitCondVar was\nlost and main blocked forever. That was already reachable from StartServer's\nthree failure paths, which run on worker threads and can signal before main\nstarts waiting - a server whose port is still in TIME_WAIT, for instance - and\nqueueing a server from main makes it deterministic.\n\nTwo incidental fixes: a failed queue attempt used to leak the\nconnection_info_t along with its socket, and a server that could not be\nstarted was silently skipped instead of signalling shutdown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321213\n", "files": ["testing/mochitest/ssltunnel/ssltunnel.cpp"], "git_node": "03eb9f4624b7d312db742b1bfa6d0363f579a167", "git_parents": ["2df1c436608bd6d826b076c23b3c434b5b1f578a"], "node": "40f883ddc074e97f779f7585967e85f6450957f0", "parents": ["227e5c620d39743fcc8f393a6e56ef3f8445da7c"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065344 - Catch ForegroundServiceStartNotAllowedException in AbstractPrivateNotificationService r=jdelorenzo,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321358\n", "files": ["mobile/android/android-components/components/feature/privatemode/src/main/java/mozilla/components/feature/privatemode/notification/AbstractPrivateNotificationService.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/session/PrivateNotificationService.kt"], "git_node": "5e86de3d57c03d470138bc46a5847e8cf5b10529", "git_parents": ["03eb9f4624b7d312db742b1bfa6d0363f579a167"], "node": "aa2234895dca260c9f3d2898328a6bcffee9f9ee", "parents": ["40f883ddc074e97f779f7585967e85f6450957f0"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065552 - Allow Nimbus to provide the marketing card title and copy for treatment C r=android-reviewers,rebecatudor273,cbect,android-l10n-reviewers,parker\n\nDisplay the third copy value in bold as part of the second line.\n\nAdd previews for the French, German, and Spanish treatment C configurations.\n\n{F78424280}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320914\n", "files": ["mobile/android/fenix/app/onboarding.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/MarketingDataOnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingMapper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingPageState.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "4ab94261ac04f1d761fa41e98349fa4e393458f3", "git_parents": ["5e86de3d57c03d470138bc46a5847e8cf5b10529"], "node": "45dea8fce2a7ff7e1973b5999a08d51a1c345e8f", "parents": ["aa2234895dca260c9f3d2898328a6bcffee9f9ee"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061980 - Do not abort cmSetupOther in the Eluminate shim when a property cannot be assigned r=webcompat-reviewers,manuel,twisniewski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317290\n", "files": ["browser/extensions/webcompat/shims/eluminate.js"], "git_node": "afb73383bfc0806e9190d7a3abe1d965e532e6c8", "git_parents": ["4ab94261ac04f1d761fa41e98349fa4e393458f3"], "node": "f581ac102806ed42c8826cb2447db7d123f113b7", "parents": ["45dea8fce2a7ff7e1973b5999a08d51a1c345e8f"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061373 - Remove the Legacy Telemetry mirror of pwmgr.login_page_safety r=credential-management-reviewers,timhuang,dimi\n\nOnly the Legacy Telemetry mirror is removed. The Glean metric\npwmgr.login_page_safety and its recording site in InsecurePasswordUtils.sys.mjs\nare left in place, so what Firefox collects is unchanged.\n\nThe metric is opt-out and is sent in both the metrics and sync pings, so ending\nthe collection itself would be a decision for the data owners rather than part\nof this mirror cleanup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317031\n", "files": ["toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "8d989970b3334db47ad853994749317d8bd058b2", "git_parents": ["afb73383bfc0806e9190d7a3abe1d965e532e6c8"], "node": "76952050eaddc1b2977e1cbe0eb06887216dc8b5", "parents": ["f581ac102806ed42c8826cb2447db7d123f113b7"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066708 - Fix leak of FFmpegVideoDecoder::mSurfaceTextureSurface with MediaCodec NDK. r=media-playback-reviewers,padenot\n\nWe need to call java::SurfaceAllocator::DisposeSurface to release\nmSurfaceTextureSurface properly. It can only be done after the\nrender or release call in CompositeListener, because any frames\nstill outstanding require it. That holds a strong reference to the\nFFmpegVideoDecoder which keeps us alive long enough to do that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321481\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h"], "git_node": "e8e396a981d34cdfc1139562e423a7eee98fa183", "git_parents": ["8d989970b3334db47ad853994749317d8bd058b2"], "node": "e85bbf5accca550e50c03f8c9ad51ee4c66ac2f2", "parents": ["76952050eaddc1b2977e1cbe0eb06887216dc8b5"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2063849 - Correctly navigate when using quickactions on already loaded url. r=daisuke,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321057\n", "files": ["browser/components/urlbar/QuickActionsLoaderDefault.sys.mjs", "browser/components/urlbar/tests/browser-quickactions/browser_commands.js"], "git_node": "f6b72ed55f8371938ab1e64dc6af8ccb8eb9bd9b", "git_parents": ["e8e396a981d34cdfc1139562e423a7eee98fa183"], "node": "3db7f2493857c4ca72ff2ed1fc89f8d64367576f", "parents": ["e85bbf5accca550e50c03f8c9ad51ee4c66ac2f2"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061672 - Remove the Legacy Telemetry mirror of fingerprinters_blocked_count r=timhuang,TravisLong\n\nOnly the Legacy Telemetry mirror is removed. The Glean metric\ncontentblocking.fingerprinters_blocked_count is left in place, so what Firefox\ncollects is unchanged. fingerprintersHistogramAdd in browser-siteProtections.js\nalready records exclusively through Glean, so no instrumentation changes are\nneeded.\n\nBoth sides of the mirror have to go in the same commit: test_mirrors.py asserts\nevery telemetry_mirror resolves to an existing probe, and also that every\nhistogram in Histograms.json has a mirroring metric, so removing either side\nalone fails.\n\nbrowser_protectionsUI_fingerprinters.js asserted on the legacy categorical\nhistogram only, so those assertions are converted to Glean rather than dropped.\nThe categorical indices the old snapshot indexed into map onto the labeled\ncounter's labels: 0 is pageLoad, 1 is blocked and 2 is allowed. The fpHistogram\nglobal and its getHistogramById lookup are now unused and removed.\n\nThis is the direct counterpart of bug 2061673 for fingerprinters. It is stacked\non that change because FINGERPRINTERS_BLOCKED_COUNT and\nCRYPTOMINERS_BLOCKED_COUNT are adjacent entries in Histograms.json, so the two\ndiffs would otherwise conflict.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317246\n", "files": ["browser/base/content/test/protectionsUI/browser_protectionsUI_fingerprinters.js", "toolkit/components/antitracking/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "a83d453d2d64176737de6543bc82ed508ebbb42b", "git_parents": ["f6b72ed55f8371938ab1e64dc6af8ccb8eb9bd9b"], "node": "33a1a5fc0b12bcd9ba7c2ffcf71bce97358d6e68", "parents": ["3db7f2493857c4ca72ff2ed1fc89f8d64367576f"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059405 - Remove legacy application reputation probes r=timhuang,janerik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317398\n", "files": ["browser/base/content/metrics.yaml", "toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/tests/python/test_mirrors.py"], "git_node": "35d1156c12c79367fba814a3935def20e75f1053", "git_parents": ["a83d453d2d64176737de6543bc82ed508ebbb42b"], "node": "f66aec93c67c89c2cbcd036fc644cf051f146ff0", "parents": ["33a1a5fc0b12bcd9ba7c2ffcf71bce97358d6e68"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062979 - Extract article text and language via PageExtractor on Listen tap r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321183\n", "files": ["mobile/android/android-components/components/feature/readerview/src/main/java/mozilla/components/feature/readerview/ReaderViewFeature.kt", "mobile/android/android-components/components/feature/readerview/src/main/java/mozilla/components/feature/readerview/internal/ReaderViewControlsInteractor.kt", "mobile/android/android-components/components/feature/readerview/src/test/java/mozilla/components/feature/readerview/ReaderViewFeatureTest.kt", "mobile/android/android-components/components/feature/readerview/src/test/java/mozilla/components/feature/readerview/internal/ReaderViewControlsInteractorTest.kt", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/integration/ReaderViewIntegration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt"], "git_node": "9f6a66c6dadd828d0a57b1831dca3ad59cf5f092", "git_parents": ["35d1156c12c79367fba814a3935def20e75f1053"], "node": "c9d0e5d60db484b00e6cb4c4182b0e2f20c571b3", "parents": ["f66aec93c67c89c2cbcd036fc644cf051f146ff0"], "tags": []}, {"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2011236 - Only store the policy container in session history entries that inherit it r=smaug,nsharpley\n\nThe CSP_ShouldURIInheritCSP check from bug 1867137 only covered the\nnsISHEntry XPCOM setter, which normal loads never reach under SHIP.\nAdding the fix to SessionHistoryInfo constructors.\n\nThis should prevent us from saving a lot of unnecessary junk.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320897\n", "files": ["browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_policy_container_not_stored.js", "browser/components/sessionstore/test/browser_policy_container_sample.html", "browser/components/sessionstore/test/browser_policy_container_sample_frame.html", "docshell/shistory/SessionHistoryEntry.cpp"], "git_node": "6a17e21b389a415c3fa4453bd2bf2e044ca076d6", "git_parents": ["9f6a66c6dadd828d0a57b1831dca3ad59cf5f092"], "node": "3e2df924f56591144d10bfe55747368c26e907ac", "parents": ["c9d0e5d60db484b00e6cb4c4182b0e2f20c571b3"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "no bug - mots: add .agents to the list of directories managed by ai4dev-reviewers r=ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321480\n", "files": ["mots.yaml"], "git_node": "2c51506094b2faba22470c5b9d45adc133476350", "git_parents": ["6a17e21b389a415c3fa4453bd2bf2e044ca076d6"], "node": "e9d09ed15fae71de23826f270319e41410d1f49e", "parents": ["3e2df924f56591144d10bfe55747368c26e907ac"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065900 - Don't obscure theme background image in the toolbar when window is inactive r=desktop-theme-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320972\n", "files": ["browser/themes/shared/browser-shared.css"], "git_node": "2b7968eb2543e483fb7dc44e5f2cd6d4aaa9dc0a", "git_parents": ["2c51506094b2faba22470c5b9d45adc133476350"], "node": "2a54ff12dfb7058209ee915b9f5e078f70dc20e6", "parents": ["e9d09ed15fae71de23826f270319e41410d1f49e"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066150 - Remove legacy security telemetry probes r=freddyb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321206\n", "files": ["toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml", "toolkit/components/telemetry/histogram-allowlists.json", "toolkit/content/metrics.yaml"], "git_node": "aa624ed172038ae1ac0953e715702ccf8465f951", "git_parents": ["2b7968eb2543e483fb7dc44e5f2cd6d4aaa9dc0a"], "node": "14785a74e13c5c50bc4df2e397bb829546ecd100", "parents": ["2a54ff12dfb7058209ee915b9f5e078f70dc20e6"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066518 - [remote] Do not set MOZ_MARIONETTE=1 when dynamically starting marionette r=whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321318\n", "files": ["remote/components/Marionette.sys.mjs"], "git_node": "f785ac0bc039dbd08365da8d563e949e5c0d4a77", "git_parents": ["aa624ed172038ae1ac0953e715702ccf8465f951"], "node": "139e312fac348be1863b2f191a1648b24ee2cc3a", "parents": ["14785a74e13c5c50bc4df2e397bb829546ecd100"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066498 - Switch Android to new encoder creation strategy to only prefer platform for hardware encoders. r=webrtc-reviewers,pehrsons\n\nWith the MediaCodec NDK changes, we expose platform support for\nsoftware VP8/VP9/AV1 encoders via ffvpx for webcodecs. At present,\nAndroid ships neither ffvpx nor webcodecs support. The MediaCodec\nNDK work is required to unblock that, and as a result, enables\nffvpx software encoding as a viable path.\n\nToday Android always prefers a platform encoder over a WebRTC\nencoder, which works because AndroidEncoderModule only exposes a\nsoftware implementation for H264.\n\nThis patch makes it so that if there is a software WebRTC encoder\navailable for the desired codec, we will only allow hardware\nencoders from platform. This preserves the behaviour that Android\nsees with an encoder creation strategy of 1 when the Media NDK\nprefs are enabled. This will fix new WPT webrtc failures with that\nconfiguration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321296\n", "files": ["dom/media/webrtc/libwebrtcglue/MediaDataCodec.cpp", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.cpp", "dom/media/webrtc/tests/mochitests/head.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "6c793c29341b49adeb0e2190e76320c1a7e7cdc7", "git_parents": ["f785ac0bc039dbd08365da8d563e949e5c0d4a77"], "node": "70ab8be087800d95e930ba94f123f12fecc32aaf", "parents": ["139e312fac348be1863b2f191a1648b24ee2cc3a"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066329. r=gfx-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321445\n", "files": ["gfx/wr/swgl/src/swgl_ext.h"], "git_node": "2612e906a336e46d9a5f1c28ffa7fce785fc6f83", "git_parents": ["6c793c29341b49adeb0e2190e76320c1a7e7cdc7"], "node": "99719c6f54495e758565cf19041d84c2cf5b0b12", "parents": ["70ab8be087800d95e930ba94f123f12fecc32aaf"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066150 - Remove legacy security telemetry probes r=freddyb\" for causing python failures @test_mirrors.py.\n\nThis reverts commit aa624ed172038ae1ac0953e715702ccf8465f951.\n", "files": ["toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml", "toolkit/components/telemetry/histogram-allowlists.json", "toolkit/content/metrics.yaml"], "git_node": "621f0710d654c7ec06a9cb14f79582e1397731be", "git_parents": ["2612e906a336e46d9a5f1c28ffa7fce785fc6f83"], "node": "2f6862d2fbf05d83acaba79afdf88ac003771d44", "parents": ["99719c6f54495e758565cf19041d84c2cf5b0b12"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062877 - Snap border radii that drive a corner segment to whole device pixels r=gfx-reviewers,nical\" for causing reftest failures.\n\nThis reverts commit 1d6dee808228bd101f4de898359fc772b7e26a0f.\n", "files": ["gfx/layers/apz/test/reftest/reftest.list", "gfx/wr/webrender/src/border.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/wrench/reftests/border/border-corner-fractional-radius-ref.yaml", "gfx/wr/wrench/reftests/border/border-corner-fractional-radius.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/border-shape.png", "gfx/wr/wrench/reftests/border/reftest.list", "layout/reftests/bugs/reftest.list"], "git_node": "a16312c9df268c2aec127121548f1a60e464dc99", "git_parents": ["621f0710d654c7ec06a9cb14f79582e1397731be"], "node": "19a11599d83be494865b6c577ebbbf4ac39381c7", "parents": ["2f6862d2fbf05d83acaba79afdf88ac003771d44"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066500 - update wpt metadata for @customizable-select/picker-icon-animation.html.\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/picker-icon-animation.html.ini"], "git_node": "81c0b0d30ecbed822da6feecf2b0706061d5035e", "git_parents": ["a16312c9df268c2aec127121548f1a60e464dc99"], "node": "0a98b00c82087c3ed7f464936ecb7bfcd99ec92b", "parents": ["19a11599d83be494865b6c577ebbbf4ac39381c7"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2059405 - Remove legacy application reputation probes r=timhuang,janerik\" for causing bc failures @browser_protectionsUI.js.\n\nThis reverts commit 35d1156c12c79367fba814a3935def20e75f1053.\n", "files": ["browser/base/content/metrics.yaml", "toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/tests/python/test_mirrors.py"], "git_node": "9f622157ccc8ab8180f8abdcc97e130dfc352eb9", "git_parents": ["81c0b0d30ecbed822da6feecf2b0706061d5035e"], "node": "174d27e164016f423c63e325a7cf164f3e8ce8fb", "parents": ["0a98b00c82087c3ed7f464936ecb7bfcd99ec92b"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066060 - Removed telemetry probes for mixed_content_unblock_counter r=freddyb,chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320875\n", "files": ["dom/ipc/WindowGlobalParent.cpp", "dom/media/metrics.yaml", "dom/security/metrics.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml", "toolkit/components/telemetry/histogram-allowlists.json"], "git_node": "2ccc12c84a77c87facbb2b647f6d9bd3a9fbe0aa", "git_parents": ["9f622157ccc8ab8180f8abdcc97e130dfc352eb9"], "node": "5044084e4fcda3d7da6776c40e755c23be8be4b9", "parents": ["174d27e164016f423c63e325a7cf164f3e8ce8fb"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1949651 - Wait for about:addons to focus the options button before focusing the options browser, r=extension-reviewers,robwu.\n\nAddonCard.render() focuses the card's options button from a requestAnimationFrame\ncallback that is armed before the inline options browser exists. If that callback\nruns between the test's promiseFocus() and its click, focus moves off the options\nbrowser and canOpenModalPicker is false.\n\nThe test now waits for the options button to be focused before touching focus\nitself, so the card can no longer steal it.\n\nThe socketprocess_networking condition also comes out: no mochitest-browser-chrome\nvariant has set that pref since bug 2004381.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318265\n", "files": ["browser/components/extensions/test/browser/browser.toml", "browser/components/extensions/test/browser/browser_ext_canOpenModalPicker.js"], "git_node": "7fd168248c5734040714c8a1a01a8974df5ed256", "git_parents": ["2ccc12c84a77c87facbb2b647f6d9bd3a9fbe0aa"], "node": "7fd006115c63f6de3b9acbef500e8f612dd1b2f2", "parents": ["5044084e4fcda3d7da6776c40e755c23be8be4b9"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058064 - Validate vertexAttribPointer byteOffset, r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321487\n", "files": ["dom/canvas/WebGLContextVertices.cpp"], "git_node": "d6756af20470c383d1ef4ce43566c326261f2f6c", "git_parents": ["7fd168248c5734040714c8a1a01a8974df5ed256"], "node": "839f739165352c55da80ca653a4f4ae8c0e77cfa", "parents": ["7fd006115c63f6de3b9acbef500e8f612dd1b2f2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062211 - Add NewtabSearchbarTestUtils, a parent-side driver for the newtab search bar. r=urlbar-reviewers,mbeier\n\nThe bar is in a content process, so each method spawns a task there and calls the content-side target. `SpecialPowers.spawn` stringifies that task, so nothing can be closed over: the method name travels as data, and `spawn` wraps a caller's task by wrapping its source.\n\nThe driver joins `UrlbarTestUtils.sys.mjs` in the tsconfig's exclusions: a spawn task's body reads sandbox globals, which tsc has no way to know about.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321220\n", "files": ["browser/components/urlbar/moz.build", "browser/components/urlbar/tests/NewtabSearchbarContentTestUtils.sys.mjs", "browser/components/urlbar/tests/NewtabSearchbarTestUtils.sys.mjs", "browser/components/urlbar/tsconfig.json"], "git_node": "d4928be6ed9ddb20e371a03c6e60fe5f85b65a9f", "git_parents": ["d6756af20470c383d1ef4ce43566c326261f2f6c"], "node": "a0b8ea0f06945758c58175300ae8cbffee2f9714", "parents": ["839f739165352c55da80ca653a4f4ae8c0e77cfa"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062211 - Drive the newtab search bar tests through the shared test utils. r=urlbar-reviewers,mbeier\n\nThe hand-rolled helpers go, and with them a poll that rebuilt a sandbox every 100ms to read three properties. `browser_escape.js` is where to look for the one-task shape.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321221\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser_escape.js", "browser/components/urlbar/tests/browser-newtab/browser_pickResult.js", "browser/components/urlbar/tests/browser-newtab/browser_resultIcon.js", "browser/components/urlbar/tests/browser-newtab/head.js"], "git_node": "8f0b5a765f8119972c5c42bd5f68cc074fde7c3e", "git_parents": ["d4928be6ed9ddb20e371a03c6e60fe5f85b65a9f"], "node": "8c39ea52ecdeb3d792e4d4479ac52863e169f907", "parents": ["a0b8ea0f06945758c58175300ae8cbffee2f9714"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2002142 - Fix a race in browser_ext_pageAction_contextMenu.js that could make it wait forever for the page action popup, r=extension-reviewers,robwu.\n\nopenContextMenuInPopup calls awaitExtensionPanel, which waits for\nWebExtPopupLoaded. That event is dispatched from the panel's popupshowing\nhandler, so a test that awaits clickPageAction first can reach\nawaitExtensionPanel after the event and then wait until the test times out.\n\nStart the click without awaiting it, so that the listener is registered before\nanything can show the popup, and await the click promise afterwards so that a\nrejection is not left unobserved.\n\nAlso document why closePageAction resolves as soon as hidePopup has been called\nrather than once the popup is hidden.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317514\n", "files": ["browser/components/extensions/test/AppUiTestDelegate.sys.mjs", "browser/components/extensions/test/browser/browser_ext_pageAction_contextMenu.js"], "git_node": "1a2260a52a12a64a8e9accc2984cebe01825ec54", "git_parents": ["8f0b5a765f8119972c5c42bd5f68cc074fde7c3e"], "node": "499850eba24cf21f6c134849a5db5ab0a3b5c2c2", "parents": ["8c39ea52ecdeb3d792e4d4479ac52863e169f907"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2028652 - Do not treat the maximized browser window size as the \"normal\" size in browser_ext_windows_update.js, and wait for the exit-fullscreen resize in windows.update(), r=extension-reviewers,robwu.\n\nTwo problems, either of which perma-fails this test when it is not skipped.\n\nThe test records the window size before ensuring the window is not maximized,\nand on a small screen mochitest's first window is maximized at startup. Fixed in\nthe test.\n\nWindow.setState() waits for the sizemode change but not for the resize that\nfollows it when leaving fullscreen, so windows.update() can resolve with the\nfullscreen size still in place. Fixed in windows.update(), sharing the\nno-window-manager timeout the sizemode wait already used. Narrow instance of bug\n1307759.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317519\n", "files": ["browser/components/extensions/parent/ext-browser.js", "browser/components/extensions/test/browser/browser-windows.toml", "browser/components/extensions/test/browser/browser_ext_windows_update.js"], "git_node": "f4b81e1116263596532879d7e242057c43ec5036", "git_parents": ["1a2260a52a12a64a8e9accc2984cebe01825ec54"], "node": "36f5e150f4053514db7992c9f4d41424b97721cb", "parents": ["499850eba24cf21f6c134849a5db5ab0a3b5c2c2"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1971622 - Clamp the click point in synthesizeClickOnSelectedTreeCell to the tree body, and re-enable browser_ext_contextMenus.js on linux2404 x11, r=places-reviewers,extension-reviewers,Standard8,robwu.\n\nFor a cell whose label does not fit, nsTreeBodyFrame::GetCoordsForCellItem\nreturns a rect overflowing its column, and in a narrow tree the midpoint of that\nrect - which this helper clicks - falls outside the tree body entirely. That is\nhow browser_ext_contextMenus.js times out on linux2404 x11, where the Library\nwindow intermittently stays at its minimum size.\n\nThe platform defect is out of scope here, so clamp the rect to the tree body in\nthe helper. Both ends are clamped, since a horizontally scrolled tree can report\na rect starting left of the body.\n\nThis moves the click point in the other tests using this helper, always towards\nthe visible part of the cell; they were re-run on linux 24.04 x11 without\nchanges.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317520\n", "files": ["browser/components/extensions/test/browser/browser-menus.toml", "browser/components/places/tests/browser/head.js"], "git_node": "2258b28902ab3e15392b89dd1a3ee581d406bfb6", "git_parents": ["f4b81e1116263596532879d7e242057c43ec5036"], "node": "f2c2b2c829743e5fad46ea55051c6e4271e68cc9", "parents": ["36f5e150f4053514db7992c9f4d41424b97721cb"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1780998 - Restore the browser window size in browser_ext_windows_create_hidpi.js, so that it does not leave a window wider than the screen for the rest of browser-windows.toml, r=extension-reviewers,robwu.\n\nSetting layout.css.devPixelsPerPx to 3 raises the window's minimum width to 1500\nand grows the window to it; popping the pref does not shrink it back. The later\ntests in the manifest then run with a window wider than the screen on the macOS\n10.15 pool, where macOS constrains it back and browser_ext_windows_update.js\nfails on the mismatch.\n\nFixed in the test that grows the window rather than the one that trips over it,\nsince it breaks testPositionBoundaryCheck too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317529\n", "files": ["browser/components/extensions/test/browser/browser_ext_windows_create_hidpi.js"], "git_node": "0906bb75d23be6581f46897cbfc6ef74da32764b", "git_parents": ["2258b28902ab3e15392b89dd1a3ee581d406bfb6"], "node": "b20de3110846d8c7fe278dc604ff7788a579115e", "parents": ["f2c2b2c829743e5fad46ea55051c6e4271e68cc9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064855 - Count only the address bar's zero-prefix view. r=Standard8\n\n`#searchbar-new` and the smartbar have counted into these since they started sharing the view, which nobody revisited when the address bar stopped being its only consumer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319915\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-telemetry/browser_zeroPrefix.js"], "git_node": "46fac315452d7cace2701e3b5a31f42e93ac9ab6", "git_parents": ["0906bb75d23be6581f46897cbfc6ef74da32764b"], "node": "59659613cce2b99b7cc5121e708e0e980bdf1d76", "parents": ["b20de3110846d8c7fe278dc604ff7788a579115e"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061279 - Add \"Add a signature\" wireframe dialog r=android-reviewers,android-l10n-reviewers,parker,pollymce\n\nThis patch adds the UI for the \"Add a signature\" box dialog. Note that the functionality\nwill be connected in a later bug.\n\nSee Figma: https://www.figma.com/design/ppIRLQw1AAIeyaG7lwnn4R/PDF.js--Android-UI--Copy-?node-id=4157-25212&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321092\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolActions.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolsIntegration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolsTestTag.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/SignatureActions.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/SignatureState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/ui/SignatureDialog.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsContentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/ui/SignatureDialogTest.kt"], "git_node": "747e403effdcaebd857f7102fc5b80e3f3f996ea", "git_parents": ["46fac315452d7cace2701e3b5a31f42e93ac9ab6"], "node": "2cb87f52d35d9a7984659ed0bc3c8d451b07bddf", "parents": ["59659613cce2b99b7cc5121e708e0e980bdf1d76"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2066502 - Avoid un-throttling animations from reflow callbacks. r=layout-reviewers,boris\n\nThis saves some work that we don't need, specially if we're already\ndoing an interruptible reflow.\n\nThe original flush should've done that if required.\n\nThe test being tweaked was wrong, it was not putting the element into\nview (the element had top:100px and the parent was 100px).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321303\n", "files": ["dom/animation/test/mozilla/file_restyles.html", "layout/base/PresShell.cpp"], "git_node": "6fad9a2595c64b5d38f551287766bf906c2ef54b", "git_parents": ["747e403effdcaebd857f7102fc5b80e3f3f996ea"], "node": "75bfa563994ba059d03be3c2d2285989f71b99e7", "parents": ["2cb87f52d35d9a7984659ed0bc3c8d451b07bddf"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066752 - Put the newtab feature gate under Nimbus control. r=daleharvey,urlbar-reviewers\n\nThe pref becomes the variable's fallback, so both registrants read `newtabFeatureGate` instead: a raw pref read does not see an enrollment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321164\n", "files": ["browser/components/search/SearchUIUtils.sys.mjs", "browser/components/urlbar/UrlbarNewTabComponentRegistrant.sys.mjs", "browser/components/urlbar/tests/unit/test_UrlbarNewTabComponentRegistrant.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "5fe16b4623109512b9f990cb71543b645bda4207", "git_parents": ["6fad9a2595c64b5d38f551287766bf906c2ef54b"], "node": "d96f27a4f8da0249156bec2eebc1db13978e272e", "parents": ["75bfa563994ba059d03be3c2d2285989f71b99e7"], "tags": []}, {"author": "Brendan Abolivier \u003cbrendan@thunderbird.net\u003e", "branch": "default", "desc": "Bug 2066393 - Skip test_attributionData for non-browser projects. r=TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321185\n", "files": ["toolkit/components/utils/test/unit/test_ClientEnvironment.js"], "git_node": "c8cdacc8ec8e6a627c4f22bc288496cd06975004", "git_parents": ["5fe16b4623109512b9f990cb71543b645bda4207"], "node": "e93bb7512e8c88296963330d3b7d8777f446ffa6", "parents": ["d96f27a4f8da0249156bec2eebc1db13978e272e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064651 - Give the newtab search bar the search bar's recent searches. r=daleharvey,urlbar-reviewers,mbeier\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320997\n", "files": ["browser/components/urlbar/UrlbarProviderRecentSearches.sys.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/unit/test_UrlbarResult_wireSerialization.js", "browser/components/urlbar/tests/unit/test_providerRecentSearches.js"], "git_node": "564f97a95f4cee3202b2bbb1a1b027a8fbd31093", "git_parents": ["c8cdacc8ec8e6a627c4f22bc288496cd06975004"], "node": "c95a07592a9e2724510742b7bdbe9ccf3ab6f2de", "parents": ["e93bb7512e8c88296963330d3b7d8777f446ffa6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064651 - Keep the newtab search bar's form history when search suggestions are off. r=mbeier,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320999\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProviderSearchSuggestions.sys.mjs", "browser/components/urlbar/tests/unit/test_UrlbarProviderSearchSuggestions.js"], "git_node": "82981bb29ed3777e76d6d67f2138d10af2230704", "git_parents": ["564f97a95f4cee3202b2bbb1a1b027a8fbd31093"], "node": "121c5b0feb03fd4543a381b4c8d48f2738d74f4e", "parents": ["c95a07592a9e2724510742b7bdbe9ccf3ab6f2de"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064651 - Stop gating a search bar's search heuristic on keyword.enabled. r=mbeier,urlbar-reviewers\n\nThe switcher's globe icon and disabled-keyword tooltip stop applying to either search bar. The newtab search bar also takes an address, so until Bug 2066396 forces the keyword lookup, fixup still hands it a visit result before the provider's gate is reached.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321002\n", "files": ["browser/components/urlbar/UrlbarProviderHeuristicFallback.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/unit/test_providerHeuristicFallback.js"], "git_node": "875269e0765c8af110170fa6044a1c7f5d7401ed", "git_parents": ["82981bb29ed3777e76d6d67f2138d10af2230704"], "node": "ac30b03cd85a7bf1b2ad87331e84b2b2079b9e65", "parents": ["121c5b0feb03fd4543a381b4c8d48f2738d74f4e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064651 - Give a search bar the search mode switcher on its own terms. r=urlbar-reviewers,mbeier\n\nThe switcher's exemption from the two switcher prefs was keyed on the toolbar search bar's id, so with both off the newtab search bar lost the switcher and with it the only route into search mode a bar without one-off buttons has.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321003\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/themes/shared/urlbar.css"], "git_node": "8d0c98781472bea29d8f7fb43e1eac4a6f43239d", "git_parents": ["875269e0765c8af110170fa6044a1c7f5d7401ed"], "node": "4e1c5a02248248d15401841335632de9f2e760e0", "parents": ["ac30b03cd85a7bf1b2ad87331e84b2b2079b9e65"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064651 - Keep the newtab search bar's value when a result opens elsewhere. r=urlbar-reviewers,mbeier\n\nReverting a bar that isn't the address bar clears its value, so the newtab bar would empty itself when a result opens in a new tab or window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321000\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-newtab/browser_pickResult.js"], "git_node": "d7ec9245983dce608f437b728c8dfdf69856fe01", "git_parents": ["8d0c98781472bea29d8f7fb43e1eac4a6f43239d"], "node": "30f024bb9650a08ae9eeff2d7d5f4326bdbefd6d", "parents": ["4e1c5a02248248d15401841335632de9f2e760e0"], "tags": []}, {"author": "Dominik Bay \u003cdominik@bay.sh\u003e", "branch": "default", "desc": "Bug 2066736 - Validate filter array lengths in FilePickerParent::RecvOpen. r=dom-core-reviewers,smaug\n\nThe loop in RecvOpen counts with aFilters.Length() but reads\naFilterNames[i]. If a content process sends the message with more filters\nthan filterNames, the read goes out of bounds and the parent process\ncrashes. So I added a check that both arrays have the same length.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321511\n", "files": ["dom/ipc/FilePickerParent.cpp"], "git_node": "c06fc27a757114e7e7baed10917283231e133cfa", "git_parents": ["d7ec9245983dce608f437b728c8dfdf69856fe01"], "node": "0413dfc9e202aec57e1d188b062c0448c2772b66", "parents": ["30f024bb9650a08ae9eeff2d7d5f4326bdbefd6d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2066502 - Make PresShell::NeedFlush deal with throttled animations explicitly. r=layout-reviewers,jfkthame\n\nThis effectively doesn't change behavior but I noticed with the previous\npatch that we would enter in DoFlushPendingNotifications more often than\nneeded, and that the DOMWindowUtils code wasn't explicit about this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321512\n", "files": ["dom/base/nsDOMWindowUtils.cpp", "layout/base/PresShell.cpp", "layout/base/PresShell.h"], "git_node": "5778c1065518805bcfe979ac1b8e0b7858bb6a39", "git_parents": ["c06fc27a757114e7e7baed10917283231e133cfa"], "node": "b26fcd578f2984b4efcf6c7aecdd92baaf75c493", "parents": ["0413dfc9e202aec57e1d188b062c0448c2772b66"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2054442 - [wdspec] Fix test name for mouse move in duration.py r=jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321456\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/duration.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/duration.py"], "git_node": "22ef0508ad15c5cae2ac4e7e0c1cdd693ddeaaf2", "git_parents": ["5778c1065518805bcfe979ac1b8e0b7858bb6a39"], "node": "0eb51efc817b147969c5563d59d0a833d1dfe41d", "parents": ["b26fcd578f2984b4efcf6c7aecdd92baaf75c493"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2066681 - [loong64] Stop generating no-op self addi.d. r=jandem\n\nThis is found by LoongLint on the JitDump file produced by running\nOctane with --strict-benchmark-mode.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321469\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "659627b276e2dc99d4bec096acb14d9ad94327e4", "git_parents": ["22ef0508ad15c5cae2ac4e7e0c1cdd693ddeaaf2"], "node": "13de058be545a5d41f89778562679e5129a97a36", "parents": ["0eb51efc817b147969c5563d59d0a833d1dfe41d"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065714 - Don't run incremental marking verification until all marking is finished r=spidermonkey-reviewers,jandem\n\nBug 2057457 made the part where we mark atoms referenced by uncollected zones\nhappen later, so that it happened after the optional incremental marking\nverification. Thus cases where an atom is only held alive by refereces from\nuncollected zones will cause incremental marking validation to fail if enabled.\n\nThe fix is to move validation to after we have done this marking.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321501\n", "files": ["js/src/gc/Sweeping.cpp", "js/src/jit-test/tests/gc/bug-2065714.js"], "git_node": "d863c156479d3e6559947f52e6bf1e48383de74e", "git_parents": ["659627b276e2dc99d4bec096acb14d9ad94327e4"], "node": "2701000e7bd2abff465383a534b232bf299b71e1", "parents": ["13de058be545a5d41f89778562679e5129a97a36"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061994 - Fix regression on sensor update timer condition r=gsvelto\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320147\n", "files": ["hal/cocoa/CocoaSensor.mm"], "git_node": "e812a8370fb743c3be05efcd60da69e54751b720", "git_parents": ["d863c156479d3e6559947f52e6bf1e48383de74e"], "node": "8d9852e28828ff22d657b633fae73ae48624d7d7", "parents": ["2701000e7bd2abff465383a534b232bf299b71e1"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054565: Leave keystrokes that carry no Command modifier to native windows that have focus on macOS. r=mac-reviewers,mstange\n\nThe Edit \u003e Delete menu item carries the forward delete key as its shortcut, with no modifiers, because it is wired to the XUL key element with keycode=\"VK_DELETE\". Since bug 2036608 the item's action is delete: with no target, so it travels the macOS responder chain, and since bug 2040851 the item is always enabled. While a native window such as an NSSavePanel sheet has focus, AppKit therefore matches the forward delete key against our menu item and performs delete: instead of leaving the keystroke alone. The panel's filename field reads delete: as \"delete the current selection\", so with a collapsed caret nothing happens at all and the keystroke is spent.\n\nNative text fields read keys that arrive without a Command modifier as plain editing or navigation keys, so leave those keys to the window that has focus. Shortcuts that include Command are still handled here, which is what lets native fields respond to Command+C/V/X/Z/A.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316554\n", "files": ["widget/cocoa/nsMenuBarX.mm"], "git_node": "1dc10ba9f2983a97ae7b1843bfcf767a70b5d78d", "git_parents": ["e812a8370fb743c3be05efcd60da69e54751b720"], "node": "f3cd87e96051f1d797ce64d60b36353072134f35", "parents": ["8d9852e28828ff22d657b633fae73ae48624d7d7"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060306: Skip menu-bar key-equivalent processing for keystrokes that carry no Command modifier on macOS. r=mac-reviewers,mstange\n\nSince bug 2040851 the standard Edit menu items are always enabled, so AppKit matches the Edit \u003e Delete item, whose shortcut is the forward delete key with no modifiers, on every forward delete keypress. While a Gecko window has focus the item does not run its command, because gMenuItemsExecuteCommands is NO, but AppKit still flashes the menu title on each match and that cost is paid per keystroke. A small standalone AppKit test app that mimics this setup drains forward delete events at roughly 53 ms each with the item enabled, against roughly 2 ms with it disabled or with the keystroke left alone, so holding forward delete deletes far more slowly than the keyboard repeat rate the OS is set to.\n\nHandle only shortcuts that include Command in the menu bar, whichever window has focus, and leave plain keys to that window. Menu items were already kept from running their commands while a Gecko window has focus, and a shortcut that Gecko does not handle still reaches the menu bar afterwards through nsCocoaWindow::PostHandleKeyEvent, so what goes away here is the menu flash for these keys.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316558\n", "files": ["widget/cocoa/nsMenuBarX.mm"], "git_node": "f307297e65d0a8ab5ea41f4f7d41951492d04669", "git_parents": ["1dc10ba9f2983a97ae7b1843bfcf767a70b5d78d"], "node": "b4d3efa445bc338dfaddf34e3fac93203aaa5e05", "parents": ["f3cd87e96051f1d797ce64d60b36353072134f35"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2065899 - Hide the app menu sign-in promo when Mozilla accounts are disabled. r=nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320955\n", "files": ["browser/base/content/test/sync/browser_sync.js", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "84eadd1a782e24e754b941a618b90266c6844137", "git_parents": ["f307297e65d0a8ab5ea41f4f7d41951492d04669"], "node": "1deacb66f268f27fc5fba1c39d41cc60126ae25b", "parents": ["b4d3efa445bc338dfaddf34e3fac93203aaa5e05"], "tags": []}, {"author": "avirvara \u003cavirvara@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064816: add new module for listen to page feature r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321464\n", "files": ["gradle/libs.versions.toml", "mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/feature/listentopage/README.md", "mobile/android/android-components/components/feature/listentopage/build.gradle", "mobile/android/android-components/components/feature/listentopage/lint-baseline.xml", "mobile/android/android-components/components/feature/listentopage/progua