67c0019887fdeb133bd2bab554a29a575747e", "dd2579cb6e7f1761a27ce64fb84d92c61d85c27f"], "user": "archaeopteryx@coole-files.de"}, "45100": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 71302855625d5bfc0352ff18192d1cd0c6d95553 with FIREFOX-ANDROID_154_0_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "81d7d57a282bb4e92dbdd75af6b67dd19aca269d", "git_parents": ["318f11b66277b3929da2e5f348f1b0b385d6446f"], "node": "93cee7dd05fa20dbc6d60a766ec957b593020548", "parents": ["e1b753e28d153309e483e1058aff81899cf1becd"], "tags": []}], "date": 1786753035, "git_changesets": ["81d7d57a282bb4e92dbdd75af6b67dd19aca269d"], "user": "ffxbld@lando.moz.tools"}, "45101": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058618 - Remove some obsolete stuff from gfxFontEntry. r=gfx-reviewers,lsalzman\n\n(Preliminary cleanup, no functional change.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318732\n", "files": ["gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxHarfBuzzShaper.cpp"], "git_node": "f0a35a5588781c5a88a6f7166ff4411bf492a8b9", "git_parents": ["f85227cec4becbad14c9673bf2101b9d6a19dcf3"], "node": "318e1d90b3a3c75e0a1bd2af1d9633617f79be00", "parents": ["bbb405c989696975295e78ddbc00a2f0dffca223"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058618 - Guard mCharacterMap with the gfxFontEntry's RWLock. r=gfx-reviewers,lsalzman\n\nIt's kept as an atomic ptr so that we can check for existence without needing to lock;\nwe only need to lock around mutations (write) or dereferencing (read).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318733\n", "files": ["gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxUserFontSet.cpp", "gfx/thebes/gfxUserFontSet.h"], "git_node": "9606294ac903ac9bc848c0d7ba1df20ea5b88653", "git_parents": ["f0a35a5588781c5a88a6f7166ff4411bf492a8b9"], "node": "a178c8b5cf557091b66503838a42410402f55ddd", "parents": ["318e1d90b3a3c75e0a1bd2af1d9633617f79be00"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2058618: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxUserFontSet.cpp"], "git_node": "fc80e4d55a5affbbfbc8aff5eee90a2c1a911a25", "git_parents": ["9606294ac903ac9bc848c0d7ba1df20ea5b88653"], "node": "8e313a0ba43dbb79899c75db6a1053be202267dd", "parents": ["a178c8b5cf557091b66503838a42410402f55ddd"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Make android-gradle-plugins tasks clone with Git, r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318738\n", "files": ["taskcluster/kinds/source-test/android-gradle-plugins.yml"], "git_node": "f3697c71e56a0bba4dbdabbe2f790554256cffca", "git_parents": ["fc80e4d55a5affbbfbc8aff5eee90a2c1a911a25"], "node": "07bdbffeb5ab3e424ef05cb736182083f18ba14a", "parents": ["8e313a0ba43dbb79899c75db6a1053be202267dd"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1974953 - Gate promisePopupNotificationShown on the notification panel being open, r=extension-reviewers,rpl.\n\nThese four copies of the helper resolve on any popupshown while\nPopupNotifications.isPanelOpen, which is also true while the panel is still\nshowing. Nothing in a panel in that state is focusable, so a test that clicks a\nbutton in it fails the a11y check with the misleading \"Node is not focusable via\nthe accessibility API\".\n\nGate them on panel.state == \"open\", as bug 2056652 did for the update doorhanger\ntests. This is a stopgap for bug 2062538, the platform bug that dispatches\npopupshown for a popup that is no longer open; the stack there removes these\ngates again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317515\n", "files": ["browser/base/content/test/webextensions/head.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_extensionsettings.js", "browser/components/extensions/test/browser/head.js", "toolkit/mozapps/extensions/test/browser/head.js"], "git_node": "fcb868bd2f421d892d296372d21b0ec094051289", "git_parents": ["f3697c71e56a0bba4dbdabbe2f790554256cffca"], "node": "0b3c3144e4fcb4ed2b801b3d6cf8b7b5e7b671f9", "parents": ["07bdbffeb5ab3e424ef05cb736182083f18ba14a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1974953 - Re-arm the webrtc promisePopupNotificationShown listener when the panel is not open yet, r=extension-reviewers,rpl.\n\nSame fix as the previous commit, for the copy in\nbrowser/base/content/test/webrtc/head.js. This one has to keep listening after\nan event it ignores, so the listener becomes a re-armable named function rather\nthan a once-only anonymous one. Its three assertions are unchanged.\n\nAs it is no longer once-only, a cleanup function removes it at the end of the\ntest file, so that a call whose promise never resolves can't leave it registered\non a window that later test files reuse.\n\nA test in this directory whose panel never reaches the open state now times out\ninstead of clicking an invisible node.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317516\n", "files": ["browser/base/content/test/webrtc/head.js"], "git_node": "66314471ff8cafcd1d54067afbad852a93b8c234", "git_parents": ["fcb868bd2f421d892d296372d21b0ec094051289"], "node": "4818200ae0773bff510e444838075adecf198069", "parents": ["0b3c3144e4fcb4ed2b801b3d6cf8b7b5e7b671f9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060888 - Resolve a tab-switch result's container in the provider instead of in UrlbarView. r=mbeier\n\nContextualIdentityService is parent-only: it reads containers.json from the\nprofile directory synchronously at module scope, so a content-process urlbar\ncan never import it. The view needs only a label, a color and an icon URL, so\nthe providers resolve them alongside the container id they already put in the\npayload, the way the switch-to-tab secondary action already does.\n\nThe id and its display data are now one `userContext` payload object. The id\nis still needed on its own -- the input uses it to perform the switch and the\nmuxer keys tab dedupe on it, including for tabs whose container has no public\nidentity, where there is nothing to display. `userContext` itself stays\noptional, as `userContextId` was, so a tab-switch result carrying no container\nid is still tolerated by the muxer and the input.\n\nBoth chiclet paths, Proton and Nova, read that payload; neither resolves a\ncontainer any more. The label is trimmed where it's resolved, so both see the\nsame string -- the Nova path used to trim and the Proton path didn't.\n\nTwo behavior differences, both in cases that shouldn't occur: a public identity\nwith an empty label renders nothing instead of an empty colored box, since the\nProton chiclet keys off the resolved label rather than the identity's existence;\nand a whitespace-only label now renders nothing there too.\n\nNote the flicker guard in #addContextualIdentityToSwitchTabChiclet compares an\nelement against a string, so it never fires. Left as-is.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317491\n", "files": ["browser/components/contextualidentity/test/browser/bro