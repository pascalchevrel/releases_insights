bpage/TabLayoutTest.kt"], "git_node": "9fe07038788cf8c69c1b1942060b9c5eda9a6bb3", "git_parents": ["6c6a9831f02c14e64c4a7e0360226ae66bbc9b48"], "node": "1c960582f1ec568e5efc9eacc2fb0a04263ee1ad", "parents": ["bc79c94bce0b0622efea345797060f1aa91f2552"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040670 part 2 : Add custom accessibility actions for reordering tabs r=android-reviewers,android-l10n-reviewers,parker,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316135\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/TabGroupCard.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabitems/TabGridTabItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabCollectionSemantics.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayout.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabReorderAccessibilityActions.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabReorderGeometry.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/tabpage/TabReorderGeometryTest.kt"], "git_node": "9cbd7b812cb97bf9169bfa589c1b7c98e38e3ecc", "git_parents": ["9fe07038788cf8c69c1b1942060b9c5eda9a6bb3"], "node": "f7a47ee859ad3ad5d1a3a12b7b18ad453b881f7d", "parents": ["1c960582f1ec568e5efc9eacc2fb0a04263ee1ad"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052424 - Fix sidebar animation by removing no-longer-needed nova animation branch. r=jsudiaman\n\n- Turns out the chrome gaps was what broke this. Removing that whole branch for nova fixes it\n- Add a test to assert on animation behavior\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318855\n", "files": ["browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_sidebar_animation.js"], "git_node": "40e9b3bcbe42a8238ee684b49a30aa7ced3fc069", "git_parents": ["9cbd7b812cb97bf9169bfa589c1b7c98e38e3ecc"], "node": "9de9948125e9caf288f57f93be4d27d1ab280771", "parents": ["f7a47ee859ad3ad5d1a3a12b7b18ad453b881f7d"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 1930510 - Copy Clean Link: Support applying rule to whole site r=manuel\n\nAdd a new \"schemelessSites\" property to the strip-on-share schema to\nallow applying query stripping rules across all subdomains of a base\ndomain.\n\nThis is implemented by extracting the base domain via nsIEffectiveTLDService\nduring URL evaluation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317452\n", "files": ["dom/chrome-webidl/StripOnShareRule.webidl", "toolkit/components/antitracking/URLQueryStringStripper.cpp", "toolkit/components/antitracking/URLQueryStringStripper.h", "toolkit/components/antitracking/URLQueryStrippingListService.sys.mjs", "toolkit/components/antitracking/jar.mn", "toolkit/components/antitracking/nsIURLQueryStrippingListService.idl", "toolkit/components/antitracking/test/xpcshell/test_strip_on_share_list.js", "toolkit/components/antitracking/test/xpcshell/test_validate_strip_on_share_list.js", "toolkit/components/antitracking/test/xpcshell/xpcshell.toml"], "git_node": "f7d1be448b4a7895064fafc3c9ca635d768c95c5", "git_parents": ["40e9b3bcbe42a8238ee684b49a30aa7ced3fc069"], "node": "e6a41f7f6a874e4d5ef3288696df828b99363f66", "parents": ["9de9948125e9caf288f57f93be4d27d1ab280771"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060283 - Basic layout and image positioning for FRO template r=omc-reviewers,mviar,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317122\n", "files": ["browser/base/content/test/static/browser_all_files_referenced.js", "browser/components/aboutwelcome/assets/backdrop-adaptive.svg", "browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aboutwelcome/jar.mn", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_configurable_ui.js", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "95c42dd7f58818e8d9f1b62e7d72b90233bc76aa", "git_parents": ["f7d1be448b4a7895064fafc3c9ca635d768c95c5"], "node": "7d798e1b19b6783c8df9fcd3f471b46a994c8ac1", "parents": ["e6a41f7f6a874e4d5ef3288696df828b99363f66"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2058496 - Deal with SVG context paint properly in border-image fast path. r=dshin\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/335\n", "files": ["layout/painting/nsImageRenderer.cpp", "testing/web-platform/tests/css/css-borders/border-image-color-scheme-ref.html", "testing/web-platform/tests/css/css-borders/border-image-color-scheme.html"], "git_node": "d3e74196e6b6f6a24fb02bd234122c04505a9438", "git_parents": ["95c42dd7f58818e8d9f1b62e7d72b90233bc76aa"], "node": "cff7d7d09394c4ee9fee1eda4a428626dc251189", "parents": ["7d798e1b19b6783c8df9fcd3f471b46a994c8ac1"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064447: Force an updatebot docker rebuild r=calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319572\n", "files": ["taskcluster/docker/updatebot/run.py"], "git_node": "21c2372e31d6ba7ea1b56f6195e88a5475fe9029", "git_parents": ["d3e74196e6b6f6a24fb02bd234122c04505a9438"], "node": "0d7ade44d13de8657a49d560072e8aa9b66a0a44", "parents": ["cff7d7d09394c4ee9fee1eda4a428626dc251189"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056357 - Part 1: Unify IPDL actor devirutalization logic, and require types to be fully qualified, r=ipc-reviewers,necko-reviewers,dom-storage-reviewers,jesup,mccr8\n\nThe devirtualization logic which was previously used was imprecise, and\npreviously didn't require the type name to be fully qualified. This\npatch updates the logic to require full qualification of the type from\nIPDL, which will be necessary for later parts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316602\n", "files": ["dom/filesystem/PFileSystemRequest.ipdl", "dom/indexedDB/PBackgroundIDBCursor.ipdl", "dom/indexedDB/PBackgroundIDBDatabase.ipdl", "dom/indexedDB/PBackgroundIDBFactory.ipdl", "dom/indexedDB/PBackgroundIDBFactoryRequest.ipdl", "dom/indexedDB/PBackgroundIDBRequest.ipdl", "dom/indexedDB/PBackgroundIDBTransaction.ipdl", "dom/indexedDB/PBackgroundIDBVersionChangeTransaction.ipdl", "dom/indexedDB/PBackgroundIndexedDBUtils.ipdl", "dom/ipc/PURLClassifierLocal.ipdl", "dom/ipc/PURLClassifierLocalByName.ipdl", "dom/media/gmp/PChromiumCDM.ipdl", "dom/media/gmp/PGMP.ipdl", "dom/media/gmp/PGMPContent.ipdl", "dom/media/gmp/PGMPStorage.ipdl", "dom/media/gmp/PGMPTimer.ipdl", "dom/media/gmp/PGMPVideoDecoder.ipdl", "dom/media/gmp/PGMPVideoEncoder.ipdl", "dom/media/ipc/PRemoteEncoder.ipdl", "dom/media/systemservices/PMedia.ipdl", "dom/media/webrtc/PMediaTransport.ipdl", "dom/storage/PBackgroundSessionStorageService.ipdl", "extensions/spellcheck/ipc/PRemoteSpellcheckEngine.ipdl", "gfx/layers/ipc/PAPZ.ipdl", "gfx/layers/ipc/PCanvas.ipdl", "gfx/layers/ipc/PCompositorBridge.ipdl", "gfx/vr/ipc/PVR.ipdl", "gfx/vr/ipc/PVRGPU.ipdl", "gfx/vr/ipc/PVRLayer.ipdl", "gfx/vr/ipc/PVRManager.ipdl", "ipc/ipdl/ipdl/lower.py", "ipc/testshell/PTestShellCommand.ipdl", "js/xpconnect/loader/PScriptCache.ipdl", "netwerk/protocol/websocket/PTransportProvider.ipdl", "netwerk/protocol/websocket/PWebSocket.ipdl"], "git_node": "bba02ee0e47dc62d9ce3802aa724e853310e64dd", "git_parents": ["21c2372e31d6ba7ea1b56f6195e88a5475fe9029"], "node": "e35fa980ffd8c49389bd0f4bd5c7b276eafd5c27", "parents": ["0d7ade44d13de8657a49d560072e8aa9b66a0a44"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056357 - Part 2: Add a helper method for IProtocol -\u003e actor downcasts, r=ipc-reviewers,mccr8\n\nThis new approach adds a type trait (ActorTraits), and a helper method\n(IProtocol::ActorCast) to perform the downcast. Thanks to the new downcast\nhelper, we can also move the ParamTraits implementation for protocol types into\nC++, reducing the amount of generated code slightly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316603\n", "files": ["ipc/glue/ProtocolMessageUtils.h", "ipc/glue/ProtocolUtils.h", "ipc/ipdl/ipdl/lower.py"], "git_node": "fb1f8a5abcd9899b6363decff96a27def14e1087", "git_parents": ["bba02ee0e47dc62d9ce3802aa724e853310e64dd"], "node": "f4b17b79babfe998b87e8e8f7da915b472f00842", "parents": ["e35fa980ffd8c49389bd0f4bd5c7b276eafd5c27"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056357 - Part 3: Use ActorDynCast instead of manual downcasting, r=ipc-reviewers,media-playback-reviewers,padenot,mccr8\n\nThere are a few places where we have previously manually checked the\nProtocolId and/or side to do manual downcasting, which can now use\nActorDynCast instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316604\n", "files": ["docshell/base/BrowsingContextGroup.cpp", "docshell/base/nsDocShellLoadState.cpp", "dom/media/ipc/RemoteImageHolder.cpp", "gfx/ipc/CanvasManagerParent.cpp", "gfx/layers/composite/TextureHost.cpp", "gfx/layers/ipc/CanvasTranslator.cpp"], "git_node": "4b90b548786689ab2fda44adc9a461e41eae9dff", "git_parents": ["fb1f8a5abcd9899b6363decff96a27def14e1087"], "node": "c7d319173badf6dfff9dec4782a02920c2371d1b", "parents": ["f4b17b79babfe998b87e8e8f7da915b472f00842"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056357 - Part 4: Use ActorCast in more places, r=ipc-reviewers,media-playback-reviewers,cookie-reviewers,dom-worker-reviewers,padenot,baku,edenchuang,mccr8\n\nThere are a number of places which were doing manual static_casts to\nconvert from actor types to their concrete types. Change a number of\nthese callers to use the new safe ActorCast helper instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316605\n", "files": ["dom/base/nsContentPermissionHelper.cpp", "dom/credentialmanagement/identity/WebIdentityParent.cpp", "dom/credentialmanagement/identity/WebIdentityParent.h", "dom/ipc/BrowserBridgeChild.h", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/ContentParent.cpp", "dom/locks/LockManagerParent.cpp", "dom/locks/LockRequestChild.cpp", "dom/locks/LockRequestParent.cpp", "dom/media/ipc/RemoteDecoderChild.cpp", "dom/media/ipc/RemoteMediaDataEncoder.cpp", "dom/serviceworkers/FetchEventOpChild.cpp", "dom/serviceworkers/FetchEventOpProxyChild.cpp", "dom/webauthn/WebAuthnTransactionParent.cpp", "dom/webserial/SerialManagerParent.cpp", "dom/workers/remoteworkers/RemoteWorkerChild.cpp", "dom/workers/remoteworkers/RemoteWorkerControllerParent.cpp", "dom/workers/remoteworkers/RemoteWorkerServiceChild.cpp", "gfx/layers/ipc/CanvasChild.cpp", "gfx/layers/wr/WebRenderBridgeChild.cpp", "ipc/glue/BackgroundChildImpl.cpp", "ipc/glue/BackgroundParentImpl.cpp", "ipc/testshell/TestShellParent.cpp", "netwerk/base/SimpleChannel.cpp", "netwerk/cookie/CookieServiceChild.cpp", "netwerk/dns/DNSRequestChild.cpp", "netwerk/ipc/DocumentChannelParent.cpp", "netwerk/ipc/NeckoChild.cpp", "netwerk/ipc/NeckoParent.cpp", "netwerk/ipc/SocketProcessChild.cpp", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/protocol/data/nsDataChannel.cpp", "netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelParent.cpp", "netwerk/protocol/websocket/WebSocketChannelChild.cpp"], "git_node": "c1d4320c34317d3e86df23ff264d756db9ef3273", "git_parents": ["4b90b548786689ab2fda44adc9a461e41eae9dff"], "node": "9228939b41e64500bf73adda7781bb83ded742d3", "parents": ["c7d319173badf6dfff9dec4782a02920c2371d1b"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2064249, part 1 - Remove the use of do_GetClassObject from ErrorReporter. r=firefox-style-system-reviewers,layout-reviewers,dholbert,emilio\n\nThis is the only use of this particular helper, and it is probably faster to\nuse a direct static component Create method.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319295\n", "files": ["layout/build/components.conf", "layout/style/ErrorReporter.cpp"], "git_node": "8b9a460e153391f4ba637ce9b3c3fdce3a0b18e6", "git_parents": ["c1d4320c34317d3e86df23ff264d756db9ef3273"], "node": "3687f84eb40717e3ce1d688709a2c6d008e404d4", "parents": ["9228939b41e64500bf73adda7781bb83ded742d3"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2064249, part 2 - Clean up some contract ID gunk in XPConnect. r=nika\n\nNot very related to the other patch, except that I use the static\ncomponent create method it added. I also cleaned up a few null\nchecks while I was there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319296\n", "files": ["js/xpconnect/src/XPCWrappedJSClass.cpp", "js/xpconnect/src/nsXPConnect.cpp", "js/xpconnect/src/xpcprivate.h"], "git_node": "eb8aaf2fd4b96149797bacb29f28025501ca755f", "git_parents": ["8b9a460e153391f4ba637ce9b3c3fdce3a0b18e6"], "node": "24c385c85f7457e939326aaba06340c7aedfff7b", "parents": ["3687f84eb40717e3ce1d688709a2c6d008e404d4"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064332 - Use template's document registry for elements parsed via innerHTML r=dom-core-reviewers,edgar\n\nWhen setting innerHTML on a node with a scoped custom element registry, elements\ncreated inside a nested \u003ctemplate\u003e are created in the template contents document\nrather than the parse target's document. They must use the template contents\ndocument's registry (global), not inherit the scoped context registry of the\nparse target.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319461\n", "files": ["dom/base/FragmentOrElement.cpp", "parser/html/nsHtml5TreeOperation.cpp", "testing/web-platform/meta/custom-elements/registries/Element-innerHTML.html.ini", "testing/web-platform/meta/custom-elements/registries/ShadowRoot-innerHTML.html.ini"], "git_node": "9e6897abba1a37bc30a8cd2676c32a9743cd6a8d", "git_parents": ["eb8aaf2fd4b96149797bacb29f28025501ca755f"], "node": "86efdb0e25245a054f1edf72ed651b15194af97e", "parents": ["24c385c85f7457e939326aaba06340c7aedfff7b"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2062057 [wpt PR 61828] - Update Test262 tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate Test262 tests\n\n--\n\nwpt-commits: 50c4e5be1196d6fb0c11fdd2602d377b7ce0bd55\nwpt-pr: 61828\n", "files": ["testing/web-platform/tests/third_party/test262/harness/assert.js", "testing/web-platform/tests/third_party/test262/harness/asyncHelpers.js", "testing/web-platform/tests/third_party/test262/harness/compareArray.js", "testing/web-platform/tests/third_party/test262/harness/nativeErrors.js", "testing/web-platform/tests/third_party/test262/harness/propertyHelper.js", "testing/web-platform/tests/third_party/test262/harness/prox