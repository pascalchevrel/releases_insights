 "testing/web-platform/tests/html/canvas/offscreen/reset/2d.reset.state.clip.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.drawing.style.reset.fontKerning.none2.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.fontVariantCaps.after.reset.font.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.fontVariantCaps1.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.fontVariantCaps3.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.fontVariantCaps4.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.fontVariantCaps5.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.fontVariantCaps6.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.measure.fillTextCluster-align.tentative.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.measure.fillTextCluster-baseline.tentative.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.measure.fillTextCluster-drawing-styles-change.tentative.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.measure.fillTextCluster-font-change.tentative.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.measure.strokeTextCluster-align.tentative.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.measure.strokeTextCluster-baseline.tentative.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.measure.strokeTextCluster-drawing-styles-change.tentative.w.html", "testing/web-platform/tests/html/canvas/offscreen/text/2d.text.measure.strokeTextCluster-font-change.tentative.w.html", "testing/web-platform/tests/html/canvas/tools/templates/reftest_worker.html", "testing/web-platform/tests/html/canvas/tools/templates/reftest_worker_grid.html"], "git_node": "04da66d5265e28946db361af91d582725f2bb3a0", "git_parents": ["e0562b8177a94617f3bfd409f34014fcf68f5ff4"], "node": "abe2c34ff68e156ff79a9cb70d69d2ceea893c58", "parents": ["e34dd7a8c21a04d5fed79188fc0499796262ffc8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056800 [wpt PR 61471] - Update wpt metadata, a=testonly\n\nwpt-pr: 61471\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/scroll-markers/scroll-button-universal-before.html.ini"], "git_node": "e0ff45e712dbbf001e132ffed37d2af7fdded9e5", "git_parents": ["04da66d5265e28946db361af91d582725f2bb3a0"], "node": "8a924277dce697d8ce1fd9cac27aea9c3e1a8258", "parents": ["abe2c34ff68e156ff79a9cb70d69d2ceea893c58"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2062453 [wpt PR 61841] - Add long timeout to ignore-content-type WPT, a=testonly\n\nAutomatic update from web-platform-tests\nAdd long timeout to ignore-content-type WPT\n\nThis test has been flakily timing out on mac, and adding a long timeout\ncould help. I was not able to reproduce the timeout locally.\n\nBug: 544202039\nChange-Id: I32b8d2c2b531266ef489c998dd9fe462a0454cd4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8231502\nAuto-Submit: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: David Grogan \u003cdgrogan@chromium.org\u003e\nReviewed-by: David Grogan \u003cdgrogan@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1676823}\n\n--\n\nwpt-commits: fcc060d9adb4a1bc227a6bddfe2116fdfe5ac74b\nwpt-pr: 61841\n", "files": ["testing/web-platform/tests/html/semantics/scripting-1/the-script-element/text-module/ignore-content-type.any.js"], "git_node": "484b35abaa0f6db8fbfe12634f4c571f6e33b481", "git_parents": ["e0ff45e712dbbf001e132ffed37d2af7fdded9e5"], "node": "edeebd23ee579b6558ac95226a8ebb4cd92114c4", "parents": ["8a924277dce697d8ce1fd9cac27aea9c3e1a8258"], "tags": []}, {"author": "Javier Contreras Tenorio \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2062443 [wpt PR 61840] - [gap-decorations] Fix for auto iterator bug, a=testonly\n\nAutomatic update from web-platform-tests\n[gap-decorations] Fix for auto iterator bug\n\nWhile working on another change I found a bug with auto repeaters in gap\ndecorations. With something like `repeat(auto, red), blue, green;` in a\ncontainer that only has two gaps.\n\nThe spec defines auto repeater as filling gaps that \"would not otherwise\nreceive values from other parts of the list\".\nhttps://www.w3.org/TR/css-gaps-1/#lists-repeat.\n\nWe had a bug in blink that with the example above, we would show `red\nred` rather than `blue green`.\n\nThis CL addresses this bug and adds a WPT test for it\n\nChange-Id: Ib01f13b3e302114369e9d428c45260526e29c9fb\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8233400\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1676821}\n\n--\n\nwpt-commits: f3d30c116e82b06f72831f27b7fe94a2f8114030\nwpt-pr: 61840\n", "files": ["testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-068-ref.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-068.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-069-ref.html", "testing/web-platform/tests/css/css-gaps/flex/flex-gap-decorations-069.html"], "git_node": "64e00ad3ae4efd7a1b3d7057081a6e0a804c0d80", "git_parents": ["484b35abaa0f6db8fbfe12634f4c571f6e33b481"], "node": "331467ac1d382182e2daece844e5999075181ee6", "parents": ["edeebd23ee579b6558ac95226a8ebb4cd92114c4"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062443 [wpt PR 61840] - Update wpt metadata, a=testonly\n\nwpt-pr: 61840\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-gaps/flex/flex-gap-decorations-068.html.ini"], "git_node": "d255626077649e612896a36c3c2931e4cfedf78e", "git_parents": ["64e00ad3ae4efd7a1b3d7057081a6e0a804c0d80"], "node": "946997a7082fe32030fd83728b8c5b1dad39e0a4", "parents": ["331467ac1d382182e2daece844e5999075181ee6"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2062462 [wpt PR 61843] - Clamp shape-outside line opportunities to available inline-size, a=testonly\n\nAutomatic update from web-platform-tests\nClamp shape-outside line opportunities to available inline-size\n\nWhen a float with shape-outside is wider than the available\ninline-size, CreateLayoutOpportunity() pushes the degenerate rect's\nline-end past the available space and lines next to the shape were\nlaid out wider than the containing block; clamp the line-right in\nComputeLineLayoutOpportunity(), keeping it \u003e= line-left so lines that\ncannot fit still advance to the next opportunity.\n\nBug: 420443621\nChange-Id: I41b1d1857416bd153cc41670eb284a666e6d2f85\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8177889\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nCr-Commit-Position: refs/heads/main@{#1676877}\n\n--\n\nwpt-commits: 9944d8fe9d4d28aa4036625e50f0e295287bac58\nwpt-pr: 61843\n", "files": ["testing/web-platform/tests/css/css-shapes/shape-outside/supported-shapes/ellipse/reference/shape-outside-ellipse-054-ref.html", "testing/web-platform/tests/css/css-shapes/shape-outside/supported-shapes/ellipse/shape-outside-ellipse-054.html"], "git_node": "6637a7a77ee3b12a14d145784c6e9939197ced03", "git_parents": ["d255626077649e612896a36c3c2931e4cfedf78e"], "node": "27d42c476fe7c5c1d4fce69fcd01670827d12a10", "parents": ["946997a7082fe32030fd83728b8c5b1dad39e0a4"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2062459 [wpt PR 61842] - Make negative-width layout opportunities direction-aware, a=testonly\n\nAutomatic update from web-platform-tests\nMake negative-width layout opportunities direction-aware\n\nPass text direction through exclusion-space queries so oversized floats\ncollapse zero-width opportunities at the dominant side.\n\nBug: none\nChange-Id: Icbed1afa09f6eb30a7d65ade8514bb36718bbee7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8223905\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1676887}\n\n--\n\nwpt-commits: 0d00deb15eb71c79c0aaacf048e9508a44b9e7bd\nwpt-pr: 61842\n", "files": ["testing/web-platform/tests/css/css-shapes/shape-outside/shape-box/shape-outside-border-box-oversized-float-direction.html"], "git_node": "59fda1ef0594eb605540a7a9da001ef9470054d1", "git_parents": ["6637a7a77ee3b12a14d145784c6e9939197ced03"], "node": "1a560791d20bc4743f9c289109b5ca2920d37484", "parents": ["27d42c476fe7c5c1d4fce69fcd01670827d12a10"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2062437 [wpt PR 61839] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321383, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=321383 (#61839)\n--\n\nwpt-commits: 8e52ec8ba284b2faf220eb5a4428cd49da48cfec\nwpt-pr: 61839\n", "files": ["testing/web-platform/tests/webaudio/the-audio-api/the-audioparam-interface/audioparam-zero-duration-ramp.html"], "git_node": "5e736ee725d908d61d9d849485382547d2c25d93", "git_parents": ["59fda1ef0594eb605540a7a9da001ef9470054d1"], "node": "8246d2c3fa4b111edceac248f71a9f074c9cef82", "parents": ["1a560791d20bc4743f9c289109b5ca2920d37484"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2060421 [wpt PR 61701] - Fix remaining zoom inheritance failures, a=testonly\n\nAutomatic update from web-platform-tests\nFix remaining zoom inheritance failures\n\nRecompute zoom-sensitive inherited values and correct malformed zoom WPTs\nso every supported case passes.\n\nBug: 420443621\nChange-Id: I3774b5c18246697af45bc5dab57612453d9516e5\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8165187\nReviewed-by: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1676898}\n\n--\n\nwpt-commits: cc02a988060d9e43c30b39c2551472129277cde5\nwpt-pr: 61701\n", "files": ["testing/web-platform/tests/css/css-viewport/zoom/perspective.html", "testing/web-platform/tests/css/css-viewport/zoom/reference/box-shadow-inset-spread-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/reference/outline-offset-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/transform-perspective.html"], "git_node": "0b49b6c303785043bce2f91655abcb7426f85b07", "git_parents": ["5e736ee725d908d61d9d849485382547d2c25d93"], "node": "da85cef377e7032abcf0dd6275d1627c39cb0d0e", "parents": ["8246d2c3fa4b111edceac248f71a9f074c9cef82"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060421 [wpt PR 61701] - Update wpt metadata, a=testonly\n\nwpt-pr: 61701\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-viewport/zoom/box-shadow-inset-spread.html.ini"], "git_node": "4b81268db53f37d7167ff8194e021b72395c84c1", "git_parents": ["0b49b6c303785043bce2f91655abcb7426f85b07"], "node": "a725263b45ad433912a5e9d6e672a81998c7976b", "parents": ["da85cef377e7032abcf0dd6275d1627c39cb0d0e"], "tags": []}, {"author": "Dale Curtis \u003cdalecurtis@chromium.org\u003e", "branch": "default", "desc": "Bug 2062476 [wpt PR 61845] - Ensure VideoEncoder readback preserves visible_rect and natural_size, a=testonly\n\nAutomatic update from web-platform-tests\nEnsure VideoEncoder readback preserves visible_rect and natural_size\n\nWhen texture-backed VideoFrames (e.g. from canvas) undergo readback via\nCopyRGBATextureToVideoFrame, the newly allocated destination frame has\na visible_rect equal to the entire coded_size. VideoEncoder's\nmetadata_fix_lambda copied timestamp and metadata but did not wrap the\nresult frame with the source frame's visible_rect and natural_size.\nAs a result, encoders would downscale the entire coded size rather than\nencoding the cropped sub-rectangle specified in visibleRect.\n\nThis CL wraps the readback result_frame in VideoEncoder::StartReadback\nusing media::VideoFrame::WrapVideoFrame to preserve visible_rect and\nnatural_size.\n\nFixed: 543284189\nChange-Id: Id92a329b80595f64aff3196a86f1aafbc895dd0e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8235378\nReviewed-by: Eugene Zemtsov \u003ceugene@chromium.org\u003e\nCommit-Queue: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1676956}\n\n--\n\nwpt-commits: bf81dbf296e18bdc166c8a7912fc82c8b94e640e\nwpt-pr: 61845\n", "files": ["testing/web-platform/tests/webcodecs/video-encoder-canvasImageSource.https.html"], "git_node": "bb9178acd84f49a663f9088a203ea91e5e9881f4", "git_parents": ["4b81268db53f37d7167ff8194e021b72395c84c1"], "node": "b0f1fe800fb11b8d497279b85db5e780104801de", "parents": ["a725263b45ad433912a5e9d6e672a81998c7976b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062476 [wpt PR 61845] - Update wpt metadata, a=testonly\n\nwpt-pr: 61845\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webcodecs/video-encoder-canvasImageSource.https.html.ini"], "git_node": "1af503316dbc35f449bde12cc5520de8b4562ab4", "git_parents": ["bb9178acd84f49a663f9088a203ea91e5e9881f4"], "node": "bfea64affb3545653c073c1688b249b20497c5ea", "parents": ["b0f1fe800fb11b8d497279b85db5e780104801de"], "tags": []}, {"author": "Hyowon Kim \u003chyowon@igalia.com\u003e", "branch": "default", "desc": "Bug 2062494 [wpt PR 61847] - Hide scrollbar in transform-iframe-scroll-position, a=testonly\n\nAutomatic update from web-platform-tests\nHide scrollbar in transform-iframe-scroll-position\n\nThe iframe's own scrollbar was showing up and breaking the pixel\ncomparison against the reference, unrelated to the rotate transform.\n\nBug: 332572643\nChange-Id: I1dff55338c0275fd65aa98cf3224244892b6c6ee\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8228246\nReviewed-by: David Bokan \u003cbokan@chromium.org\u003e\nCommit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1676972}\n\n--\n\nwpt-commits: ae0d70d3f1b500ae54fd9c403dc958f66ea64f81\nwpt-pr: 61847\n", "files": ["testing/web-platform/tests/css/css-transforms/support/transform-iframe-scroll-position-contents.html"], "git_node": "a174dc0b3bd5bebde6717b132ee9ab92a397743c", "git_parents": ["1af503316dbc35f449bde12cc5520de8b4562ab4"], "node": "6bf51e7cb49a52d970382c2ba5d8921723755d4a", "parents": ["bfea64affb3545653c073c1688b249b20497c5ea"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062494 [wpt PR 61847] - Update wpt metadata, a=testonly\n\nwpt-pr: 61847\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-transforms/transform-iframe-scroll-position.html.ini"], "git_node": "9c68133d3e73c99278e85b9bd366b909c42a6a00", "git_parents": ["a174dc0b3bd5bebde6717b132ee9ab92a397743c"], "node": "5b31c484d47a5458c6bb387c0aa62748312fdbd5", "parents": ["6bf51e7cb49a52d970382c2ba5d8921723755d4a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062820 - [wpt-sync] Update web-platform-tests to b66a69abddc5bb494d500e4c18debbb2e363ff0b, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: b66a69a