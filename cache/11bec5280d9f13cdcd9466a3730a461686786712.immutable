js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_tabContextMenu.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_tab_interactions_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_manager_close.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_manager_groups.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_move_to_new_window_reload.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_preview.js", "browser/components/urlbar/ActionsProviderTabGroups.sys.mjs", "browser/components/urlbar/SmartbarMentionsPanelSearch.sys.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_sessionStore.js", "browser/components/urlbar/tests/browser/browser_aboutHomeLoading.js", "browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcuts.mjs", "browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/ContentCrashHandlers.sys.mjs", "browser/modules/test/browser/browser_UsageTelemetry_private_and_restore.js", "docshell/test/browser/browser_bug2004165.js", "docshell/test/browser/browser_bug2007897.js", "dom/base/test/browser_newtab_session_history.js", "dom/documentpip/tests/browser/browser_sessionstore_ignore_dpip.js", "netwerk/base/nsNetUtil.cpp", "services/sync/tps/extensions/tps/resource/tps.sys.mjs", "testing/talos/talos/startup_test/sessionrestore/addon/api.js", "testing/talos/talos/talos-powers/api.js", "toolkit/components/httpsonlyerror/tests/browser/browser_errorpage.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_restore_session.js", "toolkit/components/thumbnails/test/head.js", "toolkit/content/widgets/browser-custom-element.mjs", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "02b638832f75e4cd73eee124ded7b4fe276bf3ee", "git_parents": ["255efc8caff0697a82d9ea36df341e562f23c2c7"], "node": "6515cc1e1333cb5b776f57072cd06849667ed85e", "parents": ["deb5ec930227ccf24fff7c9f23555e2c4b7e8f82"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064449 - Update android nightly application-services version bump to 3771dff57d6b0d44bfd528cbc23a39820039da90 r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319561\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "8dbc936cefdc5e5897ee3b319e65bce6b929acb2", "git_parents": ["02b638832f75e4cd73eee124ded7b4fe276bf3ee"], "node": "7f833b2642de10ada6bb64f6afd9ed824b6a7a12", "parents": ["6515cc1e1333cb5b776f57072cd06849667ed85e"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2061320 - Zero inline struct fields when OOL allocation OOMs in createStructOOL. r=jpages\n\nWhen the OOL buffer allocation fails, the already-allocated cell is left as a zombie struct with uninitialized inline reference fields. Zero the inline payload so obj_trace does not dereference garbage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319584\n", "files": ["js/src/wasm/WasmGcObject-inl.h"], "git_node": "67ed1da02be7566252417842b1af55e66786a0c4", "git_parents": ["8dbc936cefdc5e5897ee3b319e65bce6b929acb2"], "node": "4b0b408a00d574e55a1e1f7a3c3eb5942a3671a0", "parents": ["7f833b2642de10ada6bb64f6afd9ed824b6a7a12"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062484 - Update libffi to version 3.8.0. r=spidermonkey-reviewers,sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317708\n", "files": ["config/external/ffi/subst_header.py", "js/src/ctypes/libffi/include/ffi.h.in", "js/src/ctypes/libffi/moz.yaml", "js/src/ctypes/libffi/src/aarch64/ffi.c", "js/src/ctypes/libffi/src/aarch64/ffitarget.h", "js/src/ctypes/libffi/src/debug.c", "js/src/ctypes/libffi/src/ia64/ia64_flags.h", "js/src/ctypes/libffi/src/ia64/unix.S", "js/src/ctypes/libffi/src/java_raw_api.c", "js/src/ctypes/libffi/src/pa/ffitarget.h", "js/src/ctypes/libffi/src/powerpc/darwin_closure.S", "js/src/ctypes/libffi/src/powerpc/ffi_darwin.c", "js/src/ctypes/libffi/src/powerpc/ffi_linux64.c", "js/src/ctypes/libffi/src/powerpc/linux64_closure.S", "js/src/ctypes/libffi/src/prep_cif.c", "js/src/ctypes/libffi/src/raw_api.c", "js/src/ctypes/libffi/src/tramp.c", "js/src/ctypes/libffi/src/x86/ffi.c", "js/src/ctypes/libffi/src/x86/ffi64.c", "js/src/ctypes/libffi/src/x86/ffitarget.h", "js/src/ctypes/libffi/src/x86/win64.S", "js/src/ctypes/libffi/src/x86/win64_intel.S"], "git_node": "2d5e218623cac47d6315c1421def063f4c0441c4", "git_parents": ["67ed1da02be7566252417842b1af55e66786a0c4"], "node": "0ee8cebc9b5c841a60372fe1ce16635973139cba", "parents": ["4b0b408a00d574e55a1e1f7a3c3eb5942a3671a0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062484 - Account for ctypes call plans with ffi_call_plan_size. r=spidermonkey-reviewers,sfink\n\nThe plan's size was hardcoded as two pointers because ffi_call_plan is an\nincomplete type at this site, which only covered the handle and left the\nargument-placement data it owns unaccounted. libffi 3.8.0 adds a size query,\nso ask the plan instead. The two accounting sites can no longer disagree,\nsince both read the same immutable plan.\n\nThis raises the version floor for the fast path from 3.7.0 to 3.8.0, which\nonly affects builds against a system libffi older than 3.8.0; those fall back\nto ffi_call as they already do on other targets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317709\n", "files": ["js/src/ctypes/CTypes.cpp", "js/src/ctypes/CTypes.h"], "git_node": "2970401c3feeba0d2b221f849a3445bd82643851", "git_parents": ["2d5e218623cac47d6315c1421def063f4c0441c4"], "node": "af339a24666b0c5329beb95c424665d352ef34eb", "parents": ["0ee8cebc9b5c841a60372fe1ce16635973139cba"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064403 - Mirror logic from CanUseWMFHwEncoder in RemoteEncoderModule::Supports. r=media-playback-reviewers,azebrowski\n\nThis should have been included in bug 2049606 but was forgotten. It\nonly affects WebRTC if media.webrtc.encoder_creation_strategy is\nflipped to 1 (prefer creating the platform encoders) over 0 (prefer\ncreating the WebRTC encoders).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319476\n", "files": ["dom/media/ipc/RemoteEncoderModule.cpp"], "git_node": "1d2bab5d5c5e5ee8a6957786518cce11e6eaddda", "git_parents": ["2970401c3feeba0d2b221f849a3445bd82643851"], "node": "ae473546fda03e6dd9961abbac5b8622a1643e14", "parents": ["af339a24666b0c5329beb95c424665d352ef34eb"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057454 - Don't remove GC root tracers on shutdown in the shell r=spidermonkey-reviewers,sfink\n\nThis is problematic because a GC can be running at this point, and doing this\ninterferes with incremental marking validation if present.\n\nWe don't need to do this anyway, and the browser doesn't. It's hoped that these\nwon't trace anything after this point though, so this also clears the shell\ncompartment privates that have roots that these hooks trace.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318713\n", "files": ["js/src/jit-test/tests/gc/bug-2057454.js", "js/src/shell/js.cpp"], "git_node": "079070640d0817ef14f0b1a022c04000df8fe1be", "git_parents": ["1d2bab5d5c5e5ee8a6957786518cce11e6eaddda"], "node": "432dcb47868c5ff35c5a5d965bda1ca28adc4a06", "parents": ["ae473546fda03e6dd9961abbac5b8622a1643e14"], "tags": []}, {"author": "Jon Coppeard \u003cjonco@pobox.com\u003e", "branch": "default", "desc": "Bug 2064330 - Part 1: Remove quadratic behaviour in testcase for bug 1852218 r=spidermonkey-reviewers,sfink\n\nI reverted the original fix and checked that this still reproduces the problem.\nDue to the changes in bug 1866502 I had to change eval() to evaluate() to make\nthis work, as eval sets an introducer filename which now prevents use of JIT\nhints for such scripts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319420\n", "files": ["js/src/jit-test/tests/bug1852218.js"], "git_node": "42a9062ab182acf1f7bd6a99065923770409a822", "git_parents": ["079070640d0817ef14f0b1a022c04000df8fe1be"], "node": "a0b71e70545f43c80b2c8b3af9a7a0a3554382dd", "parents": ["432dcb47868c5ff35c5a5d965bda1ca28adc4a06"], "tags": []}, {"author": "Jon Coppeard \u003cjonco@pobox.com\u003e", "branch": "default", "desc": "Bug 2064330 - Part 2: Turn off concurrent marking zeal for the test case for bug 1797486 as it makes it very slow r=spidermonkey-reviewers,sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319421\n", "files": ["js/src/jit-test/tests/basic/bug1797486.js"], "git_node": "1fbab68ff64a792cb0bb16af31d0593584d95b95", "git_parents": ["42a9062ab182acf1f7bd6a99065923770409a822"], "node": "ccdb2250c4e855a155352ee7b4c75e1df432a545", "parents": ["a0b71e70545f43c80b2c8b3af9a7a0a3554382dd"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2064472 - Factor out legacy shorthands code. r=boris\n\nA legacy shorthand is, fundamentally, a single-longhand shorthand with different parse and serialize methods.\n\nWe can trivially autogenerate all that code.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/336\n", "files": ["servo/components/style/properties/helpers.mako.rs", "servo/components/style/properties/shorthands.rs", "servo/components/style/properties/shorthands.toml", "servo/components/style/values/specified/box.rs", "servo/components/style/values/specified/transform.rs"], "git_node": "642e1a917c1eb927822b4f86df7e1d0d8fa60b4b", "git_parents": ["1fbab68ff64a792cb0bb16af31d0593584d95b95"], "node": "b5c70906424f8c812da0bebcc49c5cab47b5baea", "parents": ["ccdb2250c4e855a155352ee7b4c75e1df432a545"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2063188 - Ignore setting currentScale on inner svg elements r=firefox-svg-reviewers,jwatt\n\nSee https://www.w3.org/TR/SVG2/struct.html#InterfaceSVGSVGElement\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319292\n", "files": ["dom/svg/SVGSVGElement.cpp", "testing/web-platform/meta/svg/struct/scripted/currentScale-outermost.html.ini"], "git_node": "fdcbe250e933fb9b6a9ba5c65015d35f99b01aaf", "git_parents": ["642e1a917c1eb927822b4f86df7e1d0d8fa60b4b"], "node": "323d6c2712bd840347fc16fe4975efe560ca63d2", "parents": ["b5c70906424f8c812da0bebcc49c5cab47b5baea"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057831 - skip browser_contextmenu.js on Linux 22.04 r=sfoster\n\nThis test is already skipped in Linux 24.04 and fails in Linux 22.04 with the following configurations:\n\n- opt or debug\n- Nova enabled or Nova disabled\n\nThe test failures show `context-setDesktopBackground` consistently missing, and this is likely a platform-specific issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318329\n", "files": ["browser/base/content/test/contextMenu/browser.toml"], "git_node": "2fc81e489c723ad1ea8d107c565630535c29c7a7", "git_parents": ["fdcbe250e933fb9b6a9ba5c65015d35f99b01aaf"], "node": "49bc1341e1ab720f1e8a3fa7463b1d6121df1d23", "parents": ["323d6c2712bd840347fc16fe4975efe560ca63d2"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2064460 - Strip Static off the end of Chrome DOM methods when labeling native profiles. r=perftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319574\n", "files": ["testing/raptor/raptor/browser_function_labels.toml"], "git_node": "e701f2b2ddeecf1c80ff543ae4617e82fd0a89a4", "git_parents": ["2fc81e489c723ad1ea8d107c565630535c29c7a7"], "node": "24e83e3977032bee8d42102dcab1033a6ee3e254", "parents": ["49bc1341e1ab720f1e8a3fa7463b1d6121df1d23"], "tags": []}, {"author": "Pier Angelo Vendrame \u003cpierov@torproject.org\u003e", "branch": "default", "desc": "Bug 2063031 - Spoof video PiP size under RFP. r=media-playback-reviewers,kpatenio,alwu,tjr\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318184\n", "files": ["dom/media/PictureInPictureWindow.cpp", "dom/media/PictureInPictureWindow.h", "dom/media/mediaelement/HTMLVideoElement.cpp", "dom/media/mediaelement/HTMLVideoElement.h", "toolkit/components/pictureinpicture/tests/browser.toml", "toolkit/components/pictureinpicture/tests/browser_resistFingerprinting.js"], "git_node": "76ee4dd68e5dd071a47a3b2c72b522f4e1aa8124", "git_parents": ["e701f2b2ddeecf1c80ff543ae4617e82fd0a89a4"], "node": "dab4c782f36c73f596a39000471980796e449caa", "parents": ["24e83e3977032bee8d42102dcab1033a6ee3e254"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2064476 - Scope ui-test-apk nightly variant probes to autoland only r=jajohnson\n\nScope the ui-test-apk fenix/focus arm-nightly UI test tasks to [autoland-only] so they stop duplicating android-startup-test on every mozilla-central push while keeping autoland early-warning coverage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319583\n", "files": ["taskcluster/kinds/ui-test-apk/kind.yml"], "git_node": "509c0383f7ea455918082585383e2002465b281e", "git_parents": ["76ee4dd68e5dd071a47a3b2c72b522f4e1aa8124"], "node": "5b107941577d042d1c57b15709017344f523d192", "parents": ["dab4c782f36c73f596a39000471980796e449caa"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062783 - Use moz-src for sessionstore. r=Gijs,omc-reviewers,migration-reviewers,firefox-desktop-core-reviewers ,jswinarton,hsohaney,sclements,aminomancer,perftest-reviewers,kshampur\" for causing failures @SessionStore.sys.\n\nThis reverts commit 02b638832f75e4cd73eee124ded7b4fe276bf3ee.\n", "files": ["browser/actors/AboutTabCrashedParent.sys.mjs", "browser/base/content/browser-places.js", "browser/base/content/browser.js", "browser/base/content/test/about/browser_aboutCertError.js", "browser/base/content/test/tabPrompts/browser_prompt_close_groups.js", "browser/base/content/test/tabcrashed/browser_autoSubmitRequest.js", "browser/components/BrowserComponents.manifest", "browser/components/BrowserContentHandler.sys.mjs", "browser/components/BrowserGlue.sys.mjs", "browser/components/DefaultBrowserCheck.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowTabStatesManager.sys.mjs", "browser/components/aiwindow/ui/modules/TabManagementService.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_session_restore.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_manage_tabs_tool.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_tab_move.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/backup/resources/SessionStoreBackupResource.sys.mjs", "browser/components/backup/tests/marionette/test_backup.py", "browser/components/backup/tests/xpcshell/test_SessionStoreBackupResource.js", "browser/components/contextualidentity/test/browser/browser_siteContainer_retarget.js", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/customizableui/ToolbarContextMenu.sys.mjs", "browser/components/customizableui/test/browser_history_recently_closed.js", "browser/components/customizableui/test/browser_history_restore_session.js", "browser/components/extensions/parent/ext-sessions.js", "browser/components/extensions/parent/ext-tabs.js", "browser/components/extensions/test/browser/browser_ext_sessions_forgetClosedTab.js", "browser/components/extensions/test/browser/browser_ext_sessions_restore.js", "browser/components/extensions/test/browser/browser_ext_sessions_restoreTab.js", "browser/components/extensions/test/browser/browser_ext_sessions_restore_private.js", "browser/components/extensions/test/browser/browser_ext_tabs_hide.js", "browser/components/extensions/test/browser/browser_ext_tabs_update_url.js", "browser/components/firefoxview/recentlyclosed.mjs", "browser/components/firefoxview/tests/browser/browser_history_firefoxview.js", "browser/components/firefoxview/tests/browser/browser_recentlyclosed_firefoxview.js", "browser/components/firefoxview/tests/browser/head.js", "browser/components/migration/FirefoxProfileMigrator.sys.mjs", "browser/components/migration/tests/marionette/test_refresh_firefox.py", "browser/components/privatebrowsing/ResetPBMPanel.sys.mjs", "browser/components/sessionstore/PageWireframes.sys.mjs", "browser/components/sessionstore/RecentlyClosedTabsAndWindowsMenuUtils.sys.mjs", "browser/components/sessionstore/SessionFile.sys.mjs", "browser/components/sessionstore/SessionMigration.sys.mjs", "browser/components/sessionstore/SessionSaver.sys.mjs", "browser/components/sessionstore/SessionStartup.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/SessionStoreFunctions.sys.mjs", "browser/components/sessionstore/SessionWindowUI.sys.mjs", "browser/components/sessionstore/SessionWriter.sys.mjs", "browser/components/sessionstore/TabState.sys.mjs", "browser/components/sessionstore/components.conf", "browser/components/sessionstore/content/aboutSessionRestore.js", "browser/components/sessionstore/moz.build", "browser/components/sessionstore/test/SessionStoreTestUtils.sys.mjs", "browser/components/sessionstore/test/browser_duplicate_history.js", "browser/components/sessionstore/test/browser_duplicate_tab_in_new_window.js", "browser/components/sessionstore/test/browser_firefoxView_selected_restore.js", "browser/components/sessionstore/test/browser_restoreLastActionCorrectOrder.js", "browser/components/sessionstore/test/browser_restoreLastClosedTabOrWindowOrSession.js", "browser/components/sessionstore/test/head.js", "browser/components/sessionstore/test/marionette/test_new_tab_on_restore.py", "browser/components/sessionstore/test/marionette/test_persist_closed_tabs_restore_manually.py", "browser/components/sessionstore/test/marionette/test_restore_aiwindow.py", "browser/components/sessionstore/test/marionette/test_restore_manually.py", "browser/components/sessionstore/test/marionette/test_restore_manually_with_pinned_tabs.py", "browser/components/sessionstore/test/marionette/test_restore_manually_with_tab_groups.py", "browser/components/sessionstore/test/marionette/test_restore_sidebar.py", "browser/components/sessionstore/test/marionette/test_restore_sidebar_automatic.py", "browser/components/sessionstore/test/marionette/test_splitview_restore.py", "browser/components/sessionstore/test/marionette/test_tabgroups_restore.py", "browser/components/sessionstore/test/marionette/test_tabnotes_canonicalurl_restore.py", "browser/components/sessionstore/test/marionette/test_taskbartab_sessionstate.py", "browser/components/sessionstore/test/unit/head.js", "browser/components/sessionstore/test/unit/test_backup_once.js", "browser/components/sessionstore/test/unit/test_final_write_cleanup.js", "browser/components/sessionstore/test/unit/test_histogram_corrupt_files.js", "browser/components/sessionstore/test/unit/test_migration_lz4compression.js", "browser/components/sessionstore/test/unit/test_startup_invalid_session.js", "browser/components/sessionstore/test/unit/test_startup_session_async.js", "browser/components/sidebar/SidebarCollapsedWindows.sys.mjs", "browser/components/sidebar/SidebarManager.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tab-hover-preview.mjs", "browser/components/tabbrowser/content/tabgroup-menu.js", "browser/components/tabbrowser/test/TabGroupTestUtils.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_bug_1387976_restore_lazy_tab_browser_muted_state.js", "browser/components/tabbrowser/test/browser/tabs/browser_discarded_tab_move.js", "browser/components/tabbrowser/test/browser/tabs/browser_new_tab_insert_position.js", "browser/components/tabbrowser/test/browser/tabs/browser_restore_isAppTab.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_detach_restore.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_group_menu.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_list.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_tabContextMenu.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_tab_interactions_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_manager_close.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_manager_groups.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_move_to_new_window_reload.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_preview.js", "browser/components/urlbar/ActionsProviderTabGroups.sys.mjs", "browser/components/urlbar/SmartbarMentionsPanelSearch.sys.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_sessionStore.js", "browser/components/urlbar/tests/browser/browser_aboutHomeLoading.js", "browser/extensions/newtab/lib/SmartShortcutsRanker/RankShortcuts.mjs", "browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/ContentCrashHandlers.sys.mjs", "browser/modules/test/browser/browser_UsageTelemetry_private_and_restore.js", "docshell/test/browser/browser_bug2004165.js", "docshell/test/browser/browser_bug2007897.js", "dom/base/test/browser_newtab_session_history.js", "dom/documentpip/tests/browser/browser_sessionstore_ignore_dpip.js", "netwerk/base/nsNetUtil.cpp", "services/sync/tps/extensions/tps/resource/tps.sys.mjs", "testing/talos/talos/startup_test/sessionrestore/addon/api.js", "testing/talos/talos/talos-powers/api.js", "toolkit/components/httpsonlyerror/tests/browser/browser_errorpage.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_restore_session.js", "toolkit/components/thumbnails/test/head.js", "toolkit/content/widgets/browser-custom-element.mjs", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "e9dc5a46d7c8113d20b90aa8cc028b0651a78f95", "git_parents": ["509c0383f7ea455918082585383e2002465b281e"], "node": "ec9b85b5eec4a446ee389124ba6235c282a6312c", "parents": ["5b107941577d042d1c57b15709017344f523d192"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061856 - Let callers of removeAllDuplicateTabs anchor the confirmation hint r=czhou,tabbrowser-reviewers,kcochrane\n\nremoveAllDuplicateTabs raises a confirmation hint (\"Closed N tabs\") anchored to\nthe All Tabs button. Now that the function can be called from elsewhere (ie the\nOrganize Tabs panel), the confirmation should point at the caller rather than\nstatically at the All Tabs button, which is removable and is not the button the\nuser pressed. With no All Tabs button on the toolbar there is nothing to anchor\nto and the hint lands in the corner of the window.\n\nTake the anchor as an option, defaulting to the All Tabs button so the All Tabs\nmenu is unchanged, and point the Smart Window \"Organize Tabs\" panel's Close\nDuplicate Tabs row at its own toolbar button.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317169\n", "files": ["browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_close_duplicate_tabs.js"], "git_node": "fb1a6c101a6e94af31dc1d93a135d5ad925ddd25", "git_parents": ["e9dc5a46d7c8113d20b90aa8cc028b0651a78f95"], "node": "47542698be6f2605853d84ce66f4574e284bd6e4", "parents": ["ec9b85b5eec4a446ee389124ba6235c282a6312c"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060283 - Basic layout and image positioning for FRO template r=omc-reviewers,mviar,emcminn\" for causing failures @browser_aboutwelcome_configurable_ui.js.\n\nThis reverts commit 95c42dd7f58818e8d9f1b62e7d72b90233bc76aa.\n", "files": ["browser/base/content/test/static/browser_all_files_referenced.js", "browser/components/aboutwelcome/assets/backdrop-adaptive.svg", "browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aboutwelcome/jar.mn", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_configurable_ui.js", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "f4c51288a2a174cf5d5c6d42b0c57bf306f3c008", "git_parents": ["fb1a6c101a6e94af31dc1d93a135d5ad925ddd25"], "node": "68e87d567603ad1eb5c7dbb6c058b8b80f9bd658", "parents": ["47542698be6f2605853d84ce66f4574e284bd6e4"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 1918301 - Add a test to check that the pdf viewer isn't used when the pdf is in a multipart response r=marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D222933\n", "files": ["toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_multipart_response.js", "toolkit/components/pdfjs/test/head.js", "toolkit/components/pdfjs/test/pdf_multipart.sjs"], "git_node": "f68816f95e4b49f28c55cc64e70633ea7396dca4", "git_parents": ["f4c51288a2a174cf5d5c6d42b0c57bf306f3c008"], "node": "f643ef5f5e8d9a2a606b75e2dbe7fe11eaff5007", "parents": ["68e87d567603ad1eb5c7dbb6c058b8b80f9bd658"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2064131 - Cope with null base style in scroll-to-delay phase. r=boris,layout-scroll-driven-animation-reviewers,firefox-style-system-reviewers\n\nThe base style can be legitimately null. We hit this:\n\n * https://searchfox.org/firefox-main/rev/6fd3453f587cfcd74637bad0b7b67f3d4680e679/gfx/layers/AnimationInfo.cpp#519\n\nAnd ultimately crash in the compositor side of things.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319546\n", "files": ["gfx/layers/AnimationHelper.cpp", "gfx/layers/AnimationHelper.h", "layout/style/test/file_animations_omta_scroll.html"], "git_node": "32a1b84d380bc22b6979941191e98f35249e99f2", "git_parents": ["f68816f95e4b49f28c55cc64e70633ea7396dca4"], "node": "23e8da2970d62448b22f281f015b2707b62e2139", "parents": ["f643ef5f5e8d9a2a606b75e2dbe7fe11eaff5007"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 1975275 - Author SVGFE backdrop-filter subregions in the same space as the item geometry r=gfx-reviewers,lsalzman\n\nThe subregions were authored in a different space from the geometry they apply to,\nso the filter was truncated, displaced, or dropped entirely - leaving PDF\nfind-in-page highlights and text selection invisible in forced colors mode, where\npdf.js draws them with a backdrop-filter alone.\n\nNormalize them by the external scroll offset like the geometry, folding the two\npush_filters entry points into one so it cannot be bypassed, and map them through\nthe element to surface relationship at frame time. The map needs the scale, not\njust the offset, because a reference frame between the element and the backdrop\nroot may scale, as pdf.js does to its text spans.\n\nThe reftest from bug 2046779 relied on the old mismatch, so author its subregion in\nthe geometry's space; the reference rendering is unchanged. Add tests for a scaled\nreference frame and a mid-async-scroll state, which nothing covered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319379\n", "files": ["gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/picture_composite_mode.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/surface.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/wrench/reftests/filters/reftest.list", "gfx/wr/wrench/reftests/filters/svgfe-backdrop-scaled-refframe-ref.yaml", "gfx/wr/wrench/reftests/filters/svgfe-backdrop-scaled-refframe.yaml", "gfx/wr/wrench/reftests/scrolling/reftest.list", "gfx/wr/wrench/reftests/scrolling/svgfe-backdrop-async-scroll-ref.yaml", "gfx/wr/wrench/reftests/scrolling/svgfe-backdrop-async-scroll.yaml", "gfx/wr/wrench/reftests/scrolling/svgfe-backdrop-ext-scroll-offset.yaml"], "git_node": "bed6452f335bb5eddb21e1eebfb01a5db10bb524", "git_parents": ["32a1b84d380bc22b6979941191e98f35249e99f2"], "node": "b6923bf278252b7e74fa1f66fdd8329ef1c26b71", "parents": ["23e8da2970d62448b22f281f015b2707b62e2139"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055043 - Inset test content past Nova's rounded content-area corners and re-enable browser_test_position_sticky.js under Nova r=sthompson,hiro\n\nSeveral APZ snapshot tests build their compared rect anchored at the content\narea's top-left corner. Under Nova .browserContainer has rounded, clipped\ncorners (browser/themes/shared/tabbrowser/content-area.css), and that corner\nflickers between paints while scrolling, which made these reftests fail under\nNova on macOS. The flicker is a real rendering bug (bug 2061338); this is a\ntest-side workaround, not a fix.\n\nRather than measuring the corner at runtime, inset the test content itself so\nthe compared rect no longer covers the flickering rounded corners:\n\n - helper_position_sticky_flicker.html: add horizontal body margins so the\n   sticky band clears both top corners. This re-enables\n   browser_test_position_sticky.js under Nova (drops the nova skip-if,\n   bug 2057902).\n - helper_scroll_linked_effect_by_wheel.html: inset the target's left/right so\n   its 10px strip clears the corners. Same corner issue as bug 1776975.\n\nAlso add browser_test_content_area_corner_flicker.js, which compares exactly the\ncorner strip so the flicker is caught. It is fail-if = [\"nova && os == 'mac\"']\nuntil bug 2061338 is fixed; off Nova the strip is stable content and passes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316627\n", "files": ["gfx/layers/apz/test/mochitest/browser.toml", "gfx/layers/apz/test/mochitest/browser_test_content_area_corner_flicker.js", "gfx/layers/apz/test/mochitest/helper_content_area_corner_flicker.html", "gfx/layers/apz/test/mochitest/helper_position_sticky_flicker.html", "gfx/layers/apz/test/mochitest/helper_scroll_linked_effect_by_wheel.html"], "git_node": "eeda7055fc1dccce3f8c7291d1c0d19e54f83e7e", "git_parents": ["bed6452f335bb5eddb21e1eebfb01a5db10bb524"], "node": "4bb082488541b01cba6e0661bbabe7c5734f5efe", "parents": ["b6923bf278252b7e74fa1f66fdd8329ef1c26b71"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2034838 re-enable MediaRecorder-video-key-frame-distance.html even on linux asan r=Sasha\n\nThis reverts https://phabricator.services.mozilla.com/D296110\n\nCrashes are usually annotated CRASH.\nA shutdown hang was observed after this test as recorded at\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=2034838#c42 .\nThis test was the last test run before the browser intentionally initiated\nshutdown.\nThe same hang occurred even with this test disabled.\n\nThe cause of the shutdown hang is addressed separately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318970\n", "files": ["testing/web-platform/meta/mediacapture-record/MediaRecorder-video-key-frame-distance.html.ini"], "git_node": "2e0e334f16e83097faefd9e7b463e6190fa84236", "git_parents": ["eeda7055fc1dccce3f8c7291d1c0d19e54f83e7e"], "node": "f7f1f9469c20362efdd9c9152fd6cb4abe9cb9ec", "parents": ["4bb082488541b01cba6e0661bbabe7c5734f5efe"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2034838 Remove unused AudioSegment support from DirectMediaTrackListener r=pehrsons\n\nDepends on D318658\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319395\n", "files": ["dom/media/MediaTrackListener.cpp", "dom/media/MediaTrackListener.h"], "git_node": "aa47e716c3b418301c66ffd8d436aa07e248fa7c", "git_parents": ["2e0e334f16e83097faefd9e7b463e6190fa84236"], "node": "8e349a8a3ac28a0b36d7cf27332f5ea8433d08bb", "parents": ["f7f1f9469c20362efdd9c9152fd6cb4abe9cb9ec"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062182 - Split the test paths given to mach try across chunks instead of running them all in a single job, r=taskgraph-reviewers,ahal.\n\nWhen a path is passed to |mach try fuzzy|, the requested tests were all run by\nchunk 1 of each selected configuration: the taskgraph left the task's manifest\nlist set to the whole suite, so the chunk count and the manifests of each chunk\nwere meaningless, the target task selection kept only chunk 1, and the try\nconfig env overwrote every chunk's MOZHARNESS_TEST_PATHS with the requested\npaths. A path holding more tests than one job can run within its maximum\nduration therefore lost that configuration entirely.\n\nRestrict the task's manifests to those holding tests under the requested paths\ninstead, keeping a path that is narrower than a manifest (a single test file or\na subdirectory) as is, and scale the configured chunk counts down to that share\nof the suite. Chunking then spreads the requested paths over as many chunks as\nthey need, each chunk running only its own share. The skipped manifests and the\ndirectories of the other manifests are dropped along the way, as neither is\nmeaningful for a task that only runs part of the suite.\n\nOnly tasks whose manifests the taskgraph could restrict this way are chunked\nand scheduled per chunk, which the new 'test-manifests-restricted' attribute\nmarks. Everything else keeps running the request in its first chunk as before:\nsuites whose tests the decision task doesn't resolve, such as jsreftest,\nreftest-qr, crashtest-qr, marionette-unittest, jittest, cppunittest and gtest,\nweb-platform-tests, whose manifest names hold namespaces rather than source\npaths, and pushes that also carry a test tag, where only part of each manifest\nruns and the runtime data, which is per manifest, can't say how long that is.\n\nTwo parts of the runtime estimate are sized for a whole suite and give a single\nover-long chunk once only part of one runs, so they are adjusted for a\nrestricted task:\n\n - a manifest for which the runtime data holds no time is filled in with the\n   average of the manifests that do have data, rather than counted as instant.\n   The few manifests a restricted task runs can all be missing from the data,\n   which is what collapsed the slowest configurations to a single chunk; over a\n   whole suite the manifests the data does cover dominate.\n\n - the number of chunks is rounded up rather than to the nearest, as rounding\n   to the nearest lets a chunk run up to half the target duration longer than\n   it. That is amortized over the many chunks a whole suite needs, but with a\n   handful of chunks it means one of them running half again as long.\n\nThe estimate stays a guess where the data is thin: a configuration for which\nonly a couple of the requested manifests have a runtime is chunked from the\naverage of those two, and one the data doesn't cover at all falls back to a\nshare of the suite's configured chunk count, which for a small request is one\nchunk.\n\nBecause chunk counts now depend on the request, a test task label naming a\nchunk that no longer exists, which `mach try coverage` and a `mach try again`\nof an older push can both produce, is replaced by the chunks the task ended up\nwith rather than dropped with a warning.\n\nAlso fixes |mach try fuzzy \u003ctest file\u003e --allow-testfile-path|, which scheduled\nno test task at all, as no manifest path starts with a test file path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317430\n", "files": ["taskcluster/docs/attributes.md", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/gecko_taskgraph/test/test_target_tasks.py", "taskcluster/gecko_taskgraph/test/test_transforms_task.py", "taskcluster/gecko_taskgraph/test/test_transforms_test.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/gecko_taskgraph/transforms/test/chunk.py", "testing/mozbase/moztest/moztest/resolve.py", "testing/mozbase/moztest/tests/test_resolve.py", "tools/tryselect/docs/selectors/fuzzy.md"], "git_node": "77a7a17ba1b859339d8deadc98d16f67ca7b22c4", "git_parents": ["aa47e716c3b418301c66ffd8d436aa07e248fa7c"], "node": "57386e10a0b3ba1bbd5629b5cf125a3f0a5958fd", "parents": ["8e349a8a3ac28a0b36d7cf27332f5ea8433d08bb"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062977 - updated nimbus and secret settings to add listen to page flag r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318760\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "9545877c2447afb4f1fd0459bb8539afc2abf78e", "git_parents": ["77a7a17ba1b859339d8deadc98d16f67ca7b22c4"], "node": "a59086ec4450910545aa8e989400a9b0d12ba03d", "parents": ["57386e10a0b3ba1bbd5629b5cf125a3f0a5958fd"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043546 - Populate securityInfo for adopted Happy Eyeballs 0-RTT transactions r=necko-reviewers,valentin\n\nAn accepted 0-RTT winner sends its request as early data, so the adopted transaction may never refresh securityInfo the way Finish0RTT does. In particular, nsHttpTransaction::ReadSegments may not be called, leaving the channel with a null securityInfo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319446\n", "files": ["netwerk/protocol/http/HappyEyeballsTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h"], "git_node": "18be1d22bb174c780cfb419de167b23ea0994fea", "git_parents": ["9545877c2447afb4f1fd0459bb8539afc2abf78e"], "node": "c493fb7c92b713a99d00d66dc9e8e8e3f014ba97", "parents": ["a59086ec4450910545aa8e989400a9b0d12ba03d"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063759 - Avoid line-clamp style adjustment for displays that aren't block/inline. r=firefox-style-system-reviewers,emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319194\n", "files": ["layout/generic/nsBlockFrame.cpp", "servo/components/style/style_adjuster.rs", "testing/web-platform/tests/css/css-overflow/line-clamp/webkit-line-clamp-bug-2063759-crash.html"], "git_node": "b5762f7765acf378d48b08d15255c66ca6913c4e", "git_parents": ["18be1d22bb174c780cfb419de167b23ea0994fea"], "node": "aa5826cc6f0f268babcdc06a9b47cfe4ccbfc4c3", "parents": ["c493fb7c92b713a99d00d66dc9e8e8e3f014ba97"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063711 - Remove version 154 train-hop shim for registerRuntimeMetric in NewTabGleanUtils. r=joel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318813\n", "files": ["browser/extensions/newtab/lib/NewTabGleanUtils.sys.mjs"], "git_node": "a0b08653913f1b9c96939c6c75992f650e128fcc", "git_parents": ["b5762f7765acf378d48b08d15255c66ca6913c4e"], "node": "e7cd3b808e79d2fba74ba69df8d397e0be6b5a9a", "parents": ["aa5826cc6f0f268babcdc06a9b47cfe4ccbfc4c3"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063712 - Remove the version 154 train-hop shim for getLogger in TemporaryMerinoClientShim. r=Dre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318815\n", "files": ["browser/extensions/newtab/lib/TemporaryMerinoClientShim.sys.mjs"], "git_node": "1c88d730c87907ad5f910be75c10ea38fa23d589", "git_parents": ["a0b08653913f1b9c96939c6c75992f650e128fcc"], "node": "5925a6a5c17c5f6e09de0d0ee77c23a2d3d76d6a", "parents": ["e7cd3b808e79d2fba74ba69df8d397e0be6b5a9a"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063710 - Remove the Fx154 train-hop version check for MozAdsClient in AdsClient. r=jbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318816\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs"], "git_node": "c6ccb019fdcdab0a3b053c6669443a50e67db1fc", "git_parents": ["1c88d730c87907ad5f910be75c10ea38fa23d589"], "node": "7d2fd0690fd84476ab45dedf56c918cf85fabe03", "parents": ["5925a6a5c17c5f6e09de0d0ee77c23a2d3d76d6a"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063709 - Remove version 154 train-hop shims for contextual ads region/locale defaults. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318819\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_ActivityStream_contextualAds.js"], "git_node": "a35b230fefa13553416f596348672d3afa3fe5b8", "git_parents": ["c6ccb019fdcdab0a3b053c6669443a50e67db1fc"], "node": "5179c0318b582846aea93a9586db109570d37ef0", "parents": ["7d2fd0690fd84476ab45dedf56c918cf85fabe03"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063713 - Re-remove version 145 train-hop shim for PrivacyFeed getTodayStats guard. r=maxx\n\nThe `@backward-compat { version 145 }` `getTodayStats` guards were removed in bug 2055942, but came back on 2026-08-07 via bug 2050954, which was rebased over the removal. Remove both again:\n\n- `updateCounts()` \u2014 the original guard and its comment.\n- `_runMessageSelection()` \u2014 the copy added by bug 2050954.\n\n`PrivacyMetricsService.getTodayStats` is an unconditional plain method (`browser/components/protections/PrivacyMetricsService.sys.mjs:60`) and version 145 is long past Release (tree is 156.0a1), so both early-returns were dead code.\n\nAlso removed two now-unreachable `getTodayStats` stubs in `test_PrivacyFeed.js`: both tests stub `fetchTodayCounts`, which is the only call path to `getTodayStats`, so the stubs existed solely to satisfy the guard. One carried a stale \"backward-compat guard\" comment. The `test_backward_compat_guard` task deleted in bug 2055942 did not come back, so no test removal was needed there. Dropped the stale reference to the guard in `Privacy.jsx`'s `initialized` comment; the remaining rationale (no metric state before the first broadcast) still holds.\n\n`test_PrivacyFeed.js` passes 83/83 both before and after, as expected for a dead-code removal. eslint clean.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318820\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/lib/Widgets/PrivacyFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_PrivacyFeed.js"], "git_node": "f9eaa3e02a5ccce03b38b14eaa8897b462098668", "git_parents": ["a35b230fefa13553416f596348672d3afa3fe5b8"], "node": "ce2e1af7b19bbdc885727530c8897af31209c11d", "parents": ["5179c0318b582846aea93a9586db109570d37ef0"], "tags": []}, {"author": "Neeco Fabian \u003cneecofabian@gmail.com\u003e", "branch": "default", "desc": "Bug 2060285 - FRO Template Theme Screen to Support Card Over Background Layout r=mviar,fterdal,omc-reviewers\n\n- Use card over background/corner illustration layout in the Theme Screen message\n- Add support for more styling properties in messages\n- Button strings TBD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318484\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/asrouter/content-src/components/MSLocalized.jsx", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js"], "git_node": "43ad70918a549cf9ff0dd8ac043b3bb4837d0f26", "git_parents": ["f9eaa3e02a5ccce03b38b14eaa8897b462098668"], "node": "7700176e0a0f240a2c7b90ec9da9b4f520af0336", "parents": ["ce2e1af7b19bbdc885727530c8897af31209c11d"], "tags": []}, {"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013588 - Add test. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D284547\n", "files": ["js/src/jit-test/tests/wasm/bug2013588.js"], "git_node": "ce82c942d4820467f781a38c52707944b07d4644", "git_parents": ["43ad70918a549cf9ff0dd8ac043b3bb4837d0f26"], "node": "621b6465c081c1b0ccd89b0d5356aecb24f41fda", "parents": ["7700176e0a0f240a2c7b90ec9da9b4f520af0336"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063261 - Stop the round container icon background from clipping the icon itself r=desktop-theme-reviewers,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319559\n", "files": ["browser/components/contextualidentity/content/usercontext.css", "toolkit/content/widgets/moz-box-common.css"], "git_node": "65a30e4d9f70456b38ac56fb7976eccb18ebb246", "git_parents": ["ce82c942d4820467f781a38c52707944b07d4644"], "node": "29777a9c84849a6415f7d2dfe523ab98e536f3ad", "parents": ["621b6465c081c1b0ccd89b0d5356aecb24f41fda"], "tags": []}, {"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062696 - Improve group naming for Auto Tab Grouping. r=jlewis,cdipersio,ai-platform-reviewers,valentinp\n\nThis patch updates the default group name generation call to use the MLPA backend.\nOn rouge, there was an improvement of ~8% against our golden dataset. If no name\nis generated, it falls back to the local model for name generation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318789\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_auto_tab_grouping_labeling.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_organize_tabs_callout.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/aiwindow/ui/test/xpcshell/test_AutoTabGrouping.js", "toolkit/components/ml/content/EngineProcess.sys.mjs"], "git_node": "60e482af8dea4ca5cc2099a5abb3efed20d18e78", "git_parents": ["65a30e4d9f70456b38ac56fb7976eccb18ebb246"], "node": "16945392f84e3018ef07a2c039f2c75b4ad6f94c", "parents": ["29777a9c84849a6415f7d2dfe523ab98e536f3ad"], "tags": []}, {"author": "Christopher DiPersio \u003ccdipersio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063727 - PUWYLO v0 Fast Follow : Reduce mismatch between follow up message and links contained in preview r=cmurray,echa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319187\n", "files": ["browser/components/aiwindow/models/ConversationSuggestions.sys.mjs", "browser/components/aiwindow/models/SearchBrowsingHistory.sys.mjs", "browser/components/aiwindow/models/memories/MemoriesHistorySource.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_conversation_starters.js", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "39051505bba6110be7001120d733e88322cfff87", "git_parents": ["60e482af8dea4ca5cc2099a5abb3efed20d18e78"], "node": "999dd9555d268b5acfe1b25c3a85443502d7b585", "parents": ["16945392f84e3018ef07a2c039f2c75b4ad6f94c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062572 - Wait for the places context menu to be open before activating an item in the sidebar telemetry tests, r=places-reviewers,Standard8.\n\nThese tests synthesized a contextmenu click and then clicked a menu item\nwithout waiting for the menu to open. The click does not go through the path a\nuser takes, and the harness now fails tests that click inside a popup that is\nnot open.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318721\n", "files": ["browser/components/places/tests/browser/browser_sidebar_bookmarks_telemetry.js", "browser/components/places/tests/browser/browser_sidebar_history_telemetry.js"], "git_node": "490919161f63e3d7a6487ba99284ddea8071f741", "git_parents": ["39051505bba6110be7001120d733e88322cfff87"], "node": "1c8b832e751fb6cabf24f52e9add40b8c666eca6", "parents": ["999dd9555d268b5acfe1b25c3a85443502d7b585"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055043 - Inset test content past Nova's rounded content-area corners and re-enable browser_test_position_sticky.js under Nova r=sthompson,hiro\" for causing bc failures @browser_test_content_area_corner_flicker.js.\n\nThis reverts commit eeda7055fc1dccce3f8c7291d1c0d19e54f83e7e.\n", "files": ["gfx/layers/apz/test/mochitest/browser.toml", "gfx/layers/apz/test/mochitest/browser_test_content_area_corner_flicker.js", "gfx/layers/apz/test/mochitest/helper_content_area_corner_flicker.html", "gfx/layers/apz/test/mochitest/helper_position_sticky_flicker.html", "gfx/layers/apz/test/mochitest/helper_scroll_linked_effect_by_wheel.html"], "git_node": "8fd2e87414e49f31a249b983f9c48706931547af", "git_parents": ["490919161f63e3d7a6487ba99284ddea8071f741"], "node": "a5ff239a115a5b446f5dafca36d059f3aaccdf11", "parents": ["1c8b832e751fb6cabf24f52e9add40b8c666eca6"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063759 - Avoid line-clamp style adjustment for displays that aren't block/inline. r=firefox-style-system-reviewers,emilio,layout-reviewers\" for causing wr failures @line-clamp-016.html.\n\nThis reverts commit b5762f7765acf378d48b08d15255c66ca6913c4e.\n", "files": ["layout/generic/nsBlockFrame.cpp", "servo/components/style/style_adjuster.rs", "testing/web-platform/tests/css/css-overflow/line-clamp/webkit-line-clamp-bug-2063759-crash.html"], "git_node": "d03dea60cb3072b54fd4cd9586b1e26fd2cc5718", "git_parents": ["8fd2e87414e49f31a249b983f9c48706931547af"], "node": "5b003e3b0670a14a4490514723f014ec5f84ca85", "parents": ["a5ff239a115a5b446f5dafca36d059f3aaccdf11"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2062783 - Use moz-src for sessionstore. r=Gijs,omc-reviewers,migration-reviewers,firefox-desktop-core-reviewers ,jswinarton,hsohaney,sclements,aminomancer,perftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317956\n", "files": ["browser/actors/AboutTabCrashedParent.sys.mjs", "browser/base/content/browser-places.js", "browser/base/content/browser.js", "browser/base/content/test/about/browser_aboutCertError.js", "browser/base/content/test/tabPrompts/browser_prompt_close_groups.js", "browser/base/content/test/tabcrashed/browser_autoSubmitRequest.js", "browser/components/BrowserComponents.manifest", "browser/components/BrowserContentHandler.sys.mjs", "browser/components/BrowserGlue.sys.mjs", "browser/components/DefaultBrowserCheck.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowTabStatesManager.sys.mjs", "browser/components/aiwindow/ui/modules/TabManagementService.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_session_restore.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_manage_tabs_tool.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_tab_move.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/backup/resources/SessionStoreBackupResource.sys.mjs", "browser/components/backup/tests/marionette/test_backup.py", "browser/components/backup/tests/xpcshell/test_SessionStoreBackupResource.js", "browser/components/contextualidentity/test/browser/browser_siteContainer_retarget.js", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "brow