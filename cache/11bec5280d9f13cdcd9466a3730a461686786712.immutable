3d0450109baa5256907239c28"], "node": "aa93302e230ff75f281ab92f2cc39e029c3aaa9d", "parents": ["b598d10761ce7997be573261f82e29c24172892f"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2064464: Modernize css error reporter to use StaticRefPtr. r=layout-reviewers,TYLin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319575\n", "files": ["layout/style/ErrorReporter.cpp"], "git_node": "7bfc01b46c33a5350ff617963ca37693126d5de8", "git_parents": ["13a59d190ac02d29529bf3d6bb0abb03c6ce6a2f"], "node": "21e4ae0f30c5d96736f6f749d0931ce93db084c1", "parents": ["aa93302e230ff75f281ab92f2cc39e029c3aaa9d"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064741 - Fix verifyLoginSaveInCustomTabTest efficiency UI test r=jajohnson\n\nThe test failed because it waited for the login form's username field to reappear after re-opening the page, but Firefox doesn't reliably re-expose web form fields to the test after coming back to the foreground\n\nThe fix waits for the browser view itself (ENGINE_VIEW) instead, which reliably confirms the app took over\n\nThe UI test successfully passed 25x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319835\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/CustomTabsTest.kt"], "git_node": "6f635a25d2011968c2164bcbd934dc9f2f27b5ef", "git_parents": ["7bfc01b46c33a5350ff617963ca37693126d5de8"], "node": "b0ba2bef5ef420ed479cb2eba6770b82599e89f8", "parents": ["21e4ae0f30c5d96736f6f749d0931ce93db084c1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2064683 - Remove CHROME_LOCATIONBAR / chromeclass-location. r=urlbar-reviewers,desktop-theme-reviewers,tabbrowser-reviewers,dao,extension-reviewers,mviar,robwu\n\nNothing can set this dynamically now.\n\nContent popup windows opened with location=no show the urlbar anyway,\nand we have tests for it.\n\nThe only cases where we had this behavior (implicitly) were:\n\n * Web extension popups, as in windows.create({ type: \"popup\" })\n * And the TOS chromeless window.\n\nBoth now get a readonly urlbar, like content popups.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316218\n", "files": ["browser/base/content/browser-init.js", "browser/base/content/navigator-toolbox.inc.xhtml", "browser/base/content/test/popupNotifications/browser_popupNotification_2.js", "browser/components/extensions/parent/ext-windows.js", "browser/components/extensions/test/browser/browser_ext_windows_create.js", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser_restored_window_features.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/modules/URILoadingHelper.sys.mjs", "browser/modules/test/browser/browser_URILoadingHelper_chromeless.js", "browser/themes/osx/browser.css", "browser/themes/shared/browser-shared.css", "dom/base/BarProps.cpp", "dom/tests/browser/browser_test_toolbars_visibility.js", "dom/tests/mochitest/chrome/chrome.toml", "dom/tests/mochitest/chrome/focus_frameset.html", "dom/tests/mochitest/chrome/window_focus.xhtml", "dom/tests/mochitest/chrome/window_frameset.xhtml", "toolkit/components/browser/nsIWebBrowserChrome.idl", "toolkit/components/windowwatcher/nsWindowWatcher.cpp", "toolkit/components/windowwatcher/test/browser_new_content_window_chromeflags.js", "toolkit/components/windowwatcher/test/head.js", "toolkit/modules/PopupNotifications.sys.mjs", "toolkit/themes/shared/global-shared.css", "widget/tests/chrome.toml", "widget/tests/test_ime_state_others_in_parent.html", "widget/tests/window_imestate_iframes.html", "widget/tests/window_imestate_iframes.xhtml", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/nsAppShellService.cpp"], "git_node": "20dc96318eda00123273b3ea8a7fabbf86edbd1d", "git_parents": ["6f635a25d2011968c2164bcbd934dc9f2f27b5ef"], "node": "7e2dcea30a77ee20fcd2446e047aa3a9769eb2b4", "parents": ["b0ba2bef5ef420ed479cb2eba6770b82599e89f8"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2064250 - Skip browser_bug356571.js more obviously. r=firefox-desktop-core-reviewers ,mossop\n\nIf you look at the method test(), this does a todo(false) and nothing else.\n\nbrowser_bug356571.js is one of only a handful of uses of getClassObject,\nwhich I am trying to get rid of. The test has not actually done anything\nsince 2010, so I've marked it as being skipped in the .toml file. Nowadays\nyou can restore the original registration by passing in null for the\nfactory, so I've done that, but I haven't been able to verify the\ncorrectness of this because the test fails.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319303\n", "files": ["browser/base/content/test/general/browser.toml", "browser/base/content/test/general/browser_bug356571.js"], "git_node": "0fe339e28ee586a4af06fa5c6ac61b903b854c3e", "git_parents": ["20dc96318eda00123273b3ea8a7fabbf86edbd1d"], "node": "03e11604a67cd94ef0a5f36be0d10a5bca56a704", "parents": ["7e2dcea30a77ee20fcd2446e047aa3a9769eb2b4"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2064250 - Remove some dead uses of getClassObject from tests. r=xpcom-reviewers,permissions-reviewers,timhuang,emilio\n\nThis is basically some leftovers from XPCOM static component work that happened in 2019.\n\nThe factory field in test_data_protocol_registration.js is not used. The use was\nremoved in bug 1524687 part 2.\n\ntest_no_remote_registration.js is basically the same thing. I also added newlines\nto the dump() call in two places.\n\nRemove the dead use of getClassObject in test_permmanager_migrate_4-7_no_history.js.\nThis probably did something once upon a time, but it shouldn't be needed any more.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319304\n", "files": ["chrome/test/unit/test_data_protocol_registration.js", "chrome/test/unit/test_no_remote_registration.js", "extensions/permissions/test/unit/test_permmanager_migrate_4-7_no_history.js"], "git_node": "1f9c42dc444caf31aa51a302324c1af2a41be8aa", "git_parents": ["0fe339e28ee586a4af06fa5c6ac61b903b854c3e"], "node": "9dc6763784bdea018f43cc122d059d9f9b6df6fa", "parents": ["03e11604a67cd94ef0a5f36be0d10a5bca56a704"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2064250 - Remove MockPermissionPrompt. r=jgraham\n\nThis is currently not used at all outside of a minor smoke test, which dates\nto the B2G era. This testing facility also appears to date to the B2G era.\nThis uses a very old code pattern for restoring a component registration, which makes\nme think that it was not used even back in 2019, when bug 1524687 landed and\ncleaned up a lot of that. Let's just remove it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319305\n", "files": ["testing/mochitest/tests/Harness_sanity/test_SpecialPowersExtension.html", "testing/specialpowers/content/MockPermissionPrompt.sys.mjs", "testing/specialpowers/content/SpecialPowersChild.sys.mjs", "testing/specialpowers/moz.build"], "git_node": "9aad320c034c6820a4a7fcfd6ab847ad2a560674", "git_parents": ["1f9c42dc444caf31aa51a302324c1af2a41be8aa"], "node": "83682829d1cf761490fc1782f2261bafce97e6d8", "parents": ["9dc6763784bdea018f43cc122d059d9f9b6df6fa"], "tags": []}, {"author": "Gregory Mierzwinski \u003cgmierz1@live.ca\u003e", "branch": "default", "desc": "Bug 2064459 - Output exception when one is hit in condprof. r=kshampur DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319816\n", "files": ["testing/condprofile/condprof/main.py", "testing/condprofile/condprof/util.py"], "git_node": "d28ab16f34f7bd6b9ae7127f319275c65d256fa2", "git_parents": ["9aad320c034c6820a4a7fcfd6ab847ad2a560674"], "node": "4993ea4f9d526cf91868f04279ae4ce33f23e50f", "parents": ["83682829d1cf761490fc1782f2261bafce97e6d8"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2063986 - Guard the updater preallocation on a successful open and check posix_fallocate (Coverity CID 1700143) r=application-update-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319034\n", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": "5ddd23b1cfdacedd2eae4d2bdd6a8237e42cd8fe", "git_parents": ["d28ab16f34f7bd6b9ae7127f319275c65d256fa2"], "node": "95cb0528d65e7230a1b50e13412e4e5bd584d09f", "parents": ["4993ea4f9d526cf91868f04279ae4ce33f23e50f"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064401 - Re-add mochitest-remote to the macosx1500-aarch64-vms test set. r=aryx\n\nThis is the exact inverse of D316346 (bug 2059365), which removed the suite on the\nbasis that it \"has been failing consistently since it was enabled\" and that \"window\nactivation never completes on these workers\". Neither claim holds up against the job\nhistory.\n\nActual history of the suite on this platform: 385 success / 151 testfailed, a 72% pass\nrate, clean from 2026-05-29 to 2026-06-03. The failures were per-slot and binary rather\nthan uniform: a subset of slots never passed a single run while the remainder sat at\n~100%, so the apparent decline over time was the bad cohort growing as a share of the\npool. The same slots were concurrently pulling the already-enabled suites down to 52-73%\npass against 93-99% on healthy slots, which identifies this as worker health rather than\na property of the suite.\n\nRoot cause was disk exhaustion from two unaccounted OS-owned caches (Rosetta oah and\ncoresymbolicationd) crossing generic-worker's 20 GiB free-space floor. Those are now\nbounded between tasks in ronin_puppet and all 26 slots have been rolled onto the fixed\nimage.\n\nThese workers are not missing the capability the removed comment described. Verified\ninside live production guests: a real Aqua login session owned by the task user, a\nrunning WindowServer, and a live 1024x768 CoreGraphics display, awake and unlocked, with\nNSScreen.screens.count == 1 and virtual USB keyboard and pointer devices present.\nsystem_profiler SPDisplaysDataType is empty on these guests, but that reflects IOKit\nenumeration only and does not reach CoreGraphics or AppKit. The in-tree docstring for\n_running_on_macos_vm in marionette_test/decorators.py already records this.\n\nConfirmed by two independent try pushes on separate bases after the slot re-roll:\n\n  https://treeherder.mozilla.org/jobs?repo=try&revision=a015776ae7aa\n  https://treeherder.mozilla.org/jobs?repo=try&revision=ba511bdd6f2f\n\n40/40 mochitest-remote jobs green across 24 of the 26 slots, median 3.5 minutes per task\nagainst a ~75 minute hang, zero non-success results. The comment paragraph is removed\nbecause it would otherwise keep directing readers to a conclusion the data does not\nsupport.\n\nBug 2050174 remains the right tracking bug for the residual issue, but wants re-scoping:\nthe environment can deliver window activation. The defect is that SimpleTest.promiseFocus\nawaits a focus event with no timeout and no fallback, so a marginal timing race becomes a\nfull harness timeout instead of a single test failure.\n\nFleet-side work is tracked in RELOPS-2517.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319472\n", "files": ["taskcluster/test_configs/test-sets.yml"], "git_node": "9ce133953d96a7f8ca6771b2f71054f58f1c2d4e", "git_parents": ["5ddd23b1cfdacedd2eae4d2bdd6a8237e42cd8fe"], "node": "d930c4ef534e1a706da82e959853fe08d0f3f39a", "parents": ["95cb0528d65e7230a1b50e13412e4e5bd584d09f"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057895 - Re-enable autoscroll overflow test on Linux 22.04 with nova pref r=akulyk\n\nBug reporter confirmed the failure appears to be a Wayland issue specific to Linux 22.04. I can't reproduce it.\nBut either way, this removes the skip, which was targeting tests that don't run in production anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319795\n", "files": ["toolkit/content/tests/browser/browser.toml"], "git_node": "1de568bc406747e906d1bff366b351dc0bdb4029", "git_parents": ["9ce133953d96a7f8ca6771b2f71054f58f1c2d4e"], "node": "c4561f7cae667a5a4b0ef059235edf1afcfe2d59", "parents": ["d930c4ef534e1a706da82e959853fe08d0f3f39a"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Make android-detekt tasks clone with Git, r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319732\n", "files": ["taskcluster/kinds/source-test/android-detekt.yml"], "git_node": "d09e182fab97ba801e58d0d23b5deab8736419f5", "git_parents": ["1de568bc406747e906d1bff366b351dc0bdb4029"], "node": "368d32500ce7acd4007fd3681e69dc94b8358da6", "parents": ["c4561f7cae667a5a4b0ef059235edf1afcfe2d59"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Make file-metadata tasks clone with Git, r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319807\n", "files": ["python/mozbuild/mozbuild/frontend/mach_commands.py", "taskcluster/kinds/source-test/file-metadata.yml"], "git_node": "43636ce29933729e1d2ecdfa8848d2fcff4a3575", "git_parents": ["d09e182fab97ba801e58d0d23b5deab8736419f5"], "node": "57ee09e306cace36bbfbcc5957a66eedb3c066b8", "parents": ["368d32500ce7acd4007fd3681e69dc94b8358da6"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063684 - Update the 7-double-row-2-ad fallback in SectionsLayoutFeed to match Remote Settings. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318782\n", "files": ["browser/extensions/newtab/lib/SectionsLayoutFeed.sys.mjs"], "git_node": "19651dae6e968c0307c1bdc9864d5b603137bbdb", "git_parents": ["43636ce29933729e1d2ecdfa8848d2fcff4a3575"], "node": "7e20d65797f554f76fa6aed46617bec9beb341fc", "parents": ["57ee09e306cace36bbfbcc5957a66eedb3c066b8"], "tags": []}, {"author": "andyh \u003candhuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056984 - Source crash targeting attributes from getCrashes and add previousSessionCrashed. r=omc-reviewers,mimi\n\nASRouter's crash targeting attributes (crashCount, daysSinceLastCrash,\ncrashCountInLastDay, crashCountInLastWeek) were derived from\nServices.crashmanager.submittedDumps(), which only records a crash after its\nreport is submitted. This measured submission time, not crash time, and\ndepended on the user consenting to submit.\n\nPoint the shared crashData getter at Services.crashmanager.getCrashes(), which\nrecords crashes at crash time independent of submission. Each CrashRecord is\nnormalized to { id, date } so the downstream getters are unchanged. Also expose\npreviousSessionCrashed on ASRouterTargeting.Environment, sourced from\nSessionStartup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318567\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js"], "git_node": "e2ac6802e44eb56758a1afa5a15d277d95556669", "git_parents": ["19651dae6e968c0307c1bdc9864d5b603137bbdb"], "node": "a417d3cd6f1d522698137f6326114c79f194a272", "parents": ["7e20d65797f554f76fa6aed46617bec9beb341fc"], "tags": []}, {"author": "Aaron Ma \u003cmapengyu@gmail.com\u003e", "branch": "default", "desc": "Bug 2063818 - Avoid null dereference in committed key dispatch r=gtk-reviewers,emilio\n\nA Wayland text-input commit can arrive while the IM context is still\nvalid but no window is focused. DispatchKeyEventsForCommittedCharacter()\nthen passes a null mLastFocusedWindow to the keyboard event dispatcher\nand crashes while retrieving its TextEventDispatcher.\n\nReturn before dispatching synthesized key events when there is no\nfocused window.\n\nSigned-off-by: Aaron Ma \u003cmapengyu@gmail.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319691\n", "files": ["widget/gtk/IMContextWrapper.cpp"], "git_node": "f66ab2d39e45aa8c457610ac541b77a17e0bfcbe", "git_parents": ["e2ac6802e44eb56758a1afa5a15d277d95556669"], "node": "4506dc48064fc43ae07116fb9849b2df54694b74", "parents": ["a417d3cd6f1d522698137f6326114c79f194a272"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2064745 - Set layout.css.typed-om.enabled for idlharness.window.js tests r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319848\n", "files": ["testing/web-platform/meta/svg/idlharness.window.js.ini"], "git_node": "f25366d9ce072d23a6499af5bb1cf2be42c029f1", "git_parents": ["f66ab2d39e45aa8c457610ac541b77a17e0bfcbe"], "node": "905adac2f4e5bec75616dc00d47d723090854e15", "parents": ["4506dc48064fc43ae07116fb9849b2df54694b74"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061505. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316963\n", "files": ["dom/canvas/DrawTargetWebgl.cpp"], "git_node": "c172339cb062bbdacfcf7bc6063185458d189117", "git_parents": ["f25366d9ce072d23a6499af5bb1cf2be42c029f1"], "node": "03edf8819bb9cb6fdf3f045cd8f5f25340966806", "parents": ["905adac2f4e5bec75616dc00d47d723090854e15"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061495. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317641\n", "files": ["dom/canvas/DrawTargetWebgl.cpp"], "git_node": "fb2edfd6d387de7eb8bfa1d111d845adef662ddb", "git_parents": ["c172339cb062bbdacfcf7bc6063185458d189117"], "node": "d18079e97cab21cea43f7b87b5b381f018c62e89", "parents": ["03edf8819bb9cb6fdf3f045cd8f5f25340966806"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063454 - Improve the layout of the toolkit/components/search metrics in the Glean dictionary. r=search-reviewers,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318590\n", "files": ["toolkit/components/search/metrics.yaml"], "git_node": "8d62da6a1699a987c2a103c7f6b3330319f1f10d", "git_parents": ["fb2edfd6d387de7eb8bfa1d111d845adef662ddb"], "node": "07b79b011551b22f75f3d74d5f3ba4197c0b3a66", "parents": ["d18079e97cab21cea43f7b87b5b381f018c62e89"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063084 - Part 1: Select Safari for the video playback latency suite in the general perf cron. r=perftest-reviewers,sparky\n\nThe suite [1] already declares Safari and already generates a task, but the\nperiodic performance cron never selected it, so the suite has never produced a\nsingle Safari result. The cron is the only route that can run it, because the\nnon-Firefox applications are configured never to run on a push. Allow the cron\nto pick it up so cross-browser media comparison produces data.\n\nThe condition matches the browser as well as the suite, so it changes nothing\nfor Firefox. Firefox runs this suite on push already and does not need the cron;\nmatching the suite alone would schedule that same work a second time, three\ntimes a week, for no extra coverage.\n\nWebcodecs [2] also declares Safari and is deliberately left out for now. Without\nits own subtest list it inherits the Firefox set, which includes camera variants\nthat rely on a fake camera device only Firefox provides, so those would fail.\nEnabling it needs that list first and is tracked separately.\n\n[1] https://searchfox.org/mozilla-central/source/taskcluster/kinds/browsertime/desktop.yml#1107\n[2] https://searchfox.org/mozilla-central/source/taskcluster/kinds/browsertime/desktop.yml#1142\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318790\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py"], "git_node": "ba7a3b062aec09639f5e6823e15fb82b5f899f90", "git_parents": ["8d62da6a1699a987c2a103c7f6b3330319f1f10d"], "node": "df5f126da88a4d99ba209d8f13deb20a72cd73ea", "parents": ["07b79b011551b22f75f3d74d5f3ba4197c0b3a66"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063084 - Part 2: Add a cron selection test for the video playback latency suite. r=perftest-reviewers,sparky\n\nGuards the periodic performance cron against silently dropping this suite for\nSafari again. Nothing covered cron selection for it before, which is why the\nomission went unnoticed rather than turning red.\n\nThe task and graph builders are written out locally rather than taken from the\nshared test helpers, to match the existing selection test in this file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318791\n", "files": ["taskcluster/gecko_taskgraph/test/test_target_tasks.py"], "git_node": "f25a00169ccae0efd108b1a84375482adc62481f", "git_parents": ["ba7a3b062aec09639f5e6823e15fb82b5f899f90"], "node": "6aae652ee6585f299e34e22eece73c9ab2f265ad", "parents": ["df5f126da88a4d99ba209d8f13deb20a72cd73ea"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064079 - Check in ktfmt idea configuration into tree r=adhingra,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319183\n", "files": [".idea/ktfmt.xml"], "git_node": "ac2ded31d05407b1a527ba882e4f0ae87afc21a5", "git_parents": ["f25a00169ccae0efd108b1a84375482adc62481f"], "node": "da1220a8f11d9183829192814371cad512e97137", "parents": ["6aae652ee6585f299e34e22eece73c9ab2f265ad"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2061103 - Update encoding_rs to main before 0.8.40. r=supply-chain-reviewers,afranchuk,dminor\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316770\n", "files": [".cargo/config.toml.in", "Cargo.lock", "Cargo.toml", "js/src/builtin/normalizer_glue/Cargo.toml", "supply-chain/audits.toml", "supply-chain/imports.lock", "third_party/rust/core_detect/.cargo-checksum.json", "third_party/rust/core_detect/.cargo_vcs_info.json", "third_party/rust/core_detect/.github/workflows/ci.yml", "third_party/rust/core_detect/Cargo.toml", "third_party/rust/core_detect/Cargo.toml.orig", "third_party/rust/core_detect/Cross.toml", "third_party/rust/core_detect/LICENSE-APACHE", "third_party/rust/core_detect/LICENSE-MIT", "third_party/rust/core_detect/README.md", "third_party/rust/core_detect/src/arch/x86.rs", "third_party/rust/core_detect/src/cache.rs", "third_party/rust/core_detect/src/lib.rs", "third_party/rust/core_detect/src/macros.rs", "third_party/rust/core_detect/src/os/x86.rs", "third_party/rust/core_detect/tests/compare_cupid.rs", "third_party/rust/core_detect/tests/compare_std.rs", "third_party/rust/encoding_rs/.cargo-checksum.json", "third_party/rust/encoding_rs/CONTRIBUTING.md", "third_party/rust/encoding_rs/Cargo.toml", "third_party/rust/encoding_rs/Ideas.md", "third_party/rust/encoding_rs/README.md", "third_party/rust/encoding_rs/ci/miri.sh", "third_party/rust/encoding_rs/doc/Big5.txt", "third_party/rust/encoding_rs/doc/EUC-JP.txt", "third_party/rust/encoding_rs/doc/EUC-KR.txt", "third_party/rust/encoding_rs/doc/GBK.txt", "third_party/rust/encoding_rs/doc/IBM866.txt", "third_party/rust/encoding_rs/doc/ISO-2022-JP.txt", "third_party/rust/encoding_rs/doc/ISO-8859-10.txt", "third_party/rust/encoding_rs/doc/ISO-8859-13.txt", "third_party/rust/encoding_rs/doc/ISO-8859-14.tx