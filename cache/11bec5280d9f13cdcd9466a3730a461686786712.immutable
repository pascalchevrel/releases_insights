b3fb2528c27ac6092", "parents": ["85894ea33e757512ac5f0845edef609d4d99e657"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2024248 - fix.  r=yury.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313938\n", "files": ["js/src/wasm/WasmBCClass.h", "js/src/wasm/WasmBCFrame.cpp", "js/src/wasm/WasmBaselineCompile.cpp"], "git_node": "49c76e5ffdafd788e7401f1b6a3a34d9bf7a605e", "git_parents": ["6633802a15fb420421077b83beb4adac10165e67"], "node": "75429f68b865f9d3719917cd54a9247575469491", "parents": ["2a44f33d0248b486d0c3df9b3fb2528c27ac6092"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2065910 [wpt PR 62163] - Update Test262 tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate Test262 tests\n\n--\n\nwpt-commits: 1ba75cacd03c3495c1b9033176d7d3e6545179df\nwpt-pr: 62163\n", "files": ["testing/web-platform/tests/third_party/test262/test/built-ins/Promise/try/avoids-wrap-for-subclass.js", "testing/web-platform/tests/third_party/test262/test/built-ins/Promise/try/avoids-wrap.js", "testing/web-platform/tests/third_party/test262/test/built-ins/Promise/try/ctx-ctor-for-error.js", "testing/web-platform/tests/third_party/test262/vendored.toml"], "git_node": "811b6743e06a95178e2fb232bb115a0cd8a165d6", "git_parents": ["49c76e5ffdafd788e7401f1b6a3a34d9bf7a605e"], "node": "9374cc3bf3a418ee03818cba018de25c1f74b3f5", "parents": ["75429f68b865f9d3719917cd54a9247575469491"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2065908 [wpt PR 62162] - Update Wasm tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate Wasm tests (proposals)\n\n--\n\nwpt-commits: 82043f9401e166afcec705a58042c2b37f957038\nwpt-pr: 62162\n", "files": ["testing/web-platform/tests/wasm/proposals/wide-arithmetic/core/js/harness/async_index.js", "testing/web-platform/tests/wasm/proposals/wide-arithmetic/core/js/harness/sync_index.js", "testing/web-platform/tests/wasm/proposals/wide-arithmetic/core/js/wide-arithmetic.wast.js", "testing/web-platform/tests/wasm/proposals/wide-arithmetic/core/wide-arithmetic.wast.js.tentative.html"], "git_node": "7689dac6bc559a3c19a0003d1dd07212753cade5", "git_parents": ["811b6743e06a95178e2fb232bb115a0cd8a165d6"], "node": "99b650b05cca78fdfa466d21e9f0b3d724a42770", "parents": ["9374cc3bf3a418ee03818cba018de25c1f74b3f5"], "tags": []}, {"author": "Dominic Farolino \u003cdom@chromium.org\u003e", "branch": "default", "desc": "Bug 2066491 [wpt PR 62189] - Fix microtask race in src-repeated-in-ancestor.html test, a=testonly\n\nAutomatic update from web-platform-tests\nFix microtask race in src-repeated-in-ancestor.html test\n\nThe test previously used:\n\n```\nPromise.race([\n  subjectNavigation.then(...),\n  controlNavigation]\n);\n```\n\n... to detect if an iframe associated with `subjectNavigation` navigated\nto a URL that matches an ancestor URL. In Chromium, when beforeunload\nfired synchronously in both iframes, wrapping subjectNavigation in a\n`.then()` created a pending promise whose microtask ran after\n`controlNavigation` had already settled.\n\nThis caused Promise.race to resolve with controlNavigation first,\naccidentally masking any navigation/beforeunload events on the subject\niframe, which is used to assert that a navigation *didn't* take place in\nthat iframe at all.\n\nThis CL replaces the `Promise.race()` *race* with an explicit check\nensuring no beforeunload event was dispatched on the subject iframe by\nthe time the control iframe finishes loading. Chromium fails the fixed\ntest which reveals that we never implemented step 3 of\nhttps://html.spec.whatwg.org/C#shared-attribute-processing-steps-for-iframe-and-frame-elements in the HTML Standard:\n\n```\nIf the inclusive ancestor navigables of element's node navigable contains a navigable whose active document's URL equals url with exclude fragments set to true, then return null.\n```\n\nThis was found during investigation in\nhttps://github.com/whatwg/html/issues/12800.\n\nR=nrosenthal\n\nBug: N/A\nChange-Id: I03c205aef55db2daf1cfa6fde8ef0df7d08a79ac\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8281045\nCommit-Queue: Dominic Farolino \u003cdom@chromium.org\u003e\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1685576}\n\n--\n\nwpt-commits: a71786da31059e36cb24a6a5596173a1cb12be79\nwpt-pr: 62189\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-iframe-element/src-repeated-in-ancestor.html"], "git_node": "45d17d9d90c34af66f8013ec575c8257d02377f0", "git_parents": ["7689dac6bc559a3c19a0003d1dd07212753cade5"], "node": "d5dcc945d1ebc29b84890b02c784b830edb9278e", "parents": ["99b650b05cca78fdfa466d21e9f0b3d724a42770"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066491 [wpt PR 62189] - Update wpt metadata, a=testonly\n\nwpt-pr: 62189\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/the-iframe-element/src-repeated-in-ancestor.html.ini"], "git_node": "4eacc1c034d9cfd9d8472d7fa603ceb90e58e2f0", "git_parents": ["45d17d9d90c34af66f8013ec575c8257d02377f0"], "node": "93bb0416e78bf153ed8155dd546bed8757370d2b", "parents": ["d5dcc945d1ebc29b84890b02c784b830edb9278e"], "tags": []}, {"author": "lilly \u003c173393835+cupidsity@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2063189 [wpt PR 61908] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320753, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export: corner-shape: adopt the revised contoured-path algorithm (#61908)\n\nhttps://bugs.webkit.org/show_bug.cgi?id=320753\n\nCo-authored-by: lilly \u003c173393835+codedbycupidity@users.noreply.github.com\u003e\n--\n\nwpt-commits: 196629819826d0ebf7fd99e1d6603cbfaefc1656\nwpt-pr: 61908\n", "files": ["testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-box-shadow-spread-bevel-ref.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-box-shadow-spread-bevel.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-box-shadow-spread-elliptical-ref.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-box-shadow-spread-elliptical.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-outline-offset-bevel-ref.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-outline-offset-bevel.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-outline-offset-elliptical-ref.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-outline-offset-elliptical.html"], "git_node": "8f89023971f71637e497409086d449fac13e4dda", "git_parents": ["4eacc1c034d9cfd9d8472d7fa603ceb90e58e2f0"], "node": "5423b54e319834018dda6d240c1e9f6902a00a27", "parents": ["93bb0416e78bf153ed8155dd546bed8757370d2b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063189 [wpt PR 61908] - Update wpt metadata, a=testonly\n\nwpt-pr: 61908\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-box-shadow-spread-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-box-shadow-spread-elliptical.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-outline-offset-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-outline-offset-elliptical.html.ini"], "git_node": "e1ae44088b30e627c020edc78f85651ac4f52f65", "git_parents": ["8f89023971f71637e497409086d449fac13e4dda"], "node": "b7d30464b2cb888d616e9cbad13903363bafc1c9", "parents": ["5423b54e319834018dda6d240c1e9f6902a00a27"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2066637 [wpt PR 62194] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=319190, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=319190 (#62194)\n--\n\nwpt-commits: 426db04bdc925dcbabd12d226138f867c9a4daa4\nwpt-pr: 62194\n", "files": ["testing/web-platform/tests/css/css-flexbox/align-content-001.htm", "testing/web-platform/tests/css/css-flexbox/align-content-005.htm", "testing/web-platform/tests/css/css-flexbox/align-items-001.htm", "testing/web-platform/tests/css/css-flexbox/align-items-003.htm", "testing/web-platform/tests/css/css-flexbox/align-items-004.htm"], "git_node": "757016604e057a3ea55123925d5163bd960c7050", "git_parents": ["e1ae44088b30e627c020edc78f85651ac4f52f65"], "node": "54eb5930eba3566444ae60efea4d751436f9be68", "parents": ["b7d30464b2cb888d616e9cbad13903363bafc1c9"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2066595 [wpt PR 62191] - sttf: Bind the trusted initiator to the initiator creating the fragment, a=testonly\n\nAutomatic update from web-platform-tests\nsttf: Bind the trusted initiator to the initiator creating the fragment\n\nWhen we create a scroll to text fragment, we might delay processing it\nuntil related page sets are finalized. Meanwhile, we may do a same\ndoc navigation. Ensure that when we check security restrictions, we\ncheck whether the initiator is trusted using the initiator that created\nthe fragment, not the latest initiator which may be the wrong thing to\nuse.\n\nR=bokan@chromium.org\n\nBug: 549911100\nChange-Id: Iabf8796c38576c4bc17549e6c8a1509d5751b731\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8286565\nReviewed-by: David Bokan \u003cbokan@chromium.org\u003e\nReviewed-by: Dave Tapuska \u003cdtapuska@chromium.org\u003e\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1685838}\n\n--\n\nwpt-commits: e2179c40fb20102ca231f8bf8ce811ea10b74bda\nwpt-pr: 62191\n", "files": ["testing/web-platform/tests/scroll-to-text-fragment/scroll-to-text-fragment-security-replacestate-target.html", "testing/web-platform/tests/scroll-to-text-fragment/scroll-to-text-fragment-security-replacestate.sub.html"], "git_node": "b260e9af85a3f8b1bde50db54ea39489540bfefa", "git_parents": ["757016604e057a3ea55123925d5163bd960c7050"], "node": "58cda7529f40cade4ddcfad42a1e750fc151335e", "parents": ["54eb5930eba3566444ae60efea4d751436f9be68"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066595 [wpt PR 62191] - Update wpt metadata, a=testonly\n\nwpt-pr: 62191\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/scroll-to-text-fragment/scroll-to-text-fragment-security-replacestate.sub.html.ini"], "git_node": "9aff81c0402d7f1ff061554509bfce4d015cf179", "git_parents": ["b260e9af85a3f8b1bde50db54ea39489540bfefa"], "node": "43c9d5545150dc4e1a4396628ae91fa23f261da0", "parents": ["58cda7529f40cade4ddcfad42a1e750fc151335e"], "tags": []}, {"author": "Xianzhu Wang \u003cwangxianzhu@chromium.org\u003e", "branch": "default", "desc": "Bug 2066638 [wpt PR 62195] - Fix anchor position to a merged sticky layer, a=testonly\n\nAutomatic update from web-platform-tests\nFix anchor position to a merged sticky layer\n\nPreviously, wen a sticky layer was merged into another, the\ncorresponding transform node might not be converted to cc. If the\ntransform node was referenced from an anchor position transform, the\nadjustment would fail.\n\nNow ensure the transform node is converted if it's referenced by any\nanchor position.\n\nAn alternative method could be to translate the element ids of\nanchor position adjustment containers to those of the transform nodes\nof the merged-into sticky layers, but that would need a bigger change\nwith limited benefit.\n\nBug: 547970041\nChange-Id: I2efa2af25c0ad7712e7637f7b3d478a8d3717934\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8265602\nCommit-Queue: Xianzhu Wang \u003cwangxianzhu@chromium.org\u003e\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1685877}\n\n--\n\nwpt-commits: a33a37cf86696aca2761e1255ef093a16e1b405d\nwpt-pr: 62195\n", "files": ["testing/web-platform/tests/css/css-anchor-position/anchor-scroll-to-sticky-multiple.html"], "git_node": "5782ecfbe72f235ce309d4d90c44b769feb50d90", "git_parents": ["9aff81c0402d7f1ff061554509bfce4d015cf179"], "node": "fe9016d254b7ae50ad9d85ee256a21af190f824d", "parents": ["43c9d5545150dc4e1a4396628ae91fa23f261da0"], "tags": []}, {"author": "Eldar Pulatov \u003cepulatov.dev@gmail.com\u003e", "branch": "default", "desc": "Bug 2066647 [wpt PR 62199] - [Layout] Fix sticky boxes under sticky inlines, a=testonly\n\nAutomatic update from web-platform-tests\n[Layout] Fix sticky boxes under sticky inlines\n\nA sticky `LayoutBox` can miss a sticky `LayoutInline` ancestor because\n`LocationContainer()` skips the inline before or during ancestor lookup.\nThis omits the ancestor's accumulated sticky-box offset. After a scroll,\nthe ancestor's movement is effectively applied twice, leaving the inner\nsticky box below its specified inset.\n\nUse `Container()` to map sticky-box geometry and traverse ancestors.\nStore each half-open range's endpoints and recompute the nearest sticky\nancestor on demand.\n\nCover missing areas with Blink unit, paint property and WPT tests.\nThe WPTs also cover both cases reported in crbug.com/41303922.\n\nBug: 372503461, 41303922\nChange-Id: I9f49b34ae4ccece8131b8d500645fa359f3bac49\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8252700\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCommit-Queue: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1685912}\n\n--\n\nwpt-commits: d236299acdabd3b5a0b6dfdcc1520028da1bff8c\nwpt-pr: 62199\n", "files": ["testing/web-platform/tests/css/css-position/sticky/position-sticky-block-in-sticky-inline.html", "testing/web-platform/tests/css/css-position/sticky/position-sticky-inline-block-in-sticky-inline.html"], "git_node": "cb4c9d358f65fb6923c76d16e63ced916503715f", "git_parents": ["5782ecfbe72f235ce309d4d90c44b769feb50d90"], "node": "416c4bb2c55cda827f17d0577808cbab6d94d529", "parents": ["fe9016d254b7ae50ad9d85ee256a21af190f824d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066647 [wpt PR 62199] - Update wpt metadata, a=testonly\n\nwpt-pr: 62199\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-position/sticky/position-sticky-block-in-sticky-inline.html.ini", "testing/web-platform/meta/css/css-position/sticky/position-sticky-continuation-crash.html.ini"], "git_node": "80c90f410106cbd7f97282ba5d7a0e9bb32e4c29", "git_parents": ["cb4c9d358f65fb6923c76d16e63ced916503715f"], "node": "b12ff7e67c03bc4cba6ccf4fcff69dced4a9b4a5", "parents": ["416c4bb2c55cda827f17d0577808cbab6d94d529"], "tags": []}, {"author": "Sergey Rubanov \u003cchi187@gmail.com\u003e", "branch": "default", "desc": "Bug 2065715 [wpt PR 62118] - [wasm] Match ESM worker tests to worker-helper message shape, a=testonly\n\nAutomatic update from web-platform-tests\n[wasm] Match ESM worker tests to worker-helper message shape (#62118)\n\nworker-helper.js posts {value, checks} since the source-phase import\nwork. worker-import still compared msg.data to 42, and worker.tentative\ncompared the MessageEvent itself to 42. Align both with\nworker-import-source-phase.\n--\n\nwpt-commits: 63ad27f71f8f2596fb303c9f45f24b05dab5f628\nwpt-pr: 62118\n", "files": ["testing/web-platform/tests/wasm/webapi/esm-integration/worker-import.tentative.html", "testing/web-platform/tests/wasm/webapi/esm-integration/worker.tentative.html"], "git_node": "349f6a6499b653d1b790cd0ae232b7fd5b732014", "git_parents": ["80c90f410106cbd7f97282ba5d7a0e9bb32e4c29"], "node": "dc07eb47d7f897d16ebe7634fcb726937e75adc7", "parents": ["b12ff7e67c03bc4cba6ccf4fcff69dced4a9b4a5"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2066654 [wpt PR 62201] - [html-in-canvas] Avoid redundant onpaint for nested canvases, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Avoid redundant onpaint for nested canvases\n\nThis patch fixes an extra onpaint event with nested layoutsubtree\ncanvases. Nested layoutsubtree canvases do not need paint invalidation\nwhen they change, as they are painted via their CustomDataOp\nplaceholders.\n\nFixed: 552469830\nChange-Id: Ie15265b57d96531e1357076003ab5b74ced3d2c5\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8286631\nReviewed-by: Stephen Chenney \u003cschenney@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1686010}\n\n--\n\nwpt-commits: 7fab9c5b0c378da91dd1c156400f051abb96f550\nwpt-pr: 62201\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/onpaint-post-tree-order.tentative.html"], "git_node": "d43e7e7e7411cc6a9aa4f6379c95b628b5027121", "git_parents": ["349f6a6499b653d1b790cd0ae232b7fd5b732014"], "node": "25d957780740e6f3a5a4cf47f1b2393c6d9f8b86", "parents": ["dc07eb47d7f897d16ebe7634fcb726937e75adc7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066654 [wpt PR 62201] - Update wpt metadata, a=testonly\n\nwpt-pr: 62201\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/onpaint-post-tree-order.tentative.html.ini"], "git_node": "148ec62faeff708a43b33ccfebf9f44b72804e98", "git_parents": ["d43e7e7e7411cc6a9aa4f6379c95b628b5027121"], "node": "90517871dd4c08981e83ba671d9e50629735e94c", "parents": ["25d957780740e6f3a5a4cf47f1b2393c6d9f8b86"], "tags": []}, {"author": "Ho Cheung \u003chocheung@chromium.org\u003e", "branch": "default", "desc": "Bug 2066645 [wpt PR 62197] - [webaudio] Add shared port for global-scope messaging, a=testonly\n\nAutomatic update from web-platform-tests\n[webaudio] Add shared port for global-scope messaging\n\nAdd the spec-defined shared MessagePort between AudioWorklet on the main\nthread and AudioWorkletGlobalScope on the rendering thread, behind the\nAudioWorkletSharedPort runtime flag.\n\nThis exposes AudioWorklet.port and AudioWorkletGlobalScope.port when the\nflag is enabled, creates the shared MessageChannel when AudioWorklet is\nconstructed, and entangles the rendering-side port when the global scope\nis created. The existing AudioWorkletProcessor.port remains unchanged.\n\nUpdate runtime-flag expectations so the new API is exposed in default\nweb test configurations with experimental features enabled, but not in\nstable expectations.\n\nBinary-Size: 12-byte generated base::Feature for Finch control.\nBug: 446920095\nChange-Id: I136973405a0ad866e977c3c893365fba6e981089\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7710652\nReviewed-by: Nate Chapin \u003cjaphet@chromium.org\u003e\nReviewed-by: Hongchan Choi \u003chongchan@chromium.org\u003e\nCommit-Queue: Hongchan Choi \u003chongchan@chromium.org\u003e\nReviewed-by: Mahesh Kannan \u003ckmaheshb@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1686039}\n\n--\n\nwpt-commits: 684c5fae6b846d05c76d19ee70d3ed761283e155\nwpt-pr: 62197\n", "files": ["testing/web-platform/tests/webaudio/the-audio-api/the-audioworklet-interface/audioworklet-messageport.https.html", "testing/web-platform/tests/webaudio/the-audio-api/the-audioworklet-interface/processors/port-processor.js"], "git_node": "31317680da38a048fbb56810a9b516f956fbb46b", "git_parents": ["148ec62faeff708a43b33ccfebf9f44b72804e98"], "node": "9a3bef4c00269c95e5a2dc1a07095d0f521c8335", "parents": ["90517871dd4c08981e83ba671d9e50629735e94c"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2066661 [wpt PR 62204] - [html-in-canvas] Use cleaner drawable semantics, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Use cleaner drawable semantics\n\nThis patch changes drawable to mean:\n* isolation: isolate\n* container for fixed and absolute\n\nPreviously, we used `contain: paint`, but this has been removed, as\nthere is no need to clip the drawable output. Previously, we converted\ninlines to inline-blocks, but this has been removed because, similar to\nfilter, inlines can be a containing block for descendants without being\ninline-blocks.\n\nChange-Id: I482a139ed914fb11faa8f43695d2465bdde354ae\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8283068\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1686030}\n\n--\n\nwpt-commits: 2037d80d22a41301a752635f939a0e74478854a3\nwpt-pr: 62204\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/canvas-transform-get-bounding-client-rect.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/child-overflow-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/child-overflow.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/clips-overflow-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/clips-overflow.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/containment.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/inline-fixed-containment-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/inline-fixed-containment.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/inline-fragments-drawable-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/inline-fragments-drawable.tentative.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/inline-size-change-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/inline-size-change.tentative.html"], "git_node": "532cac29852c4b4f36699eb0be8c1d4084722716", "git_parents": ["31317680da38a048fbb56810a9b516f956fbb46b"], "node": "06eb49670375bca252027c60d07725c53bc389ea", "parents": ["9a3bef4c00269c95e5a2dc1a07095d0f521c8335"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066661 [wpt PR 62204] - Update wpt metadata, a=testonly\n\nwpt-pr: 62204\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/canvas-transform-get-bounding-client-rect.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/clips-overflow.tentative.html.ini"], "git_node": "ff0254a841ca2ba7ba1617b7266ce9e5d3b86185", "git_parents": ["532cac29852c4b4f36699eb0be8c1d4084722716"], "node": "eee7eb3412eb3be34ebe73d29fcd9493b25264c5", "parents": ["06eb49670375bca252027c60d07725c53bc389ea"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2066146 [wpt PR 62174] - Test parser element insertion when a custom element reaction reparents nodes, a=testonly\n\nAutomatic update from web-platform-tests\nTest parser element insertion when a custom element reaction reparents nodes\n\nThe custom element constructor, and attributeChangedCallback for the token's\nattributes, both run while creating an element for the token, before the element\nis inserted. They can give the element a parent, detach the intended parent, or\nmove the intended parent inside the element.\n\nSee https://github.com/whatwg/html/issues/12494 for context.\n--\n\nwpt-commits: c0cecef6bc584af0f4959ae006d1e8f0d8ef7ea7\nwpt-pr: 62174\n", "files": ["testing/web-platform/tests/html/semantics/scripting-1/the-template-element/template-element/template-content-hierarcy.html", "testing/web-platform/tests/html/syntax/parsing/custom-element-reparenting-shadow-cycle.html", "testing/web-platform/tests/html/syntax/parsing/custom-element-reparenting-template-cycle.html", "testing/web-platform/tests/html/syntax/parsing/custom-element-reparenting.html"], "git_node": "366fc834306975b449aed81f996b5b3c3b32c1a5", "git_parents": ["ff0254a841ca2ba7ba1617b7266ce9e5d3b86185"], "node": "40d050c865b53921356f1344c85b1d970523d6dc", "parents": ["eee7eb3412eb3be34ebe73d29fcd9493b25264c5"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066146 [wpt PR 62174] - Update wpt metadata, a=testonly\n\nwpt-pr: 62174\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/syntax/parsing/custom-element-reparenting-shadow-cycle.html.ini", "testing/web-platform/meta/html/syntax/parsing/custom-element-reparenting-template-cycle.html.ini", "testing/web-platform/meta/html/syntax/parsing/custom-element-reparenting.html.ini"], "git_node": "6eeb3d1a06bc88f5873315b882512a5043f1df26", "git_parents": ["366fc834306975b449aed81f996b5b3c3b32c1a5"], "node": "f4521f39d04b4f06fb3c780806461d0320113a3c", "parents": ["40d050c865b53921356f1344c85b1d970523d6dc"], "tags": []}, {"author": "Shubham Gupta \u003cshubham.gupta@chromium.org\u003e", "branch": "default", "desc": "Bug 2066696 [wpt PR 62208] - Elide intermediate Identity operation from TFlite graph builder, a=testonly\n\nAutomatic update from web-platform-tests\nElide intermediate Identity operation from TFlite graph builder\n\nGraph output tensors must be produced by an operator in the TFLite\nflatbuffer, so use a reshape pass-through. Intermediate tensors are\nelided by redirecting the output operand to the input tensor\n\nBug: 336399247\nChange-Id: Ic50e2a923126ecf31dc64d45f7575c26ef00f9f8\nSigned-off-by: Shubham Gupta \u003cshubham.gupta@chromium.org\u003e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8186594\nReviewed-by: Reilly Grant \u003creillyg@chromium.org\u003e\nCommit-Queue: Reilly Grant \u003creillyg@chromium.org\u003e\nReviewed-by: Hu, Ningxin \u003cningxin.hu@intel.com\u003e\nCr-Commit-Position: refs/heads/main@{#1686092}\n\n--\n\nwpt-commits: f0a694965afd7eb4da71345de936f68d99548dca\nwpt-pr: 62208\n", "files": ["testing/web-platform/tests/webnn/conformance_tests/subgraph.https.any.js"], "git_node": "03be34e32f028fa5c50166ccd6f66eea1c278581", "git_parents": ["6eeb3d1a06bc88f5873315b882512a5043f1df26"], "node": "74baec56d0a4e7e226feb0bec9532677db2542af", "parents": ["f4521f39d04b4f06fb3c780806461d0320113a3c"], "tags": []}, {"author": "Ms2ger \u003cMs2ger@gmail.com\u003e", "branch": "default", "desc": "Bug 2066593 [wpt PR 62190] - Add CODEOWNERS for test262, a=testonly\n\nAutomatic update from web-platform-tests\nAdd CODEOWNERS for test262\n\nThis should prevent unsupported manual changes and also make sure someone is pinged to review the automated PRs.\n\nRef #61924.\n\n--\n\nwpt-commits: 0117c10ba60225c0865ed1a014ef2850b2e9c281\nwpt-pr: 62190\n", "files": ["testing/web-platform/tests/CODEOWNERS"], "git_node": "d048a5b20cd57841759ada20629088fbaabae0da", "git_parents": ["03be34e32f028fa5c50166ccd6f66eea1c278581"], "node": "c22449e928090e0c990a15d01de059802beefef2", "parents": ["74baec56d0a4e7e226feb0bec9532677db2542af"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2065906 [wpt PR 62161] - Cookies: test overwriting a cookie with a new value or attributes, a=testonly\n\nAutomatic update from web-platform-tests\nCookies: test overwriting a cookie with a new value or attributes\n\nA cookie set again with the same name, host and path has to replace the\nexisting one whenever its value or any attribute differs, and be observable\nwhen it does.\n\nSee https://github.com/httpwg/http-extensions/issues/3501.\n--\n\nwpt-commits: 816294d1ab6badadb081b5aa96a6d3d7be6f05c0\nwpt-pr: 62161\n", "files": ["testing/web-platform/tests/cookies/attributes/httponly-overwrite.https.window.js", "testing/web-platform/tests/cookies/value/value-overwrite.https.window.js", "testing/web-platform/tests/cookiestore/change_eventhandler_for_attribute_change.https.window.js"], "git_node": "f49f9fad825657e70d8b84275a4b6c1a40d170cb", "git_parents": ["d048a5b20cd57841759ada20629088fbaabae0da"], "node": "d96e84707ce71879bfec6926d235574abdb78583", "parents": ["c22449e928090e0c990a15d01de059802beefef2"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065906 [wpt PR 62161] - Update wpt metadata, a=testonly\n\nwpt-pr: 62161\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/cookiestore/cookieStore_getAll_set_basic.https.any.js.ini", "testing/web-platform/meta/cookiestore/cookieStore_get_delete_basic.https.any.js.ini"], "git_node": "39b5a45896e6ed67544d110a99b91f1345083896", "git_parents": ["f49f9fad825657e70d8b84275a4b6c1a40d170cb"], "node": "46e6cd80076a0b8763f3594d6fc9fbb0cd8517e6", "parents": ["d96e84707ce71879bfec6926d235574abdb78583"], "tags": []}, {"author": "Martin Robinson \u003cmrobinson@igalia.com\u003e", "branch": "default", "desc": "Bug 2065701 [wpt PR 62112] - script: Align live range update steps with specification, a=testonly\n\nAutomatic update from web-platform-tests\nscript: Align live range update steps with specification\n\nThis change reworks the live range update steps that show up in various\nplaces in the specification so that they match what the specification\nsays. Now updates to live ranges uses the existing `set_start` and\n`set_end` APIs which simplify the code greatly as they already handle\nupdating the `Node`'s live range list. This is preparation work for\nadding a new live-ish range type for selections (which will have a few\ndifferent requirements than a real DOM live range).\n\nImprovements to spec compliance of `Node#normalize()`:\n - Instead of issuing one mutation record per merged node only issue a\n   single one.\n - The change to the preserved node's data happens before the merged\n   nodes' removal.\n - Indices for live range updates would be stale when merging more\n   than two nodes.\n\nNotes on performance:\n - This switches to accessing a rooted `SmallVec` of live ranges\n   per-node. In cases where a node has 4 or fewer live ranges, this will\n   not allocate, otherwise this adds a new vector allocation for an\n   edge case.\n - The amount of rooting should be unchanged as the old code had to\n   root all accessed `Range`'s anyway.\n - In some cases we avoid calculating node indices where they were\n   before using `LazyCell`.\n\nSigned-off-by: Martin Robinson \u003cmrobinson@igalia.com\u003e\n\n--\n\nwpt-commits: 797589c8452b14ba448ba77819427ff3d743e37f\nwpt-pr: 62112\n", "files": ["testing/web-platform/tests/dom/ranges/Range-mutations-normalize.html"], "git_node": "734b7fc6be3dd4adcf41b48319ae72f877bfdd27", "git_parents": ["39b5a45896e6ed67544d110a99b91f1345083896"], "node": "5e5720d4dca36e4fed155d46fad0bab334947574", "parents": ["46e6cd80076a0b8763f3594d6fc9fbb0cd8517e6"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2066789 [wpt PR 62213] - Test noopener with special targets without a javascript: URL, a=testonly\n\nAutomatic update from web-platform-tests\nTest noopener with special targets without a javascript: URL\n\nThe special target variants of window-open-noopener.html opened a popup\nwith a javascript: URL and assigned the callback the URL invokes only\nafter window.open() returned. That relies on the javascript: URL being\nevaluated in a queued task, which is covered elsewhere, and it made all\nthree variants time out in WebKit rather than report anything about\nnoopener.\n\nMake the call from a same-origin srcdoc iframe instead. This also lets\n_self name a different window than _parent and _top do, which the popup\ndid not.\n\nAdditionally add a test that window.open() with noopener targeting an\nexisting named iframe does not set that iframe's opener, as required by\nstep 17.2 of the window open steps. The name lookup in \"the rules for\nchoosing a navigable\" ignores noopener, so this case is reachable, but\nnothing covered it.\n\nHTML PR: https://github.com/whatwg/html/pull/12845\n--\n\nwpt-commits: 3ba06522cce6462b7042de96a4dd0bcb67d02616\nwpt-pr: 62213\n", "files": ["testing/web-platform/tests/html/browsers/the-window-object/window-open-noopener-existing-iframe.html", "testing/web-platform/tests/html/browsers/the-window-object/window-open-noopener.html"], "git_node": "6b0b3d784a41b6fc0a4600f1ff8296b961878b69", "git_parents": ["734b7fc6be3dd4adcf41b48319ae72f877bfdd27"], "node": "f92cb018aac772b9b11a0131f61076890fb67af9", "parents": ["5e5720d4dca36e4fed155d46fad0bab334947574"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066789 [wpt PR 62213] - Update wpt metadata, a=testonly\n\nwpt-pr: 62213\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/browsers/the-window-object/window-aliases.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-indexed-access-vs-named-access.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-open-noopener-existing-iframe.html.ini"], "git_node": "a754c9f416f7d0bb913d8cb543c025f559d6999e", "git_parents": ["6b0b3d784a41b6fc0a4600f1ff8296b961878b69"], "node": "8407138119ae85905cfae7b9f3d5e846e16f5e1e", "parents": ["f92cb018aac772b9b11a0131f61076890fb67af9"], "tags": []}, {"author": "Michael Reeves \u003cmichael.reeves077@gmail.com\u003e", "branch": "default", "desc": "Bug 2065868 [wpt PR 62157] - Match cross-origin Range requests to the test scheme, a=testonly\n\nAutomatic update from web-platform-tests\nMatch cross-origin Range requests to the test scheme\n\nThe service worker variant runs in a secure context, so using an HTTP remote origin makes the safe Range request fail as mixed content before the behavior under test is reached. Use the scheme-matching remote origin for both cross-origin cases.\n\n--\n\nwpt-commits: f365a86bb959d5049d4a70f6312766ddd8a8d502\nwpt-pr: 62157\n", "files": ["testing/web-platform/tests/fetch/range/general.any.js"], "git_node": "274b14da11756c319b3613fac301ff1a05960ee3", "git_parents": ["a754c9f416f7d0bb913d8cb543c025f559d6999e"], "node": "42e77aa1bae480cdf03203f1cf3f8179927cacc8", "parents": ["8407138119ae85905cfae7b9f3d5e846e16f5e1e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065868 [wpt PR 62157] - Update wpt metadata, a=testonly\n\nwpt-pr: 62157\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/fetch/range/general.any.js.ini"], "git_node": "ca9db6cd4ef828d5dc40e114995f265f5c2406eb", "git_parents": ["274b14da11756c319b3613fac301ff1a05960ee3"], "node": "854e31461827e257db09a01f25691012177fe0b9", "parents": ["42e77aa1bae480cdf03203f1cf3f8179927cacc8"], "tags": []}, {"author": "Robert Flack \u003cflackr@chromium.org\u003e", "branch": "default", "desc": "Bug 2066454 [wpt PR 62187] - Retarget snap targets on snap events, a=testonly\n\nAutomatic update from web-platform-tests\nRetarget snap targets on snap events\n\nThe snap targets should be retargeted to the current tree scope as needed.\n\nBug: 547764771\nChange-Id: I37430f1d3455f1a6a4fd5ce5ad795095038bda9d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8284569\nCommit-Queue: Robert Flack \u003cflackr@chromium.org\u003e\nReviewed-by: David A \u003cawogbemila@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1686315}\n\n--\n\nwpt-commits: fc2dc0c1117229d710325bbc397e10fc66c33197\nwpt-pr: 62187\n", "files": ["testing/web-platform/tests/css/css-scroll-snap/snap-events/snap-events-with-shadow-dom.html"], "git_node": "d50532b888645742410096b9f803c957103038d3", "git_parents": ["ca9db6cd4ef828d5dc40e114995f265f5c2406eb"], "node": "7eaa9d96b619a3c7cf07d20107b68739f94dbdff", "parents": ["854e31461827e257db09a01f25691012177fe0b9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066454 [wpt PR 62187] - Update wpt metadata, a=testonly\n\nwpt-pr: 62187\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-scroll-snap/snap-events/snap-events-with-shadow-dom.html.ini"], "git_node": "233d30314feffa1926dab63c1efc95ef0e0b523f", "git_parents": ["d50532b888645742410096b9f803c957103038d3"], "node": "4b06c0850d7b36e39dde12a0b11943e94615e4b2", "parents": ["7eaa9d96b619a3c7cf07d20107b68739f94dbdff"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2066850 [wpt PR 62217] - Add parser tests for foster parenting into a template, a=testonly\n\nAutomatic update from web-platform-tests\nAdd parser tests for foster parenting into a template\n\nThree foster parenting paths that had no coverage:\n\n* Out of a tr inside a \u003ctemplate for\u003e, where the template is the last\n  template on the stack of open elements and there is no table at all. The\n  content has to go to the template's insertion target: a \u003ctemplate for\u003e\n  element is never inserted into the DOM, so resolving to its template\n  contents loses the content. Passes in Chrome Canary.\n\n* The same shape for a plain \u003ctemplate\u003e nested in a \u003ctable\u003e, so that the\n  last table is non-null, next to the existing template.dat case that has\n  no table.\n\n* When script has made a template element the parent of the last table,\n  which has to redirect into that template's contents. Passes in Safari;\n  Chrome and Firefox drop the element instead.\n\n--\n\nwpt-commits: 1d218fc523442f84924d13163ac97c35a8ce7529\nwpt-pr: 62217\n", "files": ["testing/web-platform/tests/html/semantics/scripting-1/the-template-element/template-for/template-for-foster-parenting.html", "testing/web-platform/tests/html/syntax/parsing/foster-parenting-into-template-element.html", "testing/web-platform/tests/html/syntax/parsing/resources/template.dat"], "git_node": "555b4833f6e85fc388d0179cea79af1b40c950ef", "git_parents": ["233d30314feffa1926dab63c1efc95ef0e0b523f"], "node": "57a8c2cc2004eaab6670f59dfd64e92d4104472c", "parents": ["4b06c0850d7b36e39dde12a0b11943e94615e4b2"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066850 [wpt PR 62217] - Update wpt metadata, a=testonly\n\nwpt-pr: 62217\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/scripting-1/the-template-element/template-for/template-for-foster-parenting.html.ini", "testing/web-platform/meta/html/syntax/parsing/foster-parenting-into-template-element.html.ini"], "git_node": "1c5a204f766883d4b343689b6df7ae743630d16c", "git_parents": ["555b4833f6e85fc388d0179cea79af1b40c950ef"], "node": "34a9939e3752b502f941db0e91f92500203df088", "parents": ["57a8c2cc2004eaab6670f59dfd64e92d4104472c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066907 - [wpt-sync] Update web-platform-tests to 1d218fc523442f84924d13163ac97c35a8ce7529, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: 1d218fc523442f84924d13163ac97c35a8ce7529\nwpt-type: landing\n", "files": ["testing/web-platform/meta/clipboard-apis/clipboard-copy-selection-line-break.https.html.ini", "testing/web-platform/meta/cookiestore/cookieStore_get_arguments.https.any.js.ini", "testing/web-platform/meta/cookiestore/cookieStore_set_arguments.https.any.js.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/alignment/column-fill-reverse-stacking-alignment-indefinite-size-001.html.ini", "testing/web-platform/meta/css/css-layout-api/auto-block-size/floats.https.html.ini", "testing/web-platform/meta/css/css-overflow/scroll-markers/scroll-marker-in-display-none-column-crash.html.ini", "testing/web-platform/meta/css/css-typed-om/rotate-by-added-angle.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/BarProp.window.js.ini", "testing/web-platform/meta/html/browsers/the-window-object/open-close/no_window_open_when_term_nesting_level_nonzero.window.js.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-aliases.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-indexed-access-vs-named-access.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-indexed-properties.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/child-overflow.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/inline-fixed-containment.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/inline-fragments-drawable.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/inline-size-change.tentative.html.ini", "testing/web-platform/meta/html/semantics/interactive-elements/the-summary-element/interactive-content.html.ini", "testing/web-platform/meta/html/syntax/parsing/custom-element-reparenting-shadow-cycle.html.ini", "testing/web-platform/meta/html/user-activation/navigate-to-sameorigin.html.ini", "testing/web-platform/meta/mediacapture-record/passthrough/MediaRecorder-passthrough.https.html.ini", "testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini", "testing/web-platform/meta/mediacapture-streams/parallel-capture-requests.https.html.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/picture-in-picture/picture-in-picture-element.html.ini", "testing/web-platform/meta/pointerevents/pointerlock/pointerevent_coordinates_when_locked.html.ini", "testing/web-platform/meta/preload/__dir__.ini", "testing/web-platform/meta/storage-access-api/requestStorageAccess-same-site-iframe.sub.https.window.js.ini", "testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini", "testing/web-platform/meta/svg/animations/scripted/animatetransform-type-missing-value-default.html.ini", "testing/web-platform/meta/video-rvfc/request-video-frame-callback-webrtc.https.html.ini", "testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini", "testing/web-platform/meta/webauthn/conditional-mediation.https.html.ini", "testing/web-platform/meta/webdriver/tests/bidi/browser/create_user_context/create_user_context.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browser/create_user_context/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browser/set_client_window_state/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/context_destroyed/context_destroyed.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/context_destroyed/original_opener.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/download_end/download_end.py.ini", "testing/web-platform/meta/webdriver/tests/classic/new_session/create_alwaysMatch.py.ini", "testing/web-platform/meta/webrtc/RTCDataChannel-close.html.ini"], "git_node": "860601ec223447d5c706579bba151035600b1be2", "git_parents": ["1c5a204f766883d4b343689b6df7ae743630d16c"], "node": "5550327c1f5f2682c00962254639f66fe8c04638", "parents": ["34a9939e3752b502f941db0e91f92500203df088"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063030 - Add spec-trace skill. r=padenot,ai4dev-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318185\n", "files": [".agents/skills/spec-trace/SKILL.md", ".agents/skills/webspec-index/SKILL.md", ".claude/skills/spec-trace/SKILL.md", ".claude/skills/webspec-index/SKILL.md"], "git_node": "b96fde9db2bfa052219267e01f0b70e15dc60c53", "git_parents": ["860601ec223447d5c706579bba151035600b1be2"], "node": "df5273f4001b3b7104f035af8899dac4da27bf3c", "parents": ["5550327c1f5f2682c00962254639f66fe8c04638"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060524 - [experiment] Part 1: Add a Nimbus feature flag and secret setting to control feature enablement. r=android-reviewers,sfamisa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317462\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "d0dfcd7a6117428f6c920da82ee20b08209ede04", "git_parents": ["b96fde9db2bfa052219267e01f0b70e15dc60c53"], "node": "9b047fc088db1f53a3c90b588230b81d900d64c0", "parents": ["df5273f4001b3b7104f035af8899dac4da27bf3c"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060524 - [experiment] Part 2: Add the notification channel and logic to build and show the weekly privacy report notification, deep-linking to the protections dashboard. r=android-reviewers,sfamisa,android-l10n-reviewers,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317463\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/AndroidManifest.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/intent/HomeDeepLinkIntentProcessor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationHelper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationReceiver.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/HomeDeepLinkIntentProcessorTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationHelperTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationReceiverTest.kt"], "git_node": "8cb217538896b0e39f6fa00fe4c335ce1ae09e88", "git_parents": ["d0dfcd7a6117428f6c920da82ee20b08209ede04"], "node": "866944f2ce9d3ad121fd841e03fc5122fc73b408", "parents": ["9b047fc088db1f53a3c90b588230b81d900d64c0"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060524 - [experiment] Part 3: Add the PrivacyReportNotificationWorker and schedule it weekly. r=android-reviewers,sfamisa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317464\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorker.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportWorkerFactory.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/HomeActivityTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorkerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportWorkerFactoryTest.kt"], "git_node": "07c4c6c4b470d3544d13138f970d5b702ef1a787", "git_parents": ["8cb217538896b0e39f6fa00fe4c335ce1ae09e88"], "node": "cd443cdc7bb455808b8cf362833c7bb0d7175c8c", "parents": ["866944f2ce9d3ad121fd841e03fc5122fc73b408"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060524 - [experiment] Part 4: Added a secret setting to force the number of trackers to meet the threshold for showing the privacy report notification. r=android-reviewers,sfamisa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318518\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorker.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "729b8efc64aae46b39aef1a2691fc334ede700f3", "git_parents": ["07c4c6c4b470d3544d13138f970d5b702ef1a787"], "node": "4a218d463ced03f551451c9996191509cfc9e231", "parents": ["cd443cdc7bb455808b8cf362833c7bb0d7175c8c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2066413 - Stop building NSPR's prtpool.c and prpolevt.c when libs are folded. r=glandium,firefox-build-system-reviewers\n\nWith ssltunnel ported off PR_CreateThreadPool, prtpool.c (1224 lines) has no\nconsumer in Firefox or in NSS. prpolevt.c (234 lines) implements the pollable\nevent API, whose only caller was prtpool.c, so it goes with it.\n\nVerified by symbol cross-reference over both trees: no remaining reference to\nPR_CreateThreadPool, PR_QueueJob, PR_JoinThreadPool, PR_ShutdownThreadPool,\nPR_CancelJob, PR_JoinJob, the PR_QueueJob_* family, or any of the\nPR_*PollableEvent functions.\n\nThey are only dropped when MOZ_FOLD_LIBS is set. Where libs aren't folded\n(Linux), libnspr4.so is a real shared library and system libraries we load\ndirectly or indirectly may resolve these symbols against it, which is the same\nreason we don't fold NSPR and NSS there.\n\nBoth files remain in nsprpub for now so this stays a build-only change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321214\n", "files": ["config/external/nspr/pr/moz.build"], "git_node": "1355eaa731352bc5b8f85418ae694a18d7782c22", "git_parents": ["729b8efc64aae46b39aef1a2691fc334ede700f3"], "node": "5d59693fc119b636085944ec632124085b118da5", "parents": ["4a218d463ced03f551451c9996191509cfc9e231"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2066413 - Stop building NSPR's prdump.c on Windows. r=glandium,firefox-build-system-reviewers\n\nprdump.c only appears in the WINNT branch of the source list, and none of its\nexports have a consumer: PR_SetThreadDumpProc has no caller in Firefox or NSS,\nand PR_ShowStatus and _PR_DumpThreads are referenced only by the file itself\nplus a declaration in pprthred.h. On pthreads platforms PR_SetThreadDumpProc\ncomes from ptthread.c instead, so this only changes what Windows builds.\n\nUpstream NSPR is removing this file (bug 2066419), so dropping it here first\nkeeps the vendored update from busting the Windows build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321248\n", "files": ["config/external/nspr/pr/moz.build"], "git_node": "e546700542be32ab80f26287b7fc9f2ca8a01026", "git_parents": ["1355eaa731352bc5b8f85418ae694a18d7782c22"], "node": "e41dbbd44a7444289a2217cbbad9ef5e19b85ced", "parents": ["5d59693fc119b636085944ec632124085b118da5"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2066413 - Remove NSPR docs for the thread pool and pollable event APIs. r=leggert\n\nFirefox no longer builds prtpool.c or prpolevt.c, and upstream NSPR is removing\nboth, so these twenty reference pages document functions that no longer exist.\n\nDeletes the PRThreadPool, PRJob, PRJobFn and PRJobIoDesc type pages, the\nPR_CreateThreadPool / PR_QueueJob* / PR_CancelJob / PR_JoinJob /\nPR_ShutdownThreadPool / PR_JoinThreadPool function pages, the four\nPR_*PollableEvent pages, and the Thread Pools overview. Also drops the Thread\nPools section and the Pollable Events entry from reference/index.md, and the\nPollable Events section from reference/i_o_functions.md.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321252\n", "files": ["docs/nspr/reference/i_o_functions.md", "docs/nspr/reference/index.md", "docs/nspr/reference/pr_canceljob.md", "docs/nspr/reference/pr_createthreadpool.md", "docs/nspr/reference/pr_destroypollableevent.md", "docs/nspr/reference/pr_joinjob.md", "docs/nspr/reference/pr_jointhreadpool.md", "docs/nspr/reference/pr_newpollableevent.md", "docs/nspr/reference/pr_queuejob.md", "docs/nspr/reference/pr_queuejob_connect.md", "docs/nspr/reference/pr_queuejob_read.md", "docs/nspr/reference/pr_queuejob_timer.md", "docs/nspr/reference/pr_queuejob_write.md", "docs/nspr/reference/pr_queuejobaccept.md", "docs/nspr/reference/pr_setpollableevent.md", "docs/nspr/reference/pr_shutdownthreadpool.md", "docs/nspr/reference/pr_waitforpollableevent.md", "docs/nspr/reference/prjob.md", "docs/nspr/reference/prjobfn.md", "docs/nspr/reference/prjobiodesc.md", "docs/nspr/reference/prthreadpool.md", "docs/nspr/reference/thread_pools.md"], "git_node": "a080b0c92f8596b7acd3f8914a8e5fce4ca77f25", "git_parents": ["e546700542be32ab80f26287b7fc9f2ca8a01026"], "node": "e136834620e1fb2f9cbc1379d26aaa7c3d7852f5", "parents": ["e41dbbd44a7444289a2217cbbad9ef5e19b85ced"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066756 - Set \"layout.css.outline-offset.snapping\" preference to the Nightly value for css/css-ui/animation/outline-offset-interpolation-rounding.tentative.html. r=dholbert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321531\n", "files": ["testing/web-platform/meta/css/css-ui/animation/outline-offset-interpolation-rounding.tentative.html.ini"], "git_node": "ce7b194b4f40bd48a7144d964dc0ba6f5fa1807d", "git_parents": ["a080b0c92f8596b7acd3f8914a8e5fce4ca77f25"], "node": "aca68d7561cdcd709029d65dfb3256d5eaccd2b3", "parents": ["e136834620e1fb2f9cbc1379d26aaa7c3d7852f5"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2018678 p1. Add WPTs for view timelines with relatively and absolutely positioned subjects. r=layout-scroll-driven-animation-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317567\n", "files": ["testing/web-platform/tests/scroll-animations/view-timelines/view-timeline-abspos-containing-block-outside-scroller.tentative.html", "testing/web-platform/tests/scroll-animations/view-timelines/view-timeline-abspos-outside-scroll-range.html", "testing/web-platform/tests/scroll-animations/view-timelines/view-timeline-abspos-subject.html", "testing/web-platform/tests/scroll-animations/view-timelines/view-timeline-relative-ancestor.html", "testing/web-platform/tests/scroll-animations/view-timelines/view-timeline-relative-subject.html"], "git_node": "eea9eb1bf9f29f8e715d30130016cba61a11f459", "git_parents": ["ce7b194b4f40bd48a7144d964dc0ba6f5fa1807d"], "node": "9d128b2e0a524e958e8e9f4dbc4c55f945bab7c3", "parents": ["aca68d7561cdcd709029d65dfb3256d5eaccd2b3"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2018678 p2. Expose per-axis sticky scroll ranges from StickyScrollContainer. r=layout-scroll-driven-animation-reviewers,layout-reviewers,dholbert,boris\n\nThis adds a read-only GetForFrame() accessor and a GetStickyScrollRangesForAxis() method that re-expresses the stick and containment rectangles of ComputeStickyLimits() as, for each physical side of the given axis, the scroll offset at which sticking to that side begins or ends and the maximum displacement it can produce. ComputeStickyLimits() gains a StickyLimitSpace parameter so that these thresholds can be computed independently of the current scroll position. This information is needed to model how sticky positioning displaces a view timeline subject as a function of the scroll offset.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317568\n", "files": ["layout/generic/StickyScrollContainer.cpp", "layout/generic/StickyScrollContainer.h"], "git_node": "70b23b4a9fd39cbe2161350911b4ff59a235b7d3", "git_parents": ["eea9eb1bf9f29f8e715d30130016cba61a11f459"], "node": "e788db78a4b80a92f4598b91864cfc2fde3bbade", "parents": ["9d128b2e0a524e958e8e9f4dbc4c55f945bab7c3"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2018678 p3. Make ViewTimeline ranges account for sticky positioning. r=layout-scroll-driven-animation-reviewers,boris\n\nSticky positioning displaces a view timeline subject by a piecewise-linear function d(s) of the scroll offset s, which StickyDisplacement models using the per-axis sticky scroll ranges added in p2. UpdateCachedCurrentTime() now removes the current displacement from the cached subject position so that it is scroll-invariant, and caches the displacement model alongside it. Timeline range boundaries are then computed by solving s - d(s) == offset for the earliest or latest scroll offset, as appropriate for each boundary, matching the earliest/latest wording in the spec. If more than one sticky ancestor affects the subject we fall back to treating the current displacement as permanent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317569\n", "files": ["dom/animation/ViewTimeline.cpp", "dom/animation/ViewTimeline.h", "testing/web-platform/meta/scroll-animations/view-timelines/sticky/view-timeline-sticky-offscreen-1.html.ini", "testing/web-platform/meta/scroll-animations/view-timelines/sticky/view-timeline-sticky-offscreen-2.html.ini", "testing/web-platform/meta/scroll-animations/view-timelines/sticky/view-timeline-sticky-offscreen-3.html.ini", "testing/web-platform/meta/scroll-animations/view-timelines/sticky/view-timeline-sticky-offscreen-6.html.ini", "testing/web-platform/meta/scroll-animations/view-timelines/sticky/view-timeline-sticky-offscreen-7.html.ini", "testing/web-platform/meta/scroll-animations/view-timelines/view-timeline-sticky-block.html.ini", "testing/web-platform/meta/scroll-animations/view-timelines/view-timeline-sticky-inline.html.ini", "testing/web-platform/meta/scroll-animations/view-timelines/view-timeline-sticky-subpixel-adjustment.html.ini"], "git_node": "a07f52555b5af073803e248c19fa2e0af0c268d7", "git_parents": ["70b23b4a9fd39cbe2161350911b4ff59a235b7d3"], "node": "48dea2c913bc0f05f9a3f4f46c4881a3c8ff5d53", "parents": ["e788db78a4b80a92f4598b91864cfc2fde3bbade"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2018678 p4. Add WPTs for view timelines with sticky-positioned subjects. r=layout-scroll-driven-animation-reviewers,boris\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317570\n", "files": ["testing/web-platform/tests/scroll-animations/view-timelines/sticky/view-timeline-sticky-containing-block-clamp.html", "testing/web-platform/tests/scroll-animations/view-timelines/sticky/view-timeline-sticky-orthogonal-axis-only.html", "testing/web-platform/tests/scroll-animations/view-timelines/sticky/view-timeline-sticky-zero-size-subject.tentative.html"], "git_node": "bc89c246572fa0e38a6a98cec35ffaad7515718a", "git_parents": ["a07f52555b5af073803e248c19fa2e0af0c268d7"], "node": "24d6ac4eb8aef224f6e06ea6721119e659e1d65f", "parents": ["48dea2c913bc0f05f9a3f4f46c4881a3c8ff5d53"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065403 - Setup automatic formating of build/clang-plugin r=ahochheiden\n\nFol