\n", "files": ["toolkit/components/aboutprocesses/tests/browser/head.js"], "git_node": "1ef836b8e22cdb399fdb8dea29885e56294b91d3", "git_parents": ["d2597a8bd58369649f6416694f50e9f92070e288"], "node": "e044fd91cebb4ea1a2684921cf2cdbba03e97968", "parents": ["941e075cbb6279af169248af0c38011a3307d651"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064369 - Move moz-urlbar off moz-input-box onto the new API. r=desktop-theme-reviewers,hjones,daleharvey\n\nThe address bar and search bar are both moz-urlbar, so they share one menu now. Each item set is scoped to its own input and hidden for the other, and AddSearchEngineHelper tracks the items it created rather than everything after its separator, which is no longer only its own.\n\nWith the wrapper an HTML element, the input's tooltip is the document's default tooltip instead of #aHTMLTooltip, because FindTooltip sends every non-XUL target there. The text still comes from the title attribute, and browser_tooltip.js checks the tooltip that opens.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319498\n", "files": ["accessible/tests/browser/events/browser_test_focus_searchbar.js", "accessible/tests/browser/events/browser_test_focus_urlbar.js", "accessible/tests/browser/tree/browser_searchbar_new.js", "browser/base/content/test/contextMenu/browser_contextmenu_touch.js", "browser/base/content/test/performance/browser_appmenu.js", "browser/base/content/test/performance/browser_tabopen.js", "browser/base/content/test/performance/browser_tabopen_squeeze.js", "browser/base/content/test/performance/browser_tabstrip_overflow_underflow.js", "browser/components/qrcode/test/browser/browser_qrcode_share_menu.js", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser_tooltip.js", "browser/components/urlbar/tests/browser-autofill/browser_inputField_contextmenu_dismissal.js", "browser/components/urlbar/tests/browser-autofill/browser_inputField_contextmenu_dismissal_telemetry.js", "browser/components/urlbar/tests/browser-editing/browser_urlbar_selection.js", "browser/components/urlbar/tests/browser-engagementTelemetry/head.js", "browser/components/urlbar/tests/browser-search/browser_add_search_engine.js", "browser/components/urlbar/tests/browser-tips/browser_searchTips_interaction.js", "browser/components/urlbar/tests/browser/browser_strip_on_share.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_addEngine.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_context.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_mouseNavigation.js", "browser/themes/shared/urlbar.css", "dom/security/test/https-first/browser_schemeless.js"], "git_node": "1f8fb7a92e930bbf65e7b5c2e671d555fe177df8", "git_parents": ["1ef836b8e22cdb399fdb8dea29885e56294b91d3"], "node": "3c234d9ee29497aee4e699749e72536e3364c050", "parents": ["e044fd91cebb4ea1a2684921cf2cdbba03e97968"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064369 - Stop enabling XUL in the input's markup parser. r=mbeier\n\nThe markup has no XUL element left, so the parser needs no XUL support.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319899\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "fa5ccc55a7668a37cd3c4e3d91759a6c9f5fb3a3", "git_parents": ["1f8fb7a92e930bbf65e7b5c2e671d555fe177df8"], "node": "2d7fa70e392f6a986fd0f935099e9f8b8a13f43b", "parents": ["3c234d9ee29497aee4e699749e72536e3364c050"], "tags": []}, {"author": "Gopalarathnam Venkatesan \u003cgopal@g13n.net\u003e", "branch": "default", "desc": "Bug 2042426 - fixed clippy warnings in dom/base/fragmentdirectives/lib.rs r=sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319839\n", "fil