/tests/tools/ietf-ml-dsa-44-key.p12", "security/nss/tests/tools/ietf-ml-dsa-65-both.p12", "security/nss/tests/tools/ietf-ml-dsa-65-key.p12", "security/nss/tests/tools/ietf-ml-dsa-87-both.p12", "security/nss/tests/tools/ietf-ml-dsa-87-key.p12", "security/nss/tests/tools/openssl-ml-dsa-44.p12", "security/nss/tests/tools/openssl-ml-dsa-65.p12", "security/nss/tests/tools/openssl-ml-dsa-87.p12", "security/nss/tests/tools/tools.sh"], "git_node": "c8f2ab3b6e88ce13ffc4e7326a67f62b9d6a2d69", "git_parents": ["3fa26cea51ff17a3474a4cc251ec1862de69e266"], "node": "7b3b1724c456110c5e8641b6f3161ec36ef78caf", "parents": ["dea46e224fb376041eb2e1cb45c2488a6e07f991"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059445 - Add an action to run BHR aggregation for a given date and sample size r=dthayer\n\nThe kind hardcodes BHR_AGGREGATE_DATE_OFFSET_DAYS 4 and\nBHR_AGGREGATE_SAMPLE_SIZE 0.5, so every run processes four-days-ago at\nproduction sampling. The script already accepts --date / BHR_AGGREGATE_DATE\nand prefers it over the offset, but nothing sets it: cron input is only\nplumbed for trigger-action jobs, not decision-task ones, so there is no way\nto ask CI for a particular build date. That blocks backfilling a historical\nday, and makes re-running a failed day awkward -- a plain retrigger resolves\nthe offset against the time it runs, so it aggregates a different day.\n\nAdd a taskgraph action that creates bhr-aggregate-cron with those two values\noverridden. Both inputs are optional and an empty one leaves the cron's\nbehaviour alone, so the action is also just a way to run today's job on\ndemand. The triggered task takes a -custom treeherder symbol to keep it\napart from the daily run.\n\nThe action declares permission=\"bhr-aggregate\" rather than the default\n\"generic\". The task it creates holds secrets:get on the production BigQuery\ncredential, and Taskcluster requires the action task to hold a scope in order\nto grant it, so this needs a role and hook in fxci-config as the cron did in\nbug 2056977. Keeping it off action:generic means that grant covers this one\naction instead of every generic action on the tree. available= restricts it\nto mozilla-central for the same reason: the credential is scoped to the\nlevel-3 cron and must not be reachable from anywhere else.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320159\n", "files": ["taskcluster/gecko_taskgraph/actions/bhr_aggregate.py", "taskcluster/gecko_taskgraph/test/test_actions.py"], "git_node": "9587166b7e77a66e874bbc9634966894ac6f5c6f", "git_parents": ["c8f2ab3b6e88ce13ffc4e7326a67f62b9d6a2d69"], "node": "be97fd0f241f7fca984acc94de928eced9e5e40a", "parents": ["7b3b1724c456110c5e8641b6f3161ec36ef78caf"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2048365 - MOZ_DIAGNOSTIC_ASSERT when calling the NimbusFeature API with an unsupported feature r=nimbus-reviewers,chumphreys\n\nPreviously it was possible to use the Nimbus C++ API with features that\nwere not marked with `isEarlyStartup: true`. This would result in always\nreturning the default value, even when enrolled in an experiment. Now we\nwill throw a `MOZ_DIAGNOSTIC_ASSERT`, which will cause a crash in\nNightly, which should hopefully result in these cases being caught\nbefore making it to release.\n\nLikewise, it also now an error to call `RecordExposureEvent` for a\nfeature that is marked `hasExposure: false`, via the same mechanism as\nabove.\n\nWhile I was here I cleaned a few things up:\n\n* `NimbusFeatureManifest.inc.h` does not need to exist -- these functions\n  are only used inside `NimbusFeatures.cpp`;\n* the private static methods of the NimbusFeatures class can be static\n  functions inside `NimbusFeatures.cpp` -- it maintains essentially the\n  same isolation boundary and removes implementation details from the\n  public API;\n* likewise, the static constants inside `NimbusFeatures` were moved into\n  `NimbusFeatures.cpp` for the same reason.\n* `GetPrefName()` was renamed to `GetNimbusPrefName()` to be more\n  specific and prevent potential future naming conflicts with unified\n  builds;\n* the generated members have been moved to the `mozilla::nimbus`\n  namespace as to not pollute the global `mozilla` namespace;\n* generated code has been updated to use constinit `std::array`;\n* code generation has been cleaned up, producing human-readable\n  artifacts;\n* code generation has been refactored to use list comprehensions to make\n  the code more idiomatic; and\n* variable names are now more idiomatic (`snake_case` vs mixed\n  `snake_case` and `camelCase`).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307417\n", "files": ["toolkit/components/nimbus/FeatureManifest.yaml", "toolkit/components/nimbus/generate/generate_feature_manifest.py", "toolkit/components/nimbus/lib/NimbusFeatureManifest.inc.h", "toolkit/components/nimbus/lib/NimbusFeatures.cpp", "toolkit/components/nimbus/lib/NimbusFeatures.h", "toolkit/components/nimbus/test/gtest/NimbusFeatures_GetTest.cpp", "toolkit/components/nimbus/test/gtest/NimbusFeatures_RecordExposure.cpp"], "git_node": "52bfbfecf7f7f52481a56f22b428f7e681606dcb", "git_parents": ["9587166b7e77a66e874bbc9634966894ac6f5c6f"], "node": "a0b54074afd8ee3d5bcbf93a22de28650348accb", "parents": ["be97fd0f241f7fca984acc94de928eced9e5e40a"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060442 - Options in feature callout dropdown menu are center-aligned instead of left-aligned - r=omc-reviewers,emcminn\n\nTest experiment with feature callout messages with a submenu dropdown: https://experimenter.services.mozilla.com/nimbus/test-only-built-in-vpn-messaging-evergreen-copy/summary/ (clone of rollout with the CFRs noted in the original bug)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320926\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "dcfeb2713038708c5d85fa41fa13ce37d8bea9c5", "git_parents": ["52bfbfecf7f7f52481a56f22b428f7e681606dcb"], "node": "f9452633294a3a51fca48fbd87fd9a4e5b6c60d5", "parents": ["a0b54074afd8ee3d5bcbf93a22de28650348accb"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062613 - Show that sync is in progress or complete when animations are disabled with \"Syncing...\" label r=skhamis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321056\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser_sync.js"], "git_node": "6021ea76bd121aac95405a9bb1995fc17141bbd9", "git_parents": ["dcfeb2713038708c5d85fa41fa13ce37d8bea9c5"], "node": "02ffafda759dde0a3abe2432eb698f87de702b5e", "parents": ["f9452633294a3a51fca48fbd87fd9a4e5b6c60d5"], "tags": []}, {"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "No bug - Update Pocket Guide to change the Nightly QA sign-off day DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321351\n", "files": ["docs/contributing/pocket-guide-shipping-firefox.md"], "git_node": "961b2cf75d0edda1cf1af9e3a02252d1056a8bd0", "git_parents": ["6021ea76bd121aac95405a9bb1995fc17141bbd9"], "node": "d656f3d4bf465798bc37706c61438cf5265d1332", "parents": ["02ffafda759dde0a3abe2432eb698f87de702b5e"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066200 - fix messaging when upstream commit sha is not found in detect_upstream_revert.sh r=dbaker DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321012\n", "files": ["dom/media/webrtc/third_party_build/detect_upstream_revert.sh"], "git_node": "747ab3821c816e8b9f6460f2a3054c8488581988", "git_parents": ["961b2cf75d0edda1cf1af9e3a02252d1056a8bd0"], "node": "08be92c62a2d1edccae116ccff04c660e0095042", "parents": ["d656f3d4bf465798bc37706c61438cf5265d1332"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065227 - Point leafGroups members at the stackTable instead of respelling their stacks r=dthayer\n\nleafGroups is 90.1 MB of the 193.5 MB daily artifact (run\nF0GQFuPfQQqar17PBMJLAA, build 20260816). Almost all of it is the member list:\neach of the 158,558 members carries its whole stack as funcTable indices,\n9.67M of them at an average depth of 61, for 45.3 MB, plus 14.9 MB of\nfirstUniqueFrame name/lib pairs and ~9.6 MB of JSON key names repeated once\nper member.\n\nNone of that stack data is new. The thread's stackTable already holds every\none of those stacks, prefix-linked and interned, and signatures_from_thread\nwalks samples so it has the node to hand. Bug 2059444 shrank a member from key\nstrings to indices, but kept the shape of spelling the stack out per member;\nthis drops the shape.\n\nA member is now the stackTable node it came from. Walking that node's prefix\nchain yields the same funcTable indices, and so the same canonical key, that\nthe frontend derives for every other signature, so the join is unchanged.\nVerified against the artifact above: 15,720 groups and 158,558 members\nrecomputed, every member's canonical key byte-identical to the frameKeys it\nreplaced.\n\nAlso:\n\n- firstUniqueFrame becomes firstUniqueFunc, a funcTable index rather than a\n  name/lib pair. It cannot be derived downstream -- choosing it needs the\n  noise-prefix list this module owns -- but it can be pointed at. Verified to\n  resolve to the identical frame for all 158,558 members.\n- commonTrunk is dropped. It is the only group field the dashboard never\n  reads, and branchFrame already carries its last element, which is what\n  displayName is built from.\n- members become parallel arrays, so the five key names are written once per\n  group rather than once per member.\n\nleafGroups goes from 90.1 MB to 12.4 MB on that artifact, 86% smaller, with\nthe same group and member counts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320486\n", "files": ["toolkit/components/backgroundhangmonitor/aggregation/leaf_grouping.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_leaf_grouping.py"], "git_node": "ccef86e93dbbb50b1c57b324efbae8c55aec1d02", "git_parents": ["747ab3821c816e8b9f6460f2a3054c8488581988"], "node": "92aaf33da1dcf781ce37db9fd7da2e21718b35b9", "parents": ["08be92c62a2d1edccae116ccff04c660e0095042"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065227 - Derive inlineRatio instead of storing it per stack node r=dthayer\n\ninlineRatio is a column parallel to prefix/func, so it costs 10.0 MB of the\n193.5 MB artifact for 3,017,443 entries. Almost none of them carry\ninformation: a node is either always inlined or never inlined, which\ninlineDepth already tells you. On build 20260816 exactly 737 nodes, 0.02%,\nhave a ratio that is neither 1 nor 0 -- or that disagrees with their depth,\nwhich 4 of them do.\n\nSo store the exceptions and let readers derive the rest: the ratio is 1 where\ninlineDepth is above zero and 0 where it is not, unless the node appears in\ninlineRatioExceptions. That is 8.6 KB in place of 10.0 MB.\n\nVerified lossless against that artifact: encoding and then deriving reproduces\nall 3,017,443 original values exactly.\n\nOmitting the entries outright was the obvious first idea and does not work --\nthe column is positional, so a gap would misalign every later index, and null\ncosts more characters than the value it replaces. Nothing consumes the column\nyet, which is what makes now the moment to pick the compact shape rather than\nafter a reader has hard-coded the positional form.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320487\n", "files": ["toolkit/components/backgroundhangmonitor/aggregation/profile_processor.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_profile_processor.py"], "git_node": "3bbd2e6b5d4efa1b58d4c06361833fec99c6aa47", "git_parents": ["ccef86e93dbbb50b1c57b324efbae8c55aec1d02"], "node": "c5c4dcb4244cc2e8adb2a5a3c293f18b45664349", "parents": ["92aaf33da1dcf781ce37db9fd7da2e21718b35b9"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062613 - Show that sync is in progress or complete when animations are disabled with \"Syncing...\" label r=skhamis\" for causing failures at browser_synced_tabs_menu.js.\n\nThis reverts commit 6021ea76bd121aac95405a9bb1995fc17141bbd9.\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser_sync.js"], "git_node": "ccceac8fc9c953269aa81cff2ea5d96d01e294fa", "git_parents": ["3bbd2e6b5d4efa1b58d4c06361833fec99c6aa47"], "node": "f8432151f1ddf26430747a0ea8d46a03c7fb64db", "parents": ["c5c4dcb4244cc2e8adb2a5a3c293f18b45664349"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066502 - Avoid un-throttling animations from reflow callbacks. r=layout-reviewers,boris\" for causing failures at test_restyles.html.\n\nThis reverts commit 842b8109572e4554db80e98e6563fd42525027a1.\n", "files": ["layout/base/PresShell.cpp"], "git_node": "106712b380e2cca160c866b69291187e82930c5d", "git_parents": ["ccceac8fc9c953269aa81cff2ea5d96d01e294fa"], "node": "6d303bbacbc1fc109e94148c1badf18de73ee5d6", "parents": ["f8432151f1ddf26430747a0ea8d46a03c7fb64db"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2032032 - Store HTTP cache encryption key in lockstore instead of pref r=necko-reviewers,jesup,nwipper\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318073\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/cache2/CacheCrypto.cpp", "netwerk/cache2/CacheCrypto.h", "netwerk/cache2/CacheIndex.cpp", "netwerk/cache2/CacheObserver.cpp", "netwerk/docs/cache2/doc.md", "netwerk/test/gtest/TestCacheCrypto.cpp", "netwerk/test/unit/test_cache2-35-encryption.js"], "git_node": "6bb3b504762f76b7f9eff1f0cbfe1a4a4a402880", "git_parents": ["106712b380e2cca160c866b69291187e82930c5d"], "node": "79636e24598d0793c1a0311568744bd36b7d63cf", "parents": ["6d303bbacbc1fc109e94148c1badf18de73ee5d6"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059855 - Focus the WebExtension permission prompt so users using keyboard navigation can reach it more easily. r=robwu\n\nThis patch sets options.autofocus to true for the addon-webext-permissions PopupNotifications doorhanger,\nso the focus is moved to the panel on open.\n\nAlong with that an additional regression test triggers the panel and asserts that no control is auto-focused\non open.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320226\n", "files": ["browser/modules/ExtensionsUI.sys.mjs", "toolkit/mozapps/extensions/test/browser/browser.toml", "toolkit/mozapps/extensions/test/browser/browser_permission_prompt_focus.js", "toolkit/mozapps/extensions/test/xpinstall/browser_block_fullscreen_prompt.js"], "git_node": "785a2bba67efe4faeb096a853e069199de0763f0", "git_parents": ["6bb3b504762f76b7f9eff1f0cbfe1a4a4a402880"], "node": "f65a368df9c0b08a2676f1c920ad6d4f6627a258", "parents": ["79636e24598d0793c1a0311568744bd36b7d63cf"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049749 p1 - Change existing public annotations to ping scope r=gsvelto\n\nThese annotations are already designated as public within Socorro, so\nthere should be no reason they aren't included in pings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315028\n", "files": ["toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/crashping/src/lib.rs"], "git_node": "f13aec16303c89c4bd6f45977151003124d2b94e", "git_parents": ["785a2bba67efe4faeb096a853e069199de0763f0"], "node": "d5975d141d9c070140be3a11fe3dac45e2d4dc91", "parents": ["f65a368df9c0b08a2676f1c920ad6d4f6627a258"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049749 p2 - Add OS, OSVersion, CPUArchitecture, CPUInfo, and LinuxLSBDescription annotations r=gsvelto\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315029\n", "files": ["toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/nsDummyExceptionHandler.cpp", "toolkit/crashreporter/nsExceptionHandler.cpp", "toolkit/crashreporter/nsExceptionHandler.h", "toolkit/crashreporter/test/browser/browser_required_annotations.js", "toolkit/xre/nsAppRunner.cpp", "xpcom/base/nsSystemInfo.cpp"], "git_node": "756557d6c7c6e019b554289d1c15fbb7d28c1a8c", "git_parents": ["f13aec16303c89c4bd6f45977151003124d2b94e"], "node": "d2c11a6672e176143c6bc68039ab314bf7bee39a", "parents": ["d5975d141d9c070140be3a11fe3dac45e2d4dc91"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049749 p3 - Populate OS, OSVersion, and CPUArchitecture annotations in lib-crash r=gsvelto,android-reviewers,nalexander\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319599\n", "files": ["mobile/android/android-components/components/lib/crash/src/androidTest/java/mozilla/components/lib/crash/service/GleanCrashReporterServiceTest.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/Crash.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/service/GleanCrashReporterService.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/service/MozillaSocorroService.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/service/MozillaSocorroServiceTest.kt"], "git_node": "8966e7a25b21a9b47822eb50aa705f5f7b2fb192", "git_parents": ["756557d6c7c6e019b554289d1c15fbb7d28c1a8c"], "node": "ddd48360bb2521bd82b8b5d99248ab8dae9c3eb2", "parents": ["d2c11a6672e176143c6bc68039ab314bf7bee39a"], "tags": []}, {"author": "Harshit \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063065 - Make MSIX background tasks activate and run in a full trust process. r=nrishel,browser-installer-reviewers,aborondo,frontend-codestyle-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318008\n", "files": ["Cargo.lock", "browser/installer/windows/msix/AppxManifest.xml.in", "build/rust/mozbuild/generate_buildconfig.py", "python/mozbuild/mozbuild/repackaging/msix.py", "toolkit/components/backgroundtasks/BackgroundTasks.cpp", "toolkit/components/taskscheduler/TaskSchedulerWinMSIXImpl.sys.mjs", "toolkit/components/taskscheduler/nsIWinBackgroundTaskRegistrar.idl", "toolkit/components/taskscheduler/rust/Cargo.toml", "toolkit/components/taskscheduler/rust/src/lib.rs", "toolkit/components/taskscheduler/tests/xpcshell/xpcshell.toml", "toolkit/modules/AppConstants.sys.mjs", "toolkit/modules/moz.build", "toolkit/moz.configure", "toolkit/mozapps/msixcomserver-rust/Cargo.toml", "toolkit/mozapps/msixcomserver-rust/src/lib.rs", "toolkit/mozapps/msixcomserver/msixcomserver.cpp", "toolkit/mozapps/msixcomserver/msixcomserver.def", "tools/lint/eslint/eslint-plugin-mozilla/lib/rules/valid-ci-uses.mjs"], "git_node": "276bad1472c95b721d47f0829c571e6d5b5ef263", "git_parents": ["8966e7a25b21a9b47822eb50aa705f5f7b2fb192"], "node": "e852cbbdfb8baa2989b8d7db78d5ca929dcea9dd", "parents": ["ddd48360bb2521bd82b8b5d99248ab8dae9c3eb2"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063462 - Remove LWasmCallIndirectAdjunctSafepoint from wasm Ion codegen r=jseward\n\nThe adjunct LIR node existed only to carry a second safepoint for the two call\ninstructions (fast and slow path) of call_indirect/call_ref. Instead, record\nthis call's single LSafepoint at both return offsets via markSafepointAt: the\ntwo paths are mutually exclusive and rejoin with the same live references and\nframe layout, so one stackmap serves both.\n\nRecording one LSafepoint at multiple offsets is sound for wasm because wasm\ncode is never invalidated (in JS Ion it requires a declared extra use, see\nLIRGraph::addExtraSafepointUses / the maxSafepointIndices assert in\nCodeGenerator::generate()). Add a DEBUG assert in markSafepointAt to trip if\nthat invariant is ever broken.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318752\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/LIR.h", "js/src/jit/LIROps.yaml", "js/src/jit/Lowering.cpp", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/jit/shared/LIR-shared.h"], "git_node": "56f820bce1ac0323cafc18441586158ae5c4fdad", "git_parents": ["276bad1472c95b721d47f0829c571e6d5b5ef263"], "node": "2c950324948586968bb4b3eecd9fa9a428ea21fa", "parents": ["e852cbbdfb8baa2989b8d7db78d5ca929dcea9dd"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2066579 - Add the OLED colors for the Tab Groups r=android-reviewers,007\n\nFigma: https://www.figma.com/design/MjufE1X5fvkxZ0YneX4kRd/Android-Library--Nova-?node-id=64745-6585&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321373\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/TabGroupColors.kt"], "git_node": "3b794d9cff54a1ddbc47f5fe239f27ea0dc62f5d", "git_parents": ["56f820bce1ac0323cafc18441586158ae5c4fdad"], "node": "09fd589c2f0d9bd991a493f9ad564cb4de33c22c", "parents": ["2c950324948586968bb4b3eecd9fa9a428ea21fa"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061744 - Update sharing icons. r=desktop-theme-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321274\n", "files": ["browser/components/sharing/content/copy-link.svg", "browser/components/sharing/content/mail.svg", "browser/components/sharing/content/qr-code.svg", "browser/components/sharing/jar.mn", "browser/themes/shared/sharePanel.css"], "git_node": "3799bb1803c00312007aa0b164c5dd9d46dc8d1b", "git_parents": ["3b794d9cff54a1ddbc47f5fe239f27ea0dc62f5d"], "node": "2700548191159e42ec50f6c2d7e71b1e6cfa85d9", "parents": ["09fd589c2f0d9bd991a493f9ad564cb4de33c22c"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063779 - Garbled text (mojibake) in address bar placeholder during startup. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321263\n", "files": ["browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/tests/browser-search/browser_placeholder.js", "browser/components/urlbar/tests/unit/test_UrlbarPrefs.js"], "git_node": "d5f2e1f1d7d0b1ae71a85e4acd00efc0ec261ab7", "git_parents": ["3799bb1803c00312007aa0b164c5dd9d46dc8d1b"], "node": "3bcae5c2b2080d3387d5e8eef263cb868704f26b", "parents": ["2700548191159e42ec50f6c2d7e71b1e6cfa85d9"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2062877 - Snap border radii that drive a corner segment to whole device pixels r=gfx-reviewers,nical\n\nA rounded border corner is rasterized into a cached texture sized to the whole\ndevice pixels of its corner box, then stretched onto that box. When the box has\na fractional device size the composite resamples the cached arc, so a hairline\ncurve loses contrast against the straight sides, which are grid snapped and\nfully opaque. The curve then reads as thinner than the sides, and a radius whose\nfractional part is below a half is drawn a whole pixel too large because the\ntask size rounds while the rasterized geometry rounded up.\n\nThe corner box is max(radius, width), so snap a radius that exceeds its border\nwidth to a whole device pixel, matching what is already done for the widths.\nThat makes the corner composite exact, which in turn lets the rasterized arc use\nthe requested radius and thickness rather than rounding both up. A hairline side\nkeeps a texel of its own in the corner task so it cannot drop out of the arc.\n\nMeasured against an ideal supersampled arc, a fractional-radius corner goes from\n0.027 RMSE and 0.23 peak error to 0.010 and 0.09, matching what a whole-pixel\nradius already rendered, and the mean peak coverage along the curve rises from\n0.66 to 0.75.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319658\n", "files": ["gfx/wr/webrender/src/border.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/wrench/reftests/border/border-corner-fractional-radius-ref.yaml", "gfx/wr/wrench/reftests/border/border-corner-fractional-radius.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/border-shape.png", "gfx/wr/wrench/reftests/border/reftest.list"], "git_node": "272650e7287995534a43da0236c6d693a463ea87", "git_parents": ["d5f2e1f1d7d0b1ae71a85e4acd00efc0ec261ab7"], "node": "181835c0cbe0153f5f5d5d3e976d61025c5d4a49", "parents": ["3bcae5c2b2080d3387d5e8eef263cb868704f26b"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062188 - Use PR specific index template for eager index tasks, r=taskgraph-reviewers,jcristau\n\nPull requests need to write to a separate index cache.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321258\n", "files": ["taskcluster/gecko_taskgraph/util/cached_tasks.py"], "git_node": "29739497bbd891209a0b05d1b9191d6f399a1919", "git_parents": ["272650e7287995534a43da0236c6d693a463ea87"], "node": "2efaf93bda1005285dd63c88d99a0c899ea0dccf", "parents": ["181835c0cbe0153f5f5d5d3e976d61025c5d4a49"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2066407 - Part 1: Lift main thread requirement from GlobalObject::GetSubjectPrincipal r=nika\n\nIt looks like an outdated requirement introduced before nsIPrincipal was thread safe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321301\n", "files": ["dom/bindings/BindingUtils.cpp"], "git_node": "e91305603311cbd63c480027e2f67d3b79b22055", "git_parents": ["29739497bbd891209a0b05d1b9191d6f399a1919"], "node": "39ac2540c0ac1baca06c03527f62bb75bffd3b90", "parents": ["2efaf93bda1005285dd63c88d99a0c899ea0dccf"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2066407 - Part 2: Allow Brotli large window for pdf.js r=dom-core-reviewers,smaug\n\nBut not for web in general, because the spec currently requires RFC7932 compliance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321271\n", "files": ["dom/compression/DecompressionStream.cpp", "dom/compression/FormatBrotli.cpp", "dom/compression/FormatBrotli.h", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/compression/decompression-brotli-large-window.tentative.any.js.ini", "testing/web-platform/tests/compression/decompression-brotli-large-window.tentative.any.js"], "git_node": "0e0cfbbbb77852a92c5b2f5793df6c767ee7dadf", "git_parents": ["e91305603311cbd63c480027e2f67d3b79b22055"], "node": "fdddc0514c820357ae776992a336a4965920fc14", "parents": ["39ac2540c0ac1baca06c03527f62bb75bffd3b90"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings mobile-merino-manifest ct-logs - r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321383\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/translations-models.json"], "git_node": "f827f59b17a99ea8a531d7e63515cc0b529143c3", "git_parents": ["0e0cfbbbb77852a92c5b2f5793df6c767ee7dadf"], "node": "d79267c57ae50b5a6d6decaeb3405bf0c5d4def7", "parents": ["fdddc0514c820357ae776992a336a4965920fc14"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065408 - Add profiler markers for shutdown phases. r=xpcom-reviewers,profiler-reviewers,nika,canova\n\nAdvanceShutdownPhaseInternal emits no profiler markers, so shutdown phases are\nonly indirectly visible through the NotifyObservers marker of the topic each\nphase fires. XPCOMShutdownFinal and CCPostLastCycleCollection have no observer\ntopic at all, and the notification covers only a part of the phase advance: the\ntwo NS_ProcessPendingEvents drains and KillClearOnShutdown run outside it, so\nrunnables processed there show up with no enclosing context.\n\nAdd an interval marker over the whole advance, plus one for each drain and for\nKillClearOnShutdown, all carrying the phase name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320446\n", "files": ["xpcom/base/AppShutdown.cpp"], "git_node": "15522dafef37c6e55de2d5dd74db0771c6a97e37", "git_parents": ["f827f59b17a99ea8a531d7e63515cc0b529143c3"], "node": "419a2e88ba659e441d125e33f445836d88d3fac2", "parents": ["d79267c57ae50b5a6d6decaeb3405bf0c5d4def7"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065408 - Add a profiler marker for the actual AsyncShutdown blocker wait. r=xpcom-reviewers,mccr8\n\nThe existing \"AsyncShutdown blocker\" marker spans from the moment a blocker is\nregistered, which for most blockers is startup, so a profile shows a wall of\nmulti second intervals that say nothing about shutdown itself.\n\nStamp the time at which the barrier starts waiting for a blocker and emit a\nsecond marker covering only that wait, so it is visible which blockers actually\ndelayed which phase.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320447\n", "files": ["toolkit/components/asyncshutdown/AsyncShutdown.sys.mjs"], "git_node": "b14c9be11381d4ba790c95f6c7051409bf00cbef", "git_parents": ["15522dafef37c6e55de2d5dd74db0771c6a97e37"], "node": "8d923a80f4e57abcff3a80113d98f728a889f1d7", "parents": ["419a2e88ba659e441d125e33f445836d88d3fac2"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064936 - Part 1: Make the tab sound indicator follow a tab moved to another window. r=tabbrowser-reviewers,jswinarton\n\nA tab's media controller belongs to its browsing context, so moving a tab to\nanother window hands that controller to a different browser too. The tab kept\nlistening to the controller it had before the move, which is discarded along\nwith the window it came from, so the indicator stopped tracking playback: it\nnever appeared for audio started after the move, and never cleared if it was\nalready showing.\n\nRe-point the listener at the controller the tab has once its browsing context\nhas moved. This is done directly at the swap rather than through the existing\nswap notification, to keep the change small enough to uplift; moving to that\nnotification is left as a follow-up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321073\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "21a6b6f0ab4400e529f27c812c583ed2ecd0f9f7", "git_parents": ["b14c9be11381d4ba790c95f6c7051409bf00cbef"], "node": "607874a127df407ce2507d7168a3f647217fa0de", "parents": ["8d923a80f4e57abcff3a80113d98f728a889f1d7"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064936 - Part 2: Add a test for the tab sound indicator when a tab moves to another window. r=tabbrowser-reviewers,jswinarton\n\nCheck that audio started after the move raises the indicator and that audio\nstopped after the move clears it, once for each way a tab can reach another\nwindow.\n\nShare the media element helpers through the directory's head file rather than\nadding a second copy of them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321074\n", "files": ["browser/components/tabbrowser/test/browser/tabMediaIndicator/browser.toml", "browser/components/tabbrowser/test/browser/tabMediaIndicator/browser_mediaplayback_audibility_change.js", "browser/components/tabbrowser/test/browser/tabMediaIndicator/browser_sound_indicator_tab_move.js", "browser/components/tabbrowser/test/browser/tabMediaIndicator/head.js"], "git_node": "2dbf2549bfd778df58f1956a1e027e5045b00d96", "git_parents": ["21a6b6f0ab4400e529f27c812c583ed2ecd0f9f7"], "node": "8f162d8d560a367e91da2d9053d9495fd465b8b4", "parents": ["607874a127df407ce2507d7168a3f647217fa0de"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062877 - Snap border radii that drive a corner segment to whole device pixels r=gfx-reviewers,nical\" for causing failures at 456219-1a.html.\n\nThis reverts commit 272650e7287995534a43da0236c6d693a463ea87.\n", "files": ["gfx/wr/webrender/src/border.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/wrench/reftests/border/border-corner-fractional-radius-ref.yaml", "gfx/wr/wrench/reftests/border/border-corner-fractional-radius.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/border-shape.png", "gfx/wr/wrench/reftests/border/reftest.list"], "git_node": "a958e09a6277938d91833a2cba0deb0267bd806c", "git_parents": ["2dbf2549bfd778df58f1956a1e027e5045b00d96"], "node": "1a8c82a7d0f110485dd1e6bb09d49877af41d2ff", "parents": ["8f162d8d560a367e91da2d9053d9495fd465b8b4"], "tags": []}, {"author": "Diego Escalante \u003cdescalante@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050547 - Apply the base style for position-try-order when it's sorted to be the best fit instead of always if it fits. r=firefox-style-system-reviewers,layout-reviewers,emilio,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321277\n", "files": ["layout/generic/AbsoluteContainingBlock.cpp", "testing/web-platform/tests/css/css-anchor-position/position-try-order-include-base-ref.html", "testing/web-platform/tests/css/css-anchor-position/position-try-order-include-base.html"], "git_node": "fc72f33eca1a7aa74e8b421f7eee9071cc5b1542", "git_parents": ["a958e09a6277938d91833a2cba0deb0267bd806c"], "node": "9463f90faab994b6aed0181a1983e64b929e12c6", "parents": ["1a8c82a7d0f110485dd1e6bb09d49877af41d2ff"], "tags": []}, {"author": "Alex Jakobi \u003cajakobi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046702 - Do not overscroll an APZC that is no longer allowed to scroll r=hiro\n\nOnce an input block has a \"scrolled APZC\", AttemptScroll refuses to scroll any\nAPZC earlier in the handoff chain than that one, so a direction reversal within\nthe block cannot move a scroller the block has already left behind. Such an\nAPZC skipped the scrolling, but still turned any leftover delta into a local\noverscroll effect, even while sitting far from the edge that overscroll would\nbelong to, which triggers the assertion in Axis::OverscrollBy. Therefore, we\nonly accept the leftover delta as overscroll when we were allowed to scroll,\nand drop it otherwise.\n\nThe leftover delta was also computed too large. CallDispatchScroll clamps the\nend point to obey overscroll-behavior, but it did so on a local copy, so the\namount it dropped never reached the caller. The caller then derived the\nleftover from its own stale end point and got the true remainder plus whatever\nthe handoff target had scrolled in the meantime. Write the adjusted end point\nback to aEndPoint so caller and callee agree on how much delta is left.\n\nAdds a gtest with a nested vertical-only scroller tree with\noverscroll-behavior: none on the root, so the root can scroll but neither hand off\nnor overscroll. Panning down and then reversing past the root's extent within\none touch block sends the residual delta back to the frozen subframe, triggering\nthe assertion in Axis::OverscrollBy.\n\nAdds a second gtest modelling the reproducer page from the bug more closely:\nnested vertical-only scrollers, no overscroll-behavior, and the subframe offset\nbelow the root's origin. This exercises the changes in CallDispatchScroll().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318405\n", "files": ["gfx/layers/apz/src/AsyncPanZoomController.cpp", "gfx/layers/apz/test/gtest/TestScrollHandoff.cpp"], "git_node": "b6230249fa34f58359eb2a287e1de949d741b9a9", "git_parents": ["fc72f33eca1a7aa74e8b421f7eee9071cc5b1542"], "node": "550a4700203ad71dc69dbc84ec23b0224a81de99", "parents": ["9463f90faab994b6aed0181a1983e64b929e12c6"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043029 - Fix cross-site tracking cookies label in Custom ETP cookies dropdown r=fluent-reviewers,akulyk,bolsson\n\nThe Custom ETP cookies dropdown labels one option as \"Block cross-site cookies\", but that option only blocks cross-site tracking cookies. The label is updated to \"Block cross-site tracking cookies\" so it matches what the option does.\n\nAfter the change:\n{F78476178}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321100\n", "files": ["browser/components/preferences/config/privacy.mjs", "browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "6f265e62d50fc8982ce41df047596450f5bcb742", "git_parents": ["b6230249fa34f58359eb2a287e1de949d741b9a9"], "node": "1d0f4f2cca0461dc6e1547bab24539173204357e", "parents": ["550a4700203ad71dc69dbc84ec23b0224a81de99"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064709 - Move the parameter substitution function into EngineURL as it is only used there. r=search-reviewers,scunnane\n\nAlso adds some improved type information for the getSubmission return values\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320544\n", "files": ["toolkit/components/search/SearchEngine.sys.mjs"], "git_node": "54b714035040cc4418277ca31879ba77be9a1a31", "git_parents": ["6f265e62d50fc8982ce41df047596450f5bcb742"], "node": "6e610608ecb97f9fd374a04a8b0572c97bcc216f", "parents": ["1d0f4f2cca0461dc6e1547bab24539173204357e"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064709 - Move partner code insertion into parameters from ConfigSearchEngine to EngineUrl. r=search-reviewers,scunnane\n\nThis also sets up the SAP source map that we'll need in the next changeset, which includes the telemetry id.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320545\n", "files": ["toolkit/components/search/ConfigSearchEngine.sys.mjs", "toolkit/components/search/SearchEngine.sys.mjs"], "git_node": "f6eb2e853071532f1310fae32562652f63ca0c2d", "git_parents": ["54b714035040cc4418277ca31879ba77be9a1a31"], "node": "bd2c884c6267696fc31def8e3041ba35d9e00460", "parents": ["6e610608ecb97f9fd374a04a8b0572c97bcc216f"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064709 - Use the SAP source to determine the partner code for searches. r=search-reviewers,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320546\n", "files": ["browser/base/content/test/about/browser_aboutNetError_searchCTA_telemetry.js", "browser/components/search/SearchUIUtils.sys.mjs", "toolkit/components/search/OpenSearchEngine.sys.mjs", "toolkit/components/search/SearchEngine.sys.mjs"], "git_node": "b7e2ec635453cd5e5c9c21bdb71608c17936f9a2", "git_parents": ["f6eb2e853071532f1310fae32562652f63ca0c2d"], "node": "9c028e93e2241f622d003081870b3c7ee3d139c9", "parents": ["bd2c884c6267696fc31def8e3041ba35d9e00460"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064709 - Record the correct partner code and telemetry id for SAP telemetry when loading search via SearchUIUtils.loadSearch. r=search-reviewers,scunnane\n\nOther callers of getSubmission/recordSearch will be handled in follow-ups.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320547\n", "files": ["browser/base/content/test/about/browser_aboutNetError_searchCTA_telemetry.js", "browser/components/search/BrowserSearchTelemetry.sys.mjs", "browser/components/search/SearchUIUtils.sys.mjs", "browser/components/search/test/SearchUITestUtils.sys.mjs", "toolkit/components/search/ConfigSearchEngine.sys.mjs", "toolkit/components/search/SearchEngine.sys.mjs", "toolkit/components/search/tests/xpcshell/test_getSubmission_partnerCode.js", "toolkit/components/search/tests/xpcshell/xpcshell.toml"], "git_node": "3c3a0d589c0552ed9202585c4b56b76f1582c1c7", "git_parents": ["b7e2ec635453cd5e5c9c21bdb71608c17936f9a2"], "node": "dfd52c43a7567b9db18ad3b4bad4da19a40cb22f", "parents": ["9c028e93e2241f622d003081870b3c7ee3d139c9"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2065929 - Return resolved promise in ContentSearch.destroy r=search-reviewers,Standard8\n\n`new Promise()` throws as the constructor requires a function.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320739\n", "files": ["browser/actors/ContentSearchParent.sys.mjs"], "git_node": "833b4e762bd6cf11a5807c05f50028558649572c", "git_parents": ["3c3a0d589c0552ed9202585c4b56b76f1582c1c7"], "node": "7b52718677ab9a53459d28da63e0a8da6dbc7a0f", "parents": ["dfd52c43a7567b9db18ad3b4bad4da19a40cb22f"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2065430 - Migrate various actors to moz-src. r=mossop,perftest-reviewers,necko-reviewers,credential-management-reviewers,tabbrowser-reviewers,urlbar-reviewers,layout-reviewers,ai-platform-reviewers,kpatenio,mkennedy,dao,sparky,dshin,dimi,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320388\n", "files": ["browser/actors/AboutNewTabChild.sys.mjs", "browser/actors/AboutPrivateBrowsingChild.sys.mjs", "browser/actors/AboutProtectionsChild.sys.mjs", "browser/actors/AboutTabCrashedChild.sys.mjs", "browser/actors/BlockedSiteParent.sys.mjs", "browser/base/content/test/about/head.js", "browser/base/content/test/forms/head.js", "browser/base/content/test/performance/browser_startup_content.js", "browser/components/customkeys/CustomKeysChild.sys.mjs", "browser/components/pictureinpicture/DesktopPictureInPictureProvider.sys.mjs", "browser/components/profiles/ProfilesChild.sys.mjs", "browser/components/tabbrowser/SmartTabGrouping.sys.mjs", "browser/components/urlbar/private/MLSuggest.sys.mjs", "browser/extensions/formautofill/api.js", "layout/tools/layout-debug/moz.build", "layout/tools/layout-debug/ui/content/layoutdebug.js", "netwerk/docs/url_parsers.md", "testing/talos/talos/tests/tabswitch/actors/TalosTabSwitchChild.sys.mjs", "toolkit/actors/AboutHttpsOnlyErrorChild.sys.mjs", "toolkit/actors/AboutHttpsOnlyErrorParent.sys.mjs", "toolkit/actors/AboutPDFChild.sys.mjs", "toolkit/actors/AboutRestrictedChild.sys.mjs", "toolkit/actors/AboutRestrictedParent.sys.mjs", "toolkit/actors/NetErrorChild.sys.mjs", "toolkit/actors/ViewSourceChild.sys.mjs", "toolkit/actors/moz.build", "toolkit/components/aboutinference/content/aboutInference.js", "toolkit/components/captchadetection/moz.build", "toolkit/components/certviewer/AboutCertViewerChild.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillML.sys.mjs", "toolkit/components/ml/MLModelHubService.sys.mjs", "toolkit/components/ml/actors/moz.build", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_engine_security.js", "toolkit/components/ml/tests/browser/browser_ml_utils.js", "toolkit/components/ml/tests/browser/head.js", "toolkit/components/ml/tests/xpcshell/test_download_rs_attachment_failure.js", "toolkit/components/ml/tests/xpcshell/test_ml_engine_security.js", "toolkit/components/pictureinpicture/tests/head.js", "toolkit/components/resistfingerprinting/UserCharacteristicsPageService.sys.mjs", "toolkit/components/resistfingerprinting/tests/browser/browser_usercharacteristics_canvas_font.js", "toolkit/content/widgets/autocomplete-popup.js", "toolkit/content/widgets/autocomplete-richlistitem.js", "toolkit/content/widgets/browser-custom-element.mjs", "toolkit/modules/ActorManagerParent.sys.mjs", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "bda2a76f166a0a2ea9ddd583edb71743b61f08d7", "git_parents": ["833b4e762bd6cf11a5807c05f50028558649572c"], "node": "446a81c6a3373ecec2b54547979989178e0aded6", "parents": ["7b52718677ab9a53459d28da63e0a8da6dbc7a0f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066534 - Move the llvm-symbolizer toolchain aliases to clang 22. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321337\n", "files": ["taskcluster/kinds/toolchain/llvm-symbolizer.yml"], "git_node": "a78c19fc079139f972d1f702bd0e84f4da5f0ff6", "git_parents": ["bda2a76f166a0a2ea9ddd583edb71743b61f08d7"], "node": "7e69b6b8fc8b77faf176f43ae60015650de6ad69", "parents": ["446a81c6a3373ecec2b54547979989178e0aded6"], "tags": []}, {"author": "Chun-Min Chang \u003ccchang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048399 - Add gtests for converting the picture region. r=media-playback-reviewers,alwu\n\nConvertToI420 and ConvertToNV12 read from the wrong corner when the visible\nregion sits at an offset inside a larger buffer. Each test builds such a frame\nwith the padding and the picture in different colours, so converting from the\nwrong corner leaves padding inside the converted frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318801\n", "files": ["dom/media/gtest/TestImageConversion.cpp"], "git_node": "c156d165a5c37d33fd5773b47ec51954700745fe", "git_parents": ["a78c19fc079139f972d1f702bd0e84f4da5f0ff6"], "node": "e944a930676084ae05917857c593714768feaad6", "parents": ["7e69b6b8fc8b77faf176f43ae60015650de6ad69"], "tags": []}, {"author": "Chun-Min Chang \u003ccchang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048399 - Convert the picture region, not the coded origin. r=media-playback-reviewers,alwu\n\nA decoded video frame can sit in a buffer bigger than the visible image, with the\nvisible part starting somewhere other than the top-left corner. ConvertToI420 and\nConvertToNV12 took the visible size but read from the corner of the whole buffer,\nso such a frame came out shifted, showing padding along two edges and losing the\nopposite edges of the picture. Read from the visible region instead, as the YUV\nto RGB path already does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318802\n", "files": ["dom/media/ImageConversion.cpp"], "git_node": "f11531fae578466ad75e432d2cb5af3d4323e6a9", "git_parents": ["c156d165a5c37d33fd5773b47ec51954700745fe"], "node": "1c1515a32ac20e78bfcecbfe34af00576557f926", "parents": ["e944a930676084ae05917857c593714768feaad6"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2064530 - [Monitor Agent][FE] Monitor /watch command opens a blank monitor form on SW full page r=gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321071\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agentui_command.js"], "git_node": "8e0541ad69e1014994c4af2dbb853419c4ef052b", "git_parents": ["f11531fae578466ad75e432d2cb5af3d4323e6a9"], "node": "6db3ed3376aee12c002958cdb48d1a60b1f359d7", "parents": ["1c1515a32ac20e78bfcecbfe34af00576557f926"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2066345 - part 1: Add log of `Selection::SelectFrames` r=jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321160\n", "files": ["dom/base/AbstractRange.h", "dom/base/Selection.cpp"], "git_node": "f8dac7e03668267f81717277e7a6297e91b34cb2", "git_parents": ["8e0541ad69e1014994c4af2dbb853419c4ef052b"], "node": "d3e1751d490df057d7eec6aa3b13150c2e16a967", "parents": ["6db3ed3376aee12c002958cdb48d1a60b1f359d7"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2066345 - part 2: Add log of `Selection::LookUpSelection` r=jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321161\n", "files": ["dom/base/Highlight.h", "dom/base/Selection.cpp", "layout/generic/nsFrameSelection.h"], "git_node": "07f1c6dd6b7b489bf08b89bafb0ffa5eadfa89b0", "git_parents": ["f8dac7e03668267f81717277e7a6297e91b34cb2"], "node": "fcd0310ef0fa53ccb42f3408191f7a135d1a4d3b", "parents": ["d3e1751d490df057d7eec6aa3b13150c2e16a967"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047026 - Add Glean smoke test for Link Preview llama.cpp inference r=ai-platform-reviewers,flozia,nordzilla\n\nNothing in shipped Firefox tells us whether llama.cpp inference in Link\nPreview still produces the outputs we expect after a vendor bump, a\nmodel swap, or a quantization change. We need a Category-1-safe signal\nfrom the release population that catches output drift and lets us pin\nany drift to a specific vendored llama.cpp revision.\n\nLinkPreviewModel.generateTextAI reuses the still-warm engine to call\nrunSmokeTest immediately before terminating: a fixed Mozilla-controlled\nprompt is run with greedy sampling, the output is SHA-256'd, and a new\ngenai.linkpreview.smoke_test event records output_hash, matches_pinned,\nand the model identifiers. runSmokeTest is a no-op unless the running\nengine is the pinned SmolLM2 checkpoint on the native llama.cpp\nbackend, and fires at most once per Firefox build ID per install. The\nhash lets downstream analysis bucket users whose output drifted the\nsame way without storing the raw text.\n\nfirefox.ai.runtime.engine_run gains a backend_version extra that\nrecords the running llama.cpp revision when the backend is\n\"llama.cpp\"; the value is null for other backends until they populate\ntheir own version. Bug 2005365 unified the run-metrics shape across\npipelines but did not carry a version identifier through. The revision\nliteral lives at the top of MLEngineParent.sys.mjs; a cross-reference\ncomment in third_party/llama.cpp/moz.yaml points vendor bumpers at the\nJS constant they need to keep in sync.\n\nThe smoke_test event joins to the sibling engine_run and\nrun_inference_success_flow events for the same inference via flow_id,\nso any hash miss lands with the specific vendored revision that\nproduced it.\n\nbrowser_ml_llama_smollm2_smoke.js exercises runSmokeTest against a\nreal SmolLM2 engine under the perftest harness and asserts the\nsmoke_test event was recorded with the pinned hash, the pinned model\nidentifiers, and the correct throttle behavior on a second call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311308\n", "files": ["browser/app/profile/firefox.js", "browser/components/genai/LinkPreviewModel.sys.mjs", "browser/components/genai/metrics.yaml", "browser/components/genai/tests/xpcshell/test_link_preview_text.js", "third_party/llama.cpp/moz.yaml", "toolkit/components/ml/MLTelemetry.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/metrics.yaml", "toolkit/components/ml/tests/browser/browser_ml_llama_smollm2_smoke.js"], "git_node": "618b568868878a6c6ebe9524e7906adf70990c1a", "git_parents": ["07f1c6dd6b7b489bf08b89bafb0ffa5eadfa89b0"], "node": "785823faf065b9aa3a76f3b606656eee41efc6f9", "parents": ["fcd0310ef0fa53ccb42f3408191f7a135d1a4d3b"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2066337 - Pt 1 - Clamp a border's corner radii in the display list builder r=gfx-reviewers,nical\n\nadd_normal_border applied the css-backgrounds-3 5.5 radius clamp against the\nprimitive rect, which is the item's bounds: process_common_properties no longer\nsnaps, so every input was already known at record time. push_border does it now.\n\nNo rendering change. ensure_no_corner_overlap is a pure function of the radii and\nthe box size, the size is the same size, and every border item comes from\npush_border - so a shadow copy, built from the captured item, inherits the clamp\nrather than being clamped again on the far side.\n\nThe recorded list now carries the clamped radius rather than the authored one.\nOnly display list dumps read it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321143\n", "files": ["gfx/wr/webrender/src/border.rs", "gfx/wr/webrender_api/src/display_list.rs"], "git_node": "1fc4d7d7e8a337deeb51477dd569a2c9ef0f001a", "git_parents": ["618b568868878a6c6ebe9524e7906adf70990c1a"], "node": "a96ac4fee452ea11fef8705fa2c7111ede581504", "parents": ["785823faf065b9aa3a76f3b606656eee41efc6f9"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2066337 - Pt 2 - Derive a box-shadow's rect in the display list builder r=gfx-reviewers,nical\n\nadd_box_shadow signed the spread by the clip mode, clamped the blur, built the\nshadow rect, inflated it for the blurred region and rejected three cases that\ndraw nothing. None of that needs anything the scene builder knows, so\npush_box_shadow does it and records the rect the shader wants: the blur-inflated\nouter rect for outset, the element rect for inset. prepare_box_shadow already\nrecovered the element rect from that pair, so one rect on the item is enough.\n\nbox_bounds becomes bounds and spread_radius the signed spread_amount - same\nfields, same order, same encoded size - and push_box_shadow's signature is\nunchanged. BLUR_SAMPLE_SCALE and MAX_BLUR_RADIUS move to webrender_api for the\nproducer; the former stays re-exported for the blur code that reads it in\nbox_shadow.\n\nOne quirk is preserved rather than fixed, and is now visible instead of implied.\nAn outset shadow registered its primitive through\nLayoutPrimitiveInfo::with_clip_rect, which hardcodes PrimitiveFlags::default(),\nso outset lost ANTIALISED and had IS_BACKFACE_VISIBLE forced on while inset kept\nthe item's flags. push_box_shadow writes that default onto the item.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321144\n", "files": ["gfx/wr/webrender/src/box_shadow.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs"], "git_node": "ddcf0313ee3be07a68e999a516649bab581d7398", "git_parents": ["1fc4d7d7e8a337deeb51477dd569a2c9ef0f001a"], "node": "32d405b213e54c536ef551cc7eb8ca6d9f5a88a5", "parents": ["a96ac4fee452ea11fef8705fa2c7111ede581504"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2066337 - Pt 3 - Run the linear gradient geometry pipeline in the display list builder r=gfx-reviewers,nical\n\nThe scene builder rejected invalid gradients, resolved the repeat size, ran\noptimize_linear_gradient - which rewrites the prim rect, the tile size and both\nendpoints - then rejected a tile that rounds up to nothing. Every input came off\nthe item, and the two rects handed to process_repeat_size were the same rect.\n\npush_gradient does it and records the results. Returning early on either reject\nis safe because stops travel as an argument rather than a SetGradientStops item\npushed just before (bug 2063483 Pt 3), so there is no half-written gradient left\nbehind.\n\nSame fields, types and order on the item; the values are the optimized ones.\n\noptimize_linear_gradient's re-export in prim_store::gradient::linear has no\nreader left. Its doc comment had been stranded above that re-export, and moves\nonto the function in webrender_api::prim_geometry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321145\n", "files": ["gfx/wr/webrender/src/prim_store/gradient/linear.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/prim_geometry.rs"], "git_node": "76a25d2aa71512184f21cf42cb722aff0c68258e", "git_parents": ["ddcf0313ee3be07a68e999a516649bab581d7398"], "node": "1cad935608b701ece7fd5ad154d01e47e1693810", "parents": ["32d405b213e54c536ef551cc7eb8ca6d9f5a88a5"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2066337 - Pt 4 - Run the conic gradient geometry pipeline in the display list builder r=gfx-reviewers,nical\n\nAs Pt 3, and simpler: a conic gradient has no optimize_* pass of its own, just\nthe local clip. push_conic_gradient rejects non-finite gradients, resolves the\nrepeat size, applies the clip - which shrinks the rect and returns the offset\nthat keeps the center aligned to it - and rejects a tile that rounds away. The\nitem records the clipped rect, the resolved tile size and the offset center.\n\nSame fields, types and order.\n\nThat was apply_gradient_local_clip's last caller in webrender, so its import and\nre-export go too. The comment above the re-export said why the clip is applied\nearly and that it is done per axis, neither of which prim_geometry's own doc\nsaid, so it merges there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321146\n", "files": ["gfx/wr/webrender/src/prim_store/gradient/mod.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/prim_geometry.rs"], "git_node": "243bcf3eacf35c6862460359315579f081d05249", "git_parents": ["76a25d2aa71512184f21cf42cb722aff0c68258e"], "node": "8fc582800f0b4ab314e16cd75353ad033c421d5b", "parents": ["1cad935608b701ece7fd5ad154d01e47e1693810"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2066337 - Pt 5 - Let a rect display item say which edges to anti-alias r=gfx-reviewers,nical\n\nEvery other primitive takes the constant EdgeMask::all() that\nprocess_common_properties hands out, because the scene builder only masks edges\nwhen it splits an item into abutting pieces. Pt 6 moves the clamped-radial-\ngradient margin decomposition to the builder, which makes those margins ordinary\nrect items whose interior edges must not be anti-aliased or they seam against the\ngradient.\n\nOnly the transformed mask: aligned_aa_edges is EdgeMask::empty() for every\nprimitive, so masking it would be a byte for nothing.\n\nEdgeMask gains a Default for peek-poke's Peek derive - empty() rather than all(),\nso a mask nobody set cannot silently anti-alias an interior edge.\n\nA byte per rect item that buys nothing until Pt 6: a prerequisite, not an\nimprovement.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321147\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/key_types.rs"], "git_node": "180c49b8190a1cfcaff0c264d3caf41fece064fb", "git_parents": ["243bcf3eacf35c6862460359315579f081d05249"], "node": "c078b7de100d0bffdaf0454aefe03b705553b87b", "parents": ["8fc582800f0b4ab314e16cd75353ad033c421d5b"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2066337 - Pt 6 - Run the radial gradient geometry pipeline in the display list builder r=gfx-reviewers,nical\n\npush_radial_gradient rejects non-finite gradients, resolves the repeat size, runs\noptimize_radial_gradient - which shrinks the gradient to the part that is not a\nconstant colour, moves the center, narrows an edge mask and hands back the solid\nmargins it split off - runs simplify_repeated_primitive again, then rejects a\ntile that rounds away. The margins become rect items pushed ahead of the\ngradient, which is what Pt 5's edge mask is for. The gradient item carries the\nnarrowed mask too, until the gradient is interned and PrimKeyCommonData carries\nit instead.\n\nTwo details are easy to get wrong. The margins are emitted before the ceil-empty\nreject and are not conditional on it, because a gradient that optimizes away\nentirely is all margin. And the second simplify_repeated_primitive is not\nredundant with the one inside radial_gradient_prim: that one discards the rect it\nproduces, so the mutation has to be made out here, and it is the rect the\nprimitive is registered with.\n\nThat was the last webrender caller of optimize_radial_gradient, so its import and\nre-export go.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321148\n", "files": ["gfx/wr/webrender/src/prim_store/gradient/radial.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs"], "git_node": "4e169894cd98555e453ee87efcffdc472ca286fa", "git_parents": ["180c49b8190a1cfcaff0c264d3caf41fece064fb"], "node": "5b980b608e7a0b5f3bfffd20fecd7fb64e585b88", "parents": ["c078b7de100d0bffdaf0454aefe03b705553b87b"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2066337 - Pt 7 - Collapse process_repeat_size to one rect and rename it r=gfx-reviewers,nical\n\nIt took the snapped and unsnapped prim rects and, per axis, replaced a tile\nextent that fuzzily matched the unsnapped rect with the snapped one. Snapping\nmoved to frame time and process_common_properties has returned the same rect for\nboth ever since, so every caller passed one rect twice.\n\nWith one rect there is no snapping left in it. What remains is an epsilon that\nmakes a tile meant to fill the primitive fill it exactly, rather than repeat and\nleave a sliver of a second tile at the far edge - which is not what the name or\nthe doc said. resolve_tile_size takes the prim rect and the authored tile size.\n\nA no-op: the two arguments were the same value at all three call sites.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321149\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/prim_geometry.rs"], "git_node": "f90cfe4c48878eea15dfcf65ce0920dd02fb5bb1", "git_parents": ["4e169894cd98555e453ee87efcffdc472ca286fa"], "node": "f37e09707c62640cb4d6361a95a109beef21fd6a", "parents": ["5b980b608e7a0b5f3bfffd20fecd7fb64e585b88"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2066337 - Pt 8 - Drop process_common_properties' dead unsnapped rect r=gfx-reviewers,nical\n\nIt returned the prim rect twice, which is all \"let unsnapped_rect = prim_rect;\"\never was - left from when snapping happened here and the two could differ.\nEleven of the twelve call sites already discarded it; the twelfth handed it to\nprocess_image_stretch_size, which reads layout.rect instead. The same value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321150\n", "files": ["gfx/wr/webrender/src/scene_building.rs"], "git_node": "453b62c065a2a34f07bac6d094d6fb47625b5826", "git_parents": ["f90cfe4c48878eea15dfcf65ce0920dd02fb5bb1"], "node": "aec446b7cc7dc933d3dac0dec1cca17f1b10b6b5", "parents": ["f37e09707c62640cb4d6361a95a109beef21fd6a"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/feature/addons/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-en-rCA/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-es-rAR/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-fi/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-gn/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-hy-rAM/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ka/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-kk/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-pl/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-pt-rBR/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ro/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ru/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-sk/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-sl/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ug/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-vi/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-zh-rCN/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rCA/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-ug/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml"], "git_node": "9695df7f043bd6ba44b8ee9102374898a5a22af8", "git_parents": ["453b62c065a2a34f07bac6d094d6fb47625b5826"], "node": "24280701cc005dee739895b1bbd554ceb730686f", "parents": ["aec446b7cc7dc933d3dac0dec1cca17f1b10b6b5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048399 - Fix non-unified build bustage.\n", "files": ["dom/media/gtest/TestImageConversion.cpp"], "git_node": "9885aaec6c273a5ccfc6fe1cb6d75a6f90d067b7", "git_parents": ["9695df7f043bd6ba44b8ee9102374898a5a22af8"], "node": "60b249775f713f83b3fa600b315694e05e99c732", "parents": ["24280701cc005dee739895b1bbd554ceb730686f"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064226 - Show Duplicate Tabs on Hover in Organize Tabs r=fluent-reviewers,bolsson,gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319887\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/components/aiwindow/ui/test/xpcshell/test_AutoTabGrouping.js", "browser/locales-preview/autoTabGrouping.ftl"], "git_node": "6e5f2a2d89870ee9bb50b722977ae0f91da0fc58", "git_parents": ["9885aaec6c273a5ccfc6fe1cb6d75a6f90d067b7"], "node": "2d8336e8a533ff4f574e9e5df1161dfa0cb5ca05", "parents": ["60b249775f713f83b3fa600b315694e05e99c732"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034694 - Add `--pushdate` to `mach try` invocations. r=ahochheiden,perftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320254\n", "files": ["tools/tryselect/selectors/auto.py", "tools/tryselect/selectors/chooser/__init__.py", "tools/tryselect/selectors/coverage.py", "tools/tryselect/selectors/empty.py", "tools/tryselect/selectors/fuzzy.py", "tools/tryselect/selectors/perf.py", "tools/tryselect/task_config.py", "tools/tryselect/test/test_task_configs.py"], "git_node": "f52049b5e77c940770a0de2f5e68853d6d086c66", "git_parents": ["6e5f2a2d89870ee9bb50b722977ae0f91da0fc58"], "node": "e42798eae2cf5133cf801bf7a9aa2fbbd2112f2a", "parents": ["2d8336e8a533ff4f574e9e5df1161dfa0cb5ca05"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2063565 - Say which popup is not open when an a11y check fails inside one, r=firefox-desktop-core-reviewers ,mconley,Jamie.\n\n\"Node is not focusable via the accessibility API\" describes the symptom and\nsends people looking for a missing tabindex. When the node is inside a popup\nthat is not open, name the popup instead. Only the message changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317770\n", "files": ["testing/mochitest/browser-test.js", "testing/mochitest/tests/SimpleTest/AccessibilityUtils.js"], "git_node": "f230660e3d38e350a10673b2e79826ef6f0e974e", "git_parents": ["f52049b5e77c940770a0de2f5e68853d6d086c66"], "node": "5ddd87868b6c0584cc2e1ed6d8d2bdc27da458c3", "parents": ["e42798eae2cf5133cf801bf7a9aa2fbbd2112f2a"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064965 - Render the wallpaper attribution under the Nova New Tab layout r=maxx\n\nWallpapers that credit a photographer show that credit at the bottom of the\nNew Tab page. With Nova turned on it never appeared, so the credit those\nwallpapers ship with was never shown at all.\n\nIt now appears in the same place it does with Nova off, and goes away when\nthe wallpaper does. Nothing changes with Nova off. The attribution had no\ntests at all before, so this adds them for both layouts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320783\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/Base/_Base.scss", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx"], "git_node": "999b6f7f98225d7fe8ea085b6b1edd88a970d30d", "git_parents": ["f230660e3d38e350a10673b2e79826ef6f0e974e"], "node": "707c3b84e13716e02cfe0259715664886e0bfa0b", "parents": ["5ddd87868b6c0584cc2e1ed6d8d2bdc27da458c3"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2066636 - Don't allow calling AddonTestUtils.overrideCertDB() twice during a test. r=robwu\n\nThere's a handful of tests that call AddonTestUtils.overrideCertDB() more than once.\nRight now, that works just fine, but with my changes in bug 2065291, overrideCertDB\nwill get more finicky and not support that. In this bug, I'll change it to explicitly\nthrow an error when it is called twice, and fix the places that do it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321425\n", "files": ["toolkit/components/extensions/test/xpcshell/test_ext_experiments.js", "toolkit/mozapps/extensions/internal/AddonTestUtils.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/test_AMBrowserExtensionsImport.js", "toolkit/mozapps/extensions/test/xpcshell/test_AddonRepository_cache_locale.js", "toolkit/mozapps/extensions/test/xpcshell/test_EnvironmentAddonBuilder_telemetry.js", "toolkit/mozapps/extensions/test/xpcshell/test_QuarantinedDomains_AddonWrapper.js", "toolkit/mozapps/extensions/test/xpcshell/test_addons_glean_ping.js", "toolkit/mozapps/extensions/test/xpcshell/test_amo_stats_telemetry.js", "toolkit/mozapps/extensions/test/xpcshell/test_installOrigins.js", "toolkit/mozapps/extensions/test/xpcshell/test_loadManifest_isPrivileged.js", "toolkit/mozapps/extensions/test/xpcshell/test_recommendations.js", "toolkit/mozapps/extensions/test/xpcshell/test_shutdown_barriers.js", "toolkit/mozapps/extensions/test/xpcshell/test_webextension_install.js"], "git_node": "39532fe5a7a63cf58953e0ce2e2e264c94313b12", "git_parents": ["999b6f7f98225d7fe8ea085b6b1edd88a970d30d"], "node": "3a948d4f4a4cede74d7ebc0776ce4a70d5636e4e", "parents": ["707c3b84e13716e02cfe0259715664886e0bfa0b"], "tags": []}], "date": 1787717531, "git_changesets": ["b7bba6fba0930a23de34a19053fc9804a2eb2049", "68d8aed86fa766050797eab1dbd20b669f7c9cb0", "365628b4f08f0b1e9d57f10cfeb7f1d0ba44981e", "8f572b986a1a81d541525fb364af44ae089668e2", "e9610bf4182e22a6f2d99f3c8c21a7f3802465cf", "ac8df485a6b337651ca353c8491c98c32fcef507", "4e5bc8a910c9675fec173d0832c1fd0623981670", "23bfb4dc67a35b55c97b8e2b4fb7b6a6ed46d025", "cf1c0831dbdc0aec3a6404eec577ddaaba9153c5", "98cfb5ec9050343fd2a389c900ede42dbaa82727", "a1da912370453a7425bfa01904af280fa069a4ff", "2a6f05c7433a4099e5606542fd051ed470d19196", "73da04da85289aac01c08749730ee0564ea013c6", "242510ef57ae513394f6ef3bd72e18bea3ee733a", "88a35f00a31ab280ea8cc03a50a301a45f7607ff", "48b9028d81a13ddc5e1dcad3d49e05390677b9aa", "2534cbb3208c34ac4e2dbe289e3e2b8fc38d4160", "b9f09f4b4c6cbc72100d5a54b484f7865a3b0b6b", "c56948641e407