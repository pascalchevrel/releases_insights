ranch": "default", "desc": "Bug 2058900 - Ensure chrome fully hides when in fullscreen mode r=sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319757\n", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js", "browser/base/content/test/fullscreen/browser.toml", "browser/base/content/test/fullscreen/browser_fullscreen_autohide_toolbox_height.js"], "git_node": "6ebf3f0dfdb427d3b247678e60d788c205bc894f", "git_parents": ["96e23fcb01cb34b74e52df054561a3b5767289ed"], "node": "1313e08ad7dbc710166d01af09c2ec1d3d5a0e2c", "parents": ["b7984d778416804c7edf9bd72a291a9223aa91dd"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065160 - Fix CacheSetupAction::OrphanCleanupFailed leading to potentially wrong quota calculations. r=dom-storage-reviewers,dom-worker-reviewers,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320131\n", "files": ["dom/cache/Manager.cpp", "dom/cache/test/mochitest/mochitest-common.toml", "dom/cache/test/mochitest/test_cache_orphaned_padding_underflow.html"], "git_node": "65c97949918b2c3a9c87f631edbf07e6dba79a33", "git_parents": ["6ebf3f0dfdb427d3b247678e60d788c205bc894f"], "node": "f46f924b774da97c7af4627c2adaf9acc3ef2cad", "parents": ["1313e08ad7dbc710166d01af09c2ec1d3d5a0e2c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064279 - Keep per-tab state and the trimmed-prefix derivation to the address bar. r=daleharvey\n\nA content realm threw on every result selection, and again on picking an engine in the switcher. The search-mode store already keeps one object per input outside the address bar; only the browser passed to it and compared against came from `gBrowser`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319712\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "ef27dd1e637ce24e8228fa738d7fe6113dbb69c3", "git_parents": ["65c97949918b2c3a9c87f631edbf07e6dba79a33"], "node": "ac298cdf7ef5cf99bef3e76b39b7ac22fb3aa0bd", "parents": ["f46f924b774da97c7af4627c2adaf9acc3ef2cad"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065630 - Enable the tracker count pref by default, but keep the feature gate off. r=credential-management-reviewers,vinilla\n\nThe tracker count only shows when both browser.urlbar.trackerCount.featureGate and browser.urlbar.trackerCount.enabled are true. Bug 2065206 disabled both by default. The Experimenter treatment flips only the featureGate (the Nimbus-controlled pref), so with enabled=false the count would still stay hidden until a user manually toggled it in Settings.\n\nDefault enabled to true so the treatment shows the count immediately once the gate is on. featureGate stays false, so the feature remains off for the general population, and enabled remains a plain user pref (not Nimbus-controlled), so users can still toggle it off/on in Settings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320583\n", "files": ["browser/app/profile/firefox.js"], "git_node": "fc38d20de1be7aefdb0835809be13c7b0555c214", "git_parents": ["ef27dd1e637ce24e8228fa738d7fe6113dbb69c3"], "node": "f76e863535ee5e24d8c6736ec779ddd377e5bb65", "parents": ["ac298cdf7ef5cf99bef3e76b39b7ac22fb3aa0bd"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053492 - Quota manager: add telemetry to investigate further where drift/underflow are coming from. r=dom-storage-reviewers,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316118\n", "files": ["dom/localstorage/ActorsParent.cpp", "dom/quota/Assertions.cpp", "dom/quota/Assertions.h", "dom/quota/AssertionsImpl.h", "storage/QuotaVFS.cpp"], "git_node": "d5df6027070fc947b293232fff28f96c0654c2d8", "git_parents": ["fc38d20de1be7aefdb0835809be13c7b0555c214"], "node": "3e33325fbccbade2254e64a1e6e0ee373510cf70", "parents": ["f76e863535ee5e24d8c6736ec779ddd377e5bb65"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP - r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320581\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "96096e45dedc6dbffc581045e3b97932002031fa", "git_parents": ["d5df6027070fc947b293232fff28f96c0654c2d8"], "node": "0d72d3abd6ce695a9a40900006c4b3bae955ec74", "parents": ["3e33325fbccbade2254e64a1e6e0ee373510cf70"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053622: about:sync-log UX Refresh r=fluent-reviewers,bolsson,simonf,tschuster,emilio,mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311211\n", "files": ["docshell/base/nsAboutRedirector.cpp", "docshell/build/components.conf", "services/sync/Weave.sys.mjs", "services/sync/components.conf", "services/sync/content/aboutSyncLog.css", "services/sync/content/aboutSyncLog.html", "services/sync/content/aboutSyncLog.mjs", "services/sync/tests/browser/browser.toml", "services/sync/tests/browser/browser_aboutSyncLog.js", "toolkit/content/jar.mn", "toolkit/locales/en-US/services/aboutSyncLog.ftl"], "git_node": "0254efd8e78b1d64dde56b5e8182619b0d13bbef", "git_parents": ["96096e45dedc6dbffc581045e3b97932002031fa"], "node": "283147c9b407f6099f783a236e7cb5efb54ede11", "parents": ["0d72d3abd6ce695a9a40900006c4b3bae955ec74"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049039 - Part 1: Persist ip protection location selection r=android-reviewers,jonalmeida,Roger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316382\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Actions.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddleware.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationRepository.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddlewareTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtection.kt"], "git_node": "d8126c141566ca9659e49e15264976612373f31e", "git_parents": ["0254efd8e78b1d64dde56b5e8182619b0d13bbef"], "node": "57f01f41b56377eb4e3849fde6abe9b30d11b384", "parents": ["283147c9b407f6099f783a236e7cb5efb54ede11"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049039 - Part 2: Show error snackbar when the previously selected r=android-reviewers,android-l10n-reviewers,jonalmeida,Roger,gmalekpour,parker\n\n...vpn location is no longer available.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317144\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/snackbar/SnackbarState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/snackbar/SnackbarStateReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtection.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtectionSnackbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/ui/IPProtectionSnackbarBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocationsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/snackbar/SnackbarBinding.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionSnackbarMiddlewareTest.kt"], "git_node": "c1fee0f90153108b6c3646c37f371ee5b420de84", "git_parents": ["d8126c141566ca9659e49e15264976612373f31e"], "node": "4db7e43a302fb0c6401b2a90455f6a50733adeef", "parents": ["57f01f41b56377eb4e3849fde6abe9b30d11b384"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049039 - Part 3: Remove cached location code when user logs out r=android-reviewers,sfamisa,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318004\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddleware.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddlewareTest.kt"], "git_node": "37da1a1f02c822f149c59164912bcb7970224aa1", "git_parents": ["c1fee0f90153108b6c3646c37f371ee5b420de84"], "node": "eb24a5e1968b4fabb1cfc069ec81b1154764cede", "parents": ["4db7e43a302fb0c6401b2a90455f6a50733adeef"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061058 - Replace activate Boolean with a data class r=android-reviewers,Roger,sfamisa\n\nThe previous `activate: Boolean?` did not allow for switching between\nlocations: the `true` flag would result in an activation, but clearing\nonly happened when the proxy reported a change in state from `ready` to\n`active`. In case of a location switch, proxy would not report any new data,\nso there was a need to help the observer (IPProtectionFeature) to\nreact to activation request even if the flag was not cleared.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317922\n", "files": ["mobile/android/android-components/components/feature/ipprotection/build.gradle", "mobile/android/android-components/components/feature/ipprotection/lint-baseline.xml", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/debug/IPProtectionStateDebug.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/res/values/static_strings.xml", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/debug/IPProtectionStateDebugTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt"], "git_node": "66c33e3582b44059ecfe89360acf9c2d442fd2f7", "git_parents": ["37da1a1f02c822f149c59164912bcb7970224aa1"], "node": "a451d0c3ac99c1f5472940e98086f53cd7acb071", "parents": ["eb24a5e1968b4fabb1cfc069ec81b1154764cede"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065593 - restore logins after switching back to json r=dimi,chutten,mtigley,bdk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319826\n", "files": ["modules/libpref/init/all.js", "toolkit/components/passwordmgr/LoginStorageMigrator.sys.mjs", "toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/passwordmgr/test/unit/test_LoginStorageMigrator.js"], "git_node": "eb964476af2c4eb3cc27de2d87266c677a2e1cc5", "git_parents": ["66c33e3582b44059ecfe89360acf9c2d442fd2f7"], "node": "8b47dca1823c68e34bd70165cb34a29d4295d508", "parents": ["a451d0c3ac99c1f5472940e98086f53cd7acb071"], "tags": []}, {"author": "Andrey Zinovyev \u003cazinovyev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060611 - Fix background audio playback r=webcompat-reviewers,twisniewski,android-reviewers,beth,jonalmeida,geckoview-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316336\n", "files": ["browser/extensions/webcompat/data/interventions/2060611-youtube.com_background-video-playback.json", "browser/extensions/webcompat/injections/js/bug2060611-youtube.com-background-video-playback.js", "mobile/android/app/geckoview-prefs.js", "mobile/android/fenix/app/nimbus.fml.yaml"], "git_node": "d1afce6771bcb7ac02d4ed4aade97b86d1e3680b", "git_parents": ["eb964476af2c4eb3cc27de2d87266c677a2e1cc5"], "node": "aea1e566b3bfef14b27d88bd3d7bd20904b85579", "parents": ["8b47dca1823c68e34bd70165cb34a29d4295d508"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2065567 - Update samply toolchain revision. r=perftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320491\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "052b2a3931af34af38ca07b45dc5e0134e0a9100", "git_parents": ["d1afce6771bcb7ac02d4ed4aade97b86d1e3680b"], "node": "551a03fc5906431d6bfc3b20a1fdae8ec4661d04", "parents": ["aea1e566b3bfef14b27d88bd3d7bd20904b85579"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063294 - Remove inner window gaps of floating chrome for Nova r=desktop-theme-reviewers,tabbrowser-reviewers,dao,sclements,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319297\n", "files": ["browser/base/content/test/maximized/browser_maximized_decoration.js", "browser/themes/shared/browser-shared.css", "browser/themes/shared/customizableui/customizeMode.css", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/content-area.css", "toolkit/components/extensions/test/browser/browser_ext_themes_sidebars.js"], "git_node": "8e0409728a132acd07d5361adfe388e88f0420ec", "git_parents": ["052b2a3931af34af38ca07b45dc5e0134e0a9100"], "node": "9d0b2f7ad33a24bb90bd9d40efe9024118ad236b", "parents": ["551a03fc5906431d6bfc3b20a1fdae8ec4661d04"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054370 - Update AFL++ to version v5.02c. r=truber\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311721\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "4ed2f2cfe77d334ae8cb8bb34a8417a2a435a8f1", "git_parents": ["8e0409728a132acd07d5361adfe388e88f0420ec"], "node": "d63c8150c07a8923a6e9374457fcacec2813eef0", "parents": ["9d0b2f7ad33a24bb90bd9d40efe9024118ad236b"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2065492 - Only register in updateAppInfo once. r=xpcom-reviewers,nika\n\nCurrently, updateAppInfo will see if there's a current factory registered for\napp info, then unregister it using the testing-only CID. Because nobody else is\nusing that CID, this unregister can never succeed unless it was registered by\na previous call to updateAppInfo. This is okay in practice because you can override\na static factory and nobody else in the tests that use this is registering an\napp info factory via another means.\n\nMy patch simplifies this process by tracking whether updateAppInfo has already\nregistered a factory so it only does it once. The factory can stay the same\neven if the app info instance does not because the createInstance method of\nthe factory always uses the current value of currentAppInfo, so it'll be updated\nas the app info changes.\n\nMy goal here is to remove the call to getClassObjectByContractID, which is an odd\nAPI I am trying to remove.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320421\n", "files": ["testing/modules/AppInfo.sys.mjs"], "git_node": "b0e75f3d663a9683dbd704bff330f8c1ae0f1fae", "git_parents": ["4ed2f2cfe77d334ae8cb8bb34a8417a2a435a8f1"], "node": "16d1ac4ec71a0dadbcfe375e25d058d9723beff7", "parents": ["d63c8150c07a8923a6e9374457fcacec2813eef0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065660 - Remove redundant atomization in attribute selector parsing. r=dshin\n\nIf the name is lowercase there's no need to atomize twice.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/347\n", "files": ["servo/components/selectors/parser.rs"], "git_node": "e6cdc04b27d69a22852f763a4d4200456aa58d14", "git_parents": ["b0e75f3d663a9683dbd704bff330f8c1ae0f1fae"], "node": "47d5f0fbbc48bef1aeed24f2ee277ee60bb05da5", "parents": ["16d1ac4ec71a0dadbcfe375e25d058d9723beff7"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061742 - Adding newtab spaces experiment r=fluent-reviewers,ini,jbrown,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320286\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/Base/_Grid.scss", "browser/extensions/newtab/content-src/components/DiscoveryStreamAdmin/DiscoveryStreamAdmin.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamBase/DiscoveryStreamBase.jsx", "browser/extensions/newtab/content-src/components/Spaces/Spaces.jsx", "browser/extensions/newtab/content-src/components/Spaces/_Spaces.scss", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/lib/selectLayoutRender.mjs", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/lib/SectionsLayoutFeed.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/browser/browser.toml", "browser/extensions/newtab/test/browser/browser_newtab_spaces.js", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Spaces.test.jsx", "browser/extensions/newtab/test/unit/lib/PrefsFeed.test.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "7682a4dec4bf0cc39c59ee2809f3ccf3b1a7ac42", "git_parents": ["e6cdc04b27d69a22852f763a4d4200456aa58d14"], "node": "2fa2f4d067d94db7b1468008a9103ea98f9ca35f", "parents": ["47d5f0fbbc48bef1aeed24f2ee277ee60bb05da5"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054192 - [devtools] Ignore updates for network message which are not in the Message state. r=jdescottes,devtools-reviewers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320369\n", "files": ["devtools/client/webconsole/reducers/messages.js", "devtools/client/webconsole/test/node/store/messages.test.js"], "git_node": "125adcdce53522bc9a07b6b8ee381f698b1a9b9b", "git_parents": ["7682a4dec4bf0cc39c59ee2809f3ccf3b1a7ac42"], "node": "29ed8d3d37ec0128f396465bcaa11a3e49e5fdb8", "parents": ["2fa2f4d067d94db7b1468008a9103ea98f9ca35f"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1661556 - Iterate the action list in reverse order on rollback. r=application-update-reviewers,cdupuis\n\nThe updater's rollback code currently implicitly assumes that no two actions\never touch the same path. Non-staged complete updates break this assumption by\nmaking us perform a REMOVE (from the precomplete actions) followed by an ADD,\nincluding on firefox.exe. The consequence is that an update failure results in\nfile loss for the affected paths, so an install directory ends up without\nfirefox.exe in particular.\n\nIterating in reverse order during rollback fixes this. AddFile::Finish now runs\nfirst: it removes the file it added, then finds the shared backup slot still\npopulated and restores the original. RemoveFile::Finish then finds the slot\nalready consumed and does nothing, leaving the restored original in place. This\nimplements the common sense idea that we want to first undo what we did last.\n\nThe success path keeps the forward order, because there RemoveDir::Finish is\nwhat actually removes the directories and it must visit children before their\nparents.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318734\n", "files": ["toolkit/mozapps/update/tests/data/partial_log_failure_mac", "toolkit/mozapps/update/tests/data/partial_log_failure_win", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "e6e3c256f0b333f44464785d9bd3dfa2b5f33ce0", "git_parents": ["125adcdce53522bc9a07b6b8ee381f698b1a9b9b"], "node": "56c6df1ede5c8544da0d7ae596135b8d80b7be6c", "parents": ["29ed8d3d37ec0128f396465bcaa11a3e49e5fdb8"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1661556 - Test rollback of a failed non-staged complete update. r=application-update-reviewers,cdupuis\n\nThe new test exercises the path that the previous patch fixes: a non-staged\ncomplete update where the installed precomplete manifest removes files that the\nMAR manifest then adds back.\n\ncheckFilesAfterUpdateFailure verifies that the whole installation is back to\nits original contents. Without the previous patch, the removed-then-added files\nare missing instead of restored and the test fails. The failure is injected\nafter those re-adds have run, by locking 1/10/10text0.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318735\n", "files": ["toolkit/mozapps/update/tests/unit_update_binary/marRemoveAddRollbackFailureComplete_win.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml"], "git_node": "989a72e7f2053fc7f93e4487e03e177997e62c93", "git_parents": ["e6e3c256f0b333f44464785d9bd3dfa2b5f33ce0"], "node": "11b68e797909a37d96681ce665573bf679c04e9e", "parents": ["56c6df1ede5c8544da0d7ae596135b8d80b7be6c"], "tags": []}, {"author": "Swarup Ukil \u003csukil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1986641 - Remove the legacy content: attr() path. r=emilio,devtools-reviewers,firefox-style-system-reviewers,layout-reviewers,nchevobbe\n\nnsAttributeTextNode is used by MozLabelContent and MozAltContent, which\nmakes complete removal tough, but overall the node is now leaner.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314355\n", "files": ["accessible/base/CssAltContent.cpp", "accessible/base/CssAltContent.h", "accessible/generic/LocalAccessible.cpp", "devtools/client/inspector/rules/test/browser_rules_container-queries.js", "dom/base/nsTextNode.cpp", "layout/base/nsCSSFrameConstructor.cpp", "layout/generic/nsHTMLParts.h", "layout/inspector/tests/test_bug877690.html", "servo/components/style/custom_properties.rs", "servo/components/style/properties/mod.rs", "servo/components/style/queries/feature_expression.rs", "servo/components/style/values/generics/counters.rs", "servo/components/style/values/specified/box.rs", "servo/components/style/values/specified/counters.rs", "servo/components/style/values/specified/mod.rs", "servo/ports/geckolib/glue.rs"], "git_node": "911e6275fa7f6bb66bc1318b0b79adb41dbfe582", "git_parents": ["989a72e7f2053fc7f93e4487e03e177997e62c93"], "node": "ede2f736fe4bfe7248ffcaf1395bd6c93d93185b", "parents": ["11b68e797909a37d96681ce665573bf679c04e9e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064194 part 6 - Say what an underscore means in the tabbrowser. r=tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320072\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/docs/api.md"], "git_node": "8132b55297b94bc792249e46e5cce47a8214092f", "git_parents": ["911e6275fa7f6bb66bc1318b0b79adb41dbfe582"], "node": "2871e647268d6341b8dc452a4e025d337ded457a", "parents": ["ede2f736fe4bfe7248ffcaf1395bd6c93d93185b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064194 part 7 - Keep the tabbrowser's module getters off the instance. r=tabbrowser-reviewers,jsudiaman\n\nOnly `TabMetrics` has consumers reaching it through `gBrowser`; the rest move to the module's `lazy` object, and the two sibling modules that reached for one import it themselves. Two of the getters were read nowhere at all, one of them shadowed by an identically named entry on `lazy`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320073\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/content/tab-context-menu.js"], "git_node": "e409460d0c7fa7ee2a2db32cff78a10ee6438b92", "git_parents": ["8132b55297b94bc792249e46e5cce47a8214092f"], "node": "4274b2f758e312169091bcf3aaa8ce11ae6521a6", "parents": ["2871e647268d6341b8dc452a4e025d337ded457a"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2030831 - Relax `a-s` version ping on try r=nalexander,android-reviewers\" for causing lint failures.\n\nThis reverts commit 5e6464a1784f42e1335d910049c3dbba57001bcb.\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/DependenciesPlugin.kt"], "git_node": "71e4cb606601abae7f44499e35b5a054713d133b", "git_parents": ["e409460d0c7fa7ee2a2db32cff78a10ee6438b92"], "node": "21709d5b7c0817ff7525126abcfe8178cfdee1f0", "parents": ["4274b2f758e312169091bcf3aaa8ce11ae6521a6"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061058, Bug 2049039 - Replace activate Boolean with a data class r=android-reviewers,Roger,sfamisa\" for causing fenix-debug failures.\n\nThis reverts commit 66c33e3582b44059ecfe89360acf9c2d442fd2f7.\n\nThis reverts commit 37da1a1f02c822f149c59164912bcb7970224aa1.\n\nThis reverts commit c1fee0f90153108b6c3646c37f371ee5b420de84.\n\nThis reverts commit d8126c141566ca9659e49e15264976612373f31e.\n", "files": ["mobile/android/android-components/components/feature/ipprotection/build.gradle", "mobile/android/android-components/components/feature/ipprotection/lint-baseline.xml", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/debug/IPProtectionStateDebug.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Actions.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddleware.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationRepository.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/res/values/static_strings.xml", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/debug/IPProtectionStateDebugTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddlewareTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/snackbar/SnackbarState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/snackbar/SnackbarStateReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtection.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtectionSnackbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/ui/IPProtectionSnackbarBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocationsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/snackbar/SnackbarBinding.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionSnackbarMiddlewareTest.kt"], "git_node": "24e7e7d9427ff16112c80ec1d63cdb3e13cef65a", "git_parents": ["71e4cb606601abae7f44499e35b5a054713d133b"], "node": "775a79271b186a65d2ddc1da15aa22d3938176d6", "parents": ["21709d5b7c0817ff7525126abcfe8178cfdee1f0"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064194 part 6 - Say what an underscore means in the tabbrowser. r=tabbrowser-reviewers,jsudiaman\" for causig mass failures.\n\nThis reverts commit 8132b55297b94bc792249e46e5cce47a8214092f.\n\nThis reverts commit e409460d0c7fa7ee2a2db32cff78a10ee6438b92.\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/content/tab-context-menu.js", "browser/components/tabbrowser/docs/api.md"], "git_node": "1a2dca6a09fc5c6bfd2c4817b73ce7acb61513c1", "git_parents": ["24e7e7d9427ff16112c80ec1d63cdb3e13cef65a"], "node": "e189283aaa8820310673b45c66faa2f4526cb686", "parents": ["775a79271b186a65d2ddc1da15aa22d3938176d6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062896 - Gate panel-list's click-on-mouseup on an explicit attribute instead of the anchor's role. r=jules\n\nBehavior-neutral: the new attribute is set on the two panel-lists whose anchors carry role=\"combobox\" today, the search mode switcher's and moz-select's.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319167\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "toolkit/content/tests/widgets/test_panel_item_mouseup_click.html", "toolkit/content/widgets/moz-select/moz-select.mjs", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "36de50e088f563e77e9cb5de735ea01bc373e9aa", "git_parents": ["1a2dca6a09fc5c6bfd2c4817b73ce7acb61513c1"], "node": "3f805bf41807143568418021422563bc0fb180cb", "parents": ["e189283aaa8820310673b45c66faa2f4526cb686"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062896 - Stop exposing the search mode switcher as a combobox wrapping a button. r=Jamie,daleharvey\n\nRemoving the role outright, as suggested in bug 2009628 comment 18, leaves the host exposing an unnamed container: every moz-button host produces one, which bug 2064122 tracks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319168\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser_a11y.js"], "git_node": "9e286ada72d20f5a25a11ca9e99d9f6dfafd8454", "git_parents": ["36de50e088f563e77e9cb5de735ea01bc373e9aa"], "node": "34881436ec24d33ebe0e376510e4b9f7f3e04447", "parents": ["3f805bf41807143568418021422563bc0fb180cb"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2056488 - Show disabled quickactions as disabled. r=daisuke,desktop-theme-reviewers,urlbar-reviewers,Jamie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314254\n", "files": ["browser/components/urlbar/UrlbarProviderActionsSearchMode.sys.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-quickactions/browser_general.js", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "3f18d69dc1a0db011820c71555853e06d53b6f4c", "git_parents": ["9e286ada72d20f5a25a11ca9e99d9f6dfafd8454"], "node": "d7d0ddd5c0ab7867ca05a35e721505856b35f789", "parents": ["34881436ec24d33ebe0e376510e4b9f7f3e04447"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056051: Don't cancel the ImageDecoder read request from cycle-collection unlink r=dom-core-reviewers,media-playback-reviewers,smaug,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318221\n", "files": ["dom/base/NodeIterator.cpp", "dom/media/webcodecs/ImageDecoder.cpp", "dom/media/webcodecs/ImageDecoder.h"], "git_node": "976bbc9aef179896a65ec7c96007fc36c547d662", "git_parents": ["3f18d69dc1a0db011820c71555853e06d53b6f4c"], "node": "4528958758bd49ce22a979d53ba966c9d7f962c1", "parents": ["d7d0ddd5c0ab7867ca05a35e721505856b35f789"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063064: Restructure ImageDecoderReadRequest teardown to remove its CAN_RUN_SCRIPT_BOUNDARY r=media-playback-reviewers,aosmond,jolin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318222\n", "files": ["dom/media/webcodecs/ImageDecoder.cpp", "dom/media/webcodecs/ImageDecoder.h", "dom/media/webcodecs/ImageDecoderReadRequest.cpp", "dom/media/webcodecs/ImageDecoderReadRequest.h", "dom/media/webcodecs/ImageTrack.cpp", "dom/media/webcodecs/ImageTrack.h", "dom/media/webcodecs/ImageTrackList.h"], "git_node": "4abd4a22c56c3945bc5d0d3aab969a05cf5564f0", "git_parents": ["976bbc9aef179896a65ec7c96007fc36c547d662"], "node": "2d8470f6aa66331cbf6c1b4380d1016e5c149944", "parents": ["4528958758bd49ce22a979d53ba966c9d7f962c1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061502 - Add a subsampling bitmap decode helper and use it for AMO add-on icons r=android-reviewers,jdelorenzo\n\nBitmapFactory decodes at full resolution unless it is handed an explicit sample size, so an image\nserved larger than the view it is bound for stays in memory at that larger size.\n\nAdd File.toSampledBitmap and InputStream.toSampledBitmap to support-ktx. They read the image bounds\nfirst and pick the largest power-of-two sample size that still covers the requested target, so the\nresult is never smaller than asked for and callers can scale the rest of the way without visible\nloss. The stream overload has to buffer to read the bounds, so it takes a byte ceiling; prefer the\nfile one where the image is already on disk. Decode the add-on icons fetched from AMO through it,\nwhich also makes explicit that an icon that fails to decode is skipped rather than stored in the\ncache.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316945\n", "files": ["mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/amo/AMOAddonsProvider.kt", "mobile/android/android-components/components/feature/addons/src/test/java/mozilla/components/feature/addons/amo/AMOAddonsProviderTest.kt", "mobile/android/android-components/components/feature/addons/src/test/resources/png/mozac_large.png", "mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/android/graphics/SampledBitmap.kt", "mobile/android/android-components/components/support/ktx/src/test/java/mozilla/components/support/ktx/android/graphics/SampledBitmapTest.kt", "mobile/android/android-components/components/support/ktx/src/test/resources/png/sampled_bitmap.png", "mobile/android/android-components/docs/changelog.md"], "git_node": "6f1c946abb7a7b421bc8ebf04ee273f1a7c8e507", "git_parents": ["4abd4a22c56c3945bc5d0d3aab969a05cf5564f0"], "node": "1b6940c9d2959c0d5bcf376dcd25f0ed9f3a91f9", "parents": ["2d8470f6aa66331cbf6c1b4380d1016e5c149944"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061502 - Decode identity credential icons at the size they are displayed at r=android-reviewers,jdelorenzo\n\nIdentity credential icons arrive as data URIs from a third party provider and are drawn no larger\nthan 32dp, so base64ToBitmap now takes the size its result will be displayed at and subsamples to\nsuit. The decode also moves off the main thread, since it runs while the dialog composes, and the\nsizes handed to it come from the Acorn tokens the icons are drawn with rather than dp literals\nrepeated beside them. Each icon slot is held open while its decode runs so that nothing moves\nonce the bitmap lands.\n\nA data URI can be well formed and still carry a payload that is not base64, which threw out of\nbase64ToBitmap instead of returning null the way its documentation promises. It now returns null,\nso a provider cannot take the dialog down with a malformed icon.\n\nThe bounds of an already-decoded byte array are free to inspect, so this adds a ByteArray overload\nof toSampledBitmap, kept internal to support-ktx since base64ToBitmap is its only caller.\n\nSearch engine icons are left alone. Routing them through AndroidImageDecoder looked like it would\nmake the JPEG and PNG branch consistent with the SVG and ICO ones beside it, but that decoder\nrejects any image whose longest side is more than twice its target, so an icon served at 128px\nwould have been replaced by the generic fallback. Its neighbours do not behave that way: one\nrenders a vector at the requested size and the other picks a frame out of a container. The test\nadded here covers the oversized case that made this visible.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316946\n", "files": ["mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/identitycredential/SelectAccountDialog.kt", "mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/identitycredential/SelectProviderDialog.kt", "mobile/android/android-components/components/feature/search/src/test/java/mozilla/components/feature/search/storage/SearchEngineReaderTest.kt", "mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/android/graphics/SampledBitmap.kt", "mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/kotlin/String.kt", "mobile/android/android-components/components/support/ktx/src/test/java/mozilla/components/support/ktx/kotlin/StringTest.kt", "mobile/android/android-components/docs/changelog.md"], "git_node": "48b3e2aba2187cca70b608a59c2969b0c9beec73", "git_parents": ["6f1c946abb7a7b421bc8ebf04ee273f1a7c8e507"], "node": "693604a6d560e8f89493b53d77a372bcf3b451dd", "parents": ["1b6940c9d2959c0d5bcf376dcd25f0ed9f3a91f9"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061502 - Decode Fenix bitmaps at the size they are displayed at r=android-reviewers,jdelorenzo\n\nThe account avatar, both wallpaper assets and Google Lens captures were each decoded at full\nresolution and only then scaled down or bound to a much smaller view. Wallpapers are served at one\nresolution for every device and a Lens capture is at the camera's full sensor resolution, so this\nis tens of megabytes for images that are about to be shrunk anyway.\n\nDecode all of them with a sample size derived from the size they are actually used at. Lens reuses\nthe subsampling its remote path already does so both of its inputs behave the same way; the rest go\nthrough the new support-ktx helpers. Thumbnails take their target from the composable that draws\nthem and pass it to the use case, rather than the use case rebuilding it from copies of the\nlayout's numbers, so the decode cannot drift from what reaches the screen.\n\nWhile here, stop the thumbnail load turning a cancellation into a null result: it caught every\nthrowable through runCatching, where the full screen load beside it already rethrows\nCancellationException so callers cannot mistake a cancelled load for a missing wallpaper.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316947\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/LensImageUploader.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/UseCases.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/Client.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/WallpaperOnboardingDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/AccountUiView.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/wallpaper/WallpaperSettings.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/wallpaper/WallpaperSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/wallpapers/WallpaperOnboarding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/wallpapers/WallpapersUseCases.kt", "mobile/android/fenix/app/src/main/res/layout/account_preference.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/LensImageUploaderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/ClientTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/helpers/ShadowBoundsReportingBitmapFactory.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/wallpaper/WallpaperSettingsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/wallpapers/WallpaperBitmapSamplingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/wallpapers/WallpapersUseCasesTest.kt", "mobile/android/fenix/app/src/test/resources/png/avatar.png", "mobile/android/fenix/app/src/test/resources/png/wallpaper.png"], "git_node": "f656e951c26b45d324c0a89b4505440435302bb6", "git_parents": ["48b3e2aba2187cca70b608a59c2969b0c9beec73"], "node": "32787f0d1f93b6bc1a36aa32149518400a0c4cf7", "parents": ["693604a6d560e8f89493b53d77a372bcf3b451dd"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061502 - Copy the QR code bytes when saving rather than re-encoding them r=android-reviewers,jdelorenzo\n\nSaving a QR code to the Downloads folder decoded the cached image into a bitmap and compressed it\nback to PNG. The source is already a PNG the app itself wrote, so the bytes can be copied straight\nthrough: lossless, and with no bitmap allocated at all.\n\nWhile here, tighten up the failure paths. A save that cannot be opened, does not finish, or finds\nnothing to copy now reports failure and leaves nothing behind, where before it could claim success\nor leave a truncated PNG in Downloads. The MediaStore entry is also held back until its bytes are\nwritten, so no other app sees a half written download.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316948\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/share/QRCodeDownloader.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/QRCodeDownloaderTest.kt"], "git_node": "820020e865c1147308d2bf9bcf3049c512657455", "git_parents": ["f656e951c26b45d324c0a89b4505440435302bb6"], "node": "9e1f346628f9ec50840888a29b7daff1353013d5", "parents": ["32787f0d1f93b6bc1a36aa32149518400a0c4cf7"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061502 - Fix the QR code bounds decode discarding every image on API 26 and 27 r=android-reviewers,tthibaud\n\nA bounds pass always returns a null bitmap by contract, reporting the size through the Options\ninstead. decodeDownsampledStream treated that null as \"the stream could not be opened\" and threw,\nso decoding a QR code from a URI failed on every device below API 28, which is the only path that\ndoes not go through ImageDecoder.\n\nKey off the decoded dimensions instead, which stay at zero when the stream really cannot be opened.\n\nThe decode that follows reported a failure to open for both a missing stream and a null bitmap, so\nit now says which of the two happened.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316949\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraActivity.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensCameraActivityTest.kt"], "git_node": "cd50073a3b3db620abacba88e20ad0ae15eae01d", "git_parents": ["820020e865c1147308d2bf9bcf3049c512657455"], "node": "4a3fd238930651fc46faefaee9f13384aad40edb", "parents": ["9e1f346628f9ec50840888a29b7daff1353013d5"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042977 - Implement named-feature() function for @supports. r=firefox-style-system-reviewers,layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320178\n", "files": ["servo/components/style/stylesheets/supports_rule.rs"], "git_node": "fb9ddcc52de9f550f088bb3bced1193658e50657", "git_parents": ["cd50073a3b3db620abacba88e20ad0ae15eae01d"], "node": "5055adebef608e706fdf7a37baf3d83bf8dc8479", "parents": ["4a3fd238930651fc46faefaee9f13384aad40edb"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055354 - Implement named-feature(anchor-position-follows-transforms). r=layout-reviewers,firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320166\n", "files": ["servo/components/style/stylesheets/supports_rule.rs", "testing/web-platform/meta/css/css-conditional/at-supports-named-feature-001.html.ini"], "git_node": "bd921e6cfecef6f4bd4b8f81a85b72326cd31192", "git_parents": ["fb9ddcc52de9f550f088bb3bced1193658e50657"], "node": "4ff71c0592c420065a40354f746cb2e7099370f6", "parents": ["5055adebef608e706fdf7a37baf3d83bf8dc8479"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061005 - added errorPage source value for serp/sap telemetry impressions. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317827\n", "files": ["browser/components/search/BrowserSearchTelemetry.sys.mjs", "browser/components/search/docs/telemetry.md", "browser/components/search/metrics.yaml", "browser/components/search/test/browser/telemetry/browser_search_telemetry_sources_in_content.js"], "git_node": "6cb11d11503e70c3cf2825842c208b1e9f373e66", "git_parents": ["bd921e6cfecef6f4bd4b8f81a85b72326cd31192"], "node": "2899c1e24a57e6e7750b6f1b0c479547e37b514f", "parents": ["4ff71c0592c420065a40354f746cb2e7099370f6"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062852 part 1: Centrally handle accessibility.force_disabled=-1 (force enable) for all platforms. r=eeejay\n\naccessibility.force_disabled=-1 is meant to force enable accessibility, but previously, nothing acted on it centrally.\nGetOrCreateAccService only checked the force disabled case, leaving the force enabled case to platform specific code.\nAside from being hard to reason about, this meant there was different (sometimes broken) behaviour on different platforms.\nWindows was the only platform that proactively started accessibility in nsWindow::Create.\nOn Mac and Linux, the force enabled state allowed accessibility to be enabled where it otherwise wouldn't have been (e.g. no detected client), but it still only activated based on specific platform signals.\nAndroid never read the pref at all.\n\nTo fix this, add a11y::MaybeStartForceEnabled, called once from nsAppRunner.cpp just before the main run loop starts.\nThis only ever runs in the parent process.\nCalling PlatformDisabledState() there unconditionally also ensures the pref-change callback gets registered even when nothing else would have triggered that registration.\n\nThis required an additional fix on Android.\nPreviously, SessionAccessibility::Settings unconditionally shut accessibility down when a session's accessibility was first attached to a view with no assistive technology running.\nWe now prevent that shutdown when force enabled via the pref.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318646\n", "files": ["accessible/android/SessionAccessibility.cpp", "accessible/base/Platform.h", "accessible/base/nsAccessibilityService.cpp", "accessible/moz.build", "accessible/tests/browser/forceEnabled/browser.toml", "accessible/tests/browser/forceEnabled/browser_forceEnabled.js", "toolkit/xre/nsAppRunner.cpp"], "git_node": "db7b3eedf872479510d21ab02ef5f603ab47e785", "git_parents": ["6cb11d11503e70c3cf2825842c208b1e9f373e66"], "node": "24746728bb6bfb38517efbf6738eb341cbbd9d9a", "parents": ["2899c1e24a57e6e7750b6f1b0c479547e37b514f"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062852 part 2: Remove the Windows specific accessibility force enable priming hack. r=eeejay\n\nThis is now redundant.\na11y::MaybeStartForceEnabled, called centrally from nsAppRunner.cpp, covers this on every platform including Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318647\n", "files": ["widget/windows/WinMessages.h", "widget/windows/nsWindow.cpp"], "git_node": "e76da9eb3cfc64edb08e4cb7611ac2dacc57f3f3", "git_parents": ["db7b3eedf872479510d21ab02ef5f603ab47e785"], "node": "5dbd841c776751b04dfac47da88e7c0861972f80", "parents": ["24746728bb6bfb38517efbf6738eb341cbbd9d9a"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062852 part 3: Enable ATK to be reinitialised after it is shut down. r=eeejay\n\natk-bridge caches the AtkObject returned by atk_get_root() exactly once, for the lifetime of its AT-SPI D-Bus connection.\nPreviously, we destroyed and recreated the application root's AtkObject every time accessibility shut down and started up again, leaving atk-bridge's cached pointer stale after the first restart of the accessibility engine.\nThe obvious fix is to call atk_bridge_adaptor_cleanup on shutdown so atk-bridge forgets the stale pointer.\nHowever, this closes and reopens the AT-SPI D-Bus connection.\nThat triggers a lock order inversion inside libdbus: it takes its global bus and bus_datas locks before a connection's own lock when connecting, but a connection's own lock before the bus lock when disconnecting.\nTSAN flagged this as a potential deadlock.\nInstead, keep the application root's AtkObject alive for the life of the process, and only detach and reattach the LocalAccessible it wraps as accessibility shuts down and restarts.\nThis keeps atk-bridge's cached root pointer permanently valid, so we never need to call atk_bridge_adaptor_cleanup, or otherwise touch the D-Bus connection, after the accessibility engine first starts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319726\n", "files": ["accessible/atk/ApplicationAccessibleWrap.cpp", "accessible/atk/ApplicationAccessibleWrap.h"], "git_node": "9bbdbfb27a876dbde28d1df12bdc21e91d47a9e8", "git_parents": ["e76da9eb3cfc64edb08e4cb7611ac2dacc57f3f3"], "node": "c0e18acfdcbedc5abf956c9f9fe8d13694ed9496", "parents": ["5dbd841c776751b04dfac47da88e7c0861972f80"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062852 part 4: Start accessibility when accessibility.force_disabled changes to -1 at runtime. r=eeejay,geckoview-reviewers,m_kato\n\nPrefChanged already force shuts accessibility down when the pref changes to 1.\nHowever, it previously did nothing on a change to -1, so force enabling required a restart.\nGive MaybeStartForceEnabled an async flag and call it from PrefChanged with that mode when the pref changes to force enabled.\nAsync is needed because this callback runs synchronously wherever the pref is set.\nWe don't want accessibility init happening inside arbitrary code.\nThis also updates the comment describing the pref and adds platform specific tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318648\n", "files": ["accessible/base/Platform.h", "accessible/base/nsAccessibilityService.cpp", "accessible/tests/browser/atk/browser.toml", "accessible/tests/browser/atk/browser_forceEnabled.js", "accessible/tests/browser/browser_shutdown_pref.js", "accessible/tests/browser/windows/ia2/browser.toml", "accessible/tests/browser/windows/ia2/browser_forceEnabled.js", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "modules/libpref/init/all.js"], "git_node": "7c14fb003c14793951307e7a27a84f2579ff8395", "git_parents": ["9bbdbfb27a876dbde28d1df12bdc21e91d47a9e8"], "node": "e59e6960ee8548049737549f253e8c87e6de6a5f", "parents": ["c0e18acfdcbedc5abf956c9f9fe8d13694ed9496"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061823 - Add config for two head model r=NeilDeakin,perftest-reviewers,credential-management-reviewers,ai-platform-reviewers,nordzilla,sparky\n\nThe 'two head' model is a newer architecture that we released to Nightly a little over a week ago.\n\nIt seems to be performing ok (though there was a telemetry change that landed the same day that has made it harder to check), but it would be good to have an option to turn it off for a/b/ testing.\n\nAlso adding Nimbus config for engine timeout, keeping the same default. -1 can be set to keep the engine running all the time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317135\n", "files": ["modules/libpref/init/all.js", "testing/perfdocs/generated/mozperftest.md", "toolkit/components/formautofill/shared/FormAutofillML.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_autofill_perf.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "d1744f6b82a720b8647a2887d316a93404d2b05e", "git_parents": ["7c14fb003c14793951307e7a27a84f2579ff8395"], "node": "375c139c91b222985a3eb8126eb3714c93b654c8", "parents": ["e59e6960ee8548049737549f253e8c87e6de6a5f"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2065377. Raise the max-run-time of the vendor verify jobs to 35 minutes. r=taskgraph-reviewers,jcristau\n\nThe sandbox group was seen going over 30 minutes. It has two libraries that vendor from\ngooglesource, which downloads a file at a time, so it is the slowest of the groups by some\nway. Raise the limit in task-defaults so it covers all of them rather than special casing\none.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320334\n", "files": ["taskcluster/kinds/source-test/vendor-verify.yml"], "git_node": "2abf64279c80113f1c6c4d81e8d47a2ee5d70d82", "git_parents": ["d1744f6b82a720b8647a2887d316a93404d2b05e"], "node": "23eee6b412f261faaa581ecc9dc33b2143027648", "parents": ["375c139c91b222985a3eb8126eb3714c93b654c8"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1879900 - Nest design tokens output r=emilio,desktop-theme-reviewers,tabbrowser-reviewers,urlbar-reviewers,dao,jules\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320325\n", "files": ["browser/themes/shared/tabbrowser/tab.tokens.css", "browser/themes/shared/tabbrowser/tabs-navbar.tokens.css", "browser/themes/shared/urlbar/urlbar.tokens.css", "browser/themes/shared/urlbar/urlbarview.tokens.css", "toolkit/content/widgets/moz-badge/moz-badge.tokens.css", "toolkit/content/widgets/moz-box.tokens.css", "toolkit/content/widgets/moz-breadcrumb-group/moz-breadcrumb.tokens.css", "toolkit/content/widgets/moz-input-color/moz-input-color.tokens.css", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.css", "toolkit/content/widgets/moz-page-nav/moz-page-nav.tokens.css", "toolkit/content/widgets/moz-promo/moz-promo.tokens.css", "toolkit/content/widgets/moz-reorderable-list/moz-reorderable-list.tokens.css", "toolkit/content/widgets/moz-segmented-control/moz-segmented-control.tokens.css", "toolkit/content/widgets/moz-select/moz-select.tokens.css", "toolkit/content/widgets/moz-toggle/moz-toggle.tokens.css", "toolkit/content/widgets/moz-visual-picker/moz-visual-picker-item.tokens.css", "toolkit/content/widgets/panel-list/panel-item.tokens.css", "toolkit/content/widgets/panel-list/panel-list.tokens.css", "toolkit/themes/shared/design-system/config/tokens-config.js", "toolkit/themes/shared/design-system/dist/tokens-brand.css", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/docs/README.design-tokens.stories.md"], "git_node": "ca2fa08157b38222054294686f17d15fd38ee157", "git_parents": ["2abf64279c80113f1c6c4d81e8d47a2ee5d70d82"], "node": "f2e6b2fa68f68575f9802ada43ff86c7975f277b", "parents": ["23eee6b412f261faaa581ecc9dc33b2143027648"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056488 - Show disabled quickactions as disabled. r=daisuke,desktop-theme-reviewers,urlbar-reviewers,Jamie\" for causing multiple failures\n\nThis reverts commit 3f18d69dc1a0db011820c71555853e06d53b6f4c.\n", "files": ["browser/components/urlbar/UrlbarProviderActionsSearchMode.sys.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-quickactions/browser_general.js", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "f42e5a45c06f7a79c61dda18f85acecd08826b23", "git_parents": ["ca2fa08157b38222054294686f17d15fd38ee157"], "node": "8abfd170ccc2c9694845ad3e51ef41714eb304ca", "parents": ["f2e6b2fa68f68575f9802ada43ff86c7975f277b"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062896 - Stop exposing the search mode switcher as a combobox wrapping a button. r=Jamie,daleharvey\" for causing mochitests failures in browser_searchbar_new.js.\n\nThis reverts commit 9e286ada72d20f5a25a11ca9e99d9f6dfafd8454.\n\nThis reverts commit 36de50e088f563e77e9cb5de735ea01bc373e9aa.\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser_a11y.js", "toolkit/content/tests/widgets/test_panel_item_mouseup_click.html", "toolkit/content/widgets/moz-select/moz-select.mjs", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "9200f19daa8eac3fc1558f224f9eb0d504d8b1da", "git_parents": ["f42e5a45c06f7a79c61dda18f85acecd08826b23"], "node": "e602f1f577639d7340187fcb0abd78308288166c", "parents": ["8abfd170ccc2c9694845ad3e51ef41714eb304ca"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2063877. Read git output as text in mach vendor's git host. r=tjr\n\nGitHost.upstream_commit hands back what subprocess.check_output gives it, which is bytes,\nwhere the other hosts return str. Those bytes reach moz.yaml, so vendoring a library with\n`source-hosting: git` records a Python bytes repr as its revision:\n\n  revision: b'e75f4eb79165213a02d567940d344f5c2ff1be03'\n\nNothing can resolve that, so the next `mach vendor` run on the manifest stops in\n`git rev-parse` with exit 128. upstream_snapshot called revision.decode() to build the\ntarball path, so the bytes did not break anything else, and only the recorded revision\ncame out wrong.\n\nRead both commands as text and drop the decode, which would fail on a str revision.\n\nmodules/xz-embedded is the only library using this host, and its manifest has the bytes\nrepr in it; a patch in another bug replaces that with the revision this fix writes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318923\n", "files": ["python/mozbuild/mozbuild/vendor/host_git.py"], "git_node": "943a52f1d868423d590651e8b7fbff112d32bd34", "git_parents": ["9200f19daa8eac3fc1558f224f9eb0d504d8b1da"], "node": "d399bbb81e0f89bc1db4d87f06b1523130850af5", "parents": ["e602f1f577639d7340187fcb0abd78308288166c"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2063875. Make third_party/js/cfworker vendor again. r=mossop\n\nVendoring cfworker has not worked since it was set up in bug 1755599, for three reasons,\nall of which are visible only when `./mach vendor` is actually run:\n\nbuild.sh is not executable. moz.yaml runs it as an update-action, and mach vendor execs it\ndirectly, so the run stops with a PermissionError. It has been mode 644 since it landed.\n\n`keep` names json-schema.jsm.patch, while the file in the tree is json-schema.js.patch.\nThere is no `patches:` list here, since build.sh applies the patches itself with the patch\ncommand, so `keep` is the only thing protecting that file and cleaning the vendor directory\ndeletes it. The name has been wrong since it landed too.\n\nThe recorded revision, v1.10.1, is not what is vendored. The release line said\n\"commit @cfworker/dev@1.13.2\", and the committed json-schema.js matches sources from\nthat tag: v1.10.1's dereference.ts passes baseURI.href to new URL() once, where the\n1.13.2 tag does so five times, and the committed bundle has the later form. Point both\nlines at the tag that was really used.\n\nWith all three of the above, plus a fix to let mach npm run in a tree with no objdir (patch in another bug), ./mach vendor third_party/js/cfworker/moz.yaml -r @cfworker/dev@1.13.2 --patch-mode check --force rebuilds json-schema.js through npm, tsc and rollup and reproduces the committed file exactly, so the build is deterministic once it is pointed at the right sources.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318921\n", "files": ["third_party/js/cfworker/build.sh", "third_party/js/cfworker/moz.yaml"], "git_node": "bda35eb738362649ead26fcb149409dcf7f6c6b2", "git_parents": ["943a52f1d868423d590651e8b7fbff112d32bd34"], "node": "24cf7636939a04c1f927d5e00ece9a0e8cf8d303", "parents": ["d399bbb81e0f89bc1db4d87f06b1523130850af5"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2063873. Make dom/webauthn/winwebauthn/moz.yaml reproduce the vendored header. r=keeler\n\nThe moz.yaml records revision 9108981ca80b, a May 2023 upstream commit, but the\nvendored webauthn.h and README.md match c3ed95fd7603 from September 2025, which\nwas the upstream tip when the manifest was added in bug 1995898. The recorded\nrevision does not correspond to any state of this directory, so re-vendoring at\nit replaces the header with a two year old version.\n\nThe include guard in the vendored header is a local change as well. The tree wide\nsweep in bug 2009953 renamed __WEBAUTHN_H_ to WEBAUTHN_H_ here along with 467\nother files, and there was no patch file to carry it, so re-vendoring restores\nthe reserved identifier and undoes that sweep for this one file. Capture it as\ninclude-guard.patch and add a patches list.\n\nBoth are easy to miss, since nothing checked that vendoring reproduced the tree\nuntil now.\n\nWith this, `./mach vendor dom/webauthn/winwebauthn/moz.yaml -r\nc3ed95fd7603441a0253c55c14e79239cb556a9f --patch-mode check --force` reproduces\nthe committed tree exactly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318919\n", "files": ["dom/webauthn/winwebauthn/include-guard.patch", "dom/webauthn/winwebauthn/moz.yaml", "taskcluster/scripts/misc/vendor-verify-expected-fail.yml"], "git_node": "140d1928b533cecc7f138adf1f7ba1020a7d7464", "git_parents": ["bda35eb738362649ead26fcb149409dcf7f6c6b2"], "node": "ef3e47ee82dee4f1f834b89180fe6c75d89abd4e", "parents": ["24cf7636939a04c1f927d5e00ece9a0e8cf8d303"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2058221 - Add Smart Form Fill autocomplete row item to trigger SFF r=desktop-theme-reviewers,credential-management-reviewers,mlucks,fluent-reviewers,flod,kcochrane,dimi,Mardak,mshillabeer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316453\n", "files": ["browser/components/aiwindow/models/SmartFormFillModel.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/assets/sff-autofill-icon.svg", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/SmartFormFillAutocomplete.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_autocomplete.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_metadata_lifecycle.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_autocomplete.js", "browser/components/aiwindow/ui/test/browser/test_smartformfill_autocomplete.html", "browser/extensions/formautofill/test/browser/browser_autocomplete_footer.js", "browser/locales-preview/aiWindow.ftl", "toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/formautofill/FormAutofillChild.sys.mjs", "toolkit/components/formautofill/FormAutofillParent.sys.mjs", "toolkit/components/passwordmgr/LoginAutoComplete.sys.mjs", "toolkit/components/passwordmgr/LoginManagerChild.sys.mjs", "toolkit/components/passwordmgr/LoginManagerParent.sys.mjs", "toolkit/components/passwordmgr/test/unit/test_login_autocomplete_result.js", "toolkit/components/satchel/FillHelpers.sys.mjs", "toolkit/components/satchel/FormHistoryChild.sys.mjs", "toolkit/components/satchel/FormHistoryParent.sys.mjs", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.css", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.mjs", "toolkit/components/satchel/test/browser/browser_autocomplete.js", "toolkit/content/widgets/autocomplete-popup.js"], "git_node": "88e7560519099be5bec92c1ac4abe94711894738", "git_parents": ["140d1928b533cecc7f138adf1f7ba1020a7d7464"], "node": "cb466a6328b245c0ff7a2f4ca56bd310bf125b13", "parents": ["ef3e47ee82dee4f1f834b89180fe6c75d89abd4e"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2063931 - Part 1: Add new color tokens for Acorn design system r=android-reviewers,007\n\nAdded 4 color tokens:\n- Surface Container Selected\n- Success Container\n- On Success Container\n- Sheet Outline\n\nFigma: https://www.figma.com/design/MjufE1X5fvkxZ0YneX4kRd/Android-Library--Nova-?node-id=64745-6578&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319852\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/theme/AcornColorGrid.kt", "mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/theme/AcornColors.kt", "mobile/android/fenix/app/src/main/res/values-night/colors.xml", "mobile/android/fenix/app/src/main/res/values/attrs.xml", "mobile/android/fenix/app/src/main/res/values/colors.xml", "mobile/android/fenix/app/src/main/res/values/styles.xml"], "git_node": "65cda2a532a54e5b991c0dd22831034ff4140538", "git_parents": ["88e7560519099be5bec92c1ac4abe94711894738"], "node": "0bafef8bd4fb0b1355b740b8796d8ba3d273d177", "parents": ["cb466a6328b245c0ff7a2f4ca56bd310bf125b13"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2063931 - Part 2: Update OLED color scheme in AcornColors r=android-reviewers,007\n\n- Updates the OLED color scheme to match the latest Acorn Design System color spec.\n\nFigma: https://www.figma.com/design/MjufE1X5fvkxZ0YneX4kRd/Android-Library--Nova-?node-id=64745-6578&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319853\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/theme/AcornColors.kt"], "git_node": "1603b813060599955ac6cbcf8cc7d9b9c7a5b392", "git_parents": ["65cda2a532a54e5b991c0dd22831034ff4140538"], "node": "0e52a2bb156d2d3e0547b4bd2d0adfd0d0cf665a", "parents": ["0bafef8bd4fb0b1355b740b8796d8ba3d273d177"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2063931 - Part 3: Update Gradient Accent Subtle in AcornGradientScheme r=android-reviewers,007\n\nChanged\n- 1 color token: Gradient Accent Subtle (and stops)\n- 1 primitive alpha color violet-desaturated-90A50 changed to violet-desaturated-90A40\n\nFigma:\nhttps://www.figma.com/design/MjufE1X5fvkxZ0YneX4kRd/Android-Library--Nova-?node-id=64112-20783&m=dev\nhttps://www.figma.com/design/MjufE1X5fvkxZ0YneX4kRd/Android-Library--Nova-?node-id=73969-5133&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319854\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/theme/AcornGradientScheme.kt", "mobile/android/android-components/components/ui/colors/src/main/java/mozilla/components/ui/colors/NovaColorGroups.kt", "mobile/android/android-components/components/ui/colors/src/main/java/mozilla/components/ui/colors/NovaColors.kt", "mobile/android/android-components/components/ui/colors/src/main/res/values/nova_colors.xml"], "git_node": "a1aced42021ef1d2939636d6939a1b5c0fc32a73", "git_parents": ["1603b813060599955ac6cbcf8cc7d9b9c7a5b392"], "node": "0b68feff9ada2afc812b9b46b481e0e57358191c", "parents": ["0e52a2bb156d2d3e0547b4bd2d0adfd0d0cf665a"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 2e39c0c064b99652618fcbf818e868719922ac03\naf -\u003e 2e39c0c064b99652618fcbf818e868719922ac03\nan -\u003e 2e39c0c064b99652618fcbf818e868719922ac03\nar -\u003e 2e39c0c064b996526