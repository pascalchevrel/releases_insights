_private_and_restore.js", "docshell/test/browser/browser_bug2004165.js", "docshell/test/browser/browser_bug2007897.js", "dom/base/test/browser_newtab_session_history.js", "dom/documentpip/tests/browser/browser_sessionstore_ignore_dpip.js", "netwerk/base/nsNetUtil.cpp", "services/sync/tps/extensions/tps/resource/tps.sys.mjs", "testing/talos/talos/startup_test/sessionrestore/addon/api.js", "testing/talos/talos/talos-powers/api.js", "toolkit/components/httpsonlyerror/tests/browser/browser_errorpage.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_restore_session.js", "toolkit/components/thumbnails/test/head.js", "toolkit/content/widgets/browser-custom-element.mjs", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "f8a84cd6151a43f293a27948ac691b618f8de6e5", "git_parents": ["365e156097abf4f249d998677828bd7c1947d1a8"], "node": "6d06b1ada81c23f3f06c9a5099d0d64c42dccfa4", "parents": ["d82174581e6ac877df91d8f35282d7bbd29381c7"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2060205 - Update `webrender-dcomp-disabled` expiration  DONTBUILD r=aryx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319623\n", "files": ["taskcluster/test_configs/variants.yml"], "git_node": "0af30a5f2fda2bcf28d4311dfafbd978a1be67fe", "git_parents": ["f8a84cd6151a43f293a27948ac691b618f8de6e5"], "node": "9f8211634f52bf07873e87f115d49a03459eb2aa", "parents": ["6d06b1ada81c23f3f06c9a5099d0d64c42dccfa4"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2060207 - Update `webrender-dcomp-present` expiration  DONTBUILD r=aryx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319624\n", "files": ["taskcluster/test_configs/variants.yml"], "git_node": "9651ada2b9bf3d973aa8e60d2f9e0c2e626d53da", "git_parents": ["0af30a5f2fda2bcf28d4311dfafbd978a1be67fe"], "node": "f4e4384a7b0f53afc0018db1d9fbc0724edf82fa", "parents": ["9f8211634f52bf07873e87f115d49a03459eb2aa"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2060208 - Update `webrender-dcomp-overlays` expiration  DONTBUILD r=aryx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319625\n", "files": ["taskcluster/test_configs/variants.yml"], "git_node": "b18aaf1333451bc67f590e1392137360a5ef7615", "git_parents": ["9651ada2b9bf3d973aa8e60d2f9e0c2e626d53da"], "node": "d8573669e63869a3e4e68639135c788870bf7607", "parents": ["f4e4384a7b0f53afc0018db1d9fbc0724edf82fa"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2060209 - Update `webrender-dcomp-compositing` expiration  DONTBUILD r=aryx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319626\n", "files": ["taskcluster/test_configs/variants.yml"], "git_node": "9354fdc423d53d4f9def434aa88e1c183ce4d8a6", "git_parents": ["b18aaf1333451bc67f590e1392137360a5ef7615"], "node": "2da7e47b02e56fef4acc10d0ed86e2f777e673b7", "parents": ["d8573669e63869a3e4e68639135c788870bf7607"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047007 - Add Smart Window enabled metrics r=Mardak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319283\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/modules/SmartWindowTelemetry.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_metrics_telemetry.js"], "git_node": "da7239e3174edc9aa88b59ecb12a64482028c2fe", "git_parents": ["9354fdc423d53d4f9def434aa88e1c183ce4d8a6"], "node": "e959380123ef6fee68880de37203eacddddaa14d", "parents": ["2da7e47b02e56fef4acc10d0ed86e2f777e673b7"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062119 - Do not dereference gJarHandler after it has been cleared at shutdown. r=necko-reviewers,valentin\n\nnsJARChannel read the gJarHandler global directly in five places. Since bug\n1412726 that global is a StaticRefPtr cleared by ClearOnShutdown, so it can be\nnull while channels are still alive and opening a channel during late shutdown\ncrashes. The owning reference the channel takes in its constructor kept the\nhandler object alive but stopped protecting the global, and has had no readers\nsince that same bug.\n\nAdd shutdown safe accessors that return null once the singleton is gone, use\nthem for all of those accesses and fail the channel with\nNS_ERROR_ILLEGAL_DURING_SHUTDOWN instead. Drop the unused mJarHandler member.\n\nWhile here, EnsureCached can use the accessor instead of fetching the handler\nthrough the IO service and downcasting the result.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317420\n", "files": ["modules/libjar/nsJARChannel.cpp", "modules/libjar/nsJARChannel.h", "modules/libjar/nsJARProtocolHandler.cpp", "modules/libjar/nsJARProtocolHandler.h"], "git_node": "4ea762f8d52e17c12738d702f5c8db36bbcf22c2", "git_parents": ["da7239e3174edc9aa88b59ecb12a64482028c2fe"], "node": "7879a1e8229d43737a9b400e6e26d7c735dc2733", "parents": ["e959380123ef6fee68880de37203eacddddaa14d"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062119 - Clear the jar protocol handler after the JS module loader is gone. r=necko-reviewers,xpcom-reviewers,valentin,nika\n\nChrome JS module loading reads from omni.ja through jar channels, and\nmozJSModuleLoader::UnloadLoaders() runs after the XPCOMShutdownFinal phase,\nwhich is the default phase for ClearOnShutdown. The handler was therefore\ncleared while chrome JS modules could still be imported, leaving a window in\nwhich those imports and any other late jar access fail.\n\nClear it at CCPostLastCycleCollection instead, which runs after UnloadLoaders().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317421\n", "files": ["modules/libjar/nsJAR.cpp", "modules/libjar/nsJARProtocolHandler.cpp"], "git_node": "894994ff7a160de1a5bc6ad1963f4dfd162b1ee7", "git_parents": ["4ea762f8d52e17c12738d702f5c8db36bbcf22c2"], "node": "9dd5090f6b0cc61073e205ed0c90e93cb9b13af8", "parents": ["7879a1e8229d43737a9b400e6e26d7c735dc2733"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2045415 - Add WPT for decodeAudioData into a much higher context rate r=karlt\n\ndecodeAudioData resamples decoded audio to the destination OfflineAudioContext\nrate. Per the Web Audio spec, a decode whose resampled result is not\nrepresentable as an AudioBuffer must reject with EncodingError rather than\ntruncate.\n\nThe test decodes a spec-valid 683-frame 8 kHz mono FLAC into a 768 kHz context.\nA flac-builder.js helper synthesizes the FLAC in memory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306577\n", "files": ["testing/web-platform/tests/webaudio/resources/flac-builder.js", "testing/web-platform/tests/webaudio/the-audio-api/the-offlineaudiocontext-interface/decodeAudioData-oversized-resample.html"], "git_node": "b8fd183c5b99507b0168969452ecddcfe0658601", "git_parents": ["894994ff7a160de1a5bc6ad1963f4dfd162b1ee7"], "node": "bbf347746d14370c3d34e38af8ef5bd560202fd2", "parents": ["9dd5090f6b0cc61073e205ed0c90e93cb9b13af8"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2044846 - Add per-test Chrome arguments to Raptor. r=perftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318591\n", "files": ["testing/perfdocs/generated/browsertime.md", "testing/raptor/raptor/perfdocs/browsertime.md", "testing/raptor/raptor/perftest.py", "testing/raptor/test/test_raptor.py"], "git_node": "d65b60c4a9f9231885f95bfa9b7fb140750d6674", "git_parents": ["b8fd183c5b99507b0168969452ecddcfe0658601"], "node": "1f47dc615884e15bd28c766883947b7f82a0613c", "parents": ["bbf347746d14370c3d34e38af8ef5bd560202fd2"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2044846 - Enable camera VideoEncoder tests on Chrome and custom-car. r=perftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304620\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/tests/custom/browsertime-webcodecs.toml"], "git_node": "9b9a66c71c0ca5845bb89a1d1cf8a080b4506dc1", "git_parents": ["d65b60c4a9f9231885f95bfa9b7fb140750d6674"], "node": "f88cf2bf63a6e2fc77b7134b98497eed863230d6", "parents": ["1f47dc615884e15bd28c766883947b7f82a0613c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064159 - Drop the indentation-preserving block from Tabbrowser.sys.mjs. r=tabbrowser-reviewers,jsudiaman\n\nNot whitespace-only: two fewer columns let prettier re-join lines that now fit in 80 columns. `git diff -w` isolates those as 49 hunks collapsing 180 lines into 62; the rest is re-indentation that `git blame -w` follows.\n\nThe SHA goes into .git-blame-ignore-revs and .hg-annotate-ignore-revs in a follow-up, since a commit can't carry its own SHA.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319209\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "560af3c0b95a11167742f616efb7e12c8850f08a", "git_parents": ["9b9a66c71c0ca5845bb89a1d1cf8a080b4506dc1"], "node": "ad8a77424e8f54de2a0c7b47f9fc106131597374", "parents": ["f88cf2bf63a6e2fc77b7134b98497eed863230d6"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042790 - Document reasoning for our current string length limit r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316429\n", "files": ["js/src/doc/constraints.md", "js/src/doc/index.md"], "git_node": "6a701ead99fd4d5d3f126d5483f3d1ad60e705cc", "git_parents": ["560af3c0b95a11167742f616efb7e12c8850f08a"], "node": "13512f384be5a1a3bed58808aa01a8b271bba3a4", "parents": ["ad8a77424e8f54de2a0c7b47f9fc106131597374"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/fenix/app/src/main/res/values-cak/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-ka/strings.xml"], "git_node": "418082a36939a7a6910625c4fed9ec758bf8511c", "git_parents": ["6a701ead99fd4d5d3f126d5483f3d1ad60e705cc"], "node": "3f7f9ad131684fc29c1bb9039e94d4eb25e22d46", "parents": ["13512f384be5a1a3bed58808aa01a8b271bba3a4"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044846 - Enable camera VideoEncoder tests on Chrome and custom-car. r=perftest-reviewers,sparky\" for causing lint failures.\n\nThis reverts commit 9b9a66c71c0ca5845bb89a1d1cf8a080b4506dc1.\n\nRevert \"Bug 2044846 - Add per-test Chrome arguments to Raptor. r=perftest-reviewers,sparky\"\n\nThis reverts commit d65b60c4a9f9231885f95bfa9b7fb140750d6674.\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/browsertime.md", "testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/perfdocs/browsertime.md", "testing/raptor/raptor/perftest.py", "testing/raptor/raptor/tests/custom/browsertime-webcodecs.toml", "testing/raptor/test/test_raptor.py"], "git_node": "4dceb649e0c561376344c6c91063c07fc81c881a", "git_parents": ["418082a36939a7a6910625c4fed9ec758bf8511c"], "node": "93db0f6b3c50b229055a0d44876aa59f7bfeb3b2", "parents": ["3f7f9ad131684fc29c1bb9039e94d4eb25e22d46"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2061556 - part 1: Improve logging code in `IMEStateManager` r=m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318382\n", "files": ["dom/events/IMEStateManager.cpp", "widget/IMEData.h"], "git_node": "093c49de7114378cf9692ea410b7ea489fb96f34", "git_parents": ["4dceb649e0c561376344c6c91063c07fc81c881a"], "node": "6ad1d1923bc174f08816196d7681b5a283a2d3e1", "parents": ["93db0f6b3c50b229055a0d44876aa59f7bfeb3b2"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2061556 - part 2: Make `IMEStateManager::OnChangeFocusInternal()` do nothing if requesting commit composition causes another focus change r=m_kato\n\nWhile requesting to commit composition at a focus change, another focus\nmove may occur. Then, `OnChangeFocusInternal()` should keep handling the\nold focus move anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318383\n", "files": ["dom/events/IMEStateManager.cpp", "dom/events/IMEStateManager.h", "widget/tests/browser/browser.toml", "widget/tests/browser/browser_test_ime_focus_after_synthesize_composition_caused_moving_focus.js", "widget/tests/file_ime_state_test_helper.js"], "git_node": "9a16d1eeb096da1cf452c02d678667e1ec43e35d", "git_parents": ["093c49de7114378cf9692ea410b7ea489fb96f34"], "node": "097822daabcbc1ba42b516a22192d0ea23709614", "parents": ["6ad1d1923bc174f08816196d7681b5a283a2d3e1"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2061556 - part 3: Make `nsFocusManager` stop handling a focus move if calling `IMEStateManager::OnChangeFocus` causes another focus move r=ltenenbaum\n\nA call of `IMEStateManager::OnChangeFocus` may cause committing\nactive composition. Therefore, composition events, `beforeinput` and\n`input` events will be fired and another focus move may occur.\nThen, the nested focus handling should've set all things before\n`IMEStateManager::OnChangeFocus` returns. So, `nsFocusManager` should\nhave nothing to do anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318384\n", "files": ["dom/base/nsFocusManager.cpp", "dom/base/test/mochitest.toml", "dom/base/test/test_focus_move_during_composition.html"], "git_node": "baf83444b45e6bc47e03a5b4871095a20b080692", "git_parents": ["9a16d1eeb096da1cf452c02d678667e1ec43e35d"], "node": "864e16109dcb3b6d0011128db4d311ea74f1d1b4", "parents": ["097822daabcbc1ba42b516a22192d0ea23709614"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062482 - Add a Markets/Watchlist list dropdown to the Stocks widget r=fluent-reviewers,bolsson,reemhamz\n\nReplace the static \"Stocks\" title with a dropdown so people can switch the\nwidget between two lists:\n\n- Markets (default): the set of stocks shown today.\n- Watchlist: the user's own picks. It stays empty for now, until a later bug\n  lets people add tickers to it.\n\nThe dropdown shows the current list's name and marks the selected list with a\ncheckmark. Screen readers still announce the widget as \"Stocks\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318602\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/_Stocks.scss", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "0d154b68efff255e55aa8a47932d8b0619ac6a78", "git_parents": ["baf83444b45e6bc47e03a5b4871095a20b080692"], "node": "1fb41258b90c0fc6ea1460d886c269a2902ff1a8", "parents": ["864e16109dcb3b6d0011128db4d311ea74f1d1b4"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062845 - Add Stocks strings for watchlist and ticker search r=fluent-reviewers,bolsson,reemhamz\n\nAdd the Fluent strings for the Stocks widget's watchlist add and remove controls:\nthe add and remove button labels, an \"in your watchlist\" indicator for stocks that\nare already saved, and screen-reader confirmations for adding and removing. Add\nstrings for ticker search.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318603\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "1646c314824cc7aaf95a76dd1bf6a16d5dfe7ad0", "git_parents": ["0d154b68efff255e55aa8a47932d8b0619ac6a78"], "node": "73467a411c2f840e137ed918cb6b12490d2c355a", "parents": ["1fb41258b90c0fc6ea1460d886c269a2902ff1a8"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062483 - Add watchlist add/remove to the Stocks widget r=reemhamz\n\nAt the Large size, the Stocks widget now lets people build a Watchlist. Adding a\nticker from the Markets list saves it and briefly shows a confirmation checkmark;\nthe Watchlist tab then lists the saved tickers, each with its own remove control.\nWhen the user already has a watchlist, the widget opens on that tab. Every add and\nremove is announced to screen readers and recorded in telemetry, and the list is\nstored in a new comma-separated pref.\n\nThis also removes a pre-existing duplicate widgets.stocks.size pref entry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318604\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Stocks/StockTicker.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/StocksWatchlist.mjs", "browser/extensions/newtab/content-src/components/Widgets/Stocks/_Stocks.scss", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/StockTicker.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/StocksWatchlist.test.jsx"], "git_node": "16a6da2e9deb06dc2ed66750a778cec4403af797", "git_parents": ["1646c314824cc7aaf95a76dd1bf6a16d5dfe7ad0"], "node": "fce3ec871e44ec8e1678ac1e5a72b985795a52ef", "parents": ["73467a411c2f840e137ed918cb6b12490d2c355a"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062920 - Add a small size to the Stocks widget r=reemhamz\n\nAdds a small size that shows a single ticker: the first saved watchlist\nsymbol, or the first ticker from the default feed when the watchlist is\nempty. The tile shows the ticker's indicator, change, and price with the\nsymbol as the heading, and covers the loading and error states.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318605\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Stocks/StockTicker.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/_Stocks.scss", "browser/extensions/newtab/test/jest/content-src/components/Widgets/StockTicker.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx"], "git_node": "ed2314f3debec685f10fef9bde6b448389a34bf2", "git_parents": ["16a6da2e9deb06dc2ed66750a778cec4403af797"], "node": "12ddf046b0f6e6b42f6417eb562fa7c1a0e5398d", "parents": ["fce3ec871e44ec8e1678ac1e5a72b985795a52ef"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063144 - Stocks Widget: update feed to fetch data for individual stock tickers r=reemhamz\n\nThe Stocks feed only fetched the default ETF set, so a watchlist symbol\noutside that set was written to the pref but never rendered. The feed now\nlooks up individual saved symbols and keeps them as a separate watchlist\ndataset, fetched on init, when widgets.stocks.watchlist changes, and when the\ncached data goes stale. The widget merges that dataset with the default\nsnapshot so saved symbols render and persist. Prerequisite for ticker search.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318606\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/common/StocksWatchlist.mjs", "browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/StocksWatchlist.mjs", "browser/extensions/newtab/lib/Widgets/StocksFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/StocksWatchlist.test.jsx", "browser/extensions/newtab/test/xpcshell/test_StocksFeed.js"], "git_node": "41c6817cbcba93b332aef75a64ac431286680705", "git_parents": ["ed2314f3debec685f10fef9bde6b448389a34bf2"], "node": "b4dbf080b4e1c47a8a4140eb06c051fedacaeac5", "parents": ["12ddf046b0f6e6b42f6417eb562fa7c1a0e5398d"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063183 - Part 1: Stocks Widget ticker search feed and state r=reemhamz\n\nAdd the feed and state plumbing for Stocks ticker search. StocksFeed gains a\nsearch path that looks up a query through Merino on a per-search client and\nreturns the matching tickers to only the tab that asked, with per-tab,\ncontent-only Redux state that tracks the active request. No user-facing UI in\nthis patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318607\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/lib/Widgets/StocksFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx", "browser/extensions/newtab/test/xpcshell/test_StocksFeed.js"], "git_node": "2c425a325cfb5096bda5d4da37d6bfd22d2dbd0a", "git_parents": ["41c6817cbcba93b332aef75a64ac431286680705"], "node": "c2a1018da376c0b9b9c692abe4a83236ff45abf3", "parents": ["b4dbf080b4e1c47a8a4140eb06c051fedacaeac5"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063183 - Part 2: Stocks Widget ticker search UI r=reemhamz\n\nAdd the search panel and wire it into the Stocks widget: search for a\nticker, see the results, and add one to the watchlist. Also cap the\nwatchlist at 10 and make it scroll.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318608\n", "files": ["browser/extensions/newtab/common/StocksWatchlist.mjs", "browser/extensions/newtab/content-src/components/Widgets/Stocks/StockSearch.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/StockTicker.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/_Stocks.scss", "browser/extensions/newtab/content-src/components/Widgets/Stocks/useStockSearch.jsx", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/test/jest/content-src/components/Widgets/StockSearch.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/StockTicker.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/StocksWatchlist.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/useStockSearch.test.jsx"], "git_node": "be5817f698542416ece08d480ec4f635d7c1d8ea", "git_parents": ["2c425a325cfb5096bda5d4da37d6bfd22d2dbd0a"], "node": "7eca779ee37ed901a0a5e165ebb050d57de15c18", "parents": ["c2a1018da376c0b9b9c692abe4a83236ff45abf3"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063289 - Stocks Widget: add Watchlist tab to the Medium size r=reemhamz\n\nAdd the dropdown to the Medium widget, matching Large: it shows when the\nwatchlist is non-empty and defaults to Watchlist, so the selected list\npersists across sizes. The Medium Watchlist shows the first four saved\ntickers in a view-only grid.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318609\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx"], "git_node": "12759fe5a289ae960ac873b4131a3542f3de8177", "git_parents": ["be5817f698542416ece08d480ec4f635d7c1d8ea"], "node": "f9e1ece18bd017cb7b63155c4f1df4bc62458777", "parents": ["7eca779ee37ed901a0a5e165ebb050d57de15c18"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064483 - Update Spotless to version 8.10.0. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319589\n", "files": ["gradle/libs.versions.toml"], "git_node": "5bbb3d01d376ac26db48d1b549209780b2bed3f3", "git_parents": ["12759fe5a289ae960ac873b4131a3542f3de8177"], "node": "2ab0b8109fb0ac15538f90051626b9f0580f1094", "parents": ["f9e1ece18bd017cb7b63155c4f1df4bc62458777"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064446 - Update intellij-markdown to version 0.7.9. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319571\n", "files": ["gradle/libs.versions.toml"], "git_node": "060a663bb68bf739b68e539a7815fb9ec60c65d2", "git_parents": ["5bbb3d01d376ac26db48d1b549209780b2bed3f3"], "node": "d219895ee1bf60c95e9a180d3b6a1fed76c5e2ad", "parents": ["2ab0b8109fb0ac15538f90051626b9f0580f1094"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064454 - Clean up dom/media/tools/generateGmpJson.py and make it support Linux aarch64. r=media-playback-reviewers,azebrowski\n\nIt also removes support for the old way of updating Widevine plugins\nas we have not shipped that in years (and Google stopped updating\nthe servers.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319570\n", "files": ["dom/media/tools/generateGmpJson.py"], "git_node": "68aef17bf11944441c4860c91639b3cf901e915f", "git_parents": ["060a663bb68bf739b68e539a7815fb9ec60c65d2"], "node": "97f281b64e24d50cf268d5aaa36d8698dfd46d0e", "parents": ["d219895ee1bf60c95e9a180d3b6a1fed76c5e2ad"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064276 - Parse the input's markup with DOMParser. r=mbeier,urlbar-reviewers\n\n`parseXULToFragment` is chrome-only, as a content document can hold no XUL elements at all. So both realms parse with `DOMParser`, the markup naming the XHTML namespace by default and its one XUL element with a `xul:` prefix, which content resolves to XHTML.\n\nDropping the `html:` prefixes breaks whatever matched a qualified name, hence the fixes alongside. The fragment also keeps the markup's whitespace text nodes, which `parseXULToFragment` stripped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319331\n", "files": ["browser/base/content/browser-toolbarKeyNav.js", "browser/components/extensions/test/browser/browser_ext_tabs_create_url.js", "browser/components/urlbar/content/UrlbarInputBase.mjs", "toolkit/content/editMenuOverlay.js"], "git_node": "fcee5de428a020254b167e92a84e4e85932ab130", "git_parents": ["68aef17bf11944441c4860c91639b3cf901e915f"], "node": "37e5d2ab84cf42fae44523028a4cf7c232f4c678", "parents": ["97f281b64e24d50cf268d5aaa36d8698dfd46d0e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064277 - Clone parent-sent payloads into the content realm. r=mbeier\n\nThe port's returns are already cloned; the parent's dispatches into the child controller weren't, so a content-realm input saw an Xray over an object in this realm and was denied even `Symbol.iterator` -- iterating the engine-store snapshot threw.\n\n`Notify` has the same gap and isn't fixed here: it carries a `UrlbarQueryContext` that `fromWire` builds in this realm, and cloning would flatten it. Content has the class, so deserializing there is likely the answer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319332\n", "files": ["browser/actors/UrlbarChild.sys.mjs"], "git_node": "56467e58ed367be5f21b138eb564f3e1804c26d8", "git_parents": ["fcee5de428a020254b167e92a84e4e85932ab130"], "node": "7887a6c59181236edfa969d3dc87f6b831bed809", "parents": ["37e5d2ab84cf42fae44523028a4cf7c232f4c678"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064277 - Build the query context in the realm that reads it. r=mbeier,urlbar-reviewers\n\nThe remaining half of the previous patch, and the one a clone can't fix: the actor deserialized the wire form into a `UrlbarQueryContext` in its own realm, so a content-realm view got an Xray over it. That reads every property as `undefined` rather than throwing, so a query produced no rows and no error.\n\nThe wire form is plain data, so it crosses as one and the child controller builds the context from it, in an entry point of its own so that `notify` takes a real context whichever path delivered it. That has to happen before `notify` inspects `id` to drop the results of a stale query.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319413\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs"], "git_node": "e7e50f5e61bad7ee664a371954c9893b7e1d292a", "git_parents": ["56467e58ed367be5f21b138eb564f3e1804c26d8"], "node": "430c093b2bea354db5e607460d04ef26b86c2706", "parents": ["7887a6c59181236edfa969d3dc87f6b831bed809"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064279 - Gate the copy/cut controller on the address bar. r=mbeier,urlbar-reviewers\n\n`_trimValue` returns early unless the input is the address bar, so on the searchbar the controller only reimplements native copy/cut.\n\nThis is what lets a content-realm input work without a realm branch here: the controller needs `controllers` and `editor` on the input plus the clipboard service, all chrome-only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319333\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "aa895826ce3d1c232358408e254d2127727db459", "git_parents": ["e7e50f5e61bad7ee664a371954c9893b7e1d292a"], "node": "bdb2fd01d5f2bace88f6b8248b8026e6df78d002", "parents": ["430c093b2bea354db5e607460d04ef26b86c2706"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064279 - Defer the placeholder update to a tab switch only in the address bar. r=mbeier,urlbar-reviewers\n\nThe update waits for the user to look away, and a tab switch qualifies only for the address bar, which takes its value from the selected tab. Nothing gives the searchbar a value on `TabSelect`, so its listener could only ever fire with the guard already false -- and by then the `input` listener has removed both.\n\nA content-realm input, not being the address bar, is left with the same single cue, which is what this needs to not reach for a tabbrowser it doesn't have.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319334\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "e0baa9504fa5f28c20496dcf8ac642cd49c5c412", "git_parents": ["aa895826ce3d1c232358408e254d2127727db459"], "node": "484b10e80c663d5803a9937914a44b4d2630d990", "parents": ["bdb2fd01d5f2bace88f6b8248b8026e6df78d002"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064185 - Observe the AI window's state only from a chrome window. r=mbeier,urlbar-reviewers\n\n`observe` matches the notification's subject against the input's own window, so a content-realm input could never match it -- and `generateQI` and the observer service are chrome-only, so reaching for them threw before the engine-store observer below could be registered. That one a content realm does need.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319335\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "d7435c3ede7e687f7fbcba938dbebf97968e78b1", "git_parents": ["e0baa9504fa5f28c20496dcf8ac642cd49c5c412"], "node": "25d6d3d69f82ccf5c4cff8507510aad0658381ba", "parents": ["484b10e80c663d5803a9937914a44b4d2630d990"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062987 - Give the content prefs shim getScotchBonnetPref. r=mbeier,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319408\n", "files": ["browser/components/urlbar/content/UrlbarContentPrefs.mjs"], "git_node": "e4fbb3f30c8e6cfee292f757516aa247e533b868", "git_parents": ["d7435c3ede7e687f7fbcba938dbebf97968e78b1"], "node": "87e80f5d560c19f3ebba5dd25966daa02db76836", "parents": ["25d6d3d69f82ccf5c4cff8507510aad0658381ba"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064185 - Read the default user context id without Ci. r=mbeier,urlbar-reviewers\n\n`UrlbarQueryContext`'s constructor normalizes the container id, so this sits on the path of every query -- a content-realm input couldn't run one at all. The value is spelled out beside the private-window sentinel the same file already carries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319409\n", "files": ["browser/components/urlbar/content/UrlbarShared.mjs"], "git_node": "f1b48ae625b036bd642a34e44b13b35cbe714340", "git_parents": ["e4fbb3f30c8e6cfee292f757516aa247e533b868"], "node": "3c753113721b09c4d28b1b9762eb64542078f068", "parents": ["87e80f5d560c19f3ebba5dd25966daa02db76836"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064279 - Gate the search-terms persistence check on the address bar. r=mbeier,urlbar-reviewers\n\nIts state is keyed by the selected tab's browser, which a content-realm input has no way to reach.\n\n`handleEvent` wraps every `_on_*` in a try/catch and reports through `console.error`, so the exception left `_on_input` silently half-done: typing updated the value and started no query, with nothing in the parent-process log.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319410\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "69cdce10fed3779a93074dcc505acdf5d1114e81", "git_parents": ["f1b48ae625b036bd642a34e44b13b35cbe714340"], "node": "6176008fb1e98d76bd17e180aed8d33b9b29b264", "parents": ["3c753113721b09c4d28b1b9762eb64542078f068"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062209 - Scope the Urlbar actor to about:newtab and about:home. r=mconley,mbeier\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318748\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/components/DesktopActorRegistry.sys.mjs"], "git_node": "e00a96bdf858dcb6fc29e585ef2f4f7fa72be048", "git_parents": ["69cdce10fed3779a93074dcc505acdf5d1114e81"], "node": "39f8c66f261a7c0a14adfffeca3fb798fc7887bb", "parents": ["6176008fb1e98d76bd17e180aed8d33b9b29b264"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2059333. Use explicit reinterprets in the NEON swizzle specializations so they build with GCC. r=aosmond,lsalzman,gfx-reviewers\n\nBug 2052246 converted the NEON swizzle specializations to take and return\nxsimd::batch\u003cT, Arch\u003e but kept the bodies of the old hand written intrinsics,\nwhich mix vreinterpretq suffixes that no longer match the element type of the\nbatch they are given. On NEON each batch has exactly one register type, so\nbatch\u003cuint8_t, Arch\u003e is uint8x16_t, batch\u003cuint16_t, Arch\u003e is uint16x8_t and\nbatch\u003cuint32_t, Arch\u003e is uint32x4_t. clang enables lax vector conversions by\ndefault and silently bitcasts between same width integer vector types, so the\nmismatches compiled anyway. GCC has no such conversion and rejects all of them.\nThis cannot happen on x86 because every integer batch there maps to the same\n__m128i or __m256i, so a mismatched suffix is never a type error, and it did not\nshow up in CI because we build with clang on every platform.\n\nAdd the reinterprets needed to get to and from the register type each batch\nactually has. They are all bitcasts, so the generated code is identical.\n\nSwizzleVector_SIMD is constrained to xsimd::neon and so is only instantiated on\n32 bit ARM, which is why the aarch64 build did not report it. It has the same\nproblem, plus a conditional operator whose two arms end up as uint16x8_t and\nuint8x16_t, so fix it here too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317694\n", "files": ["gfx/2d/SwizzleNEON.h"], "git_node": "cd626924710ef8b882a7d70a8c3719c2917255cd", "git_parents": ["e00a96bdf858dcb6fc29e585ef2f4f7fa72be048"], "node": "76c3b27f046f04aaeb6697d465a26075f7a0093b", "parents": ["39f8c66f261a7c0a14adfffeca3fb798fc7887bb"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2061106. Give arm a SwapRB8_SIMD specialization instead of a SwizzleVector_SIMD one, so GCC can resolve it. r=aosmond,lsalzman,gfx-reviewers\n\nSwizzleVector_SIMD has an unconstrained generic definition in SwizzleGeneric.h\nand, until now, an overload in SwizzleNEON.h constrained to xsimd::neon.\nProcessRow_SIMD and Process_SIMD take the op as a deduced non type template\nparameter, so naming SwizzleVector_SIMD there forms the address of an overload\nset. With xsimd::neon64 the constraint is not satisfied and only the generic\ncandidate is left, but on 32 bit ARM both are viable. C++20 says the more\nconstrained candidate wins, and clang implements that, but GCC does not here and\ncalls the conversion ambiguous, so 32 bit ARM does not build. GCC 15 still\nbehaves this way.\n\nThe specialization is at the wrong level though. The reason arm wants it is that\nthere is no xsimd::swizzle vectorization, and xsimd::shuffle is used by\nSwapRB8_SIMD, not by SwizzleVector_SIMD. SSE2 already handles the same problem\nthe same way: it has no pshufb, so it specializes SwapRB8_SIMD and leaves\nSwizzleVector_SIMD alone.\n\nSpecialize SwapRB8_SIMD for xsimd::neon with the swap taken out of the old\nSwizzleVector_SIMD, and drop the SwizzleVector_SIMD specialization. SwapRB8_SIMD\nis only ever called, never named as a template argument, so GCC resolves it with\nordinary overload resolution, which it does implement. SwizzleGeneric.h does not\nneed to change at all.\n\nThe generated code is equivalent. On aarch64 it is identical. On armv7 the opcode\nhistogram is the same except that some of the selects come out as vbif or vbit\nrather than vbsl, 30 selects and 1592 instructions either way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317695\n", "files": ["gfx/2d/SwizzleNEON.h"], "git_node": "345ae1a275ae5fdf72095879d21b8a1e8a329947", "git_parents": ["cd626924710ef8b882a7d70a8c3719c2917255cd"], "node": "55531d2b8789df08bc3273ab0e6378d1f80e0652", "parents": ["76c3b27f046f04aaeb6697d465a26075f7a0093b"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2064316 - Rasterize a scaled bitmap-strike glyph at its final size r=gfx-reviewers,lsalzman\n\nBug 2061411 routes a bitmap-strike run under a transform to the local-raster\nfallback, which rasterized at scale 1.0 and left the shader to scale the image up.\nCore Text and DirectWrite resample the strike at rasterization time, so a scaled\nemoji lost its detail before the GPU saw it. Take the raster scale from the\ntransform instead. Screen raster space only: a local raster space carries its own.\n\nThe reference moves to local(3.0), with a notref at local(1.0) pinning the soft\nrendering. Both bitmap tests drop to scale 1.0, since wrench emulates a device\npixel scale with a root scale transform that a reference cannot name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319648\n", "files": ["gfx/wr/webrender/src/prim_store/text_run.rs", "gfx/wr/wrench/reftests/text/2061411-bitmap-scale-notref.yaml", "gfx/wr/wrench/reftests/text/2061411-bitmap-scale-ref.yaml", "gfx/wr/wrench/reftests/text/2061411-bitmap-scale.yaml", "gfx/wr/wrench/reftests/text/reftest.list"], "git_node": "9ac8b3931eb863aa0148846af82d402780e0eb78", "git_parents": ["345ae1a275ae5fdf72095879d21b8a1e8a329947"], "node": "7d21eb4ff7715a2a599e54a7d388af2bbbadfebf", "parents": ["55531d2b8789df08bc3273ab0e6378d1f80e0652"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063750: Add a signal to the pageload domain event whether a client is active. r=acreskey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318865\n", "files": ["dom/base/test/browser_page_load_event_telemetry.js", "dom/ipc/ContentParent.cpp", "dom/metrics.yaml", "tools/performance/PageloadEvent.cpp", "tools/performance/PageloadEvent.h"], "git_node": "b777c7aaae9f6da83e8d0e77bdee0697f0a05180", "git_parents": ["9ac8b3931eb863aa0148846af82d402780e0eb78"], "node": "65ab512b32dd798ca192bb90e59d0571f107b54d", "parents": ["7d21eb4ff7715a2a599e54a7d388af2bbbadfebf"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2031524 - Add WPT for VideoFrame.copyTo opaque/alpha format conversion r=media-playback-reviewers,padenot\" for causing android webcodecs failures on videoFrame-copyTo-opaque-swizzle.https.any.html.\n\nThis reverts commit 2a83e4d921f4f0e40309e0f98553a9aa3bffa59c.\n", "files": ["testing/web-platform/tests/webcodecs/videoFrame-copyTo-opaque-swizzle.https.any.js"], "git_node": "16b0062e4db7a6b6acfa655359752156d2cb0e8b", "git_parents": ["b777c7aaae9f6da83e8d0e77bdee0697f0a05180"], "node": "dd1dfb026f61df66449f313f000701f8a67b3b8e", "parents": ["65ab512b32dd798ca192bb90e59d0571f107b54d"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061009 - Set default browser triggers two prompts on macOS 27 r!#mac-reviewers r=mac-reviewers,mstange\n\nUse -[NSWorkspace setDefaultApplicationAtURL:toOpenURLsWithScheme:] instead of\nLSSetDefaultHandlerForURLScheme() and LSSetDefaultRoleHandlerForContentType() to\nset the default browser on macOS 27+. We already use NSWorkspace this way to set\nthe default PDF handler.\n\nOn macOS 27 Beta, with LSSetDefaultHandlerForURLScheme() and\nLSSetDefaultRoleHandlerForContentType(), each call generates a confirmation\nprompt resulting in multiple prompts when the \"Make default\" button is pressed.\n\nThe NSWorkspace API is available on macOS 12+, but limit it to macOS 27+ for now\nto be conservative.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317309\n", "files": ["browser/components/shell/nsMacShellService.mm"], "git_node": "66c171bcd537725e908812c1a46ebbcf02f6d39a", "git_parents": ["16b0062e4db7a6b6acfa655359752156d2cb0e8b"], "node": "d14a8d8cf86dfacc721dc897277ac28bc4940dbb", "parents": ["dd1dfb026f61df66449f313f000701f8a67b3b8e"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062782 - Report ::-webkit-scrollbar as unsupported in @supports conditions. r#firefox-style-system-reviewers r=firefox-style-system-reviewers,layout-reviewers,emilio\n\nSites use `selector(::-webkit-scrollbar)` as a check for the whole family of\nWebKit scrollbar pseudo-elements, and guard their non-WebKit styles behind the\nnegation of it. We only implement `::-webkit-scrollbar` itself, so a site that\ntakes the WebKit branch on our answer ends up with styles we only partly apply,\nwhich is worse than the non-WebKit branch it would otherwise have taken.\n\nSo report it as unsupported while parsing a @supports condition, like the\n`-webkit-*` pseudo-elements we don't recognize at all. The answer no longer\ndepends on the enabled-domains allowlist, so the allowlist reftests now probe\nthe pseudo-element through the scrollbar it hides rather than through @supports.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318655\n", "files": ["layout/reftests/scrolling/reftest.list", "layout/reftests/scrolling/webkit-scrollbar-allowlist-subdomain-ref.html", "layout/reftests/scrolling/webkit-scrollbar-allowlist-subdomain.html", "layout/reftests/scrolling/webkit-scrollbar-in-at-supports.html", "layout/reftests/scrolling/webkit-scrollbar-in-css-supports.html", "servo/components/style/gecko/pseudo_element.rs", "servo/components/style/gecko/selector_parser.rs", "servo/ports/geckolib/glue.rs"], "git_node": "1d3daf987cd8d0137e63eaad6019db2219f03e85", "git_parents": ["66c171bcd537725e908812c1a46ebbcf02f6d39a"], "node": "5a21bd152daebe0245afa1a6450fe45d97405df3", "parents": ["d14a8d8cf86dfacc721dc897277ac28bc4940dbb"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041758 - Fix trivial string indexing bug in Linux sandbox policy construction. r=Thinker,sandbox-reviewers\n\nThis appears to be benign \u2014 the code works as expected and isn't\ninvoking undefined behavior in the language standard \u2014 but it can\ncause false positives in testing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317181\n", "files": ["security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp"], "git_node": "64ad87568a194bdd370b570330e18f34cf68028c", "git_parents": ["1d3daf987cd8d0137e63eaad6019db2219f03e85"], "node": "82305df7ac37046987851e8f835e86f17fc6624f", "parents": ["5a21bd152daebe0245afa1a6450fe45d97405df3"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061863 - Strengthen assertion in nsTStringRepr::CharAt. r=nika\n\nThis makes dependent substrings consistent with nsTString and its\nsubclasses.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317182\n", "files": ["xpcom/string/nsTStringRepr.h"], "git_node": "5b377b9539a9d0601b9fd45137d9ebdb5cf225ce", "git_parents": ["64ad87568a194bdd370b570330e18f34cf68028c"], "node": "02aca7f46a7e0e139e3c0002e9613d4eed6b1582", "parents": ["82305df7ac37046987851e8f835e86f17fc6624f"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064022 - Fix openCustomTabInFirefoxTest efficiency UI test r=jajohnson\n\nThe UI test was sometimes flaky because after tapping \u201cOpen in Firefox,\u201d Android takes about a second to switch from the custom-tab screen to the full browser, but the test checked \u201cam I on the browser yet?\u201d only once with no waiting \u2014 so if that single glance landed mid-switch, it failed and the test crashed with \u201cno navigation path found.\u201d\n\nI added a route from the custom tab to the browser, which makes the framework re-check for up to 10 seconds instead of glancing once.\n\nThe UI test successfully passed 50x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDi