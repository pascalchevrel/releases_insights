adf17c24296e60"], "node": "218de5c58b4166bf48345d6358ed5ae9ca7979b3", "parents": ["3354a570778e7e2384f6e9748975887275e217da"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047435 - XPCOM file unit tests: make sure the global flag to test prefixed or unprefixed paths on Windows is correctly reset at the end of each test. r=xpcom-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320855\n", "files": ["xpcom/tests/gtest/TestFile.cpp"], "git_node": "df75baabd477f08279aff9a776d7e9e47517f714", "git_parents": ["50be55ab083514487be4254d568974c3a08c92c2"], "node": "f7af5503da66bb7cacfd196e289016ee7d8e48c8", "parents": ["218de5c58b4166bf48345d6358ed5ae9ca7979b3"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047435 - XPCOM: add copy file tests r=xpcom-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306645\n", "files": ["xpcom/tests/gtest/TestFile.cpp", "xpcom/tests/gtest/moz.build"], "git_node": "7eaa22aaf879109eaa3e098313adf78eb7b90c50", "git_parents": ["df75baabd477f08279aff9a776d7e9e47517f714"], "node": "ff7f728ecc06198b370ff9162617045a13cd793d", "parents": ["f7af5503da66bb7cacfd196e289016ee7d8e48c8"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047435 - XPCOM: use fast native functions for file copies on macOS and Linux r=xpcom-reviewers,jld,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306646\n", "files": ["xpcom/io/nsLocalFileUnix.cpp"], "git_node": "dc5a2b801440896c6d9b56e784a57f1bac80b828", "git_parents": ["7eaa22aaf879109eaa3e098313adf78eb7b90c50"], "node": "40b9be3d4f46375aed9fac72437929edc0cf33fa", "parents": ["ff7f728ecc06198b370ff9162617045a13cd793d"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060248 - FRO Template Updates for Terms of Service r=omc-reviewers,emcminn\" for causing bc failures @ browser_all_files_referenced.js\n\nThis reverts commit a4bbcd8ba2e4c77bd7f54c2cf93de13810981038.\n", "files": ["browser/components/aboutwelcome/assets/kit-sit-look-up.svg", "browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aboutwelcome/jar.mn", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_configurable_ui.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_multiselect.js", "browser/components/asrouter/content-src/components/LinkParagraph.jsx", "browser/components/asrouter/content-src/components/MultiSelect.jsx", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/docs/feature-callout.md", "browser/components/asrouter/tests/unit/content-src/components/LinkParagraph.test.jsx", "browser/components/asrouter/tests/unit/content-src/components/MultiSelect.test.jsx"], "git_node": "5eed9cae3b7116b5fcda2724faf9546b171453c7", "git_parents": ["dc5a2b801440896c6d9b56e784a57f1bac80b828"], "node": "75cdb5f71d5ae024cb97153901dad517214febef", "parents": ["40b9be3d4f46375aed9fac72437929edc0cf33fa"], "tags": []}, {"author": "Tzu-An Liu \u003ctliu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052362 - Smart Window perf: add missing ChatSql indexes and fix the correlated history subquery r=bjohns,ai-security-reviewers,omarg\n\nmessage.parent_message_id and message.revision_root_message_id are ON DELETE\nCASCADE with no covering index, so SQLite scanned all of `message` twice per\ncascaded row. In a synthetic 24k-message store, deleting 12k messages took\n29.8s; with partial indexes on both columns it takes 0.23s. Neither column is\nread by any SELECT, so the indexes are partial on IS NOT NULL to keep insert\ncost down.\n\nAlso adds (role, created_date) so MESSAGES_BY_DATE_AND_ROLE seeks instead of\nscanning the date window and filtering role per row, and drops the standalone\nmessage_ordinal_idx: ordinal is only ordered by within a single conversation,\nwhich conv_id already narrows, so the planner never chose it. Query plans for\nevery message query are unchanged by the drop.\n\nVerified each change with EXPLAIN QUERY PLAN. Schema version 12.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319653\n", "files": ["browser/components/aiwindow/ui/modules/AIWindowConstants.sys.mjs", "browser/components/aiwindow/ui/modules/ChatMigrations.sys.mjs", "browser/components/aiwindow/ui/modules/ChatSql.sys.mjs", "browser/components/aiwindow/ui/modules/ChatStore.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_ChatStore.js"], "git_node": "61677f316467dcae8e1c2b4a9a1ee8943e9b9981", "git_parents": ["5eed9cae3b7116b5fcda2724faf9546b171453c7"], "node": "53c52f8c20d84b994aa2ad81b4e84c9c0240fa3c", "parents": ["75cdb5f71d5ae024cb97153901dad517214febef"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064772 - Ignore panel-list.show() while the list is open. r=desktop-theme-reviewers,tgiles\n\nSetting `open` on an already-open list fires no attributeChangedCallback, so a re-show never reaches onShow() or setAlign(). Nothing can depend on show() to re-anchor an open list: `SmartbarInputUtils.updatePanel()` re-shows on every keystroke, and it re-anchors through its own `#reposition()`, which reads its own anchor element rather than `lastAnchorNode`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319881\n", "files": ["toolkit/content/tests/widgets/test_panel_list_accessibility.html", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "3f6e89a10fc6b872967bc4819a8a7b7bbfdffe7d", "git_parents": ["61677f316467dcae8e1c2b4a9a1ee8943e9b9981"], "node": "744b6a05fbd84142533be171906b5cf50807d289", "parents": ["53c52f8c20d84b994aa2ad81b4e84c9c0240fa3c"], "tags": []}, {"author": "Sameem-baba \u003cssssameembaba@gmail.com\u003e", "branch": "default", "desc": "Bug 1969880 - Clean up WebDriver BiDi user context state when deleted externally. r=Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318884\n", "files": ["remote/shared/UserContextManager.sys.mjs", "remote/shared/test/browser/browser_UserContextManager.js", "remote/webdriver-bidi/modules/root/browser.sys.mjs"], "git_node": "e161351146516e9733122c7dc7bd9cd178e41400", "git_parents": ["3f6e89a10fc6b872967bc4819a8a7b7bbfdffe7d"], "node": "27c805352a6cffa3c142585ae0ab5ec4bc255df0", "parents": ["744b6a05fbd84142533be171906b5cf50807d289"], "tags": []}, {"author": "Cornelius Emase \u003ccorneliuslochipi@gmail.com\u003e", "branch": "default", "desc": "Bug 2062293 - Update Promise.try to use PromiseResolve for non-error case. r=dminor\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317830\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "0163c4f32f426435f3370da1e17f42d4a8f16cbf", "git_parents": ["e161351146516e9733122c7dc7bd9cd178e41400"], "node": "da54bd5fbd31fedcc1587adc1a97f24f799d55ab", "parents": ["27c805352a6cffa3c142585ae0ab5ec4bc255df0"], "tags": []}, {"author": "Cornelius Emase \u003ccorneliuslochipi@gmail.com\u003e", "branch": "default", "desc": "Bug 2062293 - Update test262 snapshot. r=dminor\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317831\n", "files": ["js/src/tests/jstests.list", "js/src/tests/test262/GIT-INFO", "js/src/tests/test262/built-ins/Array/prototype/Symbol.unscopables/at.js", "js/src/tests/test262/built-ins/Iterator/prototype/chunks/argument-effect-order.js", "js/src/tests/test262/built-ins/Iterato