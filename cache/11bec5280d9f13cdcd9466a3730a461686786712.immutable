rc/vm/NativeObject.h"], "git_node": "c17212a24280e5f6bab567f79740071e475ecc5a", "git_parents": ["0366e201af0d869a20530137cf66a973926ed357"], "node": "a223522886a66c1f94e26e4984597abd3e2391ed", "parents": ["db83f74aed7e789e396c72ca50108ee2014caade"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2058790 - adjust desktop reader mode URL handling, r=fchasen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321557\n", "files": ["toolkit/components/reader/ReaderMode.sys.mjs"], "git_node": "00f9400e9e422a557b30ee5551825ec6589b7197", "git_parents": ["c17212a24280e5f6bab567f79740071e475ecc5a"], "node": "f3d5c7c7ee87930c7f1df4dfaeae98f939208290", "parents": ["a223522886a66c1f94e26e4984597abd3e2391ed"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1983258 - Disable newtab customize panel controls whose pref is locked r=thecount\n\nPrefsFeed broadcasts the names of the locked prefs to content alongside the\npref values, and the customize panel disables the controls carrying a matching\ndata-preference. Controls that render a disabled condition of their own opt out\nwith data-lock-managed and apply the lock themselves.\n\nThis keys off Services.prefs lock state rather than the policy engine, so it\ncovers autoconfig and the Preferences policy as well as FirefoxHome's Locked.\nThe panel has no controls for showSearch, feeds.section.highlights,\nshowSponsored or showSponsoredTopSites, so those locks have nothing to disable\nhere; about:preferences already handles them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316932\n", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_firefoxhome.js", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/unit/lib/PrefsFeed.test.js", "browser/extensions/newtab/test/unit/utils.js"], "git_node": "32bd4fc5bab68fd2d89822233875529244d0d065", "git_parents": ["00f9400e9e422a557b30ee5551825ec6589b7197"], "node": "20dcd33034ef7048ebeed4a0a42b7abb0a315e4f", "parents": ["f3d5c7c7ee87930c7f1df4dfaeae98f939208290"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066184 - Part 3: Navigate to Notification or action's navigation URL on click. r=saschanaz\" for causing wpt failures @telemetry.sub.https.window.html.\n\nThis reverts commit c7572d318c0dcb13e84791c12b2b4374f4f4f75e.\n\nRevert \"Bug 2066184 - Part 2: Add navigate to NotificationStorage. r=saschanaz\"\n\nThis reverts commit 03531562b70431b44fe5559b2d357f9047e6b135.\n\nRevert \"Bug 2066184 - Part 1: Add navigate property to Notification. r=saschanaz,webidl\"\n\nThis reverts commit e75fc51c16fd7345492126771521f2cedbd5ef1a.\n", "files": ["dom/interfaces/notification/nsINotificationStorage.idl", "dom/ipc/DOMTypes.ipdlh", "dom/notification/Notification.cpp", "dom/notification/Notification.h", "dom/notification/NotificationHandler.cpp", "dom/notification/NotificationHandler.h", "dom/notification/NotificationParent.cpp", "dom/notification/NotificationUtils.cpp", "dom/webidl/Notification.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/notifications/idlharness.https.any.js.ini", "testing/web-platform/mozilla/meta/notifications/navigate.https.window.js.ini", "testing/web-platform/mozilla/meta/notifications/simulate-click-handler.sub.https.window.js.ini", "testing/web-platform/mozilla/tests/notifications/navigate-sw.js", "testing/web-platform/mozilla/tests/notifications/navigate.https.window.js", "testing/web-platform/mozilla/tests/notifications/resources/broadcast-when-opened.html", "testing/web-platform/mozilla/tests/notifications/simulate-click-handler-sw.js", "testing/web-platform/mozilla/tests/notifications/simulate-click-handler.sub.https.window.js", "toolkit/components/alerts/AlertNotification.cpp", "toolkit/components/alerts/AlertNotification.h", "toolkit/components/alerts/nsIAlertsService.idl"], "git_node": "8bd99648eb7376a72280779b8d68169d442e0105", "git_parents": ["32bd4fc5bab68fd2d89822233875529244d0d065"], "node": "169f389014c27a6e22482e997036e338e2caed44", "parents": ["20dcd33034ef7048ebeed4a0a42b7abb0a315e4f"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064930 - Make image icons work in native menubar. r=mac-reviewers,mkennedy,bradwerth\" for causing mochitests failures in browser_aboutKeyboard.js.\n\nThis reverts commit 00f1683533041a3c88d7e9a30d706b436d841890.\n", "files": ["browser/base/content/browser-menubar.inc.xhtml", "layout/reftests/xul/menuitem-key-ref.xhtml", "toolkit/content/widgets/menu.js", "widget/cocoa/nsMenuBarX.h", "widget/cocoa/nsMenuBarX.mm"], "git_node": "c8d8bdd21e2182c98c9d7018cce094ccaedc9b02", "git_parents": ["8bd99648eb7376a72280779b8d68169d442e0105"], "node": "4c228ced5f1c389e04316143c0d208005fd2bbac", "parents": ["169f389014c27a6e22482e997036e338e2caed44"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052772 - Part 2: Allowlist the pre-existing urlbar focus-ring startup flicker exposed by the idle-task port r=Gijs\" for causing mochitests-plain failures in test_ping_submitted.py.\n\nThis reverts commit 7bc824ce462ab723c4cccb949e112544db9eaab0.\n\nThis reverts commit 854379309b4f2e997b0623d2d8d4e24710d29840.\n", "files": ["browser/base/content/browser-gestureSupport.js", "browser/base/content/browser-init.js", "browser/base/content/browser.js", "browser/base/content/browser.js.globals", "browser/base/content/test/general/browser_gestureSupport.js", "browser/base/content/test/performance/browser_startup_flicker.js", "browser/components/BrowserComponents.manifest", "browser/components/downloads/DownloadsCommon.sys.mjs", "browser/docs/BrowserStartup.md", "browser/modules/test/browser/browser_taskbar_preview.js", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/tests/xpcshell/test_BrowserUtils.js"], "git_node": "eb77d4d8bbcf35ac296368294a60a770f893a3d7", "git_parents": ["c8d8bdd21e2182c98c9d7018cce094ccaedc9b02"], "node": "41583e0e0858f5c51c2cea1f82ef10b4e34e9e85", "parents": ["4c228ced5f1c389e04316143c0d208005fd2bbac"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058065 - Truncate on on unexpected error, r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321513\n", "files": ["dom/canvas/WebGLTextureUpload.cpp"], "git_node": "0d3efc88d2f4abbb1a77a7e5fb14e63d4c75457c", "git_parents": ["eb77d4d8bbcf35ac296368294a60a770f893a3d7"], "node": "f868622170690c8ddbd1a61a1de389d0c7773317", "parents": ["41583e0e0858f5c51c2cea1f82ef10b4e34e9e85"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2066856 - Bug 1850626 - Read the docshell's CSS error reporting flag directly. r=firefox-style-system-reviewers,emilio\n\nErrorReporter::ShouldReportErrors(const Document&) runs once per CSSOM\nproperty set, from Servo's set_property by way of ErrorReporter::new, so\nelement.style assignments pay it in a loop. It reaches a single bit through a\nvirtual XPCOM getter and an out-parameter, when nsDocShell has had a\nnon-virtual CSSErrorReportingEnabled() accessor for the flag since bug 1452143.\n\nnsDocShell::GetCssErrorReportingEnabled() only writes the bit and returns\nNS_OK, and nsDocShell::Cast() of a null nsIDocShell is null, so this is\nequivalent. Every caller of ShouldReportErrors benefits, not just the CSSOM\nsetter path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321538\n", "files": ["layout/style/ErrorReporter.cpp"], "git_node": "069a1bcec3c4aa7e7d2e57e2afc06220b40179d8", "git_parents": ["0d3efc88d2f4abbb1a77a7e5fb14e63d4c75457c"], "node": "cb0c4d5e827f42a392cdf799313c634da1da4ecd", "parents": ["f868622170690c8ddbd1a61a1de389d0c7773317"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1824085 - Part 1: Add jit-tests for bound function call bailouts and stack walking r=iain\n\nThese pass today. They exist so that the following patches, which make these\ncalls eligible for trial inlining, have coverage for the two things that are\neasy to get wrong: reconstructing |this| and the argument list on bailout, and\nwalking the stack through the call.\n\nThe call sites are deliberately fixed-arity, because spread calls are not\noptimized by tryAttachBoundFunction and so would not exercise the bound function\nstubs at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319120\n", "files": ["js/src/jit-test/tests/cacheir/bound-function-bailout.js", "js/src/jit-test/tests/cacheir/bound-function-stack-walk.js"], "git_node": "af429b9a167abffcebbb8c1ef33da7a988b95e79", "git_parents": ["069a1bcec3c4aa7e7d2e57e2afc06220b40179d8"], "node": "af5b23a951460a14b1969ed4ded6697a0b398dc9", "parents": ["cb0c4d5e827f42a392cdf799313c634da1da4ecd"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1824085 - Part 2: Trial-inline calls to bound scripted functions with no bound arguments r=iain\n\nAdds a CallInlinedBoundFunction CacheIR op so a call to a bound function can be\ntrial-inlined the same way CallInlinedFunction handles a direct call.\n\nCallBoundScriptedFunction also needs inlining_candidate. Without it the fallback\nstub never reaches TrialInliningState::Candidate, so maybeSingleStub rejects the\nsite before we look at the op.\n\nWe only support calls with no bound arguments and no new.target for now. That\nshape leaves the outer frame identical to a direct call to the target, so we can\nreuse ResumeMode::InlinedStandardCall and don't need to touch BaselineBailouts or\nthe frame iterators.\n\nFindInlinableCallData is also used for monomorphic inlining, which doesn't\nreplace the stub, so emitCallBoundScriptedFunction needs an isInlined() branch\ntoo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319121\n", "files": ["js/src/jit-test/tests/cacheir/bound-function-trial-inlining.js", "js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/BaselineCacheIRCompiler.h", "js/src/jit/CacheIROps.yaml", "js/src/jit/IonCacheIRCompiler.cpp", "js/src/jit/TrialInlining.cpp", "js/src/jit/TrialInlining.h", "js/src/jit/WarpBuilder.cpp", "js/src/jit/WarpCacheIRTranspiler.cpp"], "git_node": "7b9457b697b411efe45d847a313e2946dba43c6d", "git_parents": ["af429b9a167abffcebbb8c1ef33da7a988b95e79"], "node": "09bc9c87a7c288b384d6ea377773501a42040bd1", "parents": ["af5b23a951460a14b1969ed4ded6697a0b398dc9"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1824085 - Part 3: Enable scalar replacement for bound functions created by specialized bind r=iain\n\nA bound function created by the specialized Function.prototype.bind stub and then\ncalled in the same compilation usually doesn't escape, so the allocation can be\nremoved entirely and recovered on bailout.\n\nMNewBoundFunction becomes a recoverable instruction taking its template object as\nan MConstant operand, mirroring MNewIterator, because MObjectState::templateObjectOf\nreads the template from the operand.\n\nThe escape analysis needs to understand the instructions the bound function call\nstubs emit against the callee:\n\n  - loadBoundFunctionTarget    -\u003e MLoadFixedSlotAndUnbox\n  - loadBoundFunctionNumArgs   -\u003e MBoundFunctionNumArgs\n  - guardBoundFunctionIsConstructor\n  - guardObjectIdentity, which tryAttachBoundFunction emits for constructing\n    calls to check newTarget == callee. Both operands alias the object being\n    replaced, so the guard is trivially true, but either one can be a chain of\n    guards on that object rather than the object itself, so we compare with\n    PhiOperandEqualTo. Without this case the constructing call never\n    scalar-replaces, since ScalarReplacement runs before GVN and\n    MGuardObjectIdentity::foldsTo only folds constants and nursery objects.\n\nThe test uses assertRecoveredOnBailout, without which it would pass whether or\nnot scalar replacement actually happened. It is skipped when nothing warms up in\nthe baseline interpreter: the specialized bind IC never attaches in that case, so\nthere is no template object and no MNewBoundFunction, and the assertions would\nfail for an unrelated reason.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319122\n", "files": ["js/src/jit-test/tests/ion/bound-function-scalar-replacement.js", "js/src/jit/LIROps.yaml", "js/src/jit/MIR.cpp", "js/src/jit/MIR.h", "js/src/jit/MIROps.yaml", "js/src/jit/Recover.cpp", "js/src/jit/Recover.h", "js/src/jit/ScalarReplacement.cpp", "js/src/jit/WarpCacheIRTranspiler.cpp"], "git_node": "8da442ca1d7b637cd181346b9e1bddb2b5a774bb", "git_parents": ["7b9457b697b411efe45d847a313e2946dba43c6d"], "node": "9baec63ad73c0bd26ed3875831444cab0673e09a", "parents": ["09bc9c87a7c288b384d6ea377773501a42040bd1"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2061387 - Call MaybeBecomeUntrusted in CrossProcessRedirect, r=mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321568\n", "files": ["dom/ipc/ContentChild.cpp"], "git_node": "a901d3ec0b6ed0c438476a2de1af5bf996ce6a9c", "git_parents": ["8da442ca1d7b637cd181346b9e1bddb2b5a774bb"], "node": "0986882477940af34a36a622af90ccdacf009772", "parents": ["9baec63ad73c0bd26ed3875831444cab0673e09a"], "tags": []}, {"author": "Alex Finder \u003cafinder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2036884 - Stop running Jetstream2 in CI r=perftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320124\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/gecko_taskgraph/transforms/test/raptor.py", "taskcluster/kinds/browsertime/desktop.yml", "taskcluster/kinds/browsertime/mobile.yml", "taskcluster/test_configs/test-sets.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "543bce9ee58f21e87c5fba0e1865d3b3c6aa27bd", "git_parents": ["a901d3ec0b6ed0c438476a2de1af5bf996ce6a9c"], "node": "14c6baf0509dcd08e7fc4171e0eb87a6aa904386", "parents": ["0986882477940af34a36a622af90ccdacf009772"], "tags": []}], "date": 1787777748, "git_changesets": ["6cc78ddef539bcf313c247c62107de749d190ed4", "1753ff86a2ba6365e247afe641551a680a0dd30e", "9f7d07037cb2e1f848fa319811b30ceecfe67305", "bf76bce22e5b54e4f11e71042843e77c8188e2e8", "351b1d2d3a4b41256db20dc0fb79fe9c64527710", "6ba022ce909d0e7289fd07a541c8ef6dc89d77c8", "c49e5b6fe473c58be2ec39eb71e89a2457d52154", "208aee2c6673c95b00e3a5b976a7ded169c5eeaa", "dabaa0ae328f359398d722d46a553e4d92630e1e", "e45ecb46461f32b49518861ac2a4f66dc24d751e", "e75fc51c16fd7345492126771521f2cedbd5ef1a", "03531562b70431b44fe5559b2d357f9047e6b135", "c7572d318c0dcb13e84791c12b2b4374f4f4f75e", "7980bec1c624972f041ae5bdd6b4e00ddf1ba97d", "5bf0f62b6f9635874ff27cf4450729710ded7363", "a8ca1eac0bb4788bc783dab7bca241e59fbb4ace", "905f143c459d20de719b1f439d965d7e47d85c2e", "00f1683533041a3c88d7e9a30d706b436d841890", "b0e52bee2c4e84a19664eeb5129dc9084d9cc073", "6a22871ac112bd49bf6f0818cef6788c3ed7cc4b", "e028c1b3f1e560b1479a0eb931af26a6420eedc3", "b192c039a1212f063f1289082651b033b6c2514c", "089b8156937f7ba002ea937a457a52e48171c080", "894aa6a96122d64cab66f3c9470e9a6e35430c19", "2335ca1ef867628eafb5ff89d2400c17d965583a", "854379309b4f2e997b0623d2d8d4e24710d29840", "7bc824ce462ab723c4cc