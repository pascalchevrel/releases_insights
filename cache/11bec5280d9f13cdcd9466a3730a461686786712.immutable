platform/tests/html/dom/elements/global-attributes/dir-shadow-utils.js", "testing/web-platform/tests/html/dom/elements/global-attributes/dir-slots-directionality.html"], "git_node": "5dcfe902dd85e6acebc39e2bc4cec218c9ca62ba", "git_parents": ["7196c73c7b7f1ca5071daa42c252acf90259cba1"], "node": "d7ca2501702f9fb5b7ff788d02a3ee804d8826ba", "parents": ["c41ec898ad1bccfefdda3ada8c9940100ea39661"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015828 - Refactor selection code out of DirectionalityUtils Slot methods. r=jjaschke,dom-core-reviewers,keithamus\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320336\n", "files": ["dom/base/AbstractRange.h", "dom/base/DirectionalityUtils.cpp", "dom/base/DirectionalityUtils.h", "dom/html/HTMLSlotElement.cpp", "dom/html/HTMLSlotElement.h"], "git_node": "b68c0a11527edb4ecca6e9ebbadb96c794863c93", "git_parents": ["5dcfe902dd85e6acebc39e2bc4cec218c9ca62ba"], "node": "c634033932a6eafb4552ab00b696d5e997d9fdc2", "parents": ["d7ca2501702f9fb5b7ff788d02a3ee804d8826ba"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061486 - Make nsIConstraintValidation setters inlineable with a no-op fast path. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317093\n", "files": ["dom/html/nsIConstraintValidation.cpp", "dom/html/nsIConstraintValidation.h"], "git_node": "9165d5e0d6d851c81a55d4c59a8ce6e6b9bc9a59", "git_parents": ["b68c0a11527edb4ecca6e9ebbadb96c794863c93"], "node": "c46aa16ef547bee3c6066a77cf6499606d8a4a87", "parents": ["c634033932a6eafb4552ab00b696d5e997d9fdc2"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061486 - Early-return input validity methods if validity state doesn't apply. r=dom-core-reviewers,smaug\n\nCalling methods on mInputType is expensive because they are virtual and go\nthrough the mInputType member. If possible, we should do cheap checks in\nHTMLInputElement.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317094\n", "files": ["dom/html/HTMLInputElement.cpp", "dom/html/HTMLInputElement.h"], "git_node": "4eb69fe69eeb42d65a943aa7a0c04fbc8d8ab9cf", "git_parents": ["9165d5e0d6d851c81a55d4c59a8ce6e6b9bc9a59"], "node": "1bc09c54427478a6bddfa4359a9825893b3bf8a5", "parents": ["c46aa16ef547bee3c6066a77cf6499606d8a4a87"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047339. r=geckoview-reviewers,nika,ipc-reviewers\" for causing Android gtest failures.\n\nThis reverts commit c1d8ad3f29e20b1f9f4a6654ee25b82c56acfeed.\n", "files": ["ipc/glue/GeckoChildProcessHost.cpp", "mobile/android/geckoview/src/main/aidl/org/mozilla/gecko/process/IProcessManager.aidl", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/GeckoProcessManager.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/GeckoServiceChildProcess.java", "widget/android/GeckoEditableSupport.cpp", "widget/android/GeckoEditableSupport.h", "widget/android/GeckoProcessManager.cpp", "widget/android/GeckoProcessManager.h"], "git_node": "ef2a77bf6a41240e1e59dfc55eb29062bebb160b", "git_parents": ["4eb69fe69eeb42d65a943aa7a0c04fbc8d8ab9cf"], "node": "367585d0d3bfa303c0cc36cec5fa4aa2e5442695", "parents": ["1bc09c54427478a6bddfa4359a9825893b3bf8a5"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063169 - Fix uninitialized corner shape values in box shadows. r=gfx-reviewers,layout-reviewers,emilio,nical\" for causing reftests failures in boxshadow-rotated.html.\n\nThis reverts commit 47265f313ab5dc847c378eb886fa0585527f153b.\n", "files": ["layout/painting/nsDisplayList.cpp"], "git_node": "0da1c6d881f209d47a29bb2ca4e484a8fbd51261", "git_parents": ["ef2a77bf6a41240e1e59dfc55eb29062bebb160b"], "node": "ecddd182f14980f544368a65ca5cf355f6712008", "parents": ["367585d0d3bfa303c0cc36cec5fa4aa2e5442695"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063979 [Linux] Disable HW video decoding if dmabuf is not available r=emilio,gtk-reviewers\" for causing xpcshell assertion failures in StaticPtr.h.\n\nThis reverts commit 7494b0276beb96d0b85681349e2860d78e9f7efd.\n", "files": ["widget/gtk/GfxInfo.cpp"], "git_node": "a5e6230b7f3d34cc35db8fd51b7b471bd9902287", "git_parents": ["0da1c6d881f209d47a29bb2ca4e484a8fbd51261"], "node": "1be4c29d11aed8aedf5126e6c679e1a3e9bdee9a", "parents": ["ecddd182f14980f544368a65ca5cf355f6712008"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1955168 - Prevent flashing when opening mica popups for the first time r=emilio\" for causing mochitests failures in browser_contextmenu_blocked_image_protocols.js.\n\nThis reverts commit 987e01a0402953141cb0e44f44c8476a143630d6.\n", "files": ["gfx/layers/wr/WebRenderLayerManager.cpp", "widget/nsIWidget.cpp", "widget/nsIWidget.h", "widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h"], "git_node": "0092723d13b9cbd352b53ee1b8bee7c482ea2d60", "git_parents": ["a5e6230b7f3d34cc35db8fd51b7b471bd9902287"], "node": "2a6be518aaf15d8c004ddf830d299f088ebac548", "parents": ["1be4c29d11aed8aedf5126e6c679e1a3e9bdee9a"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060764 part 3: Remove parent document argument to PDocAccessible constructor and PBrowserBridge::SetEmbedderAccessible. r=eeejay,nika\" for causing geckoview failures in testAccessibilityFocusAboutMozilla\n\nThis reverts commit 677f69b293d5a0f48c0eecfc2a8beacb47b8c95e.\n\nRevert \"Bug 2060764 part 2: Ensure the correct same-process embedder when adding a child doc. r=eeejay,nika\"\n\nThis reverts commit 359b76dd6bdd0ff19b315bf369bd2543e84081b6.\n\nRevert \"Bug 2060764 part 1: Make PDocAccessible managed by PWindowGlobal instead of PBrowser. r=eeejay,nika\"\n\nThis reverts commit 9fced15f6e2e06a3727bd56528ce11698596b88e.\n", "files": ["accessible/android/SessionAccessibility.cpp", "accessible/base/FocusManager.cpp", "accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp", "accessible/generic/OuterDocAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "accessible/ipc/PDocAccessible.ipdl", "accessible/ipc/RemoteAccessible.cpp", "accessible/pdf/PdfStructTreeBuilder.cpp", "accessible/xul/XULComboboxAccessible.cpp", "dom/ipc/BrowserBridgeChild.h", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserBridgeParent.h", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/PBrowser.ipdl", "dom/ipc/PBrowserBridge.ipdl", "dom/ipc/PWindowGlobal.ipdl", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalChild.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/ipc/moz.build"], "git_node": "f54181e69218689d62e9fd89e9d49c253ac43469", "git_parents": ["0092723d13b9cbd352b53ee1b8bee7c482ea2d60"], "node": "e646a5a4261fc792c04f0f809a7cf722ecdee915", "parents": ["2a6be518aaf15d8c004ddf830d299f088ebac548"], "tags": []}], "date": 1787586925, "git_changesets": ["3e8ee7b6ceb99721d5de9810a844aa53e2427998", "3f8bf8fc7b1d2167610206dd64ac62eb39d48de0", "fc6edf0cc88713398bc3e7172c25b86149569f83", "373532d4b1e8e7cdad8b32921a3cf691f6d2d1e0", "9d51f1ff2b80f07814577383e8d61610a0247a8a", "be3b7c354a7fa4acc6903b0d7e35ae52df428593", "ed79429a34136da018dfb4bd739e262c9609ae12", "cce5d0c827bc6479427166e79fe059395fb408e7", "a70d6d2262c5a0f94e4a75735a3ee2be58420a3d", "448404d2743f514d039f7a3bc18f7fcb0d63e38c", "c1b873aa087660aee0cd9b34743e950bace103b5", "d261ca7a01bf23520033185c4c6541380864cd4c", "210b24818662a456bc06d9a414644005db04f16f", "24daa84a6e0314e2c27b55c5fd0f0d444f3ee247", "d9f285988cae0c1d9d