64e4fd8681d19382a4a4dec", "9764b4daf3bb1bc5b68148f2a5e3bf8afa515717", "7ffb0dbbb0aaf9f7ac5f78f907f70a56e98750a6", "005f406beb8fe42104abef8681a76f9a1ecf37fe", "b172b09dfbe0afabf04f5ae37e90e68e323544c0", "787cdd108cf004ca62ae6e26605d496fc8c9ab86", "bd2dcae484eeef7e607f3b7957031a413c8744de", "de89896f534d2ec730ce2afbe48b43edd66a0dd0", "0315d5e88189d75f4dd79180a5fd58fd00236482"], "user": "smolnar@mozilla.com"}, "45169": {"changesets": [{"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1764233. Enable scroll wheel acceleration on mac on nightly builds. r=mstange\" for causing wpt/wr failures on mac\n\nThis reverts commit 6b91c2f68c21b920507fb9ef5e0606dbb0766e7e.\n", "files": ["dom/events/test/test_bug422132.html", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "600bd2128b2ba435b9698ec8b61394aa27c7c93f", "git_parents": ["0315d5e88189d75f4dd79180a5fd58fd00236482"], "node": "1c12266c4f983ea52b856961508a15d6b7f99be1", "parents": ["e2604025ff5fa3c64c6b1b86c0c388f68e353fb7"], "tags": []}], "date": 1787648668, "git_changesets": ["600bd2128b2ba435b9698ec8b61394aa27c7c93f"], "user": "smolnar@mozilla.com"}, "45170": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 8b532c2140db30c193436254a61ce964e7d2a121 with FIREFOX-ANDROID_154_0_1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "d8daf0a4b4d2662e2d8f32c1cdc63cad4f1e135b", "git_parents": ["4fce20f036b0cf1fe3fad9ff62d5b7180727e14c"], "node": "11f05ea8aa531132d5494b0734c53e12e9211a1c", "parents": ["9c20d772368fae616c220c8c4309ca58924592dd"], "tags": []}], "date": 1787663390, "git_changesets": ["d8daf0a4b4d2662e2d8f32c1cdc63cad4f1e135b"], "user": "ffxbld@lando.moz.tools"}, "45171": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 8b532c2140db30c193436254a61ce964e7d2a121 with FIREFOX_154_0_1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "8bcca3a43f95463f107a5f9d868fe4be1b7b7ad0", "git_parents": ["d8daf0a4b4d2662e2d8f32c1cdc63cad4f1e135b"], "node": "455116b2573e96d1aee0cdded95bd041e93aadb7", "parents": ["11f05ea8aa531132d5494b0734c53e12e9211a1c"], "tags": []}], "date": 1787663619, "git_changesets": ["8bcca3a43f95463f107a5f9d868fe4be1b7b7ad0"], "user": "ffxbld@lando.moz.tools"}, "45172": {"changesets": [{"author": "Luk\u00e1\u0161 Lipinsk\u00fd \u003c6032558+Mr-Tao@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1776179 - Listen for text track changes before a track is active. r=kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318595\n", "files": ["toolkit/actors/PictureInPictureChild.sys.mjs", "toolkit/components/pictureinpicture/tests/browser_text_tracks_webvtt_2.js"], "git_node": "2c64f95f241f4697c3dde082ae60ba626918ad64", "git_parents": ["de89896f534d2ec730ce2afbe48b43edd66a0dd0"], "node": "2272a4c8baea2af8fc68b799f866bc180a5e5b30", "parents": ["3f805eac062895b5db9fbe275fdd39b097478af7"], "tags": []}, {"author": "Luk\u00e1\u0161 Lipinsk\u00fd \u003c6032558+Mr-Tao@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1776179 - Observe text tracks added after PiP opens. r=kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318612\n", "files": ["browser/extensions/pictureinpicture/tests/browser/browser.toml", "browser/extensions/pictureinpicture/tests/browser/browser_mock_wrapper.js", "browser/extensions/pictureinpicture/tests/browser/test-mock-wrapper.html", "browser/extensions/pictureinpicture/video-wrappers/mock-wrapper.js", "toolkit/actors/PictureInPictureChild.sys.mjs", "toolkit/components/pictureinpicture/tests/browser_text_tracks_webvtt_2.js"], "git_node": "5d53c509fd7c127e83deb29e92d045c706cd5c25", "git_parents": ["2c64f95f241f4697c3dde082ae60ba626918ad64"], "node": "99e77bbbc5246f40a5f23d7a2b9555a592fc8073", "parents": ["2272a4c8baea2af8fc68b799f866bc180a5e5b30"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2061357 - Add tab selector dialog to when clicking the Smart Form Fill autocomplete row edit button r=mlucks,fluent-reviewers,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317241\n", "files": ["browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.css", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.stories.mjs", "browser/components/aiwindow/ui/content/smartformfill-tab-select.css", "browser/components/aiwindow/ui/content/smartformfill-tab-select.html", "browser/components/aiwindow/ui/content/smartformfill-tab-select.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/SmartFormFillAutocomplete.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillConstants.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_tab_selector.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "840db7ebcba1b1b40c61343c02ceb543988c642d", "git_parents": ["5d53c509fd7c127e83deb29e92d045c706cd5c25"], "node": "39d2be0b501ab47352e2e114aba55ddbcff85af8", "parents": ["99e77bbbc5246f40a5f23d7a2b9555a592fc8073"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2065808 - jit/arm64: emit mov for computeEffectiveAddress with a zero offset. r=jandem\n\ncomputeEffectiveAddress unconditionally emitted add xD, xN, #imm, which\ndegenerates to add xD, xN, #0 when the offset is zero. Emit Mov instead:\nvixl drops it entirely when source and destination are the same X register,\nand otherwise emits the orr-form mov alias, a candidate for zero-latency\nmove elimination, while add #0 always occupies an ALU slot. When sp is\ninvolved vixl's Mov falls back to the same add form, so sp semantics are\nunchanged.\n\nThe dominant caller is pre-barrier emission: unguardedCallPreBarrier\ncomputes the barriered slot address into PreBarrierReg, so every barriered\nstore to a zero-offset address (dynamic slot 0, element 0) hit this.\n\nFound via armlint: 2438 'ADD/SUB #0 is redundant' findings on Octane\n(2301 Ion / 51 Baseline / 82 RegExp / 4 trampoline) drop to 2. Code size\nis unchanged in the common dest != base case (mov and add are both one\ninstruction); the win is that the register move is a candidate for\nzero-latency move elimination at rename instead of always occupying an\nALU slot, and the instruction disappears entirely when dest == base. The\ndominant sites are out-of-line barrier paths, so no wall-clock change is\nexpected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320681\n", "files": ["js/src/jit/arm64/MacroAssembler-arm64.h"], "git_node": "c15a091628d5198098b17d5be05955c2076709ee", "git_parents": ["840db7ebcba1b1b40c61343c02ceb543988c642d"], "node": "222fef62adbd1cdef9a40f4e8e5f4cf3c8fab77e", "parents": ["39d2be0b501ab47352e2e114aba55ddbcff85af8"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061357 - Add tab selector dialog to when clicking the Smart Form Fill autocomplete row edit button r=mlucks,fluent-reviewers,flod\" for causing bc failures @ browser_smartformfill_tab_selector.js\n\nThis reverts commit 840db7ebcba1b1b40c61343c02ceb543988c642d.\n", "files": ["browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.css", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.mjs", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.stories.mjs", "browser/components/aiwindow/ui/content/smartformfill-tab-select.css", "browser/components/aiwindow/ui/content/smartformfill-tab-select.html", "browser/components/aiwindow/ui/content/smartformfill-tab-select.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/SmartFormFillAutocomplete.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillConstants.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_tab_selector.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "87662995efd4966d1464f2bf616f67e65e4c0c5c", "git_parents": ["c15a091628d5198098b17d5be05955c2076709ee"], "node": "1c0e9783d8c2e91857efbf278aed87a710da36f2", "parents": ["222fef62adbd1cdef9a40f4e8e5f4cf3c8fab77e"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1764233. Enable scroll wheel acceleration on mac on nightly builds. r=mstange\" for causing wpt/wr failures on mac\n\nThis reverts commit 6b91c2f68c21b920507fb9ef5e0606dbb0766e7e.\n", "files": ["dom/events/test/test_bug422132.html", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "8309eb8265b478255a3545c8dd99273bb959cdaf", "git_parents": ["87662995efd4966d1464f2bf616f67e65e4c0c5c"], "node": "cb52a38f090e05e1ef373a5c8eec430870b094ae", "parents": ["1c0e9783d8c2e91857efbf278aed87a710da36f2"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2065620 - Pass the source as the VEX merge operand for scalar sqrt and round on x86-shared. r=jandem\n\nvroundsd_irr/vroundss_irr passed invalid_xmm as the VEX first source,\nwhich encodes vvvv=1111b -- and ROUNDSD/ROUNDSS read vvvv as their merge\noperand, so it decodes as xmm0: every rounding instruction\n(Math.floor/ceil/round/trunc and wasm nearest) carried a false\ndependency on whatever last wrote xmm0, an allocation-dependent hazard\ninvisible at the call sites. sqrtDouble/sqrtFloat32 merged from the\nstale destination like the conversions in bug 2064904. Pass the source\nregister as the merge operand instead, making the destination a pure\noutput; the fixed encodings are the same length, so generated code is\nbyte-for-byte the same size. Without AVX the legacy forms are emitted\nas before. vroundsd/vroundss now take src0 like the other VEX\nencoders, and the new roundDoubleWithMode/roundFloat32WithMode pick the\nmerge operand for all callers. visitPowHalfD now funnels through\nsqrtDouble to pick up the same fix.\n\nOn Zen 5 these merges do not measurably stall, unlike the\nfloat32\u003c-\u003edouble conversions, so this is dependency hygiene rather than\na measured win there: dependency-bound sqrt/floor microkernels change\nby under 1% and Mandreel (x10) / Octane (x3) are within noise. An\nx86lint survey of Octane's JIT output confirms the rewrite: the 12\nstale VEX merge operand findings (all vroundsd) and the lone legacy\nsqrtsd merge finding drop to zero.\n\nFound via x86lint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320566\n", "files": ["js/src/jit/x86-shared/Assembler-x86-shared.h", "js/src/jit/x86-shared/BaseAssembler-x86-shared.h", "js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp", "js/src/jit/x86-shared/MacroAssembler-x86-shared-inl.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared.cpp", "js/src/jit/x86-shared/MacroAssembler-x86-shared.h"], "git_node": "f7b57856f171f3f0332adaaf18cfd687d52ee6d3", "git_parents": ["8309eb8265b478255a3545c8dd99273bb959cdaf"], "node": "23fd64a024b669738258247b06c73220c2b3a1bb", "parents": ["cb52a38f090e05e1ef373a5c8eec430870b094ae"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038655 - Exit early when the jj workspace is stale r=ahal,sfink\n\nAlso stop suppressing stderr in `toolchains.py` so the\nerror message is actually visible on the build path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300104\n", "files": ["build/mach_initialize.py", "python/mach/mach/main.py", "python/mach/mach/sentry.py", "python/mach/mach/telemetry.py", "python/mozversioncontrol/mozversioncontrol/errors.py", "python/mozversioncontrol/mozversioncontrol/repo/jj.py"], "git_node": "6971df0263510189e7908d0b10dd67038d8282a7", "git_parents": ["f7b57856f171f3f0332adaaf18cfd687d52ee6d3"], "node": "5e6e4bcdcd81fb56ef2713fb4fb47877a57a6102", "parents": ["23fd64a024b669738258247b06c73220c2b3a1bb"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065666 - [efficiency] Describe selector strategies as data and resolve them with four adapters instead of a 34-arm branch r=isabel_rios\n\nmozGetElement was a 295-line `when` with one arm per SelectorStrategy: 254 lines\nof code to express 34 lookups.\n\nThe strategies are not 34 ideas. They are the product of five small ones - which\ntoolkit answers the question, what to match on, exactly or as a substring, which\nCompose semantics tree, and whether to take the single node or the first of all\nmatches - plus an optional second clause such as a sibling's or a child's text.\n\nSo Locator says what a strategy asks for, STRATEGY_LOCATORS maps every existing\nconstant to one, and four resolvers interpret it, one per toolkit. Each resolver\nis a five-to-seven arm `when` over the handle instead of a 34-arm `when` over\nstrategies, and the table is the entire compatibility surface, so every selector\ncatalog and page object compiles untouched.\n\nResolution logic: 254 -\u003e 116 lines, plus a 71-line declarative table. BasePage\noverall: 1806 -\u003e 1573 lines of code.\n\nThe line count is not the point. Adding a strategy meant adding an arm, and arms\ncould disagree about things the caller never chose: UIAUTOMATOR_WITH_RES_ID\nprefixes the package and UIAUTOMATOR_WITH_RAW_RES_ID does not, so aiming one at\na Compose test tag finds nothing and says nothing. Those are now one code path\nwith different field values, and the same is true of the merged/unmerged tree\nchoice that several Compose arms made inconsistently.\n\nVerified on device across all four layers - HomeTest, HistoryTest,\nFindInPageTest and SettingsAboutTest, 19 tests - with the same classes passing\nidentically on main.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320802\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Locator.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Resolvers.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt"], "git_node": "30de3682f9cd93b814888c7de9f7494128ffd639", "git_parents": ["6971df0263510189e7908d0b10dd67038d8282a7"], "node": "362aadd12fd31701535bcc25910686f5a8edf043", "parents": ["5e6e4bcdcd81fb56ef2713fb4fb47877a57a6102"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065666 - [efficiency] Give every element verb one skeleton instead of eighteen copies of it r=aaronmt\n\nEighteen of BasePage's moz* verbs were the same dozen lines with three lines of\ndifference: announce the command, announce the lookup, resolve, retry once if a\nknown overlay was covering the target, report the miss, dump the screen, throw\nwith the selector in the message - and somewhere in the middle, do the thing.\n\nCopying that skeleton eighteen times is why the verbs disagreed with each other.\nmozVerify polled and mozClick did not, so the same missing element was a timeout\nor an instant failure depending on which verb you reached for. The overlay retry\nexisted in two verbs out of eighteen. Three verbs dumped the screen on failure\nand the rest did not. None of those differences were decisions; they were the\nplaces the copies had drifted.\n\ncore/Interaction.kt holds the skeleton once. A verb is now a name, a wait\npolicy, a predicate and an action:\n\n  fun mozClickWhenEnabled(selector: Selector, ...) = require(\n      verb = \"click_when_enabled\",\n      policy = WaitPolicy.Poll(timeout, interval),\n      predicate = { ElementState.probe(it, Trait.ENABLED) },\n      action = UiActions::click,\n  )\n\nPatience is declared rather than hand-rolled, so WaitPolicy.Immediate versus\nPoll is visible at the call site instead of buried in a while loop. The overlay\nretry and the screen dump now happen for every verb because they happen in one\nplace. ElementState.isNot asserts the negative rather than negating the positive,\nbecause Compose distinguishes \"not enabled\" from \"no enabled semantics at all\".\n\ncore/UiActions.kt takes the second duplication: nine verbs each ended in the\nsame four-branch `when` over ViewInteraction / UiObject / UiObject2 /\nSemanticsNodeInteraction, with an `else -\u003e throw \"unsupported element type\"` for\nthe impossible fifth case. Sixteen hand-written cases become one dispatch.\n\nTwo behaviours are deliberately preserved rather than unified, both marked:\nmozClick still resolves through resolve() and everything else through\nmozGetElement (the asymmetry is a real defect, tracked separately, and changing\nit here would hide this refactor inside a behaviour change); and \"optional\" now\ncovers the action as well as the lookup, because mozClickIfPresent was written\nto swallow a failed UiObject click and the type dispatch would otherwise have\nstarted throwing.\n\nVerbs: 723 -\u003e 175 lines. BasePage: 1653 -\u003e 1123 lines of code.\n\nVerified on eff-firebase-api34: 87 tests across HomeTest, BookmarksTest,\nHistoryTest, SearchTest, MainMenuTest, SettingsAccessibilityTest,\nSettingsCustomizeTest, SettingsDeleteBrowsingDataTest, SettingsGeneralTest,\nSettingsHTTPSOnlyModeTest, TranslationsTest, FindInPageTest and ReaderViewTest.\nOne failure, MainMenuTest.verifyTheTranslatePageSubMenuOptionTest, is the\ndocumented local baseline failure: the translation model never downloads on this\nemulator.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320803\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Interaction.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/UiActions.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt"], "git_node": "da1d35f90d3c73bffd786bd17016dfc758b4afcb", "git_parents": ["30de3682f9cd93b814888c7de9f7494128ffd639"], "node": "87824db0a4bf01795551ebe5b6d29341cf97faf2", "parents": ["362aadd12fd31701535bcc25910686f5a8edf043"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065666 - [efficiency] Finish the verb consolidation: gestures, collections, repetition, and a faster wait r=aaronmt\n\nThe remaining verbs that still carried their own skeleton, and the last two\nduplications underneath them.\n\nGestures. mozSwipeElement was 103 lines: a four-branch `when` in which each\nbranch re-derived the same four directions in that backend's own vocabulary -\nsixteen cases written longhand. core/Gestures.kt makes direction a lookup and\ngives each backend one line, plus onScreen() for the case where there is no\nelement to aim at yet.\n\nRepetition. Four verbs were the same loop - swipe until it shows, swipe until it\ngoes, press back until it goes, press back until it shows - each rebuilding the\nattempt counter, the per-attempt report line and its own failure text. They also\ndisagreed about whether to check before or after the last step, so two of them\ncould take one more action than they were asked for. driveUntil() checks first\nand acts second, so a screen that is already correct costs nothing.\n\nThat fixed a three-second stall per call in mozPressBackUntilGone, which waited\nwaitingTimeShort for the element to be *present* before concluding it was gone -\nso the success path always paid the full timeout.\n\nCollections. Five verbs each fetched the match collection, rebuilt the same poll\nloop, and wrote their own \"strategy not supported\" error. requireAll() asks the\nquestion once. Only a Compose tag can match more than one element, and that is\nnow the message when a caller picks something else, instead of a bare \"not\nfound\".\n\nWaiting. WaitPolicy.Poll now backs off - 25ms, then doubling to the caller's\ninterval - so a screen that settles in 80ms costs 80ms instead of a full tick.\nThe suite spends most of its time waiting for things that have already happened.\nmozVerifyElementCount opts out, because a list still being populated passes\nthrough the expected count on its way to a larger one and probing faster would\nmake that transient easier to catch, not harder.\n\nAlso here: mozVerifyElementCount was the last unguarded closeSoftKeyboard() in\nthe tree. Espresso throws PerformException from it when the focused view's root\nis not the one it expects, and hiding the keyboard is only ever a convenience,\nso it must not fail a test. It now uses the guarded dismissSoftKeyboard(), and\nSettingsSearchTest.verifyCustomSearchEngineCanBeAddedFromSearchEngineMenuTest -\na standing local failure - passes.\n\ncore/ is now ten small files rather than one growing one: Wait, VerbHost,\nElementState, Verbs, UiActions, Gestures, Relations, Locator, Resolvers,\nUiElement.\n\nVerbs: 702 -\u003e 241 lines. BasePage: 1123 -\u003e 742 lines of code, from 1890 at the\nstart of this branch.\n\nVerified on eff-firebase-api34: 68 tests, zero failures, across every class that\ncalls a verb this touched - SearchTest, TranslationsTest, SettingsSearchTest,\nSettingsCustomizeTest, NavigationToolbarTest, NavigationToolbarExpandedTest,\nSettingsAccessibilityTest, SettingsPageSummariesTest, CreditCardAutofillTest,\nReaderViewTest, BookmarksTest, HistoryTest and UploadPermissionsTest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320804\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/ElementState.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Gestures.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Interaction.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Relations.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/VerbHost.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Verbs.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/WaitPolicy.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt"], "git_node": "73ca42436b543fbce81492ad9e17dd789dde2ec8", "git_parents": ["da1d35f90d3c73bffd786bd17016dfc758b4afcb"], "node": "0ee837d0b21c1db591689dfbb47ba35607cf251b", "parents": ["87824db0a4bf01795551ebe5b6d29341cf97faf2"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065666 - [efficiency] Move the page-group probe and the displayed-match resolver into core r=aaronmt\n\nThe last three functions carrying their own skeleton, and the resolution path\nthat was still split across two files.\n\nPage groups. \"Am I already on this page\", \"wait until I am\", and \"verify this\ngroup of elements\" were three functions iterating a group of selectors, each\nwriting its own per-selector report line and folding the results with `all {}`.\nThe polling one restarted its command on every tick, so a ten-second wait wrote\na hundred command pairs into the report to answer one question. groupPresent()\nasks once and answers; the three callers differ only in their wait policy,\nwhether they scroll, and what they do with a no.\n\nResolution. resolveComposeNode/pickDisplayed/toUiElement lived in BasePage while\nthe four strategy resolvers lived in core/Resolvers.kt, so the two halves of\n\"selector -\u003e element\" could not be read together. Resolvers.displayed() is now\nthe fifth resolver, next to the others: the four answer \"which node does this\nname\", it answers \"which of them is the one on screen\", which is the question an\ninteraction actually has. UiElement.wrap() moves to the facade it produces.\n\nPutting both paths in one file is also the precondition for closing the\nasymmetry between them - mozClick resolves through displayed(), everything else\nthrough mozGetElement, so an element can be clickable and unverifiable. That is\na behaviour change and belongs in its own patch; this one just stops the two\nhalves being in different places.\n\nAlso removed: check(), which had no callers. Speculative API in a file whose\nwhole point is that there is one way to say each thing is a defect, not a\nconvenience.\n\nBasePage: 742 -\u003e 618 lines of code, from 1890 at the start of this branch.\n\nVerified with the full package on eff-firebase-api34: 217 tests, 27 skipped, one\nfailure - MainMenuTest.verifyTheTranslatePageSubMenuOptionTest, the documented\nlocal baseline failure where the translation model never downloads.\n\nFour failures from the recorded baseline now pass, and the run contains no\nPerformException at all. Two of those are this stack's guarded keyboard dismiss;\nthe download and Play-Store handoff ones are not attributable to it - that\nbaseline was recorded on a different emulator image.\n\n47m03s for 217 tests, against a recorded 51m31s for 200. Per test that is 12.7s\nagainst 15.5s. The poll backoff and the removed three-second stall in\nmozPressBackUntilGone are the plausible causes, but a single run cannot separate\nthem from variance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320805\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Resolvers.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/UiElement.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Verbs.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt"], "git_node": "44015b94cab9f158c87ccf595e560d6fcb59cf19", "git_parents": ["73ca42436b543fbce81492ad9e17dd789dde2ec8"], "node": "573eb3b8aed766b6085b5fb33db33732abe250c3", "parents": ["0ee837d0b21c1db591689dfbb47ba35607cf251b"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065666 - [efficiency] Reorder BasePage into sections that describe their contents r=aaronmt\n\nPure move, no code changes. The old section banners described a file that no\nlonger existed: \"Interaction helpers (CMD + LOC)\" sat above three verbs while\nfive more lived under \"Preconditions (CMD)\", and mozClear, mozVerifyNativeAppOpens\nand dismissSoftKeyboard shared a heading with ensureReachable because that is\nwhere they happened to be written.\n\nNow the file reads as what it is - a page's host wiring, then navigation, then a\nverb vocabulary grouped by the question each verb answers:\n\n  What the verb executor needs from a page\n  Page identity\n  Reporting internals\n  Navigation (STEP)\n  Resolution: selector -\u003e element\n  Preconditions and interference\n  Verbs: is it there?\n  Verbs: what state is it in?\n  Verbs: all the matches at once\n  Verbs: touch it\n  Verbs: type into it\n  Verbs: move the screen\n  Verbs: the device around the app\n\nVerified move-only by diffing the sorted non-blank content of both revisions with\nthe banners excluded: identical. Compiles, formats clean, and 21 tests across\nHomeTest, SettingsCustomizeTest and SearchTest pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320806\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt"], "git_node": "3207706c35381a999f423d9c6dac6df2417bc559", "git_parents": ["44015b94cab9f158c87ccf595e560d6fcb59cf19"], "node": "20b967543a9e3bb6af02881e4f7d7978481ce1cf", "parents": ["573eb3b8aed766b6085b5fb33db33732abe250c3"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065666 - [efficiency] Return the receiver from each primitive so a verb is one expression r=aaronmt\n\nEvery primitive returned Unit (or, in require's case, a Boolean nobody read), so\neach verb needed a block that called it and then said `return this` for chaining.\nTwenty-eight verbs paid three lines to say one thing:\n\n  fun mozVerifyElementAbsent(selector: Selector): BasePage {\n      requireAbsent(\"verify_absent\", selector)\n      return this\n  }\n\nThe primitives are now generic in their receiver - `fun \u003cT : VerbHost\u003e T.require(...): T` -\nso the verb is the expression:\n\n  fun mozVerifyElementAbsent(selector: Selector) = requireAbsent(\"verify_absent\", selector)\n\nrequire's Boolean return goes with it. It reported whether an `optional` verb had\nactually done anything, and nothing ever asked.\n\nAlso trimmed 48 lines of comment. I had annotated the new code with what it\nreplaced - \"six verbs, one shape, each was ~40 lines\" - which is commit-message\nmaterial, and it is already in the commit messages. What stays is what a reader\nneeds in order to change the code safely.\n\nBasePage: 618 -\u003e 560 lines of code, from 1890 at the start of this branch.\n\nVerified on eff-firebase-api34: 63 tests across HomeTest, BookmarksTest,\nSearchTest, SettingsCustomizeTest and MainMenuTest. One failure,\nMainMenuTest.verifyTheTranslatePageSubMenuOptionTest, the documented local\nbaseline failure where the translation model never downloads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320807\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/ElementState.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Gestures.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Relations.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/UiActions.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/VerbHost.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Verbs.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/WaitPolicy.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt"], "git_node": "2025c3119bbfa9674a05e5e27952c9635312cfd2", "git_parents": ["3207706c35381a999f423d9c6dac6df2417bc559"], "node": "3aedec9617ee532557627b178a0771709a77221b", "parents": ["20b967543a9e3bb6af02881e4f7d7978481ce1cf"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065666 - [efficiency] Make the docs describe the harness that now exists r=aaronmt\n\nDocumentation only.\n\nBasePage's class comment was headed \"why BasePage owns logging\". It does not own\nlogging any anymore - core/Verbs.kt does, and BasePage's entire involvement is\n`override fun reporter() = rep()`. The rest of it was a roadmap (test factories,\nreflection-based page enumeration, AI-assisted self-healing) rather than anything\nthat helps someone change this file. Replaced with what BasePage now is:\nnavigation, host wiring, and a verb vocabulary where each verb is one expression.\n\nOne sentence from it was load-bearing and moved to core/Verbs.kt, where the\nreporting actually happens: the structured log stream is the source of truth for\nwhat a test did. That is not philosophy - it is why effpretty and effverify\nexist, and it is the constraint on any future change to the report format.\n\ndocs/guides/extending-basepage.md was worse than stale, it was misleading. It\ntold the next verb author that a primitive \"must dispatch across the element\nbackends - don't hard-code one\", which is now exactly backwards: a verb that\nhand-writes a four-way `when` re-introduces the duplication that UiActions,\nGestures, ElementState and Relations removed. It now says a verb is one\nexpression, tabulates the seven primitives to choose between, and says where\nbackend behaviour goes instead. Its verb inventory was six verbs short and is\nnow generated from BasePage and grouped the way the file is; a checker in the\ncommit process confirmed all 39 are listed and nothing listed is fictional.\n\narchitecture.md claimed \"everything funnels through resolve()\", which was only\never true of mozClick and is not the organising fact now. It describes the ten\ncore files. gotchas.md B6 said new verbs go through resolve(); it now says what\nthey actually go through, and keeps the advice that matters - full-suite any core\nchange, which this branch has repeatedly justified.\n\nAlso updated the efficiency-test-authoring skill in firefox-aidev-plugins, which\ndistills these docs for agent use and carried the same resolve() instruction.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320808\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Verbs.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/architecture.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/gotchas.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/extending-basepage.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt"], "git_node": "5cf6d919f5424219948e54b49e4c33ba80f872c6", "git_parents": ["2025c3119bbfa9674a05e5e27952c9635312cfd2"], "node": "a4be3590a1decb8f88c2be6fc4d3c7e5adee923b", "parents": ["3aedec9617ee532557627b178a0771709a77221b"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065666 - [efficiency] Tighten BasePage's comments to what a reader cannot get from the code r=aaronmt\n\nComments only; not a line of code changed.\n\nOne test applied throughout: does this tell a reader something the code cannot,\nand would it change what they do? What failed it:\n\n- Archaeology. mozGetElement still opened with \"was a 295-line `when`\", and the\n  navigateToPage dump explained what the code used to fail to do. The line count\n  is in the commit that made it true; it is not orientation for anyone reading\n  the file now.\n- Restatement. \"Helps avoid super long or illegal step ids due to punctuation\" sat\n  above a regex substitution and a take(120).\n- Padding. dismissKnownOverlaysIfPresent had thirteen lines saying three things.\n\nWhat stayed, shorter: the reasons a change would be wrong. mozVerifyElement must\nnot throw, because the page probes poll it and an escaped exception becomes a\nStrictMode penaltyDeath that masks the real error. dismissSoftKeyboard tolerates\nfailure because hiding the keyboard is only a convenience. mozVerifyElementCount\npolls on a fixed beat because a list still filling passes through the expected\ncount. mozClickWhenEnabled exists because a disabled control accepts the tap and\nthe test passes anyway.\n\nTwo additions, both facts a reader needs: resolve() now says outright that every\nother verb resolves through mozGetElement, so an element can be clickable and\nunverifiable (MTE-5737); and dismissSoftKeyboard says to use it rather than a\nbare closeSoftKeyboard(), which is the bug this branch fixed.\n\nSection banners are one line rather than three.\n\nBasePage comments: 168 -\u003e 105 lines. Code unchanged at 560.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320809\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt"], "git_node": "a9cd67bcc8e1adb36d011113c7cd531a855005fa", "git_parents": ["5cf6d919f5424219948e54b49e4c33ba80f872c6"], "node": "eda09f28b2b257a2b461c640530e7276098c6b72", "parents": ["a4be3590a1decb8f88c2be6fc4d3c7e5adee923b"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065666 - [efficiency] Hand out reporting scopes instead of pushing onto a stack r=aaronmt\n\nThe reporter had six public methods that were three, and a latent bug in the\nother three. endStep, endCmd and endLoc were all `= endEvent(success, message)`,\nwhich pops whatever is on top of a stack regardless of type - so a verb that\nthrew between its start and its end left its event on the stack, and the next\nendCmd() silently closed the wrong one, shifting the indentation of every line\nafter it. Nothing detected that.\n\nstart() now hands back a Scope and you close the scope you were handed:\n\n    val cmd = cmd(verb, selector.description, \"Attempting to $verb ...\")\n    ...\n    cmd.fail(message)\n\nwhich makes the mismatch unrepresentable and lets the ArrayDeque go entirely. An\nabandoned scope now corrupts nothing, and a second close is ignored rather than\ndouble-counted.\n\nThe rest is the same de-duplication as the verbs. Type carries what differs\nbetween STEP/CMD/LOC - depth, announcer, slow threshold, summary label - so four\n`when` blocks over the same three cases become a table, and printSummary's three\nnear-identical emissions become a loop. Outcome does the same for OK/FAIL/SKIP,\nmerging endEvent and endEventSkip. Thresholds and Totals were public nested\nclasses with no callers and are gone.\n\nTestLogging.reporter is no longer nullable. It was null only before BaseTest\ninstalls one, which put a `?.` on all forty-odd call sites to express something\nno caller ever wanted to handle; TimedReporter.Silent covers the case that\nactually exists - page objects driven outside a test, by the inspector or\ntooling. Verbs.kt and BasePage.kt now contain zero `rep?.`.\n\nAlso: effpretty had no style for [SKIP], so a skipped scope - an optional element\nthat was not there - rendered as unstyled body text. LEVEL_STYLE.get() defaulted\nit silently.\n\nTimedReporter: 137 -\u003e 93 lines of code. Verbs.kt: 270 -\u003e 249.\n\nVerified output-preserving rather than assumed. Captured the Eff stream from\nHomeTest on this code and on the previous commit, normalised only the millisecond\nmeasurements, and diffed: 238 structured lines each, identical - every tag, glyph,\nindentation level, message and counter (Steps 2, Commands 11, Locators 12 on the\nfirst test; 7/33/48 on the second). effpretty's STRUCT_RE and effverify's grading\nread that stream, so this was the guard that mattered.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320810\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/VerbHost.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Verbs.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/effpretty/effpretty.py", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/TestLogging.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/TimedReporter.kt"], "git_node": "9db6608cc89ad010a8b56961b5d7bab2a9d312f2", "git_parents": ["a9cd67bcc8e1adb36d011113c7cd531a855005fa"], "node": "37faec786123a49dfb00979848645e7bea8d79c5", "parents": ["eda09f28b2b257a2b461c640530e7276098c6b72"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065666 - [efficiency] Emit the run as structured records, not only as prose r=aaronmt\n\nTriage over rendered English breaks silently, and this branch proved it: the verb\nconsolidation reworded eight of efftriage's thirteen matchers at once. Nothing\nfailed. Tests passed, runs passed, and the tool quietly stopped explaining\nanything. One rule had already died the same way in August, which is documented\nin efftriage's own header \u2014 so this is the second time, not the first.\n\nThe harness now emits every event twice. Prose on the Eff tag, unchanged, for a\nhuman. And one JSON object per event on a new EffJson tag for a machine, carrying\nwhat the prose only implies:\n\n  {\"type\":\"CMD\",\"verb\":\"wait_until_absent\",\"selector\":\"Translation bottom sheet\n   translate button\",\"strategy\":\"COMPOSE_BY_TEXT\",\"value\":\"Translate\",\n   \"failure\":\"still_present\",\"outcome\":\"FAIL\",\"elapsedMs\":25530.29, ...}\n\ncore/VerbHost.kt gains a Failure vocabulary \u2014 not_found, wrong_state,\naction_failed, still_present, appeared, never_settled, collection_unsatisfied,\nunsupported_strategy, condition_timeout, not_arrived, no_path \u2014 so a rule can\nmatch a value instead of a sentence. Every primitive records which one applies,\nplus the selector's identity and the label of the screen dump taken for that\nfailure, so a consumer can pair the two.\n\nThree gaps closed while wiring it:\n\n- The failure cause was dropped twice. StepResult.Fail carries a Throwable, but\n  TimedReporter built Fail(message) without one and CombinedLogger wrote only the\n  reason, so no stack ever reached either sink. It does now.\n- details.jsonl had no test boundaries, so a step could not be attributed to a\n  test \u2014 the first thing triage asks. A TestWatcher records testStart/testEnd\n  with the outcome. This turns out to matter more than expected: a real 32-test\n  run logs 82 failing records for ONE failing test, because navigateToPage asks\n  \"am I already here?\" before every move and the answer is usually no. Without\n  boundaries a consumer cannot tell those apart from the real failure.\n- outcome (OK/FAIL/SKIP) and result (PASS/FAIL) said nearly the same thing in two\n  vocabularies, and result flattened SKIP into PASS. One field now.\n\nTransport is logcat rather than a file, which was the reachability problem all\nalong: the artifacts live in app-scoped storage and the orchestrator runs\npm clear between tests, so nothing written there survives to be pulled \u2014 and the\nTAE flank configs only pull /sdcard/screenshots, which nothing in this suite\nwrites to. Logcat already survives all of that and is already captured. The file\nstays for local use.\n\neffpretty demuxes the tag: --events writes the records verbatim to a sidecar and\nnever renders them. It does the split because it is the only process reading\nlogcat during a run; a second adb logcat would race it for the same buffer and\nboth would come away with holes.\n\nAlso: effpretty had no style for [SKIP], so a skipped scope rendered as unstyled\nbody text.\n\nVerified end to end on device rather than reasoned about: a real MainMenuTest run\nproduced 1556 records, none unparseable, and the one genuine failure appears with\nfailure=still_present and its full selector identity. The corresponding efftriage\nchange lands separately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320811\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/VerbHost.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Verbs.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/effpretty/README.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/effpretty/effpretty.py", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/debugging-tests.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/JsonSink.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/LoggerFactory.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/TimedReporter.kt"], "git_node": "22b6ab6ecf9eaf2cb45fef9fcf484df956394fae", "git_parents": ["9db6608cc89ad010a8b56961b5d7bab2a9d312f2"], "node": "916e073cda5f07fc2718d03ebf23023969279ca4", "parents": ["37faec786123a49dfb00979848645e7bea8d79c5"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065666 - [efficiency] Make screen dumps queryable, and replace four unused sink methods with one that is used r=aaronmt\n\nEvery triage rule ends with \"read the dump\", which until now meant a human\nreading dozens of bullet lines of prose. The dump is now also emitted as records\n\u2014 one per node, grouped by the dump's label, across both the Compose and the\nUiAutomator layers \u2014 so \"was the element on screen under a different handle?\"\nbecomes a query instead of an eyeball exercise. That question is the most common\nconversion mistake there is, and the native layer is where it is often answered:\na system dialog or a legacy View lives outside the Compose semantics tree\nentirely, which is the whole point of gotcha A9/F1.\n\nThe prose dump is unchanged, byte for byte. It is what a person reads.\n\nGetting there meant giving StepLogger a general emitter, and that turned four\nmethods into one. info, warn, error and attachScreenshot had no callers between\nthem \u2014 attachScreenshot in particular could never have had one, because it wants\na PNG path and ScreenDump writes logcat. record(type, fields) replaces all four\nand has a real use on the day it lands. StepLogger is down from eight methods to\nfive, every one of them called.\n\nVolume is bounded: dumps only happen on failure, and MAX_STRUCTURED_NODES caps a\npathological screen at 250 nodes per layer with the truncation recorded rather\nthan silent.\n\nVerified by running the EffScreenDumpRunner devtool, which dumps deliberately, so\nthe emission path could be checked without waiting for a failure to produce one:\n36 compose records and 136 uiautomator records, correctly grouped by label and\ntagged with their layer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320812\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/effpretty/README.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/ScreenDump.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/LoggerFactory.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/StepLogger.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/TimedReporter.kt"], "git_node": "0a09c8a1ed33349b946348bfdae9a6aa856e942a", "git_parents": ["22b6ab6ecf9eaf2cb45fef9fcf484df956394fae"], "node": "44d60dce86cc27313e0a467c3f2934742a55fde1", "parents": ["916e073cda5f07fc2718d03ebf23023969279ca4"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065666 - [efficiency] Stop effpretty orphaning its adb logcat child r=aaronmt\n\n`capture` terminated the child in the generator's `finally`, which is not the\nthing that gets killed. Python's default SIGTERM handling exits the interpreter\nwithout unwinding generators, so the cleanup never ran.\n\neffloop backgrounds `effpretty capture` and SIGTERMs it at the end of every run,\nwhich means it has been leaving one `adb logcat` attached to the device per loop\niteration, silently, forever. Two were found still attached after a day's work.\n\nA stray reader is not free: logd serves it every line and applies backpressure to\nthe app producing them. Reaping the two found here was worth about 7% on a test\nclass \u2014 small, but it accumulates with every run and nothing ever cleaned it up.\n\nThe children are now tracked at module level and reaped from an atexit hook plus\nSIGTERM/SIGHUP handlers, so the path that actually happens is covered rather than\nonly the one that doesn't.\n\nVerified by running capture under each version and counting readers after a\nSIGTERM: before, one left behind; after, none.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320813\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/effpretty/effpretty.py"], "git_node": "03e110c4216eeee990bdc6caa5ff06330d749509", "git_parents": ["0a09c8a1ed33349b946348bfdae9a6aa856e942a"], "node": "004794d79ed507e918de1e1188ee5365212a3c70", "parents": ["44d60dce86cc27313e0a467c3f2934742a55fde1"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065973 - [efficiency] Write down the log format the harness promises r=aaronmt\n\nFour tools parse this harness's output and none of them live in this repository:\neffpretty renders the console stream, efftriage diagnoses failures from the\nstructured one, effverify grades runs, and the fleet UI reads both. So a\nrewording here cannot fail anyone's CI, and is invisible until someone notices\ntheir tooling has quietly stopped working.\n\nWhich has happened twice. On 2026-08-21 the verb consolidation reworded eight of\nefftriage's thirteen matchers at once: tests green, runs green, triage silently\nexplaining nothing. One rule had already died the same way on 2026-08-13 and its\nown comment records the date. Both were found by accident, weeks apart.\n\nlog-format.json is that contract written down: the console tags and glyphs and\nindentation effpretty parses, the EffJson record types and field vocabulary,\nthe Failure values triage matches on instead of prose, and the screen-dump\nmarkers. It documents what already exists --- no behaviour changes here.\n\nThe file is deliberately data rather than prose so it can be asserted against.\nContract tests reading it live in testops-tools for now\n(tae-conversion/tests/harness_contract_tests.py) and catch drift in both\ndirections: the harness dropping something it promises, and a consumer matching\na value the harness no longer emits.\n\nThose tests belong here, in the CI that reviews the change that breaks them ---\nin testops-tools they only fire when somebody runs that suite, so a break lands\ngreen and goes red later. Moving them is a port rather than a redesign precisely\nbecause this file stays put. That move needs a gradle-config change, which is a\nconversation worth having when the toolchain has earned it rather than now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320814\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/log-format.json"], "git_node": "0d1e719c1900eea432c5c4fd5b945b5b5ff0ffaa", "git_parents": ["03e110c4216eeee990bdc6caa5ff06330d749509"], "node": "8e0afe0d0367429bf35b040e4123fc89ac8d496c", "parents": ["004794d79ed507e918de1e1188ee5365212a3c70"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065974 - [efficiency] Capture the failure screen, and give the analyzer a --json mode r=aaronmt\n\nA failed test was a name and a status, so the next step was always to re-run it\nlocally and watch. That does not work for the load-sensitive failures, which are\nexactly the ones that pass when run alone.\n\nThe harness already knew the answer and threw it away. On failure it dumped the\nCompose tree as text, while dumpAll() --- which additionally captures a\nscreenshot and every element's on-screen bounds across all three layers --- was\nreserved for interactive inspection. dumpFailure now does both, so a failure\nleaves behind the picture and the map, not just the prose.\n\nTwo things found while wiring it up:\n\nnavigateToPage and mozVerifyElementsByGroup called ScreenDump.dump directly\nrather than through dumpFailure, so the one place that decides what a failure\nrecords was bypassed by the two paths that produce most failures.\n\neffviewdump-v2.py had no --json mode, but mission-control's inspect page has\nbeen invoking it with --json and treating the usage message as \"analyzer\nfailed\" --- so that overlay has been silently broken. Added analyze(), which\nreturns the same grouping, bounds and ranked selectors the HTML overlay draws.\nEmitting them from here rather than reimplementing the ranking is the point:\notherwise the selector you are shown depends on which tool you opened.\n\nVerified end to end against a deliberate failure on the homepage: 110 selectors\nin 55 groups, page detected, screenshot and log captured.\n\nNot fixed here, because it changes what a green suite means and that is not\nmine to decide: mozVerifyElementsByGroup passes vacuously for a group name that\ndoes not exist. groupPresent does selectors.all {}, and all {} on an empty list\nis true, so a typo'd group is an assertion that cannot fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320815\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/effview/effviewdump-v2.py", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt"], "git_node": "73a0e34b337e3e9851f3ca5c909f62eee12eeb44", "git_parents": ["0d1e719c1900eea432c5c4fd5b945b5b5ff0ffaa"], "node": "830525b8aa46a2d7f221e330d7eb85444bd9479b", "parents": ["8e0afe0d0367429bf35b040e4123fc89ac8d496c"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065975 - [efficiency] Record the launch config on testStart, and add a snapshot primer r=aaronmt\n\ntestStart has always taken a meta map and nothing ever filled it, so every\nstructured trace implied a default launch. \"Was this test even running the app\nit expects?\" was therefore unanswerable after the fact, which came up\nimmediately the first time a Translations failure needed explaining --- the\nflag turned out to be applied, but only a device still running could say so.\nLaunchConfig.asMeta() puts it on the record instead.\n\nAlso adds tools.SnapshotPrimer: a BaseTest that takes its LaunchConfig from\ninstrumentation arguments, launches the app and holds it, so an emulator\nsnapshot can be taken of a device already in one group's configuration. It goes\nthrough BaseTest rather than writing preferences directly, because\nHomeActivityTestRule applies the flags and then launches --- a snapshot of\nanything else would capture a state no test is ever in.\n\nDeliberately in tools/ rather than tests/: the sweep's default suite is\nui.efficiency.tests, so this stays out of it while remaining dispatchable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320816\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/LaunchConfig.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tools/SnapshotPrimer.kt"], "git_node": "0e30d68a37012fe62b4c83701177a74caf700992", "git_parents": ["73a0e34b337e3e9851f3ca5c909f62eee12eeb44"], "node": "302e8bf9a98e9ced61680d561b1219c97cb2fbc6", "parents": ["830525b8aa46a2d7f221e330d7eb85444bd9479b"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065976 - [efficiency] Dump the screen on any test failure r=aaronmt\n\nBasePage.dumpFailure covers navigateToPage and mozVerifyElementsByGroup, but a\npage object that asserts with a bare JUnit assertTrue throws straight past it ---\nBrowserPage.verifyPageContent does exactly that. So the failures with no\npage-object verb behind them, the ones most in need of a picture, produced no\nscreenshot and no element dump at all.\n\nThe dump is wrapped INSIDE the activity rule, which matters and is not obvious:\ncatching further out photographs a black screen, because the activity rule\nfinishes the activity in its own teardown before the exception reaches anything\noutside it. The first attempt did exactly that and produced a black frame with a\nfully populated element tree, which is what gave the ordering away.\n\nVerified end to end through the dispatch API: a forced failure now yields a\nscreenshot, 85 selectors across three layers with bounds, the harness log, and\nthe launch configuration the test ran under.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320817\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt"], "git_node": "81f70b17b9034bbc980b17a448945eec57892828", "git_parents": ["0e30d68a37012fe62b4c83701177a74caf700992"], "node": "cb7869df50b973edc283334fa13efd63f6c40cd6", "parents": ["302e8bf9a98e9ced61680d561b1219c97cb2fbc6"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065977 - [efficiency] Reset the launcher icon between tests r=aaronmt\n\nThe app icon is not app data. Changing it calls\nPackageManager.setComponentEnabledSetting on activity-aliases, which lives in the\npackage manager's own state --- so `pm clear`, which wipes /data/data/\u003cpkg\u003e and\nruntime permissions, does not touch it. An icon a test switches stays switched for\nevery later test on that device.\n\nverifyTheChangeAppIconButtonTest sets the icon to Dark;\nverifyTheDefaultAppIconSettingTest then asserts it reads Default. Tests are\ndispatched per method across a work queue, so whether those two land on the same\ndevice and in which order is not fixed --- which made this an intermittent failure\nwith no intermittent cause. It was the only genuine failure in a 178-test sweep,\nand the failure screenshot showed the Customize screen reading 'Dark' where the\ntest wanted 'Default'.\n\nReset alongside the bookmarks, logins and tabs cleanup, because it is the same\nclass of problem. COMPONENT_ENABLED_STATE_DEFAULT restores whatever the manifest\ndeclares, so this is a reset rather than a guess at the right state.\n\nVerified in the worst-case order on one device --- set the icon, then assert the\ndefault --- which failed before and passes now.\n\nWorth noting for the harness generally: pm clear is the reset on read-only clones,\nand it leaves package-manager state, external storage, system settings and the\nclock alone. Measured today: a planted download directory and a changed system\nsetting both survived it. Anything a test changes outside its own app data has to\nbe undone explicitly, here or in the test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320818\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt"], "git_node": "ab850c277bfe83fb44011ca323870d64802bbb9a", "git_parents": ["81f70b17b9034bbc980b17a448945eec57892828"], "node": "2e40224fb3fef619be799ca13b0bac264b1608b0", "parents": ["cb7869df50b973edc283334fa13efd63f6c40cd6"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065971 - [efficiency] Sample app state at each test boundary r=aaronmt\n\nStateProbe reads the app's own stores --- tabs, history, bookmarks, logins, addresses, cards, top\nsites, downloads, and the launcher icon alias --- and emits one structured record at the start of\neach test and one at the end.\n\nTwo things this makes visible that nothing else does. A count above baseline at the START is state\nthe per-test reset could not clear, which is how the launcher icon leak was found and is otherwise\ninvisible until a much later test fails for an unrelated-looking reason. And on failure, comparing\nthe two samples separates 'the store has the data and the screen does not show it', a real and\nreportable defect, from 'the test never created the data' --- today both present as an element not\nbeing found.\n\nSampling is counts only and every read is wrapped: a probe that can fail a passing test would be\nworse than no probe. The record type is added to log-format.json, since consumers outside this\nrepository parse the stream.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320819\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/StateProbe.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/log-format.json"], "git_node": "83178f7ed836505890f0854410dea7c1444c1262", "git_parents": ["ab850c277bfe83fb44011ca323870d64802bbb9a"], "node": "23fa8463659285a8c902a2aeaea54e52002b896d", "parents": ["2e40224fb3fef619be799ca13b0bac264b1608b0"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065971 - [efficiency] Install the reporter before the first test's state sample r=aaronmt\n\nStateProbe.record went straight to TestLogging.reporter, which is TimedReporter.Silent until\nBaseTest's @Before installs a real one --- and a TestWatcher's starting() fires BEFORE @Before. So\nthe start sample of the FIRST test in every class was written to a reporter that discards\neverything.\n\nIt looked like an intermittent gap rather than a rule, because the reporter installed for one test\nis still installed for the next: only the first test of each class was ever missing, and only its\nstart half, which reads as a log that happened to roll over. What it actually cost is the one\nsample that matters most --- the first test in a class is the only one whose starting state was not\nproduced by the harness itself, so it is the one that can show what the DEVICE brought.\n\nThe lazy install already existed as BaseTest.installedReporter; it was just private to the class\nthat had it. Moved to TestLogging.installed() so anything running outside a test body reaches it,\nwith BaseTest delegating.\n\nVerified on device: all four methods of SettingsCustomizeTest now report a start sample, where the\nfirst previously reported none.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320820\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/StateProbe.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/TestLogging.kt"], "git_node": "83035c18b7159cf7ecd36d17de6105b0589f0f66", "git_parents": ["83178f7ed836505890f0854410dea7c1444c1262"], "node": "df4592b75102b59e7f8bd7524c222c1e77480390", "parents": ["23fa8463659285a8c902a2aeaea54e52002b896d"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065971 - [efficiency] Add a demo that leaks state on purpose r=aaronmt\n\nEvery real state leak so far has been a one-off nobody could reproduce on demand, which leaves the\nreporting for a dirty start as the part of the system never exercised. StateLeakDemoTest produces\none to order: step1 creates state, step2 inherits it, and the ledger has something real to show.\n\nThe leak is genuine rather than simulated, and building it answered a question worth recording. It\nleaks two ways: history, which is on disk in the Places database, and a download entry, which is in\nthe BrowserStore in the app's memory. Under 'am instrument' --- how the fleet dispatches, with no\nAndroidX Test Orchestrator --- the on-disk half is cleared between methods and the in-memory half\nis NOT. So the isolation boundary is the app's data directory, and anything the running process\nholds in memory crosses it freely. That is the mechanism behind a search engine still being\nDuckDuckGo four tests after the test that changed it, which had looked like the reset simply\nfailing.\n\nUnder Gradle the orchestrator gives each method its own process and neither half survives, so the\nsame pair passes both ways and only the recorded state differs --- which is precisely the\ndiscrepancy the ledger exists to surface.\n\nIn tools/ rather than tests/, so it stays out of the sweep's suite while remaining dispatchable by\nname. It cleans up after itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320821\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tools/StateLeakDemoTest.kt"], "git_node": "ed11ef6ee4b0dda527b077fb656820bd8dd2a1bd", "git_parents": ["83035c18b7159cf7ecd36d17de6105b0589f0f66"], "node": "35c49a1c766138350e1c2bd8aeab9b9d15931c6a", "parents": ["df4592b75102b59e7f8bd7524c222c1e77480390"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065974 - [efficiency] Restore --strategies, and stop reading the package as the page name r=aaronmt\n\nTwo defects in the same script, both of the same shape: a caller asks for something the script does\nnot offer, gets no error, and silently gets a worse answer.\n\n--strategies did not exist in v2. mission-control's codegen calls it to read the SelectorStrategy\nenum and validate what it is about to write; the call returned the usage text, so the set of valid\nstrategies was empty. That does not degrade codegen's answer, it inverts it. The raw-resource-id\nbranch fails CLOSED --- it will only emit UIAUTOMATOR_WITH_RAW_RES_ID if it can confirm the\nconstant exists --- so with an empty set it fell through to UIAUTOMATOR_WITH_RES_ID, which prepends\n'\u003cpackage\u003e:id/' and therefore can never match the bare Compose tag it was asked for. Every selector\ncodegen produced for a raw resource id was one that finds nothing, without erroring. The mode is\nback, reading the enum from Selector.kt rather than from a hardcoded copy, which would be the same\nfailure with an extra step. All 34 constants are found.\n\ndetect_page split every element identifier on '.' and capitalised the most common first component.\nResource ids arrive fully qualified, so a home screen with the keyboard up gave 132 elements\nbeginning 'com.google.android.inputmethod...' against 8 beginning 'homepage', and the page came out\nas 'ComPage'. Resource ids are now read from after ':id/', and reverse-DNS roots join the generic\nprefix list. The dump that produced ComPage now reads HomePage.\n\nAlso adds harnessPage to the dump: what PageStateTracker last recorded navigation reaching. The\nanalyser infers a page from pixels; this is what the harness believed. When they disagree the\nharness recorded an arrival it did not make, which is a navigation bug and was invisible before.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320822\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/effview/effviewdump-v2.py", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/ScreenDump.kt"], "git_node": "a2a475e090fad93cdf4b91b12b50c6f1c7ba24aa", "git_parents": ["ed11ef6ee4b0dda527b077fb656820bd8dd2a1bd"], "node": "25fd2c8f175d79840031579859d32fba73b23467", "parents": ["35c49a1c766138350e1c2bd8aeab9b9d15931c6a"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066003 - [efficiency] Give BaseTest one way to say how the app launches r=aaronmt\n\nThe launch configuration came from two places: seven constructor arguments on BaseTest, and an\noverridable launchConfig(). Both were live, the constructor arguments existed only to build the\ndefault the override returns, and a reader had to check both to know what a test launches with.\nAdding a flag meant changing a signature every subclass inherits.\n\nBaseTest now takes one LaunchConfig. Overriding launchConfig() stays, for the shards that pick\ntheirs from the case they were given. Seven classes passed constructor arguments; two of them ---\nMainMenuTest and SettingsPageSummariesTest --- were passing the default value, so they now pass\nnothing.\n\nThe behaviour shards had a third shape for the same idea. BehaviorBaseTestConfig held the same\nflags again, and BaseBehaviorShardTest called toBaseTestConfig() once per field to spread them\ninto the constructor for BaseTest to reassemble. It builds a LaunchConfig directly now.\n\nWorth knowing rather than a regression: that type also carried isUnifiedTrustPanelEnabled, which\nBaseTest has never accepted, so it was read from the case and dropped. A behavior case setting\nUnifiedTrustPanelEnabled has never had any effect.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320823\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/adding-navigation.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/creating-a-page-object.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/writing-a-test.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BaseBehaviorShardTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorBaseTestConfig.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorLaunchConfig.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/OnboardingPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/OnboardingSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/HomeTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/NavigationToolbarExpandedTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/OnboardingTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SearchTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsPageSummariesTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TranslationsTest.kt"], "git_node": "f9e9b178f729932e60bde7a4ae1cffa83e0712d9", "git_parents": ["a2a475e090fad93cdf4b91b12b50c6f1c7ba24aa"], "node": "0af95d4853b3e8d534e523200c237e3c529cd865", "parents": ["25fd2c8f175d79840031579859d32fba73b23467"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066003 - [efficiency] Make BaseTest's two debug hooks reachable r=aaronmt\n\nsetUp gated a navigation-path summary and a page-catalog dump on java.lang.Boolean.getBoolean,\nwhich reads a JVM system property. Instrumentation arguments do not set system properties --- they\narrive through InstrumentationRegistry --- and nothing in the tree calls System.setProperty for\neither name, so both were permanently false. The page-catalog one does reflective discovery and a\ngetter call per page, and nobody could trigger it.\n\nRead from the instrumentation arguments, the same way SnapshotPrimer already reads its own:\n\n  am instrument -e logPageCatalog true ...\n\nKept rather than deleted because they are useful diagnostics that happened to be wired to the\nwrong switch. Dead code in setUp is also what makes the setup contract hard to state, which is the\nlarger point of this cleanup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320824\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt"], "git_node": "866059486271c6449d7b8eb4c5eaf7172eb4a948", "git_parents": ["f9e9b178f729932e60bde7a4ae1cffa83e0712d9"], "node": "303ccf6e90f9a7b238d694dc3514b583232b9e7d", "parents": ["0af95d4853b3e8d534e523200c237e3c529cd865"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066003 - [efficiency] Name the per-test cleanup, and stop it failing silently r=aaronmt\n\nThe clears lived inline in BaseTest's rule, each wrapped in runCatching with a log line. That makes\na clear that errored indistinguishable from a genuine state leak: both present as a later test\nstarting with state it did not create, and the comment in the file already said as much.\n\nAppDataCleaner is that list as one named unit. Each step has a name, clear() returns the ones that\nfailed, and it emits a `cleanup` record on the structured stream carrying the phase and the failed\nsteps --- so a consumer can say \"clean, but the clear that would have made it clean errored\",\nwhich is a different and far more actionable fact than either \"clean\" or \"dirty\". Added to\nlog-format.json, since consumers of that stream live outside this repository.\n\nStill best-effort, deliberately: a cleanup that fails the test it was preparing is worse than one\nthat did not happen. The change is that it is no longer silent.\n\nBehaviour is otherwise unchanged --- same steps, same order, same runCatching per step. The\nlauncher-icon reset moves across with its comment intact.\n\nNote recorded in the class rather than left to be rediscovered: FenixTestRule at order 0 wraps\nTestSetupRule, which separately clears history, bookmarks, site permissions, downloads and\nnotifications before any of this runs. The effective per-test cleanup is the union of the two, and\nreading either alone gives the wrong answer about what leaks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320825\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/AppDataCleaner.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/log-format.json"], "git_node": "f4603ead492a82389bb1ba9e39898b78f7e712d5", "git_parents": ["866059486271c6449d7b8eb4c5eaf7172eb4a948"], "node": "910084e97348d913eee9e08d64e98d5fb37628e7", "parents": ["303ccf6e90f9a7b238d694dc3514b583232b9e7d"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066003 - [efficiency] Clean up after a test, and sample what it inherited r=aaronmt\n\nTwo halves of the same defect: the harness could not see state arriving, and did not tidy up state\nleaving.\n\nCLEANING ONLY AT THE START. Every clear ran in the rule's before-phase, so a failing test left\neverything it created on the device until the NEXT test cleared up on its behalf --- and if it was\nthe last test in the class, indefinitely. That is why devices are found dirty long after a run\nends. AppDataCleaner now also runs in a finally, so the failure case, which is the one that used\nto leave the mess, is tidied up too.\n\nSAMPLING TOO LATE TO SEE ANYTHING. StateProbe took its \"start\" reading from a watcher at rule order\n2, nested inside every cleanup there is. So it always sampled AFTER the harness had cleared what it\nclears, and app-data dirt could essentially never be reported --- the probe answered \"did the\ncleanup work\" when the question was \"what did this device bring\".\n\nThere is now an arrival sample at rule order -1, outside FenixTestRule. A lower order is applied\nfurther out, and FenixTestRule at 0 wraps TestSetupRule, whose before() clears history, bookmarks,\nsite permissions, downloads and notifications. Measured rather than reasoned: with the sample at\norder 1 the leak demo reported its inherited downloads and not its inherited history, because\nhistory had already been cleared two layers out. At order -1 it reports both.\n\nThe ledger reads dirt from arrival, falling back to start for runs recorded before this existed,\nand separately reports what the cleanup removed --- not dirt, since the harness handled it, but\nthe evidence a leak existed at all, which \"clean\" alone erases.\n\nVerified on device with tools/StateLeakDemoTest:\n  step1  arrival clean, changed history 0-\u003e3 and downloads 0-\u003e3\n  step2  arrival dirty history=3 downloads=3, cleanup removed history 3-\u003e0\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320826\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt"], "git_node": "79fc7d7c831d7e5a21e3dc7ec7fa030619e9e2df", "git_parents": ["f4603ead492a82389bb1ba9e39898b78f7e712d5"], "node": "a6ea627499c13db6ba3e6e4dbff7a4c74fed28a9", "parents": ["910084e97348d913eee9e08d64e98d5fb37628e7"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066003 - [efficiency] Give BaseTest's two process globals an owner r=aaronmt\n\nsetUp mutated two pieces of process-wide state and restored neither.\n\nESPRESSO'S FAILURE HANDLER is a singleton. Replacing it stops Espresso's screenshot-on-failure\ntripping Fenix's StrictMode penaltyDeath, which is a real problem and well documented in the file,\nbut it was being set on every test and never put back. Under `am instrument` the process is shared\nacross a class's methods, so \"per test\" was never true --- it was the same value written\nrepeatedly to a global with no owner. Installed once per process now.\n\nPAGESTATETRACKER is a mutable global written by every page object. It stays global, because\nthreading it through every page object would be boilerplate on all of them, but it now has an\nowner and a vocabulary: reset() instead of assigning a bare \"AppEntry\", and ENTRY naming the value\nthat means \"nowhere yet\" rather than repeating the string at each site. SettingsAppIconPage was\nthe other place repeating it.\n\nThe reason this is worth more than tidiness now: ScreenDump writes the tracker into every failure\nas `harnessPage`, and mission-control shows it beside the page its analyser infers from the\nscreen. A disagreement means navigation recorded an arrival it did not make, which is a real\nfinding --- so a stale tracker has gone from an internal inconsistency to a false accusation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320827\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageStateTracker.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsAppIconPage.kt"], "git_node": "f932ea2e894f30fc775f7809556f66b25cd218f4", "git_parents": ["79fc7d7c831d7e5a21e3dc7ec7fa030619e9e2df"], "node": "7f5ee006b440fd4650dc32c79e28ec7390a2a95f", "parents": ["a6ea627499c13db6ba3e6e4dbff7a4c74fed28a9"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066003 - [efficiency] Say what rule order guarantees, instead of asserting it with !! r=aaronmt\n\ncomposeRule was a `!!` on a nullable backing field. Reading it before the rule at order 1 built it\ngave a NullPointerException and no hint of the cause, and the cause is a rule ordering that was\nnowhere written down. It is now a checkNotNull whose message states the ordering: outermost-first\nby ascending order, -1 samples arrival, 0 is FenixTestRule, 1 builds the activity rule, 2 records\nboundaries --- so anything at a lower order, or outside a test body, runs before it exists.\n\nThat hazard has already cost one silent bug. A watcher at order 2 recorded state through a\nreporter a later @Before had not installed yet, so the first test of every class lost its sample\nand nothing said so. The message will not prevent the next one, but it will name it in a second\nrather than an afternoon.\n\nAlso corrects a claim in the same block that was load-bearing and false. The no-retry comment\njustified itself with \"every test already runs in its own process with package data cleared\n(ANDROIDX_TEST_ORCHESTRATOR + clearPackageData)\". True under Gradle. False under `am instrument`,\nwhich is how the fleet dispatches: no orchestrator, no clearPackageData, so a class's methods share\none process and one data directory. Verified --- a download added to the BrowserStore in one method\nis still present at the start of the next, while on-disk history is not.\n\nThe decision it justifies is still right; the reason given for it was only true on one of the two\npaths we run, and the file said so to anyone reading it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320828\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt"], "git_node": "573fb4e603e92d60175488013959a7e249b9b825", "git_parents": ["f932ea2e894f30fc775f7809556f66b25cd218f4"], "node": "7f97edb7b4765ad47ede99764aca9bd2c9370210", "parents": ["7f5ee006b440fd4650dc32c79e28ec7390a2a95f"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066003 - [efficiency] State what a test starts with, in one place r=aaronmt\n\nThe setup an efficiency test inherits was spread across three rules and written down in none of\nthem, so the only way to know what a test begins with was to read all three and hold the union in\nyour head. That is not a hypothetical cost. Writing up the state boundaries I concluded from\nBaseTest alone that history leaks between tests; it does not, because TestSetupRule clears it two\nlayers further out, and only catching deleteHistoryStorage in logcat settled it.\n\nBaseTest's class documentation is now that list. The rules in the order they run, what each one\nclears, and --- the part that matters most and was nowhere --- what NOTHING clears: the Gecko\nprofile in external storage with its cookies and HSTS state and certificates, the default search\nengine, fenix_preferences.xml, and anything the running process holds in memory, which under\n`am instrument` crosses freely between the methods of a class.\n\nReplaces documentation that described the logging design and the long-term intent for it. That\nmaterial is still true but it answered a question nobody has in front of a red test; the logging\nsection is now four lines and points at the contract file.\n\nNo behaviour change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320829\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt"], "git_node": "c12a8cfd1c812b561151cf8f67fcadc9325496ad", "git_parents": ["573fb4e603e92d60175488013959a7e249b9b825"], "node": "22cd358ee6c6f74680edb688bb54978217c18653", "parents": ["7f97edb7b4765ad47ede99764aca9bd2c9370210"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2061689 - Update audioipc r=padenot,supply-chain-reviewers,afranchuk\n\nDi