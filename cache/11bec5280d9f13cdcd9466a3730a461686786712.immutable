"toolkit/components/protobuf/src/google/protobuf/wrappers.pb.cc", "toolkit/components/protobuf/src/google/protobuf/wrappers.pb.h", "toolkit/components/reputationservice/chromium/chrome/common/safe_browsing/csd.pb.cc", "toolkit/components/reputationservice/chromium/chrome/common/safe_browsing/csd.pb.h", "toolkit/components/url-classifier/chromium/safebrowsing.pb.cc", "toolkit/components/url-classifier/chromium/safebrowsing.pb.h", "toolkit/components/url-classifier/chromium/safebrowsing_v5.pb.cc", "toolkit/components/url-classifier/chromium/safebrowsing_v5.pb.h"], "git_node": "0de7e2adb700bd0d4440aeb450c769e204f9b870", "git_parents": ["419ae15dad4378443d8172d8cc6f6c8091d56f72"], "node": "1d58540e1bfd83214611f3b23ccd9e843e9f7e07", "parents": ["b44af76934e8aa0313a4b1be12544baad9833ae3"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065936 - Update prost-build to 0.14.4 and regenerate its output. r=timhuang\n\ntoolkit/components/protobuf/scripts sits in the workspace exclude list, so prost-build is\nresolved from crates.io when the generator runs rather than vendored, and the bump carries no\nsupply-chain review. The lock also drops the getrandom chain that 0.14.3 pulled in.\n\nThe regenerated opentelemetry bindings are not fallout from the bump. 0.14.4 emits output byte\nidentical to 0.14.3; the checked-in files simply predate the move to prost-build 0.14, so they\nstill carry #[allow(clippy::derive_partial_eq_without_eq)], lack the Eq and Hash derives the\ngenerator adds where every field supports them, and spell match arms with the enum name rather\nthan Self.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320756\n", "files": ["third_party/opentelemetry-cpp/third_party/opentelemetry-proto/opentelemetry.proto.collector.trace.v1.rs", "third_party/opentelemetry-cpp/third_party/opentelemetry-proto/opentelemetry.proto.common.v1.rs", "third_party/opentelemetry-cpp/third_party/opentelemetry-proto/opentelemetry.proto.resource.v1.rs", "third_party/opentelemetry-cpp/third_party/opentelemetry-proto/opentelemetry.proto.trace.v1.rs", "toolkit/components/protobuf/scripts/Cargo.lock", "toolkit/components/protobuf/scripts/Cargo.toml"], "git_node": "1580ea22df4bd5ba3248447d445d8861dcec4b64", "git_parents": ["0de7e2adb700bd0d4440aeb450c769e204f9b870"], "node": "d41ce4f9a467a8b4d6dcee9b2e8aeaba43cf84d1", "parents": ["1d58540e1bfd83214611f3b23ccd9e843e9f7e07"], "tags": []}, {"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065788 - Improve the type hints in Log.sys.mjs. r=Standard8\n\nThis makes it so that that it's possible to do to the definition of\nthe logging functions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320668\n", "files": ["toolkit/modules/Log.sys.mjs"], "git_node": "51a57d8c86e14fcd748462a67b8205e2079b71af", "git_parents": ["1580ea22df4bd5ba3248447d445d8861dcec4b64"], "node": "8b8bde1de43490efdba94ece05bf7dac19321531", "parents": ["d41ce4f9a467a8b4d6dcee9b2e8aeaba43cf84d1"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059662 - Screen reader announces Firefox VPN location list items as radio buttons - r=ip-protection-reviewers,kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316112\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/content/locations-list.mjs", "browser/components/ipprotection/content/locations-subview.css", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_keyboard_navigation.js", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_list.js"], "git_node": "d7270e16bb2289029fe8bb21075d3680db24ce61", "git_parents": ["51a57d8c86e14fcd748462a67b8205e2079b71af"], "node": "e27b5076a50702191b02b6fe032e0a09ae7cf528", "parents": ["8b8bde1de43490efdba94ece05bf7dac193