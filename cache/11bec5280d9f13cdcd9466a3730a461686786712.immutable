/helpers/ScreenDump.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BookmarksPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/NotificationRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuAutofillRobot.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bookmarks/NavBarUtilsKtTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bookmarks/UtilsKtTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/fake/FakeBookmarksStorage.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/CustomTabBrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/ActivityTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/helpers/ShadowBoundsReportingBitmapFactory.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/labs/middleware/LabsMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/summarization/onboarding/FenixSummarizationFeatureConfigurationTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/ChangeAppLauncherIconTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/middleware/WebCompatReporterSubmissionMiddlewareTest.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/helpers/TestHelper.kt"], "git_node": "54b12936ba9e981bcb84b8d241b5c18e3867c57c", "git_parents": ["476929c59ccd976cddc1fb5bc4e04acd5925e9af"], "node": "635cad17b2fbf095e50a3eec61f68f41a7057add", "parents": ["4c7be61ea5c977e5f58f5cb8a12420e3aab43d19"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049696 - Fix outdated KDoc on Android test helpers r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319342\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/customannotations/Converted.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/customannotations/SkipLeaks.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/HomeActivityTestRule.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/MockBrowserDataHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/perf/FenixDetectLeaksAssert.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsAutofillPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/BrowserRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuSearchRobot.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/helpers/FenixGleanTestRule.kt"], "git_node": "d158b255d1c74d78da3ce81c8deb80297d3a45ae", "git_parents": ["54b12936ba9e981bcb84b8d241b5c18e3867c57c"], "node": "b6b1aefb40ef9e7e462d4008a284a90309810cb7", "parents": ["635cad17b2fbf095e50a3eec61f68f41a7057add"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049696 - Run detekt over the Fenix, Focus and android-components test sources r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319343\n", "files": ["mobile/android/android-components/build.gradle", "mobile/android/fenix/app/build.gradle", "mobile/android/focus-android/app/build.gradle"], "git_node": "f2046653ba1dd98034fdb58df324b8376ccd4b89", "git_parents": ["d158b255d1c74d78da3ce81c8deb80297d3a45ae"], "node": "b246d76dcf2209c1f3b96a5a28898583c302233f", "parents": ["b6b1aefb40ef9e7e462d4008a284a90309810cb7"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065833 - Stop the Gradle dependency proxies answering 404 while a remote is unreachable r=RyanVM\n\nWhen an upstream repository returns a transient server error, Nexus automatically blocks it and answers\nuncached artifact requests with 404. Gradle treats those artifacts as nonexistent and omits them from\nboth the mirror and its own inventory, so the completeness check passes.\n\nThe toolchain then publishes an incomplete mirror. Downstream jobs using that mirror find the module\nmetadata but not its AAR, making the failure appear downstream even though it occurred while producing\nthe mirror.\n\nD319977 disabled caching of not found responses, but automatic blocking is separate. Disable it on the\nfour repositories the task uses so each request can reach the upstream repository instead of one\ntransient error making uncached artifacts appear missing for the entire automatic blocking window.\nLeave apache snapshots unchanged because the task neither resolves through nor packages it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320706\n", "files": ["taskcluster/scripts/misc/android-gradle-dependencies/nexus.xml"], "git_node": "90ca614c10df57f7302c473312f56a66389de970", "git_parents": ["f2046653ba1dd98034fdb58df324b8376ccd4b89"], "node": "0038d99757ac82b906cf48bb144aa83b592952fc", "parents": ["b246d76dcf2209c1f3b96a5a28898583c302233f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030831 - Relax `a-s` version ping on try r=nalexander,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292594\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/DependenciesPlugin.kt"], "git_node": "5244af9e826095ae7c36b25ad7e59f8e3f47bdd6", "git_parents": ["90ca614c10df57f7302c473312f56a66389de970"], "node": "950359413116215dbcbd6562da81c02c292f34ca", "parents": ["0038d99757ac82b906cf48bb144aa83b592952fc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065760 - Disable MSVC STL \u003coptional\u003e ASan annotations on clang-cl Windows ASan builds. r=firefox-build-system-reviewers,ahochheiden\n\nMSVC STL 14.51 added ASan annotations to \u003coptional\u003e that poison the storage of\ndisengaged optionals. At -O2 this produces false-positive use-after-poison\nreports in valid code that guards its loads behind has_value(); at -O0 it does\nnot.\n\nThe annotations are new in 14.51, so disabling them gives up coverage we never\nhad. The vector and string container annotations are left enabled.\n\nThe define has to apply to every translation unit: the annotation header\nenforces consistency via #pragma detect_mismatch, so defining it for part of\nthe tree fails to link.\n\nTracked as llvm/llvm-project#204041, and reproduces on clang 20, 21 and 22.\nOriginally filed as microsoft/STL#6291, which was labelled external on the\ngrounds that the optimizer should not move those loads outside the branch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320656\n", "files": ["build/moz.configure/toolchain.configure"], "git_node": "48e4438fe6e158f55e8c1176afb6c7be6c94abf9", "git_parents": ["5244af9e826095ae7c36b25ad7e59f8e3f47bdd6"], "node": "04db90da72cdb3f08b33b4446f3f612bc333d25a", "parents": ["950359413116215dbcbd6562da81c02c292f34ca"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065760 - Cherry-pick an upstream onnxruntime fix to avoid LNK1248 under MSVC 14.51. r=firefox-build-system-reviewers,ahochheiden\n\nWith onnxruntime_ENABLE_LTO the provider objects carry whole-program IR, which\npushes onnxruntime_providers.lib past the 4 GiB limit lib.exe enforces on the\nCOFF archive format. MSVC 14.51 tips it a few MB over on both x86_64 and i686,\nso the Windows toolchain build fails to link.\n\nThe fix builds the providers as an object library rather than an archive on\nMSVC shared-library builds, which only need the objects for the final link.\nCherry-picked from microsoft/onnxruntime#32162, not yet merged.\n\nThe hunks for onnxruntime_unittests.cmake, onnxruntime_providers_webgpu.cmake\nand onnxruntime_providers_pch.cmake are omitted: they do not apply to the\npinned revision and cover code this build does not configure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320657\n", "files": ["taskcluster/scripts/misc/onnxruntime.patches/0006-Separate-provider-compilation-from-its-archive-on-MS.patch"], "git_node": "61d9b5d17265c607ec48ad7738244a947a030c00", "git_parents": ["48e4438fe6e158f55e8c1176afb6c7be6c94abf9"], "node": "ccecde6ddee5ce07a713bfcc0df40f08b56171a2", "parents": ["04db90da72cdb3f08b33b4446f3f612bc333d25a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065760 - Update the VS 2026 toolchain to 18.9.1 and Windows SDK 10.0.28000.2114 r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320658\n", "files": ["build/vs/vs2026-aarch64.yaml", "build/vs/vs2026.yaml", "taskcluster/scripts/misc/vs-setup.sh"], "git_node": "fb65b9edaf6aff986beabb8308812b3022b35a5b", "git_parents": ["61d9b5d17265c607ec48ad7738244a947a030c00"], "node": "b39891d7c0c8ae87433e80412f177757dc74a37d", "parents": ["ccecde6ddee5ce07a713bfcc0df40f08b56171a2"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2065649 - Build option list by deeply traversing select subtree r=emilio,firefox-style-system-reviewers,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320588\n", "files": ["browser/base/content/test/forms/browser.toml", "browser/base/content/test/forms/browser_selectpopup_option_in_div.js", "layout/forms/nsListControlFrame.cpp", "layout/reftests/forms/select/option-in-div-multiple-ref.html", "layout/reftests/forms/select/option-in-div-multiple.html", "layout/reftests/forms/select/option-in-div-notref.html", "layout/reftests/forms/select/option-in-div-ref.html", "layout/reftests/forms/select/option-in-div.html", "layout/reftests/forms/select/reftest.list", "layout/style/res/forms.css", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-size-multiple-new-content.html.ini", "toolkit/actors/SelectChild.sys.mjs"], "git_node": "0e741ea3df9abb26ec1efce720bc725a8c9f84f4", "git_parents": ["fb65b9edaf6aff986beabb8308812b3022b35a5b"], "node": "0a5a1aa89ade9350ccc30ab411f1b283c2f2db93", "parents": ["b39891d7c0c8ae87433e80412f177757dc74a37d"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047435 - XPCOM: add copy file tests r=xpcom-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306645\n", "files": ["xpcom/tests/gtest/TestFile.cpp", "xpcom/tests/gtest/moz.build"], "git_node": "70f00d9f45b90c208ac2f174dcfa770b8ea08da6", "git_parents": ["0e741ea3df9abb26ec1efce720bc725a8c9f84f4"], "node": "b92fe4c4bfb6d8b0b8326fd584501470ec850f2e", "parents": ["0a5a1aa89ade9350ccc30ab411f1b283c2f2db93"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047435 - XPCOM: use fast native functions for file copies on macOS and Linux r=xpcom-reviewers,jld,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306646\n", "files": ["xpcom/io/nsLocalFileUnix.cpp"], "git_node": "29afba7eb136844ede1f39d166db1ef17ac74ae5", "git_parents": ["70f00d9f45b90c208ac2f174dcfa770b8ea08da6"], "node": "dfede6d4424e10d17da17ca5b103e7dcae919332", "parents": ["b92fe4c4bfb6d8b0b8326fd584501470ec850f2e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065672 - Avoid inflating inline stylesheet text just to turn it into utf-8 again. r=dom-core-reviewers,smaug\n\nMost inline stylesheets are actually ascii / use Latin1 storage, so it's\nfaster to just copy it out that to inflate just to deflate it before\nparsing.\n\nDo the same trick we use for \u003cscript\u003e elements and CSP and retrieve the\ntwo-byte text there instead. Chances are we want to just use the utf-8\ntext there, since that's what we end up using for the hash / nonce:\n\n  https://searchfox.org/firefox-main/rev/2916f047242de012d1aa0c572be9e5239644cc48/dom/security/nsCSPUtils.cpp#1020-1021\n\nBut plumbing that through gets a bit annoying.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320598\n", "files": ["dom/base/CharacterData.h", "dom/base/CharacterDataBuffer.h", "dom/base/LinkStyle.cpp", "dom/base/LinkStyle.h", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/security/nsCSPContext.cpp", "layout/style/Loader.cpp", "layout/style/Loader.h", "layout/style/SharedStyleSheetCache.h", "testing/web-platform/tests/html/semantics/document-metadata/the-style-element/style-multibyte-text.html"], "git_node": "a2666940ab8875cce1d1970501f67a5f30efb481", "git_parents": ["29afba7eb136844ede1f39d166db1ef17ac74ae5"], "node": "d67e01c46a66136be42b53e85251d46a27f35212", "parents": ["dfede6d4424e10d17da17ca5b103e7dcae919332"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065844 - Remove cargo_build_defs.py. r=firefox-build-system-reviewers,ahochheiden\n\nNothing uses cargo_extra_outputs, should've been removed in D73911.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320613\n", "files": ["python/mozbuild/mozbuild/backend/cargo_build_defs.py"], "git_node": "f7b32f4733ec57a09c17a47500f8fb05ea8633cf", "git_parents": ["a2666940ab8875cce1d1970501f67a5f30efb481"], "node": "c818c1855731e87d6138e4c7472c634753bfc68d", "parents": ["d67e01c46a66136be42b53e85251d46a27f35212"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047435 - XPCOM: use fast native functions for file copies on macOS and Linux r=xpcom-reviewers,jld,emilio\" for causing windows gtest assertions on nsLocalFileWin.cpp.\n\nThis reverts commit 29afba7eb136844ede1f39d166db1ef17ac74ae5.\n\nRevert \"Bug 2047435 - XPCOM: add copy file tests r=xpcom-reviewers,emilio\"\n\nThis reverts commit 70f00d9f45b90c208ac2f174dcfa770b8ea08da6.\n", "files": ["xpcom/io/nsLocalFileUnix.cpp", "xpcom/tests/gtest/TestFile.cpp", "xpcom/tests/gtest/moz.build"], "git_node": "2f4359d953b4d7b323904995ef9b4587386678d6", "git_parents": ["f7b32f4733ec57a09c17a47500f8fb05ea8633cf"], "node": "fa137164edc5c8e19d78b2a3a3766c311bfd77f4", "parents": ["c818c1855731e87d6138e4c7472c634753bfc68d"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/feature/addons/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gn/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pa-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml"], "git_node": "6f2ad4d0e78ccf1abe5075862403037ae89194c1", "git_parents": ["2f4359d953b4d7b323904995ef9b4587386678d6"], "node": "995a9ed5db2f78af713be296497df0e431752efe", "parents": ["fa137164edc5c8e19d78b2a3a3766c311bfd77f4"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2065649 - Build option list by deeply traversing select subtree r=emilio,firefox-style-system-reviewers,layout-reviewers\" for causing wpt failures in select-as-listbox-default-styles.tentative.html\n\nThis reverts commit 0e741ea3df9abb26ec1efce720bc725a8c9f84f4.\n", "files": ["browser/base/content/test/forms/browser.toml", "browser/base/content/test/forms/browser_selectpopup_option_in_div.js", "layout/forms/nsListControlFrame.cpp", "layout/reftests/forms/select/option-in-div-multiple-ref.html", "layout/reftests/forms/select/option-in-div-multiple.html", "layout/reftests/forms/select/option-in-div-notref.html", "layout/reftests/forms/select/option-in-div-ref.html", "layout/reftests/forms/select/option-in-div.html", "layout/reftests/forms/select/reftest.list", "layout/style/res/forms.css", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-size-multiple-new-content.html.ini", "toolkit/actors/SelectChild.sys.mjs"], "git_node": "8e712beaf34237da899ef30a8dfcb352e65c0516", "git_parents": ["6f2ad4d0e78ccf1abe5075862403037ae89194c1"], "node": "c037701abcbe36f6bbb3e6f6d0f7c65e41fc1fcf", "parents": ["995a9ed5db2f78af713be296497df0e431752efe"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2065665 - Use getService for protocol-proxy-service in socks_client_subprocess.js. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320595\n", "files": ["netwerk/test/unit/socks_client_subprocess.js"], "git_node": "dbb64e7911d8507433dbd6a8f9a3eb3292e99d6e", "git_parents": ["8e712beaf34237da