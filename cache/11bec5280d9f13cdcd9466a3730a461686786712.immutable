.services.mozilla.com/D304717\n", "files": ["dom/media/webrtc/CodecInfo.cpp", "dom/media/webrtc/jsapi/DefaultCodecPreferences.cpp", "dom/media/webrtc/jsapi/DefaultCodecPreferences.h", "dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.h", "dom/media/webrtc/jsapi/RTCRtpSender.cpp", "dom/media/webrtc/jsapi/RTCRtpTransceiver.cpp", "dom/media/webrtc/jsep/JsepCodecDescription.h", "media/webrtc/signaling/gtest/MockJsepCodecPreferences.h", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp"], "git_node": "4d48e7b536ce1ae90224f9ee72bf5704b908ce33", "git_parents": ["1c5c81befa5930b89538f366aba9aa1a642b30ab"], "node": "896cfe3f1418db6dfe35188aa7ff3319e21d2034", "parents": ["1b5b5c583fddcf3be2f30935da489f96060da41c"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043211 - Remove redundant CodecOverrides setters. r=webrtc-reviewers,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304693\n", "files": ["media/webrtc/signaling/gtest/jsep_track_unittest.cpp"], "git_node": "2e1ec0ab37485319cc24b1d1c48f73d59220c3c2", "git_parents": ["4d48e7b536ce1ae90224f9ee72bf5704b908ce33"], "node": "3764832c2aa7c2691215241f3101a49db1eb3f8f", "parents": ["896cfe3f1418db6dfe35188aa7ff3319e21d2034"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043211 - In jsep, move rtp header extensions to nsTArray. r=webrtc-reviewers,dbaker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308242\n", "files": ["dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.h", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp"], "git_node": "a8f84aef65c7a208e7acbbcb952b95a161bbb319", "git_parents": ["2e1ec0ab37485319cc24b1d1c48f73d59220c3c2"], "node": "bff69e60524d019b04e71be5fc766150811211c2", "parents": ["3764832c2aa7c2691215241f3101a49db1eb3f8f"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043211 - In jsep, move rtp header extensions to nsCString. r=webrtc-reviewers,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304695\n", "files": ["dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.h", "dom/media/webrtc/jsapi/RTCRtpReceiver.cpp", "dom/media/webrtc/jsapi/RTCRtpTransceiver.cpp", "dom/media/webrtc/jsep/JsepSession.h", "dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/jsep/JsepSessionImpl.h", "dom/media/webrtc/jsep/JsepTrack.h", "dom/media/webrtc/sdp/RsdparsaSdpAttributeList.cpp", "dom/media/webrtc/sdp/SdpAttribute.cpp", "dom/media/webrtc/sdp/SdpAttribute.h", "dom/media/webrtc/sdp/SipccSdpAttributeList.cpp", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp", "media/webrtc/signaling/gtest/jsep_track_unittest.cpp", "media/webrtc/signaling/gtest/sdp_unittests.cpp"], "git_node": "cf89e059505a708af0ec524a2dddd3602a178cf0", "git_parents": ["a8f84aef65c7a208e7acbbcb952b95a161bbb319"], "node": "562acd7d20470a8e561ca9c8ec0b17709c0ef1da", "parents": ["bff69e60524d019b04e71be5fc766150811211c2"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043211 - Add PeerConnectionImpl unittests for transport-cc pref behavior. r=dbaker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309669\n", "files": ["media/webrtc/signaling/gtest/moz.build", "media/webrtc/signaling/gtest/peer_connection_unittest.cpp"], "git_node": "e6a7f977b52bc1d3186cbceafc75c407a898af7a", "git_parents": ["cf89e059505a708af0ec524a2dddd3602a178cf0"], "node": "387d31b153e0115fd36689c7f02e54b9c2449568", "parents": ["562acd7d20470a8e561ca9c8ec0b17709c0ef1da"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062848 - Fix clipped digit visual issue on show trackers when resizing browser window. r=desktop-theme-reviewers,emilio\n\nPlease see the recording in this ticket for the visual issue.\nhttps://mozilla-hub.atlassian.net/jira/software/c/projects/FELTPY/boards/13722?selectedIssue=FELTPY-119\n\nAnother relevant Slack discussion: https://mozilla.slack.com/archives/C4D3JFF26/p1785182348472679\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318471\n", "files": ["browser/themes/shared/identity-block/identity-block.css"], "git_node": "0da9cf6b210ec3a8a8825e98d321636902129908", "git_parents": ["e6a7f977b52bc1d3186cbceafc75c407a898af7a"], "node": "9a31035ecba4f6bb9bc13522efa713b5ee7776bb", "parents": ["387d31b153e0115fd36689c7f02e54b9c2449568"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052649 - Make IsFollowedByCompositionEnd() return true for non-duplicated commit events. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317951\n", "files": ["editor/libeditor/tests/mochitest.toml", "editor/libeditor/tests/test_blur_in_compositionend.html", "widget/TextEvents.h"], "git_node": "51cc64c9cb1580b8489fc026d79ded5fd0f04895", "git_parents": ["0da9cf6b210ec3a8a8825e98d321636902129908"], "node": "a63271d1da9c60b0aa1166edf7e4a060994e3254", "parents": ["9a31035ecba4f6bb9bc13522efa713b5ee7776bb"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062642 - Enable hw support for AV1 in WebRTC with a pref, when available on the platform. r=webrtc-reviewers,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318439\n", "files": ["dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-webrtc-power-efficient.any.js.ini"], "git_node": "f0d3afb79027ba9d6a22e1545578409a8fe9e9cc", "git_parents": ["51cc64c9cb1580b8489fc026d79ded5fd0f04895"], "node": "6a9722e1a011a0e3f5dd4d647c02a992b5840d8b", "parents": ["a63271d1da9c60b0aa1166edf7e4a060994e3254"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2060947 - Only create ProfilerParentTracker in the parent process r=florian,profiler-reviewers\n\nProfilerParentTracker is a class specifically for the parent process,\nbut it looks like we never prevent it from being called from child\nprocesses. This patch adds this early return. This is fine because all\nthe callers check for nullptr.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319059\n", "files": ["tools/profiler/gecko/ProfilerParent.cpp"], "git_node": "adc9e055e1513b5638724e190649ccebf7372a98", "git_parents": ["f0d3afb79027ba9d6a22e1545578409a8fe9e9cc"], "node": "1914d25e6ab7f958dda8ebdc5411f177649155ae", "parents": ["6a9722e1a011a0e3f5dd4d647c02a992b5840d8b"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057580 - Resolve local_rate_limited error on mobile applink startup tests. r=perftest-reviewers,mozperftest-reviewers,taskgraph-reviewers,bhearsum,kshampur\n\nWe're been seeing more and more local_rate_limited errors on tests related to the live shopify page.\nTo resolve this we are doing 2 things:\n1) We will convert restore startup tests to use locally hosted newssite, not live shopify page\n2) Stop running the a55 shopify applink startup tests on autoland\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314097\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/perftest/android.yml", "testing/performance/mobile-startup/cvne-newssite.sh", "testing/performance/mobile-startup/expected_startup_screenshots/chrome-m-mobile_restore-a55.png", "testing/performance/mobile-startup/expected_startup_screenshots/chrome-m-mobile_restore-p6.png", "testing/performance/mobile-startup/expected_startup_screenshots/chrome-m-mobile_restore-s24.png", "testing/performance/mobile-startup/expected_startup_screenshots/fenix-mobile_restore-a55.png", "testing/performance/mobile-startup/expected_startup_screenshots/fenix-mobile_restore-p6.png", "testing/performance/mobile-startup/expected_startup_screenshots/fenix-mobile_restore-s24.png", "testing/performance/mobile-startup/newssite-setup.sh", "testing/performance/mobile-startup/restore.sh"], "git_node": "0ae5f702756789ee622cceeb9284075a009cbcc7", "git_parents": ["adc9e055e1513b5638724e190649ccebf7372a98"], "node": "b740db1a24cfc44dab903f209c309fd29dcf4921", "parents": ["1914d25e6ab7f958dda8ebdc5411f177649155ae"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060941 - Migrate resourse usage tests away from bitbar to lambdatest. r=perftest-reviewers,mozperftest-reviewers,afinder,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316592\n", "files": ["taskcluster/kinds/perftest/android.yml"], "git_node": "f0ddb9f1bdb19e8cff0b3b6ef8e3a24ea380db1a", "git_parents": ["0ae5f702756789ee622cceeb9284075a009cbcc7"], "node": "4084816b2fcc6cd27481c2cc2669ca04ab80f8e2", "parents": ["b740db1a24cfc44dab903f209c309fd29dcf4921"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2054635 - Test custom element reparenting during construction r=dom-core-reviewers,vhilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312077\n", "files": ["testing/web-platform/tests/custom-elements/parser/xml-parser-custom-element-reparents-during-construction.xhtml"], "git_node": "ebd7af0a360aff7d67868210e0c34f8b94ab2641", "git_parents": ["f0ddb9f1bdb19e8cff0b3b6ef8e3a24ea380db1a"], "node": "c2e70ff2dc983c68deb755ddea6d5f470e5b05bf", "parents": ["4084816b2fcc6cd27481c2cc2669ca04ab80f8e2"], "tags": []}, {"author": "Robert Mader \u003crobert.mader@collabora.com\u003e", "branch": "default", "desc": "Bug 2056029 - WebRTC backport: video_capture: Implement buffer stride support for Pipewire r=pehrsons,grulja\n\nSimple backport of https://webrtc-review.googlesource.com/c/src/+/491680\n\nUpstream commit: 5da5a6e4e00c69ef60c7643e99ef34f65f7af51a\n\nFrom the commit message:\nAdd optional buffer stride support to VideoCaptureImpl and use it in\nVideoCaptureModulePipeWire, allowing us to drop the requirement for\nunpadded buffers. This notably improves compatibility with libcamera,\nwhich supports a wider range of devices than the V4L2 backend - some\nhaving hardware requirements for stride-alignment.\n\nExtending `ConvertToI420()` in libyuv was rejected on the grounds that\nthere are various approaches to stride handling - using a single stride\nvalue for multiple planes, having explicit values for each one etc. - as\nwell as the fact that we might well want to extend the helper further in\nthe future - e.g. in order to better handle color spaces such as BT709\n(instead of always assuming BT601).\n\nThus this patch now adds a local copy of `ConvertToI420()`, supporting\nimplicit and a single explicit stride value for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312871\n", "files": ["third_party/libwebrtc/common_video/BUILD.gn", "third_party/libwebrtc/common_video/common_video_gn/moz.build", "third_party/libwebrtc/common_video/libyuv/include/webrtc_libyuv.h", "third_party/libwebrtc/common_video/libyuv/libyuv_unittest.cc", "third_party/libwebrtc/common_video/libyuv/webrtc_libyuv.cc", "third_party/libwebrtc/modules/video_capture/linux/video_capture_pipewire.cc", "third_party/libwebrtc/modules/video_capture/video_capture.h", "third_party/libwebrtc/modules/video_capture/video_capture_impl.cc", "third_party/libwebrtc/modules/video_capture/video_capture_impl.h", "third_party/libwebrtc/moz-patch-stack/5da5a6e4e0.no-op-cherry-pick-msg"], "git_node": "958cc9da5f101c1b4118cf6013e5a9ca15925019", "git_parents": ["ebd7af0a360aff7d67868210e0c34f8b94ab2641"], "node": "12cb8c8b816b10d46e6979b2726065c02f4001f0", "parents": ["c2e70ff2dc983c68deb755ddea6d5f470e5b05bf"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060517: Do not enforce font restrictions on modern fedora versions r=timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318652\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp"], "git_node": "8399a9834c4b138bb6ebda3752f387115bbaf9b3", "git_parents": ["958cc9da5f101c1b4118cf6013e5a9ca15925019"], "node": "b72503b98926e2ec210315844936aebc0dca0a8c", "parents": ["12cb8c8b816b10d46e6979b2726065c02f4001f0"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2060066 - Record max consecutive HTTP/3 PTOs per connection r=valentin,necko-reviewers\n\nneqo already tracks pto_counts, a sliding histogram whose highest set bucket\nis the longest run of consecutive PTOs a connection saw. That run length is\nthe condition neqo's max_pto black-hole detector acts on. Record it once per\nestablished connection, at close time in record_stats_in_glean, as a new Glean\ncustom distribution networking.http_3_max_consecutive_ptos.\n\nThis measures how often established HTTP/3 connections black-hole, independent\nof whether the close is ever surfaced as a state change, and will show whether\nthe detector closes such connections sooner once it is enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315882\n", "files": ["netwerk/metrics.yaml", "netwerk/socket/neqo_glue/src/lib.rs"], "git_node": "50104b4eed1dccda88fa6d9be002bf8ee7720516", "git_parents": ["8399a9834c4b138bb6ebda3752f387115bbaf9b3"], "node": "0ead44fea8a691e08d124277e9aad377197ea6ed", "parents": ["b72503b98926e2ec210315844936aebc0dca0a8c"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063382 - Lower-case privacy.resistFingerprinting.exemptedDomains before matching. r=timhuang\n\nnsRFPService::GetExemptedDomainsLowercase() never lower-cased the pref value\ndespite its name, so an entry containing upper-case characters silently failed\nto match, and the assertion in nsContentUtils::IsURIInList() that the list is\nlower-case would fire in debug builds.\n\nThe ToLowerCase() call was dropped in bug 1954188, when the pref read moved out\nof nsContentUtils::IsURIInPrefList() and into nsRFPService.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318558\n", "files": ["browser/components/resistfingerprinting/test/browser/browser_timezone.js", "toolkit/components/resistfingerprinting/nsRFPService.cpp"], "git_node": "ca903c2632dc67750745d6c7c40fbdbe99726990", "git_parents": ["50104b4eed1dccda88fa6d9be002bf8ee7720516"], "node": "1c851890e495f2f9d710ada234f143b93c0ac84a", "parents": ["0ead44fea8a691e08d124277e9aad377197ea6ed"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063382 - Reduce a site-keyed first-party domain or partition key to its base domain before matching exemptedDomains. r=timhuang\n\nPartionKeyIsAlsoExempted() built a URI by concatenating the raw first-party\ndomain or partition key onto \"https://\". Both are serialized in site format,\n\"(https,example.com[,port][,f])\", when privacy.firstparty.isolate.use_site or\nprivacy.dynamic_firstparty.use_site respectively is set, and the latter is\nenabled by default. Parentheses and commas are valid sub-delimiters in a\nreg-name, so NS_NewURI() succeeded and yielded the host \"(https,example.com)\",\nwhich can never match an entry in the list. That revoked the exemption the\npreceding host check had just granted, so exemptedDomains had no effect at all\nfor anyone running with privacy.firstparty.isolate.use_site.\n\nParse the value with OriginAttributes::ParsePartitionKey() instead. That\nfunction only consults privacy.dynamic_firstparty.use_site to decide whether\nthe value is site-keyed, which is the wrong pref for a first-party domain, so\ndetect the serialization from the value itself and only parse when it is in\nsite format.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318559\n", "files": ["browser/components/resistfingerprinting/test/browser/browser_timezone.js", "dom/base/nsContentUtils.cpp"], "git_node": "f1ac5f7e58a1951a42114fb43e33f84ba1a8fe44", "git_parents": ["ca903c2632dc67750745d6c7c40fbdbe99726990"], "node": "440443c191bd0eaf575dcf5616070f237b160b2b", "parents": ["1c851890e495f2f9d710ada234f143b93c0ac84a"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840910 - [devtools] Test compatibility issues for a property with no MDN nor spec url r=devtools-reviewers,nchevobbe\n\nAdd a new mocked compat data to cover missing cases\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318891\n", "files": ["devtools/client/inspector/compatibility/test/browser/browser_compatibility_css-property_issue.js", "devtools/client/inspector/compatibility/test/browser/head.js", "devtools/client/inspector/rules/test/browser_rules_css-compatibility-learn-more-link.js", "devtools/shared/compatibility/dataset/mock-css-properties.json"], "git_node": "59b4e7c4d58501c189d2bd9623263f553b110abb", "git_parents": ["f1ac5f7e58a1951a42114fb43e33f84ba1a8fe44"], "node": "c865f90a742e4ff01702ce7418d1e290708303a4", "parents": ["440443c191bd0eaf575dcf5616070f237b160b2b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063840 - Use the correct moz-page-thumb host in tests. r=mconley\n\nPageThumbs builds moz-page-thumb URLs with the \"thumbnails\" host and PageThumbProtocolHandler rejects\nany other host, so the singular \"thumbnail\" spelling has not resolved since bug 1184701 changed it. The\ncontext menu fixture's image therefore never loaded, and two of the protocol handler's error cases were\nonly re-testing host rejection rather than the query handling they describe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318901\n", "files": ["browser/base/content/test/contextMenu/file_blocked_image_protocols.html", "toolkit/components/thumbnails/test/test_thumbnails_interfaces.js"], "git_node": "5adbc3c0a54a4742e98c0053f50a7c82b630ce99", "git_parents": ["59b4e7c4d58501c189d2bd9623263f553b110abb"], "node": "fb878f6021ccad87786c39e7d7efe7590b5f12f9", "parents": ["c865f90a742e4ff01702ce7418d1e290708303a4"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059334 - fix profdir_existed telemetry recording in the installer. r=browser-installer-reviewers,aborondo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317849\n", "files": ["browser/installer/windows/nsis/install_dir_helpers.nsh", "browser/installer/windows/nsis/installer.nsi", "browser/installer/windows/nsis/test_stub.nsi"], "git_node": "43a3b50d63a6a877aa2ce7e37a7874d7f5290432", "git_parents": ["5adbc3c0a54a4742e98c0053f50a7c82b630ce99"], "node": "49a0fd63eac9228df39f9052204f490acbb5bc1c", "parents": ["fb878f6021ccad87786c39e7d7efe7590b5f12f9"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2064025 - Only read MOZ_USE_PERFORMANCE_MARKER_FILE env var once r=mstange\n\nPreviously `getenv` was running on every `performance.measure()` call.\nIt is especially slow on Windows, where it walks the whole environment\ndoing a case-insensitive comparison per variable. This patch extracts\nthat into a static variable so we only execute it once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319072\n", "files": ["dom/performance/Performance.cpp"], "git_node": "932d1240de71d1001d6ac6e2abf93a1dc1d3acf5", "git_parents": ["43a3b50d63a6a877aa2ce7e37a7874d7f5290432"], "node": "88af1a16a86f06d7ab8548f80e44f681a2461916", "parents": ["49a0fd63eac9228df39f9052204f490acbb5bc1c"], "tags": []}, {"author": "Jan-Erik Rediger \u003cjrediger@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064031 - legacy telemetry: Remove the aborted files, not the directory r=chutten\n\nWe don't control the whole data reporting path from legacy telemetry anymore, so we shouldn't remove it in tests.\nE.g. FOG/Glean puts its own files there (and in case of SQLite those files might still be in use by the running FOG)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319082\n", "files": ["toolkit/components/telemetry/tests/unit/test_TelemetrySession.js", "toolkit/components/telemetry/tests/unit/test_TelemetrySession_abortedSessionQueued.js"], "git_node": "df8512b910b9f26b9115454aa312a9f651dd60be", "git_parents": ["932d1240de71d1001d6ac6e2abf93a1dc1d3acf5"], "node": "2eac84eead0345fd5fa387c88165a519dc9fd21a", "parents": ["88af1a16a86f06d7ab8548f80e44f681a2461916"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1980036: Re-add the a11y-checks skip-if for browser_tab_preview.js r=sthompson,tabbrowser-reviewers\n\nIn https://phabricator.services.mozilla.com/D314360, I got a bit hasty\nand removed one skip-if condition that didn't belong to this bug, and is\nstill unfixed. This adds it back.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316589\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser.toml"], "git_node": "1633715a20976bfda907f16cb043f21bc58755b6", "git_parents": ["df8512b910b9f26b9115454aa312a9f651dd60be"], "node": "7197c0f6ab06f297f9b5cbf9c7f3f58ce4ffb27b", "parents": ["2eac84eead0345fd5fa387c88165a519dc9fd21a"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1980036 - Defer hiding a hover preview panel until it has finished showing r=tabbrowser-reviewers,sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317868\n", "files": ["browser/components/tabbrowser/content/tab-hover-preview.mjs"], "git_node": "3aa6d82cd3f31bba66c572e0dc0bf3e50dd46618", "git_parents": ["1633715a20976bfda907f16cb043f21bc58755b6"], "node": "6e1c6af6a27cab5536042c903c1c56f0bae0d706", "parents": ["7197c0f6ab06f297f9b5cbf9c7f3f58ce4ffb27b"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1980036 - Ignore real mouse input while browser_tab_preview.js drives hover synthetically r=tabbrowser-reviewers,dao\n\nThe tests open previews with synthesized mouseover events, which set\nGecko's hover target without moving the OS pointer. Showing the panel\nprompts the platform to deliver a real mouse event, Gecko resynchronises\nhover to where the pointer physically is, and the tab receives a\nmouseout it is not expecting. This often dismisses the panel while it is\nmid-open (especially on Windows), which disrupts the tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317869\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser_tab_preview.js"], "git_node": "88e4a2beac2ded21ba3e713e6ce2915fb11821fd", "git_parents": ["3aa6d82cd3f31bba66c572e0dc0bf3e50dd46618"], "node": "76d5ea748abfd93e2a3fb32827e131b70535fa9d", "parents": ["6e1c6af6a27cab5536042c903c1c56f0bae0d706"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052265 - Add QR code button to share panel. r=jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317131\n", "files": ["browser/components/sharing/SharePageAction.sys.mjs", "browser/components/sharing/SharingUtils.sys.mjs", "browser/components/sharing/tests/browser/browser.toml", "browser/components/sharing/tests/browser/browser_testSharePanelQRCode.js"], "git_node": "e47c651a4de4b591f86320c6149966d8266265c7", "git_parents": ["88e4a2beac2ded21ba3e713e6ce2915fb11821fd"], "node": "6ee4b2d833d9ad1d0b50d7545cc7d720f8a6b500", "parents": ["76d5ea748abfd93e2a3fb32827e131b70535fa9d"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052263 - Add windows sharing functionality to share panel. r=jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318243\n", "files": ["browser/components/sharing/SharePageAction.sys.mjs", "browser/components/sharing/tests/browser/browser.toml", "browser/components/sharing/tests/browser/browser_testSharePanelWindowsShare.js"], "git_node": "c435c991fa67e9cf1f48e0338256ad86e0846423", "git_parents": ["e47c651a4de4b591f86320c6149966d8266265c7"], "node": "c3cad4177c9547efea0891a0c92751c2510bc401", "parents": ["6ee4b2d833d9ad1d0b50d7545cc7d720f8a6b500"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052268 - Toggle share panel button visibility depending on the url. r=jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318488\n", "files": ["browser/components/sharing/SharePageAction.sys.mjs", "browser/components/sharing/tests/browser/browser.toml", "browser/components/sharing/tests/browser/browser_testSharePanelButtonVisibility.js"], "git_node": "79272588cbbd13d5530a9475aeff54e38c3675ec", "git_parents": ["c435c991fa67e9cf1f48e0338256ad86e0846423"], "node": "c36bf1135a49a9fbf443c73bd564bccca404393f", "parents": ["c3cad4177c9547efea0891a0c92751c2510bc401"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2061152 - Don't infer dom depth from bloom filter. r=firefox-style-system-reviewers,dshin\n\nWe know the right depth, and the bloom filter doesn't get updated for\nstyles that don't need selector-matching, which made rule-node reuse\nless effective (since it was not necessarily looking at the right\ncache).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318961\n", "files": ["servo/components/style/context.rs", "servo/components/style/driver.rs", "servo/components/style/gecko/traversal.rs", "servo/components/style/parallel.rs", "servo/components/style/sharing/mod.rs", "servo/components/style/style_resolver.rs", "servo/components/style/traversal.rs", "servo/ports/geckolib/glue.rs"], "git_node": "44776dda6eb03bbf96f33791d0353d7c0a238a36", "git_parents": ["79272588cbbd13d5530a9475aeff54e38c3675ec"], "node": "c2a6fb531dae9e65ea750aa1e6206237b1f9dce2", "parents": ["c36bf1135a49a9fbf443c73bd564bccca404393f"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2053780 - Update SearchModeSwitcher to use declareLazy. r=mbeier,urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318948\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs"], "git_node": "139aad560b4f18006c7628d949f63a39502deb8f", "git_parents": ["44776dda6eb03bbf96f33791d0353d7c0a238a36"], "node": "6f13d5d6305f336f9ee0fedc572759879e0a0590", "parents": ["c2a6fb531dae9e65ea750aa1e6206237b1f9dce2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064036 - Read prefs in urlbar content modules through UrlbarPrefs. r=urlbar-reviewers,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319093\n", "files": ["browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarView.mjs"], "git_node": "ef80b861da7ee5ee749b8950654a6c966828a70c", "git_parents": ["139aad560b4f18006c7628d949f63a39502deb8f"], "node": "aec3daffff7658546c4a3fafb939605c45152e91", "parents": ["6f13d5d6305f336f9ee0fedc572759879e0a0590"], "tags": []}, {"author": "Luk\u00e1\u0161 Lipinsk\u00fd \u003c6032558+Mr-Tao@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2061020 - Extend \u010cesk\u00e1 televize PiP caption override to live-page origins. r=mconley\n\nThe live channel pages now own their video elements directly under www.ceskatelevize.cz and sport.ceskatelevize.cz, while the selected WebVTT tracks remain hidden. Cover those owner-document origins so Picture-in-Picture can render the active cues.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316749\n", "files": ["browser/extensions/pictureinpicture/data/picture_in_picture_overrides.js"], "git_node": "cdbc45cbf7708e7dc97195aff1c3645dfa1e45b2", "git_parents": ["ef80b861da7ee5ee749b8950654a6c966828a70c"], "node": "cf240ac6dd5c287baa7d407dcac51ab3904157c3", "parents": ["aec3daffff7658546c4a3fafb939605c45152e91"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064036 - Define the switcher's and mentions panel's lazies without XPCOMUtils. r=urlbar-reviewers,daleharvey\n\nThe switcher's module getters go back to `defineESModuleGetters` so nothing in\nthe file needs `XPCOMUtils`; bug 2062987 gates that import along with the rest.\nThe mentions logger keeps its own log-level pref, which `getLogger` now takes\nas an option.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319094\n", "files": ["browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs", "browser/components/urlbar/content/UrlbarShared.mjs"], "git_node": "9e35e44bc118724021cfd6a019a35b85c5eae2a8", "git_parents": ["cdbc45cbf7708e7dc97195aff1c3645dfa1e45b2"], "node": "3bb8a2e77698d549f0dbd7d505d8011c7fffa916", "parents": ["cf240ac6dd5c287baa7d407dcac51ab3904157c3"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064036 - Define the inputs' content-safe lazies without XPCOMUtils. r=urlbar-reviewers,daleharvey\n\nWhat's left in the `declareLazy` blocks is the system modules and the XPCOM\nservices, which bug 2062987 gates on `ChromeUtils` availability.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319095\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "007133d3208100347e4cfeee5a5a68414d8e8e66", "git_parents": ["9e35e44bc118724021cfd6a019a35b85c5eae2a8"], "node": "59a17ad3df67b4841ec79e9ef57bab511e5ca2f0", "parents": ["3bb8a2e77698d549f0dbd7d505d8011c7fffa916"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2038724 - Remove BCryptGenRandom initialization. r=yjuglaret,win-reviewers\n\nBCryptGenRandom is no longer used and by removing this initialization we can\ndelay load bcrypt.dll, which should prevent it from loading in child processes.\n\nIt still exists in av_random_bytes in media/ffvpx/libavutil/random_seed.c, which\nis used in av_get_random_seed, but its only use is commented out and substituted\nwith 0xffffffff.\n\nIt also exists in third_party/abseil-cpp/absl/random/internal/seed_material.cc,\nbut by commenting out the function and subsequent callers, it can be shown that\nit is also never called.\n\nWhen Windows platform encoding is in the content process it currently relies on\nthe fact that bcrypt.dll opens KsecDD, so we need to allow it to be opened when\nplatform encoding is not remote.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303776\n", "files": ["js/xpconnect/src/XPCShellImpl.cpp", "security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp", "toolkit/library/moz.build", "toolkit/xre/dllservices/mozglue/WindowsBCryptInitialization.cpp", "toolkit/xre/dllservices/mozglue/WindowsBCryptInitialization.h", "toolkit/xre/dllservices/mozglue/moz.build", "toolkit/xre/dllservices/tests/TestDllInterceptor.cpp", "toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsEmbedFunctions.cpp"], "git_node": "4c409cf78a02f855565075dde9dad37476f4d59a", "git_parents": ["007133d3208100347e4cfeee5a5a68414d8e8e66"], "node": "93d10d0f30e1d819793539138c8d9cda22f4fc54", "parents": ["59a17ad3df67b4841ec79e9ef57bab511e5ca2f0"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2058948 - Add three-operand 64-bit shift instructions. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314976\n", "files": ["js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/arm/MacroAssembler-arm-inl.h", "js/src/jit/arm64/MacroAssembler-arm64-inl.h", "js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/mips64/MacroAssembler-mips64-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/wasm32/MacroAssembler-wasm32-inl.h", "js/src/jit/x64/MacroAssembler-x64-inl.h", "js/src/jit/x86/MacroAssembler-x86-inl.h"], "git_node": "b9aeeee21c3c49151229d148faa3898a3e04eb44", "git_parents": ["4c409cf78a02f855565075dde9dad37476f4d59a"], "node": "5a9c509f925fca2e69bdfb815147a878d4c72a76", "parents": ["93d10d0f30e1d819793539138c8d9cda22f4fc54"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2060788 - Test that Happy Eyeballs revalidates a stale DNS answer r=necko-reviewers,kershaw\n\nSeed a short-TTL A record by driving one connection through Happy\nEyeballs, let it age into the grace period, then answer the name with a\nworking address. The stale address is raced first and its connection is\nrefused; Happy Eyeballs revalidates with a cache-bypassing lookup, races\nthe address that comes back, and the request succeeds on it.\n\nServing a stale entry also makes the resolver renew it in the\nbackground, and that renewal alone is enough to reach the working\naddress: it updates the shared host record, so a lookup landing after it\nsees the new address, and the test would pass with or without the\nrevalidation. DNS therefore goes through the TRR server, whose answers\ncan be delayed: the revalidated answer is held back until Happy Eyeballs\nhas consumed the stale one and failed to connect to it. TRR_ONLY mode\nkeeps native resolution, which answers 127.0.0.1 for everything in TRR\ntests, out of the picture as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317011\n", "files": ["netwerk/test/unit/test_happy_eyeballs_optimistic_dns.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "c9b408da359a4ad0256dcd7d1d963c8444b86d8e", "git_parents": ["b9aeeee21c3c49151229d148faa3898a3e04eb44"], "node": "4bc2d1107eff0b42660e685137194e133bb733cc", "parents": ["5a9c509f925fca2e69bdfb815147a878d4c72a76"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2060788 - Revalidate stale DNS answers in Happy Eyeballs r=necko-reviewers,kershaw\n\nFirefox already serves DNS answers from a cache entry's grace period\n(stale-while-revalidate). This teaches Happy Eyeballs to notice when an\nanswer was served stale and race it immediately while revalidating with\na fresh, cache-bypassing lookup, then race the revalidated answer too.\n\n- Expose nsIDNSAddrRecord::fromStaleCache and\n  nsIDNSByTypeRecord::fromStaleCache. The flag is captured at serve time:\n  the resolver sets it true only when it hands back a grace-period cache\n  hit, and false on every fresh resolution. Deriving it after the fact\n  from CheckExpiration == EXP_GRACE would misreport a freshly resolved\n  answer as stale whenever its TTL is short enough to land in the grace\n  window immediately (SetExpiration puts mGraceStart at now + ttl, so a\n  TTL of 0 is born in grace). The flag lives on the shared nsHostRecord\n  base, so AddrHostRecord and TypeHostRecord share it.\n- Plumb happy-eyeballs v0.11.0's stale/allow_stale API through the FFI\n  glue and the C++ driver. Output::SendDnsQuery carries allow_stale;\n  when the state machine revalidates a stale answer (allow_stale=false)\n  the driver adds RESOLVE_BYPASS_CACHE to force a fresh lookup. The stale\n  entry is left in place so concurrent consumers can keep using it while\n  the revalidation is in flight.\n- happy_eyeballs_process_dns_response_{a,aaaa,https} carry the stale flag\n  into Input::DnsResult, so both address and HTTPS/SVCB answers report\n  fromStaleCache and are revalidated when served stale. A cache-bypassing\n  revalidation never takes the cache-hit path, so its answer is always\n  reported fresh, upholding the state machine's invariant that a refresh\n  query is never answered from a stale entry.\n\nThe DNSRecord and IPCTypeRecord IPC structs carry the flag too, sampled\nwhen the lookup completes: the receiving side holds no expiration times of\nits own, so it cannot recompute grace status.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317012\n", "files": ["netwerk/dns/DNSByTypeRecord.h", "netwerk/dns/DNSRequestChild.cpp", "netwerk/dns/DNSRequestParent.cpp", "netwerk/dns/PDNSRequestParams.ipdlh", "netwerk/dns/nsDNSService2.cpp", "netwerk/dns/nsHostRecord.cpp", "netwerk/dns/nsHostRecord.h", "netwerk/dns/nsIDNSByTypeRecord.idl", "netwerk/dns/nsIDNSRecord.idl", "netwerk/protocol/http/ConnectionEstablisher.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.h", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs"], "git_node": "a9ed29df9407776e6570a9bd7a46f1310e40d3c8", "git_parents": ["c9b408da359a4ad0256dcd7d1d963c8444b86d8e"], "node": "cc97ac2dfe21fe014e7534a783b82f1a035f5d20", "parents": ["4bc2d1107eff0b42660e685137194e133bb733cc"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2060788 - Surface stale and revalidation state in Happy Eyeballs profiler markers r=necko-reviewers,jesup\n\nThe Happy Eyeballs DNS profiler markers now record two facts introduced\nby Optimistic DNS: whether a query was a cache-bypassing revalidation of\na stale answer (allow_stale=false), and whether the answer it received\nwas served from a stale (past-TTL, grace-period) cache entry. This makes\nthe revalidation flow visible when profiling a connection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317089\n", "files": ["netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/protocol/http/happy_eyeballs_glue/src/profiler.rs"], "git_node": "32547b4910c07437fe09f8c7a4850f55650ab9f8", "git_parents": ["a9ed29df9407776e6570a9bd7a46f1310e40d3c8"], "node": "7f788ec4c025bb494770e9d54b89c77ab9274960", "parents": ["cc97ac2dfe21fe014e7534a783b82f1a035f5d20"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060913 - Don't use UrlbarUtils.getUrlFromResult in UrlbarInput. r=urlbar-reviewers,dao\n\nThis also fixes bug 2031546 in the smartbar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318128\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/content/UrlbarView.mjs"], "git_node": "74391a222dccd2a84462ca3093ec7becc2039cbb", "git_parents": ["32547b4910c07437fe09f8c7a4850f55650ab9f8"], "node": "2389a508b88d02808f58535ba047c10c3537a544", "parents": ["7f788ec4c025bb494770e9d54b89c77ab9274960"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061745 - Don't use nsIInputStream in UrlbarInput. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318129\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_context_paste.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_suggestions.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/tests/browser/browser_dns_first_for_single_words.js", "browser/components/urlbar/tests/browser/browser_edit_invalid_url.js", "browser/components/urlbar/tests/browser/browser_enter.js", "browser/components/urlbar/tests/browser/browser_handleCommand_fallback.js"], "git_node": "99da654a3eb1e6c3dc585ea0bfef790d804e4465", "git_parents": ["74391a222dccd2a84462ca3093ec7becc2039cbb"], "node": "f701dbc729e17a8830186b03b4d1d9d8874c996d", "parents": ["2389a508b88d02808f58535ba047c10c3537a544"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049770 - Resolve TabProgressListener's window through its tab. r=jsudiaman,tabbrowser-reviewers\n\nThe listener looked up gBrowser, gURLBar, window and clearTimeout in the realm\nthat constructed it, which is always the window its tab lives in, so this is a\nbehavior-neutral rerouting. It frees the class of the realm it is created in,\nwhich a single shared class won't have.\n\nThe bare globals that remain hold the same value in every window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318692\n", "files": ["browser/components/tabbrowser/content/tabbrowser.js"], "git_node": "4f80d80c64c727881081aec4d4e71f97ecf320f5", "git_parents": ["99da654a3eb1e6c3dc585ea0bfef790d804e4465"], "node": "dbd80c0fb016616279c9602dead135848fc35001", "parents": ["f701dbc729e17a8830186b03b4d1d9d8874c996d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049770 - Move StatusPanel and TabBarVisibility to their own window scripts. r=tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318765\n", "files": ["browser/base/content/browser-main.js", "browser/components/tabbrowser/content/status-panel.js", "browser/components/tabbrowser/content/tab-bar-visibility.js", "browser/components/tabbrowser/content/tabbrowser.js", "browser/components/tabbrowser/jar.mn"], "git_node": "6979a392042b9b776f7374b38d3e9c600b66d3aa", "git_parents": ["4f80d80c64c727881081aec4d4e71f97ecf320f5"], "node": "2983616e6d54e97211654b36e13b2bdd764ca357", "parents": ["dbd80c0fb016616279c9602dead135848fc35001"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049770 - Take the window out of tabbrowser.js's file-scope helpers. r=tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318766\n", "files": ["browser/components/tabbrowser/content/tabbrowser.js"], "git_node": "c5a99f5b3591af6c0d6496dc39853a47a8adb7c7", "git_parents": ["6979a392042b9b776f7374b38d3e9c600b66d3aa"], "node": "b3f5727c94c50cdd0c33d5244c5e24150983dd64", "parents": ["2983616e6d54e97211654b36e13b2bdd764ca357"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056732 - automatically download smart tab grouping models for Auto Tab Grouping r=Mardak,tabbrowser-reviewers,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315309\n", "files": ["browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/components/t