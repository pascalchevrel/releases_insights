175c7d6d92e801", "git_parents": ["d33c0886b920455a84b3b46529368ffc3a6da880"], "node": "9f8472e772a1365895a5e95dbb2297dc1c8234ec", "parents": ["3d457119926a35e57bdc96a293b36f4ea53aa50b"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066044 - [devtools] - Add preference to simulate devtools transport slowdown r=devtools-reviewers,ochameau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320853\n", "files": ["devtools/shared/DevToolsUtils.js"], "git_node": "4719d85550de8f70e38a4c6c4a848577d5816631", "git_parents": ["98702339c37f8703ac9cced97a175c7d6d92e801"], "node": "65b958a502dc58c26e99e816526a405dc5486d1a", "parents": ["9f8472e772a1365895a5e95dbb2297dc1c8234ec"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065956 - Harden WMF encoding state machines to avoid edge case pitfalls. r=media-playback-reviewers,alwu\n\nWith remote encoding, a compromised content process may be able to\nexploit the process boundary to cause us to enter states we did not\nanticipate. This patch adds explicit guards for these scenarios.\n\nIt also ensures that we handle multiple encodes in flight properly.\nBefore a second encode would attempt to reuse the same promise and\nholder as the first encode. Now we have a promise per encode call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320751\n", "files": ["dom/media/platforms/wmf/MFTEncoder.cpp", "dom/media/platforms/wmf/MFTEncoder.h", "dom/media/platforms/wmf/WMFMediaDataEncoder.cpp", "dom/media/platforms/wmf/WMFMediaDataEncoder.h"], "git_node": "dbc1de358ad2dfc87edf00b8db4c8866825e33a2", "git_parents": ["4719d85550de8f70e38a4c6c4a848577d5816631"], "node": "5345c32e18eebde0dfc22cfb8cb1b0887dcd9d48", "parents": ["65b958a502dc58c26e99e816526a405dc5486d1a"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065957 - Harden AppleVTEncoder state machine to avoid edge case pitfalls. r=media-playback-reviewers,alwu\n\nWith remote encoding, a compromised content process may be able to\nexploit the process boundary to cause us to enter states we did not\nanticipate. This patch adds explicit guards for these scenarios.\n\nIt also ensures that we handle multiple encodes in flight properly.\nBefore a second encode would attempt to reuse the same promise and\nholder as the first encode. Now we have a promise per encode call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320752\n", "files": ["dom/media/platforms/apple/AppleVTEncoder.cpp", "dom/media/platforms/apple/AppleVTEncoder.h"], "git_node": "de5536321cddf4ac4803188280e00cfe8b700080", "git_parents": ["dbc1de358ad2dfc87edf00b8db4c8866825e33a2"], "node": "95a824e3f9c47440352f23af909a63999b6ade79", "parents": ["5345c32e18eebde0dfc22cfb8cb1b0887dcd9d48"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2065815 - Rename usage of macro Success to X11Success in nsXRemoteServer.cpp. r=mossop\n\nThis is a fixup to Bug 2065007.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321140\n", "files": ["toolkit/components/remote/nsXRemoteServer.cpp"], "git_node": "c327de0a238df79e1397373cd87824965d327b32", "git_parents": ["de5536321cddf4ac4803188280e00cfe8b700080"], "node": "35379c0555997725944792d197bb45ec4ac8e263", "parents": ["95a824e3f9c47440352f23af909a63999b6ade79"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2065957 - Harden AppleVTEncoder state machine to avoid edge case pitfalls. r=media-playback-reviewers,alwu\" for causing build bustages @ MFTEncoder.cpp\n\nThis reverts commit de5536321cddf4ac4803188280e00cfe8b700080.\n", "files": ["dom/media/platforms/apple/AppleVTEncoder.cpp", "dom/media/platforms/apple/AppleVTEncoder.h"], "git_node": "4900d0eb6accf0f93c1e00b84966138d617f72ae", "git_parents": ["c327de0a238df79e1397373cd87824965d327b32"], "node": "5844bde2119d4dc4d4df81c6dee89ff86462b68a", "parents": ["35379c0555997725944792d197bb45ec4ac8e263"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2065956 - Harden WMF encoding state machines to avoid edge case pitfalls. r=media-playback-reviewers,alwu\" for causing build bustages @ MFTEncoder.cpp\n\nThis reverts commit dbc1de358ad2dfc87edf00b8db4c8866825e33a2.\n", "files": ["dom/media/platforms/wmf/MFTEncoder.cpp", "dom/media/platforms/wmf/MFTEncoder.h", "dom/media/platforms/wmf/WMFMediaDataEncoder.cpp", "dom/media/platforms/wmf/WMFMediaDataEncoder.h"], "git_node": "6c9af4cddec9582c510e6d7f320828d3abba3100", "git_parents": ["4900d0eb6accf0f93c1e00b84966138d617f72ae"], "node": "3482545c5611d372353314b66a51854072788f0a", "parents": ["5844bde2119d4dc4d4df81c6dee89ff86462b68a"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2064609 - [geckodriver] Document onboarding automation workaround for Firefox on Android in CHANGES.md. r=geckodriver-reviewers,jgraham DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321180\n", "files": ["testing/geckodriver/CHANGES.md"], "git_node": "d44cdb07db9f444a7e94dd4eb6d0479e92e80511", "git_parents": ["6c9af4cddec9582c510e6d7f320828d3abba3100"], "node": "f3ac6ea0e9c8779510527fe5f87eb9f0702cf4c6", "parents": ["3482545c5611d372353314b66a51854072788f0a"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065956 - Harden WMF encoding state machines to avoid edge case pitfalls. r=media-playback-reviewers,alwu\n\nWith remote encoding, a compromised content process may be able to\nexploit the process boundary to cause us to enter states we did not\nanticipate. This patch adds explicit guards for these scenarios.\n\nIt also ensures that we handle multiple encodes in flight properly.\nBefore a second encode would attempt to reuse the same promise and\nholder as the first encode. Now we have a promise per encode call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320751\n", "files": ["dom/media/platforms/wmf/MFTEncoder.cpp", "dom/media/platforms/wmf/MFTEncoder.h", "dom/media/platforms/wmf/WMFMediaDataEncoder.cpp", "dom/media/platforms/wmf/WMFMediaDataEncoder.h"], "git_node": "503697686388d07d2c96f7b3f7ed5c87e35173e3", "git_parents": ["d44cdb07db9f444a7e94dd4eb6d0479e92e80511"], "node": "a151425664426a346b1d0da9d19bc7c88a3c6815", "parents": ["f3ac6ea0e9c8779510527fe5f87eb9f0702cf4c6"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065957 - Harden AppleVTEncoder state machine to avoid edge case pitfalls. r=media-playback-reviewers,alwu\n\nWith remote encoding, a compromised content process may be able to\nexploit the process boundary to cause us to enter states we did not\nanticipate. This patch adds explicit guards for these scenarios.\n\nIt also ensures that we handle multiple encodes in flight properly.\nBefore a second encode would attempt to reuse the same promise and\nholder as the first encode. Now we have a promise per encode call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320752\n", "files": ["dom/media/platforms/apple/AppleVTEncoder.cpp", "dom/media/platforms/apple/AppleVTEncoder.h"], "git_node": "89adca98dee1a94309f29542f5b951dde1102eb8", "git_parents": ["503697686388d07d2c96f7b3f7ed5c87e35173e3"], "node": "3984d30ba772f63ad1e91e5d283a1f5e33f38722", "parents": ["a151425664426a346b1d0da9d19bc7c88a3c6815"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066044 - [devtools] - Add preference to simulate devtools transport slowdown r=devtools-reviewers,ochameau\" for causing multiple failures\n\nThis reverts commit 4719d85550de8f70e38a4c6c4a848577d5816631.\n", "files": ["devtools/shared/DevToolsUtils.js"], "git_node": "0d499da5b09b226a9a23c4183bc25769063fc98b", "git_parents": ["89adca98dee1a94309f29542f5b951dde1102eb8"], "node": "19b863ae67193a4872dc2ca0171d7ed2c34bd2f0", "parents": ["3984d30ba772f63ad1e91e5d283a1f5e33f38722"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065814 - Declare the tab strip's custom elements for TypeScript. r=tabbrowser-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320688\n", "files": ["browser/components/tabbrowser/types/elements.ts"], "git_node": "618471abdbb6321f055039790bdb9c341e007d60", "git_parents": ["0d499da5b09b226a9a23c4183bc25769063fc98b"], "node": "50516df9639ff69dc615e228a1c94684b76d1cbc", "parents": ["19b863ae67193a4872dc2ca0171d7ed2c34bd2f0"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065814 - Make the tabbrowser's element predicates narrow their argument. r=tabbrowser-reviewers,kcochrane\n\njsdoc's parser rejects a type predicate, so the @returns description would not render; it moves into the summary line, and the members still show up in the generated reference at the price of a line each in the doc build log.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320689\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "150c126a1d748c299b6568c80b971a12b8e4afbe", "git_parents": ["618471abdbb6321f055039790bdb9c341e007d60"], "node": "5b0db39502861a60d56d1d59ebb44d6009ba77f9", "parents": ["50516df9639ff69dc615e228a1c94684b76d1cbc"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066386 - Add a regression test for undo in the address bar. r=mbeier\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321199\n", "files": ["browser/components/urlbar/tests/browser-editing/browser.toml", "browser/components/urlbar/tests/browser-editing/browser_undo_history.js"], "git_node": "5bcba6004ec6b31df2592515d36dda391dcd198c", "git_parents": ["150c126a1d748c299b6568c80b971a12b8e4afbe"], "node": "c7c718971c396381f1bafd363a73694de1f95f39", "parents": ["5b0db39502861a60d56d1d59ebb44d6009ba77f9"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062463: Only check that a sandboxed macOS process cannot launch another process, not which error it gets. r=sandbox-reviewers,haik\n\nbrowser_sandbox_test.js has been failing permanently since bug 2062465 moved mochitest-browser-chrome from macOS 10.15 Intel to macOS 15 AArch64. The LSOpenCFURLRef check expects kLSServerCommunicationErr (-10822), which is what LaunchServices appears to have returned on the old platform. The failures on the new platform line up with the sandbox policies: the process types that allow reading /System (content, GPU and RDD) get kLSExecutableIncorrectFormat (-10661), and the ones that do not (socket, GMP and utility) get -54. On macOS 26 the posix_spawnp check fails as well in the four process types that expect ENOENT, because they now get EPERM.\n\nA small probe run under sandbox-exec on macOS 26.6 (arm64) suggests that the error LaunchServices reports depends on which rule stops the launch: denying a read of /System/Applications returns -54, while denying the LaunchServices mach services returns kLSUnknownErr (-10810). Denying process-exec on its own does not appear to stop the launch at all, since launchservicesd performs the spawn. The specific value therefore does not look like something we can pin down across process types, macOS versions and CPU architectures, and the comment on the function already says that the important aspect to test for is that the launch is not permitted. So check only that the launch failed, and keep the returned value in the message so a failure stays diagnosable.\n\nThis also releases the CFString that the LSOpenCFURLRef test was leaking, and re-enables the test on macOS 15 AArch64, which is the only platform that runs it on macOS since the migration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320628\n", "files": ["security/sandbox/common/test/SandboxTestingChildTests.h", "security/sandbox/test/browser.toml"], "git_node": "25b4aaea96a1a203a16085c7e86122fac4463fd6", "git_parents": ["5bcba6004ec6b31df2592515d36dda391dcd198c"], "node": "97988c59b535cbc5dce75a1829580a6ec323c4d9", "parents": ["c7c718971c396381f1bafd363a73694de1f95f39"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2066189 [Linux][Vulkan Video] Enable ffvpx when system FFmpeg is older. r=alwu,media-playback-reviewers\n\nffvpx has Vulkan Video (bug 2045971) but is still lavc 62.29.101 without\n25e187f849. PDM currently always prefers system FFmpeg when Vulkan is on,\nwhich sidelines bundled ffvpx even when the system library is older\n(e.g. FFmpeg 6.1/7.1).\n\nPrefer system FFmpeg first only when Vulkan is wanted and\navcodec_version() \u003e= bundled ffvpx's LIBAVCODEC_VERSION_INT; otherwise\nkeep ffvpx first. Force-disable direct export on bundled ffvpx while its\nlavc is at or below MOZ_FFMPEG_MIN_LAVC_FOR_VULKAN_DMABUF (25e187f849\nfloor); raise that after an ffvpx rebase that includes the fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321070\n", "files": ["dom/media/platforms/PDMFactory.cpp", "dom/media/platforms/ffmpeg/FFmpegLibWrapper.h", "dom/media/platforms/ffmpeg/FFmpegRuntimeLinker.cpp", "dom/media/platforms/ffmpeg/FFmpegRuntimeLinker.h", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp"], "git_node": "ddcd2a32809b079b4cfce75c1819a726f08080ea", "git_parents": ["25b4aaea96a1a203a16085c7e86122fac4463fd6"], "node": "77554c7b7039e89eccc0bcad417dc3776869e536", "parents": ["97988c59b535cbc5dce75a1829580a6ec323c4d9"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066352 - Update android nightly application-services version bump to e6aa0c251cda885dd31850b2912b937612ea810c r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321157\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "9d41fc4520e2b7c60cb2cd6dc8f73f903db5eca1", "git_parents": ["ddcd2a32809b079b4cfce75c1819a726f08080ea"], "node": "b2f01d7c824afac4dff526df7ce7aaab97d4d6ae", "parents": ["77554c7b7039e89eccc0bcad417dc3776869e536"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029482 - Don't make ORB exemptions for DevTools. r=dom-core-reviewers,devtools-reviewers,necko-reviewers,smaug,vhilla,valentin,ochameau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319804\n", "files": ["netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "4ccf14558de6362a72d49be69a54c8d68ecaa7d2", "git_parents": ["9d41fc4520e2b7c60cb2cd6dc8f73f903db5eca1"], "node": "7f078488152ab5c97f81e44f69d1696a6cb5db2a", "parents": ["b2f01d7c824afac4dff526df7ce7aaab97d4d6ae"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065449 - Log the actual error when a FedCM mochitest fails to get a credential r=manuel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317272\n", "files": ["dom/credentialmanagement/identity/tests/mochitest/test_account_label.html", "dom/credentialmanagement/identity/tests/mochitest/test_continue_on.html", "dom/credentialmanagement/identity/tests/mochitest/test_continue_on_override.html", "dom/credentialmanagement/identity/tests/mochitest/test_domain_hint_filter.html", "dom/credentialmanagement/identity/tests/mochitest/test_login_hint_filter.html", "dom/credentialmanagement/identity/tests/mochitest/test_manifest_sa