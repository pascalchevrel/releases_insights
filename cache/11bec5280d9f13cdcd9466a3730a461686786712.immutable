mponents/aiwindow/ui/test/browser/test_smartwindow_promo_page.html", "browser/components/asrouter/content-src/schemas/MessagingExperiment.schema.json", "browser/components/asrouter/content-src/templates/OnboardingMessage/SmartWindowNewtabPromo.schema.json", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/modules/SmartWindowNewTabPromo.sys.mjs"], "git_node": "fbc7d35efc2620a046d0a0f38188002d9d38b9ee", "git_parents": ["94d8f6086573b8a636a02923e4d2e0033158a2e0"], "node": "6e2c517445f3e4f32ef2bddede893a6d2d4f425e", "parents": ["cd816028851329f84a38e6dbfbf46666cd733020"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064194 part 5 - Make the tabbrowser's internal members private. r=tabbrowser-reviewers,jsudiaman\" for causing multiple bc failures in browser_asrouter_newtab_messages.js\n\nThis reverts commit 9cd97a8c076a8819ff5e091da7eb7c158ca1171a.\n\nRevert \"Bug 2064194 part 4 - Drop the tabbrowser's dead _allowTabChange check. r=tabbrowser-reviewers,nsharpley\"\n\nThis reverts commit 5a62ca2c47f2a7eeff7d26501af8cde062647d05.\n\nRevert \"Bug 2064194 part 3 - Keep the tabbrowser's pref getters off the instance. r=tabbrowser-reviewers,jsudiaman\"\n\nThis reverts commit ce6b6bc5c83b017f11af7fa134d9005c3e12a9b8.\n\nRevert \"Bug 2064194 part 2 - Stop reaching into the tabbrowser's internals from outside it. r=tabbrowser-reviewers,fxview-reviewers,webcompat-reviewers,nsharpley,twisniewski\"\n\nThis reverts commit 674522f01606d0ea5cfcb4fec40f88e82ab83689.\n\nRevert \"Bug 2064194 part 1 - Make the tabbrowser's lazy-browser insertion public API. r=tabbrowser-reviewers,jsudiaman\"\n\nThis reverts commit c54cc4f9832223cd44ea19f882df6aee2cfa6ee3.\n", "files": ["browser/components/extensions/parent/ext-tabs.js", "browser/components/extensions/test/browser/browser_ext_tabs_discard_reversed.js", "browser/components/firefoxview/tests/browser/browser_firefoxview_tab.js", "