/examples/remote-settings-cli/src/dump/client.rs", "third_party/application-services/examples/tabs-sync/src/tabs-sync.rs", "third_party/application-services/moz.yaml", "third_party/application-services/tools/generate-rust-dashboards/src/component_config.rs", "third_party/application-services/tools/generate-rust-dashboards/src/config.rs", "third_party/application-services/tools/generate-rust-dashboards/src/main.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/event.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/mod.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/sync.rs", "third_party/application-services/tools/generate-rust-dashboards/src/schema.rs", "third_party/application-services/tools/generate-rust-dashboards/src/sql.rs", "third_party/application-services/tools/generate-rust-dashboards/src/team_config.rs", "toolkit/components/uniffi-bindgen-gecko-js/android/components/autofill/android/src/main/java/mozilla/appservices/autofill/autofill.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/logins/android/src/main/java/mozilla/appservices/logins/logins.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/merino/android/src/main/java/mozilla/appservices/merino/merino.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/tabs/android/src/main/java/mozilla/appservices/remotetabs/tabs.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustInitRustComponents.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTracing.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "5a775cc857be28fc2f2d455815e58df1753bd311", "git_parents": ["811ad42741a6965b23b78a57b7586ea5a87b88ec"], "node": "96e2d152772789e5362576e44887a960990eb95d", "parents": ["7e26839f589f5c4456990def3871e659945efe72"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057574 - Don't exclude wpt reftests/crashtests that live under subsuite paths r=taskgraph-reviewers,ahal\n\nWPT subsuites (canvas, webgpu, webcodecs, eme) exist only to split the\nlarge testharness suite into separate CI jobs.\nDefaultLoader.get_manifests applied the subsuite-path exclusion to every\nweb-platform-tests suite, including\nreftest/crashtest/wdspec/print-reftest, which are not split. As a result\ne.g.  canvas reftests and canvas crashtests were excluded from the\ngeneral reftest/crashtest jobs and, since the subsuite jobs only run\n--test-type=testharness, ran nowhere. This is the same class of bug as\nbug 2017833.\n\nOnly apply subsuite partitioning to the testharness suite; the other wpt\nsuites keep every manifest. With crashtests under subsuite paths running\nin the general web-platform-tests-crashtest job again, drop the\n--test-type=crashtest workaround from the webcodecs job to avoid running\nthose crashtests twice.\n\nThe webgpu CTS reftests are the exception: they need the webgpu job's\n--timeout-multiplier (software WebGPU is too slow for the default\nreftest timeout) and just time out in the general reftest job, so\nexclude them there with --exclude-tag=webgpu until a dedicated webgpu\nreftest job exists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315668\n", "files": ["taskcluster/gecko_taskgraph/test/test_util_chunking.py", "taskcluster/gecko_taskgraph/util/chunking.py", "taskcluster/kinds/web-platform-tests/kind.yml"], "git_node": "b8e19698b97ce1ef5ddc91f5173cccd283c00dcc", "git_parents": ["5a775cc857be28fc2f2d455815e58df1753bd311"], "node": "252b58d5b5565d780dfd88a77bf3f40a166415e4", "parents": ["96e2d152772789e5362576e44887a960990eb95d"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057574 - Update canvas reftest metadata for the re-enabled reftest job. r=ci-and-tooling,aryx\n\nRestoring the canvas reftests to the general reftest job (they stopped running\nwhen the canvas subsuite was split out) surfaced stale expectations, updated\nhere with `mach wpt-update` from a try push:\n\n- Several offscreen text tests (canvas.2d.fontStretch.*, canvas.2d.offscreen.direction)\n  no longer fail on Android; drop their stale FAIL expectations.\n- canvas.2d.offscreen.worker.lang[.inherit] time out on Android; mark them\n  expected TIMEOUT there.\n- drawImage-from-blob and 2d.reset.render.text[.w] show sub-pixel differences on\n  macOS (max per-channel 1, 2-4 pixels); annotate them fuzzy.\n\nDifferential Revision: https://phabricator.services.mozill