icator.services.mozilla.com/D315320\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_restore_respects_pending_minimize.js"], "git_node": "6623b2fb2429e24632bfbe97f2f47c6d831c396d", "git_parents": ["ed636c5e21340d466e8acd0a5153e88308f477f9"], "node": "5059f112560cb1f11c82470f8ab359285248c252", "parents": ["659dc35f07c480997887dfef604d9313a1285450"], "tags": []}, {"author": "Benjamin Peterson \u003cbenjamin@python.org\u003e", "branch": "default", "desc": "Bug 2064430 - Remove empty js/src/jit-test/tests/wasm/builtin-modules/profiling.js. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319540\n", "files": ["js/src/jit-test/tests/wasm/builtin-modules/profiling.js"], "git_node": "255efc8caff0697a82d9ea36df341e562f23c2c7", "git_parents": ["6623b2fb2429e24632bfbe97f2f47c6d831c396d"], "node": "deb5ec930227ccf24fff7c9f23555e2c4b7e8f82", "parents": ["5059f112560cb1f11c82470f8ab359285248c252"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2062783 - Use moz-src for sessionstore. r=Gijs,omc-reviewers,migration-reviewers,firefox-desktop-core-reviewers ,jswinarton,hsohaney,sclements,aminomancer,perftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317956\n", "files": ["browser/actors/AboutTabCrashedParent.sys.mjs", "browser/base/content/browser-places.js", "browser/base/content/browser.js", "browser/base/content/test/about/browser_aboutCertError.js", "browser/base/content/test/tabPrompts/browser_prompt_close_groups.js", "browser/base/content/test/tabcrashed/browser_autoSubmitRequest.js", "browser/components/BrowserComponents.manifest", "browser/components/BrowserContentHandler.sys.mjs", "browser/components/BrowserGlue.sys.mjs", "browser/components/DefaultBrowserCheck.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", 