testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/service.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/ImageBitmap/shared.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/web_platform/copyToTexture/canvas/cts.https.html.ini"], "git_node": "f1f7eab5a47ac172bd1951dd1b743ab5ae65a002", "git_parents": ["999464fe3c9d9e9852a62af6d16fd72f9607cb05"], "node": "dfbd7310793b5c115f829434c82ecbdf7bfac659", "parents": ["53c625ca1242d96b916e8519acb7daa15076b2f3"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063946 - More glean events for the Containers UI - part 1 - metrics.yaml r=chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318989\n", "files": ["browser/components/contextualidentity/metrics.yaml"], "git_node": "fb9db6e8877dafbb8fe5cbef5bfa5c814342690c", "git_parents": ["f1f7eab5a47ac172bd1951dd1b743ab5ae65a002"], "node": "403fe2613c2456ec28e16b442bb2031575753989", "parents": ["dfbd7310793b5c115f829434c82ecbdf7bfac659"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063946 - More glean events for the Containers UI - part 2 - Settings r=hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318990\n", "files": ["browser/components/contextualidentity/content/ContainerCreationPanel.mjs", "browser/components/preferences/config/containers.mjs", "browser/components/preferences/tests/privacy/browser.toml", "browser/components/preferences/tests/privacy/browser_containers_telemetry.js"], "git_node": "c56714d45b3c92722a2e3602037cb5bfe4d19329", "git_parents": ["fb9db6e8877dafbb8fe5cbef5bfa5c814342690c"], "node": "3533ea165f323d508b11892694bcf98084c21f17", "parents": ["403fe2613c2456ec28e16b442bb2031575753989"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063946 - More glean events for the Containers UI - part 3 - Browser/base r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318991\n", "files": ["browser/base/content/browser-menubar.js", "browser/base/content/browser-sets.js", "browser/base/content/browser.js", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/utilityOverlay.js", "browser/components/contextualidentity/test/browser/browser_telemetry.js", "browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/URILoadingHelper.sys.mjs"], "git_node": "079de8d1ed04824e4bf024b3356512288c7005a8", "git_parents": ["c56714d45b3c92722a2e3602037cb5bfe4d19329"], "node": "227f437e94b922525da1b1527b83ae5dce040560", "parents": ["3533ea165f323d508b11892694bcf98084c21f17"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063946 - More glean events for the Containers UI - part 4 - Tabs r=tabbrowser-reviewers,jswinarton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318992\n", "files": ["browser/components/contextualidentity/test/browser/browser_telemetry.js", "browser/components/tabbrowser/content/browser-allTabsMenu.inc.xhtml", "browser/components/tabbrowser/content/browser-allTabsMenu.js", "browser/components/tabbrowser/content/tab-context-menu.js"], "git_node": "90e9f1948de3b00251d1098525c02bea4c09370d", "git_parents": ["079de8d1ed04824e4bf024b3356512288c7005a8"], "node": "c316ecd91f8e275def98bb1e9928d13719029812", "parents": ["227f437e94b922525da1b1527b83ae5dce040560"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063946 - More glean events for the Containers UI - part 6 - Bookmarks r=sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318994\n", "files": ["browser/components/sidebar/sidebar-bookmarks.mjs", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar_glean.js"], "git_node": "05ee1074fca54a5ed69f139c004272bd96777ac7", "git_parents": ["90e9f1948de3b00251d1098525c02bea4c09370d"], "node": "49506d3f8bb5818d15519f806dfdebd9a71f98b6", "parents": ["c316ecd91f8e275def98bb1e9928d13719029812"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063946 - More glean events for the Containers UI - part 7 - Sync tabs menu r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318995\n", "files": ["browser/base/content/main-popupset.js", "browser/components/syncedtabs/TabListView.sys.mjs", "browser/components/syncedtabs/test/browser/browser_sidebar_syncedtabslist.js"], "git_node": "1d7f03630636f54645794abe52971c47cf56d850", "git_parents": ["05ee1074fca54a5ed69f139c004272bd96777ac7"], "node": "04ebb1f4b7a5c1f2e2e53b88a96f9d49a9fcc008", "parents": ["49506d3f8bb5818d15519f806dfdebd9a71f98b6"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064182 - Make test_artifact_patterns an ordered sequence. r=firefox-build-system-reviewers,sergesanspaille\n\ntest_artifact_patterns was a set, but its consumers iterate it and break on the\nfirst matching pattern, and two of its entries overlap: mozpath.match() treats\nthe trailing * in \"bin/plugins/*\" as matching a whole subtree, so it also\nmatches the gmp plugin paths that \"bin/plugins/gmp-*/*/*\" is meant to claim.\nWhich one won therefore depended on set iteration order, i.e. on PYTHONHASHSEED,\nwhich nothing in the build system pins. Roughly 58% of seeds picked the wrong\none.\n\nWhen that happened, libfake.so and libfakeopenh264.so landed in dist/plugins\ninstead of dist/bin. test_archive.py only packages GMP plugins from dist/bin, so\nthe libraries went missing from the test archive while manifest.json and\nfakeopenh264.info stayed, those being installed from the source tree. Gecko then\ndiscovered the plugin and advertised H264, and the GMP child process crashed with\nMOZ_CRASH(Plugin file does not exist) as soon as anything tried to use it.\n\nKeeping the patterns in source order fixes it, since the specific gmp-* pattern\nis already written above the general one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319235\n", "files": ["python/mozbuild/mozbuild/artifacts.py", "python/mozbuild/mozbuild/test/test_artifacts.py"], "git_node": "e1685d244084bee95891c767232ddb392fdae5fa", "git_parents": ["1d7f03630636f54645794abe52971c47cf56d850"], "node": "260e9343ddf6494e18785f44042d27e716197d96", "parents": ["04ebb1f4b7a5c1f2e2e53b88a96f9d49a9fcc008"], "tags": []}, {"author": "Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e", "branch": "default", "desc": "Bug 2062561: rename variables to avoid shadowing in PeerConnection.sys.mjs r=pehrsons\n\nadding suppressions for the intentional overrides of IDL-defined globals.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316997\n", "files": ["dom/media/PeerConnection.sys.mjs"], "git_node": "9a4657446d4df765f35984af28edaa0c864ff85a", "git_parents": ["e1685d244084bee95891c767232ddb392fdae5fa"], "node": "ba6e5db2b1256fdb236cb751b305561ba4b1f7c0", "parents": ["260e9343ddf6494e18785f44042d27e716197d96"], "tags": []}, {"author": "Debadree Chatterjee \u003cdebadree333@gmail.com\u003e", "branch": "default", "desc": "Bug 2040286 - Treat using bindings as non-writable like const. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315807\n", "files": ["js/src/frontend/Parser.cpp", "js/src/jit-test/tests/debug/Environment-setVariable-using.js", "js/src/jit-test/tests/explicit-resource-management/using-not-writable-in-eval.js", "js/src/vm/EnvironmentObject.cpp", "js/src/vm/Scope.cpp"], "git_node": "fc9d369df353087ee29db4b719f53e8d11247bc9", "git_parents": ["9a4657446d4df765f35984af28edaa0c864ff85a"], "node": "7e5511dbdfa77daeb3c8de82506019dace0756f4", "parents": ["ba6e5db2b1256fdb236cb751b305561ba4b1f7c0"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064646 - Remove return statement from finally block r=sylvestre\n\nSince PEP-765, usage of a return statement in a finally block is\ndiscouraged and raises a SyntaxWarning.\n\nRemove references in .../code_analysis/utils.py as they did not serve any\npurpose.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319718\n", "files": ["python/mozbuild/mozbuild/code_analysis/utils.py"], "git_node": "dfbbc6bc7db4999295a8d2d246573eaa43d7e96a", "git_parents": ["fc9d369df353087ee29db4b719f53e8d11247bc9"], "node": "d9028b973d75e9e20ca519a9b1d0d03353ba53cc", "parents": ["7e5511dbdfa77daeb3c8de82506019dace0756f4"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064266 - [efficiency] Do not fail a test when closeSoftKeyboard() cannot hide the keyboard r=aaronmt\n\nEspresso's closeSoftKeyboard() throws PerformException when the focused view's root is not\nthe one it expects, which happens whenever no editable view has focus - on the homepage, or\nafter a dialog takes focus. Hiding the keyboard is only ever a convenience for the assertion\nthat follows, so failing to do it must not fail the test.\n\nTwo tests fail locally on this today, and pass in CI, so it only bites developers running\nthe suite: SettingsGeneralTest.verifyFontSizingChangeTest via\nBasePage.mozVerifyAnyContainsText, and\nSettingsSearchTest.verifyCustomSearchEngineCanBeAddedFromSearchEngineMenuTest via\nSettingsSearchAddSearchEnginePage.\n\nAdds BasePage.dismissSoftKeyboard(), which wraps the call in runCatching and logs what it\nswallowed, and routes the four call sites in the efficiency framework through it. It is\nprotected rather than private so the two page objects, which extend BasePage, use the same\nhelper instead of repeating the guard.\n\nA further 13 unguarded calls remain in the legacy ui/robots/* and ui/*Test.kt files. Left\nalone here to keep the patch reviewable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319321\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsAutofillPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsSearchAddSearchEnginePage.kt"], "git_node": "4edfa99bcb5861da4a5504dd49705696cf224373", "git_parents": ["dfbbc6bc7db4999295a8d2d246573eaa43d7e96a"], "node": "67ab1de4c56988137f17efc7621f1bc120172a5b", "parents": ["d9028b973d75e9e20ca519a9b1d0d03353ba53cc"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063993 - Disable Rust logins storage on release r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319038\n", "files": ["modules/libpref/init/all.js"], "git_node": "bd5a8eb9c6d6b42744438558ba4a3591084c8959", "git_parents": ["4edfa99bcb5861da4a5504dd49705696cf224373"], "node": "bd05ed2ef0672e1984afec9dbc0078e4a434c39c", "parents": ["67ab1de4c56988137f17efc7621f1bc120172a5b"], "tags": []}, {"author": "Keri Grubb \u003cgrubbke@oregonstate.edu\u003e", "branch": "default", "desc": "Bug 2042422 - Remove needless borrows in labeled_memory_distribution.rs. r=TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316190\n", "files": ["toolkit/components/glean/api/src/private/labeled_memory_distribution.rs"], "git_node": "fec53586cc347f021fbb3685f54d6d6652b2deaa", "git_parents": ["bd5a8eb9c6d6b42744438558ba4a3591084c8959"], "node": "e275afa261457684a70477580b0c8bbe5dc4bf83", "parents": ["bd05ed2ef0672e1984afec9dbc0078e4a434c39c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2064677 - Add MOZ_LIFETIME_CAPTURE_BY_THIS to fix -Wdeprecated-attributes with clang 23 r=sergesanspaille\n\nclang 23 deprecates lifetime_capture_by(this) in favor of\nlifetime_capture_by_this. Keep the old spelling as a fallback since the\nminimum supported clang is still 19.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319738\n", "files": ["mfbt/Attributes.h", "mfbt/api.yml", "xpcom/string/nsTDependentString.h"], "git_node": "17705b58c6af21ce235ed476206ac17f63a01e8e", "git_parents": ["fec53586cc347f021fbb3685f54d6d6652b2deaa"], "node": "aa81d0ebd761a0a996d9148d9326f25f85481c22", "parents": ["e275afa261457684a70477580b0c8bbe5dc4bf83"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061430 - Fall back to non-localized if localized datetime error message formatting fails. r=dom-core-reviewers,platform-i18n-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319175\n", "files": ["dom/html/input/DateTimeInputTypes.cpp", "intl/components/src/FormatBuffer.h"], "git_node": "ef96cc9277a91a2d818b14964a669410bbe0b3bd", "git_parents": ["17705b58c6af21ce235ed476206ac17f63a01e8e"], "node": "c6b7eb4d8bc9d702eba4822f3fc2b668e13dfdb1", "parents": ["aa81d0ebd761a0a996d9148d9326f25f85481c22"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061852 - Notify IME of selection change when handling eSetSelection command for EditContext. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319587\n", "files": ["dom/events/IMEContentObserver.cpp", "dom/html/EditContext.cpp", "editor/libeditor/tests/edit-context/test_editcontext_set_selection.html", "testing/mochitest/tests/SimpleTest/EventUtils.js"], "git_node": "a69f5bff740017c75085fbad9b80fd2b52da4050", "git_parents": ["ef96cc9277a91a2d818b14964a669410bbe0b3bd"], "node": "6b0953b095ebc9d1cfcaaaa4aac2208a6ec7e946", "parents": ["c6b7eb4d8bc9d702eba4822f3fc2b668e13dfdb1"], "tags": []}, {"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2059127 - WebRTC backport: Screen capture: validate and snapshot cursor and videocrop metadata r=pehrsons\n\nCap cursor_meta-\u003esize against the negotiated maximum and validate that\nbitmap_offset and the bitmap pixel data offset both point within the\nmetadata region before forming pointers and copying data.\n\nCopy cursor and videocrop metadata headers from shared memory into\nlocal storage before validating and using their fields, so the\nproducer cannot modify them between validation and use.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: 9b33b6c524a185a20586741af262370291000b69\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319761\n", "files": ["third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream.cc", "third_party/libwebrtc/moz-patch-stack/9b33b6c524.no-op-cherry-pick-msg"], "git_node": "45376b1c54ed1c658f9168ff93b2e6fa5ae5f989", "git_parents": ["a69f5bff740017c75085fbad9b80fd2b52da4050"], "node": "a0efe8bc90331a480e396095c9ebe58b30225cb2", "parents": ["6b0953b095ebc9d1cfcaaaa4aac2208a6ec7e946"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2063814 - Handle \\ correctly in SplitMimetype r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319097\n", "files": ["dom/base/MimeType.cpp"], "git_node": "641d322ce937f42f2f7e48bb01dd207c5322a041", "git_parents": ["45376b1c54ed1c658f9168ff93b2e6fa5ae5f989"], "node": "8e738b555997f8685d6b9fbbe3eba1570edfe868", "parents": ["a0efe8bc90331a480e396095c9ebe58b30225cb2"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061397 - Tear down WebSocketChannelChild on the main thread, r=necko-reviewers,valentin\n\nUse the same approach HttpChannelChild::Release() uses: dispatch off-main-thread\nreleases through the main thread with DecrementWithLimit\u003c2\u003e, so the count==1\nSendDeleteSelf and count==0 delete only run on the main thread where the IPDL\nreference is also released.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319530\n", "files": ["netwerk/protocol/websocket/WebSocketChannelChild.cpp"], "git_node": "7ff40451ff8b907d1826e4b689d356a9f62acd5b", "git_parents": ["641d322ce937f42f2f7e48bb01dd207c5322a041"], "node": "7a8249a085b1f8cf203f503fa239861077711754", "parents": ["8e738b555997f8685d6b9fbbe3eba1570edfe868"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063946 - More glean events for the Containers UI - part 7 - Sync tabs menu r=mconley\" for causing mochitests failures in browser_library_container_menu.js.\n\nThis reverts commit 1d7f03630636f54645794abe52971c47cf56d850.\n\nThis reverts commit 05ee1074fca54a5ed69f139c004272bd96777ac7.\n\nThis reverts commit 90e9f1948de3b00251d1098525c02bea4c09370d.\n\nThis reverts commit 079de8d1ed04824e4bf024b3356512288c7005a8.\n\nThis reverts commit c56714d45b3c92722a2e3602037cb5bfe4d19329.\n\nThis reverts commit fb9db6e8877dafbb8fe5cbef5bfa5c814342690c.\n", "files": ["browser/base/content/browser-menubar.js", "browser/base/content/browser-sets.js", "browser/base/content/browser.js", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/main-popupset.js", "browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/utilityOverlay.js", "browser/components/contextualidentity/content/ContainerCreationPanel.mjs", "browser/components/contextualidentity/metrics.yaml", "browser/components/contextualidentity/test/browser/browser_telemetry.js", "browser/components/preferences/config/containers.mjs", "browser/components/preferences/tests/privacy/browser.toml", "browser/components/preferences/tests/privacy/browser_containers_telemetry.js", "