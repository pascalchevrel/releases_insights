ner.cpp", "widget/android/GeckoViewSupport.h", "widget/android/nsWindow.cpp", "widget/uikit/nsWindow.mm", "widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/AppWindow.h"], "git_node": "976be8097ea1c793c2d65ed5438afd90471f6883", "git_parents": ["91613ab000fd3b3cfa7100ffb8f8784bd0f0203c"], "node": "5ad103946a2ef877d8fd22f19b3fcca0b0fa13f3", "parents": ["a69d9d31fb6117b7b2058da10c2162a25cd3a7b6"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1625902 - part 2: Mark `nsContentUtils::Dispatch*Event` for chrome as `MOZ_CAN_RUN_SCRIPT` r=smaug,dom-core-reviewers,win-reviewers,layout-reviewers,emilio,handyman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310972\n", "files": ["docshell/base/BrowsingContext.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/nsContentSink.h", "dom/base/nsContentUtils.h", "dom/base/nsDocElementCreatedNotificationRunner.h", "dom/base/nsFocusManager.cpp", "dom/base/nsFocusManager.h", "dom/base/nsGlobalWindowOuter.cpp", "dom/base/nsGlobalWindowOuter.h", "dom/base/nsImageLoadingContent.cpp", "dom/events/EventDispatcher.cpp", "dom/events/EventTarget.h", "dom/events/WheelHandlingHelper.cpp", "dom/events/WheelHandlingHelper.h", "dom/fetch/Fetch.cpp", "dom/fetch/FetchDriver.cpp", "dom/fetch/FetchDriver.h", "dom/html/HTMLButtonElement.cpp", "dom/html/HTMLButtonElement.h", "dom/html/HTMLDetailsElement.h", "dom/html/HTMLFormElement.cpp", "dom/html/HTMLFormElement.h", "dom/html/HTMLInputElement.cpp", "dom/html/HTMLInputElement.h", "dom/html/HTMLMarqueeElement.h", "dom/html/HTMLSelectElement.h", "dom/html/HTMLTextAreaElement.h", "dom/interfaces/base/nsIDOMWindowUtils.idl", "dom/ipc/BrowserChild.h", "dom/ipc/FilePickerParent.cpp", "dom/ipc/FilePickerParent.h", "dom/media/mediaelement/HTMLMediaElement.h", "dom/media/mediaelement/HTMLVideoElement.cpp", "dom/media/mediaelement/HTMLVideoElement.h", "dom/prototype/PrototypeDocumentContentSink.cpp", "dom/xhr/XMLHttpRequestMainThread.cpp", "dom/xhr/XMLHttpRequestMainThread.h", "dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLContentSink.h", "dom/xml/nsXMLPrettyPrinter.h", "gfx/layers/apz/public/GeckoContentController.h", "gfx/layers/apz/src/AsyncPanZoomController.h", "gfx/layers/apz/src/InputBlockState.h", "gfx/layers/apz/util/APZCCallbackHelper.h", "gfx/layers/apz/util/ChromeProcessController.h", "gfx/layers/apz/util/ContentProcessController.h", "gfx/layers/ipc/APZChild.cpp", "gfx/layers/ipc/APZChild.h", "layout/base/PresShell.cpp", "layout/base/nsCSSFrameConstructor.cpp", "layout/base/nsCSSFrameConstructor.h", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h", "layout/forms/nsComboboxControlFrame.cpp", "layout/forms/nsComboboxControlFrame.h", "widget/cocoa/nsFilePicker.h", "widget/gtk/nsFilePicker.h", "widget/nsBaseFilePicker.cpp", "widget/nsBaseFilePicker.h", "widget/nsIFilePicker.idl", "widget/windows/nsFilePicker.h", "xpfe/appshell/AppWindow.cpp"], "git_node": "1645f3d8648605c442c7f7d8a58d7d238ca20b5e", "git_parents": ["976be8097ea1c793c2d65ed5438afd90471f6883"], "node": "d6f309417ca7d1cba5fb32579466f9977d76f5b5", "parents": ["5ad103946a2ef877d8fd22f19b3fcca0b0fa13f3"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1625902 - part 3: Make some overloads of `nsContentUtils::Dispatch*Event` r=smaug,layout-reviewers,emilio\n\nThe `Document` parameter is used only for creating the DOM event.\nTherefore, it does not need to be held by the caller. However, using\n`MOZ_KnownLive` may lead misunderstanding of the developers. Therefore,\nwe should hide the `MOZ_KnownLive` into the overloads if the event\ntarget can access the document quickly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311669\n", "files": ["dom/base/Element.cpp", "dom/base/nsContentUtils.h", "dom/base/nsFocusManager.cpp", "dom/base/nsGlobalWindowInner.cpp", "dom/base/nsGlobalWindowOuter.cpp", "dom/canvas/ClientWebGLContext.cpp", "dom/canvas/nsICanvasRenderingContextInternal.cpp", "dom/events/WheelHandlingHelper.cpp", "dom/html/HTMLDialogElement.cpp", "dom/html/HTMLFormElement.cpp", "dom/html/HTMLInputElement.cpp", "dom/html/HTMLSelectElement.cpp", "dom/html/HTMLSlotElement.cpp", "dom/html/HTMLTextAreaElement.cpp", "dom/html/nsIConstraintValidation.cpp", "dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/utils/MediaElementEventRunners.cpp", "dom/media/webvtt/HTMLTrackElement.cpp", "dom/script/ScriptElement.cpp", "editor/libeditor/TextEditor.cpp", "gfx/layers/apz/util/APZCCallbackHelper.cpp", "layout/base/nsPresContext.cpp", "layout/forms/nsComboboxControlFrame.cpp", "layout/forms/nsFileControlFrame.cpp", "layout/generic/nsVideoFrame.cpp", "widget/nsBaseFilePicker.cpp"], "git_node": "01df2c4f8fa1b7f9aa91b0add2daf6d54fcb75c2", "git_parents": ["1645f3d8648605c442c7f7d8a58d7d238ca20b5e"], "node": "3cc56f9c4a9b81f71dd667d62eaf9c5aba30d010", "parents": ["d6f309417ca7d1cba5fb32579466f9977d76f5b5"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1625902 - part 4: Make dispatcher of the chrome event of initializing/finalizing UA shadow require a script blocker r=smaug,emilio,layout-reviewers\n\nThey may dispatch `UAWidgetSetupOrChange` or `UAWidgetTeardown` chrome\nevent to notify the UA widget of creation or destruction. That's\nrequired to the layout and making the UA widget start working. This\nis important especially when the call is caused by JS. Then, the next\nline may require the new UA widget. Therefore, we cannot make them\nuse `NS_DispatchToCurrentThread` because it may run too late for JS.\n\nOn the other hand, they are called during `BindToTree()`,\n`UnbindFromTree()` and `nsCSSFrameConstructor` working. In these cases,\nrunning script is blocked. Therefore, their `AddScriptRunner` dispatches\nthe chrome events asynchronously but before returning to the JS world.\n\nTo avoid to mark them as `MOZ_CAN_RUN_SCRIPT` and `BindToTree()`,\n`UnbindFromTree()` and `nsCSSFrameConstructor` methods as\n`MOZ_CAN_RUN_SCRIPT_BOUNDARY`, they should always dispatch chrome events\nasynchronously. Therefore, they will assert that they are called when\nscript is blocked and this patch adds some callers put\n`nsAutoScriptBlocker` or `mozAutoDocUpdate`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311670\n", "files": ["dom/base/Document.cpp", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/FragmentOrElement.cpp", "dom/base/nsImageLoadingContent.cpp", "dom/html/HTMLDetailsElement.h", "dom/html/HTMLInputElement.cpp", "dom/html/HTMLInputElement.h", "dom/html/HTMLMarqueeElement.cpp", "dom/html/HTMLMarqueeElement.h", "dom/html/HTMLSelectElement.h", "dom/html/HTMLTextAreaElement.h", "dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/mediaelement/HTMLMediaElement.h", "dom/media/mediaelement/HTMLVideoElement.cpp", "dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLContentSink.h", "dom/xml/nsXMLPrettyPrinter.h", "editor/libeditor/HTMLAbsPositionEditor.cpp", "editor/libeditor/HTMLAnonymousNodeEditor.cpp", "editor/libeditor/HTMLEditor.h", "editor/libeditor/HTMLEditorObjectResizer.cpp", "editor/libeditor/HTMLInlineTableEditor.cpp", "editor/libeditor/ManualNAC.h", "layout/base/nsCSSFrameConstructor.h", "parser/html/nsHtml5TreeOperation.cpp", "parser/html/nsHtml5TreeOperation.h"], "git_node": "ca0029c572b9ee09ee98a8eb1918345fe34a7bb0", "git_parents": ["01df2c4f8fa1b7f9aa91b0add2daf6d54fcb75c2"], "node": "878bf368d699c704bdd118202e72b9daf1ba3975", "parents": ["3cc56f9c4a9b81f71dd667d62eaf9c5aba30d010"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066113 - Inherit QueryInterface from StaticRange in CrossShadowBoundaryRange. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320971\n", "files": ["dom/base/CrossShadowBoundaryRange.cpp"], "git_node": "16d354aa4f96ff69ab6e4e1004f9d5009a234e50", "git_parents": ["ca0029c572b9ee09ee98a8eb1918345fe34a7bb0"], "node": "16bab233fc5ce519f6968f46835f238acf3f56a9", "parents": ["878bf368d699c704bdd118202e72b9daf1ba3975"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055837 - mozinfo: derive apple_silicon from the target processor. r=sergesanspaille\" on request.\n\nThis reverts commit 308ae3ea26727b0161581cc5824204f8692c2d76.\n", "files": ["testing/mozbase/mozinfo/mozinfo/mozinfo.py", "testing/mozbase/mozinfo/tests/test.py"], "git_node": "8e46e733fd62fdd7b973c550f9e8c5f7c1cadcf5", "git_parents": ["16d354aa4f96ff69ab6e4e1004f9d5009a234e50"], "node": "f3e5f522be58620c2d9c7a9d609491e90e80aa1a", "parents": ["16bab233fc5ce519f6968f46835f238acf3f56a9"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059477 - Remove Legacy Telemetry mirrors of application update telemetry r=csadilek,application-update-reviewers,chumphreys,cdupuis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319754\n", "files": ["browser/components/enterprisepolicies/tests/xpcshell/test_appupdatepin.js", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml", "toolkit/components/telemetry/histogram-allowlists.json", "toolkit/mozapps/update/UpdateService.sys.mjs", "toolkit/mozapps/update/metrics.yaml", "toolkit/mozapps/update/shared_metrics.yaml", "toolkit/mozapps/update/tests/unit_aus_update/languagePackUpdates.js"], "git_node": "c0d030807cd8c8ccfb529e58d29d505894832018", "git_parents": ["8e46e733fd62fdd7b973c550f9e8c5f7c1cadcf5"], "node": "e31e0d5b74d61e8b2ecf5bdb18417a28df61b110", "parents": ["f3e5f522be58620c2d9c7a9d609491e90e80aa1a"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2066099 - Cleanup leftover browser_test_local_network_access.js r=necko-reviewers,kershaw\n\nIt has been split into multiple subtests in bug 2017207, but the file was never actually removed.\nIt is not currently running, as it is not in the test manifest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320895\n", "files": ["netwerk/test/browser/browser_test_local_network_access.js"], "git_node": "50e68d40c8813cf558e2fee99fe93421db84db45", "git_parents": ["c0d030807cd8c8ccfb529e58d29d505894832018"], "node": "c4cf232b678616db1ab85395061a89e89f045f74", "parents": ["e31e0d5b74d61e8b2ecf5bdb18417a28df61b110"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062342 - Publish the RPM-KEY file to archive.mozilla.org. r=taskgraph-reviewers,releng-reviewers,bhearsum\n\nThe rpm signing task now exports the public key with the revoked subkeys\nstripped as public/build/RPM-KEY, so beetmove it next to the existing KEY\nfile, both for nightlies and in the candidates directories.\n\ngenerate_artifact_registry_gcs_sources_rpm() collects every destination\nfrom the repackage-rpm-signing artifact map, so restrict it to the .rpm\npackages to keep RPM-KEY out of the YUM repository import.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319719\n", "files": ["taskcluster/gecko_taskgraph/manifests/firefox_candidates.yml", "taskcluster/gecko_taskgraph/manifests/firefox_nightly.yml", "taskcluster/gecko_taskgraph/util/scriptworker.py"], "git_node": "7a7b249b473931ff39885047f8010e9e73ec8a66", "git_parents": ["50e68d40c8813cf558e2fee99fe93421db84db45"], "node": "a53e77bde977e1f240b1b1322db29469220f77a2", "parents": ["c4cf232b678616db1ab85395061a89e89f045f74"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065710 - set UPLOAD_SYMBOLS in dxc and system symbols upload tasks. r=smarnach DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321158\n", "files": ["taskcluster/kinds/system-symbols-upload/kind.yml", "taskcluster/kinds/toolchain-dxc-upload/kind.yml"], "git_node": "41c5a13daf1b372693d6d9e83bd26f053c3e537c", "git_parents": ["7a7b249b473931ff39885047f8010e9e73ec8a66"], "node": "b08d3f8a6e5a8f7de20586adf8a5b88f30970ea2", "parents": ["a53e77bde977e1f240b1b1322db29469220f77a2"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064490 - Change VPN call-to-action from \"Try it\" to \"Try it free\" r=android-reviewers,android-l10n-reviewers,parker,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320432\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "fbf2ab03bc62037dc4915714ee0211e740fc0c24", "git_parents": ["41c5a13daf1b372693d6d9e83bd26f053c3e537c"], "node": "8924e4b8d7158e2f12cb3e08db02973a0c50f89d", "parents": ["b08d3f8a6e5a8f7de20586adf8a5b88f30970ea2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065769 - Make the type names in the tabbrowser's JSDoc resolve. r=kcochrane,tabbrowser-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320686\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tabgroup.js", "browser/components/tabbrowser/types/globals.ts"], "git_node": "7a1de732db167c3b644639bbdc659b4e82b90546", "git_parents": ["fbf2ab03bc62037dc4915714ee0211e740fc0c24"], "node": "c46179c705d6a5ddd66d9ec41cf0e8a1b500cfca", "parents": ["8924e4b8d7158e2f12cb3e08db02973a0c50f89d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065769 - Document the tabbrowser's option-bag parameters. r=kcochrane,tabbrowser-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320687\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "e1c47d88b9f533c84b6c7979c5e185b489ae4c30", "git_parents": ["7a1de732db167c3b644639bbdc659b4e82b90546"], "node": "39a9b0e9b13ac7575c0b40cef92797c2e72b6af8", "parents": ["c46179c705d6a5ddd66d9ec41cf0e8a1b500cfca"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2058098 - Check for wildcard chars in user font file policy rules. r=handyman,sandbox-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320499\n", "files": ["security/sandbox/win/gtest/TestConfigHelpers.cpp", "security/sandbox/win/src/sandboxbroker/ConfigHelpers.cpp"], "git_node": "f5ee8f872293411d5ddc1c5ba41526f89d1bcf2a", "git_parents": ["e1c47d88b9f533c84b6c7979c5e185b489ae4c30"], "node": "d3fb7988d0fb6692dbaf0a8a0fea312f4e99f4db", "parents": ["39a9b0e9b13ac7575c0b40cef92797c2e72b6af8"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066150 - Remove legacy security telemetry probes r=freddyb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320963\n", "files": ["browser/components/metrics.yaml", "dom/security/metrics.yaml"], "git_node": "954209af30ff7288247488b0d49abdbae3005a37", "git_parents": ["f5ee8f872293411d5ddc1c5ba41526f89d1bcf2a"], "node": "0bec3c2ae0035162ab8e3f9a3ba777cbad2cd17b", "parents": ["d3fb7988d0fb6692dbaf0a8a0fea312f4e99f4db"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066115 - Stop mirroring some https related telemetry probes r=freddyb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320922\n", "files": ["browser/components/metrics.yaml", "dom/security/metrics.yaml"], "git_node": "7151b667600bee259d865503b196c233c5393773", "git_parents": ["954209af30ff7288247488b0d49abdbae3005a37"], "node": "e91a62720f764c9230a73d5529380c30f77288fc", "parents": ["0bec3c2ae0035162ab8e3f9a3ba777cbad2cd17b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1830323 - Start a new WebM cluster on an interval, not just on keyframes. r=media-playback-reviewers,padenot\n\nA SimpleBlock's timecode is relative to the start of its cluster and is\nserialized as an int16_t of milliseconds, so a cluster cannot span more than\n32767ms. EbmlComposer only started a new cluster on a video keyframe when the\nstream had video, so a video track that stalled for longer than that -- while\naudio kept flowing -- made the timecode overflow and crashed.\n\nApply the interval that audio-only streams already used to every stream, since\na video track cannot be relied on to keep producing keyframes. Keyframes still\nstart a cluster, so they remain aligned with one; clusters just no longer wait\nfor one. The WebM muxer guidelines allow this, saying only that keyframes\nSHOULD be placed at the beginning of clusters.\n\nThe block timecode is now bounded by the interval, which a static_assert ties\nto the format limit, so the release assertion on it is replaced by a debug-only\none covering the remaining caller contract: frames in non-decreasing time order.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320118\n", "files": ["dom/media/gtest/TestWebMWriter.cpp", "dom/media/webm/EbmlComposer.cpp"], "git_node": "c785dd3544ef9266399ef602b4e47d15237d66b3", "git_parents": ["7151b667600bee259d865503b196c233c5393773"], "node": "f53c390a1dcd74f28b04aa892d0a2134a0c1de4b", "parents": ["e91a62720f764c9230a73d5529380c30f77288fc"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066103 - Stop mirroring securityuicerterror_load_aboutcerterror r=freddyb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320905\n", "files": ["toolkit/content/metrics.yaml"], "git_node": "69889ef91e48ff681cd41a39a600c71aad7f8c83", "git_parents": ["c785dd3544ef9266399ef602b4e47d15237d66b3"], "node": "812538a01865851c39ee01678b7cc6e1f0158fdd", "parents": ["f53c390a1dcd74f28b04aa892d0a2134a0c1de4b"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "f6938e10852e799733ecef4a52c2d150b86b6c2a", "git_parents": ["69889ef91e48ff681cd41a39a600c71aad7f8c83", "600bd2128b2ba435b9698ec8b61394aa27c7c93f"], "node": "3190f938d15f34989b18fa611aaf921b29ee8990", "parents": ["812538a01865851c39ee01678b7cc6e1f0158fdd", "1c12266c4f983ea52b856961508a15d6b7f99be1"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066150 - Remove legacy security telemetry probes r=freddyb\" for causing telemetry probe failures\n\nThis reverts commit 954209af30ff7288247488b0d49abdbae3005a37.\n", "files": ["browser/components/metrics.yaml", "dom/security/metrics.yaml"], "git_node": "3e8de4777df48ecddac561c2e63ce7f5e47f7978", "git_parents": ["f6938e10852e799733ecef4a52c2d150b86b6c2a"], "node": "23864224649655b1fa6cf2190b6c45f9700e0dcd", "parents": ["3190f938d15f34989b18fa611aaf921b29ee8990"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059477 - Remove Legacy Telemetry mirrors of default browser and OS environment telemetry r=csadilek,chumphreys\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319755\n", "files": ["browser/components/metrics.yaml", "browser/components/tests/browser/browser_browserGlue_telemetry.js", "browser/components/tests/browser/browser_default_browser_prompt.js", "browser/components/tests/browser/browser_to_handle_telemetry.js", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml", "toolkit/components/telemetry/histogram-allowlists.json"], "git_node": "4edf18e811a3138348bcd3a0d43d085914bd01