c/vulkan_video.c", "media/ffvpx/libavcodec/vulkan_video.h", "media/ffvpx/libavcodec/vulkan_vp9.c", "media/ffvpx/libavutil/avutil.symbols", "media/ffvpx/libavutil/hwcontext_vulkan.c", "media/ffvpx/libavutil/hwcontext_vulkan.h", "media/ffvpx/libavutil/moz.build", "media/ffvpx/libavutil/vulkan.c", "media/ffvpx/libavutil/vulkan.h", "media/ffvpx/libavutil/vulkan_functions.h", "media/ffvpx/libavutil/vulkan_loader.h"], "git_node": "210b24818662a456bc06d9a414644005db04f16f", "git_parents": ["d261ca7a01bf23520033185c4c6541380864cd4c"], "node": "cee90e5116a14fb01313be09798b1b9bcaebb337", "parents": ["81e6f9e69b48095cf225a266501481ab9087c41e"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063979 [Linux] Disable HW video decoding if dmabuf is not available r=emilio,gtk-reviewers\" for causing build bustages in GfxInfo.cpp.\n\nThis reverts commit a70d6d2262c5a0f94e4a75735a3ee2be58420a3d.\n", "files": ["widget/gtk/GfxInfo.cpp"], "git_node": "24daa84a6e0314e2c27b55c5fd0f0d444f3ee247", "git_parents": ["210b24818662a456bc06d9a414644005db04f16f"], "node": "7e8ca9b37561bbdf78295f0b5e6d0d632c0a814e", "parents": ["cee90e5116a14fb01313be09798b1b9bcaebb337"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040037 - Guard against null current entry in NavigationTraverse r=farre,smaug\n\nIf there's no `mActiveEntry`, make the Navigation API operation throw `InvalidStateError`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320057\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp"], "git_node": "d9f285988cae0c1d9dcda0bf268272f2acf56f35", "git_parents": ["24daa84a6e0314e2c27b55c5fd0f0d444f3ee247"], "node": "a886c8949c32c7f279e9ed5bf2f42a1072fae0df", "parents": ["7e8ca9b37561bbdf78295f0b5e6d0d632c0a814e"], "tags": []}, {"author": "Mr. M \u003cmr.m@tuta.com\u003e", "branch": "default", "desc": "Bug 1955168 - Prevent flashing when opening mica popups for the first time r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319740\n", "files": ["gfx/layers/wr/WebRenderLayerManager.cpp", "widget/nsIWidget.cpp", "widget/nsIWidget.h", "widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h"], "git_node": "987e01a0402953141cb0e44f44c8476a143630d6", "git_parents": ["d9f285988cae0c1d9dcda0bf268272f2acf56f35"], "node": "c7727e6de48695b938e17a6da4b1ef3b93ef9d64", "parents": ["a886c8949c32c7f279e9ed5bf2f42a1072fae0df"], "tags": []}, {"author": "Louis-Philippe \u003clpmanette@omnicesoft.com\u003e", "branch": "default", "desc": "Bug 2063867 - [Wayland][HDR] Provide fallback luminance mechanism for metadata-less PQ videos. r=stransky,gtk-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318916\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "widget/gtk/ScreenHelperGTK.cpp", "widget/gtk/ScreenHelperGTK.h", "widget/gtk/WaylandSurface.cpp", "widget/gtk/WaylandSurface.h", "widget/gtk/nsWaylandDisplay.cpp", "widget/gtk/nsWaylandDisplay.h"], "git_node": "1adfe6336f988ff2d15f90db21c3bda83dd3f7f5", "git_parents": ["987e01a0402953141cb0e44f44c8476a143630d6"], "node": "261565acbdc36a2c9f5d687a1bcfc2b8f7d60d27", "parents": ["c7727e6de48695b938e17a6da4b1ef3b93ef9d64"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2032017 - Don't paint a panel-list's own surface inside a XUL panel. r=desktop-theme-reviewers,emilio\n\nThe panel's `::part(content)` already paints the background and text color, casts the shadow, and rounds and clips the corners. The switcher's list was casting a second shadow identical to the panel's, and the migration wizard's, which has no styling of its own, was painting a second background.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320143\n", "files": ["toolkit/content/widgets/panel-list/panel-list.css"], "git_node": "b54a0bb96fc151feb692fccc8391c70b66c34111", "git_parents": ["1adfe6336f988ff2d15f90db21c3bda83dd3f7f5"], "node": "030cf2cf7d8ab9a282f5b9177717679b07433e91", "parents": ["261565acbdc36a2c9f5d687a1bcfc2b8f7d60d27"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2032017 - Clean up the switcher panel-list's styling. r=daleharvey,urlbar-reviewers\n\n`--panel-background` isn't a real variable (the panel system's is `--panel-background-color`), so the background already fell back to transparent and the panel now suppresses it properly; the misnamed declaration goes too. The rest are no-ops that restate panel-list's or panel-item's own defaults, or lose to an `!important` in the shadow tree. What panel-item only gets right under nova moves into the proton branch, so it goes when proton does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320144\n", "files": ["browser/themes/shared/urlbar.css", "toolkit/themes/shared/global-shared.css"], "git_node": "54438ffe66334ae2ec6062fe1a3fe0d33872ac72", "git_parents": ["b54a0bb96fc151feb692fccc8391c70b66c34111"], "node": "c95dc7f04e70b161839d66ca0e017d359fec203e", "parents": ["030cf2cf7d8ab9a282f5b9177717679b07433e91"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062215 - Override --urlbar-input-container-padding for the newtab bar. r=daisuke\n\n--urlbar-input-container-padding exists for the input container, so resolving that inset in the container's own rule leaves the variable to unrelated consumers and gives an embedder nothing to override. New Tab sets it alongside the bar's height; the inset comes out the same under Nova, where the container draws no border, and grows by the border width without it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320297\n", "files": ["browser/extensions/newtab/content-src/components/Search/_Search.scss", "browser/themes/shared/urlbar.css"], "git_node": "4ccdfcc1aa17adf2e31a6489c585acbdaf4d801d", "git_parents": ["54438ffe66334ae2ec6062fe1a3fe0d33872ac72"], "node": "142f63ae96df70aab3d88f3e107604a3fb062d56", "parents": ["c95dc7f04e70b161839d66ca0e017d359fec203e"], "tags": []}, {"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2028535 - dismiss dialog behind sign in screen r=android-reviewers,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309043\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesDialogFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/HomeActivityTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/share/SendToDevicesDialogFragmentTest.kt"], "git_node": "d74dec21965d85edc47a4eb859c344f475152ab0", "git_parents": ["4ccdfcc1aa17adf2e31a6489c585acbdaf4d801d"], "node": "24d167631faab81b0861f516d6d52ee616f1dbbb", "parents": ["142f63ae96df70aab3d88f3e107604a3fb062d56"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048566 - Gate WebRTC GMP codec creation on plugin availability. r=webrtc-reviewers,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308756\n", "files": ["dom/media/webrtc/libwebrtcglue/GmpVideoCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.cpp"], "git_node": "86e8d7e6e5045156f0dbcc584e2c19a1a8b4fd74", "git_parents": ["d74dec21965d85edc47a4eb859c344f475152ab0"], "node": "7a5e133911ac282f53ab051df41ec13be24da71f", "parents": ["24d167631faab81b0861f516d6d52ee616f1dbbb"], "tags": []}, {"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054929 - additional usecounters for Sanitizer entry points r=emilio,webidl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320439\n", "files": ["dom/base/UseCounters.conf", "dom/base/use_counter_metrics.yaml", "dom/webidl/Document.webidl", "dom/webidl/Element.webidl", "dom/webidl/ShadowRoot.webidl"], "git_node": "6198b93e9d53c15438d4a2d400754bed95b266fc", "git_parents": ["86e8d7e6e5045156f0dbcc584e2c19a1a8b4fd74"], "node": "63fb10292de19137ddd4deb397104f87ec80646b", "parents": ["7a5e133911ac282f53ab051df41ec13be24da71f"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063169 - Fix uninitialized corner shape values in box shadows. r=gfx-reviewers,layout-reviewers,emilio,nical\n\nHaving unitialized values here resulted in WebRender using the corner-shape code path, as the shape_xxx values are not exactly 1.0. This in turns triggers the loading of the superellipse variants of the box shadow shaders (even with the pref off), which are quite complex and take a long time to load on low-end platforms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320568\n", "files": ["layout/painting/nsDisplayList.cpp"], "git_node": "47265f313ab5dc847c378eb886fa0585527f153b", "git_parents": ["6198b93e9d53c15438d4a2d400754bed95b266fc"], "node": "e49751f8a1dcba7657dafccc1271930cd187ad8a", "parents": ["63fb10292de19137ddd4deb397104f87ec80646b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062215 - Fit the newtab results view inside the viewport. r=desktop-theme-reviewers,mconley,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319856\n", "files": ["browser/components/urlbar/UrlbarNewTabComponentRegistrant.sys.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/extensions/newtab/content-src/components/Search/_Search.scss", "browser/themes/shared/urlbar.css"], "git_node": "43bfb449f5b0e1b9abf2a7fde87713c8fcf963fd", "git_parents": ["47265f313ab5dc847c378eb886fa0585527f153b"], "node": "0fa6fca4e92c867392971a93ebf600af17a957ba", "parents": ["e49751f8a1dcba7657dafccc1271930cd187ad8a"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060764 part 1: Make PDocAccessible managed by PWindowGlobal instead of PBrowser. r=eeejay,nika\n\nA PDocAccessible is tied to a single DOM document only.\nConversely, PBrowser encompasses an entire document tree within a content process; i.e. a tab and all its in-process iframes, or an OOP iframe and all its nested in-process iframes.\nTherefore, it is a better fit for PDocAccessible to be managed by PWindowGlobal, which is also associated one to one with a single DOM document.\n\nThis patch largely moves code and changes calls in order to switch to the new manager.\nHowever, there are a few noteworthy changes:\n\n1. PDocAccessible's constructor no longer takes a BrowsingContext.\n  This isn't necessary now because a PWindowGlobal is associated with a single BrowsingContext, so we can get the BrowsingContext from there.\n2. Use Manager() in DocAccessibleParent::RecvPrinting to get the window context, rather than going via the BrowsingContext.\n  Now that PDocAccessible is managed by PWindowGlobal, we don't need the indirection, and going directly is more precise.\n3. Remove handling for the case that the manager is being destroyed in RecvPDocAccessibleConstructor.\n  Unlike BrowserParent, WindowGlobalParent doesn't have an intermediate \"destroying\" state.\n  it's either alive or it isn't, and if it isn't, it can't receive IPDL messages.\n4. In RecvPDocAccessibleConstructor, change the code which cleans up a previous top level DocAccessibleParent so that it walks the BrowsingContext's WindowContexts rather than using BrowserParent::GetTopLevelDocAccessible.\n  Because DOM keeps the current WindowContext up to date and PDocAccessible is tied to WindowContext, GetTopLevelDocAccessible now only always returns the current top level actor, so it would return null in this case and the previous top level actor wouldn't be found, making the previous code a no-op.\n  This code is now only necessary for Android because Android strictly requires that there only be a single top level DocAccessibleParent at any given time.\n5. Clear any queued cache updates on DocAccessible when a DocAccessibleChild is prematurely destroyed.\n  Previously, this couldn't happen because PBrowser lives for the life of the tab or OOP iframe.\n  In contrast, PWindowGlobal's lifetime ends with its document.\n  That means that if the document is being torn down, the actor will be too, and that sometimes happens a little before the DocAccessible is shut down.\n6. Previously, BrowserBridgeParent::RecvSetEmbedderAccessible compared the manager of the parent doc and the child doc.\n  It can't do that any more because two DocAccessibleParents will now always have different managers.\n7. BrowserParent::GetTopLevelDocAccessible has been significantly rewritten for the new actor relationship, since it no longer has to deal with a single actor managing multiple PDocAccessibles.\n8. BrowserParent::Destroy no longer destroys the top level DocAccessibleParent.\n  BrowserParent doesn't own DocAccessibleParent any more, so we leave this to WindowGlobalParent actor teardown.\n  Also, by the time Browserparent::Destroy is called, there might not even be a current WindowGlobal any more, which means we couldn't get the DocAccessibleParent anyway.\n9. Changed various checks of IsTopLevelInContentProcess to assertions, since this is now inherently true because we get the precise WindowGlobalParent we are interested in and a PWindowGlobal only manages one PDocAccessible.\n10. A PWindowGlobal should only ever have a single PDocAccessible.\n  We enforce that in RecvPDocAccessibleConstructor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318677\n", "files": ["accessible/android/SessionAccessibility.cpp", "accessible/base/FocusManager.cpp", "accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "accessible/ipc/PDocAccessible.ipdl", "accessible/ipc/RemoteAccessible.cpp", "accessible/pdf/PdfStructTreeBuilder.cpp", "accessible/xul/XULComboboxAccessible.cpp", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/PBrowser.ipdl", "dom/ipc/PWindowGlobal.ipdl", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalChild.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/ipc/moz.build"], "git_node": "9fced15f6e2e06a3727bd56528ce11698596b88e", "git_parents": ["43bfb449f5b0e1b9abf2a7fde87713c8fcf963fd"], "node": "58fcbde8355ee7a7501b5b1d8cc122b346464079", "parents": ["0fa6fca4e92c867392971a93ebf600af17a957ba"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060764 part 2: Ensure the correct same-process embedder when adding a child doc. r=eeejay,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318678\n", "files": ["accessible/ipc/DocAccessibleParent.cpp"], "git_node": "359b76dd6bdd0ff19b315bf369bd2543e84081b6", "git_parents": ["9fced15f6e2e06a3727bd56528ce11698596b88e"], "node": "9b795e34d914fd0fa973e3c19d0068c8f615dd51", "parents": ["58fcbde8355ee7a7501b5b1d8cc122b346464079"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060764 part 3: Remove parent document argument to PDocAccessible constructor and PBrowserBridge::SetEmbedderAccessible. r=eeejay,nika\n\nWe can now get the parent document using the PWindowGlobal tree instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319427\n", "files": ["accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp", "accessible/generic/OuterDocAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "dom/ipc/BrowserBridgeChild.h", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserBridgeParent.h", "dom/ipc/PBrowserBridge.ipdl", "dom/ipc/PWindowGlobal.ipdl", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalChild.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h"], "git_node": "677f69b293d5a0f48c0eecfc2a8beacb47b8c95e", "git_parents": ["359b76dd6bdd0ff19b315bf369bd2543e84081b6"], "node": "9a03e25e50f4475eb457fb131e53d307c2d3a4b1", "parents": ["9b795e34d914fd0fa973e3c19d0068c8f615dd51"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2063979 [Linux] Disable HW video decoding if dmabuf is not available r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320061\n", "files": ["widget/gtk/GfxInfo.cpp"], "git_node": "7494b0276beb96d0b85681349e2860d78e9f7efd", "git_parents": ["677f69b293d5a0f48c0eecfc2a8beacb47b8c95e"], "node": "ad7e05c7bbc6e0e672b7d8b7f16382f3af81f9ea", "parents": ["9a03e25e50f4475eb457fb131e53d307c2d3a4b1"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2066017 - Store compressed TLS token size r=valentin,necko-reviewers\n\nAlso introduce some named constants while I'm here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320842\n", "files": ["netwerk/base/SSLTokensCache.cpp"], "git_node": "cf795bbdac151123bfdf46369543ce60f61de39c", "git_parents": ["7494b0276beb96d0b85681349e2860d78e9f7efd"], "node": "8bda71c6b7404e17301adb91f562bae4de2f4ff4", "parents": ["ad7e05c7bbc6e0e672b7d8b7f16382f3af81f9ea"], "tags": []}, {"author": "calixteman \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 1864440 - Send the pdf.js context menu commands to the frame the menu was opened in. r=pdfjs-reviewers,robwu\n\nbrowser.sendMessageToActor() without a scope only reaches the top-level window\nglobal, so when the viewer was in an iframe the editingaction event was\ndispatched in the embedding document and undo, redo, delete and select all did\nnothing. Use the PdfJs actor of the window global nsContextMenu was opened in\ninstead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320730\n", "files": ["toolkit/components/pdfjs/content/PdfJsContextMenu.sys.mjs", "toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_editing_contextmenu.js", "toolkit/components/pdfjs/test/file_pdfjs_iframe.html", "toolkit/components/pdfjs/test/file_pdfjs_middle_iframe.html", "toolkit/components/pdfjs/test/file_pdfjs_nested_iframe.html", "toolkit/components/pdfjs/test/file_pdfjs_target.html", "toolkit/components/pdfjs/test/head.js"], "git_node": "e871e1656b54fec36d3bcd56a4ea8bf260ef237d", "git_parents": ["cf795bbdac151123bfdf46369543ce60f61de39c"], "node": "8d9ce1574d4e0430891df6a28a0753906a64b2d9", "parents": ["8bda71c6b7404e17301adb91f562bae4de2f4ff4"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2064033. Restore libsrtp's config.h placeholder when vendoring. r=bwc,tjr\n\nUpstream libsrtp generates config.h from config_in.h at build time, so it is not in the\nsources we fetch, while moz.build defines HAVE_CONFIG_H and 40 files under src/ include\nit. We carry an empty placeholder for that at third_party/libsrtp/config.h.\n\nNothing in moz.yaml puts that placeholder into the vendor directory, so `mach vendor`\ncleans src/, does not find config.h upstream, and then stops with\n\n  Could not remove third_party/libsrtp/src/include/config.h from the appropriate\n  moz.build file\n\nbecause the file is not listed in any moz.build. Add a copy-file update action that\nrestores it after unpacking.\n\nThis one has reached the tree before, so it is not a silent failure like most vendoring\nproblems: src/include/config.h has been removed by three changesets and all three were\nbacked out for build bustages, most recently the v2.5.0 update in bug 1814375. That is\npresumably why the placeholder copy was added to update_srtp.sh in bug 2023349, which is\nthe path updates have been done through. A companion patch removes that script, since\nmoz.yaml describes the whole update once this action is in place.\n\nWith this, `./mach vendor third_party/libsrtp/moz.yaml -r v2.8.0 --patch-mode check\n--force` reproduces the committed tree exactly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319085\n", "files": ["third_party/libsrtp/moz.yaml"], "git_node": "3e64fedc1a36bdfc86b358a3c54ca26d9c88c30c", "git_parents": ["e871e1656b54fec36d3bcd56a4ea8bf260ef237d"], "node": "1b67c64bb758c0d44c917861d9ebbcb446af6b96", "parents": ["8d9ce1574d4e0430891df6a28a0753906a64b2d9"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2064033. Remove libsrtp's update_srtp.sh. r=bwc,tjr\n\nlibsrtp has two update paths: update_srtp.sh, which copies the sources out of a local git\ncheckout, and moz.yaml, which updatebot drives with `mach vendor`. Having both means an\nupdate can leave the tree and the manifest disagreeing, because the script cannot write\nthe new revision into moz.yaml and it asks for local patches to be reapplied by hand\nrather than applying the ones moz.yaml lists.\n\nThe script has also drifted from the directory it maintains. Its `hg addremove` names\nsrc/VERSION, which is not in the tree, and its header says it assumes no changes have\nbeen made to the sources, which stopped holding when 00_use_consistent_printf_types.patch\nwas added. It appends to srtp_update.log, which is not in the tree either.\n\nmoz.yaml now covers everything the script did, including copying the config.h placeholder\ninto the vendor directory, so remove it and leave `mach vendor` as the single update path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319086\n", "files": ["taskcluster/scripts/misc/vendor-verify-expected-fail.yml", "third_party/libsrtp/update_srtp.sh"], "git_node": "9a0919ec52296e0454c15331478f1811d977862a", "git_parents": ["3e64fedc1a36bdfc86b358a3c54ca26d9c88c30c"], "node": "dcd5e08facaf9e7d5e162da862bbe05e0af0ba86", "parents": ["1b67c64bb758c0d44c917861d9ebbcb446af6b96"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065164 - Move urlbar actors to browser/components/urlbar/actors. r=dao,urlbar-reviewers\n\nThis effectively enables type checking in the actors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320436\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/actors/UrlbarParent.sys.mjs", "browser/actors/moz.build", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/urlbar/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/moz.build"], "git_node": "52f821c8281e5ad7f8cfbf44aebb17d824024c77", "git_parents": ["9a0919ec52296e0454c15331478f1811d977862a"], "node": "d04cf4c079703d7a5d85219dbdefa1af4c1aeb0f", "parents": ["dcd5e08facaf9e7d5e162da862bbe05e0af0ba86"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065164 - Fix issues found by type checking urlbar actors. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320437\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProviderQuickSuggestContextualOptIn.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs"], "git_node": "428084d23b8de45093192b37e4308a7c9ffa01ec", "git_parents": ["52f821c8281e5ad7f8cfbf44aebb17d824024c77"], "node": "876fb0a5c42c91bfd3b08fd837ad497392b7678f", "parents": ["d04cf4c079703d7a5d85219dbdefa1af4c1aeb0f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065724 - Stop naming the search mode switcher \"More options\". r=mbeier,urlbar-reviewers\n\n`moz-button` maps `aria-label` onto its shadow button, so the hardcoded value became the control's accessible name while the engine-specific string only ever reaches `title`. The name is now computed from the button's content, i.e. the slotted `searchmode-switcher-dropmarker` image's own label, \"Pick a Search Engine\"; `title` supplies the description.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320634\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser_a11y.js"], "git_node": "302c03fbe9863bd12eddf253778dbbfd8cf0bed1", "git_parents": ["428084d23b8de45093192b37e4308a7c9ffa01ec"], "node": "563b065b0ba9a8461d57c69629cb783870ebcfe6", "parents": ["876fb0a5c42c91bfd3b08fd837ad497392b7678f"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2065164 - Fix issues found by type checking urlbar actors. r=dao,urlbar-reviewers\" for causing gecko decision failures with ActionsProvider.sys.mjs\n\nThis reverts commit 428084d23b8de45093192b37e4308a7c9ffa01ec.\n\nRevert \"Bug 2065164 - Move urlbar actors to browser/components/urlbar/actors. r=dao,urlbar-reviewers\" for causing gecko decision failures\n\nThis reverts commit 52f821c8281e5ad7f8cfbf44aebb17d824024c77.\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/actors/UrlbarParent.sys.mjs", "browser/actors/moz.build", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProviderQuickSuggestContextualOptIn.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/moz.build", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs"], "git_node": "e06c0c961f4dadc337bba4bd895f0491aa64cac0", "git_parents": ["302c03fbe9863bd12eddf253778dbbfd8cf0bed1"], "node": "3bf20a88344bb29015a6ce04acdc2541ccc36a95", "parents": ["563b065b0ba9a8461d57c69629cb783870ebcfe6"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge Mozilla-central to autoland\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/actors/UrlbarParent.sys.mjs"], "git_node": "1c80d4410975952c05aee36fc342404c6e61ce3c", "git_parents": ["e06c0c961f4dadc337bba4bd895f0491aa64cac0", "017a9913bd6c272a859aea16d3cab5a4d46bf1b0"], "node": "a8d78dd823fd1e3d0aa422d09fc2ebbc1c98c6f5", "parents": ["3bf20a88344bb29015a6ce04acdc2541ccc36a95", "69981ff91c5ff9d587d6b8e76c2ccce4fddf6794"], "tags": []}, {"author": "Sarah Clements \u003csclements@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058059 - Update synced tabs empty state asset r=fxview-reviewers,desktop-theme-reviewers,sfoster\n\n* Add new svg that combines kit and a QR code to be used for the state when a user is signed in but does not have devices synced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320498\n", "files": ["browser/components/firefoxview/SyncedTabsController.sys.mjs", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/sidebar/kit-qr-tabs-devices-empty.svg"], "git_node": "a1464fdd7a38bb5b92afa8ebe5643c1a3d158337", "git_parents": ["1c80d4410975952c05aee36fc342404c6e61ce3c"], "node": "520e9f81d952b72e6c53ac0a7f5418b5a9eb6a7d", "parents": ["a8d78dd823fd1e3d0aa422d09fc2ebbc1c98c6f5"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2047339. r=geckoview-reviewers,nika,ipc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312246\n", "files": ["ipc/glue/GeckoChildProcessHost.cpp", "mobile/android/geckoview/src/main/aidl/org/mozilla/gecko/process/IProcessManager.aidl", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/GeckoProcessManager.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/process/GeckoServiceChildProcess.java", "widget/android/GeckoEditableSupport.cpp", "widget/android/GeckoEditableSupport.h", "widget/android/GeckoProcessManager.cpp", "widget/android/GeckoProcessManager.h"], "git_node": "c1d8ad3f29e20b1f9f4a6654ee25b82c56acfeed", "git_parents": ["a1464fdd7a38bb5b92afa8ebe5643c1a3d158337"], "node": "03c8024cddea7efb13d3d74d3a6bd11656630827", "parents": ["520e9f81d952b72e6c53ac0a7f5418b5a9eb6a7d"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065164 - Move urlbar actors to browser/components/urlbar/actors. r=dao,urlbar-reviewers\n\nThis effectively enables type checking in the actors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320436\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/actors/UrlbarParent.sys.mjs", "browser/actors/moz.build", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/urlbar/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/moz.build"], "git_node": "1ee2ddca03d435e103d195f81f644ed1254f7cc3", "git_parents": 