926cf80c5b884"], "tags": []}, {"author": "Ben Dean-Kawamura \u003cbdk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1664954 - refresh device list after showing menus, r=markh\n\nRefresh the device list after showing \"send to device\" from the tab\ncontext menu and also after showing the account menu.  This helps users\nget unstuck if the device list is stale.  It won't fix the current menu\nitems, but it will fix the next time they see the menu.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315623\n", "files": ["browser/base/content/browser-sync.js"], "git_node": "68c1227d84b90ca00f38f6eb40e8f7172ad11bd8", "git_parents": ["c85bdf4a172f63344071b878908c21458253dd95"], "node": "cb3c7175d263f8abfc4e6742621cd06abbf5735a", "parents": ["d41884647d87e7b0fab6f883721a6c714135fcc5"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2062813 - only schedule mochitest-browser-chrome and mochitest-devtools-chrome tests for Developer Edition. r=ahal\n\nThe difference to Firefox builds are some developer tools enabled by default and e.g. the developer\ntools button added to the toolbar. Platform behavior is very similar except the firing of\nMOZ_DIAGNOSTIC_ASSERT which caught no other issues than Nightly had before.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317980\n", "files": ["taskcluster/test_configs/test-platforms.yml", "taskcluster/test_configs/test-sets.yml"], "git_node": "4cbe50df59018ac5d1d4299117cd723d822844c7", "git_parents": ["68c1227d84b90ca00f38f6eb40e8f7172ad11bd8"], "node": "fb6f424052a5dc06ae810b300a67325197af6847", "parents": ["cb3c7175d263f8abfc4e6742621cd06abbf5735a"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2045044 - Part 2 - Ensure clang plugin for FINAL cycle collecting macros scans all of DOM r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305339\n", "files": ["build/clang-plugin/FinalCycleCollectingIsupportsChecker.cpp"], "git_node": "233725e9cd9c59d623103660917141519c389f81", "git_parents": ["4cbe50df59018ac5d1d4299117cd723d822844c7"], "node": "51a920d029772d5922e4bf32177f6d6cba4ed753", "parents": ["fb6f424052a5dc06ae810b300a67325197af6847"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2045970 [Linux] Enable Vulkan decode on Nightly and recent NVIDIA devices r=tboiko,media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317778\n", "files": ["dom/media/platforms/PDMFactory.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "gfx/config/gfxVars.h", "gfx/thebes/gfxPlatform.cpp", "modules/libpref/init/StaticPrefList.yaml", "widget/gtk/GfxInfo.cpp"], "git_node": "64a3caf2135053847dd2514d9a02275957871f8e", "git_parents": ["233725e9cd9c59d623103660917141519c389f81"], "node": "585a77d8786acc96527649f87cfd9cc9cff059a2", "parents": ["51a920d029772d5922e4bf32177f6d6cba4ed753"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062637 - Pass in head_git_ref when cloning from Github, r=taskgraph-reviewers,releng-reviewers,bhearsum\n\nPassing in the head ref can make clone times faster.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317828\n", "files": ["taskcluster/docs/parameters.md", "taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/parameters.py", "taskcluster/gecko_taskgraph/transforms/job/common.py", "taskcluster/test/params/autoland-cron-android-l10n-import.yml", "taskcluster/test/params/autoland-cron-l10n-bumper.yml", "taskcluster/test/params/autoland-onpush-backstop.yml", "taskcluster/test/params/autoland-onpush.yml", "taskcluster/test/params/mb-cron-android-l10n-sync.yml", "taskcluster/test/params/mb-onpush.yml", "taskcluster/test/params/mb-promote-android.yml", "taskcluster/test/params/mb-promote-devedition-partials.yml", "taskcluster/test/params/mb-promote-devedition.yml", "taskcluster/test/params/mb-promote-firefox-partials.yml", "taskcluster/test/params/mb-promote-firefox.yml", "taskcluster/test/params/mb-push-android.yml", "taskcluster/test/params/mb-push-devedition.yml", "taskcluster/test/params/mb-push-firefox-partials.yml", "taskcluster/test/params/mb-push-firefox.yml", "taskcluster/test/params/mb-ship-android.yml", "taskcluster/test/params/mb-ship-devedition.yml", "taskcluster/test/params/mb-ship-firefox-partials.yml", "taskcluster/test/params/mb-ship-firefox.yml", "taskcluster/test/params/mb-to-release-merge-automation.yml", "taskcluster/test/params/mc-android-nightly.yml", "taskcluster/test/params/mc-bump-main-merge-automation.yml", "taskcluster/test/params/mc-cron-os-integration.yml", "taskcluster/test/params/mc-cron-system-symbols.yml", "taskcluster/test/params/mc-desktop-nightly.yml", "taskcluster/test/params/mc-nightly-all.yml", "taskcluster/test/params/mc-onpush.yml", "taskcluster/test/params/mc-to-beta-merge-automation.yml", "taskcluster/test/params/me-promote-firefox.yml", "taskcluster/test/params/me-push-firefox.yml", "taskcluster/test/params/me-ship-firefox.yml", "taskcluster/test/params/mr-onpush-geckoview.yml", "taskcluster/test/params/mr-onpush.yml", "taskcluster/test/params/mr-promote-firefox.yml", "taskcluster/test/params/mr-push-android.yml", "taskcluster/test/params/mr-push-firefox.yml", "taskcluster/test/params/mr-ship-firefox.yml", "taskcluster/test/params/try-config-git-backing.yml", "tools/tryselect/push.py"], "git_node": "f55ed57a123a5c119637b929e94104ad9a6f14c3", "git_parents": ["64a3caf2135053847dd2514d9a02275957871f8e"], "node": "0eeeb87174222499a51c8f14a18a826ce8fc1ee6", "parents": ["585a77d8786acc96527649f87cfd9cc9cff059a2"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055678 - Make some session history state update early return. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318031\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "7b4241367318bf035b46681e1ec78bd30b0b7986", "git_parents": ["f55ed57a123a5c119637b929e94104ad9a6f14c3"], "node": "5dfdeaec95271c32903f40f1242d37ad2a95cdf8", "parents": ["0eeeb87174222499a51c8f14a18a826ce8fc1ee6"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062637 - Pass in head_git_ref when cloning from Github, r=taskgraph-reviewers,releng-reviewers,bhearsum\" for causing multiple linting and doc failures IGNORE BAD COMMIT MESSAGES\n\nThis reverts commit f55ed57a123a5c119637b929e94104ad9a6f14c3.\n", "files": ["taskcluster/docs/parameters.md", "taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/parameters.py", "taskcluster/gecko_taskgraph/transforms/job/common.py", "taskcluster/test/params/autoland-cron-android-l10n-import.yml", "taskcluster/test/params/autoland-cron-l10n-bumper.yml", "taskcluster/test/params/autoland-onpush-backstop.yml", "taskcluster/test/params/autoland-onpush.yml", "taskcluster/test/params/mb-cron-android-l10n-sync.yml", "taskcluster/test/params/mb-onpush.yml", "taskcluster/test/params/mb-promote-android.yml", "taskcluster/test/params/mb-promote-devedition-partials.yml", "taskcluster/test/params/mb-promote-devedition.yml", "taskcluster/test/params/mb-promote-firefox-partials.yml", "taskcluster/test/params/mb-promote-firefox.yml", "taskcluster/test/params/mb-push-android.yml", "taskcluster/test/params/mb-push-devedition.yml", "taskcluster/test/params/mb-push-firefox-partials.yml", "taskcluster/test/params/mb-push-firefox.yml", "taskcluster/test/params/mb-ship-android.yml", "taskcluster/test/params/mb-ship-devedition.yml", "taskcluster/test/params/mb-ship-firefox-partials.yml", "taskcluster/test/params/mb-ship-firefox.yml", "taskcluster/test/params/mb-to-release-merge-automation.yml", "taskcluster/test/params/mc-android-nightly.yml", "taskcluster/test/params/mc-bump-main-merge-automation.yml", "taskcluster/test/params/mc-cron-os-integration.yml", "taskcluster/test/params/mc-cron-system-symbols.yml", "taskcluster/test/params/mc-desktop-nightly.yml", "taskcluster/test/params/mc-nightly-all.yml", "taskcluster/test/params/mc-onpush.yml", "taskcluster/test/params/mc-to-beta-merge-automation.yml", "taskcluster/test/params/me-promote-firefox.yml", "taskcluster/test/params/me-push-firefox.yml", "taskcluster/test/params/me-ship-firefox.yml", "taskcluster/test/params/mr-onpush-geckoview.yml", "taskcluster/test/params/mr-onpush.yml", "taskcluster/test/params/mr-promote-firefox.yml", "taskcluster/test/params/mr-push-android.yml", "taskcluster/test/params/mr-push-firefox.yml", "taskcluster/test/params/mr-ship-firefox.yml", "taskcluster/test/params/try-config-git-backing.yml", "tools/tryselect/push.py"], "git_node": "cd104ab48546fbdc7b9ba90dba9c07c9d4f39d7f", "git_parents": ["7b4241367318bf035b46681e1ec78bd30b0b7986"], "node": "d79266ecf73adbd427fa7fa18d1d2fe8fcf353b8", "parents": ["5dfdeaec95271c32903f40f1242d37ad2a95cdf8"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045223 - Hold a local reference to the DistributionCustomizer while applying customizations. r=mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317543\n", "files": ["browser/components/distribution.sys.mjs", "browser/components/tests/unit/test_distribution_bookmarks_first.js", "browser/components/tests/unit/xpcshell.toml"], "git_node": "29bbe9f9cabda59f8db2aacd1285ecb677703e89", "git_parents": ["cd104ab48546fbdc7b9ba90dba9c07c9d4f39d7f"], "node": "1d570872319a2bb0172b2a521a72c3a21eb597c2", "parents": ["d79266ecf73adbd427fa7fa18d1d2fe8fcf353b8"], "tags": []}, {"author": "Xuan Chen \u003chenry.chen@oss.cipunited.com\u003e", "branch": "default", "desc": "Bug 2062948 - [mips64] Unmerge shared WASM Atomic code from Loong64. r=csmantle\n\nWith the introduction of LAM_BH, MIPS64 and Loong64 can no longer share\ntheir PopAndAllocate implementations since MIPS always uses the LL/SC\npair.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318098\n", "files": ["js/src/wasm/WasmBCMemory.cpp"], "git_node": "e84230bb7241601803895e263d8a9426d4e96389", "git_parents": ["29bbe9f9cabda59f8db2aacd1285ecb677703e89"], "node": "f2223b25a118a10a785f92be54b73e2711088588", "parents": ["1d570872319a2bb0172b2a521a72c3a21eb597c2"], "tags": []}, {"author": "Xuan Chen \u003chenry.chen@oss.cipunited.com\u003e", "branch": "default", "desc": "Bug 2062953 - [mips64] Fix alignedAliased for float32 registers. r=csmantle\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318099\n", "files": ["js/src/jit/mips64/Architecture-mips64.h"], "git_node": "1fd8d6e18fa2a0c013ede498db8aea7179f12c35", "git_parents": ["e84230bb7241601803895e263d8a9426d4e96389"], "node": "704a141629cafe6274c4af49ba69c7717b97614e", "parents": ["f2223b25a118a10a785f92be54b73e2711088588"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063017, don't tokenize a form fields type attribute so that the asterisks are preserved and the value is left as is, r=dimi,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318167\n", "files": ["toolkit/components/formautofill/shared/FormAutofillHeuristics.sys.mjs"], "git_node": "2f15bed2e0cd295cecb6a49a76f462eefa5e56f7", "git_parents": ["1fd8d6e18fa2a0c013ede498db8aea7179f12c35"], "node": "76f443a6bf06cb24b3f5c4a731e1d045e02e7306", "parents": ["704a141629cafe6274c4af49ba69c7717b97614e"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061890 - Build the nimbus-gradle-plugin with the kotlin-dsl plugin. r=android-reviewers,geckoview-reviewers,tcampbell\n\n`kotlin-dsl` subsumes both `java-gradle-plugin` and the explicit `kotlin(\"jvm\")` application, and builds\nagainst Gradle's embedded Kotlin by construction rather than by convention. It also supplies the Gradle\nAPI, making the explicit `gradleApi()` dependency redundant. Every other in-tree Gradle plugin build\nalready uses it; this was the last one that did not.\n\n`kotlin-dsl` applies the sam-with-receiver compiler plugin, which gives every Gradle `Action\u003cT\u003e` lambda\nan implicit receiver, so lambdas that took an explicit parameter no longer compile. Rewrite them in the\nequivalent implicit-receiver style: task registration and configuration blocks, the `fetch`/`unzip`\nspecs, `providers.of`, `FileTree.matching`/`visit`, and `ExecOperations.exec`. The `exec` block loses its\n`spec.apply { ... }` wrapper, which only existed to obtain the receiver the lambda now has.\n\nTwo places rely on resolving against an enclosing receiver rather than the innermost one: `unzip`'s\n`include` refers to the task's `platform`, and the `doFirst`/`doLast` blocks refer to task properties\nthat `Task` itself does not declare. Conversely, `fetch`'s nested `fallback` block sets `archive` and\n`hash` on the fallback spec, shadowing the identically named members of the outer spec, which is what it\nshould do.\n\nThere are no tests here, so this was checked by generating for both consumers: `FxNimbus.kt` for\n`:fenix:nimbusFeaturesDebug` is byte-identical before and after, `:focus-android:nimbusFeaturesFocusDebug`\ngenerates, and `assembleNimbusTools` was made to run so that the rewritten `matching`/`visit` extraction\npath produced a working `nimbus-fml` binary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317263\n", "files": ["mobile/android/gradle/plugins/nimbus-gradle-plugin/build.gradle.kts", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusAssembleToolsTask.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusFmlCommandTask.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusGradlePlugin.kt"], "git_node": "053f5c80daeefdd62e16ca91fb433f88373aedd6", "git_parents": ["2f15bed2e0cd295cecb6a49a76f462eefa5e56f7"], "node": "1f6c9b37a3edcfd95e707f723a48a3f6477c416f", "parents": ["76f443a6bf06cb24b3f5c4a731e1d045e02e7306"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061890 - Remove the unused maven-publish setup from the nimbus-gradle-plugin build. r=android-reviewers,geckoview-reviewers,tcampbell\n\nThe plugin is consumed through `includeBuild` from the root, Fenix and Focus settings scripts, so plugin\nsubstitution resolves `org.mozilla.nimbus-gradle-plugin` from the descriptors `kotlin-dsl` generates\nrather than from a publication. Nothing configures a publication or a repository to publish to, and\nnothing in the tree or in automation invokes any of the four publish tasks the plugin contributed, all of\nwhich could only target the local Maven cache.\n\nIt arrived with the plugin from application-services, where the plugin genuinely was published, and\npredates the Groovy to Kotlin DSL conversion.\n\nVerified that `:fenix:nimbusFeaturesDebug` and `:focus-android:nimbusFeaturesFocusDebug` still resolve\nthe plugin and generate byte-identical output afterwards.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317264\n", "files": ["mobile/android/gradle/plugins/nimbus-gradle-plugin/build.gradle.kts"], "git_node": "8e59d8184fdcfcdbedd1bfc126cd5cbfc6273a9c", "git_parents": ["053f5c80daeefdd62e16ca91fb433f88373aedd6"], "node": "8fde0714f3d267a57a4d7da54f54419327df7ceb", "parents": ["1f6c9b37a3edcfd95e707f723a48a3f6477c416f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061890 - Write the nimbus-gradle-plugin's build output to the object directory. r=android-reviewers,geckoview-reviewers,tcampbell\n\nThis was the last of the in-tree Gradle plugin builds still writing `build/` into the source tree;\n`plugins/conventions` and `android-components/plugins/dependencies` both redirect to the object\ndirectory. The settings script already passes the mozconfig through, so `topobjdir` is available.\n\nIt also takes two of the three license errors `./mach lint` reports for the plugin directory out of the\npicture, since they came from `build/pluginDescriptors` and `build/resources`. The third is\n`.gradle/buildOutputCleanup/cache.properties`, which is the project cache rather than the build\ndirectory and so is unaffected; every plugin build has it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317265\n", "files": ["mobile/android/gradle/plugins/nimbus-gradle-plugin/build.gradle.kts"], "git_node": "68231239e9d6bf7b82cfb8054ee4fa9c310034f7", "git_parents": ["8e59d8184fdcfcdbedd1bfc126cd5cbfc6273a9c"], "node": "74cbbeaddbe5065a04a782ddd0ea5413a346a590", "parents": ["8fde0714f3d267a57a4d7da54f54419327df7ceb"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061890 - Remove two Nimbus plugin properties that nothing reads. r=android-reviewers,geckoview-reviewers,tcampbell,beth\n\n`NimbusPluginExtension.outputDir` is documented as defaulting to the generated sources folder, but the\nplugin never reads it: the generated sources directory comes from `NimbusFeaturesTask.outputDir`, which\nthe plugin sets per variant and hands to `addGeneratedSourceDirectory`. None of the projects that\nconfigure the `nimbus` extension sets it either.\n\n`NimbusAssembleToolsTask.cacheRoot` is set by the plugin and likewise never read. It is annotated\n`@Internal`, so Gradle does not consider it for up-to-date checks, and the cache location the task\nactually uses is the `cacheDir` provider computed alongside it, which `archiveFile` and `hashFile` are\nderived from.\n\nNeither is reachable from outside the tree, since the plugin is consumed only through `includeBuild`.\nThe download and extraction path still works with `cacheRoot` gone: with the binary deleted,\n`assembleNimbusTools` runs, extracts from the cached archive, and generation output is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317266\n", "files": ["mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusAssembleToolsTask.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusGradlePlugin.kt"], "git_node": "95a02f2c5527bf409b0413c0e06fbd59356115a6", "git_parents": ["68231239e9d6bf7b82cfb8054ee4fa9c310034f7"], "node": "c13f5ac9502f26e0bd41b1eb2789e7b9f6e5264b", "parents": ["74cbbeaddbe5065a04a782ddd0ea5413a346a590"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061890 - Tidy the imports in NimbusGradlePlugin. r=android-reviewers,geckoview-reviewers,tcampbell\n\n`TaskProvider` and `RegularFile` were spelled out in full at each use, and the `isTruthy` import sat in\nthe middle of the `org.gradle` block. Nothing lints these sources, so this is consistency only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317267\n", "files": ["mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusGradlePlugin.kt"], "git_node": "859ba2f7cb565c3fbb178ef882b52f7a10885698", "git_parents": ["95a02f2c5527bf409b0413c0e06fbd59356115a6"], "node": "8232eab7d3bc88aec58a4414953d6892edc1881f", "parents": ["c13f5ac9502f26e0bd41b1eb2789e7b9f6e5264b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061890 - Drop the vestigial experimenterManifest setting. r=android-reviewers,geckoview-reviewers,ohall\n\nThe Nimbus plugin stopped generating a manifest for Experimenter in application-services commit\n465af634f, \"Modify Android Gradle plugin to use validate instead of generate-experimenter\", in October\n2023: `setupExperimenterTasks` and the `generate-experimenter` invocation went away in favour of the\nvalidate task the plugin still has. The `experimenterManifest` property was left declared on the\nextension, and the in-tree copy inherited it along with the rest of the plugin.\n\nSo nothing reads it. Fenix and Focus still point it at their `.experimenter.yaml`, and the comment above\nthe setting describes that file as generated by the FML, which it no longer is. Both files are real and\nchecked in, but they are maintained by hand now, as step 6 of\n`mobile/android/fenix/docs/Implementing-a-Nimbus-Experiment.md` instructs. Remove the property and both\nsettings together, since dropping the property alone would fail those two builds at configuration time.\n\n`nimbus-fml` does still have a `generate-experimenter` command, but nothing in the tree invokes it or\nchecks the committed manifests against the feature definitions, so keeping them in sync stays manual.\nThis commit only removes the knob that does nothing; restoring generation would take a new task.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317268\n", "files": ["mobile/android/fenix/app/build.gradle", "mobile/android/focus-android/app/build.gradle", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusGradlePlugin.kt"], "git_node": "3f60bf8c6109b565943383c488b20804e033ceb6", "git_parents": ["859ba2f7cb565c3fbb178ef882b52f7a10885698"], "node": "4eab67f94769314f7517f98f80245e59175b58d1", "parents": ["8232eab7d3bc88aec58a4414953d6892edc1881f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061890 - Fix the dead application-services link in the Nimbus plugin README. r=android-reviewers,geckoview-reviewers,tcampbell\n\nThe link pointed at `tools/nimbus-gradle-plugin` in application-services, which 404s: that copy was\nremoved in application-services#7184, which is why the plugin lives here now. Point at the removal\ninstead, and drop a stray word from the opening sentence.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317269\n", "files": ["mobile/android/gradle/plugins/nimbus-gradle-plugin/README.md"], "git_node": "5bbb81661489f4c062b43f5d181fc1aca67d6ca3", "git_parents": ["3f60bf8c6109b565943383c488b20804e033ceb6"], "node": "1a68b639896923e7cf1156b3462f3405257750f1", "parents": ["4eab67f94769314f7517f98f80245e59175b58d1"], "tags": []}, {"author": "yazan \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041115 - Add inline icon support to MSLocalized and LinkParagraph. r=omc-reviewers,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315689\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_configurable_ui.js", "browser/components/asrouter/content-src/components/LinkParagraph.jsx", "browser/components/asrouter/content-src/components/MSLocalized.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/docs/feature-callout.md", "browser/components/asrouter/tests/unit/content-src/components/LinkParagraph.test.jsx", "browser/components/asrouter/tests/unit/content-src/components/MSLocalized.test.jsx"], "git_node": "c9ff57310085d394ed8277f9ce8a72d6c8df877b", "git_parents": ["5bbb81661489f4c062b43f5d181fc1aca67d6ca3"], "node": "af852f6b569d4f31