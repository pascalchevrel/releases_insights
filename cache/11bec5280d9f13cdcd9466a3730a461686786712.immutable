81b2b5a7e2f836919e3433824", "git_parents": ["23de33645e194ccc28489555687e67dd7eacac90"], "node": "ebbad8d326d6b7b285e839d746a0404c3e9da8a7", "parents": ["67e4133f8dfa6826e96ff048371a268952c086d8"], "tags": []}, {"author": "calixteman \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2063901 - Don't drop implicit row headers when building the PDF struct tree. r=Jamie\n\nPdfStructTreeBuilder::BuildStructSubtree passed the same array to\nColHeaderCells and RowHeaderCells. CachedTableCellAccessible::RowHeaderCells\nonly falls back to implicit row headers if the array is still empty after\nhandling explicit headers, so the column headers already in the array\nsuppressed that fallback and the row headers were lost.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318945\n", "files": ["accessible/pdf/PdfStructTreeBuilder.cpp", "accessible/tests/browser/pdfOutput/browser_structTree.js", "accessible/tests/browser/pdfOutput/head.js"], "git_node": "3fbe686c75b48d174089d8108ecdc4e9526fdecc", "git_parents": ["d8f6a8429a4351a81b2b5a7e2f836919e3433824"], "node": "0b840dd22bd4b650a79d3b517471ccdff3d6f63a", "parents": ["ebbad8d326d6b7b285e839d746a0404c3e9da8a7"], "tags": []}, {"author": "calixteman \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2063815 - Update the PDF struct tree test expectations for table attributes. r=Jamie\n\npdf.js now exposes table structure attributes, so the struct tree reported for\nthe table in testBasic includes Scope, Headers and element ids.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318946\n", "files": ["accessible/tests/browser/pdfOutput/browser_structTree.js"], "git_node": "e90625d3ee460d08f463cb41fdd5a5dcb8deb626", "git_parents": ["3fbe686c75b48d174089d8108ecdc4e9526fdecc"], "node": "a06d3d539e9102863a6b4e3b2ff7df65ab89da20", "parents": ["0b840dd22bd4b650a79d3b517471ccdff3d6f63a"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2045044 - Part 2 - Ensure clang plugin for FINAL cycle collecting macros scans all of DOM r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305339\n", "files": ["build/clang-plugin/FinalCycleCollectingIsupportsChecker.cpp"], "git_node": "385a7f6969de226f5d59c584b0371c5a6dc23869", "git_parents": ["e90625d3ee460d08f463cb41fdd5a5dcb8deb626"], "node": "2e73eccdaa8e083a02f02cb94ddd2db749cc16e9", "parents": ["a06d3d539e9102863a6b4e3b2ff7df65ab89da20"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2063874. Remove four protobuf .proto files that moz.yaml excludes. r=firefox-build-system-reviewers,sergesanspaille\n\ntoolkit/components/protobuf/moz.yaml lists these four files under `exclude`, so vendoring\ndeletes them and the tree does not reproduce:\n\n  src/google/protobuf/cpp_file_options.proto\n  src/google/protobuf/cpp_options.proto\n  src/google/protobuf/json_enumvalue_options.proto\n  src/google/protobuf/json_options.proto\n\nThey arrived with the v35.0 update in bug 1989886, which added the exclude entries for them\nin the same change, so having them in the tree looks unintended. Nothing outside moz.yaml\nreferences them and they are not part of the build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318920\n", "files": ["toolkit/components/protobuf/src/google/protobuf/cpp_file_options.proto", "toolkit/components/protobuf/src/google/protobuf/cpp_options.proto", "toolkit/components/protobuf/src/google/protobuf/json_enumvalue_options.proto", "toolkit/components/protobuf/src/google/protobuf/json_options.proto"], "git_node": "2219644bf726dcfc66c6aacc257ced58594777e7", "git_parents": ["385a7f6969de226f5d59c584b0371c5a6dc23869"], "node": "bfd04fc58cc08dc107ba1477e58a0cdb7a1a9cf5", "parents": ["2e73eccdaa8e083a02f02cb94ddd2db749cc16e9"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2062547 - Concatenate per-test testsummary logs into summary.jsonl r=ahal\n\nIn per-test mode the harness runs once per modified test file and each run\ntruncates the log file it is given, so the fixed summary.jsonl name introduced\nby bug 2051646 left only the last run's results in the uploaded artifact.\n\nGive each run its own indexed testsummary log again and append it to\nsummary.jsonl once the run completes, keeping the stable artifact name while\nretaining every run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317740\n", "files": ["testing/mozharness/mozharness/mozilla/testing/per_test_base.py", "testing/mozharness/scripts/android_emulator_unittest.py", "testing/mozharness/scripts/android_hardware_unittest.py", "testing/mozharness/scripts/desktop_unittest.py", "testing/mozharness/test/python.toml", "testing/mozharness/test/test_mozilla_per_test_base.py"], "git_node": "ae44406ef1b143d3b457b6ecab75a47a30da1d1e", "git_parents": ["2219644bf726dcfc66c6aacc257ced58594777e7"], "node": "09bf86003722c8cb7208814a82ccc74d9e1f6624", "parents": ["bfd04fc58cc08dc107ba1477e58a0cdb7a1a9cf5"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062642 - Enable hw support for AV1 in WebRTC with a pref, when available on the platform. r=webrtc-reviewers,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318439\n", "files": ["dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "498711e128fedb7f40800f98a368a23f17348a91", "git_parents": ["ae44406ef1b143d3b457b6ecab75a47a30da1d1e"], "node": "edf65dcab738c855aca217798eb6eb152075b974", "parents": ["09bf86003722c8cb7208814a82ccc74d9e1f6624"], "tags": []}, {"author": "Theo Hale \u003c5333778+HaTheo@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2046541 [wpt PR 60533] - Add UIA wapper and enable support for core-aam tests (application, article, banner, blockquote, etc.), a=testonly\n\nAutomatic update from web-platform-tests\nAdd UIA wapper and enable support for core-aam tests (application, article, banner, blockquote, etc.)\n\nThis introduces Windows UI Automation (UIA) support to the `core-aam` test suite and adds initial test coverage for several ARIA roles.\n\nKey Changes:\n* `UiaWrapper` Implementation: Added `core-aam/aamtests/support/uia_wrapper.py` which uses `comtypes` to interface directly with `UIAutomationCore.dll`. It provides mappings for UIA constants and methods to retrieve control types, localized control types, properties, and landmark types.\n* UIA Fixture: Registered the new `uia` accessibility API fixture in `fixtures_a11y_api.py`.\n* Role Tests: Added `test_uia` assertions for all ARIA roles currently listed.\n\nThis lays the essential groundwork for expanding UIA test coverage in WPT.\n--\n\nwpt-commits: 5e7e05030fa5f8bccdd3600d719921f26143415a\nwpt-pr: 60533\n", "files": ["testing/web-platform/tests/core-aam/aamtests/role/alert.py", "testing/web-platform/tests/core-aam/aamtests/role/alertdialog.py", "testing/web-platform/tests/core-aam/aamtests/role/application.py", "testing/web-platform/tests/core-aam/aamtests/role/article.py", "testing/web-platform/tests/core-aam/aamtests/role/banner.py", "testing/web-platform/tests/core-aam/aamtests/role/blockquote.py", "testing/web-platform/tests/core-aam/aamtests/role/button.py", "testing/web-platform/tests/core-aam/aamtests/role/button_haspopup.py", "testing/web-platform/tests/core-aam/aamtests/role/button_pressed.py", "testing/web-platform/tests/core-aam/aamtests/role/caption.py", "testing/web-platform/tests/core-aam/aamtests/role/cell.py", "testing/web-platform/tests/core-aam/aamtests/role/checkbox.py", "testing/web-platform/tests/core-aam/aamtests/role/code-role.py", "testing/web-platform/tests/core-aam/aamtests/role/columnheader.py", "testing/web-platform/tests/core-aam/aamtests/role/combobox.py", "testing/web-platform/tests/core-aam/aamtests/role/comment.py", "testing/web-platform/tests/core-aam/aamtests/role/complementary.py", "testing/web-platform/tests/core-aam/aamtests/role/contentinfo.py", "testing/web-platform/tests/core-aam/aamtests/role/definition.py", "testing/web-platform/tests/core-aam/aamtests/role/deletion.py", "testing/web-platform/tests/core-aam/aamtests/role/dialog.py", "testing/web-platform/tests/core-aam/aamtests/role/directory.py", "testing/web-platform/tests/core-aam/aamtests/role/document.py", "testing/web-platform/tests/core-aam/aamtests/role/emphasis.py", "testing/web-platform/tests/core-aam/aamtests/role/feed.py", "testing/web-platform/tests/core-aam/aamtests/role/figure.py", "testing/web-platform/tests/core-aam/aamtests/role/form.py", "testing/web-platform/tests/core-aam/aamtests/role/generic.py", "testing/web-platform/tests/core-aam/aamtests/role/grid.py", "testing/web-platform/tests/core-aam/aamtests/role/gridcell.py", "testing/web-platform/tests/core-aam/aamtests/role/group.py", "testing/web-platform/tests/core-aam/aamtests/role/heading.py", "testing/web-platform/tests/core-aam/aamtests/role/image.py", "testing/web-platform/tests/core-aam/aamtests/role/img.py", "testing/web-platform/tests/core-aam/aamtests/role/insertion.py", "testing/web-platform/tests/core-aam/aamtests/role/link.py", "testing/web-platform/tests/core-aam/aamtests/role/list.py", "testing/web-platform/tests/core-aam/aamtests/role/listbox.py", "testing/web-platform/tests/core-aam/aamtests/role/listbox_in_combobox.py", "testing/web-platform/tests/core-aam/aamtests/role/listitem.py", "testing/web-platform/tests/core-aam/aamtests/role/log.py", "testing/web-platform/tests/core-aam/aamtests/role/main.py", "testing/web-platform/tests/core-aam/aamtests/role/mark.py", "testing/web-platform/tests/core-aam/aamtests/role/marquee.py", "testing/web-platform/tests/core-aam/aamtests/role/math-role.py", "testing/web-platform/tests/core-aam/aamtests/role/menu.py", "testing/web-platform/tests/core-aam/aamtests/role/menubar.py", "testing/web-platform/tests/core-aam/aamtests/role/menuitem.py", "testing/web-platform/tests/core-aam/aamtests/role/menuitemcheckbox.py", "testing/web-platform/tests/core-aam/aamtests/role/menuitemradio.py", "testing/web-platform/tests/core-aam/aamtests/role/meter.py", "testing/web-platform/tests/core-aam/aamtests/role/navigation.py", "testing/web-platform/tests/core-aam/aamtests/role/note.py", "testing/web-platform/tests/core-aam/aamtests/role/option.py", "testing/web-platform/tests/core-aam/aamtests/role/option_in_combobox.py", "testing/web-platform/tests/core-aam/aamtests/role/paragraph.py", "testing/web-platform/tests/core-aam/aamtests/role/progressbar.py", "testing/web-platform/tests/core-aam/aamtests/role/radio.py", "testing/web-platform/tests/core-aam/aamtests/role/radiogroup.py", "testing/web-platform/tests/core-aam/aamtests/role/region.py", "testing/web-platform/tests/core-aam/aamtests/role/row.py", "testing/web-platform/tests/core-aam/aamtests/role/row_in_treegrid.py", "testing/web-platform/tests/core-aam/aamtests/role/rowgroup.py", "testing/web-platform/tests/core-aam/aamtests/role/rowheader.py", "testing/web-platform/tests/core-aam/aamtests/role/scrollbar.py", "testing/web-platform/tests/core-aam/aamtests/role/search.py", "testing/web-platform/tests/core-aam/aamtests/role/searchbox.py", "testing/web-platform/tests/core-aam/aamtests/role/sectionfooter.py", "testing/web-platform/tests/core-aam/aamtests/role/sectionheader.py", "testing/web-platform/tests/core-aam/aamtests/role/separator.py", "testing/web-platform/tests/core-aam/aamtests/role/separator_focusable.py", "testing/web-platform/tests/core-aam/aamtests/role/slider.py", "testing/web-platform/tests/core-aam/aamtests/role/spinbutton.py", "testing/web-platform/tests/core-aam/aamtests/role/status.py", "testing/web-platform/tests/core-aam/aamtests/role/strong.py", "testing/web-platform/tests/core-aam/aamtests/role/subscript.py", "testing/web-platform/tests/core-aam/aamtests/role/suggestion.py", "testing/web-platform/tests/core-aam/aamtests/role/superscript.py", "testing/web-platform/tests/core-aam/aamtests/role/switch.py", "testing/web-platform/tests/core-aam/aamtests/role/tab.py", "testing/web-platform/tests/core-aam/aamtests/role/table.py", "testing/web-platform/tests/core-aam/aamtests/role/tablist.py", "testing/web-platform/tests/core-aam/aamtests/role/tabpanel.py", "testing/web-platform/tests/core-aam/aamtests/role/term.py", "testing/web-platform/tests/core-aam/aamtests/role/textbox.py", "testing/web-platform/tests/core-aam/aamtests/role/textbox_multiline.py", "testing/web-platform/tests/core-aam/aamtests/role/time-role.py", "testing/web-platform/tests/core-aam/aamtests/role/timer.py", "testing/web-platform/tests/core-aam/aamtests/role/toolbar.py", "testing/web-platform/tests/core-aam/aamtests/role/tooltip.py", "testing/web-platform/tests/core-aam/aamtests/role/tree.py", "testing/web-platform/tests/core-aam/aamtests/role/treegrid.py", "testing/web-platform/tests/core-aam/aamtests/role/treeitem.py", "testing/web-platform/tests/core-aam/aamtests/support/fixtures_a11y_api.py", "testing/web-platform/tests/core-aam/aamtests/support/uia_wrapper.py"], "git_node": "d3773406f9806ad01f69c3ea0c28e720e8858bbb", "git_parents": ["498711e128fedb7f40800f98a368a23f17348a91"], "node": "ceffd2619e137fc79992674a6fc527327cd54f2a", "parents": ["edf65dcab738c855aca217798eb6eb152075b974"], "tags": []}, {"author": "Theo Hale \u003c5333778+HaTheo@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2049221 [wpt PR 60778] - Implement accessibility property support via CDP for Chrome, a=testonly\n\nAutomatic update from web-platform-tests\nImplement accessibility property support via CDP for Chrome\n\nIntroduces `ChromeDriverAccessibilityProtocolPart` to provide accessibility tree and computed property support for Chrome under `wptrunner`. This mirrors the pattern used by existing drivers (such as Marionette) and leverages the Chrome DevTools Protocol (`CDP`) `Accessibility.getPartialAXTree` command(https://chromedevtools.github.io/devtools-protocol/tot/Accessibility/#method-getPartialAXTree). It also, as a result, adds support for Edge and other Chromium browsers.\n\n* Protocol Implementation: Added `ChromeDriverAccessibilityProtocolPart` (subclassing `WebDriverAccessibilityProtocolPart`) to fetch computed labels, roles, and tree structures via CDP commands `Accessibility.getPartialAXTree`.\n* Changes to aria-utils.js to cast elements to a String to prevent a undefined =! \"undefined\" bug\n--\n\nwpt-commits: 43f8a304cbfde06c09d20cf8300da57ce5c4b41b\nwpt-pr: 60778\n", "files": ["testing/web-platform/tests/tools/wptrunner/wptrunner/executors/executorchrome.py", "testing/web-platform/tests/wai-aria/scripts/aria-utils.js"], "git_node": "0c8c98e2315ef43d0337716160abec2e7b1c5815", "git_parents": ["d3773406f9806ad01f69c3ea0c28e720e8858bbb"], "node": "88fc316540fe59488272ccf48ac99dd082c796e5", "parents": ["ceffd2619e137fc79992674a6fc527327cd54f2a"], "tags": []}, {"author": "Valerie Young \u003cspectranaut@igalia.com\u003e", "branch": "default", "desc": "Bug 2061590 [wpt PR 61801] - aamtest: add GNOME_ACCESSIBILITY for firefox runs, a=testonly\n\nAutomatic update from web-platform-tests\naamtest: add GNOME_ACCESSIBILITY for firefox runs\n\n--\n\nwpt-commits: 9bc6e2404bff5349e48d7962b0a495582bc5ade8\nwpt-pr: 61801\n", "files": ["testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py"], "git_node": "06949b116d542d88b6f63d4aea30273ce9361d02", "git_parents": ["0c8c98e2315ef43d0337716160abec2e7b1c5815"], "node": "dfac5b01c89da3e05a5abc2105358aa87391209a", "parents": ["88fc316540fe59488272ccf48ac99dd082c796e5"], "tags": []}, {"author": "Javier Fern\u00e1ndez Garc\u00eda-Boente \u003cjfernandez@igalia.com\u003e", "branch": "default", "desc": "Bug 2061684 [wpt PR 61809] - [Typed OM] Support the logical border longhands, a=testonly\n\nAutomatic update from web-platform-tests\n[Typed OM] Support the logical border longhands\n\nborder-{block,inline}-{start,end}-{width,style,color} carried no\ntypedom_types at all, while their physical counterparts border-top-* all\ndo. StylePropertyMap therefore rejected every value for them: set()\nthrew \"Invalid type for property\" and get() returned the base\nCSSStyleValue, even though setting the same value as a string worked.\n\nGive them the typedom_types their physical counterparts already have --\nKeyword and Length for the widths, Keyword for the styles and colors.\nThe colors additionally needed the keywords list ('currentcolor') that\nborder-top-color already carries. Nothing else is required: once the\nTyped OM tables know about them, the logical longhands behave exactly\nlike the physical ones, verified for the specified and computed value of\neach keyword.\n\nlogical.html also has a bug of its own. For border-*-width it omitted\nthe computed callbacks that border-width.html supplies for the physical\nproperties, so it expected the computed value of 'thin' to be\nCSSKeywordValue('thin') rather than the 1px it computes to. Add them.\n\nChange-Id: Idc2bc939514bb6ee11913a407761a54718ec21f7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8209360\nCommit-Queue: Javier Fernandez \u003cjfernandez@igalia.com\u003e\nReviewed-by: Anders Hartvoll Ruud \u003candruud@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1677067}\n\n--\n\nwpt-commits: 5297796ed8f7b5022f91b0c3ea90dfe31f21f799\nwpt-pr: 61809\n", "files": ["testing/web-platform/tests/css/css-typed-om/the-stylepropertymap/properties/logical.html"], "git_node": "57df8d81dd0dcd04ae6d685b1efd2dac5876079d", "git_parents": ["06949b116d542d88b6f63d4aea30273ce9361d02"], "node": "18ae1d9ab13c99fcc166db274bd50af36e66bc22", "parents": ["dfac5b01c89da3e05a5abc2105358aa87391209a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061684 [wpt PR 61809] - Update wpt metadata, a=testonly\n\nwpt-pr: 61809\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-typed-om/the-stylepropertymap/properties/logical.html.ini"], "git_node": "ad73628d5a80d60e9a8e438cce3311c85340abdb", "git_parents": ["57df8d81dd0dcd04ae6d685b1efd2dac5876079d"], "node": "2e6a5a1b99ed67298360aaf4753574a437a1b9c7", "parents": ["18ae1d9ab13c99fcc166db274bd50af36e66bc22"], "tags": []}, {"author": "Florian Rivoal \u003cgit@florian.rivoal.net\u003e", "branch": "default", "desc": "Bug 2062585 [wpt PR 61850] - test that float clipping in line-clamp is at the unshaped content edge, a=testonly\n\nAutomatic update from web-platform-tests\ntest that float clipping in line-clamp is at the unshaped content edge (#61850)\n\nSee https://github.com/w3c/csswg-drafts/issues/14067, as well as\nhttps://github.com/w3c/csswg-drafts/issues/12665\n--\n\nwpt-commits: eb7aa8a1d700d76170f68cf5c8da748928abd32f\nwpt-pr: 61850\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-with-floats-011.html"], "git_node": "f9a5016727d0c7801a0f794c330dff34f8590e21", "git_parents": ["ad73628d5a80d60e9a8e438cce3311c85340abdb"], "node": "6f48919f6317ee137d8af06d82282eb27620de87", "parents": ["2e6a5a1b99ed67298360aaf4753574a437a1b9c7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062585 [wpt PR 61850] - Update wpt metadata, a=testonly\n\nwpt-pr: 61850\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-floats-011.html.ini"], "git_node": "c3224a8538d72acd2d2b69fd88e47feb9ba1cdb9", "git_parents": ["f9a5016727d0c7801a0f794c330dff34f8590e21"], "node": "0450c902c74cc5e756f9623d5c865a8fc59ce7ee", "parents": ["6f48919f6317ee137d8af06d82282eb27620de87"], "tags": []}, {"author": "Jake Archibald \u003cjaffathecake@gmail.com\u003e", "branch": "default", "desc": "Bug 2061564 [wpt PR 61795] - Update existing tests for popovers reacting to fullscreen & dialog open, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate existing tests for popovers reacting to fullscreen & dialog open, and remove redundant test\n\nSee https://github.com/whatwg/html/pull/12764\n--\n\nwpt-commits: e46272bf2e14781f0375138fa427bf512f38684a\nwpt-pr: 61795\n", "files": ["testing/web-platform/tests/html/semantics/popovers/popover-hint-dialog-dismisses-unrelated-auto.html"], "git_node": "b3058b2caba7fb7bdc1c00a60288af09756714b2", "git_parents": ["c3224a8538d72acd2d2b69fd88e47feb9ba1cdb9"], "node": "6fcb1dff018a6c8868457cd1efb92063448e80f8", "parents": ["0450c902c74cc5e756f9623d5c865a8fc59ce7ee"], "tags": []}, {"author": "Florian Rivoal \u003cgit@florian.rivoal.net\u003e", "branch": "default", "desc": "Bug 2062630 [wpt PR 61853] - Add test for strut insertion with block ellipsis, a=testonly\n\nAutomatic update from web-platform-tests\nAdd test for strut insertion with block ellipsis (#61853)\n\nWe only insert a strut based on the root inline, not on any interrupted\ninline box that might be there otherwise.\n\nSee https://github.com/w3c/csswg-drafts/issues/13786\n--\n\nwpt-commits: 1518939bc5d88ae5ab91aee9fa246e9920b87143\nwpt-pr: 61853\n", "files": ["testing/web-platform/tests/css/css-overflow/line-clamp/block-ellipsis-039.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/block-ellipsis-039-ref.html"], "git_node": "45bf296c96e07b2cbcc14af39c643f0ad3d59e53", "git_parents": ["b3058b2caba7fb7bdc1c00a60288af09756714b2"], "node": "a1d32b9f1578a7bb74cddfe4e9ce6b9488b748a9", "parents": ["6fcb1dff018a6c8868457cd1efb92063448e80f8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062630 [wpt PR 61853] - Update wpt metadata, a=testonly\n\nwpt-pr: 61853\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-039.html.ini"], "git_node": "179290b2def3aeb91039167c9629864836921bdc", "git_parents": ["45bf296c96e07b2cbcc14af