third_party/rust/encoding_rs/doc/macintosh.txt", "third_party/rust/encoding_rs/doc/replacement.txt", "third_party/rust/encoding_rs/doc/windows-1250.txt", "third_party/rust/encoding_rs/doc/windows-1251.txt", "third_party/rust/encoding_rs/doc/windows-1252.txt", "third_party/rust/encoding_rs/doc/windows-1253.txt", "third_party/rust/encoding_rs/doc/windows-1254.txt", "third_party/rust/encoding_rs/doc/windows-1255.txt", "third_party/rust/encoding_rs/doc/windows-1256.txt", "third_party/rust/encoding_rs/doc/windows-1257.txt", "third_party/rust/encoding_rs/doc/windows-1258.txt", "third_party/rust/encoding_rs/doc/windows-874.txt", "third_party/rust/encoding_rs/doc/x-mac-cyrillic.txt", "third_party/rust/encoding_rs/doc/x-user-defined.txt", "third_party/rust/encoding_rs/generate-encoding-data.py", "third_party/rust/encoding_rs/rustfmt.toml", "third_party/rust/encoding_rs/src/ascii.rs", "third_party/rust/encoding_rs/src/big5.rs", "third_party/rust/encoding_rs/src/data.rs", "third_party/rust/encoding_rs/src/euc_jp.rs", "third_party/rust/encoding_rs/src/euc_kr.rs", "third_party/rust/encoding_rs/src/gb18030.rs", "third_party/rust/encoding_rs/src/handles.rs", "third_party/rust/encoding_rs/src/iso_2022_jp.rs", "third_party/rust/encoding_rs/src/lib.rs", "third_party/rust/encoding_rs/src/macros.rs", "third_party/rust/encoding_rs/src/mem.rs", "third_party/rust/encoding_rs/src/shift_jis.rs", "third_party/rust/encoding_rs/src/simd_funcs.rs", "third_party/rust/encoding_rs/src/single_byte.rs", "third_party/rust/encoding_rs/src/test_data/big5_in.txt", "third_party/rust/encoding_rs/src/test_data/big5_in_ref.txt", "third_party/rust/encoding_rs/src/test_data/big5_out.txt", "third_party/rust/encoding_rs/src/test_data/big5_out_ref.txt", "third_party/rust/encoding_rs/src/test_data/euc_kr_in.txt", "third_party/rust/encoding_rs/src/test_data/euc_kr_in_ref.txt", "third_party/rust/encoding_rs/src/test_data/euc_kr_out.txt", "third_party/rust/encoding_rs/src/test_data/euc_kr_out_ref.txt", "third_party/rust/encoding_rs/src/test_data/gb18030_in.txt", "third_party/rust/encoding_rs/src/test_data/gb18030_in_ref.txt", "third_party/rust/encoding_rs/src/test_data/gb18030_out.txt", "third_party/rust/encoding_rs/src/test_data/gb18030_out_ref.txt", "third_party/rust/encoding_rs/src/test_data/iso_2022_jp_in.txt", "third_party/rust/encoding_rs/src/test_data/iso_2022_jp_in_ref.txt", "third_party/rust/encoding_rs/src/test_data/iso_2022_jp_out.txt", "third_party/rust/encoding_rs/src/test_data/iso_2022_jp_out_ref.txt", "third_party/rust/encoding_rs/src/test_data/jis0208_in.txt", "third_party/rust/encoding_rs/src/test_data/jis0208_in_ref.txt", "third_party/rust/encoding_rs/src/test_data/jis0208_out.txt", "third_party/rust/encoding_rs/src/test_data/jis0208_out_ref.txt", "third_party/rust/encoding_rs/src/test_data/jis0212_in.txt", "third_party/rust/encoding_rs/src/test_data/jis0212_in_ref.txt", "third_party/rust/encoding_rs/src/test_data/shift_jis_in.txt", "third_party/rust/encoding_rs/src/test_data/shift_jis_in_ref.txt", "third_party/rust/encoding_rs/src/test_data/shift_jis_out.txt", "third_party/rust/encoding_rs/src/test_data/shift_jis_out_ref.txt", "third_party/rust/encoding_rs/src/utf_16.rs", "third_party/rust/encoding_rs/src/utf_8.rs", "third_party/rust/encoding_rs/src/variant.rs", "third_party/rust/encoding_rs/src/x_user_defined.rs", "third_party/rust/multiversion-macros/.cargo-checksum.json", "third_party/rust/multiversion-macros/.cargo_vcs_info.json", "third_party/rust/multiversion-macros/Cargo.toml", "third_party/rust/multiversion-macros/Cargo.toml.orig", "third_party/rust/multiversion-macros/LICENSE-APACHE", "third_party/rust/multiversion-macros/LICENSE-MIT", "third_party/rust/multiversion-macros/README.md", "third_party/rust/multiversion-macros/src/cfg.rs", "third_party/rust/multiversion-macros/src/dispatcher.rs", "third_party/rust/multiversion-macros/src/lib.rs", "third_party/rust/multiversion-macros/src/match_target.rs", "third_party/rust/multiversion-macros/src/multiversion.rs", "third_party/rust/multiversion-macros/src/target.rs", "third_party/rust/multiversion-macros/src/util.rs", "third_party/rust/multiversion/.cargo-checksum.json", "third_party/rust/multiversion/.cargo_vcs_info.json", "third_party/rust/multiversion/Cargo.toml", "third_party/rust/multiversion/Cargo.toml.orig", "third_party/rust/multiversion/LICENSE-APACHE", "third_party/rust/multiversion/LICENSE-MIT", "third_party/rust/multiversion/README.md", "third_party/rust/multiversion/benches/benchmark.rs", "third_party/rust/multiversion/src/lib.rs", "third_party/rust/multiversion/tests/async_fn.rs", "third_party/rust/multiversion/tests/attrs.rs", "third_party/rust/multiversion/tests/cfg.rs", "third_party/rust/multiversion/tests/choose_dispatcher.rs", "third_party/rust/multiversion/tests/clones.rs", "third_party/rust/multiversion/tests/destructure.rs", "third_party/rust/multiversion/tests/generics.rs", "third_party/rust/multiversion/tests/helpers.rs", "third_party/rust/multiversion/tests/impl_trait.rs", "third_party/rust/multiversion/tests/simd.rs", "third_party/rust/multiversion_no_op/.cargo-checksum.json", "third_party/rust/multiversion_no_op/.cargo_vcs_info.json", "third_party/rust/multiversion_no_op/COPYRIGHT", "third_party/rust/multiversion_no_op/Cargo.toml", "third_party/rust/multiversion_no_op/Cargo.toml.orig", "third_party/rust/multiversion_no_op/LICENSE-APACHE", "third_party/rust/multiversion_no_op/LICENSE-MIT", "third_party/rust/multiversion_no_op/README.md", "third_party/rust/multiversion_no_op/src/lib.rs", "third_party/rust/simdutf8/.cargo-checksum.json", "third_party/rust/simdutf8/.cargo_vcs_info.json", "third_party/rust/simdutf8/CHANGELOG.md", "third_party/rust/simdutf8/Cargo.lock", "third_party/rust/simdutf8/Cargo.toml", "third_party/rust/simdutf8/Cargo.toml.orig", "third_party/rust/simdutf8/LICENSE-Apache", "third_party/rust/simdutf8/LICENSE-MIT", "third_party/rust/simdutf8/README.md", "third_party/rust/simdutf8/examples/streaming.rs", "third_party/rust/simdutf8/release.toml", "third_party/rust/simdutf8/rustfmt.toml", "third_party/rust/simdutf8/src/basic.rs", "third_party/rust/simdutf8/src/compat.rs", "third_party/rust/simdutf8/src/implementation/aarch64/mod.rs", "third_party/rust/simdutf8/src/implementation/aarch64/neon.rs", "third_party/rust/simdutf8/src/implementation/algorithm.rs", "third_party/rust/simdutf8/src/implementation/helpers.rs", "third_party/rust/simdutf8/src/implementation/mod.rs", "third_party/rust/simdutf8/src/implementation/wasm32/mod.rs", "third_party/rust/simdutf8/src/implementation/wasm32/simd128.rs", "third_party/rust/simdutf8/src/implementation/x86/avx2.rs", "third_party/rust/simdutf8/src/implementation/x86/mod.rs", "third_party/rust/simdutf8/src/implementation/x86/sse42.rs", "third_party/rust/simdutf8/src/lib.rs", "third_party/rust/simdutf8/tests/tests.rs", "third_party/rust/simdutf8/wasm32-development.md", "third_party/rust/target-features/.cargo-checksum.json", "third_party/rust/target-features/.cargo_vcs_info.json", "third_party/rust/target-features/Cargo.lock", "third_party/rust/target-features/Cargo.toml", "third_party/rust/target-features/Cargo.toml.orig", "third_party/rust/target-features/LICENSE-APACHE", "third_party/rust/target-features/LICENSE-MIT", "third_party/rust/target-features/README.md", "third_party/rust/target-features/build.rs", "third_party/rust/target-features/examples/proof-token.rs", "third_party/rust/target-features/rustc-version.txt", "third_party/rust/target-features/src/lib.rs", "third_party/rust/target-features/src/simd.rs", "third_party/rust/target-features/target-cpus.txt", "third_party/rust/target-features/target-features.txt", "third_party/rust/target-features/tests/target.rs"], "git_node": "90ce18e6213517e4c8e932f8f34ff46f598f4182", "git_parents": ["be00d859faae3d05f100f32f94e2c87f8724770c"], "node": "84f572ba408950aff6691ce242fcd49b880132cc", "parents": ["d4d4ebf712513dca61109a1a051f89c4de12916d"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059442 - Add a mach bhr-timeseries command to run the roll-up locally r=dthayer\n\nbhr_timeseries.py (bug 2052962) is a library module: it exposes\nbuild_timeseries() but has no main(), no argparse, and no __main__ block,\nso nothing can actually invoke the roll-up. The daily TaskCluster job runs\nonly bhr_collection.aggregate(), so hangs_timeseries_\u003cthread\u003e.json is never\nproduced, and the dashboard reads that artifact for its Overview page,\nper-signature trend badges, and the 7/28/365-day affected-user windows.\n\nThis adds the entry point: a thin mach wrapper over build_timeseries(),\nmirroring bhr-aggregate. It shares the bhr-aggregate virtualenv, so no new\ndependency is pulled in.\n\nScheduling the roll-up on TaskCluster is the rest of this bug and comes\nseparately, because it needs a decision on state handling first. The\nroll-up keeps a state file across runs, keyed by full canonical signature\nstrings, which measures 244 MB after 30 days and extrapolates to roughly\n2.9 GB over a 365-day window (21.7 MB and ~265 MB respectively when\ngzipped). The published artifact is only 1.05 MB, so the state, not the\noutput, is what makes a daily task awkward.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315306\n", "files": ["python/mach/mach/command_util.py", "toolkit/components/backgroundhangmonitor/mach_commands.py"], "git_node": "067f14c0b2563ae7df930f05ff2de0253a644270", "git_parents": ["90ce18e6213517e4c8e932f8f34ff46f598f4182"], "node": "84d594cef7284bededa8e1894109601ec2b5ab4e", "parents": ["84f572ba408950aff6691ce242fcd49b880132cc"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059442 - Store the BHR timeseries state gzipped r=dthayer\n\nThe roll-up keeps a state file between runs so it only has to read each\ndaily artifact once. That state is far larger than what it publishes: a\n30-day window measures 244 MB against a 1.05 MB published artifact, and a\n365-day window extrapolates to roughly 2.9 GB. A daily TaskCluster task has\nto fetch the previous state and republish it, so the state, not the output,\nis what makes scheduling the roll-up awkward.\n\nAlmost none of that is data. Measured over 30 days: the map keys (each a\nfull canonical signature string) account for 106 MB, the per-entry `frames`\narray repeats the same stack for another 122 MB, and the ms/count that are\nactually wanted come to under 1 MB. Because the content is so repetitive it\ncompresses about 11x, taking the 30-day state to 22 MB and a full window to\nan estimated 265 MB.\n\nOnly the state file is compressed. The published artifact is fetched\ndirectly by the dashboard, so it stays plain JSON.\n\nThe HLL sketches this compresses are dense, not sparse. Sparse encoding was\ndropped in bug 2052962: serialize() emits the full 2**p register array\nbase64 encoded, because a mostly-zero register array is a long run of one\nbyte and gzips better than a map of scattered indices (0.61 MB dense against\n1.25 MB sparse over a 200-signature, 10-day state). This revision previously\nsat on a pre-drop base, so its diff did compress sparse state; rebased onto\nthe landed dense encoding it no longer does.\n\nAlso renames the leftover `sparse` locals and docstrings in bhr_timeseries\nand bhr_collection, which still described the sketches as sparse after the\nencoding changed and made this diff read as though it were compressing\nsparse maps.\n\nCompressing rather than restructuring is deliberate for now. Dropping the\nduplicated per-day `frames` (build_published only reads the first one per\nkey) would cut the state around 4x on its own and stack with this, but that\nis a format change and this is not; gzip is what unblocks scheduling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315323\n", "files": ["toolkit/components/backgroundhangmonitor/aggregation/bhr_collection.py", "toolkit/components/backgroundhangmonitor/aggregation/bhr_timeseries.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_bhr_timeseries.py"], "git_node": "036fef83fb1b5259b8d531f7454a78e2eafb7867", "git_parents": ["067f14c0b2563ae7df930f05ff2de0253a644270"], "node": "be4277a5e56d4e0fade607957f08eacdf5521192", "parents": ["84d594cef7284bededa8e1894109601ec2b5ab4e"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059442 - Run the timeseries roll-up in the daily TaskCluster job r=dthayer\n\nThe cron published hangs_main_\u003cdate\u003e.json but never the roll-up, so\nhangs_timeseries_\u003ctag\u003e.json did not exist. The dashboard fetches that\nartifact for its Overview page, per-signature trend badges, and the\n7/28/365-day affected-user windows, all of which had no data to read.\n\nThe roll-up now runs in the same task, straight after the aggregation.\nIt needs the previous run's state, which is fetched from the index route\nthis task already publishes to\n(gecko.v2.mozilla-central.latest.firefox.bhr-aggregate). Both the state and\nthe published timeseries land in the artifacts directory, so the next run\npicks the state up from today's index entry.\n\nA missing state is not an error. The first run has no predecessor, and\nbuild_timeseries refills any window date absent from state from that day's\nartifact, so a lost or corrupt state costs a slower run rather than a\nfailure. That is also why only the newly aggregated day has to be present\non disk: every earlier day in the window is already summarized in state.\n\nVerified by simulating three consecutive runs, each with a fresh directory\nholding one new daily artifact plus the prior run's state. Each filled only\nits own day and the window accumulated correctly.\n\nTwo scaling limits worth recording, neither of which bites at launch\nbecause the window grows a day at a time:\n\n- State is roughly 0.7 MB gzipped per day, so a full 365-day window lands\n  near 256 MB fetched and republished per run.\n- Loading it costs about 36 MB of RSS per day, extrapolating to ~12.7 GB at\n  a full window.\n\nBoth are consequences of state storing each stack twice, once as the map\nkey and again as a per-day frames array, while ms and count come to under\n1 MB. Dropping the duplicate frames would cut it about 4x and should land\nbefore the window fills.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315330\n", "files": ["taskcluster/scripts/bhr-aggregate.py"], "git_node": "14294c592b1e1e54657f33e7e1ae657cca487a70", "git_parents": ["036fef83fb1b5259b8d531f7454a78e2eafb7867"], "node": "822a25d41606b969da2c3240abab7028970381fe", "parents": ["be4277a5e56d4e0fade607957f08eacdf5521192"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2063809 - Skip Vulkan H.264 on FFmpeg \u003c n7.1 for COINCIDE without SEPARATE_REFERENCE_IMAGES. r=stransky\n\nOld FFmpeg crashes in ff_vk_exec_add_dep_frame on GPUs that report\nCOINCIDE without SEPARATE_REFERENCE_IMAGES. After the Vulkan device is\ncreated, query those caps and fall back to VA-API if that combo is set.\n\nH.264 and libavcodec \u003c 61.19.100 only. Caps are cached per SPS profile\n(layout, chroma, depth). High 10 / 4:2:2 map to Vulkan HIGH so the query\ndoes not fail open. A failed query leaves Vulkan enabled.\n\nAdded HEVC / AV1 / VP9 Ensure arms are unused. They share the same design\nso a possible future codec gate can query that slot instead of adding a\nsecond table. Those codecs are not skipped here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318905\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.h"], "git_node": "dbab9f62b6490f9ad1eb3a0d1e4efee4896e6fce", "git_parents": ["14294c592b1e1e54657f33e7e1ae657cca487a70"], "node": "d106f6534f6038399cb635fd28ff0a4eeeeae506", "parents": ["822a25d41606b969da2c3240abab7028970381fe"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056370 - Group near-duplicate hang signatures in the aggregation job r=dthayer\n\nMany signatures are the same underlying hang, differing only in noise: which\nsystem call, allocator path, or JS trampoline happened to be sampled, or how\ndeep the nested event loop was. Because a signature is the whole stack, every\nsuch variation becomes its own row, so the true size of a hang is split across\nnear-identical entries and the list reads as noise.\n\nThis adds a server-side grouping pass. Following the hang-triage heuristics,\nthe frame that identifies a hang is not the raw leaf, which is usually a lock,\na sleep, an allocation, or an event-loop wait, but the first frame naming\nactual Firefox work. So each stack is normalized down to its meaningful frames\nand bucketed by the leaf of that: walking from the raw leaf downward we skip\nexternal system and third-party libraries, synchronization and allocation\nprimitives, and SpiderMonkey/XPConnect trampolines. Each bucket's common trunk\nand first branching point give the group its name, and every group carries its\nmembers' canonical keys and first-unique frames, so the frontend collapses\nnear-duplicates without fuzzy matching of its own. Only multi-member groups are\nemitted; a signature with no near-duplicate stands for itself.\n\nNormalization only chooses how signatures are bucketed and named. A member key\nremains the canonical key of the signature's full trimmed stack, byte-for-byte\nidentical to what the frontend and the timeseries roll-up compute, so all three\nsides join without any shared hashing and signature identity is unchanged.\nThat key derivation and the stack reconstruction it needs now live in\nstack_keys.py, shared with the timeseries job instead of duplicated per job.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315107\n", "files": ["toolkit/components/backgroundhangmonitor/aggregation/bhr_collection.py", "toolkit/components/backgroundhangmonitor/aggregation/bhr_timeseries.py", "toolkit/components/backgroundhangmonitor/aggregation/leaf_grouping.py", "toolkit/components/backgroundhangmonitor/aggregation/stack_keys.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/python.toml", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_bhr_collection.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_leaf_grouping.py"], "git_node": "bce42dadfa36eef38c8a55fee8f97f0298066d4b", "git_parents": ["dbab9f62b6490f9ad1eb3a0d1e4efee4896e6fce"], "node": "3f2b876585478257637d21e742ba392a8c35d83e", "parents": ["d106f6534f6038399cb635fd28ff0a4eeeeae506"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059444 - Identify leafGroups members by funcTable index r=dthayer\n\nEach group member carried its canonical signature key and its variant key as\nfull strings, spelling out funcName and libName for every frame in the stack.\nMeasured on a 2026-04-01 profile that made leafGroups 38.40 MB of a 41.68 MB\nartifact, roughly 90%, against 3.28 MB for the profile itself.\n\nThe columnar profile already interns every one of those strings in\nstringArray, so the group block was denormalizing back out what the rest of\nthe artifact deduplicates. A member is now identified by frameKeys, its stack\nas funcTable indices leaf-\u003eroot, and the variant by a group-local ordinal\nrather than the meaningful stack's key.\n\nSame profile: leafGroups drops to 4.19 MB, 9.2x smaller, with the grouping\nitself unchanged at 1592 groups over 8614 members.\n\nSignature identity is untouched. The frontend resolves frameKeys against the\nsame funcTable and recomputes the canonical key with the function it already\nuses for its own samples, so the two sides still agree byte-for-byte and the\njoin needs no shared hashing. The end-to-end test now asserts that round trip\nrather than the emitted value, since the round trip is what the dashboard\nactually depends on.\n\nThis matters because the dashboard is a static site that fetches the artifact\nover HTTP on page load.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315395\n", "files": ["toolkit/components/backgroundhangmonitor/aggregation/leaf_grouping.py", "toolkit/components/backgroundhangmonitor/aggregation/stack_keys.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_leaf_grouping.py"], "git_node": "6aa837c3a118d3df4966fbc40dfdd26917aaaad9", "git_parents": ["bce42dadfa36eef38c8a55fee8f97f0298066d4b"], "node": "6300451df76b75d8f9546f676a1c714a0e5b4ef0", "parents": ["3f2b876585478257637d21e742ba392a8c35d83e"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059443 - Record inline depth per stack node in the BHR artifact r=dthayer\n\nBug 2052961 reconstructs inlined frames, then splices the chain flat into\nthe stack. Once spliced an inlined frame is indistinguishable from a real\ncaller, so the frontend can neither fold inline frames back into their\nenclosing function nor say anything about them. parse_inlines already knows\neach frame's nest level and was throwing it away.\n\nThe depth now rides from symbolicate_stacks, through the heuristics, to the\nprofile, and lands as two columns parallel to stackTable:\n\n- inlineDepth: the frame's position in its inlined chain, 0 for a real\n  frame and 1+ for each inlined callee.\n- inlineRatio: the share of hang count at that node where the frame was\n  inlined, rounded to 2dp.\n\nBoth are per stack node rather than per function, because a node is\n(func, lib, prefix): the same function can be inlined into one caller and\nnot another, and only the node distinguishes those.\n\nThe two differ because signatures merge across builds. A build that inlined\na call and one that did not produce the same reconstructed stack, which is\nexactly bug 2052961's dedup property, so a node can be inlined only some of\nthe time. Depth is therefore max-merged and the ratio carries the split.\nDepth is deliberately NOT part of the grouping key: putting it there would\nstop those builds merging and undo 2052961.\n\nRounding the ratio is not cosmetic. Measured on a real 2026-04-01 artifact,\nunrounded floats cost +48% raw and +87% gzipped, because values like\n0.3333333333333333 defeat compression; at 2dp the same field is +3.0%\ngzipped.\n\nSize, measured by adding the columns to a real inline artifact\n(5.39 MB, 171026 stack nodes) and re-serializing:\n\n  raw JSON  5.39 MB -\u003e 5.90 MB   +9.5%\n  gzipped   1.21 MB -\u003e 1.21 MB   +0.3%\n\nPer funcTable instead of per stack node would be +1.7% raw, but it cannot\nexpress \"inlined here, not there\", which is the distinction the field\nexists to record.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315444\n", "files": ["toolkit/components/backgroundhangmonitor/aggregation/bhr_collection.py", "toolkit/components/backgroundhangmonitor/aggregation/heuristics.py", "toolkit/components/backgroundhangmonitor/aggregation/profile_processor.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_bhr_collection.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_bhr_timeseries.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_heuristics.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_leaf_grouping.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_profile_processor.py"], "git_node": "882b0252cfd09d7636ac8388ce241130ca7332cd", "git_parents": ["6aa837c3a118d3df4966fbc40dfdd26917aaaad9"], "node": "6caa5dfda373906cf387cd3a3cbb8c8a0a3348e8", "parents": ["6300451df76b75d8f9546f676a1c714a0e5b4ef0"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062960 - Part 1: Drop two stale ML perftests, fix perftest metadata r=perftest-reviewers,mozperftest-reviewers,taskgraph-reviewers,ai-platform-reviewers,kshampur,nordzilla,ahal\n\nspeecht5 and summarizer exercise no shipping configuration. Also clean up\nafter a failed engine init, fix the suggest-inference memory unit, and\ndrop multi_perf's generated declarations, which match no subtest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318506\n", "files": ["python/mozperftest/perfdocs/config.yml", "taskcluster/gecko_taskgraph/transforms/test/linux_perf_platform_restrictions.py", "taskcluster/kinds/fetch/onnxruntime-web-fetch.yml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx.yml", "taskcluster/kinds/perftest/windows11-24h2-ref.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "testing/perfdocs/generated/mozperftest.md", "toolkit/components/ml/docs/perf.md", "toolkit/components/ml/tests/browser/browser_ml_engine_multi_perf.js", "toolkit/components/ml/tests/browser/browser_ml_speecht5_tts.js", "toolkit/components/ml/tests/browser/browser_ml_suggest_inference.js", "toolkit/components/ml/tests/browser/browser_ml_summarizer_perf.js", "toolkit/components/ml/tests/browser/head.js", "toolkit/components/ml/tests/browser/perftest.toml"], "git_node": "64b7b1e9a97eb1c1b21b97f26450b9e8f776235b", "git_parents": ["882b0252cfd09d7636ac8388ce241130ca7332cd"], "node": "1c324f8f3b5173813fc9b98cdf65986f31a7b311", "parents": ["6caa5dfda373906cf387cd3a3cbb8c8a0a3348e8"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062960 - Part 2: Run the ONNX perftests on both the native and wasm backends r=perftest-reviewers,mozperftest-reviewers,ai-platform-reviewers,nordzilla,kshampur\n\nEach ONNX-related perf task becomes a -native and a -wasm job\npinned via MOZ_ML_BACKENDS; a backend that cannot run fails its job.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318508\n", "files": ["taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx.yml", "taskcluster/kinds/perftest/windows11-24h2-ref.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "testing/perfdocs/generated/mozperftest.md", "toolkit/components/ml/docs/perf.md", "toolkit/components/ml/tests/browser/browser_ml_autofill_perf.js", "toolkit/components/ml/tests/browser/browser_ml_engine_multi_perf.js", "toolkit/components/ml/tests/browser/browser_ml_engine_perf.js", "toolkit/components/ml/tests/browser/browser_ml_llama_summarizer_perf.js", "toolkit/components/ml/tests/browser/browser_ml_semantic_history_search_perf.js", "toolkit/components/ml/tests/browser/browser_ml_smart_tab_clustering_perf.js", "toolkit/components/ml/tests/browser/browser_ml_smart_tab_perf.js", "toolkit/components/ml/tests/browser/browser_ml_suggest_feature_perf.js", "toolkit/components/ml/tests/browser/browser_ml_suggest_inference.js", "toolkit/components/ml/tests/browser/head.js", "tools/tryselect/try_presets.yml"], "git_node": "5cfc8d25081992e0800431c55a9cf6a83dc8cd28", "git_parents": ["64b7b1e9a97eb1c1b21b97f26450b9e8f776235b"], "node": "8adebfffecd919152773a134df524629debc10fa", "parents": ["1c324f8f3b5173813fc9b98cdf65986f31a7b311"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062960 - Part 3: Move the ML perftests to Ubuntu 24.04 r=kshampur,ai-platform-reviewers,nordzilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318509\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/linux_perf_platform_restrictions.py"], "git_node": "5921a7bf57443e2580c2ade7a2fb741ef70209cf", "git_parents": ["5cfc8d25081992e0800431c55a9cf6a83dc8cd28"], "node": "147fb7b91713174acd58ed8da1a0fd15c61c4210", "parents": ["8adebfffecd919152773a134df524629debc10fa"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064108 - Do not run ML perftests that do not alert on push to autoland r=kshampur,mozperftest-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319158\n", "files": ["taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx.yml", "taskcluster/kinds/perftest/windows11-24h2-ref.yml", "taskcluster/kinds/perftest/windows11-24h2.yml"], "git_node": "2870ed0d1bde56718ba48ce3268397a4f8819dc0", "git_parents": ["5921a7bf57443e2580c2ade7a2fb741ef70209cf"], "node": "dbcf4b3790732419439585b50315d4943043d21b", "parents": ["147fb7b91713174acd58ed8da1a0fd15c61c4210"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064679 - Loosen assertions in ml_smart_tab_clustering_perf.js r=vazish,nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319762\n", "files": ["toolkit/components/ml/tests/browser/browser_ml_smart_tab_clustering_perf.js"], "git_node": "67d7488384180c0a505254c02c433faf831126cb", "git_parents": ["2870ed0d1bde56718ba48ce3268397a4f8819dc0"], "node": "e9372d6111703516378680cd66dd66d5b12b2b7b", "parents": ["dbcf4b3790732419439585b50315d4943043d21b"], "tags": []}], "date": 1787199301, "git_changesets": ["860e0b76a2a3861497a1194c4d093051151027c1", "f1d6bc5cad07dc2ba350c1822c36a34f322afc84", "3ffc2ab968d7c1445cf76c71551625f04d4dda08", "2f4fb7b4372ac9644938a8830afe20d57562395d", "ec7aa3fd1d9fba45fe075608875e331b904b7476", "ffbb412877b5de90d756eb9774139bb2a01b9baa", "7874e705a6163aeec0d406f924014b5845dde8ae", "cb7f9b6d22e11c071a93d4b7a124d02d507a5af4", "d18274f658327f3da148d7f26072ab1b17227678", "9ba51020e2b8e5a72c9307ca4f648e576cdcf6ce", "3c7bbc55b4ed26c3d0450109baa5256907239c28", "13a59d190ac02d29529bf3d6bb0abb03c6ce6a2f", "7bfc01b46c33a5350ff617963ca37693126d5de8", "6f635a25d2011968c2164bcbd934dc9f2f27b5ef", "20dc96318eda00123273b3ea8a7fabbf86edbd1d", "0fe339e28ee586a4af06fa5c6ac61b903b854c3e", "1f9c42dc444caf31aa51a302324c1af2a41be8aa", "9aad320c034c6820a4a7fcfd6ab847ad2a560674", "d28ab16f34f7bd6b9ae7127f319275c65d256fa2", "5ddd23b1cfdacedd2eae4d2bdd6a8237e42cd8fe", "9ce133953d96a7f8ca6771b2f71054f58f1c2d4e", "1de568bc406747e906d1bff366b351dc0bdb4029", "d09e182fab97ba801e58d0d23b5deab8736419f5", "43636ce29933729e1d2ecdfa8848d2fcff4a3575", "19651dae6e968c0307c1bdc9864d5b603137bbdb", "e2ac6802e44eb56758a1afa5a15d277d95556669", "f66ab2d39e45aa8c457610ac541b77a17e0bfcbe", "f25366d9ce072d23a6499af5bb1cf2be42c029f1", "c172339cb062bbdacfcf7bc6063185458d189117", "fb2edfd6d387de7eb8bfa1d111d845adef662ddb", "8d62da6a1699a987c2a103c7f6b3330319f1f10d", "ba7a3b062aec09639f5e6823e15fb82b5f899f90", "f25a00169ccae0efd108b1a84375482adc62481f", "ac2ded31d05407b1a527ba882e4f0ae87afc21a5", "db95f34392f68cf05d71053854eb21bc21918b32", "c78da196e516597bcdc546e0e3338e8b5688984a", "266d5819777e8d604848fa61c84c8147d852d71b", "bbb3133f422869b52a9f06232b669490e140b6cf", "ebe1ad9344b19d1a306cef6cda40bba7cce6f561", "7752e222b67506c57d50132ef9b6470ec285a92b", "56a0df9cc6fc1e052b0cec1f409fa314ae8dafdd", "300c371b029b0c67283ad42b32bf26d7e07e6833", "4db7f49e8c32b97dd9b2cb920bccbdbcdf805df8", "fe82d06ec430b2050724744ec4694d8165bedb4d", "e4eb59824172cf66d906e7a8fabf0ea0f03909fe", "02d70b5ac7cdaa8b7e45a4e36538a81b8cf9fb94", "c256f393763794684b6b92a0563d9b037569597c", "61e34f1e5af3e06c5569ba27f3f02f32c8a6ad53", "cb0a5ff77b7b075623fd9a980028687c0dcec34c", "4e097829297ab431dad58dc2435e4ad5fb93a856", "035207508158e740641f89eb1247566cedc1cb1e", "14d104ab834f30c57fde8d905cec1a8e3ef7a97d", "b4209c503f37af8a951767ee7a979889ebbf5f07", "629f848e6f1f9f9676a3a940cb22b9a342cb34b5", "10c67792b86484b601301d8b24c7a6a34d49a85a", "b5c6357dc90d8469ecd94e788aac34f3b468c585", "0856a27e204712f29368d9d3ab30af46a1beffdb", "ffc5f075fe471e8b88b1f3a936d255a5b9ec1dba", "402e7c158bd62624672b607a8fd9f95e44ade7d0", "190161f9abcf6670cd4851ad609bea11a0ee0307", "07174ef66d5604603f43c142a33e310cfaec1f08", "869d83d9f862c98acdd68b0b2e197f92138b60fd", "5faae4ff36e5157838f67b1d202019e294e816ba", "e7e0d330b8db58075ec8439e5873256d46667385", "be00d859faae3d05f100f32f94e2c87f8724770c", "90ce18e6213517e4c8e932f8f34ff46f598f4182", "067f14c0b2563ae7df930f05ff2de0253a644270", "036fef83fb1b5259b8d531f7454a78e2eafb7867", "14294c592b1e1e54657f33e7e1ae657cca487a70", "dbab9f62b6490f9ad1eb3a0d1e4efee4896e6fce", "bce42dadfa36eef38c8a55fee8f97f0298066d4b", "6aa837c3a118d3df4966fbc40dfdd26917aaaad9", "882b0252cfd09d7636ac8388ce241130ca7332cd", "64b7b1e9a97eb1c1b21b97f26450b9e8f776235b", "5cfc8d25081992e0800431c55a9cf6a83dc8cd28", "5921a7bf57443e2580c2ade7a2fb741ef70209cf", "2870ed0d1bde56718ba48ce3268397a4f8819dc0", "67d7488384180c0a505254c02c433faf831126cb"], "user": "nfay@mozilla.com"}, "45131": {"changesets": [{"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055613 - Prepare telemetry/addons tests for legacy environment addons removal r=chutten,robwu\n\nRemoves activeAddons/theme/GMPlugins test coverage from TelemetryEnvironment and\nAddonManager tests, ahead of removing the environment addons properties as part\nof the child revision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317632\n", "files": ["toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js", "toolkit/mozapps/extensions/test/xpcshell/test_EnvironmentAddonBuilder_telemetry.js", "toolkit/mozapps/extensions/test/xpcshell/test_amo_stats_telemetry.js"], "git_node": "a449dabf881cabf50f4fcd6f369b85de830a6398", "git_parents": ["67d7488384180c0a505254c02c433faf831126cb"], "node": "4b5e5685c540a51ddcc95e47d2b89845e2fc587d", "parents": ["e9372d6111703516378680cd66dd66d5b12b2b7b"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055613 - Remove activeAddons/theme/activeGMPlugins from the legacy Telemetry environment r=chutten,robwu\n\nRemoves environment.addons along with cleaning up about:telemetry and EnvironmentAddonBuilder from\nlogic that was mainly needed due to the legacy telemetry environment.\n\nAlso updates the docs and and decrements the arewegleanyet Legacy/Glean counters.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317633\n", "files": ["mobile/android/app/geckoview-prefs.js", "toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/docs/data/main-ping.md", "toolkit/components/telemetry/tests/marionette/tests/client/test_subsession_management.py", "toolkit/components/telemetry/tests/unit/test_PingAPI.js", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js", "toolkit/content/aboutTelemetry.js", "toolkit/mozapps/extensions/AddonManager.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/test_EnvironmentAddonBuilder_telemetry.js", "toolkit/mozapps/extensions/test/xpcshell/test_addons_glean_ping.js", "toolkit/mozapps/extensions/test/xpcshell/test_shutdown_early.js", "toolkit/mozapps/extensions/test/xpcshell/test_types.js", "toolkit/mozapps/extensions/test/xpcshell/xpcshell.toml"], "git_node": "0681535597e70869dae0146f57f1ed9938d8027e", "git_parents": ["a449dabf881cabf50f4fcd6f369b85de830a6398"], "node": "df6099ef84341fcf2c50b1856cd1e2afc91c1816", "parents": ["4b5e5685c540a51ddcc95e47d2b89845e2fc587d"], "tags": []}, {"author": "Sarah Chung \u003csachung@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052973 - add propTypes to screen renderer components r=mimi,omc-reviewers,yazan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313596\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/docs/feature-callout.md", "browser/components/asrouter/docs/spotlight.md", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/unit/content-src/components/MultiStageAWProton.test.jsx", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json", "toolkit/components/messaging-system/schemas/index.md"], "git_node": "b3ec05da6ac35adeb3f3709583bfa3d681732df8", "git_parents": ["0681535597e70869dae0146f57f1ed9938d8027e"], "node": "1a7c49b80c017d799ddb67e6e8170acb30ca550f", "parents": ["df6099ef84341fcf2c50b1856cd1e2afc91c1816"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055613 - Remove activeAddons/theme/activeGMPlugins from the legacy Telemetry environment r=chutten,robwu\" for causing xpcshell failures on test_exposure.\n\nThis reverts commit 0681535597e70869dae0146f57f1ed9938d8027e.\n\nRevert \"Bug 2055613 - Prepare telemetry/addons tests for legacy environment addons removal r=chutten,robwu\"\n\nThis reverts commit a449dabf881cabf50f4fcd6f369b85de830a6398.\n", "files": ["mobile/android/app/geckoview-prefs.js", "toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/docs/data/main-ping.md", "toolkit/components/telemetry/tests/marionette/tests/client/test_subsession_management.py", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs", "toolkit/components/telemetry/tests/unit/test_PingAPI.js", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js", "toolkit/content/aboutTelemetry.js", "toolkit/mozapps/extensions/AddonManager.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/test_EnvironmentAddonBuilder_telemetry.js", "toolkit/mozapps/extensions/test/xpcshell/test_addons_glean_ping.js", "toolkit/mozapps/extensions/test/xpcshell/test_amo_stats_telemetry.js", "toolkit/mozapps/extensions/test/xpcshell/test_shutdown_early.js", "toolkit/mozapps/extensions/test/xpcshell/test_types.js", "toolkit/mozapps/extensions/test/xpcshell/xpcshell.toml"], "git_node": "4b843058d565bf729ec9bf3a3803945e3c113831", "git_parents": ["b3ec05da6ac35adeb3f3709583bfa3d681732df8"], "node": "47f67f50e8f13941ea321551d351754415055888", "parents": ["1a7c49b80c017d799ddb67e6e8170acb30ca550f"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\" for causing browser_styleeditor_pretty.js failures.\n\nThis reverts commit be00d859faae3d05f100f32f94e2c87f8724770c.\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-be/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-be/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-cak/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gl/strings.xml", "mobile/android/fenix/app/src/main/res/values-gn/strings.xml", "mobile/android/fenix/app/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-iw/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nb-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-uk/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml"], "git_node": "c83a0f2a5385df816b193d29acd52087a1919e4d", "git_parents": ["4b843058d565bf729ec9bf3a3803945e3c113831"], "node": "4d7dac333c91cfed4667c5ede5b7992607fee601", "parents": ["47f67f50e8f13941ea321551d351754415055888"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2061040 - Create SQLite Base Class and new DB setup for AITab - r=omarg\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318207\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/modules/AITabConstants.sys.mjs", "browser/components/aiwindow/ui/modules/AITabMigrations.sys.mjs", "browser/components/aiwindow/ui/modules/AITabSql.sys.mjs", "browser/components/aiwindow/ui/modules/AITabStore.sys.mjs", "browser/components/aiwindow/ui/modules/SQLiteStoreBase.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/xpcshell/test_AITabStore.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml"], "git_node": "d9febaaa4c5f0c4890585fddaf09fec3e7f934ab", "git_parents": ["c83a0f2a5385df816b193d29acd52087a1919e4d"], "node": "d74da6e6eb053c0c9bacfb7ec926a3fa86ef8235", "parents": ["4d7dac333c91cfed4667c5ede5b7992607fee601"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063437 - Part 1: Measure the cold seek arm on Firefox only. r=perftest-reviewers,aglavic\n\nThis test is being extended to other browsers so that seek latency becomes\ncomparable across them.\n\nThe cold arm cannot come along, because it depends on Firefox internals: it needs\nthe decoder to be released as soon as playback pauses, and only Gecko can be asked\nto do that. On any other browser the arm would report an unforced decoder state\nunder a name that implies a forced one, and that number would be read directly\nagainst the Firefox one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318778\n", "files": ["testing/perfdocs/generated/raptor.md", "testing/raptor/browsertime/media_seek.js", "testing/raptor/raptor/perfdocs/config.yml"], "git_node": "3ab6e1c8fce20e0a39fe455e7c55fce4657e8340", "git_parents": ["d9febaaa4c5f0c4890585fddaf09fec3e7f934ab"], "node": "369e9d62126f9d8a9c1becbbf66757dd0a701fb6", "parents": ["d74da6e6eb053c0c9bacfb7ec926a3fa86ef8235"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063437 - Part 2: Run the media-seek test on Chrome. r=perftest-reviewers,aglavic\n\nThe suite is portable already: the clip is an embedded, muted Blob and the test\nscript drives the browser through WebDriver alone, so Chrome needs the app added\nand nothing else. The periodic perf cron picks the task up without any scheduling\nchange, which is why the new arm is kept off the per-push path and at the lower\ntier while its noise level is still unknown.\n\nChrome starts on macOS and Linux, the platform set the other cross-browser media\ntests already use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318779\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "30d5766cb08a0b273828fc5eabebc099e9425bf1", "git_parents": ["3ab6e1c8fce20e0a39fe455e7c55fce4657e8340"], "node": "e051378c5e291392cacbc68b2f04ffa9cb4e39fc", "parents": ["369e9d62126f9d8a9c1becbbf66757dd0a701fb6"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058696 - Add mail button for linux r=niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319225\n", "files": ["browser/components/sharing/SharePageAction.sys.mjs", "browser/components/sharing/SharingUtils.sys.mjs", "browser/components/sharing/tests/browser/browser.toml", "browser/components/sharing/tests/browser/browser_testSharePanelMail.js"], "git_node": "1fcb78a15d35848644a6097670b703f197c6dcfb", "git_parents": ["30d5766cb08a0b273828fc5eabebc099e9425bf1"], "node": "760b9ca44eb9db26381136fd794a78028ff54f3b", "parents": ["e051378c5e291392cacbc68b2f04ffa9cb4e39fc"], "tags": []}, {"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060047. r=gfx-reviewers,lsalzman,ErichDonGubler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319639\n", "files": ["gfx/ipc/CanvasManagerParent.cpp"], "git_node": "24f381f39a4250d0b852514638d717b031c01c2f", "git_parents": ["1fcb78a15d35848644a6097670b703f197c6dcfb"], "node": "e2403addf9435fb1650adcff130f92df0bf952a0", "parents": ["760b9ca44eb9db26381136fd794a78028ff54f3b"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063127 - Increase the opacity of the URL secondary color text paint style. r=emilio,layout-reviewers\n\nThe Nova Components Figma uses `--text-color-deemphasized, rgba(24, 14, 48, 0.70)`\nfor the secondary text in the urlbar input [1]. The opacity is 0.7 in all\nthemes [2].\n\n[1] https://www.figma.com/design/PqfaOcMGbX5liEXTTUzeYX/Nova-Components--Experimental-?node-id=13812-47163&m=dev\n[2] https://www.figma.com/design/Co6vXnF5SiQMcJ7UoJvZX6/Nova-Styles--Experimental-?node-id=0-1&p=f&view=variables&var-id=3-123&var-set-id=2-5&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319654\n", "files": ["layout/generic/nsTextPaintStyle.cpp"], "git_node": "10b419cc6afb86e93ef1e205c273e4dcae0e9453", "git_parents": ["24f381f39a4250d0b852514638d717b031c01c2f"], "node": "67d01c8e37e4129d0f184682ed52287048617cf7", "parents": ["e2403addf9435fb1650adcff130f92df0bf952a0"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2063483 - Pt 1 - Remove the write-only LinearGradient::edge_aa_mask r=gfx-reviewers,nical\n\nThe field was set on the interned value and then dropped: LinearGradientKey::new\ncopies eight of the nine fields and never that one, and nothing read it. Not a\nlost mask either - both call sites pass EdgeMask::all(), which is what\nPrimKeyCommonData::transformed_aa_edges already carries, so it was redundant\nrather than broken. A linear gradient that wants a narrowed mask can compute it\nand put it in the key's common data.\n\nLinearGradient is never itself hashed or compared - it goes straight into\nLinearGradientKey::new - so dropping the field cannot change interning. The u8\nwas sitting in padding, so the struct is still 72 bytes and the size\nexpectations are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318634\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/interned_prims.rs"], "git_node": "471920554c76ad4c3bbe8896765172cab6db12ce", "git_parents": ["10b419cc6afb86e93ef1e205c273e4dcae0e9453"], "node": "f5358f0a1223a68cf64137f0dde992d4088f17fb", "parents": ["67d01c8e37e4129d0f184682ed52287048617cf7"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2063483 - Pt 2 - Move the gradient prim builders into webrender_api r=gfx-reviewers,nical\n\ncreate_linear_gradient_prim, create_radial_gradient_prim and\ncreate_conic_gradient_prim were methods on SceneBuilder that never touched self:\npure functions of item data plus simplify_repeated_primitive and\ncompute_stretch_ratio, both of which already live in\nwebrender_api::prim_geometry. They move there verbatim, next to the gradient\nhelpers that are already there.\n\nThese have two quirks worth not rediscovering by accident, and both are now\ncommented where they live:\n\n- the simplify_repeated_primitive call discards its rect mutation and keeps only\n  the tile_spacing one, and\n- stretch_ratio resolves against the incoming prim rect rather than the\n  simplified one.\n\nThe conic builder took its stops as an ItemRange and converted them inside,\nwhile the other two took Vec\u003cGradientStopKey\u003e; all three take the vector now, so\nthe two call sites that fed the conic one go through read_gradient_stops like\neverything else.\n\nNo behaviour change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318635\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/prim_geometry.rs"], "git_node": "bc138ad7018d5a1cb6a0e6d0de023d8252ec3841", "git_parents": ["471920554c76ad4c3bbe8896765172cab6db12ce"], "node": "bf218d0d42bc5de10c44c21354857439cb79a6cd", "parents": ["f5358f0a1223a68cf64137f0dde992d4088f17fb"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2063483 - Pt 3 - Hand gradient stops to push_* instead of the display list r=gfx-reviewers,nical\n\ncreate_gradient normalized the stops and then pushed them into the item stream\nitself, leaving push_gradient to record an item that referred back to them. That\nis why gradients \"must be pushed in the order they're created\" - and, since a\nSetGradientStops overwrites the previous one, why they really had to be created\nand pushed strictly one at a time, a sharper constraint than the note admitted.\n\nThe stops describe the gradient, so they now travel with it: create_* returns\nthem alongside the gradient and the matching push_* takes them, the way\npush_text already takes its glyphs. That deletes the ordering hazard rather than\nrestating it.\n\npush_border takes them too, for a NinePatchBorderSource gradient; the plain and\nimage border paths pass an empty slice, which push_stops ignores exactly as it\ndid when nothing called it for them.\n\nNo wire change: push_stops now runs inside push_* rather than in the create_*\nimmediately preceding it, which is the same point in the stream.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318636\n", "files": ["gfx/webrender_bindings/src/bindings.rs", "gfx/wr/examples/basic.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs", "gfx/wr/wrench/src/yaml_helper.rs"], "git_node": "c6c52d7a1d32618862e63c2642b39cfb7a9a0b6a", "git_parents": ["bc138ad7018d5a1cb6a0e6d0de023d8252ec3841"], "node": "ce245ccd55deb4d91a5c71dc187628bb94621f96", "parents": ["bf218d0d42bc5de10c44c21354857439cb79a6cd"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2063483 - Pt 4 - Resolve a stacking context's raster space in the display list builder r=gfx-reviewers,nical\n\nTwo stacks walked the same item stream and had to agree: the display list\nbuilder recorded the raster space its caller requested, and the scene builder\nresolved that against the enclosing contexts a second time.\n\nResolve once, on the builder, and record the resolved value in the item.\npush_stacking_context keeps the stack the resolution needs, and the scene\nbuilder now pushes what the item tells it rather than recomputing it. Its stack\nstays, because add_text still needs the innermost value, but it no longer\ncarries a copy of the rule.\n\nGecko is unaffected: it passes what it wants and the builder resolves before\nrecording. The nested extra-stacking-context case is unchanged, since resolving\nan already resolved space against itself is idempotent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318637\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs"], "git_node": "70a1f42b63e22231283c7c0bc187361d3021aa1d", "git_parents": ["c6c52d7a1d32618862e63c2642b39cfb7a9a0b6a"], "node": "f68963a1fdee1bd0af15f1590bf68f8b9ab90b8c", "parents": ["ce245ccd55deb4d91a5c71dc187628bb94621f96"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2063483 - Pt 5 - Retain wrench's display list builders and font caches across yaml files r=gfx-reviewers,nical\n\nWrench rebuilt per yaml file what Gecko retains per pipeline: a fresh\nDisplayListBuilder for every display list, and font templates and instances\nowned by the YamlFrameReader and deleted in its deinit.\n\nBoth now live on Wrench for the life of the process, which is what Gecko does.\nA builder is meant to be reused across builds, and an identical font is meant to\nkeep its instance key across paints; rebuilding either per file means the\nretained-builder path is never the one under test.\n\nNo reftest isolation is lost: the scene builder's interners already live on a\nsingle Document for the process, so state was shared across reftests regardless.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318638\n", "files": ["gfx/wr/wrench/src/wrench.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs"], "git_node": "04f8e4c41e46f7691f0a6684e95ba7fbc305a267", "git_parents": ["70a1f42b63e22231283c7c0bc187361d3021aa1d"], "node": "a0f9cea41b97a5b318f52b1719b1872b0f8b7327", "parents": ["f68963a1fdee1bd0af15f1590bf68f8b9ab90b8c"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060047. r=gfx-reviewers,lsalzman,ErichDonGubler\" for causing assertion failure @ CanvasManagerParent.cpp\n\nThis reverts commit 24f381f39a4250d0b852514638d717b031c01c2f.\n", "files": ["gfx/ipc/CanvasManagerParent.cpp"], "git_node": "2499d1c872b53bb40165b84a0c1d497909b171eb", "git_parents": ["04f8e4c41e46f7691f0a6684e95ba7fbc305a267"], "node": "0204d510d2aa05c8df5831c098f915ffbca6d36b", "parents": ["a0f9cea41b97a5b318f52b1719b1872b0f8b7327"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061040 - Create SQLite Base Class and new DB setup for AITab - r=omarg\" for failures on browser_all_files_referenced.\n\nThis reverts commit d9febaaa4c5f0c4890585fddaf09fec3e7f934ab.\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/modules/AITabConstants.sys.mjs", "browser/components/aiwindow/ui/modules/AITabMigrations.sys.mjs", "browser/components/aiwindow/ui/modules/AITabSql.sys.mjs", "browser/components/aiwindow/ui/modules/AITabStore.sys.mjs", "browser/components/aiwindow/ui/modules/SQLiteStoreBase.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/xpcshell/test_AITabStore.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml"], "git_node": "3a5b0440bf2f21089a48d1e91f7abb543e42f6ee", "git_parents": ["2499d1c872b53bb40165b84a0c1d497909b171eb"], "node": "ea66f6e73235358ceb14da21bf71518682239e6b", "parents": ["0204d510d2aa05c8df5831c098f915ffbca6d36b"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064582 - update rsdparsa_capi to use webrtc-sdp 0.3.14;r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319910\n", "files": ["dom/media/webrtc/sdp/rsdparsa_capi/Cargo.toml"], "git_node": "69be58c81129528954f93da816468b9ae15e3ea4", "git_parents": ["3a5b0440bf2f21089a48d1e91f7abb543e42f6ee"], "node": "22d4189e669ded32061969ae4c5964bbae17850d", "parents": ["ea66f6e73235358ceb14da21bf71518682239e6b"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064582 - vendor webrtc-sdp 0.3.14;r=mjf,supply-chain-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319911\n", "files": ["Cargo.lock", "supply-chain/audits.toml", "third_party/rust/webrtc-sdp/.cargo-checksum.json", "third_party/rust/webrtc-sdp/.cargo_vcs_info.json", "third_party/rust/webrtc-sdp/.circleci/config.yml", "third_party/rust/webrtc-sdp/CHANGELOG.md", "third_party/rust/webrtc-sdp/Cargo.lock", "third_party/rust/webrtc-sdp/Cargo.toml", "third_party/rust/webrtc-sdp/Cargo.toml.orig", "third_party/rust/webrtc-sdp/README.md", "third_party/rust/webrtc-sdp/src/attribute_type.rs", "third_party/rust/webrtc-sdp/src/lib.rs", "third_party/rust/webrtc-sdp/src/lib_tests.rs"], "git_node": "af8974f74e4f86b3708ea577bbf0369f409a7835", "git_parents": ["69be58c81129528954f93da816468b9ae15e3ea4"], "node": "15894ed216ff82712a0d868fdbc366d3b11415e7", "parents": ["22d4189e669ded32061969ae4c5964bbae17850d"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064557 - Offline Suggest EU expansion 2026 phase 1: Enable AMP and Wikpedia by default in DE, FR, IT. r=daisuke,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319649\n", "files": ["browser/components/urlbar/QuickSuggest.sys.mjs", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_defaultPrefs.js"], "git_node": "ee65069e273d34ce7f88488e742a67f956d5b517", "git_parents": ["af8974f74e4f86b3708ea577bbf0369f409a7835"], "node": "a1ff537904b68d59636824fd528b4ddf4e8a91bb", "parents": ["15894ed216ff82712a0d868fdbc366d3b11415e7"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2063274 - Add Privacy title to widget for screenreader access. r=fluent-reviewers,nina-py,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319659\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Privacy.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "48b8fa122b5599177347af095eabe1ec5a58f209", "git_parents": ["ee65069e273d34ce7f88488e742a67f956d5b517"], "node": "ebbbc04e6d7e579c01b445e62c7d35f7969f1d7b", "parents": ["a1ff537904b68d59636824fd528b4ddf4e8a91bb"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2064005 - Remove some old fullscreen related telemetry probes, r=edgar,janerik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319075\n", "files": ["browser/actors/metrics.yaml", "dom/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "07d2a32ea5e256ea9c798a83aa7d7bf197e1dfaf", "git_parents": ["48b8fa122b5599177347af095eabe1ec5a58f209"], "node": "88e0f253bf9c036d90aebf8248afe671202e58e6", "parents": ["ebbbc04e6d7e579c01b445e62c7d35f7969f1d7b"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059597 - Use a plain Mutex for nsHostResolver::mDBLock r=necko-reviewers,valentin\n\nmDBLock is taken for writing on nearly every path. The only readers are SizeOfIncludingThis and GetDNSCacheEntries, so the reader/writer split only gives us little concurrency benefit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319815\n", "files": ["netwerk/dns/nsHostResolver.cpp", "netwerk/dns/nsHostResolver.h"], "git_node": "d44f624fb016accce4d4c6ce4c26014e0d1cc9dd", "git_parents": ["07d2a32ea5e256ea9c798a83aa7d7bf197e1dfaf"], "node": "c30bf6a9f4be42052a351b46ef1308211c72137a", "parents": ["88e0f253bf9c036d90aebf8248afe671202e58e6"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-be/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-be/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-cak/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gl/strings.xml", "mobile/android/fenix/app/src/main/res/values-gn/strings.xml", "mobile/android/fenix/app/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-iw/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nb-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-uk/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml"], "git_node": "ac9b592519d76e96dc2005dfb0244bc512d3d493", "git_parents": ["d44f624fb016accce4d4c6ce4c26014e0d1cc9dd"], "node": "e91b583d7fab9696eae8f6d0812116aa08ed9c5c", "parents": ["c30bf6a9f4be42052a351b46ef1308211c72137a"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062457 - Refactor Recommended location into an object r=android-reviewers,jonalmeida,Roger,gmalekpour\n\nThe intention behind the Recomended was to be consistent with the\ntoolkit api that treats specifically null as the default, \"recommended\",\noption, so removing the ability to override it through the constructor\nmakes code more resilent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316959\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocations.kt"], "git_node": "734e568c3ff6e4dfda7d3099be6120809f0c87df", "git_parents": ["ac9b592519d76e96dc2005dfb0244bc512d3d493"], "node": "ad02d9be4b46304b65d9d8ac57803dedf72b9082", "parents": ["e91b583d7fab9696eae8f6d0812116aa08ed9c5c"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2044846 - Add per-test Chrome arguments to Raptor. r=perftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318591\n", "files": ["testing/perfdocs/generated/browsertime.md", "testing/raptor/raptor/perfdocs/browsertime.md", "testing/raptor/raptor/perftest.py", "testing/raptor/test/test_raptor.py"], "git_node": "7bbe3188d08d865bd2ebbfe919e58cb18c7eb1a7", "git_parents": ["734e568c3ff6e4dfda7d3099be6120809f0c87df"], "node": "823c88487cebf8a5c3fdd144a25ceba69563e694", "parents": ["ad02d9be4b46304b65d9d8ac57803dedf72b9082"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2044846 - Enable camera VideoEncoder tests on Chrome and custom-car. r=perftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304620\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/tests/custom/browsertime-webcodecs.toml"], "git_node": "96ca1f7325b1e1b74ddde4d61c62b7f5e293d1f9", "git_parents": ["7bbe3188d08d865bd2ebbfe919e58cb18c7eb1a7"], "node": "1e3f27a7d589dcd1c132326fd3d03d5d85ffd9f8", "parents": ["823c88487cebf8a5c3fdd144a25ceba69563e694"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2057817 - ensure browser id handling is consistent, r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318490\n", "files": ["docshell/base/BrowsingContext.cpp"], "git_node": "64a1e2a8634556c0e581892187c7a87255c438fc", "git_parents": ["96ca1f7325b1e1b74ddde4d61c62b7f5e293d1f9"], "node": "13f4ec058d1ce6acb8520db4f5d45111af0760b5", "parents": ["1e3f27a7d589dcd1c132326fd3d03d5d85ffd9f8"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2031524 - Add WPT for VideoFrame.copyTo opaque/alpha format conversion r=media-playback-reviewers,padenot\n\nWebCodecs video encoding is unavailable on Android (bug 1840508), so the\nencode/decode round-trip check gates on VideoEncoder.isConfigSupported and\nis expected to report PRECONDITION_FAILED there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294066\n", "files": ["testing/web-platform/meta/webcodecs/videoFrame-copyTo-opaque-swizzle.https.any.js.ini", "testing/web-platform/tests/webcodecs/videoFrame-copyTo-opaque-swizzle.https.any.js"], "git_node": "45768e45de1fec411e05dd556303d67fe44e9da5", "git_parents": ["64a1e2a8634556c0e581892187c7a87255c438fc"], "node": "7a165e40313faca15841dc77ab541eeb73b3db24", "parents": ["13f4ec058d1ce6acb8520db4f5d45111af0760b5"], "tags": []}], "date": 1787218064, "git_changesets": ["a449dabf881cabf50f4fcd6f369b85de830a6398", "0681535597e70869dae0146f57f1ed9938d8027e", "b3ec05da6ac35adeb3f3709583bfa3d681732df8", "4b843058d565bf729ec9bf3a3803945e3c113831", "c83a0f2a5385df816b193d29acd52087a1919e4d", "d9febaaa4c5f0c4890585fddaf09fec3e7f934ab", "3ab6e1c8fce20e0a39fe455e7c55fce4657e8340", "30d5766cb08a0b273828fc5eabebc099e9425bf1", "1fcb78a15d35848644a6097670b703f197c6dcfb", "24f381f39a4250d0b852514638d717b031c01c2f", "10b419cc6afb86e93ef1e205c273e4dcae0e9453", "471920554c76ad4c3bbe8896765172cab6db12ce", "bc138ad7018d5a1cb6a0e6d0de023d8252ec3841", "c6c52d7a1d32618862e63c2642b39cfb7a9a0b6a", "70a1f42b63e22231283c7c0bc187361d3021aa1d", "04f8e4c41e46f7691f0a6684e95ba7fbc305a267", "2499d1c872b53bb40165b84a0c1d497909b171eb", "3a5b0440bf2f21089a48d1e91f7abb543e42f6ee", "69be58c81129528954f93da816468b9ae15e3ea4", "af8974f74e4f86b3708ea577bbf0369f409a7835", "ee65069e273d34ce7f88488e742a67f956d5b517", "48b8fa122b5599177347af095eabe1ec5a58f209", "07d2a32ea5e256ea9c798a83aa7d7bf197e1dfaf", "d44f624fb016accce4d4c6ce4c26014e0d1cc9dd", "ac9b592519d76e96dc2005dfb0244bc512d3d493", "734e568c3ff6e4dfda7d3099be6120809f0c87df", "7bbe3188d08d865bd2ebbfe919e58cb18c7eb1a7", "96ca1f7325b1e1b74ddde4d61c62b7f5e293d1f9", "64a1e2a8634556c0e581892187c7a87255c438fc", "45768e45de1fec411e05dd556303d67fe44e9da5"], "user": "rperta@mozilla.com"}, "45132": {"changesets": [{"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062417 - browser.smartwindow.agent.enabled set default and set nimbus feature pattern for Smart Window Agent Watch r=ngrato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319880\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_nimbus.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "252eb0e1b7a4c9cabf8ece484188351d89a04d54", "git_parents": ["45768e45de1fec411e05dd556303d67fe44e9da5"], "node": "4fff988dd9d6faa1136cb1e3e54144c8590e19d6", "parents": ["7a165e40313faca15841dc77ab541eeb73b3db24"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059240 - Show the Taskbar Tabs page action on moz-extension and use the addon's name for the Taskbar Tab. r=nrishel,hsohaney,extension-reviewers,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315753\n", "files": ["browser/components/taskbartabs/TaskbarTabs.sys.mjs", "browser/components/taskbartabs/TaskbarTabsPageAction.sys.mjs", "browser/components/taskbartabs/test/browser/browser_taskbarTabs_pageAction.js"], "git_node": "fa08e6fa65657ad7182d22d0008272e876868653", "git_parents": ["252eb0e1b7a4c9cabf8ece484188351d89a04d54"], "node": "2179aabf5bbb7eeb0f2023a9b820e830bb8e88af", "parents": ["4fff988dd9d6faa1136cb1e3e54144c8590e19d6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062215 - Load the address bar's stylesheets in a content document. r=mbeier,desktop-theme-reviewers,urlbar-reviewers,hjones\n\n`urlbar-searchbar.css` becomes `urlbar.css` and imports the rest of the urlbar's set, so a chrome window, the smartbar and a content document all load the one sheet, the element linking it when it builds outside a chrome window. New Tab's registrant gives it the `urlbar` class most of the rules are keyed on.\n\nThe results still draw behind the page: promoting them to the top layer is the rest of the bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319708\n", "files": ["browser/components/urlbar/UrlbarNewTabComponentRegistrant.sys.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/themes/shared/browser-shared.css", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/smartbar.css", "browser/themes/shared/urlbar-searchbar.css", "browser/themes/shared/urlbar.css", "stylelint-rollouts.config.js"], "git_node": "59a22ae4d07562b2d255e5cccd1a54ea4eaf04e7", "git_parents": ["fa08e6fa65657ad7182d22d0008272e876868653"], "node": "392cb50a5076516bc3b807704cdea18a72b0d3f1", "parents": ["2179aabf5bbb7eeb0f2023a9b820e830bb8e88af"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062215 - Make the view's layout and popup paths content-safe. r=daleharvey\n\nOpening the view runs through four chrome-only paths plus an observer notification. A content realm threw on the first of them, and `handleEvent`'s try/catch reported it to a console nothing reads, so the view simply never opened.\n\n`getBoundsWithoutFlushing` moves to `UrlbarShared`, since the input and the view both had their own copy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319709\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/content/UrlbarView.mjs"], "git_node": "53babef4391252be3356cbfc0d06fc30dbe91032", "git_parents": ["59a22ae4d07562b2d255e5cccd1a54ea4eaf04e7"], "node": "cfc2c7001343865f596b19328a1a66adaec4238f", "parents": ["392cb50a5076516bc3b807704cdea18a72b0d3f1"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062215 - Open the newtab results view in the top layer. r=daleharvey\n\n`#allowBreakout` asked whether the element sits in a toolbar, which is how a chrome window says the urlbar may grow past its container and into the top layer. Content answers it with the popover attribute, which the registrant sets again since the stylesheets reach the page and reset the UA rules that hide a closed popover.\n\nRendered rows also ask for the group labels in enUS-searchFeatures.ftl, which the component's bundles were missing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319710\n", "files": ["browser/components/urlbar/UrlbarNewTabComponentRegistrant.sys.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "55f92889865935379996ea5bd686bf53bc9ef85f", "git_parents": ["53babef4391252be3356cbfc0d06fc30dbe91032"], "node": "cb66e21d8b954ad329eaa4ee389db23036c4b3d3", "parents": ["cfc2c7001343865f596b19328a1a66adaec4238f"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056051: Don't cancel the ImageDecoder read request from cycle-collection unlink r=dom-core-reviewers,media-playback-reviewers,smaug,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318221\n", "files": ["dom/base/NodeIterator.cpp", "dom/media/webcodecs/ImageDecoder.cpp", "dom/media/webcodecs/ImageDecoder.h"], "git_node": "e8ff0efe95edd43df51f9e0cb8b5d9f54f879cf7", "git_parents": ["55f92889865935379996ea5bd686bf53bc9ef85f"], "node": "7144e78ab08a1a4aceb3345e3864b7e3f8ff0038", "parents": ["cb66e21d8b954ad329eaa4ee389db23036c4b3d3"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063064: Restructure ImageDecoderReadRequest teardown to remove its CAN_RUN_SCRIPT_BOUNDARY r=media-playback-reviewers,aosmond\n\nImageDecoderReadRequest::Cancel() was MOZ_CAN_RUN_SCRIPT_BOUNDARY, which let\nDestroy() call it without Destroy()'s own callers -- including cycle-collection\nUnlink and ~ImageDecoder -- needing MOZ_CAN_RUN_SCRIPT. That's the annotation\ngap the previous patch closed at runtime with a bool parameter; the analyzer\ncan't see through that bool, so it never actually verified the reentrancy is\ngone.\n\nSplit the teardown into textually distinct paths instead, so the analyzer can\nverify it directly:\n\n- ImageDecoderReadRequest: Destroy() (never cancels, plain) vs.\n  DestroyAndCancel() (MOZ_CAN_RUN_SCRIPT, calls the now unboundaried Cancel()).\n- ImageDecoder: CloseWithoutRef() (plain) vs. CloseAndCancelWithoutRef()\n  (MOZ_CAN_RUN_SCRIPT), sharing teardown via CloseCommon(). Unlink, ~ImageDecoder,\n  and OnShutdown() use the plain path; Close() uses the cancelling one.\n\nOnShutdown() moving to the plain path is a real behavior change, not just an\nannotation split: it goes through nsIObserver::Observe() (main-thread shutdown)\nor a WeakWorkerRef callback (worker shutdown), and Observe() is a fixed\ninterface method that can never be MOZ_CAN_RUN_SCRIPT. Global teardown isn't a\nsafe place to run page script either, so this puts it on the same footing as\nUnlink/~ImageDecoder rather than trying to thread script-safety through\nnsIObserver.\n\nCloseCommon() also now runs the read-request step last, after mTracks/\nmCompletePromise/mShutdownWatcher are already torn down and mClosed is set, so\nany reentrancy from the cancel callback sees a fully-closed decoder instead of\na half-torn-down one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318222\n", "files": ["dom/media/webcodecs/ImageDecoder.cpp", "dom/media/webcodecs/ImageDecoder.h", "dom/media/webcodecs/ImageDecoderReadRequest.cpp", "dom/media/webcodecs/ImageDecoderReadRequest.h"], "git_node": "324adfbd3024ea6c35c60e444a6c67b10a8c29d1", "git_parents": ["e8ff0efe95edd43df51f9e0cb8b5d9f54f879cf7"], "node": "6bae67f50dbba6b079efc1bd6353adbca1ed3dcd", "parents": ["7144e78ab08a1a4aceb3345e3864b7e3f8ff0038"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064594 - Update custom icons with tighter margins, and use the older 2004 variant. r=yazan\n\nThe 2004 variant we used was from the tail end of 2004 when Firefox 1.0 was released, but\napparently most people expected the variant for 2004 to be the one from versions 0.8 to 0.10,\nso we're swapping in that asset instead.\n\nThe margins around the Momo and Retro 2017 variants have also been tightened up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319943\n", "files": ["browser/components/shell/icons/momo.ico", "browser/components/shell/icons/retro2004.ico", "browser/components/shell/icons/retro2017.ico"], "git_node": "de3cb9d472f7dcda7ea30ea39b281a53e6fba7af", "git_parents": ["324adfbd3024ea6c35c60e444a6c67b10a8c29d1"], "node": "16ad9a2df8750d344506f8dfaa6a81294bb9b6d6", "parents": ["6bae67f50dbba6b079efc1bd6353adbca1ed3dcd"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2059965 - Copy mapped AppleVT inputs before submission r=media-playback-reviewers,alwu\n\nCopy packed source pixels into an owned CVPixelBuffer while their map is live, so VideoToolbox never receives a scoped map address.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318170\n", "files": ["dom/media/platforms/apple/AppleVTEncoder.cpp"], "git_node": "e52670d68dfadad69fa74a56d2b991876cfadb7b", "git_parents": ["de3cb9d472f7dcda7ea30ea39b281a53e6fba7af"], "node": "e54c990278165a01619595516f31f8240109e32a", "parents": ["16ad9a2df8750d344506f8dfaa6a81294bb9b6d6"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054917 - Add print button to Android PDF viewer r=android-reviewers,jonalmeida\n\nPatch adds a print button to the Android PDF viewer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319739\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolsIntegration.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsContentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationGleanTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationTest.kt"], "git_node": "98f3968396aba8cec65bc394c9fcbf9f2ef29d39", "git_parents": ["e52670d68dfadad69fa74a56d2b991876cfadb7b"], "node": "24374655a76b093b364690ae5853cf3726aea762", "parents": ["e54c990278165a01619595516f31f8240109e32a"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054918 - Add share button to Android PDF viewer r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319812\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolsIntegration.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsContentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationGleanTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationTest.kt"], "git_node": "a383d052ca0aaee3111f8829406135fa2c85bf5c", "git_parents": ["98f3968396aba8cec65bc394c9fcbf9f2ef29d39"], "node": "ecaa0ccddb6137190ecd3c509b57f51bd344affd", "parents": ["24374655a76b093b364690ae5853cf3726aea762"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2061532 r=gfx-reviewers,lsalzman\n\nANGLE Metal backend usage is also going to disable RenderExternalTextureHost usage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318624\n", "files": ["gfx/webrender_bindings/RenderExternalTextureHost.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "a71279f779e884b0957c0e008b67d76bc16f2b37", "git_parents": ["a383d052ca0aaee3111f8829406135fa2c85bf5c"], "node": "907a891050273dba42b7a11a1a69fe038d718327", "parents": ["ecaa0ccddb6137190ecd3c509b57f51bd344affd"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2063167 - Keep scroll container's overflow state across frame reconstruction so underflow is fired. r=layout-reviewers,emilio,hiro\n\nThe fade-out mask was left on result titles once rows started wrapping. Wrapping\nswitches the row body containing the title from `display: flex` to\n`display: grid`, which recreates the frames inside it, and no underflow event\nwas fired for the recreated frames even though the title was then wide enough\nfor its contents.\nThis is because the overflow state is reset when reframing, so carry it over to\nthe new frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319724\n", "files": ["layout/base/PresState.ipdlh", "layout/base/nsLayoutHistoryState.cpp", "layout/generic/ScrollContainerFrame.cpp", "layout/generic/test/chrome.toml", "layout/generic/test/test_overflow_underflow_on_reframe.html"], "git_node": "719ac364b8594e49df504fef9781c20c8fda4402", "git_parents": ["a71279f779e884b0957c0e008b67d76bc16f2b37"], "node": "7dcaf32ecff9dbe2f0c02660aa7a9f0f597deeab", "parents": ["907a891050273dba42b7a11a1a69fe038d718327"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064162 -  On Android, saveAsPdf should behave differently if the page is a PDF r=geckoview-reviewers,calixte,jonalmeida\n\nBefore this patch, `saveAsPdf` always ran through the Gecko print machinery to generate a PDF.\n\nThis patch adds a check for if the document is a and uses the PDF machinery to save.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319600\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PdfCreationTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionPdfFileSaver.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md"], "git_node": "482fa522a3086515f1be9f4fbc0207bcde90867f", "git_parents": ["719ac364b8594e49df504fef9781c20c8fda4402"], "node": "8d919ee0855ad9cc0a92a9a56cb8648af60ef3e4", "parents": ["7dcaf32ecff9dbe2f0c02660aa7a9f0f597deeab"], "tags": []}, {"author": "Christopher DiPersio \u003ccdipersio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064838 - Reduce PUWYLO URL semantic similarity threshold and expose as a pref r=cmurray\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319898\n", "files": ["browser/components/aiwindow/models/ConversationSuggestions.sys.mjs", "browser/components/aiwindow/models/memories/MemoriesHistorySource.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_conversation_starters.js"], "git_node": "628bcb5a2ec324fb2b7825dba17426d3ebd36bf7", "git_parents": ["482fa522a3086515f1be9f4fbc0207bcde90867f"], "node": "f715a06542652f4a03730f2a844585c5d3dc1233", "parents": ["8d919ee0855ad9cc0a92a9a56cb8648af60ef3e4"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2056071 (part 1) - Remove app-services BridgedEngine. r=bdk,skhamis,sync-reviewers\n\nThe mozilla-central side of the consolidation of SyncEngine and BridgedEngine.\nMoves to a duck-typed bridged engine (which should be fixed), changes to how\nthe last-sync time is managed.\n\nPaired with https://github.com/mozilla/application-services/pull/7483, which\nis being vendored in part 2.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312903\n", "files": ["services/interfaces/moz.build", "services/interfaces/mozIBridgedSyncEngine.idl", "services/sync/modules/bridged_engine.sys.mjs", "services/sync/modules/engines/tabs.sys.mjs", "services/sync/tests/unit/test_bridged_engine.js", "services/sync/tests/unit/test_extension_storage_engine.js", "services/sync/tests/unit/test_tab_quickwrite.js", "toolkit/components/extensions/test/xpcshell/test_StorageSyncService.js", "toolkit/components/uniffi-bindgen-gecko-js/config.toml"], "git_node": "27ec4a33b145e67f0ddec12aad5217bc91662ffa", "git_parents": ["628bcb5a2ec324fb2b7825dba17426d3ebd36bf7"], "node": "d70972e9ab97ecb607ff865f1e0377707d499b30", "parents": ["f715a06542652f4a03730f2a844585c5d3dc1233"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2056071 (part 2) - Vendor application-services rev 7c34b8930543e7c34b89. r=skhamis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319670\n", "files": ["third_party/application-services/components/autofill/src/autofill.udl", "third_party/application-services/components/autofill/src/sync/bridge.rs", "third_party/application-services/components/autofill/src/sync/engine.rs", "third_party/application-services/components/example/src/error.rs", "third_party/application-services/components/fxa-client/src/state_machine/transitions.rs", "third_party/application-services/components/logins/Cargo.toml", "third_party/application-services/components/logins/src/db.rs", "third_party/application-services/components/logins/src/encryption.rs", "third_party/application-services/components/logins/src/error.rs", "third_party/application-services/components/logins/src/logins.udl", "third_party/application-services/components/logins/src/sync/bridge.rs", "third_party/application-services/components/logins/src/sync/engine.rs", "third_party/application-services/components/merino/src/lib.rs", "third_party/application-services/components/merino/src/worldcup/error.rs", "third_party/application-services/components/merino/src/worldcup/fixtures/live.json", "third_party/application-services/components/merino/src/worldcup/fixtures/matches.json", "third_party/application-services/components/merino/src/worldcup/fixtures/teams.json", "third_party/application-services/components/merino/src/worldcup/http.rs", "third_party/application-services/components/merino/src/worldcup/mod.rs", "third_party/application-services/components/merino/src/worldcup/schema.rs", "third_party/application-services/components/merino/src/worldcup/tests.rs", "third_party/application-services/components/nimbus/Cargo.toml", "third_party/application-services/components/nimbus/src/tests/helpers.rs", "third_party/application-services/components/places/src/storage/history_metadata.rs", "third_party/application-services/components/remote_settings/dumps/main/attachments/search-config-icons/acae3d3c-b09e-47f0-a9e5-57980d21fc4a", "third_party/application-services/components/remote_settings/dumps/main/attachments/search-config-icons/acae3d3c-b09e-47f0-a9e5-57980d21fc4a.meta.json", "third_party/application-services/components/remote_settings/dumps/main/attachments/search-config-icons/fea7a389-2590-4675-8661-50f187dcb888", "third_party/application-services/components/remote_settings/dumps/main/attachments/search-config-icons/fea7a389-2590-4675-8661-50f187dcb888.meta.json", "third_party/application-services/components/remote_settings/dumps/main/search-config-icons.json", "third_party/application-services/components/remote_settings/dumps/main/search-config-icons.timestamp", "third_party/application-services/components/remote_settings/dumps/main/search-config-v2.json", "third_party/application-services/components/remote_settings/dumps/main/search-config-v2.timestamp", "third_party/application-services/components/remote_settings/dumps/main/search-telemetry-v2.json", "third_party/application-services/components/remote_settings/dumps/main/search-telemetry-v2.timestamp", "third_party/application-services/components/support/error/tests/macro_arguments.stderr", "third_party/application-services/components/support/rc_crypto/src/agreement.rs", "third_party/application-services/components/support/viaduct-hyper/src/lib.rs", "third_party/application-services/components/sync15/src/bso/content.rs", "third_party/application-services/components/sync15/src/client/request.rs", "third_party/application-services/components/sync15/src/client/sync.rs", "third_party/application-services/components/sync15/src/client_types.rs", "third_party/application-services/components/sync15/src/engine/bridged_engine.rs", "third_party/application-services/components/sync15/src/engine/mod.rs", "third_party/application-services/components/sync15/src/engine/sync_engine.rs", "third_party/application-services/components/tabs/android/src/main/java/mozilla/appservices/tabs/Guid.kt", "third_party/application-services/components/tabs/src/lib.rs", "third_party/application-services/components/tabs/src/sync/bridge.rs", "third_party/application-services/components/tabs/src/sync/engine.rs", "third_party/application-services/components/tabs/src/sync/record.rs", "third_party/application-services/components/tabs/src/tabs.udl", "third_party/application-services/components/viaduct/src/backend.rs", "third_party/application-services/components/webext-storage/src/lib.rs", "third_party/application-services/components/webext-storage/src/sync/bridge.rs", "third_party/application-services/components/webext-storage/src/webext-storage.udl", "third_party/application-services/examples/merino-cli/src/main.rs", "third_party/application-services/examples/remote-settings-cli/src/dump/client.rs", "third_party/application-services/examples/tabs-sync/src/tabs-sync.rs", "third_party/application-services/moz.yaml", "third_party/application-services/tools/generate-rust-dashboards/src/component_config.rs", "third_party/application-services/tools/generate-rust-dashboards/src/config.rs", "third_party/application-services/tools/generate-rust-dashboards/src/main.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/event.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/mod.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/sync.rs", "third_party/application-services/tools/generate-rust-dashboards/src/schema.rs", "third_party/application-services/tools/generate-rust-dashboards/src/sql.rs", "third_party/application-services/tools/generate-rust-dashboards/src/team_config.rs", "toolkit/components/uniffi-bindgen-gecko-js/android/components/autofill/android/src/main/java/mozilla/appservices/autofill/autofill.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/logins/android/src/main/java/mozilla/appservices/logins/logins.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/merino/android/src/main/java/mozilla/appservices/merino/merino.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/tabs/android/src/main/java/mozilla/appservices/remotetabs/tabs.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustInitRustComponents.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTracing.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "2e4e1eb7eef193031df0bc0e0138468c6fb3d4c7", "git_parents": ["27ec4a33b145e67f0ddec12aad5217bc91662ffa"], "node": "650ec3ac35a9da706ae58f641b2b0199b25c6b1a", "parents": ["d70972e9ab97ecb607ff865f1e0377707d499b30"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2053997 - Make `Range.deleteContents()`, `Range.cloneContents()`, `Range.extractContents()` and `Selection.deleteFromDocument()` work as in the DOM r=smaug\n\nThe spec does not mention about the flattened tree and Chrome handles\nthe range as in a DOM. E.g., unassigned node is handled, but the nodes\nin the shadow are ignored.\n\nFor the compatibility with Chrome, we should follow their behavior\nfor now.\n\nThe new tests for `Selection.deleteFromDocument` does not pass even\nwith this patch. However, we just call `nsRange::DeleteContents()` [1].\nTherefore, it may be caused by a bug of `Selection::SetBaseAndExtent()`.\nFixing it may require more changes. So, this does not fix the failures.\n\n1. https://searchfox.org/firefox-main/rev/a07b2cb8ff33387a81968a7ed9d59ebdc4dad607/dom/base/Selection.cpp#4205\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311661\n", "files": ["dom/base/CrossShadowBoundaryRange.h", "dom/base/nsRange.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/selection/shadow-dom/tentative/Selection-deleteFromDocument-around-shadow.html.ini", "testing/web-platform/tests/dom/ranges/Range-cloneContents-around-shadow.html", "testing/web-platform/tests/dom/ranges/Range-cloneContents-around-shadow.tentative.html", "testing/web-platform/tests/dom/ranges/Range-deleteContents-around-shadow.html", "testing/web-platform/tests/dom/ranges/Range-deleteContents-around-shadow.tentative.html", "testing/web-platform/tests/dom/ranges/Range-extractContents-around-shadow.html", "testing/web-platform/tests/dom/ranges/Range-extractContents-around-shadow.tentative.html", "testing/web-platform/tests/selection/shadow-dom/tentative/Selection-deleteFromDocument-around-shadow.html"], "git_node": "bc8abb63926115cb0c94d645c81897a3a4a24531", "git_parents": ["2e4e1eb7eef193031df0bc0e0138468c6fb3d4c7"], "node": "bd08d097d3d05aac6aa7598bc082090dd857032f", "parents": ["650ec3ac35a9da706ae58f641b2b0199b25c6b1a"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2053997 - Make `nsRange::CutContents` work with `TreeKind::FlatForSelection` if called by `nsRange::SuppressContentsForPrintSelection` r=smaug\n\n`nsRange::CutContents` is used by the printing too and printing feature\nexpects that this API work within `TreeKind::FlatForSelection`.\nTherefore, this patch adds `Maybe\u003cAllowRangeCrossShadowBoundary\u003e`\nparameter to override the pref.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319445\n", "files": ["dom/base/nsRange.cpp", "dom/base/nsRange.h"], "git_node": "cf321a4d1ef8e403c604ba9c8384766700e30cda", "git_parents": ["bc8abb63926115cb0c94d645c81897a3a4a24531"], "node": "d13b4d9adc6469581a987932791222f8d85f99fe", "parents": ["bd08d097d3d05aac6aa7598bc082090dd857032f"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2052939 - Improve the async commit composition which is in a content process r=m_kato\n\nWhen `TextComposition` in a content process requests to commit\ncomposition, the request is sent to the parent process synchronously.\nThen, if IME handles the request synchronously,\n`PuppetWidget::RequestIMEToCommitComposition` dispatches a\n`eCompositionCommit` event synchronously. However, if IME handles it\nasynchronously, `RequestIMEToCommitComposition` does nothing and\n`TextComposition::RequestToCommit` dispatches `eCompositionCommit` or\n`eCompositionCommitAsIs` before receiving next event (in the most\ncases). However, the puppet widget won't receive the delayed commit\nevent in this case because `TextComposition::DispatchCompositionEvent`\nin the parent process does not send the delayed commit event. Therefore,\n`PuppetWidget::DispatchEvent` cannot notify `TextEventDispatcher` of\nthe commit event. Therefore, `TextEventDispatcher` will have wrong\ncomposition state.\n\nSo, fixing this issue, we need to make\n`TextComposition::DispatchCompositionEvent` in the parent process should\nsend the commit event as usual. To avoid the `ContentCacheInParent`\nto misunderstand the native IME's composition state,\n`TextComposition::RequestToCommit` should not dispatch\n`eCompositionCommit` nor `eCompositionCommitAsIs` because the event\ncauses `ContentCacheInParent` thinks the composition is actually\ncommitted in IME.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319302\n", "files": ["dom/base/TextInputProcessor.cpp", "dom/events/TextComposition.cpp", "widget/PuppetWidget.cpp", "widget/PuppetWidget.h", "widget/TextEventDispatcher.cpp", "widget/TextEventDispatcher.h", "widget/tests/browser/browser.toml", "widget/tests/browser/browser_test_ime_request_commit_async.js", "widget/tests/browser/browser_test_ime_request_commit_sync.js", "widget/tests/chrome.toml", "widget/tests/file_ime_state_test_helper.js", "widget/tests/file_test_ime_request_commit.js", "widget/tests/test_ime_request_commit_async_in_parent.html", "widget/tests/test_ime_request_commit_sync_in_parent.html"], "git_node": "02c332d879a77597ce68cc5c3d893b00d41344b9", "git_parents": ["cf321a4d1ef8e403c604ba9c8384766700e30cda"], "node": "f15e3db72bb517dc067603eca8bf7cd2e9d01bbf", "parents": ["d13b4d9adc6469581a987932791222f8d85f99fe"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2064596 - Exclude border/padding when applying text-box-trim to inline boxes. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319661\n", "files": ["layout/generic/nsLineLayout.cpp", "testing/web-platform/meta/css/css-inline/text-box-trim/text-box-trim-inline-box-005.html.ini", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-004-ref.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-004.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-005-ref.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-005.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-006-ref.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-006.html"], "git_node": "bec057ba804ef1beeb181accc925097cbb8a1360", "git_parents": ["02c332d879a77597ce68cc5c3d893b00d41344b9"], "node": "8ab970302b57f2a50803457d241d6077f972fe90", "parents": ["f15e3db72bb517dc067603eca8bf7cd2e9d01bbf"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062852 part 1: Centrally handle accessibility.force_disabled=-1 (force enable) for all platforms. r=eeejay\n\naccessibility.force_disabled=-1 is meant to force enable accessibility, but previously, nothing acted on it centrally.\nGetOrCreateAccService only checked the force disabled case, leaving the force enabled case to platform specific code.\nAside from being hard to reason about, this meant there was different (sometimes broken) behaviour on different platforms.\nWindows was the only platform that proactively started accessibility in nsWindow::Create.\nOn Mac and Linux, the force enabled state allowed accessibility to be enabled where it otherwise wouldn't have been (e.g. no detected client), but it still only activated based on specific platform signals.\nAndroid never read the pref at all.\n\nTo fix this, add a11y::MaybeStartForceEnabled, called once from nsAppRunner.cpp just before the main run loop starts.\nThis only ever runs in the parent process.\nCalling PlatformDisabledState() there unconditionally also ensures the pref-change callback gets registered even when nothing else would have triggered that registration.\n\nThis required an additional fix on Android.\nPreviously, SessionAccessibility::Settings unconditionally shut accessibility down when a session's accessibility was first attached to a view with no assistive technology running.\nWe now prevent that shutdown when force enabled via the pref.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318646\n", "files": ["accessible/android/SessionAccessibility.cpp", "accessible/base/Platform.h", "accessible/base/nsAccessibilityService.cpp", "accessible/moz.build", "accessible/tests/browser/forceEnabled/browser.toml", "accessible/tests/browser/forceEnabled/browser_forceEnabled.js", "toolkit/xre/nsAppRunner.cpp"], "git_node": "2e9006c7240bfbc413a1ee5bd717f8aec350f8c1", "git_parents": ["bec057ba804ef1beeb181accc925097cbb8a1360"], "node": "c5e8ba0fdb080ac2fd6015b4b07f1e059ad6305d", "parents": ["8ab970302b57f2a50803457d241d6077f972fe90"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062852 part 2: Remove the Windows specific accessibility force enable priming hack. r=eeejay\n\nThis is now redundant.\na11y::MaybeStartForceEnabled, called centrally from nsAppRunner.cpp, covers this on every platform including Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318647\n", "files": ["widget/windows/WinMessages.h", "widget/windows/nsWindow.cpp"], "git_node": "3595a736aa06fb2915a4eb6e4c53f31f0327aadf", "git_parents": ["2e9006c7240bfbc413a1ee5bd717f8aec350f8c1"], "node": "685b5dcd757def2f7d9d5187cde7112f78b58b61", "parents": ["c5e8ba0fdb080ac2fd6015b4b07f1e059ad6305d"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062852 part 3: Enable ATK to be reinitialised after it is shut down. r=eeejay\n\nPreviously, we didn't unregister from ATK when shutting down.\nThat was fine because we never supported starting the engine up again after it was shut down, but we soon will.\nAt that point, failure to unregister from ATK will cause subsequent registration attempts to do nothing, so clients can't find us.\nTo fix this, call atk_bridge_adaptor_cleanup when shutting down.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319726\n", "files": ["accessible/atk/Platform.cpp"], "git_node": "c8ef71edc46b7f2b144cb2a566aa2472b80b4151", "git_parents": ["3595a736aa06fb2915a4eb6e4c53f31f0327aadf"], "node": "1f0db270a191a28cb48907eb24edb346532f888a", "parents": ["685b5dcd757def2f7d9d5187cde7112f78b58b61"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062852 part 4: Start accessibility when accessibility.force_disabled changes to -1 at runtime. r=eeejay,geckoview-reviewers,m_kato\n\nPrefChanged already force shuts accessibility down when the pref changes to 1.\nHowever, it previously did nothing on a change to -1, so force enabling required a restart.\nGive MaybeStartForceEnabled an async flag and call it from PrefChanged with that mode when the pref changes to force enabled.\nAsync is needed because this callback runs synchronously wherever the pref is set.\nWe don't want accessibility init happening inside arbitrary code.\nThis also updates the comment describing the pref and adds platform specific tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318648\n", "files": ["accessible/base/Platform.h", "accessible/base/nsAccessibilityService.cpp", "accessible/tests/browser/atk/browser.toml", "accessible/tests/browser/atk/browser_forceEnabled.js", "accessible/tests/browser/browser_shutdown_pref.js", "accessible/tests/browser/windows/ia2/browser.toml", "accessible/tests/browser/windows/ia2/browser_forceEnabled.js", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "modules/libpref/init/all.js"], "git_node": "9752743055a8a98ef1bcab3c68302d0651bd6e05", "git_parents": ["c8ef71edc46b7f2b144cb2a566aa2472b80b4151"], "node": "8d1e6e307f8b8724e9e52bdf94fe602aa0097e4a", "parents": ["1f0db270a191a28cb48907eb24edb346532f888a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043635 - Prevent build output suppression in CI by tying the log level to build's verbose flag r=firefox-build-system-reviewers,glandium\n\nIf there's a bug in the warning suppression logic, then some warnings\ncan get misattributed and suppressed. This suppression logic was only\never supposed to run locally, and never in CI. Since builds run with\n`-v` in CI, my thinking was `mach` would set the log level to `DEBUG`.\n\nhttps://searchfox.org/firefox-main/rev/25d7109bf565c299435dec3dd2b9e79a1ce7c15d/python/mach/mach/main.py#390\n\nMy mistake was that there's both a global `verbose` flag and a build\n`verbose` flag, and only the global one sets the log level to `DEBUG`.\nSince we run `./mach build -v` and not `./mach -v build`, we only get\nthe behavior of the build `verbose`, which did not change the log level.\n\nThe solution is to make the build's `verbose` flag also change the log\nlevel. It does not need to be `DEBUG` since that would be an unintended\nbehavior change, it just has to be on par with `THIRD_PARTY_WARNING`,\nwhich is the lowest level we set for suppression, then nothing will ever\nget suppressed in CI.\n\nThis does not fix the root cause in the suppression logic, which will\nbe a follow up. This just fixes CI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318663\n", "files": ["python/mozbuild/mozbuild/build_commands.py"], "git_node": "144668cb7a157889d1640ac37e76fc88420ccc13", "git_parents": ["9752743055a8a98ef1bcab3c68302d0651bd6e05"], "node": "290560fa73c62705acf075ba3653ba539f2a94a7", "parents": ["8d1e6e307f8b8724e9e52bdf94fe602aa0097e4a"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063064, Bug 2056051: Restructure ImageDecoderReadRequest teardown to remove its CAN_RUN_SCRIPT_BOUNDARY r=media-playback-reviewers,aosmond\" for causing build bustages on ImageDecoderBinding.cpp\n\nThis reverts commit 324adfbd3024ea6c35c60e444a6c67b10a8c29d1.\n\nRevert \"Bug 2056051: Don't cancel the ImageDecoder read request from cycle-collection unlink r=dom-core-reviewers,media-playback-reviewers,smaug,aosmond\"\n\nThis reverts commit e8ff0efe95edd43df51f9e0cb8b5d9f54f879cf7.\n", "files": ["dom/base/NodeIterator.cpp", "dom/media/webcodecs/ImageDecoder.cpp", "dom/media/webcodecs/ImageDecoder.h", "dom/media/webcodecs/ImageDecoderReadRequest.cpp", "dom/media/webcodecs/ImageDecoderReadRequest.h"], "git_node": "b519d650f57bc8d4507723f31f660a04d72dfdf6", "git_parents": ["144668cb7a157889d1640ac37e76fc88420ccc13"], "node": "871510f51054eb93d3ed826874ac397bf60b708f", "parents": ["290560fa73c62705acf075ba3653ba539f2a94a7"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056071 (part 2) - Vendor application-services rev 7c34b8930543e7c34b89. r=skhamis\" for causing lint failures\n\nThis reverts commit 2e4e1eb7eef193031df0bc0e0138468c6fb3d4c7.\n\nRevert \"Bug 2056071 (part 1) - Remove app-services BridgedEngine. r=bdk,skhamis,sync-reviewers\"\n\nThis reverts commit 27ec4a33b145e67f0ddec12aad5217bc91662ffa.\n", "files": ["services/interfaces/moz.build", "services/interfaces/mozIBridgedSyncEngine.idl", "services/sync/modules/bridged_engine.sys.mjs", "services/sync/modules/engines/tabs.sys.mjs", "services/sync/tests/unit/test_bridged_engine.js", "services/sync/tests/unit/test_extension_storage_engine.js", "services/sync/tests/unit/test_tab_quickwrite.js", "third_party/application-services/components/autofill/src/autofill.udl", "third_party/application-services/components/autofill/src/sync/bridge.rs", "third_party/application-services/components/autofill/src/sync/engine.rs", "third_party/application-services/components/example/src/error.rs", "third_party/application-services/components/fxa-client/src/state_machine/transitions.rs", "third_party/application-services/components/logins/Cargo.toml", "third_party/application-services/components/logins/src/db.rs", "third_party/application-services/components/logins/src/encryption.rs", "third_party/application-services/components/logins/src/error.rs", "third_party/application-services/components/logins/src/logins.udl", "third_party/application-services/components/logins/src/sync/bridge.rs", "third_party/application-services/components/logins/src/sync/engine.rs", "third_party/application-services/components/merino/src/lib.rs", "third_party/application-services/components/merino/src/worldcup/error.rs", "third_party/application-services/components/merino/src/worldcup/fixtures/live.json", "third_party/application-services/components/merino/src/worldcup/fixtures/matches.json", "third_party/application-services/components/merino/src/worldcup/fixtures/teams.json", "third_party/application-services/components/merino/src/worldcup/http.rs", "third_party/application-services/components/merino/src/worldcup/mod.rs", "third_party/application-services/components/merino/src/worldcup/schema.rs", "third_party/application-services/components/merino/src/worldcup/tests.rs", "third_party/application-services/components/nimbus/Cargo.toml", "third_party/application-services/components/nimbus/src/tests/helpers.rs", "third_party/application-services/components/places/src/storage/history_metadata.rs", "third_party/application-services/components/remote_settings/dumps/main/attachments/search-config-icons/acae3d3c-b09e-47f0-a9e5-57980d21fc4a", "third_party/application-services/components/remote_settings/dumps/main/attachments/search-config-icons/acae3d3c-b09e-47f0-a9e5-57980d21fc4a.meta.json", "third_party/application-services/components/remote_settings/dumps/main/attachments/search-config-icons/fea7a389-2590-4675-8661-50f187dcb888", "third_party/application-services/components/remote_settings/dumps/main/attachments/search-config-icons/fea7a389-2590-4675-8661-50f187dcb888.meta.json", "third_party/application-services/components/remote_settings/dumps/main/search-config-icons.json", "third_party/application-services/components/remote_settings/dumps/main/search-config-icons.timestamp", "third_party/application-services/components/remote_settings/dumps/main/search-config-v2.json", "third_party/application-services/components/remote_settings/dumps/main/search-config-v2.timestamp", "third_party/application-services/components/remote_settings/dumps/main/search-telemetry-v2.json", "third_party/application-services/components/remote_settings/dumps/main/search-telemetry-v2.timestamp", "third_party/application-services/components/support/error/tests/macro_arguments.stderr", "third_party/application-services/components/support/rc_crypto/src/agreement.rs", "third_party/application-services/components/support/viaduct-hyper/src/lib.rs", "third_party/application-services/components/sync15/src/bso/content.rs", "third_party/application-services/components/sync15/src/client/request.rs", "third_party/application-services/components/sync15/src/client/sync.rs", "third_party/application-services/components/sync15/src/client_types.rs", "third_party/application-services/components/sync15/src/engine/bridged_engine.rs", "third_party/application-services/components/sync15/src/engine/mod.rs", "third_party/application-services/components/sync15/src/engine/sync_engine.rs", "third_party/application-services/components/tabs/android/src/main/java/mozilla/appservices/tabs/Guid.kt", "third_party/application-services/components/tabs/src/lib.rs", "third_party/application-services/components/tabs/src/sync/bridge.rs", "third_party/application-services/components/tabs/src/sync/engine.rs", "third_party/application-services/components/tabs/src/sync/record.rs", "third_party/application-services/components/tabs/src/tabs.udl", "third_party/application-services/components/viaduct/src/backend.rs", "third_party/application-services/components/webext-storage/src/lib.rs", "third_party/application-services/components/webext-storage/src/sync/bridge.rs", "third_party/application-services/components/webext-storage/src/webext-storage.udl", "third_party/application-services/examples/merino-cli/src/main.rs", "third_party/application-services/examples/remote-settings-cli/src/dump/client.rs", "third_party/application-services/examples/tabs-sync/src/tabs-sync.rs", "third_party/application-services/moz.yaml", "third_party/application-services/tools/generate-rust-dashboards/src/component_config.rs", "third_party/application-services/tools/generate-rust-dashboards/src/config.rs", "third_party/application-services/tools/generate-rust-dashboards/src/main.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/event.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/mod.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/sync.rs", "third_party/application-services/tools/generate-rust-dashboards/src/schema.rs", "third_party/application-services/tools/generate-rust-dashboards/src/sql.rs", "third_party/application-services/tools/generate-rust-dashboards/src/team_config.rs", "toolkit/components/extensions/test/xpcshell/test_StorageSyncService.js", "toolkit/components/uniffi-bindgen-gecko-js/android/components/autofill/android/src/main/java/mozilla/appservices/autofill/autofill.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/logins/android/src/main/java/mozilla/appservices/logins/logins.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/merino/android/src/main/java/mozilla/appservices/merino/merino.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/tabs/android/src/main/java/mozilla/appservices/remotetabs/tabs.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustInitRustComponents.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTracing.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/config.toml", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "32b145772987224d21a080ba71746eb2d4bfaaf5", "git_parents": ["b519d650f57bc8d4507723f31f660a04d72dfdf6"], "node": "64d1da1c92a7f01cfa10909d9eea3d64bfc70779", "parents": ["871510f51054eb93d3ed826874ac397bf60b708f"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063091 - Don't show the dnsNotFound search CTA in subframes - r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319877\n", "files": ["browser/base/content/test/about/browser.toml", "browser/base/content/test/about/browser_aboutNetError_searchCTA_frame.js", "browser/base/content/test/about/head.js", "toolkit/actors/NetErrorParent.sys.mjs", "toolkit/content/metrics.yaml", "toolkit/content/net-error-card.mjs"], "git_node": "d124877e9012ffc26902730cb240a9760b77c6b3", "git_parents": ["32b145772987224d21a080ba71746eb2d4bfaaf5"], "node": "003b799702986d745be458c23d5b0ec7f967f543", "parents": ["64d1da1c92a7f01cfa10909d9eea3d64bfc70779"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2062451 - Add gtest for YUVBufferGenerator's chroma plane sizing. r=media-playback-reviewers,alwu\n\nInit() sizes its source buffer from the luma plane length, while the image\ncreators lay out two chroma planes of ceil(width / 2) x ceil(height / 2). Those\ntwo agree only when both dimensions are even.\n\nThe test asserts every chroma byte of the generated image holds the value Init()\nwrote, at odd and even sizes. It fails until the following patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317992\n", "files": ["dom/media/gtest/TestYUVBufferGenerator.cpp", "dom/media/gtest/moz.build"], "git_node": "720db4e284881146b7b3936b2f6580ba5b131257", "git_parents": ["d124877e9012ffc26902730cb240a9760b77c6b3"], "node": "ebeb621e210ce8cf40f35c19c676a4e239bfeb7f", "parents": ["003b799702986d745be458c23d5b0ec7f967f543"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2062451 - Size YUVBufferGenerator's source buffer for odd dimensions. r=media-playback-reviewers,alwu\n\nInit() derived the chroma region from the luma plane length, which matches the\nI420 chroma size only when both dimensions are even.\n\nBoth Init() and CreateI420Image now take the chroma size from gfx::ChromaSize(),\nthe helper PlanarYCbCrData::CbCrDataSize() already uses, so the buffer size and\nthe plane layout cannot disagree. That removes the four hand-rolled (x + 1) / 2\nexpressions this file carried, which is what let the two sides drift apart.\n\nPre-existing rather than a regression: the expression has been here at least\nsince it moved into this file in bug 1423253, and every current caller passes\neven dimensions, for which the old and new forms are numerically identical.\nVideoFrameConverterTest, MediaDataEncoder and VideoTrackEncoder pass unchanged.\n\nMakes the preceding test pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317993\n", "files": ["dom/media/gtest/YUVBufferGenerator.cpp"], "git_node": "ad7d7886b75411cc90cf4ae990efa9300e78b28b", "git_parents": ["720db4e284881146b7b3936b2f6580ba5b131257"], "node": "55d08f619268222010ddaea8aaeba3dc8db3145e", "parents": ["ebeb621e210ce8cf40f35c19c676a4e239bfeb7f"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996189 part 1 - Add AbstractGeneratorObject::create overload for modules. r=mgaudet\n\nThis removes `createModuleGenerator` and replaces it with a `create` method that\ndoesn't take an `AbstractFramePtr`. This is similar to the `create` version for\nfunctions.\n\nAs a drive-by change this also removes the `script` argument from the function version\nso these are consistent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319001\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/VMFunctions.cpp", "js/src/jit/VMFunctions.h", "js/src/vm/GeneratorObject.cpp", "js/src/vm/GeneratorObject.h"], "git_node": "03c8501bd7d29ad77f35e43349d360c16332d44b", "git_parents": ["ad7d7886b75411cc90cf4ae990efa9300e78b28b"], "node": "02e1c4c723d08acf15138144b3d2243d7a179607", "parents": ["55d08f619268222010ddaea8aaeba3dc8db3145e"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996189 part 2 - Support async module scripts in Warp. r=mgaudet\n\nThe resume machinery already works for top-level module scripts/frames so we just\nneed to add `JSOp::Generator` support.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319002\n", "files": ["js/src/jit-test/tests/generators/resume-modules.js", "js/src/jit/CodeGenerator.cpp", "js/src/jit/Ion.cpp", "js/src/jit/Lowering.cpp", "js/src/jit/MIROps.yaml", "js/src/jit/VMFunctionList-inl.h", "js/src/jit/VMFunctions.cpp", "js/src/jit/VMFunctions.h", "js/src/jit/WarpBuilder.cpp"], "git_node": "177abd3f2bb962fcc44e6fbbc413e1fc99fc10dc", "git_parents": ["03c8501bd7d29ad77f35e43349d360c16332d44b"], "node": "f92f316fee6525d00d014d9e98b708c5f84ec1b7", "parents": ["02e1c4c723d08acf15138144b3d2243d7a179607"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996189 part 3 - Generate MIR/LIR boilerplate for MGenerator. r=mgaudet\n\nThis required changing the arguments object operand to a `Value`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319003\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/LIROps.yaml", "js/src/jit/Lowering.cpp", "js/src/jit/MIR.h", "js/src/jit/MIROps.yaml", "js/src/jit/VMFunctions.cpp", "js/src/jit/VMFunctions.h", "js/src/jit/WarpBuilder.cpp"], "git_node": "b420528a4b5b7cb9204105e9f938c31c72ef3f76", "git_parents": ["177abd3f2bb962fcc44e6fbbc413e1fc99fc10dc"], "node": "28fe9bfd14f1d4391a29cc2b8257be4dcda600c9", "parents": ["f92f316fee6525d00d014d9e98b708c5f84ec1b7"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2064595. Back out the vendored jxl_simd Mac/x86_64 workaround ahead of the jxl-rs 0.6 upgrade. r=saschanaz,supply-chain-reviewers\n\nBacks out the local patch from bug 2043090 so that the jxl-rs 0.6 upgrade in the\nnext patch lands an unmodified copy of the published crates, and the workaround is\nre-applied on top as its own patch. Split this way so a reviewer can verify that\nthird_party/rust/jxl* is an exact copy of the crates.io tarballs plus exactly one\nlocal patch.\n\nNo behaviour change once the third patch of the series is applied (re-applying this patch).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319662\n", "files": ["Cargo.lock", "Cargo.toml", "supply-chain/config.toml", "third_party/rust/jxl_simd/Cargo.toml", "third_party/rust/jxl_simd/src/x86_64/avx.rs", "third_party/rust/jxl_simd/src/x86_64/avx512.rs"], "git_node": "8d56afaee49d384b7be7887bea98d4b92958af12", "git_parents": ["b420528a4b5b7cb9204105e9f938c31c72ef3f76"], "node": "e0e00cf436cf75205c87521ed7202575dad35abd", "parents": ["28fe9bfd14f1d4391a29cc2b8257be4dcda600c9"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2064595. Upgrade jxl-rs to 0.6.0. r=saschanaz,supply-chain-reviewers\n\nStraight `./mach vendor rust` after bumping image/rust/jxl/Cargo.toml, with no\nlocal modifications on top.\n\nDependency changes: none that affect vendoring. 0.6.0 adds an optional `shuttle`\ndependency, used only by upstream's own concurrency tests; it is not enabled, so it\ndoes not enter Cargo.lock or the vendor set.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319663\n", "files": ["Cargo.lock", "image/rust/jxl/Cargo.toml", "supply-chain/imports.lock", "third_party/rust/jxl/.cargo-checksum.json", "third_party/rust/jxl/.cargo_vcs_info.json", "third_party/rust/jxl/Cargo.lock", "third_party/rust/jxl/Cargo.toml", "third_party/rust/jxl/Cargo.toml.orig", "third_party/rust/jxl/README.md", "third_party/rust/jxl/src/api/color.rs", "third_party/rust/jxl/src/api/decoder.rs", "third_party/rust/jxl/src/api/inner/codestream_parser/frame_info.rs", "third_party/rust/jxl/src/api/inner/codestream_parser/mod.rs", "third_party/rust/jx