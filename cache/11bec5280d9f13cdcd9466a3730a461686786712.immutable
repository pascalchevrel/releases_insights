e-nova.toml", "toolkit/content/tests/widgets/chrome.toml", "toolkit/content/tests/widgets/test_panel_list_contextmenu.html", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "558d32dfa2521d7088b2b76049a9e0ade25b2d64", "git_parents": ["c424de15ab627203ec6cf95c9f11c3b0de69f51e"], "node": "3708b51d63b924aba8abae2d8581e7d59bd197f5", "parents": ["ebe26f54dc5ae8dbbe0a7c2ea5382136f4ee96a3"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062820 - Set RTCDataChannel-close.html and service-worker.tentative.https.html as intermittent r=aryx\n", "files": ["testing/web-platform/meta/fetch/local-network-access/service-worker.tentative.https.html.ini", "testing/web-platform/meta/webrtc/RTCDataChannel-worker-GC.html.ini"], "git_node": "2f5828d6df470ea7fd38afc980d6586c8a911f8d", "git_parents": ["558d32dfa2521d7088b2b76049a9e0ade25b2d64"], "node": "c69b68797c92ac242615e0b50c5bc9526583831c", "parents": ["3708b51d63b924aba8abae2d8581e7d59bd197f5"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062820 - Fix typo.\n", "files": ["testing/web-platform/meta/fetch/local-network-access/service-worker.tentative.https.html.ini"], "git_node": "b27db6923024c89fd4d667479f2f922c30218283", "git_parents": ["2f5828d6df470ea7fd38afc980d6586c8a911f8d"], "node": "8a0d772dd430216943d780859c5dcba7b62f48df", "parents": ["c69b68797c92ac242615e0b50c5bc9526583831c"], "tags": []}, {"author": "Jan-Erik Rediger \u003cjrediger@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062900 - Use a proper unique temporary directory for the tests r=fchasen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318055\n", "files": ["browser/components/backup/tests/xpcshell/test_AddonsBackupResource.js"], "git_node": "0342d999e5e124363a0796c1588c1343f88f347a", "git_parents": ["b27db6923024c89fd4d667479f2f922c30218283"], "node": "65a786829bbabfdf15a6b11f9a5340120d295173", "parents": ["8a0d772dd430216943d780859c5dcba7b62f48df"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062914 - Migrate verifyPageSummariesUITest UI test to the efficiency framework r=jajohnson\n\nPorts the Page summaries smoke test (TestRail 4036042) onto the ui/efficiency\nframework with full assertion parity: the Settings \"Page summaries\" entry, and on\nthe sub-screen the toolbar title, the Navigate-up button, and the Summarize pages /\nLearn more / Gestures / Shake to summarize options.\n\nAdds SettingsPageSummariesPage and SettingsPageSummariesSelectors, a\nSettings -\u003e Page summaries navigation edge, SettingsSelectors.PAGE_SUMMARIES_BUTTON,\nand plumbs shakeToSummarizeFeatureFlagEnabled through LaunchConfig/BaseTest so the\npage's launch dependency is explicit (default mirrors the app's Nimbus default).\n\nThe legacy test is annotated @Converted and keeps running until the replacement has\nbeen green on main for the configured cadence.\n\nThe UI test successfully passed 50x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=78054 | Try ]]\n\nAll efficiency UI test successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=78053 | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318091\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsPageSummariesTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/LaunchConfig.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsPageSummariesPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsPageSummariesSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsPageSummariesTest.kt"], "git_node": "d84878769ed7f72df2e7e4b4a1db6a0ab5b9adbe", "git_parents": ["0342d999e5e124363a0796c1588c1343f88f347a"], "node": "db7c88634941464455a95e77c06731d9ec9e4371", "parents": ["65a786829bbabfdf15a6b11f9a5340120d295173"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2062884 - Fix unused function templates in dom/media to fix -Wunused-template with clang 23 r=webrtc-reviewers,pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318317\n", "files": ["dom/media/AudioSegment.h", "dom/media/VideoUtils.h", "dom/media/platforms/agnostic/bytestreams/H264.cpp", "dom/media/webrtc/libwebrtcglue/VideoConduit.cpp"], "git_node": "88d5dab6e497360a77a4b285f2e7fcda3a23173b", "git_parents": ["d84878769ed7f72df2e7e4b4a1db6a0ab5b9adbe"], "node": "7605531b33658db391bb9395633003ff8c8da7f3", "parents": ["db7c88634941464455a95e77c06731d9ec9e4371"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056576 - Prevent .dialogStack to overlap DevTools toolbox when RDM is enabled. r=sfoster,desktop-theme-reviewers,tabbrowser-reviewers,jswinarton.\n\nDefine Devtools anchors that we can use when setting the dialogStack inset positions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316229\n", "files": ["browser/themes/shared/tabbrowser/content-area.css"], "git_node": "9efffa5d89c277548cd8344bffc8e8be667b62a7", "git_parents": ["88d5dab6e497360a77a4b285f2e7fcda3a23173b"], "node": "a9decca17f17dd6d949cc2c2eac3be413f0f1e1e", "parents": ["7605531b33658db391bb9395633003ff8c8da7f3"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 1758288 - Stop generating speculative loads inside the template element. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318063\n", "files": ["parser/html/nsHtml5TreeBuilderCppSupplement.h", "parser/htmlparser/tests/mochitest/file_bug1758288.sjs", "parser/htmlparser/tests/mochitest/mochitest.toml", "parser/htmlparser/tests/mochitest/test_bug1758288.html"], "git_node": "47db5ffd25bf411fb0acb661b24e5cd5c55e6ae5", "git_parents": ["9efffa5d89c277548cd8344bffc8e8be667b62a7"], "node": "3d99fcb95ba15b96fc5c5f133924e3f6ac0224ca", "parents": ["a9decca17f17dd6d949cc2c2eac3be413f0f1e1e"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2013619 - Add test. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D284741\n", "files": ["js/src/jit-test/tests/debug/bug2013619.js"], "git_node": "a4980b289dc47d75883b543c5af7fb94fdd7596e", "git_parents": ["47db5ffd25bf411fb0acb661b24e5cd5c55e6ae5"], "node": "867ef85c29f7648336aeacfeacd0c0a78036a06e", "parents": ["3d99fcb95ba15b96fc5c5f133924e3f6ac0224ca"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2059274 - Allow LNA from insecure pages for now r=necko-reviewers,android-reviewers,kershaw,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317783\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "modules/libpref/init/StaticPrefList.yaml", "netwerk/test/browser/browser_test_lna_insecure_context.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "c34e34838844ea6b7c607f161d4e0912d320f6a3", "git_parents": ["a4980b289dc47d75883b543c5af7fb94fdd7596e"], "node": "a1f2de780f574745cd41f5bf4b57ee941be96cee", "parents": ["867ef85c29f7648336aeacfeacd0c0a78036a06e"], "tags": []}, {"author": "Christian Grossegger \u003cchr.grossegger@gmail.com\u003e", "branch": "default", "desc": "Bug 1698140 - Don't claim PDF channels that have no browsing context in PdfStreamConverter. r=Gijs,calixte\n\nWhen a consumer opens a PDF channel that is not a docshell/document load (e.g.\nopening a PDF attachment from the Thunderbird compose window via nsIURILoader),\nthe channel has no targetBrowsingContext. getConvertedType currently still\nrewrites the channel's type to text/html so PDF.js can take over - but PDF.js\ncannot render without a DOM window, and the rewritten text/html type then breaks\nthe external-helper-app fallback. Bail out early so the load is handled normally\nas application/pdf and routed to the user's PDF handler.\n\nThis implements the targetBrowsingContext check suggested in comment 29.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304451\n", "files": ["toolkit/components/pdfjs/content/PdfStreamConverter.sys.mjs", "toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_no_browsing_context.js"], "git_node": "1f488676c1103015799abc6b6176554d9b94088a", "git_parents": ["c34e34838844ea6b7c607f161d4e0912d320f6a3"], "node": "310246c57ca832bf1831d116bb1d92973b4c56cb", "parents": ["a1f2de780f574745cd41f5bf4b57ee941be96cee"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062950 - Move default browser prompt gating into DefaultBrowserPromptManager. r=android-reviewers,alastun\n\n**Fix**\n* Folded the Nimbus enabled check into `canShowPrompt()` alongside the existing device-capable, not-already-default, and not-yet-shown checks, instead of gating on it separately in `OnboardingFragment`.\n* Add tests covering the enabled-flag case and the `maybePromptToSetAsDefaultBrowser` integration path.\n\n**Expected behaviour**\nThe set to default system prompt should be shown during onboarding when:\n  - the device is capable\n  - the onboarding card is the set to default card\n  - Firefox (current build) is not already default browser\n  - the set to default prompt is enabled\n  - the prompt has not already been shown during onboarding\n\n{F77595754}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318095\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/DefaultBrowserPromptManager.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/DefaultBrowserPromptManagerTest.kt"], "git_node": "c087e7d78e5db684cb2afd8745f739882f144443", "git_parents": ["1f488676c1103015799abc6b6176554d9b94088a"], "node": "245e52a3a4d50ec1f42c3a7c20d532d7696aa2eb", "parents": ["310246c57ca832bf1831d116bb1d92973b4c56cb"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2062206 - Restore ostream format state in SDP imageattr serialization (Coverity CID 1315812, 1315813, 1315814) r=webrtc-reviewers,bwc\n\nSRange/PRange/Set::Serialize set sticky std::fixed and std::setprecision\non the shared per-document stream without restoring it, corrupting the\nformatting of every later float in the same SDP. Save and restore flags\nand precision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317470\n", "files": ["dom/media/webrtc/sdp/SdpAttribute.cpp"], "git_node": "05b12e317113eb2e7aaf2ee51055757bf6f6164f", "git_parents": ["c087e7d78e5db684cb2afd8745f739882f144443"], "node": "ab7604b89ecb1ae00c09084b85cc54d591d1fd9b", "parents": ["245e52a3a4d50ec1f42c3a7c20d532d7696aa2eb"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060869 - Avoid using chrome-only features in more parts of the urlbar UI code. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317446\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/L10nCache.mjs", "browser/components/urlbar/content/UrlbarEventBufferer.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/unit/test_l10nCache.js"], "git_node": "b5ebe58efa49a0de807e11c0c85b7e98a31a3544", "git_parents": ["05b12e317113eb2e7aaf2ee51055757bf6f6164f"], "node": "f22ee4848e3698aec71f760e6c64a99377d44ddf", "parents": ["ab7604b89ecb1ae00c09084b85cc54d591d1fd9b"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 1939602 - Add dividers between GleanDebugButtons r=android-reviewers,tthibaud\n\nAdd dividers between GleanDebugButton entries in GleanDebugToolsScreen to make the individual debug actions easier to identify.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318133\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/gleandebugtools/ui/GleanDebugToolsScreen.kt"], "git_node": "963b8b89b0a735ab9f6f59cf0be905afd3630322", "git_parents": ["b5ebe58efa49a0de807e11c0c85b7e98a31a3544"], "node": "5426d61c8d46ca3de79a27b4e985be62d32a27b0", "parents": ["f22ee4848e3698aec71f760e6c64a99377d44ddf"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "no bug - doc: recommend the MyQOnly add-on for tracking review queues DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318410\n", "files": ["docs/contributing/reviewer_checklist.md", "docs/contributing/reviews.md"], "git_node": "f8f4403b7261ea9dbbfba9c36ed22be96f9f94d7", "git_parents": ["963b8b89b0a735ab9f6f59cf0be905afd3630322"], "node": "f90bb623e4acb3375e88564702c0b5f8df7c1fba", "parents": ["5426d61c8d46ca3de79a27b4e985be62d32a27b0"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1698140 - Don't claim PDF channels that have no browsing context in PdfStreamConverter. r=Gijs,calixte\" for causing failures at browser_pdfjs_no_browsing_context.js. IGNORE BAD COMMIT MESSAGES\n\nThis reverts commit 1f488676c1103015799abc6b6176554d9b94088a.\n", "files": ["toolkit/components/pdfjs/content/PdfStreamConverter.sys.mjs", "toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_no_browsing_context.js"], "git_node": "65e6250c7bfab612e62b0872454338a85374214d", "git_parents": ["f8f4403b7261ea9dbbfba9c36ed22be96f9f94d7"], "node": "304ad2e0da160af40a79b279b3cd172f17317bd9", "parents": ["f90bb623e4acb3375e88564702c0b5f8df7c1fba"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060963 - Try to avoid recreating fontgroup in offscreen canvas worker if relevant attributes haven't changed. r=gfx-reviewers,lsalzman\n\nEventually we should use a (thread-safe version of) nsFontCache or similar, but as an interim\nmitigation, this addresses the case where a site simply repeats the same `ctx.font = ...` setting\nbefore every individual fillText or measureText call. We don't need to create a new fontGroup\nin that case, if the user font set hasn't changed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318101\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h"], "git_node": "e3a54fe72902f7fd02b44ba91a680da0950ad067", "git_parents": ["65e6250c7bfab612e62b0872454338a85374214d"], "node": "a5e6bb5f7b7e75315fca98f1dd6f42d4a1460ccc", "parents": ["304ad2e0da160af40a79b279b3cd172f17317bd9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061668 - Don't let the mouseup that follows a contextmenu event dismiss the panel-list it opened. r=mstriemer\n\nA contextmenu event is dispatched during the button press on Linux and macOS, so a\npanel-list opened from one is already an auto popover when the button is released,\nand that release light-dismisses it. At the pointerdown no auto popover was open\nyet, so the document's popover pointerdown target was never recorded; at the\npointerup the release target has no popover ancestor either, so the two match and\nHidePopoverStackUntil hides the whole auto popover stack. Since that happens\nnatively, hide() never runs and the open attribute stays set, so the element state\ndesyncs from the popover state.\n\nOpening as a manual popover keeps the panel in the top layer but out of the auto\npopover stack, so light dismiss leaves it alone. What's worth checking is that the\nlisteners addHideListeners() already installs cover everything light dismiss did:\noutside mousedown, Escape, focus changes, scroll, resize and window blur.\n\nThe test drives the whole sequence through the widget path, since a trusted\ncontextmenu event is a PointerEvent and constructing one as a MouseEvent asserts\nin debug builds. That also makes the release reproduce the dismissal, so the\nassertions that the panel survives it fail without the fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317046\n", "files": ["toolkit/content/tests/widgets/chrome-nova.toml", "toolkit/content/tests/widgets/chrome.toml", "toolkit/content/tests/widgets/test_panel_list_contextmenu.html", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "3c1c3307693bfbd5b9c81aec72fd84cb50f5a78d", "git_parents": ["e3a54fe72902f7fd02b44ba91a680da0950ad067"], "node": "239963c4cc77c67c72101a3244b8fc8d608a9049", "parents": ["a5e6bb5f7b7e75315fca98f1dd6f42d4a1460ccc"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062246 - Log UTILITYACTOR for ChildProcessLifecycle, r=ipc-reviewers,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317941\n", "files": ["ipc/glue/GeckoChildProcessHost.h", "ipc/glue/UtilityProcessManager.cpp", "ipc/glue/UtilityProcessManager.h"], "git_node": "9eb63285c6638f67642f5d6ad8ab2eb7e44dd904", "git_parents": ["3c1c3307693bfbd5b9c81aec72fd84cb50f5a78d"], "node": "580448758cefcca066e76cab69836ad333768d81", "parents": ["239963c4cc77c67c72101a3244b8fc8d608a9049"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2063215 - Remove unused AppWindow::mChromeFlagsFrozen member r=emilio\n\nThe member was left behind when the chrome flags were made immutable in\nbug 2060396 (D316217), which removed its last reader and writer. It is\nnever initialized either, so Coverity flags it as an uninitialized\nmember (CID 1700059).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318402\n", "files": ["xpfe/appshell/AppWindow.h"], "git_node": "f96e7cffcb33b2c42ec012377e315550581da892", "git_parents": ["9eb63285c6638f67642f5d6ad8ab2eb7e44dd904"], "node": "088ecd000cb16021dfca9b4e7e41b6b19b4ddcb5", "parents": ["580448758cefcca066e76cab69836ad333768d81"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2062042 - Don't use branded toolbarbutton hover / active colors in the native theme. r=mstriemer,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317326\n", "files": ["toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/toolbarbutton.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbarbutton.tokens.json"], "git_node": "da592e6e454fe31ad3b8551056f4bafa1ef82c45", "git_parents": ["f96e7cffcb33b2c42ec012377e315550581da892"], "node": "e8fabf6443a9283439cb4cf3361bd611de4865f8", "parents": ["088ecd000cb16021dfca9b4e7e41b6b19b4ddcb5"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2060624 - part 1 - Make TranslationMenuItem reusable r=android-reviewers,matt-tighe\n\nThis was previously a private function available only in the main menu.\nExtracted it to a public function to ensure the custom tab menu can use it also.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318141\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MoreSettingsSubmenu.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/TranslationMenuItem.kt"], "git_node": "b373bc954e8339ae1ce4e6ecfaf12a281575bfa5", "git_parents": ["da592e6e454fe31ad3b8551056f4bafa1ef82c45"], "node": "534c45771f21b36129c97ac5f280af145d70425b", "parents": ["e8fabf6443a9283439cb4cf3361bd611de4865f8"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2060624 - part 2 - Add \"Translate page\" to custom tabs' menu r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318142\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/CustomTabMenu.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/TranslationMenuItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuNavigationMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/TranslationsDialogBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/TranslationsDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/TranslationsDialogMiddleware.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuNavigationMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/translations/TranslationsDialogBindingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/translations/TranslationsDialogMiddlewareTest.kt"], "git_node": "888af351d3e3936a5093cd52a8d52dcab918a0fc", "git_parents": ["b373bc954e8339ae1ce4e6ecfaf12a281575bfa5"], "node": "323547867b3daace8c23e9a4d20144a5973d04cb", "parents": ["534c45771f21b36129c97ac5f280af145d70425b"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2060624 - part 3 - Add \"Summarize page\" to custom tabs' menu r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318143\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/CustomTabMenu.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuDialogMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuNavigationMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/summarization/SummarizationFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/summarization/SummarizationNavigator.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/summarization/SummarizationStoreViewModel.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ext/TabSessionState.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuDialogMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuNavigationMiddlewareTest.kt"], "git_node": "5c37c8a62eabca50acd0c8ef604118bcf3d3cfa5", "git_parents": ["888af351d3e3936a5093cd52a8d52dcab918a0fc"], "node": "25199570036529637fcbb9fd77f5ed0adb78dbc6", "parents": ["323547867b3daace8c23e9a4d20144a5973d04cb"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054983 - Remove vpio-forcelist from cubeb-coreaudio-rs. r=cubeb-reviewers,padenot\n\nWith the forcelist we set up a VPIO unit in bypass mode when no input\nprocessing params are configured.\n\nWithout the forcelist we instead use a regular HALOutput unit when no input\nprocessing params are configured.\n\nThe forcelist matches only the builtin mic.\n\nOn an M2 Macbook Pro VPIO in bypass has similar volume to VPIO not in bypass,\nbut with no AEC.\n\nOn M3, M4 and M5 Macbook Pros VPIO in bypass instead has similar volume to\nHALOutput units. This makes the forcelist irrelevant on modern Macs.\n\nAt the same time the forcelist prevents some use cases - those where a site only\nrequests non-processing audio capture.\n\nThis patch removes the forcelist, making older Macbooks behave like modern\nMacbooks, and enabling non-processing use cases with the builtin mic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318409\n", "files": ["toolkit/library/rust/shared/Cargo.toml"], "git_node": "5bce419cbb6d2396cd9046a6780cc18320d5a9aa", "git_parents": ["5c37c8a62eabca50acd0c8ef604118bcf3d3cfa5"], "node": "d1dbd1028c3eec4af9790e77faaf1bd1250a987e", "parents": ["25199570036529637fcbb9fd77f5ed0adb78dbc6"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062351 - Remove outer window gaps of floating chrome for nova r=desktop-theme-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317821\n", "files": ["browser/themes/shared/browser-shared.css", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "338bed96dde9bc56873e1b6342baf0d6d0d3a589", "git_parents": ["5bce419cbb6d2396cd9046a6780cc18320d5a9aa"], "node": "1ceeec7006740d33342c94cdd90c79745f01d57e", "parents": ["d1dbd1028c3eec4af9790e77faaf1bd1250a987e"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940240 - Part 1: Centralize reduced-precision timestamp conversion on Performance. r=canova\n\nThis moves the precision reduction code into a place more appropriate for non-LCP users.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309591\n", "files": ["dom/performance/LargestContentfulPaint.cpp", "dom/performance/Performance.cpp", "dom/performance/Performance.h"], "git_node": "49261c7747c33e09d9ee9ab5c3f6d42ace6b4d93", "git_parents": ["338bed96dde9bc56873e1b6342baf0d6d0d3a589"], "node": "d4d1bab2f584ed919f505819678f19c856a1ef60", "parents": ["1ceeec7006740d33342c94cdd90c79745f01d57e"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940240 - Part 2: Compute rect and region areas in 64-bit to avoid overflow. r=gfx-reviewers,bradwerth,lsalzman\n\nBaseRect::Area(), BaseRectAbsolute::Area() and nsRegion::Area() multiplied width by height in 32-bit arithmetic, which overflows for large integer rects (well below screen-area sizes once expressed in app units). Widen to 64-bit before multiplying for integer coordinate types.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309592\n", "files": ["gfx/2d/BaseRect.h", "gfx/2d/RectAbsolute.h", "gfx/src/nsRegion.cpp", "gfx/tests/gtest/TestRect.cpp", "gfx/tests/gtest/TestRegion.cpp"], "git_node": "c419214bb9ed840765a48696bfe07b551f50a48f", "git_parents": ["49261c7747c33e09d9ee9ab5c3f6d42ace6b4d93"], "node": "47a7b09d5bf0e052b5dacfd1d3d557bc54390571", "parents": ["d4d1bab2f584ed919f505819678f19c856a1ef60"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940240 - Part 3: Implement the Container Timing API behind a pref. r=smaug,webidl,saschanaz\n\nAdds the PerformanceContainerTiming interface and the processing model from the spec on PerformanceMainThread. Each element caches its nearest containertiming ancestor, so resolving an element's container roots at paint time is O(1).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309593\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/Element.cpp", "dom/base/Element.h", "dom/base/nsGlobalWindowInner.cpp", "dom/base/nsINode.cpp", "dom/base/nsPIDOMWindow.h", "dom/html/nsGenericHTMLElement.cpp", "dom/html/nsGenericHTMLElement.h", "dom/performance/PerformanceContainerTiming.cpp", "dom/performance/PerformanceContainerTiming.h", "dom/performance/PerformanceMainThread.cpp", "dom/performance/PerformanceMainThread.h", "dom/performance/PerformanceObserver.cpp", "dom/performance/moz.build", "dom/webidl/HTMLElement.webidl", "dom/webidl/PerformanceContainerTiming.webidl", "dom/webidl/moz.build", "modules/libpref/init/StaticPrefList.yaml", "xpcom/ds/StaticAtoms.py"], "git_node": "51568e3f54156407b174efe2840988b08cac0f7d", "git_parents": ["c419214bb9ed840765a48696bfe07b551f50a48f"], "node": "503b6f644252ba7da2275679214150adf46a583b", "parents": ["47a7b09d5bf0e052b5dacfd1d3d557bc54390571"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940240 - Part 4: Record container-timing paints from the layout paint pipeline. r=layout-reviewers,emilio\n\nCalls into ContainerTimingHelpers when images, backgrounds, text, canvas and video paint, and finalizes the accumulated entries at the end of each paint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309594\n", "files": ["layout/base/PresShell.cpp", "layout/generic/nsHTMLCanvasFrame.cpp", "layout/generic/nsImageFrame.cpp", "layout/generic/nsVideoFrame.cpp", "layout/painting/nsDisplayList.cpp", "layout/svg/SVGImageFrame.cpp"], "git_node": "26a59da95256d3b4be701b1514626358d84108d2", "git_parents": ["51568e3f54156407b174efe2840988b08cac0f7d"], "node": "5b2d2c8b6d0439caaa3d9f9e3caae41e557a87ce", "parents": ["503b6f644252ba7da2275679214150adf46a583b"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940240 - Part 5: Enable container-timing web platform tests. r=canova\n\nEnables the dom.enable_container_timing pref for the upstream container-timing WPTs and adds Gecko tests for a number of scenarios and canvas/video containers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309595\n", "files": ["testing/web-platform/meta/container-timing/tentative/__dir__.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-and-ignore-on-img-itself.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-and-ignore-on-text-itself.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-body-with-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-img-already-loaded.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-img-itself.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-observe-after-paint-with-buffering.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-observe-after-paint-without-buffering.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-observe-no-paint.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-text-itself.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-two-overlapping-imgs.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-with-child-ignore-and-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-with-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-with-child-text.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-with-ignore-and-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/iframe-isolation-cross-origin.sub.html.ini", "testing/web-platform/meta/container-timing/tentative/iframe-isolation-same-origin.html.ini", "testing/web-platform/meta/container-timing/tentative/ignore-with-containertiming-and-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/img-not-child-of-container-timing.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-and-ignore-on-img.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-and-ignore-on-text.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-child-img-with-ignore.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-on-img-without-ignore.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-with-ignore.html.ini", "testing/web-platform/meta/container-timing/tentative/pseudo-background-image-before-in-container-timing.html.ini", "testing/web-platform/meta/container-timing/tentative/pseudo-with-image-content-in-container-timing.html.ini", "testing/web-platform/meta/container-timing/tentative/pseudo-with-text-content-in-container-timing.html.ini", "testing/web-platform/tests/container-timing/tentative/containertiming-attribute-reflection.html", "te