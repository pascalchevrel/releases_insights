ine/mod.rs", "third_party/rust/jxl/src/render/simple_pipeline/run_stage.rs", "third_party/rust/jxl/src/render/simple_pipeline/save.rs", "third_party/rust/jxl/src/render/stages/blending.rs", "third_party/rust/jxl/src/render/stages/chroma_upsample.rs", "third_party/rust/jxl/src/render/stages/convert.rs", "third_party/rust/jxl/src/render/stages/epf/epf0.rs", "third_party/rust/jxl/src/render/stages/epf/epf1.rs", "third_party/rust/jxl/src/render/stages/epf/epf2.rs", "third_party/rust/jxl/src/render/stages/epf/test.rs", "third_party/rust/jxl/src/render/stages/extend.rs", "third_party/rust/jxl/src/render/stages/from_linear.rs", "third_party/rust/jxl/src/render/stages/gaborish.rs", "third_party/rust/jxl/src/render/stages/nearest_neighbor.rs", "third_party/rust/jxl/src/render/stages/noise.rs", "third_party/rust/jxl/src/render/stages/patches.rs", "third_party/rust/jxl/src/render/stages/premultiply_alpha.rs", "third_party/rust/jxl/src/render/stages/splines.rs", "third_party/rust/jxl/src/render/stages/spot.rs", "third_party/rust/jxl/src/render/stages/to_linear.rs", "third_party/rust/jxl/src/render/stages/upsample.rs", "third_party/rust/jxl/src/render/stages/xyb.rs", "third_party/rust/jxl/src/render/stages/ycbcr.rs", "third_party/rust/jxl/src/render/test.rs", "third_party/rust/jxl/src/tests/api.rs", "third_party/rust/jxl/src/tests/compare_incremental.rs", "third_party/rust/jxl/src/tests/compare_parallel.rs", "third_party/rust/jxl/src/tests/decode.rs", "third_party/rust/jxl/src/tests/macros.rs", "third_party/rust/jxl/src/tests/mod.rs", "third_party/rust/jxl/src/util/atomic_refcell/internal.rs", "third_party/rust/jxl/src/util/atomic_refcell/mod.rs", "third_party/rust/jxl/src/util/mod.rs", "third_party/rust/jxl/src/util/per_thread_storage.rs", "third_party/rust/jxl/src/util/sync.rs", "third_party/rust/jxl_macros/.cargo-checksum.json", "third_party/rust/jxl_macros/.cargo_vcs_info.json", "third_party/rust/jxl_macros/Cargo.lock", "third_party/rust/jxl_macros/Cargo.toml", "third_party/rust/jxl_macros/Cargo.toml.orig", "third_party/rust/jxl_macros/README.md", "third_party/rust/jxl_simd/.cargo-checksum.json", "third_party/rust/jxl_simd/.cargo_vcs_info.json", "third_party/rust/jxl_simd/Cargo.lock", "third_party/rust/jxl_simd/Cargo.toml", "third_party/rust/jxl_simd/Cargo.toml.orig", "third_party/rust/jxl_simd/README.md", "third_party/rust/jxl_transforms/.cargo-checksum.json", "third_party/rust/jxl_transforms/.cargo_vcs_info.json", "third_party/rust/jxl_transforms/Cargo.lock", "third_party/rust/jxl_transforms/Cargo.toml", "third_party/rust/jxl_transforms/Cargo.toml.orig", "third_party/rust/jxl_transforms/README.md"], "git_node": "a81f63e62e89182c581ff391d1259566ebd8a641", "git_parents": ["8d56afaee49d384b7be7887bea98d4b92958af12"], "node": "ede0622a963478a38b74adfdf73afe2a8b4470de", "parents": ["e0e00cf436cf75205c87521ed7202575dad35abd"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2064595. Re-apply the vendored jxl_simd Mac/x86_64 workaround on top of jxl-rs 0.6.0. r=saschanaz,supply-chain-reviewers\n\nRe-lands the local patch backed out in the first patch of this series, now on top\nof the unmodified 0.6.0 import. Upstream did not touch src/x86_64/avx.rs or\nsrc/x86_64/avx512.rs between 0.5.1 and 0.6.0, so this is the same patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319666\n", "files": ["Cargo.lock", "Cargo.toml", "supply-chain/config.toml", "third_party/rust/jxl_simd/Cargo.toml", "third_party/rust/jxl_simd/src/x86_64/avx.rs", "third_party/rust/jxl_simd/src/x86_64/avx512.rs"], "git_node": "33829f650c7729d7157f0aa4611a6aa7b6f7be21", "git_parents": ["a81f63e62e89182c581ff391d1259566ebd8a641"], "node": "3c2868d238cae497988c2128f7732385ac08133a", "parents": ["ede0622a963478a38b74adfdf73afe2a8b4470de"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2064595. Pass None for the new parallel-runner argument at the jxl-rs flush_pixels and process call sites. r=saschanaz\n\njxl 0.6.0 adds an Option\u003c&mut dyn JxlParallelRunner\u003e parameter to\nJxlDecoderInner::process and ::flush_pixels, which breaks the three call sites in\nimage/rust/jxl/src/decoder.rs.\n\nWe pass None to keep the same behaviour:: with None jxl-rs uses its\nown SequentialRunner, and 0.5.1 had no runner concept at all, so decoding stays\nsingle-threaded exactly as before. Supplying a real runner to use multithreaded\ndecoding is a separate change in a future patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319667\n", "files": ["image/rust/jxl/src/decoder.rs"], "git_node": "f39d0f94e1cc4ae2deb7da49f2891b0a6a20244c", "git_parents": ["33829f650c7729d7157f0aa4611a6aa7b6f7be21"], "node": "cf2b8345b618ddee29e7bc41250ccf9b2c1d55ea", "parents": ["3c2868d238cae497988c2128f7732385ac08133a"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2064595. Adjust fuzz for jxl-rs 0.6.0 upgrade. r=saschanaz\n\njxl-rs 0.6.0 changed the dithering algorithm that is used for u8 output so that basically every pixel gets a +-1 adjustment. This is the same dither algorithm that libjxl adopted.\n\njxl-rs made this change in https://github.com/libjxl/jxl-rs/commit/f694be56506708a6805eac62fa09995a4a58d609.\n\nlibjxl changed the dithering in https://github.com/libjxl/libjxl/commit/2a4f12b6ef22672e0f4a399df3b8589856ebace2 with further fixes/tweaks in https://github.com/libjxl/libjxl/commit/a5ee1a616f371e62521892ea35cbc1856231121f.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319668\n", "files": ["testing/web-platform/meta/jpegxl/cmyk-basic-conversion-reftest.html.ini", "testing/web-platform/meta/jpegxl/patches-reftest.html.ini", "testing/web-platform/tests/jpegxl/basic-decode-reftest.html", "testing/web-platform/tests/jpegxl/cmyk-basic-conversion-reftest.html", "testing/web-platform/tests/jpegxl/layers-basic-reftest.html", "testing/web-platform/tests/jpegxl/patches-reftest.html", "testing/web-platform/tests/jpegxl/progressive-1.html", "testing/web-platform/tests/jpegxl/progressive-2.html", "testing/web-platform/tests/jpegxl/progressive-3.html", "testing/web-platform/tests/jpegxl/sdr-alpha-reftest.html"], "git_node": "d12d8165951ae4152e6b9a7d6e418f7f269626d5", "git_parents": ["f39d0f94e1cc4ae2deb7da49f2891b0a6a20244c"], "node": "6f172116de56f55725297ba3aafbff4f4002a891", "parents": ["cf2b8345b618ddee29e7bc41250ccf9b2c1d55ea"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2026697 - [marionette] Return the qualified name for the \"WebDriver:GetElementTagName\" command. r=jdescottes\n\nFollowing the resolution of https://github.com/w3c/webdriver/issues/1956, the\n\"Get Element Tag Name\" command has to return the element's qualified name\ninstead of lowercasing the `tagName` property:\n\n  elem.prefix === null ? elem.localName : `${elem.prefix}:${elem.localName}`\n\nHTML elements in HTML documents keep returning lowercase names (the HTML parser\nalready lowercases their local name), so unlike the previous attempt in this bug\nthis does not change the long standing behavior for regular HTML content. Only\nelements whose local name or prefix isn't lowercase are affected, eg. SVG\ncamel case elements (`linearGradient`, `textPath`), prefixed elements in XML\ndocuments, and elements created via `document.createElementNS()`.\n\nThe wdspec tests landed already via bug 2053646, so all the `expected: FAIL`\nentries in the expectation file become passes and the file gets removed.\n\nNote: no local wdspec run was possible in the environment used to prepare this\npatch, so the expectation update should be confirmed by a try run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319422\n", "files": ["remote/marionette/actors/MarionetteCommandsChild.sys.mjs", "remote/marionette/driver.sys.mjs", "testing/web-platform/meta/webdriver/tests/classic/get_element_tag_name/get.py.ini"], "git_node": "501d038d7a16bbde5b44554cf926a8489c8974a9", "git_parents": ["d12d8165951ae4152e6b9a7d6e418f7f269626d5"], "node": "6751f34fb4c55b904868cd0265900ef9b2e43bd2", "parents": ["6f172116de56f55725297ba3aafbff4f4002a891"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064693 - Update PDF.js to e051279385c5cf141935037b340e757081052990 r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319763\n", "files": ["toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.css", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml", "toolkit/locales/en-US/toolkit/pdfviewer/viewer.ftl"], "git_node": "2c41ee9172f29607228ce087cb7f32533bd68161", "git_parents": ["501d038d7a16bbde5b44554cf926a8489c8974a9"], "node": "ea47d2ebd3d5ef13b4b9b6cffc725e82d38f8e65", "parents": ["6751f34fb4c55b904868cd0265900ef9b2e43bd2"], "tags": []}, {"author": "Bryan Olsson \u003cbolsson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064914 - add plural selector to Fluent string newtab-stocks-watchlist-full, r=flod,fluent-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319933\n", "files": ["browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "2aae576657906106e192f61ecb83cf86ae78c42f", "git_parents": ["2c41ee9172f29607228ce087cb7f32533bd68161"], "node": "9fd384256b60d07629975e6d6f6614871bcd5502", "parents": ["ea47d2ebd3d5ef13b4b9b6cffc725e82d38f8e65"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2056071 (part 1) - Remove app-services BridgedEngine. r=bdk,skhamis,sync-reviewers\n\nThe mozilla-central side of the consolidation of SyncEngine and BridgedEngine.\nMoves to a duck-typed bridged engine (which should be fixed), changes to how\nthe last-sync time is managed.\n\nPaired with https://github.com/mozilla/application-services/pull/7483, which\nis being vendored in part 2.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312903\n", "files": ["services/interfaces/moz.build", "services/interfaces/mozIBridgedSyncEngine.idl", "services/sync/modules/bridged_engine.sys.mjs", "services/sync/modules/engines/tabs.sys.mjs", "services/sync/tests/unit/test_bridged_engine.js", "services/sync/tests/unit/test_extension_storage_engine.js", "services/sync/tests/unit/test_tab_quickwrite.js", "toolkit/components/extensions/test/xpcshell/test_StorageSyncService.js", "toolkit/components/uniffi-bindgen-gecko-js/config.toml"], "git_node": "811ad42741a6965b23b78a57b7586ea5a87b88ec", "git_parents": ["2aae576657906106e192f61ecb83cf86ae78c42f"], "node": "7e26839f589f5c4456990def3871e659945efe72", "parents": ["9fd384256b60d07629975e6d6f6614871bcd5502"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2056071 (part 2) - Vendor application-services rev 7c34b8930543e7c34b89. r=skhamis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319670\n", "files": ["third_party/application-services/components/autofill/src/autofill.udl", "third_party/application-services/components/autofill/src/sync/bridge.rs", "third_party/application-services/components/autofill/src/sync/engine.rs", "third_party/application-services/components/example/src/error.rs", "third_party/application-services/components/fxa-client/src/state_machine/transitions.rs", "third_party/application-services/components/logins/Cargo.toml", "third_party/application-services/components/logins/src/db.rs", "third_party/application-services/components/logins/src/encryption.rs", "third_party/application-services/components/logi