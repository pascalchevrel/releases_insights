SLTokensCache.h", "netwerk/base/moz.build", "netwerk/base/ssl_tokens_cache/Cargo.toml", "netwerk/base/ssl_tokens_cache/README.md", "netwerk/base/ssl_tokens_cache/cbindgen.toml", "netwerk/base/ssl_tokens_cache/moz.build", "netwerk/base/ssl_tokens_cache/src/lib.rs", "netwerk/ipc/PSocketProcess.ipdl", "netwerk/ipc/SocketProcessChild.cpp", "netwerk/ipc/SocketProcessChild.h", "netwerk/metrics.yaml", "netwerk/test/gtest/TestSSLTokensCache.cpp", "netwerk/test/marionette/manifest.toml", "netwerk/test/marionette/ssl_tokens_cache_mixin.py", "netwerk/test/marionette/test_ssl_token_cache_clearing_bugs.py", "netwerk/test/marionette/test_tls_token_resumption_after_restart.py", "netwerk/test/unit/test_ssl_token_cache_persist.js", "netwerk/test/unit/test_ssl_token_cache_persist_disabled.js", "toolkit/library/rust/moz.build", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs", "tools/lint/clippy.yml", "tools/netwerk/decode_ssl_tokens_cache.py"], "git_node": "4c997c8293adae37c48c729c0136206b6a2fe9c6", "git_parents": ["8e11964e2f32b2fe7f0bf96c6c1eb7e0c3afe6ea"], "node": "9971c230065c1fb7bfa869a70b946c890406e578", "parents": ["4abb7e7fcd711bf9ab865d77857e6d751508ba2a"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065184 - mozlog: print both stdout and stderr from minidump-stackwalk r=mozbase-reviewers,ahal\n\nNot printing stdout if stderr is present means a single, benign warning\ncan mask your nice, helpful stack trace!\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320154\n", "files": ["testing/mozbase/mozlog/mozlog/formatters/machformatter.py", "testing/mozbase/mozlog/mozlog/formatters/tbplformatter.py"], "git_node": "62cf9d6795cc83e2542dd1872423f80ae2682016", "git_parents": ["4c997c8293adae37c48c729c0136206b6a2fe9c6"], "node": "6e82abc6785852be8acdd9d09e839c815dbcb7bd", "parents": ["9971c230065c1fb7bfa869a70b946c890406e578"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2049252 - Update source docs with the new captive portal domain r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320345\n", "files": ["netwerk/docs/captive_portals.md", "netwerk/docs/connectivity_checking.md"], "git_node": "dc30e4f50072f71a71ade013ebf2d54ffb8e518b", "git_parents": ["62cf9d6795cc83e2542dd1872423f80ae2682016"], "node": "b6383f7ac6bfd541a59879b74502dbd26542b33e", "parents": ["6e82abc6785852be8acdd9d09e839c815dbcb7bd"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2064683 - Collapse all chrome UI flags into CHROME_TOOLBAR. r=firefox-desktop-core-reviewers ,extension-reviewers,desktop-theme-reviewers,urlbar-reviewers,mkennedy,sthompson,dao,mossop,robwu\n\nKeep CHROME_TOOLBAR / window.toolbar.visible to distinguish popup-like\nwindows, and remove the rest, we really don't need all combinations.\n\nThe only window that had weird mixes are taskbar tabs, which already had\ntheir own attribute to do this. Gecko doesn't need to know about all the\nspecific toolbars.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319805\n", "files": ["browser/base/content/browser-init.js", "browser/base/content/browser-profiles.js", "browser/base/content/browser.js", "browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/BrowserGlue.sys.mjs", "browser/components/extensions/test/browser/browser_ext_windows_create.js", "browser/components/preferences/main.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_nonbrowser.js", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser_495495.js", "browser/components/taskbartabs/TaskbarTabsWindowManager.sys.mjs", "browser/components/taskbartabs/test/browser/browser_taskbarTabs_chromeTest.js", "browser/themes/shared/browser-shared.css", "browser/themes/shared/urlbar.css", "dom/base/BarProps.cpp", "toolkit/components/browser/nsIWebBrowserChrome.idl", "toolkit/components/passwordmgr/LoginHelper.sys.mjs", "toolkit/components/windowwatcher/nsWindowWatcher.cpp", "toolkit/components/windowwatcher/test/browser_new_content_window_chromeflags.js", "toolkit/components/windowwatcher/test/browser_popup_features_shift_click.js", "toolkit/components/windowwatcher/test/head.js", "toolkit/mozapps/update/UpdateService.sys.mjs", "toolkit/themes/shared/global-shared.css", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/nsAppShellService.cpp"], "git_node": "240636d9a5e20dfc225617dcb4716b6adef37a3a", "git_parents": ["dc30e4f50072f71a71ade013ebf2d54ffb8e518b"], "node": "717acfd9bbfbc0e223e11da89faa148ef36689bf", "parents": ["b6383f7ac6bfd541a59879b74502dbd26542b33e"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2065371. Record allowable fuzz for jpegxl/wide-gamut-adobe-rgb.html in the file itself r=saschanaz\n\nRecording it in the file means every browser gets the same fuzz level and our result is green on the wpt.fyi tracker.\n\nThe jxl and the png decode to byte identical pixels before color management. What differs is which sRGB profile we hand qcms. The png has an sRGB chunk so it gets the canned qcms sRGB profile, whose white point comes from a 6504K colour temperature and works out to 0.312714, 0.329119. The jxl reports sRGB as cicp code points so we build the profile with qcms_profile_create_cicp, which uses the exact D65 of 0.3127, 0.3290. Same transfer curve either way, but those last decimals give slightly different colorants, so about 3% of the pixels come out one off in a channel once a real display profile is involved. The image is painted scaled down from 924x1386 to about 400x600, which spreads that over more pixels and lets the rounding reach two.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320333\n", "files": ["testing/web-platform/meta/jpegxl/wide-gamut-adobe-rgb.html.ini", "testing/web-platform/tests/jpegxl/wide-gamut-adobe-rgb.html"], "git_node": "57c6cf799a77d96f94946dde1140cbca75918a60", "git_parents": ["240636d9a5e20dfc225617dcb4716b6adef37a3a"], "node": "c3b429065f687c3bee297abd915afc12581e38d4", "parents": ["717acfd9bbfbc0e223e11da89faa148ef36689bf"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2062332 - Make MruCache 2-way associative. r=layout-reviewers,jfkthame\n\nSo that we can at least hold two elements at a time with the same high\nhash bits. Otherwise if you get unlucky you get trashing in reasonable\ntest-cases like the thai-reflow.html perftest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320099\n", "files": ["dom/canvas/CanvasRenderingContext2D.h", "gfx/thebes/FontPaletteCache.h", "gfx/thebes/gfxHarfBuzzShaper.h", "gfx/thebes/gfxTextRun.cpp", "intl/lwbrk/LineBreakCache.h", "layout/painting/nsImageRenderer.cpp", "mfbt/MruCache.h", "netwerk/dns/nsEffectiveTLDService.h", "xpcom/tests/gtest/TestMruCache.cpp"], "git_node": "e2ccd3e02a35be991ba6f0bb174059ff5506eafb", "git_parents": ["57c6cf799a77d96f94946dde1140cbca75918a60"], "node": "824a635bbc5488bedf5f648a82516ecedab5e4ac", "parents": ["c3b429065f687c3bee297abd915afc12581e38d4"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": ["dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserParent.cpp"], "git_node": "e849fa63ffd53ab1cec382d2dcc022a0f83941c7", "git_parents": ["e2ccd3e02a35be991ba6f0bb174059ff5506eafb", "2916f047242de012d1aa0c572be9e5239644cc48"], "node": "6c5f049d9be818b5da68cdfc99f028a9d5e9268a", "parents": ["824a635bbc5488bedf5f648a82516ecedab5e4ac", "8e966e6c894ac4f44ad60e2232f1e810f2256113"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064761 - Update metadata for html/canvas/element/manual/draw-element-image/inline-drawable.tentative.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320370\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/inline-drawable.tentative.html.ini"], "git_node": "fd81262844f7f2891801131f01c74dbaf6e4881b", "git_parents": ["e849fa63ffd53ab1cec382d2dcc022a0f83941c7"], "node": "789ed5a00201c351629054afe4a7bdf304f251a1", "parents": ["6c5f049d9be818b5da68cdfc99f028a9d5e9268a"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064761 - update wpt metadata for causing unexpected passes @RTCPeerConnection-helper-test.html.\n", "files": ["testing/web-platform/meta/webrtc/RTCPeerConnection-helper-test.html.ini"], "git_node": "8412ffd51fd66d6042963c1f571b9e7a6987f7fa", "git_parents": ["fd81262844f7f2891801131f01c74dbaf6e4881b"], "node": "569ab0a0e6475aad0e3a65fe8471cb64a0982dfd", "parents": ["789ed5a00201c351629054afe4a7bdf304f251a1"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063757 - Make `PresShell::CompleteMove` ignore native anonymous subtrees r=emilio,layout-reviewers\" for causing marionette failures @Selection.cpp.\n\nThis reverts commit d2037c5fc8ad5352af8fbc2ed23bbafcc0a534a1.\n", "files": ["dom/base/Selection.cpp", "layout/base/PresShell.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "testing/web-platform/tests/selection/crashtests/selection-modify-line-from-optgroup-in-video-to-details-without-summary.html"], "git_node": "3a57f71d48436afa068f7db117ce3f2ef292098a", "git_parents": ["8412ffd51fd66d6042963c1f571b9e7a6987f7fa"], "node": "dec68b1c7b25e3b360ead91fe70fb99f4c435ecf", "parents": ["569ab0a0e6475aad0e3a65fe8471cb64a0982dfd"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047627 - Improve superellipse normal approximation. r=gfx-reviewers,nical\n\nFix normal discontinuity when shape approaches 1 (round). Both normal approximations\nnow correctly converge towards axis-aligned normals when reaching a round shape, which\nmatches the preexisting implementation of ellipses for border radii, ensuring a smooth\ntransition between the two and no jumps when animating the shape parameter.\n\nThe new version of compute_superellipse_half_corner(), with the correction applied\nwith a quadratic falloff, actually becomes almost linear. Thus, a much cheaper linear\napproximation has been implemented, and is now used by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317057\n", "files": ["gfx/wr/webrender/res/ellipse.glsl", "gfx/wr/wrench/reftests/boxshadow/box-shadow-spread-shape.png", "gfx/wr/wrench/reftests/clip/clip-superellipse.png", "gfx/wr/wrench/reftests/mask/shaped-corners-inset.png", "gfx/wr/wrench/reftests/mask/shaped-corners-outset.png"], "git_node": "ad7627d1a40248dccc7a11e825d55580a3350972", "git_parents": ["3a57f71d48436afa068f7db117ce3f2ef292098a"], "node": "174b2d56dc3a22c7107ed19628781cbe6a41e0fa", "parents": ["dec68b1c7b25e3b360ead91fe70fb99f4c435ecf"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047627 - Add support for CSS corner-shape in borders. r=gfx-reviewers,nical\n\nAdd support for corner-shape for most types of borders. The same shader is also\nused for outlines, and sometimes to draw rounded rects (see bug 1694269).\n\nAll border types are supported exept dotted and dashed. These are left as\nfuture work.\n\nSome other extreme edge cases (such as when corners overlap) are also not\nhandled correctly yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317058\n", "files": ["gfx/wr/webrender/res/border_shared.glsl", "gfx/wr/webrender/res/cs_border_segment.glsl", "gfx/wr/webrender/res/cs_border_solid.glsl", "gfx/wr/wrench/reftests/border/border-shape-2.png", "gfx/wr/wrench/reftests/border/border-shape-2.yaml", "gfx/wr/wrench/reftests/border/border-shape-3.png", "gfx/wr/wrench/reftests/border/border-shape-3.yaml", "gfx/wr/wrench/reftests/border/border-shape-4.png", "gfx/wr/wrench/reftests/border/border-shape-4.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/border-shape-inset.yaml", "gfx/wr/wrench/reftests/border/border-shape.png", "gfx/wr/wrench/reftests/border/border-shape.yaml", "gfx/wr/wrench/reftests/border/reftest.list", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-superellipse.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-squircle.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-concave.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-convex.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-100.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-inf.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-squircle.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini"], "git_node": "bb0c98821a1bd877640bbbf2008ea771d78fb042", "git_parents": ["ad7627d1a40248dccc7a11e825d55580a3350972"], "node": "7a6048784401319e03a7f9fb32b1c3936afece95", "parents": ["174b2d56dc3a22c7107ed19628781cbe6a41e0fa"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063169 - Add WR_FEATURE_SUPERELLIPSE variant to cs_border_solid and cs_border_segment. r=gfx-reviewers,nical\n\nSplit expensive superellipse calculations in a separate shader variant to load it lazily instead and speedup startup time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319869\n", "files": ["gfx/wr/webrender/res/border_shared.glsl", "gfx/wr/webrender/res/cs_border_segment.glsl", "gfx/wr/webrender/res/cs_border_solid.glsl", "gfx/wr/webrender/src/border.rs", "gfx/wr/webrender/src/gpu_types.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender_build/src/shader_features.rs"], "git_node": "8bda467dc90bcbcebe91b0bceb93847ede7fcc34", "git_parents": ["bb0c98821a1bd877640bbbf2008ea771d78fb042"], "node": "b5babdfbd6453cf990863a1c70c77cc036230cee", "parents": ["7a6048784401319e03a7f9fb32b1c3936afece95"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2065169 - Create new report broken site related smoke tests r=jajohnson,android-reviewers,rebecatudor273\n\nBoth UI tests successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\n\u2757 A colleague from the development team will need to perform a separate review for the test tag additions\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320135\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/WebCompatReporterSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/BrokenSiteReporterTestTags.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/EditUrlConfirmationDialog.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporter.kt"], "git_node": "48ebcd21bcbe1d59858b9b4ae0f5572177a58e3d", "git_parents": ["8bda467dc90bcbcebe91b0bceb93847ede7fcc34"], "node": "14d16eb910c558bfc9547ac5b871a649a2a0da7d", "parents": ["b5babdfbd6453cf990863a1c70c77cc036230cee"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2051911 - Fix intermittent test_http3_large_post.js r=necko-reviewers,kershaw\n\nProblem:\n\nThe failing assertion is Assert.greater(this.onProgressNotificationCount, 10) at netwerk/test/unit/test_http3_large_post.js:69, guarding the 8 MB POST.\n\nonProgress fires once per nsHttpTransaction::ReadSegments round,\nnot once per chunk handed to neqo: Http3Stream::OnReadSegment\ncalls OnTransportStatus(NS_NET_STATUS_SENDING_TO) for every body chunk,\nbut nsHttpTransaction::OnTransportStatus sees mReader set and coalesces them into a single deferred notification\nemitted at the end of ReadSegments.\nHow many rounds a given upload takes is purely a scheduling/flow-control artifact, so the count is unbounded below.\n\nThe regressor (bug 1971997) is a mechanical uploadStreamHasHeaders removal.\nFor this test hasHeaders was already false, so it doesn't change the send path.\nIt shifted timing enough to push an already-fragile\nthreshold over the edge; the comment on the assertion admits 10 was arbitrary.\n\nFix:\n\nReplaced the timing-dependent magnitude check with the property it was actually trying to express \u2014 that the upload is reported incrementally rather than as one lump:\n\n- Count notifications where progress \u003c progressMax and require at least one for the large POST. Verified from the instrumented run that the only sub-max notifications come from the upload phase (the response is a single 11/11), so this can't be satisfied by response progress.\n- Added a monotonicity check on consecutive same-phase notifications, which is deterministic and recovers some of the teeth lost by dropping the \u003e 10 bound.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320358\n", "files": ["netwerk/test/unit/test_http3_large_post.js"], "git_node": "bc078ad772982d62f3b64bf107f374d21dae0a61", "git_parents": ["48ebcd21bcbe1d59858b9b4ae0f5572177a58e3d"], "node": "1072ed0b9fb78ed5384bdffb7685b66e53639309", "parents": ["14d16eb910c558bfc9547ac5b871a649a2a0da7d"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065413 - [devtools] Update MDN compat data. r=devtools-reviewers,jdescottes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320356\n", "files": ["devtools/shared/compatibility/dataset/css-properties.json"], "git_node": "d111b8b4a0ad2208f0c348f176426308eeb83cbb", "git_parents": ["bc078ad772982d62f3b64bf107f374d21dae0a61"], "node": "69fb31507d5a56c31632ee197dba0b8de94c7119", "parents": ["1072ed0b9fb78ed5384bdffb7685b66e53639309"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065384 - Remove obsolete --panel-border-color override for Windows HCM. r=emilio,desktop-theme-reviewers\n\nNot using ThreeDShadow anymore as of bug 2048567.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320343\n", "files": ["toolkit/themes/windows/global/global.css"], "git_node": "ef2de5a24b50a15a1337d087d09caae8029e9c95", "git_parents": ["d111b8b4a0ad2208f0c348f176426308eeb83cbb"], "node": "35caf8df2e5478a3dca40926134d15fc766af94b", "parents": ["69fb31507d5a56c31632ee197dba0b8de94c7119"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2058221 - Add Smart Form Fill autocomplete row item to trigger SFF r=desktop-theme-reviewers,credential-management-reviewers,mlucks,fluent-reviewers,flod,kcochrane,dimi,Mardak,mshillabeer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316453\n", "files": ["browser/components/aiwindow/models/SmartFormFillModel.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/assets/sff-autofill-icon.svg", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/SmartFormFillAutocomplete.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_autocomplete.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_metadata_lifecycle.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_autocomplete.js", "browser/components/aiwindow/ui/test/browser/test_smartformfill_autocomplete.html", "browser/extensions/formautofill/test/browser/browser_autocomplete_footer.js", "browser/locales-preview/aiWindow.ftl", "toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/formautofill/FormAutofillChild.sys.mjs", "toolkit/components/formautofill/FormAutofillParent.sys.mjs", "toolkit/components/passwordmgr/LoginAutoComplete.sys.mjs", "toolkit/components/passwordmgr/LoginManagerChild.sys.mjs", "toolkit/components/passwordmgr/LoginManagerParent.sys.mjs", "toolkit/components/passwordmgr/test/unit/test_login_autocomplete_result.js", "toolkit/components/satchel/FillHelpers.sys.mjs", "toolkit/components/satchel/FormHistoryChild.sys.mjs", "toolkit/components/satchel/FormHistoryParent.sys.mjs", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.css", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.mjs", "toolkit/components/satchel/test/browser/browser_autocomplete.js", "toolkit/content/widgets/autocomplete-popup.js"], "git_node": "8eb299eba6dbd311441b420d572d2c2b59e1107d", "git_parents": ["ef2de5a24b50a15a1337d087d09caae8029e9c95"], "node": "c5b7085b4dec9595d6da191958704273219121fb", "parents": ["35caf8df2e5478a3dca40926134d15fc766af94b"], "tags": []}, {"author": "Sven Marnach \u003csven@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044614 - Migrate the upload_symbols.py script to the upload-symbols CLI tool r=gsvelto,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304398\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/system-symbols-upload/kind.yml", "taskcluster/kinds/toolchain-dxc-upload/kind.yml", "taskcluster/kinds/upload-symbols/kind.yml", "toolkit/crashreporter/tools/upload_symbols.py"], "git_node": "7023b6f4a20966660549218a2f975302721d7ce4", "git_parents": ["8eb299eba6dbd311441b420d572d2c2b59e1107d"], "node": "f75704bfb4ba443f50c47b390748db3bffb2687c", "parents": ["c5b7085b4dec9595d6da191958704273219121fb"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2065069 - Open the Library's context menu before activating an item in browser_library_telemetry.js, r=places-reviewers,daisuke.\n\nThe test looked its menu items up with document.getElementById, which resolves\nin the browser window rather than in the Library.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320294\n", "files": ["browser/components/places/tests/browser/browser_library_telemetry.js"], "git_node": "0dd1fe4a8e74b04e714ba6d077eeeebc7a8ca553", "git_parents": ["7023b6f4a20966660549218a2f975302721d7ce4"], "node": "76c544dd721b7a55c5acbaf41a90b0a725ecf839", "parents": ["f75704bfb4ba443f50c47b390748db3bffb2687c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2032977 - Use synthesizeClickOnSelectedTreeCell to open the context menu in browser_forgetthissite.js, r=places-reviewers,daisuke.\n\nThe hand-rolled coordinates are computed before the freshly opened Library\nwindow's tree has a non-zero width, so the right-click misses the tree and the\ncontext menu never opens. Bug 2029541 added that wait to the shared helper.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320348\n", "files": ["browser/components/places/tests/browser/browser_forgetthissite.js"], "git_node": "f425819ba6db04ed3631e80ee556fc227f69f7d7", "git_parents": ["0dd1fe4a8e74b04e714ba6d077eeeebc7a8ca553"], "node": "87f6a30407153495e313ebc4091b2fa420310468", "parents": ["76c544dd721b7a55c5acbaf41a90b0a725ecf839"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2064904 - Break the false output dependency of float32\u003c-\u003edouble conversions on x86-shared. r=jandem\n\ncvtss2sd/cvtsd2ss only write the low element of their output register,\nleaving a false dependency on its stale contents -- the same hazard\nconvertInt32ToDouble breaks with a zeroing idiom (see its comment citing\nAgner Fog). With AVX, pass the source register as the merge operand\ninstead: the instruction then has no input other than the source, at no\ncost in code size or uops (the VEX form is the same length as the legacy\nform it replaces). Without AVX the merge operand must equal the\ndestination, so pre-AVX CPUs keep the current behavior. Converting in\nplace carries a true dependency on the source and emits the legacy form\nas before.\n\nAn x86lint survey over Octane's Ion output found 218 stale-destination\nconversions, 216 of them in Mandreel, typically with the stale register\nholding the previous loop iteration's conversion result.\n\nBenchmarks on AMD Zen 5 (opt shell): a dependency-bound microkernel\n(cvtsd2ss with its input kept live) improves 26% (a xorps zeroing idiom\nrecovers slightly more, 32%, at the cost of an extra instruction per\nconversion). Mandreel (x10) and full Octane (x5) totals are within\nnoise; the expected benefit is larger on microarchitectures where the\npartial-register merge is costlier.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319929\n", "files": ["js/src/jit/x86-shared/MacroAssembler-x86-shared.h"], "git_node": "cf2846d8b83ac8411fb4708f5258a9b1aa5bbc64", "git_parents": ["f425819ba6db04ed3631e80ee556fc227f69f7d7"], "node": "c97f0457aaaf97c3404c017d0d49a82013bea4d3", "parents": ["87f6a30407153495e313ebc4091b2fa420310468"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2064291 - jit/arm64: fold load32SignExtendToPtr into ldrsw. r=jandem\n\nload32SignExtendToPtr emitted load32 (ldr, 32-bit) +\nmove32To64SignExtend (sxtw). Fold into a single ldrsw, the same\ninstruction the wasm load path already uses. ldrsw sign-extends 32-\u003e64\nin the load, so the result is identical.\n\nThe main caller is the regex engine's signed register and\nbacktrack-stack loads (RegExpNativeMacroAssembler), so ~1083 instances\ndrop out of Octane's RegExp tier. The eliminated sxtw was on the\nload-\u003euse dependency chain, so this also shortens it: a 17-run Octane\nRegExp A/B leaned ~0.8% faster (B\u003eA in 12/17), at the edge of noise.\n\nFound via armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319382\n", "files": ["js/src/jit/arm64/MacroAssembler-arm64-inl.h"], "git_node": "a257d40e3db369e7ad3e50c04bcef8c7a1ed769a", "git_parents": ["cf2846d8b83ac8411fb4708f5258a9b1aa5bbc64"], "node": "439e6ebd42ab75d58d6aa139da8deb2988d684f0", "parents": ["c97f0457aaaf97c3404c017d0d49a82013bea4d3"], "tags": []}, {"author": "lola_t \u003cltokhtamuradova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062978 - Add listen button to reader view control bar r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320101\n", "files": ["mobile/android/android-components/components/feature/readerview/src/main/java/mozilla/components/feature/readerview/ReaderViewFeature.kt", "mobile/android/android-components/components/feature/readerview/src/main/java/mozilla/components/feature/readerview/internal/ReaderViewControlsInteractor.kt", "mobile/android/android-components/components/feature/readerview/src/main/java/mozilla/components/feature/readerview/internal/ReaderViewControlsPresenter.kt", "mobile/android/android-components/components/feature/readerview/src/main/java/mozilla/components/feature/readerview/view/ReaderViewControlsBar.kt", "mobile/android/android-components/components/feature/readerview/src/main/java/mozilla/components/feature/readerview/view/ReaderViewControlsView.kt", "mobile/android/android-components/components/feature/readerview/src/main/res/layout/mozac_feature_readerview_view.xml", "mobile/android/android-components/components/feature/readerview/src/main/res/values/static_strings.xml", "mobile/android/android-components/components/feature/readerview/src/test/java/mozilla/components/feature/readerview/ReaderViewFeatureTest.kt", "mobile/android/android-components/components/feature/readerview/src/test/java/mozilla/components/feature/readerview/internal/ReaderViewControlsPresenterTest.kt", "mobile/android/android-components/components/feature/readerview/src/test/java/mozilla/components/feature/readerview/view/ReaderViewControlsBarTest.kt", "mobile/android/android-components/config/detekt-baseline.xml", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/integration/ReaderViewIntegration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/readermode/ReaderModeController.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/readermode/DefaultReaderModeControllerTest.kt"], "git_node": "61eada640234f027e0de8723ef2613b1f9ff2646", "git_parents": ["a257d40e3db369e7ad3e50c04bcef8c7a1ed769a"], "node": "f554a011dc9e1a7fcaf86c17c2819fc7e0411136", "parents": ["439e6ebd42ab75d58d6aa139da8deb2988d684f0"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064761 - update wpt metadata.\n", "files": ["testing/web-platform/meta/webrtc/RTCPeerConnection-helper-test.html.ini"], "git_node": "e04188790b29b4e904dde597fcd1fdcdddde4518", "git_parents": ["61eada640234f027e0de8723ef2613b1f9ff2646"], "node": "d7ea88985703476dbc6523b72e7695ce7f9e3f01", "parents": ["f554a011dc9e1a7fcaf86c17c2819fc7e0411136"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064761 - update wpt metadata for interactive-content.html test.\n", "files": ["testing/web-platform/meta/html/semantics/interactive-elements/the-summary-element/interactive-content.html.ini"], "git_node": "043764b213c1128c7105ba6c7e327665904dac3e", "git_parents": ["e04188790b29b4e904dde597fcd1fdcdddde4518"], "node": "552c4bfc4ec02889bd061b87d843bce648b932c8", "parents": ["d7ea88985703476dbc6523b72e7695ce7f9e3f01"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2063618 - Make ReportingHeader call HasRootDomain with host not origin r=sfarre,dom-core-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318848\n", "files": ["dom/reporting/ReportingHeader.cpp", "dom/reporting/tests/browser.toml", "dom/reporting/tests/browser_purgeHost.js", "dom/reporting/tests/reporting_endpoints.sjs"], "git_node": "ce94604f1b2af5bab5ac9f56ce8c38594f357dd4", "git_parents": ["043764b213c1128c7105ba6c7e327665904dac3e"], "node": "04cab9b915a5ce35784a337792e9cdb2835f00b1", "parents": ["552c4bfc4ec02889bd061b87d843bce648b932c8"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2063618 - Callers of hasRootDomain should use asciiHost instead of displayHost r=necko-reviewers,credential-management-reviewers,urlbar-reviewers,daleharvey,kershaw,dimi\n\n- Adds #asciiHost getter to browser-trustPanel.js for use when calling other APIs.\n- Renames #host to #displayHost to avoid future confusion\n- Makes passwordRulesManager use asciiHost when calling hasRootDomain\n- Adds tests for both callsites with IDN domains\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319031\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "toolkit/components/passwordmgr/PasswordRulesManager.sys.mjs", "toolkit/components/passwordmgr/test/unit/test_PasswordRulesManager_generatePassword.js"], "git_node": "b9a154f461e891882a4ac58f690c1dbcce140e26", "git_parents": ["ce94604f1b2af5bab5ac9f56ce8c38594f357dd4"], "node": "478a8179f78730cc5a34b0800a8e79fded279435", "parents": ["04cab9b915a5ce35784a337792e9cdb2835f00b1"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2063717, part 0 - Add GetServiceHelper to KungFuDeathGripChecker. r=firefox-static-analysis-reviewers,sergesanspaille\n\nThe next patch replaces a call to services::GetChromeRegistry() with a call to\ncomponents::ChromeRegistry::Service(). The former returns already_AddRefed while\nthe latter returns GetServiceHelper, which causes KungFuDeathGripChecker to fail\nin a few places. GetServiceHelper is basically the modern version of the\nnsGetService helpers, so add it to the list of exceptions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319827\n", "files": ["build/clang-plugin/KungFuDeathGripChecker.cpp"], "git_node": "92739c61b27c8fe890a35d9e19b5faa1acfed3ef", "git_parents": ["b9a154f461e891882a4ac58f690c1dbcce140e26"], "node": "d73a78734863d61752909c4ecbe87be8de7ff7f1", "parents": ["478a8179f78730cc5a34b0800a8e79fded279435"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2063717, part 1 - Replace uses of services::GetIOService(), ::GetChromeRegistry() and ::GetPermissionManager(). r=xpcom-reviewers,media-playback-reviewers,emilio,padenot\n\nThe new method is more threadsafe, but it will acquire a lock. Hopefully none of\nthis is super hot code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318838\n", "files": ["chrome/nsChromeProtocolHandler.cpp", "dom/fetch/FetchService.cpp", "dom/media/mediacontrol/MediaStatusManager.cpp", "js/xpconnect/loader/URLPreloader.cpp", "startupcache/StartupCacheUtils.cpp", "uriloader/exthandler/nsExternalHelperAppService.cpp", "xpcom/components/ManifestParser.cpp"], "git_node": "26a008e61a3bc54fd958c8399e0101b4f32008bc", "git_parents": ["92739c61b27c8fe890a35d9e19b5faa1acfed3ef"], "node": "6d383cc63548bc0ff022e52aa45d3eaf9baf0537", "parents": ["d73a78734863d61752909c4ecbe87be8de7ff7f1"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2063717, part 2 - Replace uses of services::GetAsyncShutdownService(). r=xpcom-reviewers,webrtc-reviewers,places-reviewers,media-playback-reviewers,emilio,padenot,pehrsons,Standard8\n\nAs with the prior patch, the new function is more threadsafe, but it needs to\nacquire a lock. Hopefully none of this is too performance sensitive.\n\nThis one is a bit funkier because one gtest does a reset thing, so we need to make the\ncomponent overridable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318839\n", "files": ["dom/base/Document.cpp", "dom/clients/manager/ClientManagerService.cpp", "dom/file/uri/BlobURLProtocolHandler.cpp", "dom/fs/child/FileSystemShutdownBlocker.cpp", "dom/ipc/ContentParent.cpp", "dom/media/gtest/TestAudioTrackGraph.cpp", "dom/media/systemservices/MediaUtils.cpp", "dom/serviceworkers/ServiceWorkerManager.cpp", "parser/html/nsHtml5TreeOpExecutor.cpp", "security/manager/ssl/nsCertOverrideService.cpp", "toolkit/components/asyncshutdown/components.conf", "toolkit/components/places/ConcurrentConnection.cpp", "toolkit/components/places/Database.cpp", "toolkit/components/places/Shutdown.cpp", "widget/nsUserIdleService.cpp", "xpcom/ioutils/IOUtils.cpp"], "git_node": "ebfe5a48e753e290d21361a6d27b1cf6cf32cac5", "git_parents": ["26a008e61a3bc54fd958c8399e0101b4f32008bc"], "node": "842bbe1c027b90092348b51e2b0cef26ed84fcc4", "parents": ["6d383cc63548bc0ff022e52aa45d3eaf9baf0537"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2063717, part 3 - Remove unused things from Services.py. r=xpcom-reviewers,emilio\n\nThe prior patches got rid of the most of the components. Also, get\nrid of a bunch of headers that aren't needed. Many of them were already\nunnecessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318840\n", "files": ["xpcom/build/Services.py"], "git_node": "48d93420c5762164166ac6b85061510f40e87f37", "git_parents": ["ebfe5a48e753e290d21361a6d27b1cf6cf32cac5"], "node": "055b49175a455187a25c167d0c149e4c0249f2ac", "parents": ["842bbe1c027b90092348b51e2b0cef26ed84fcc4"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2063717, part 4 - Hard code the services file. r=xpcom-reviewers,emilio\n\nTo better show how I have changed them, this version of Services.h and\nServices.cpp is exactly as it was generated after the prior patch, except that\nI have added the MPL and run the formatter on both files. Cleanups will happen\nin the next patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318841\n", "files": ["xpcom/build/Services.py", "xpcom/build/moz.build", "xpcom/components/Services.cpp", "xpcom/components/Services.h", "xpcom/components/moz.build"], "git_node": "6165bb9abaf5fa4e2b5c73a740446108eb7ca46f", "git_parents": ["48d93420c5762164166ac6b85061510f40e87f37"], "node": "203fde1f58fb17226606357cee88133aa8f5b1b7", "parents": ["055b49175a455187a25c167d0c149e4c0249f2ac"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2063717, part 5 - A few minor cleanups to the generated Services files. r=xpcom-reviewers,emilio\n\nThe added includes in random files are from places that had been bootlegging via\nServices.h.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318842\n", "files": ["image/ShutdownTracker.cpp", "widget/cocoa/nsMacPermissionMonitor.mm", "xpcom/components/Services.cpp", "xpcom/components/Services.h"], "git_node": "1c496e724aab0f3c644f1b399d48fc82bc15d5c6", "git_parents": ["6165bb9abaf5fa4e2b5c73a740446108eb7ca46f"], "node": "9b7035f46fa0679cf41e1a535ca7048438b6af9c", "parents": ["203fde1f58fb17226606357cee88133aa8f5b1b7"], "tags": []}, {"author": "Tiaan Louw \u003ctlouw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065108 - Remove the layout.css.relative-color-syntax.enabled pref r=layout-reviewers,devtools-reviewers,firefox-style-system-reviewers,nchevobbe,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320372\n", "files": ["devtools/client/shared/test/browser_outputparser.js", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/color/component.rs", "servo/components/style/color/parsing.rs", "testing/web-platform/meta/css/css-color/__dir__.ini"], "git_node": "ce24dfbe3a21e06438423d0695a50bad3adb479d", "git_parents": ["1c496e724aab0f3c644f1b399d48fc82bc15d5c6"], "node": "51333904a76ecee5f93098b80788821f163dae72", "parents": ["9b7035f46fa0679cf41e1a535ca7048438b6af9c"], "tags": []}, {"author": "Alex G \u003cagain@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063685 - Remove world cup tool calling code from Smart Window. r=ai-security-reviewers,tliu,jlewis,mzhang\n\nThe World Cup is over and Merino is removing the WCS endpoints, so\nremove the world_cup_matches and world_cup_live tools, the\nWCSMerinoClient, the browser.smartwindow.worldcup.* prefs, the action\nlog entries and strings, and the xpcshell test.\n\nFEATURE_GATED_HANDLERS and filterFeatureGatedTools stay since\nsearch_the_web and aitab still use them; only the world cup entries\nare removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317832\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/WCSMerinoClient.sys.mjs", "browser/components/aiwindow/models/moz.build", "browser/components/aiwindow/models/tests/xpcshell/test_Tools_WorldCup.js", "browser/components/aiwindow/models/tests/xpcshell/xpcshell.toml", "browser/components/aiwindow/ui/modules/ToolActionLog.sys.mjs", "browser/locales/en-US/browser/aiWindowContent.ftl"], "git_node": "9401a9197fb58dbac745ff9daf02f402a495992a", "git_parents": ["ce24dfbe3a21e06438423d0695a50bad3adb479d"], "node": "87f964f6f1e6e25b160b5d2a48deffad5820598f", "parents": ["51333904a76ecee5f93098b80788821f163dae72"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2032977, Bug 2065069 - Use synthesizeClickOnSelectedTreeCell to open the context menu in browser_forgetthissite.js, r=places-reviewers,daisuke.\" for causing bc failures @browser_library_telemetry.js.\n\nThis reverts commit f425819ba6db04ed3631e80ee556fc227f69f7d7.\n\nRevert \"Bug 2065069 - Open the Library's context menu before activating an item in browser_library_telemetry.js, r=places-reviewers,daisuke.\"\n\nThis reverts commit 0dd1fe4a8e74b04e714ba6d077eeeebc7a8ca553.\n", "files": ["br