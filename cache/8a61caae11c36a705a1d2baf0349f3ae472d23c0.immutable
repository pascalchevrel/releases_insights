ple/test_bug_2054717.html"], "git_node": "3c3cf0435c6fd0d016cbaacd9a9bf32750e0963c", "git_parents": ["8b0a35391961148ef322f03b718f941c8142b1fe"], "node": "0f5719bb4c1a39feb37b07305793a7739fd05fb7", "parents": ["b7d36d328d42fcda076d1712e7dab9ae11909960"], "tags": []}], "date": 1785354232, "git_changesets": ["8b0a35391961148ef322f03b718f941c8142b1fe", "3c3cf0435c6fd0d016cbaacd9a9bf32750e0963c"], "user": "dsmith@mozilla.com"}, "27692": {"changesets": [{"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054505 - Add quality filters and a clustering timeout to Auto Tab Grouping  a=diannaS\n\nBuilding Auto Tab Grouping 'v0' - largely exploratory and gated behind a pref\nNo finalized designs yet, but there is a demo: https://auto-tab-grouping.netlify.app sw0626\n\nbrowser.smartwindow.autoTabGrouping.enabled\nSmartTabGroupingManager.isEnabled\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312313\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315039\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/components/aiwindow/ui/test/xpcshell/test_AutoTabGrouping.js"], "git_node": "317cf35af8555e305a588cab79ba51bbbf846f3f", "git_parents": ["3c3cf0435c6fd0d016cbaacd9a9bf32750e0963c"], "node": "6bd5d01e9f72fe6984532298c886ce333f1a39cb", "parents": ["0f5719bb4c1a39feb37b07305793a7739fd05fb7"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054506 - Add a recent-groups list with ungroup and telemetry to Auto Tab Grouping  a=diannaS\n\nBuilding Auto Tab Grouping 'v0' - largely exploratory and gated behind a pref\nNo finalized designs yet, but there is a demo: https://auto-tab-grouping.netlify.app sw0626\n\nbrowser.smartwindow.aut