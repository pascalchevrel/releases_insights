51e47054b2497e54c750cbf7ba7a4cc"], "node": "126172da5bd3879bb1c5df0d17c4002b00eb5276", "parents": ["7a868af4b945b498ac2fa1fa983007c921dcb2a3"], "tags": []}], "date": 1785159459, "git_changesets": ["755a8d6b25b281c236627569230dd13ac2bdfa7e"], "user": "ffxbld@lando.moz.tools"}, "27640": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging ee75d075c7648416a2617069d5d78ceb3cfdf08f with FIREFOX_154_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "2eb3f18e096980a302671c39c0d1a59cffe9324a", "git_parents": ["755a8d6b25b281c236627569230dd13ac2bdfa7e"], "node": "de334f791c7ce5d5c3ab9a740996f8d25085dfe7", "parents": ["126172da5bd3879bb1c5df0d17c4002b00eb5276"], "tags": []}], "date": 1785165889, "git_changesets": ["2eb3f18e096980a302671c39c0d1a59cffe9324a"], "user": "ffxbld@lando.moz.tools"}, "27641": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging ee75d075c7648416a2617069d5d78ceb3cfdf08f with DEVEDITION_154_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "d90630a2c2c7455872bc6f037fa4b34507017caf", "git_parents": ["2eb3f18e096980a302671c39c0d1a59cffe9324a"], "node": "3b0fb71ae6ad43cf7cdfb4dc3efdaccaa14671ef", "parents": ["de334f791c7ce5d5c3ab9a740996f8d25085dfe7"], "tags": []}], "date": 1785166220, "git_changesets": ["d90630a2c2c7455872bc6f037fa4b34507017caf"], "user": "ffxbld@lando.moz.tools"}, "27642": {"changesets": [{"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048353 - Improve worker shutdown support in CookieStoreNotificationWatcher  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311765\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314265\n", "files": ["dom/cookiestore/CookieStoreNotificationWatcherWrapper.cpp"], "git_node": "66132894d9fecd5ca649274efe70c95a6d0f93ba", "git_parents": ["c762b00ae40b064d807705ec27385486aa537aeb"], "node": "0f6d2e59b227c76ea85142509024be59b2bc1268", "parents": ["1a4b679b10ef599434d942d7a90a5adeeac406ff"], "tags": []}], "date": 1785169755, "git_changesets": ["66132894d9fecd5ca649274efe70c95a6d0f93ba"], "user": "dsmith@mozilla.com"}, "27643": {"changesets": [{"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2056856 - Round a text run's ancestor clips out on both axes  a=diannaS\n\nDevice-space text runs keep their clips exact on the sub-pixel axis\n(bug 2050692), assuming glyphs are sub-pixel-positioned there. That is\ncorrect for a run's OWN clip (the leaf clip_rect - e.g. a partial-ligature\nor selection clip): rounding it out would over-reveal a sub-pixel column of\nan adjacent run at an inline boundary. But it is wrong for the run's\nANCESTOR clips (an overflow:hidden container, table-cell edge, scroll\nframe): an embedded bitmap strike (e.g. MS UI Gothic) is grid-placed with\nno sub-pixel positioning, so a zero-bearing first glyph at a fractional\ndevice origin gets its leftmost column shaved by the exact container edge.\n\nRound only the ancestor (clip-chain) clips of a text run out on both axes;\nkeep the run's own leaf clip exact on the sub-pixel axis as before. Round-out\nnever moves an edge inward, so bug 2050692 stays fixed, and keeping the leaf\nexact avoids over-revealing adjacent runs (no regression to shaping/boundary\ntext).\n\nThe wrench reftest uses Proggy's ppem-11 bitmap strike clipped by a\nclip-chain node (mirroring overflow:hidden); it can't be a Gecko reftest\nsince drawSnapshot bypasses WebRender.\n\nDrop now-passing WPT expectations that the ancestor-clip round-out fixes:\ntext-overflow-028 and text-wrap-balance-line-clamp-005 (Mac). Both target\ntests byte-identical to the ones on central, so the improvements carry over.\n\nBeta uplift of 11ccd5737372; the code change is byte-identical. Two of\ncentral's WPT metadata edits are deliberately not taken, because both files\ndiverged through wpt metadata syncs rather than any behaviour difference:\ntext-overflow-with-selection.html.ini has no counterpart on beta (the test\nitself does not exist here), and text-overflow-string-005.html.ini is left\nuntouched because beta still runs an older revision of that test, for which\nits current bare-FAIL expectation is self-consistent. If the fix flips that\ntest on beta the way it did on central, the annotation can be narrowed once\na beta try run shows it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313624\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314282\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/wrench/reftests/text/2056856-bitmap-clip-ref.yaml", "gfx/wr/wrench/reftests/text/2056856-bitmap-clip.yaml", "gfx/wr/wrench/reftests/text/reftest.list", "testing/web-platform/meta/css/css-text/white-space/text-wrap-balance-line-clamp-005.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-028.html.ini"], "git_node": "3ca0bfa2c168fabb9efb704871901f7cd62f656a", "git_parents": ["66132894d9fecd5ca649274efe70c95a6d0f93ba"], "node": "e3bc6be5a323830c06d5c2f18601d4cc3cac411a", "parents": ["0f6d2e59b227c76ea85142509024be59b2bc1268"], "tags": []}], "date": 1785170465, "git_changesets": ["3ca0bfa2c168fabb9efb704871901f7cd62f656a"], "user": "dsmith@mozilla.com"}, "27644": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018164 - Verify more Client IPC.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310602\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314311\n", "files": ["dom/clients/manager/ClientHandleOpParent.cpp", "dom/clients/manager/ClientHandleOpParent.h", "dom/clients/manager/ClientHandleParent.cpp", "dom/clients/manager/ClientHandleParent.h", "dom/clients/manager/ClientManagerOpParent.cpp", "dom/clients/manager/ClientManagerOpParent.h", "dom/clients/manager/ClientManagerParent.cpp", "dom/clients/manager/ClientValidation.cpp", "dom/clients/manager/ClientValidation.h"], "git_node": "f8a827b4e3b9334c1a1a9a0adb88db497856f3da", "git_parents": ["3ca0bfa2c168fabb9efb704871901f7cd62f656a"], "node": "c9fb031ca62d02c3f3c6194a89e8ca2012779774", "parents": ["e3bc6be5a323830c06d5c2f18601d4cc3cac411a"], "tags": []}], "date": 1785171647, "git_changesets": ["f8a827b4e3b9334c1a1a9a0adb88db497856f3da"], "user": "dsmith@mozilla.com"}, "27645": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053962 - Dispatch async backup pref writes as standalone writes instead of sharing the sPendingWriteData slot.  a=diannaS\n\nBackupPrefFile writes go through PreferencesImpl::WritePrefFile, which coalesces\nall writes through a single sPendingWriteData slot destined for the profile\nprefs.js. A backup targets a different file with a filtered pref set and carries\na MozPromise. When the slot was already occupied, the backup took the coalescing\nearly-return, dropping its MozPromiseHolder without settling it and leaving its\nfiltered data in the slot. Give writes that carry a promise holder their own\nPWRunnable with their own data so they never touch the shared slot.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311551\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314297\n", "files": ["modules/libpref/Preferences.cpp", "modules/libpref/test/unit/test_backupPrefFile.js"], "git_node": "f2c13c0d9e2ccc5653ecd07c9efa9d22c4a5695d", "git_parents": ["f8a827b4e3b9334c1a1a9a0adb88db497856f3da"], "node": "4d4a82b0dcf409974008cc02cb3c286cc4914505", "parents": ["c9fb031ca62d02c3f3c6194a89e8ca2012779774"], "tags": []}], "date": 1785172908, "git_changesets": ["f2c13c0d9e2ccc5653ecd07c9efa9d22c4a5695d"], "user": "dsmith@mozilla.com"}, "27646": {"changesets": [{"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2056836 - Keep the highlighted URL layout in sync with text changes  a=diannaS\n\nRemeasure the displayed URL when its text, style, or viewport width changes.\nThis prevents domain ranges from the current URL from being applied to a stale TextLayoutResult.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313504\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314399\n", "files": ["mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ui/HighlightedDomainUrl.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/ui/HighlightedDomainUrlLayoutTest.kt"], "git_node": "96d21fb84e3b71227b680af79c30e3b499d32a82", "git_parents": ["f2c13c0d9e2ccc5653ecd07c9efa9d22c4a5695d"], "node": "709d45579f22cc8a0b86ca5eded7ba4579a907b4", "parents": ["4d4a82b0dcf409974008cc02cb3c286cc4914505"], "tags": []}], "date": 1785176648, "git_changesets": ["96d21fb84e3b71227b680af79c30e3b499d32a82"], "user": "dsmith@mozilla.com"}, "27647": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1698087 - Move the devtools fallback page from a chrome: to a resource: URL.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309773\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314320\n", "files": ["browser/base/content/test/static/browser_all_files_referenced.js", "devtools/server/actors/descriptors/webextension.js", "devtools/server/actors/watcher/browsing-context-helpers.sys.mjs", "devtools/shared/jar.mn"], "git_node": "6e274071f89a8d3179baa4386bf7a7e04988e1ba", "git_parents": ["96d21fb84e3b71227b680af79c30e3b499d32a82"], "node": "f2dcbf3ef7c909b52c5544db39ecc6cc84b6b803", "parents": ["709d45579f22cc8a0b86ca5eded7ba4579a907b4"], "tags": []}], "date": 1785176747, "git_changesets": ["6e274071f89a8d3179baa4386bf7a7e04988e1ba"], "user": "dsmith@mozilla.com"}, "27648": {"changesets": [{"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052861 - Gate Link Preview key points on llama.cpp support  a=diannaS\n\nLink Preview key-points are now skipped for users running non-AVX2 hardware.\nKey-points users now only run native llama.cpp.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311367\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314338\n", "files": ["browser/components/genai/LinkPreview.sys.mjs", "browser/components/genai/LinkPreviewModel.sys.mjs", "browser/components/genai/tests/browser/browser_link_preview.js", "browser/components/genai/tests/browser/browser_link_preview_aifeature_lifecycle.js", "browser/components/genai/tests/browser/browser_link_preview_optin.js", "browser/components/genai/tests/browser/browser_link_preview_telemetry.js"], "git_node": "d932c330b2e809d7d2138f719325543af0bbfad7", "git_parents": ["6e274071f89a8d3179baa4386bf7a7e04988e1ba"], "node": "e504619936c52a516ccbf12006c8addaf8bc2ccd", "parents": ["f2dcbf3ef7c909b52c5544db39ecc6cc84b6b803"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053830 - Part 1: Remove the best-llama backend  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311368\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314339\n", "files": ["toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/docs/api.md", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_engine_e2e.js", "toolkit/components/ml/tests/browser/ml_engine_e2e_backend_stub.worker.mjs"], "git_node": "553bb9ec8b6f31bb5a34f1dab0cbbf1cb0191d7a", "git_parents": ["d932c330b2e809d7d2138f719325543af0bbfad7"], "