1eb5310ef90ccb155fde5a6e5c1fc44e173"], "user": "ffxbld@lando.moz.tools"}, "27547": {"changesets": [{"author": "tobypilling \u003ctoby@thunderbird.net\u003e", "branch": "default", "desc": "Bug 2056010 - Use a weak dependency for shell_windows enable_tests.  a=diannaS\n\nThe enable_tests feature was strongly enabling the optional shell_windows\ndependency, causing Thunderbird Windows builds with tests enabled to compile\nFirefox-only shell code without the required XPCOM interfaces.\n\nUse Cargo's weak dependency feature syntax so shell_windows/enable_tests is\nenabled only when shell_windows is already part of the crate graph.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312865\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313253\n", "files": ["toolkit/library/rust/shared/Cargo.toml"], "git_node": "c08af944fdb78cdaa3d9bf18a86b55e0a2035692", "git_parents": ["5dfa1f42d3da99eb1046fe9505942b87b9049a93"], "node": "f5675b00049a44ba568d0d7d2694a0381af11a5e", "parents": ["63c759f091528d33d33e69248fefda000360a192"], "tags": []}], "date": 1784658281, "git_changesets": ["c08af944fdb78cdaa3d9bf18a86b55e0a2035692"], "user": "dsmith@mozilla.com"}, "27548": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings tld-suffixes mobile-experiments mobile-merino-manifest ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313310\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "mobile/android/fenix/app/src/main/res/raw/initial_experiments.json", "netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/newtab-wallpapers-v2.json"], "git_no