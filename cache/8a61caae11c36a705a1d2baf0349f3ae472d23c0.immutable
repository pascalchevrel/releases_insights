accd4e66a8ef5c9fb18f6b3c24\ntl -\u003e fba321eb09bc2faccd4e66a8ef5c9fb18f6b3c24\ntr -\u003e fba321eb09bc2faccd4e66a8ef5c9fb18f6b3c24\ntrs -\u003e fba321eb09bc2faccd4e66a8ef5c9fb18f6b3c24\nuk -\u003e fba321eb09bc2faccd4e66a8ef5c9fb18f6b3c24\nur -\u003e fba321eb09bc2faccd4e66a8ef5c9fb18f6b3c24\nuz -\u003e fba321eb09bc2faccd4e66a8ef5c9fb18f6b3c24\nvi -\u003e fba321eb09bc2faccd4e66a8ef5c9fb18f6b3c24\nwo -\u003e fba321eb09bc2faccd4e66a8ef5c9fb18f6b3c24\nxh -\u003e fba321eb09bc2faccd4e66a8ef5c9fb18f6b3c24\nzam -\u003e fba321eb09bc2faccd4e66a8ef5c9fb18f6b3c24\nzh-CN -\u003e fba321eb09bc2faccd4e66a8ef5c9fb18f6b3c24\nzh-TW -\u003e fba321eb09bc2faccd4e66a8ef5c9fb18f6b3c24\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "bedb2b5ec66b0eea97be67058a6e432f3f885e08", "git_parents": ["e4af9549c2374b43e758058eb4c7efb851cc300d"], "node": "37982869afe7f1e1f16c49ffe4851c2ceff3aab5", "parents": ["46a0d43506a56dcb51c6d69ba2571376431b5a55"], "tags": []}], "date": 1785402195, "git_changesets": ["e4af9549c2374b43e758058eb4c7efb851cc300d", "bedb2b5ec66b0eea97be67058a6e432f3f885e08"], "user": "ffxbld@lando.moz.tools"}, "27706": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053337 - Part 1: Always add ephemeron edge for symbol keyed weak map entries  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311573\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315249\n", "files": ["js/src/gc/Marking.cpp", "js/src/gc/WeakMap.cpp"], "git_node": "f150de18dd3bb47daff33d50412cca20dc96e62a", "git_parents": ["bedb2b5ec66b0eea97be67058a6e432f3f885e08"], "node": "323a7b32fb7a9d22a9b428b1da02b5aa0f371ede", "parents": ["37982869afe7f1e1f16c49ffe4851c2ceff3aab5"], "tags": []}], "date": 1785407256, "git_changesets": ["f150de18dd3bb47daff33d50412cca20dc96e62a"], "user": "dsmith@mozilla.com"}, "27707": {"changesets": [{"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2055683 - IPC improvement  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314463\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314797\n", "files": ["mobile/android/components/geckoview/GeckoViewContentChannelParent.cpp"], "git_node": "7e586a1861ea83e71041507c0d76c0709afe3a55", "git_parents": ["f150de18dd3bb47daff33d50412cca20dc96e62a"], "node": "b0a06044d66f97a9f112e9413bdac758f0f8b5d2", "parents": ["323a7b32fb7a9d22a9b428b1da02b5aa0f371ede"], "tags": []}], "date": 1785407625, "git_changesets": ["7e586a1861ea83e71041507c0d76c0709afe3a55"], "user": "dsmith@mozilla.com"}, "27708": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056444 - Fetch same-process blob URL data directly instead of over IPC.  a=diannaS\n\nA Blob backed by in-process memory (e.g. built from an ArrayBuffer) exposes a\nseekable input stream locally. Routing its data through the parent turned it\ninto a forward-only pipe, so a media element seeking near the end of the blob\nhad to read and discard everything before the target offset, hanging.\n\nFetch the blob data from this process's own BlobURLProtocolHandler store when\nthe entry is present (which it is for blobs owned by this process), keeping the\nstream seekable. Blobs owned by another process are still fetched over IPC.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314001\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314694\n", "files": ["dom/file/uri/BlobURLInputStream.cpp"], "git_node": "d74305999d7c804f80cedb6eacdf4ba1896e9cf1", "git_parents": ["7e586a1861ea83e71041507c0d76c0709afe3a55"], "node": "a89a49d9678fe1697d1d69cd3fc5b91e120118ef", "parents": ["b0a06044d66f97a9f112e9413bdac758f0f8b5d2"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2056444 - Add a regression test for playing a video from a Blob rebuilt from an ArrayBuffer.  a=diannaS\n\nBased on https://github.com/Vincent0700/firefox-arraybuffer-blob-video-repro :\na Blob constructed from an ArrayBuffer (rather than obtained directly via\nResponse.blob()) went through the same RemoteLazyInputStream-backed,\nasync-over-IPC path as any other Blob, so it hit the same playback bug as\nthe Blob URL case already covered by test_temporary_file_blob_video_plays.html.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313277\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314695\n", "files": ["dom/media/test/mochitest.toml", "dom/media/test/test_blob_from_arraybuffer_video_plays.html"], "git_node": "441c2e64fc15445928ee53dced943734e9d0b508", "git_parents": ["d74305999d7c804f80cedb6eacdf4ba1896e9cf1"], "node": "9e9f27223fa2a94e1cfa726ae0cd1239b4240528", "parents": ["a89a49d9678fe1697d1d69cd3fc5b91e120118ef"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2056444 - Add a regression test for decoding and seeking a Blob read from CacheStorage.  a=diannaS\n\nBased on a testcase in the bug: a Blob handed out by CacheStorage is not\nbacked by memory this process owns, so it is read asynchronously over\nIPC. Reading it back as an ArrayBuffer and decoding it with\ndecodeAudioData used to hang, and so did seeking close to the end of the\nre-encoded WAV shortly after canplaythrough, with two elements sharing\nthe data.\n\nThe WAV is padded with a 1kHz tone, like in the reporter's application, so that it\nexceeds the 1MB IPC inline serialization limit and the far seek is meaningful.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314416\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314696\n", "files": ["dom/media/test/mochitest.toml", "dom/media/test/test_blob_from_cachestorage_audio_seeks.html"], "git_node": "2218cee38276ebaa051a246d2cdaf9a262f39c1a", "git_parents": ["441c2e64fc15445928ee53dced943734e9d0b508"], "node": "3c02dbdc2bdb1d16b3436210d2ea5a13a1289d73", "parents": ["9e9f27223fa2a94e1cfa726ae0cd1239b4240528"], "tags": []}], "date": 1785407825, "git_changesets": ["d74305999d7c804f80cedb6eacdf4ba1896e9cf1", "441c2e64fc15445928ee53dced943734e9d0b508", "2218cee38276ebaa051a246d2cdaf9a262f39c1a"], "user": "dsmith@mozilla.com"}, "27709": {"changesets": [{"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057778 - Verify target document after ancestor revealing algorithm in GoToAnchor.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314590\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314625\n", "files": ["layout/base/PresShell.cpp"], "git_node": "afc3c1851ef0f758e51425a7b1d05f1a23ccf638", "git_parents": ["2218cee38276ebaa051a246d2cdaf9a262f39c1a"], "node": "3ee29312c838348a9187c21ab17c1496f2280bb5", "parents": ["3c02dbdc2bdb1d16b3436210d2ea5a13a1289d73"], "tags": []}], "date": 1785407890, "git_changesets": ["afc3c1851ef0f758e51425a7b1d05f1a23ccf638"], "user": "dsmith@mozilla.com"}, "27710": {"changesets": [{"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2057393 - Set `GeckoEditableParent` if not set when taking a focus.  a=diannaS\n\nWhen opening a new window, virtual keyboard might not work because\n`GeckoEditableParent` is not set.\n\nNormally, it is creates and attched with parent process when global document\nis created. If it is too early, it is rarely failed since root window isn't\nfound yet.\n\nWe have a fallback path to create it when taking a IME focus, but it forget\nattaching with parent process. So we should attach it on fallback path.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313929\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315217\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/TextInputDelegateTest.kt", "widget/android/GeckoEditableSupport.cpp", "widget/android/GeckoEditableSupport.h", "widget/android/GeckoProcessManager.cpp", "widget/android/GeckoProcessManager.h"], "git_node": "86e40fd0288a4926ceb2e3537c70994143276a7f", "git_parents": ["afc3c1851ef0f758e51425a7b1d05f1a23ccf638"], "node": "cb90484441187571937d06d90448ae839db72df4", "parents": ["3ee29312c838348a9187c21ab17c1496f2280bb5"], "tags": []}], "date": 1785408089, "git_changesets": ["86e40fd0288a4926ceb2e3537c70994143276a7f"], "user": "dsmith@mozilla.com"}, "27711": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056865: Skip zone writer for dragged http/https URLs on Windows  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314233\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315034\n", "files": ["widget/windows/nsDataObj.cpp", "widget/windows/nsDataObj.h"], "git_node": "efc6f8c3355a63baa889b01bb5c63d9e31f7fc92", "git_parents": ["86e40fd0288a4926ceb2e3537c70994143276a7f"], "node": "2b3464c7acec13155aa30f9fdcfecb552561e5ff", "parents": ["cb90484441187571937d06d90448ae839db72df4"], "tags": []}], "date": 1785408185, "git_changesets": ["efc6f8c3355a63baa889b01bb5c63d9e31f7fc92"], "user": "dsmith@mozilla.com"}, "27712": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057118 - Reset the picture region when the decoder adopts a new image size from the stream.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314546\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315002\n", "files": ["dom/media/MediaInfo.h", "dom/media/platforms/wrappers/MediaChangeMonitor.cpp"], "git_node": "3b17f1cabe9906e633e30139601c082515b91578", "git_parents": ["efc6f8c3355a63baa889b01bb5c63d9e31f7fc92"], "node": "4b43d4c62b68a90407d1833117113b6631e7634a", "parents": ["2b3464c7acec13155aa30f9fdcfecb552561e5ff"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057118 - Constrain the picture rectangle to the image buffer when building a video frame.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314547\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315003\n", "files": ["dom/media/MediaData.cpp", "dom/media/platforms/wmf/WMFVideoMFTManager.cpp"], "git_node": "a1f1b12f4d9deb15b5619c34043b7cfa3e207258", "git_parents": ["3b17f1cabe9906e633e30139601c082515b91578"], "node": "d017fdc4555656c7f985ce7f7e572a8edb589212", "parents": ["4b43d4c62b68a90407d1833117113b6631e7634a"], "tags": []}], "date": 1785409326, "git_changesets": ["3b17f1cabe9906e633e30139601c082515b91578", "a1f1b12f4d9deb15b5619c34043b7cfa3e207258"], "user": "dsmith@mozilla.com"}, "27713": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2057692 - Make `RangeBoundaryBase::IsSetAndValid()` use right API to get the max offset of the parent  a=diannaS\n\nIf `mTreeKind` is for `TreeKind::FlatForSelection`, `mParent-\u003eLength()`\nis wrong API if `mParent` is a shadow host or a `\u003cslot\u003e` which has\nsome assigned nodes.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314582\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314833\n", "files": ["dom/base/RangeBoundary.h", "testing/web-platform/tests/selection/crashtests/selection-modify-line-into-svg-use.html"], "git_node": "640567484703618b84ce67623335835160163535", "git_parents": ["a1f1b12f4d9deb15b5619c34043b7cfa3e207258"], "node": "1936a2d9c4d5d46631f6fb6e65d7b7b992355257", "parents": ["d017fdc4555656c7f985ce7f7e572a8edb589212"], "tags": []}], "date": 1785412202, "git_changesets": ["640567484703618b84ce67623335835160163535"], "user": "dsmith@mozilla.com"}, "27714": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050482 - Filter ServiceWorker cookiechange events,  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312963\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315275\n", "files": ["dom/cookiestore/CookieStoreNotifier.cpp", "dom/cookiestore/CookieStoreParent.cpp", "dom/cookiestore/CookieStoreSubscriptionService.cpp"], "git_node": "681a6e0eedeb5e53d8550ebad284c0dcd9575ba4", "git_parents": ["640567484703618b84ce67623335835160163535"], "node": "21e9f2acf991224199b06398552fb531422be852", "parents": ["1936a2d9c4d5d46631f6fb6e65d7b7b992355257"], "tags": []}], "date": 1785415434, "git_changesets": ["681a6e0eedeb5e53d8550ebad284c0dcd9575ba4"], "user": "dsmith@mozilla.com"}, "27715": {"changesets": [{"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057680 - Fix Add-Container dialog size  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314267\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315223\n", "files": ["browser/components/preferences/dialogs/containers.js", "browser/components/preferences/tests/privacy/browser.toml", "browser/components/preferences/tests/privacy/browser_containers_dialog_size.js"], "git_node": "b5aa6d9f9a2b4e27f360a53b6ad51d6112e664c6", "git_parents": ["681a6e0eedeb5e53d8550ebad284c0dcd9575ba4"], "node": "a636457837be4dadf5d4d4d7200e81380caa357c", "parents": ["21e9f2acf991224199b06398552fb531422be852"], "tags": []}], "date": 1785418159, "git_changesets": ["b5aa6d9f9a2b4e27f360a53b6ad51d6112e664c6"], "user": "dsmith@mozilla.com"}, "27716": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 70679dc17d13e6a5082805d9823d62ece968cd81 with FIREFOX-ANDROID_153_0_2_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "44675888e529be724ea22e6275a50f522b68f203", "git_parents": ["2d6a09b064082bfca4f19deec41b2870bcb28e0e"], "node": "f6c872a50a003443800f8bb781603eacc51c8d9d", "parents": ["c2bc15c9dd71bbfd1ca4b98807f00aeba01311e6"], "tags": []}], "date": 1785431654, "git_changesets": ["44675888e529be724ea22e6275a50f522b68f203"], "user": "ffxbld@lando.moz.tools"}, "27717": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058575 - Center the Ctrl-Tab preview labels with text-align.  a=diannaS\n\nThe labels were centered by justify-content, which had an effect only while\nlabel:where([value]) computed to inline-flex. Bug 2049182 removed that rule, so\nthe label is a block container, the declaration is inert, and each title sits\nflush with the left edge of its thumbnail. text-align centers the inline text\nwhatever the label's display resolves to.\n\nTo verify: open the Ctrl-Tab panel (browser.ctrlTab.sortByRecentlyUsed) on tabs\nwith short titles and check each title against its thumbnail's center. Long\ntitles were unaffected either way, since they fill the label's width.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314707\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315312\n", "files": ["browser/themes/shared/tabbrowser/ctrlTab.css"], "git_node": "6fd76194a39152deb5bddc362379034b9602d095", "git_parents": ["b5aa6d9f9a2b4e27f360a53b6ad51d6112e664c6"], "node": "999f900a23196223a1f844d2d64fe6ee6a49dd1e", "parents": ["a636457837be4dadf5d4d4d7200e81380caa357c"], "tags": []}], "date": 1785435034, "git_changesets": ["6fd76194a39152deb5bddc362379034b9602d095"], "user": "dsmith@mozilla.com"}, "27718": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2057308.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313983\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314194\n", "files": ["image/RasterImage.cpp", "image/RasterImage.h"], "git_node": "b9cd4153f8c63f515fc8316dea6638cbe25af3f9", "git_parents": ["6fd76194a39152deb5bddc362379034b9602d095"], "node": "6925955b173f816d6f672fcdbfc8a4bfc16fdfb2", "parents": ["999f900a23196223a1f844d2d64fe6ee6a49dd1e"], "tags": []}], "date": 1785435100, "git_changesets": ["b9cd4153f8c63f515fc8316dea6638cbe25af3f9"], "user": "dsmith@mozilla.com"}, "27719": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053582 - Mask invalid values in SetCanBreakBefore.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314763\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314937\n", "files": ["gfx/thebes/gfxFont.h"], "git_node": "845c645b7219c43d2165c803d5518e2a6ccf4c5d", "git_parents": ["b9cd4153f8c63f515fc8316dea6638cbe25af3f9"], "node": "660b5119b34127959c195b82254feed249b6d403", "parents": ["6925955b173f816d6f672fcdbfc8a4bfc16fdfb2"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053582 - Pass glyph count in to GetDetailedGlyphs.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314764\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314938\n", "files": ["gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxTextRun.cpp", "gfx/thebes/gfxTextRun.h", "layout/generic/nsTextFrame.cpp", "layout/generic/nsTextRunTransformations.cpp", "layout/mathml/nsMathMLChar.cpp", "layout/painting/nsCSSRendering.cpp"], "git_node": "76db0f747948596e6f3037142d6f28bcfbe6bccf", "git_parents": ["845c645b7219c43d2165c803d5518e2a6ccf4c5d"], "node": "41dd671de10cc59f2d64cf2d511aa6475975594e", "parents": ["660b5119b34127959c195b82254feed249b6d403"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053582 - Strengthen offset validation in gfxGraphiteShaper.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314765\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314939\n", "files": ["gfx/thebes/gfxGraphiteShaper.cpp"], "git_node": "f1654173b99d507ab3ffc862ff98ad250cc03a57", "git_parents": ["76db0f747948596e6f3037142d6f28bcfbe6bccf"], "node": "3b5a898a194e997c341872ec8841cb55c217476b", "parents": ["41dd671de10cc59f2d64cf2d511aa6475975594e"], "tags": []}], "date": 1785435224, "git_changesets": ["845c645b7219c43d2165c803d5518e2a6ccf4c5d", "76db0f747948596e6f3037142d6f28bcfbe6bccf", "f1654173b99d507ab3ffc862ff98ad250cc03a57"], "user": "dsmith@mozilla.com"}, "27720": {"changesets": [{"author": "Olivia \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2032175 - Let Firefox Labs on Android ride the trains  a=diannaS\n\nPatch enables Firefox Labs for Android.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310118\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315368\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FeatureFlags.kt"], "git_node": "4066a0f896abd09d3579bd9cf937f35bd4f363cb", "git_parents": ["f1654173b99d507ab3ffc862ff98ad250cc03a57"], "node": "4fa4cc778c57d2346da25ad65e1b00f5e74b4f18", "parents": ["3b5a898a194e997c341872ec8841cb55c217476b"], "tags": []}], "date": 1785435779, "git_changesets": ["4066a0f896abd09d3579bd9cf937f35bd4f363cb"], "user": "dsmith@mozilla.com"}, "27721": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057103.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314204\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315161\n", "files": ["gfx/thebes/gfxDWriteFonts.cpp", "gfx/thebes/gfxDWriteFonts.h"], "git_node": "0d0aaa43f731ff855ffb6cc6b31fd2deec39058c", "git_parents": ["4066a0f896abd09d3579bd9cf937f35bd4f363cb"], "node": "481ca959f4dcc6a8ebf113036ffc08ce5942075e", "parents": ["4fa4cc778c57d2346da25ad65e1b00f5e74b4f18"], "tags": []}], "date": 1785435823, "git_changesets": ["0d0aaa43f731ff855ffb6cc6b31fd2deec39058c"], "user": "dsmith@mozilla.com"}, "27722": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051897: Reference .part files in a download analysis  a=diannaS\n\nIf the download contents are in a part file then pass that to CA.  Tests\ncheck that the passed file exists and that the final (non-part) filename\nexists after the analysis.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313078\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315376\n", "files": ["toolkit/components/contentanalysis/tests/browser/browser_download_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/browser_download_save_link_as_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/head.js", "toolkit/components/downloads/DownloadIntegration.sys.mjs"], "git_node": "d19a287b99357717a4a87f93a3cae19db72c2add", "git_parents": ["0d0aaa43f731ff855ffb6cc6b31fd2deec39058c"], "node": "e2bf6a18b871da59ebc2ede64fa83a36956e5baf", "parents": ["481ca959f4dcc6a8ebf113036ffc08ce5942075e"], "tags": []}], "date": 1785435936, "git_changesets": ["d19a287b99357717a4a87f93a3cae19db72c2add"], "user": "dsmith@mozilla.com"}, "27723": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315432\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": "2638fdbb3e5654889a12e07c6e7c0290ead6beb0", "git_parents": ["d19a287b99357717a4a87f93a3cae19db72c2add"], "node": "074dd0117810c336fc7ff9d9330379123954d137", "parents": ["e2bf6a18b871da59ebc2ede64fa83a36956e5baf"], "tags": []}], "date": 1785442171, "git_changesets": ["2638fdbb3e5654889a12e07c6e7c0290ead6beb0"], "user": "rvandermeulen@mozilla.com"}, "27724": {"changesets": [{"author": "Haik Aftandilian \u003chafta@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2044478 - Add profile container App Group to production entitlements for Developer Edition  a=diannaS\n\nAdd the app group for accessing App Group Container Firefox profiles to\nDeveloper Edition, matching Nightly. Release and Beta share the same\nbundle ID so we'll add those later after Developer Edition has been\nvalidated and the Beta/Release provisioning profiles are updated. The\nDeveloper Edition provisioning profile already includes the App Group\nContainer.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310736\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315456\n", "files": ["security/mac/hardenedruntime/production/firefoxdeveloperedition.browser.xml"], "git_node": "0a74a95f7690a00b194c74395a803dd4b0f9d095", "git_parents": ["2638fdbb3e5654889a12e07c6e7c0290ead6beb0"], "node": "1e0cf22a40d8b534f2aaa4eb06a9f71888c96b5f", "parents": ["074dd0117810c336fc7ff9d9330379123954d137"], "tags": []}], "date": 1785456440, "git_changesets": ["0a74a95f7690a00b194c74395a803dd4b0f9d095"], "user": "dsmith@mozilla.com"}, "27725": {"changesets": [{"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050291 - Create SplitView Trigger that gets fired on using split view feature  a=diannaS\n\n- add a new `splitViewUsed` trigger that fires after a configurable delay (`browser.tabs.splitview.trigger.delay_ms`, default 15s) of continuous Split View use, cancelling if the user leaves Split View before the delay elapses and restarting if they return\n- expose `splitViewCreateCount` in the trigger context (`browser.tabs.splitview.trigger.createCount`), tracking distinct Split View creations so message targeting can apply usage-based conditions (e.g. excluding first-time users)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308664\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315387\n", "files": ["browser/app/profile/firefox.js", "browser/components/asrouter/modules/ASRouterTriggerListeners.sys.mjs", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/browser/browser_trigger_listeners.js", "toolkit/components/messaging-system/schemas/TriggerActionSchemas/index.md"], "git_node": "92846a7118072317842fdda041a1495de2d3a7b4", "git_parents": ["0a74a95f7690a00b194c74395a803dd4b0f9d095"], "node": "e02984f1e0d86907ae0e4d5a9ca1505346d1c891", "parents": ["1e0cf22a40d8b534f2aaa4eb06a9f71888c96b5f"], "tags": []}], "date": 1785456460, "git_changesets": ["92846a7118072317842fdda041a1495de2d3a7b4"], "user": "dsmith@mozilla.com"}, "27726": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055056.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312202\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315165\n", "files": ["dom/canvas/WebGLTransformFeedback.cpp"], "git_node": "e6446d0938d3264bf6a4fca92756ce100038b55b", "git_parents": ["92846a7118072317842fdda041a1495de2d3a7b4"], "node": "e52fc9618f7dbfc840831162c073405c0d16dbf6", "parents": ["e02984f1e0d86907ae0e4d5a9ca1505346d1c891"], "tags": []}], "date": 1785456516, "git_changesets": ["e6446d0938d3264bf6a4fca92756ce100038b55b"], "user": "dsmith@mozilla.com"}, "27727": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053607.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311416\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315150\n", "files": ["gfx/wr/swgl/src/swgl_ext.h"], "git_node": "fb01abc8119b85c1d644b626f8e85d7d7c1751e3", "git_parents": ["e6446d0938d3264bf6a4fca92756ce100038b55b"], "node": "2398b60192694136cf06680bf4d05a853c2570fb", "parents": ["e52fc9618f7dbfc840831162c073405c0d16dbf6"], "tags": []}], "date": 1785456588, "git_changesets": ["fb01abc8119b85c1d644b626f8e8