68a76e28cbca", "1a6ed42ee7026ba7431ee83c63a6b5b02c94dd4b", "f8e0bf8d4c17c0342215d10cb17e72e35da5309c"], "user": "dsmith@mozilla.com"}, "27649": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051272 - Validate h3 Alt-Svc mappings under Happy Eyeballs,  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313385\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314354\n", "files": ["netwerk/ipc/NeckoChannelParams.ipdlh", "netwerk/protocol/http/AlternateServices.cpp", "netwerk/protocol/http/ConnectionEntry.h", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/HappyEyeballsTransaction.cpp", "netwerk/protocol/http/nsHttpConnectionInfo.cpp", "netwerk/protocol/http/nsHttpConnectionInfo.h", "netwerk/protocol/http/nsHttpConnectionMgr.cpp", "netwerk/test/unit/test_bug2052534.js", "netwerk/test/unit/test_http3_alt_svc_validation.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "898510e43949dcdfb7963eacf1985d6e47055add", "git_parents": ["f8e0bf8d4c17c0342215d10cb17e72e35da5309c"], "node": "cac567fa2280c1ce30d36498e51d0a9c5c78a17d", "parents": ["6dd05708dd7a2401a044272f7bef2eb7fa211774"], "tags": []}], "date": 1785179550, "git_changesets": ["898510e43949dcdfb7963eacf1985d6e47055add"], "user": "dsmith@mozilla.com"}, "27650": {"changesets": [{"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2057429 - Fix pullToRefreshPreferenceTest UI test  a=diannaS\n\nThe UI test was failing because it didn't scroll to the end of the \"Customize\" settings sub menu, and couldn't click the pull to refresh toggle.\n\nAdded a change to the way we do the scrolling, namely now we scroll to the end of the sub menu.\n\nThe UI test successfully passed 15x on Firebase using the main branch \u2705\nThe UI test successfully passed 15x on Firebase using the beta branch \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313958\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuCustomizeRobot.kt"], "git_node": "c7dbf6bcaa18d52f569f58250fc3b615c54d3d79", "git_parents": ["898510e43949dcdfb7963eacf1985d6e47055add"], "node": "b49946f8b3b59122247dab2cbf722c5bfd109ed0", "parents": ["cac567fa2280c1ce30d36498e51d0a9c5c78a17d"], "tags": []}], "date": 1785179729, "git_changesets": ["c7dbf6bcaa18d52f569f58250fc3b615c54d3d79"], "user": "dsmith@mozilla.com"}, "27651": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053174 - Compare source and destination surface sizes in ConvertToRGBA.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313543\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314415\n", "files": ["dom/media/ImageConversion.cpp"], "git_node": "e23004c59ee0f43b2b1e7d4497fcf224a3003e2a", "git_parents": ["c7dbf6bcaa18d52f569f58250fc3b615c54d3d79"], "node": "7cd6ea24efa714d87ff17ef1eaf8e2f791bb211d", "parents": ["b49946f8b3b59122247dab2cbf722c5bfd109ed0"], "tags": []}], "date": 1785180795, "git_changesets": ["e23004c59ee0f43b2b1e7d4497fcf224a3003e2a"], "user": "dsmith@mozilla.com"}, "27652": {"changesets": [{"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2048201 - Adjust padding inline end on #nav-bar for smart window  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313622\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314411\n", "files": ["browser/themes/shared/browser-shared.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "10af1a87103c1a7f62bb95bf90c6307a3acafa87", "git_parents": ["e23004c59ee0f43b2b1e7d4497fcf224a3003e2a"], "node": "f7b3b812231fdd8d01944cb33e4a322a550b2c90", "parents": ["7cd6ea24efa714d87ff17ef1eaf8e2f791bb211d"], "tags": []}], "date": 1785181065, "git_changesets": ["10af1a87103c1a7f62bb95bf90c6307a3acafa87"], "user": "dsmith@mozilla.com"}, "27653": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056373 - Update browser icon moz-promo illustrations to look better in the dark theme.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313100\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314414\n", "files": ["toolkit/themes/shared/illustrations/kit-confetti.svg", "toolkit/themes/shared/illustrations/kit-holding-lock.svg"], "git_node": "94521b689841b70b7cf0901324daac85bd06cbea", "git_parents": ["10af1a87103c1a7f62bb95bf90c6307a3acafa87"], "node": "af69050323df559c8fa1292ff2b0f76ed5747ffb", "parents": ["f7b3b812231fdd8d01944cb33e4a322a550b2c90"], "tags": []}], "date": 1785181374, "git_changesets": ["94521b689841b70b7cf0901324daac85bd06cbea"], "user": "dsmith@mozilla.com"}, "27654": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055674 - Generate the black image for muted video chunks at the encoder's coded size.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313518\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314412\n", "files": ["dom/media/VideoSegment.cpp", "dom/media/VideoSegment.h", "dom/media/encoder/VP8TrackEncoder.cpp"], "git_node": "cb8ffa473f2aa7c074ede50e38bf4f01baea64c7", "git_parents": ["94521b689841b70b7cf0901324daac85bd06cbea"], "node": "43b23f590f1597dc293edad687c6977a595e7d8f", "parents": ["af69050323df559c8fa1292ff2b0f76ed5747ffb"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055674 - Constrain the MP4 track display size to the maximum image dimension.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313519\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314413\n", "files": ["dom/media/VideoUtils.cpp", "dom/media/VideoUtils.h", "dom/media/mp4/DecoderData.cpp"], "git_node": "b3ce9397524468e0d17c1630fd759fe9c048dd45", "git_parents": ["cb8ffa473f2aa7c074ede50e38bf4f01baea64c7"], "node": "48c8e616768f463fc9ae2870fc01cd388512e423", "parents": ["43b23f590f1597dc293edad687c6977a595e7d8f"], "tags": []}], "date": 1785181752, "git_changesets": ["cb8ffa473f2aa7c074ede50e38bf4f01baea64c7", "b3ce9397524468e0d17c1630fd759fe9c048dd45"], "user": "dsmith@mozilla.com"}, "27655": {"changesets": [{"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055794 - Remove 'taskcluster-taskgraph' version check from pysites linter,  a=diannaS\n\nEnforcing we keep the versions synced adds unnecessary busy work and\nmeans we need to deal with bustage in other places (like the build\nsystem) more often than would otherwise be necessary.\n\nThe Decision task and build system are two separate unrelated code bases\nthat depend on `taskcluster-taskgraph` for different reasons. This\nscenario is no different than any other two dependencies listed under\n`python/sites`. We don't enforce compatibility between sites for\nanything else, so why should `taskcluster-taskgraph` be special?\n\nTo clarify, I do think it's good to keep dependencies up to date in\ngeneral. But if you're bumping Taskgraph to pick up a change in the\nDecision task, you should not be forced to also update the build systems\ndependencies. That is a separate task.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312813\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314451\n", "files": ["tools/lint/python-sites.yml", "tools/lint/python-sites/__init__.py"], "git_node": "eefff612df75edb2c99833fdf42446e2547f8e71", "git_parents": ["b3ce9397524468e0d17c1630fd759fe9c048dd45"], "node": "919679a94dc75c898a87ecd00e686cf870acce77", "parents": ["48c8e616768f463fc9ae2870fc01cd388512e423"], "tags": []}], "date": 1785182249, "git_changesets": ["eefff612df75edb2c99833fdf42446e2547f8e71"], "user": "dsmith@mozilla.com"}, "27656": {"changesets": [{"author": "Christopher DiPersio \u003ccdipersio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057024 - Memories in v1 schema pre-source field do not convert to v2 a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313610\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314464\n", "files": ["browser/components/aiwindow/services/MemoryStore.sys.mjs", "browser/components/aiwindow/services/tests/xpcshell/test_MemoryStore.js"], "git_node": "c1d8f54b0fb84423490e35a1eb09cd66b35c8e09", "git_parents": ["eefff612df75edb2c99833fdf42446e2547f8e71"], "node": "ba87615ac5d4181a5bcc2579e4afef063974c441", "parents": ["919679a94dc75c898a87ecd00e686cf870acce77"], "tags": []}, {"author": "lougeniac64 \u003c5533446+lougeniaC64@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2050221 - Added bookmark menu items for send tab a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308620\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314465\n", "files": ["browser/base/content/browser-menubar.inc.xhtml", "browser/base/content/browser-places.js", "browser/base/content/test/sync/browser_sync.js"], "git_node": "fd2e02e8b01794c976af1184e082acc14a13bc52", "git_parents": ["c1d8f54b0fb84423490e35a1eb09cd66b35c8e09"], "node": "0f0a86a53b39cd2c80ccdb131e91071a08d30697", "parents": ["ba87615ac5d4181a5bcc2579e4afef063974c441"], "tags": []}], "date": 1785182374, "git_changesets": ["c1d8f54b0fb84423490e35a1eb09cd66b35c8e09", "fd2e02e8b01794c976af1184e082acc14a13bc52"], "user": "dsmith@mozilla.com"}, "27657": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055902 - Prevent long solid borders from scaling down the corner tasks.  a=diannaS\n\nThe solid corners don't use render tasks so they don't need to be considered when picking the largest task side.\n\nOriginal Revision: https://phabri