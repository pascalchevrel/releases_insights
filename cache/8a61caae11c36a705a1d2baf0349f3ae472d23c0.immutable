main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-rm/strings.xml", "mobile/android/fenix/app/src/main/res/values-ro/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sat/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sr/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-th/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-ug/strings.xml", "mobile/android/fenix/app/src/main/res/values-uk/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml"], "git_node": "eb58ade0f0d49af6c2fa86df7065c9837a2d8b05", "git_parents": ["2eba43e9c3e6b564db8bb52830a2bf9737b982aa"], "node": "1823770960a2ac0489cf9504a4e869f5a312c624", "parents": ["1c5bdcc8cd7ce8c3bce54d89852df44346bb6039"], "tags": []}], "date": 1785291513, "git_changesets": ["eb58ade0f0d49af6c2fa86df7065c9837a2d8b05"], "user": "ffxbld@lando.moz.tools"}, "27670": {"changesets": [{"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2053223 - Update styles for system-prompt-spotlight.  a=diannaS\n\nOur system prompt spotlight doesn't fully visually match system prompts. This bug is for fixing that.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311192\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314749\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "778ac86cebaa2322faab737a19195d27294696a4", "git_parents": ["eb58ade0f0d49af6c2fa86df7065c9837a2d8b05"], "node": "f98f4bab9c73f7d2c17279d35ba6defd9255c3a0", "parents": ["1823770960a2ac0489cf9504a4e869f5a312c624"], "tags": []}], "date": 1785291954, "git_changesets": ["778ac86cebaa2322faab737a19195d27294696a4"], "user": "dsmith@mozilla.com"}, "27671": {"changesets": [{"author": "Shane Hughes \u003cshughes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053221 - Support fire and forget for PIN_FIREFOX_TO_TASKBAR action.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311190\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314747\n", "files": ["browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_upgrade_multistage_mr.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_pin_firefox.js"], "git_node": "71f2b7d00e2fa8316ce8dad11ab3ed1467fd9172", "git_parents": ["778ac86cebaa2322faab737a19195d27294696a4"], "node": "462f26b47b8f06c3cd3f6c81488b316cb8d44ed9", "parents": ["f98f4bab9c73f7d2c17279d35ba6defd9255c3a0"], "tags": []}], "date": 1785291995, "git_changesets": ["71f2b7d00e2fa8316ce8dad11ab3ed1467fd9172"], "user": "dsmith@mozilla.com"}, "27672": {"changesets": [{"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2022656 - Implement lastWindowClose trigger  a=diannaS\n\nSupersedes D297136 which implemented a quitRequested trigger scoped to app quit in favor of triggering on last window close (known limitation that this trigger does not run if window is closed simply by clearing out all tabs).\n\n- Dispatches an ASRouter \"lastWindowClose\" trigger.\n- Cancels the last window close while a message is pending.\n- Once the message's closedPromise resolves, reissues the window close.\n- A module-level guard prevents dispatching a second message if the user attempts to close the same window again while the first is still pending.\n\n**Important notes for when this is used in practice: ** This trigger is scoped to use with the Spotlight modal only. When a lastWindowClose triggered Spotlight message's button fires a SpecialMessageAction(s) that needs to complete before the window actually closes, set `\"needsAwait\": true` on the action(s).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312782\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314746\n", "files": ["browser/base/content/browser.js", "browser/base/content/browser.js.globals", "browser/components/asrouter/metrics.yaml", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/Spotlight.sys.mjs", "browser/components/asrouter/tests/unit/ASRouter.test.js", "browser/components/tests/browser/browser.toml", "browser/components/tests/browser/browser_last_window_close_trigger.js", "toolkit/components/messaging-system/schemas/TriggerActionSchemas/index.md"], "git_node": "1ac9fdf21a7f3142f4438f4613e6de1990131d9c", "git_parents": ["71f2b7d00e2fa8316ce8dad11ab3ed1467fd9172"], "node": "4e8b8c02910f0a6a6d89d3f260335f97a3100000", "parents": ["462f26b47b8f06c3cd3f6c81488b316cb8d44ed9"], "tags": []}], "date": 1785292230, "git_changesets": ["1ac9fdf21a7f3142f4438f4613e6de1990131d9c"], "user": "dsmith@mozilla.com"}, "27673": {"changesets": [{"author": "hanna.alemu \u003chalemu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056707 - Add preferenceIsLocked JEXL filter expression  a=diannaS\n\nAdd a preferenceIsLocked filter to FilterExpressions, wrapping\nServices.prefs.prefIsLocked. This lets messaging targeting avoid offering an\naction whose preference is locked (e.g. by enterprise policy), since setting a\nlocked pref would silently no-op.\n\nThe filter is available anywhere FilterExpressions is used, including ASRouter\nmessage targeting. A nonexistent pref evaluates to false rather than throwing,\nso arbitrary keys are safe.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313322\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314737\n", "files": ["browser/components/asrouter/docs/targeting-guide.md", "toolkit/components/utils/FilterExpressions.sys.mjs", "toolkit/components/utils/test/unit/test_FilterExpressions.js"], "git_node": "159df5ce2b5f6695668c0467dd90114e08b1e165", "git_parents": ["1ac9fdf21a7f3142f4438f4613e6de1990131d9c"], "node": "94b26b00ec2cdce44e71d1c9b38798f48056ceb7", "parents": ["4e8b8c02910f0a6a6d89d3f260335f97a3100000"], "tags": []}], "date": 1785292747, "git_changesets": ["159df5ce2b5f6695668c0467dd90114e08b1e165"], "user": "dsmith@mozilla.com"}, "27674": {"changesets": [{"author": "Shane Hughes \u003cshughes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057060 - Make launch-on-login attributes and targeting usable by Nimbus.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313652\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314736\n", "files": ["toolkit/components/nimbus/lib/TargetingContextRecorder.sys.mjs", "toolkit/components/nimbus/metrics.yaml"], "git_node": "af515fd3e7d139ffde26efedd031add0de494e73", "git_parents": ["159df5ce2b5f6695668c0467dd90114e08b1e165"], "node": "9b6c4a90c02d2555d58a085cd60f1a004dcde9d4", "parents": ["94b26b00ec2cdce44e71d1c9b38798f48056ceb7"], "tags": []}], "date": 1785293643, "git_changesets": ["af515fd3e7d139ffde26efedd031add0de494e73"], "user": "dsmith@mozilla.com"}, "27675": {"changesets": [{"author": "David Rubino \u003cdrubino@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056462 - Add launchOnLoginAllowedByPolicy targeting getter for launch-options eligibility.  a=diannaS\n\nThe launch-options-for-existing-users experiment needs to gate enrollment on\nwhether launch on login could be enabled for a user, which was not previously\nexpressible in Nimbus or messaging targeting.\n\nlaunchOnLoginAllowedByPolicy exposes the isAllowedByPolicy value from\nWindowsLaunchOnLogin.getLaunchOnLoginEnablementDetails() so enrollment can\nexclude users for whom launch on login cannot be turned on (locked by Windows\nSettings or enterprise policy). Windows-only; false elsewhere.\n\nThe targeting-attributes.md doc entry is required by the TargetingDocs unit\ntest.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313154\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314735\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs"], "git_node": "e1b6a87088a01d5bb560e18576867d8bcb128c27", "git_parents": ["af515fd3e7d139ffde26efedd031add0de494e73"], "node": "1cc305fce831b16f2f2f90cb89130fd5cff17a80", "parents": ["9b6c4a90c02d2555d58a085cd60f1a004dcde9d4"], "tags": []}], "date": 1785293682, "git_changesets": ["e1b6a87088a01d5bb560e18576867d8bcb128c27"], "user": "dsmith@mozilla.com"}, "27676": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2057894 - Don't apply vertical-align to ::placeholder.  a=diannaS\n\nIn the regressing bug we did the same for line-height for similar\nreasons. In this case the site is setting vertical-align on\n::placeholder but expecting it not to have an effect.\n\nIt doesn't have an effect per spec:\n\n\u003e All properties that apply to the ::first-line pseudo-element also\n\u003e apply to the ::placeholder pseudo-element, except those defined in\n\u003e [CSS-INLINE-3].\n\nImplement that to the letter (which in practice only impacts\nvertical-align).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314283\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314605\n", "files": ["layout/style/test/property_database.js", "servo/components/style/properties/data.py", "testing/web-platform/tests/css/css-pseudo/placeholder-vertical-align-ref.html", "testing/web-platform/tests/css/css-pseudo/placeholder-vertical-align.html"], "git_node": "2087efbd1de6e24f57958c68cc1d22a35afdd50d", "git_parents": ["e1b6a87088a01d5bb560e18576867d8bcb128c27"], "node": "1ffab4ebcfd39f47ba7b516245b1cf7b0dc70fdf", "parents": ["1cc305fce831b16f2f2f90cb89130fd5cff17a80"], "tags": []}], "date": 1785293729, "git_changesets": ["2087efbd1de6e24f57958c68cc1d22a35afdd50d"], "user": "dsmith@mozilla.com"}, "27677": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058197: ensure the patch instruction for firefox.exe is the last instruction in partial mars  a=diannaS\n\nThis ensures that Firefox cannot be run in the middle of an update being applied, reducing the chances of hitting https://bugzilla.mozilla.org/show_bug.cgi?id=1681745 and similar issues.\n\nI verified this locally by:\n* Running a `partials` task locally in a docker container with the existing code\n* Running again after injecting this new code\n* Unpacking one of the generated partials and diffing the `updatev3.manifest` contents, which showed the `firefox.exe` instruction moving to the bottom of the manifest as expected:\n\n```\nworker@a087bd0a695f:~$ diff -Naur artifacts-nofix/part/updatev3.manifest artifacts/part/updatev3.manifest\n--- artifacts-nofix/part/updatev3.manifest\t2026-07-27 16:54:46.958931475 +0000\n+++ artifacts/part/updatev3.manifest\t2026-07-27 17:26:03.533519742 +0000\n@@ -35,7 +35,6 @@\n patch \"gkcodecs.dll.patch\" \"gkcodecs.dll\"\n patch \"freebl3.dll.patch\" \"freebl3.dll\"\n patch \"firefox.exe.sig.patch\" \"firefox.exe.sig\"\n-patch \"firefox.exe.patch\" \"firefox.exe\"\n patch \"dxcompiler.dll.patch\" \"dxcompiler.dll\"\n patch \"desktop-launcher/desktop-launcher.exe.patch\" \"desktop-launcher/desktop-launcher.exe\"\n add \"dependentlibs.list\"\n@@ -61,3 +60,4 @@\n add \"browser/confused_fox.pdf\"\n add \"browser/blank.pdf\"\n remove \"chrome.manifest\"\n+patch \"firefox.exe.patch\" \"firefox.exe\"\n```\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314801\n", "files": ["tools/update-packaging/make_incremental_update.sh"], "git_node": "594a1a73c50a2cf375e85e70bf9fa56f82c2727f", "git_parents": ["2087efbd1de6e24f57958c68cc1d22a35afdd50d"], "node": "8f3f85f8e631296a8a7dc1c14a61af38c78e9f92", "parents": ["1ffab4ebcfd39f47ba7b516245b1cf7b0dc70fdf"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058594: optimize partial MAR operation order to minimize the chance of crashes  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314721\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314802\n", "files": ["tools/update-packaging/make_incremental_update.sh"], "git_node": "25a1b6d8bd9e94bdfb2930694fd1219ad7004b6e", "git_parents": ["594a1a73c50a2cf375e85e70bf9fa56f82c2727f"], "node": "4084c17459e3343bd4ef4a7353d2df95641abed6", "parents": ["8f3f85f8e631296a8a7dc1c14a61af38c78e9f92"], "tags": []}], "date": 1785294671, "git_changesets": ["594a1a73c50a2cf375e85e70bf9fa56f82c2727f", "25a1b6d8bd9e94bdfb2930694fd1219ad7004b6e"], "user": "dsmith@mozilla.com"}, "27678": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump\n\nach -\u003e cf6d85332629ee45816d290f41c124b173b5565b\naf -\u003e cf6d85332629ee45816d290f41c124b173b5565b\nan -\u003e cf6d85332629ee45816d290f41c124b173b5565b\nar -\u003e cf6d85332629ee45816d290f41c124b173b5565b\nast -\u003e cf6d85332629ee45816d290f41c124b173b5565b\naz -\u003e cf6d85332629ee45816d290f41c124b