a4a26710d7a4f\nkn -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nko -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nlij -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nlo -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nlt -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nltg -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nlv -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nmeh -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nmix -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nml -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nmr -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nms -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nmy -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nnb-NO -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nne-NP -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nnl -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nnn-NO -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\noc -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\npa-IN -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\npl -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\npt-BR -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\npt-PT -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nrm -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nro -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nru -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nsk -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nsl -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nson -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nsq -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nsr -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nsv-SE -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nta -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nte -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nth -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\ntl -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\ntr -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\ntrs -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nuk -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nur -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nuz -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nvi -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nwo -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nxh -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nzam -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nzh-CN -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\nzh-TW -\u003e cb3b44455f8ef68a5633720a86da4a26710d7a4f\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "cd6ab8791da6dfcdd9229dbcbc066ad1dc4ac7df", "git_parents": ["bb470d93bb0b6904d141a74ca69d324b15f26328"], "node": "3a03b34fee15a4e575ac05d4fde26f5ae170f2b3", "parents": ["e84c42f80cb092974e3b89329f34662c08067295"], "tags": []}], "date": 1784797423, "git_changesets": ["bb470d93bb0b6904d141a74ca69d324b15f26328", "cd6ab8791da6dfcdd9229dbcbc066ad1dc4ac7df"], "user": "ffxbld@lando.moz.tools"}, "27568": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055541 - Part 1: Hold the seek-resume clock to the audible position.  a=diannaS\n\nResuming after a seek advanced the reported clock on the system clock while the\naudio stream restarted, then re-anchored the reported position forward to\nwall-clock time when it switched to the audio clock. On a device with a large\noutput latency the audio only becomes audible well after the stream starts, so\nthe reported clock, and the video that follows it, ended up ahead of the audible\naudio by the resume gap and stayed there.\n\nFor example, seeking to 10s on a device with 200ms of output latency:\n\n  1. the stream restarts at 10s, but the speakers stay silent for 200ms;\n  2. before this change the reported clock jumped to about 10.2s during that\n     silence, so the video ran about 200ms ahead of the sound;\n  3. after this change the clock stays at 10s until the audio is actually heard,\n     then advances together with it.\n\nOn a seek resume, follow the audio stream's own position instead: hold the\nreported position at the seek target until the stream produces audio, then track\nit, on both the recreated-stream and reused-stream paths.\n\nA seek resume that begins while muted has no audio stream to follow, so playback\nadvances on the system clock. Drop the hold in that case so a later unmute takes\nthe normal system-clock handoff and the reported clock never jumps backwards.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312951\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313245\n", "files": ["dom/media/mediasink/AudioSinkWrapper.cpp", "dom/media/mediasink/AudioSinkWrapper.h"], "git_node": "001726df6379bd9f59ea6599f8dac60ed60ba6df", "git_parents": ["cd6ab8791da6dfcdd9229dbcbc066ad1dc4ac7df"], "node": "414dd79c3b53748081be9221eaf7e4e4daf71233", "parents": ["3a03b34fee15a4e575ac05d4fde26f5ae170f2b3"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055541 - Part 2: Drain pending events in the AudioSinkWrapper gtest callback helper.  a=diannaS\n\nThe AudioSinkWrapper gtests advance playback by hand and must pump the owner\nthread's event queue to observe asynchronously dispatched work (stream event\nlisteners, promise continuations). DriveCallback left that to each caller, which\nhad to follow it with a bare ProcessPending().\n\nDrain the queue inside DriveCallback after a callback runs, bundling the\nProcessPending() with the call that needs it so the tests read cleaner, and drop\nthe now-redundant ProcessPending() calls in the fixture helpers.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312952\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313246\n", "files": ["dom/media/gtest/TestAudioSinkWrapper.cpp"], "git_node": "df34dafe24fd5b625dd2dc6a6ca7fec753745aae", "git_parents": ["001726df6379bd9f59ea6599f8dac60ed60ba6df"], "node": "0fbacc2819fe057b9aaae21f4ff4326101c46304", "parents": ["414dd79c3b53748081be9221eaf7e4e4daf71233"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055541 - Part 3: Model output latency in MockCubeb and add seek-resume clock coverage.  a=diannaS\n\nMockCubeb reported its play cursor as equal to its write cursor, so a test\ncould not exercise a backend whose played position lags the written frames by\nthe output device's latency, as real backends do. Add a settable output latency\nso the reported play cursor lags the write cursor, letting tests reproduce\noutput-latency-dependent playback-clock behaviour without real audio hardware.\n\nBuilding on that, add gtest coverage for the seek-resume playback clock: it\nasserts the reported position never leads the audible audio after a seek resume,\nrun across both the reused-stream and freshly-created-stream paths.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312953\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313247\n", "files": ["dom/media/MockCubeb.cpp", "dom/media/MockCubeb.h", "dom/media/gtest/TestAudioSinkWrapper.cpp"], "git_node": "f8752e9430c65f20a5159f84802c23d4746d4d45", "git_parents": ["df34dafe24fd5b625dd2dc6a6ca7fec753745aae"], "node": "b717462bd3594ca7feaad11f66fe2e2688b7d20a", "parents": ["0fbacc2819fe057b9aaae21f4ff4326101c46304"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055541 - Part 4: Document the AudioSinkWrapper playback clock.  a=diannaS\n\nThe playback clock in AudioSinkWrapper selects between the audio-stream clock,\nthe system clock, and a held constant depending on the playback mode, and those\nmodes have grown to include seek resume on recreated and reused streams, unmute,\nand a seek while muted.\n\nAdd a docs page that lays out the clock model, the two invariants it must\nsatisfy, and each playback mode with the clock source it uses and why, so the\nbehaviour can be reviewed and maintained as a whole rather than reconstructed\nfrom the branches.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312954\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313248\n", "files": ["dom/media/docs/AudioSinkWrapper.md", "dom/media/docs/index.md"], "git_node": "6dad1267535e21b23d362d729845a3fc9070d899", "git_parents": ["f8752e9430c65f20a5159f84802c23d4746d4d45"], "node": "bd05d55d32c233daddeb858919633ea0504f875f", "parents": ["b717462bd3594ca7feaad11f66fe2e2688b7d20a"], "tags": []}], "date": 1784805377, "git_changesets": ["001726df6379bd9f59ea6599f8dac60ed60ba6df", "df34dafe24fd5b625dd2dc6a6ca7fec753745aae", "f8752e9430c65f20a5159f84802c23d4746d4d45", "6dad1267535e21b23d362d729845a3fc9070d899"], "user": "dsmith@mozilla.com"}, "27569": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054364 - Track render task grouping at sub-pass instead of surface level.  a=diannaS\n\nWith backdrop filters we can run into situations where a picture is rendered in two steps (two sub-passes). The first step is allocated into a shared texture atlas, then captured, and then the second step needs to render on top of the first with clearing disabled at the sub-pass level. Disabling clearing means we have to refrain from grouping other render tasks into the second sub-pass. However, since is_shared was tracked by the surface, and the first sub-pass was placed into a shared surface, the second sub-pass could in some circumstances receive other render tasks (which relied on clears but clearing was disabled, leading to glitches).\n\nThis patch tracks whether render tasks can be grouped at the sub-pass level so that the second step of a background filter can be correctly isolated even if the first step was put into a shared atlas.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313023\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313668\n", "files": ["gfx/wr/webrender/src/render_task_graph.rs"], "git_node": "a33f7028ba730fa4807fda4e73e6b1e323568b4b", "git_parents": ["6dad1267535e21b23d362d729845a3fc9070d899"], "node": "12bb6a86891519c9ec81afbafbb81f834beea5ee", "parents": ["bd05d55d32c233daddeb858919633ea0504f875f"], "tags": []}], "date": 1784805983, "git_changesets": ["a33f7028ba730fa4807fda4e73e6b1e323568b4b"], "user": "dsmith@mozilla.com"}, "27570": {"changesets": [{"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054416 - Validate RemoteTypeOverride.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312471\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313387\n", "files": ["docshell/base/nsDocShellLoadState.cpp", "netwerk/ipc/DocumentLoadListener.cpp"], "git_node": "5369379c98fa5a8151593bd3d060387ea4a9b652", "git_parents": ["a33f7028ba730fa4807fda4e73e6b1e323568b4b"], "node": "dfc3205eeeb2b314c7e0bcf8b606344086ce2c22", "parents": ["12bb6a86891519c9ec81afbafbb81f834beea5ee"], "tags": []}], "date": 1784808849, "git_changesets": ["5369379c98fa5a8151593bd3d060387ea4a9b652"], "user": "dsmith@mozilla.com"}, "27571": {"changesets": [{"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056155 - Handle uninitialized storage in uiBusy/isLoggedIn  a=diannaS\n\nSince LoginManagerStorage.create() became asynchronous (bug 2042808),\nthis._storage the  synchronous uiBusy and isLoggedIn getters could threw a\nTypeError during a small window before the storage has bneen set.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312993\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313695\n", "files": ["toolkit/components/passwordmgr/LoginManager.sys.mjs", "toolkit/components/passwordmgr/test/unit/test_module_LoginManager.js"], "git_node": "e580e023e07fa2e3fe332fc4249918e0e92c637d", "git_parents": ["5369379c98fa5a8151593bd3d060387ea4a9b652"], "node": "a69e819c63a7f74a0f63f4191acc601313a0ceb8", "parents": ["dfc3205eeeb2b314c7e0bcf8b606344086ce2c22"], "tags": []}], "date": 1784810626, "git_changesets": ["e580e023e07fa2e3fe332fc4249918e0e92c637d"], "user": "dsmith@mozilla.com"}, "27572": {"changesets": [{"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2054635 - Remove content from parent node before appending, r=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312076\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313203\n", "files": ["dom/xml/nsXMLContentSink.cpp"], "git_node": "e8163033b70c94faad14b9ce54d241b6bcb154bf", "git_parents": ["e580e023e07fa2e3fe332fc4249918e0e92c637d"], "node": "06d86d096755106646c1a9392184df743d4afe8f", "parents": ["a69e819c63a7f74a0f63f4191acc601313a0ceb8"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2046734: Add release assertions to SplitSingleCharHelper. a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311251\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313380\n", "files": ["js/src/builtin/String.cpp"], "git_node": "c25dae0ce263dc1ec96bc005f85cf15e1d2dd44f", "git_parents": ["e8163033b70c94faad14b9ce54d241b6bcb154bf"], "node": "8bc508c315fd131ab9afba47f4875456f793a71f", "parents": ["06d86d096755106646c1a9392184df743d4afe8f"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2047556 - Fix HCM styles for history thumbnail list scrollbar, a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309746\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313601\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-grid/ai-chat-grid.css", "browser/components/aiwindow/ui/components/ai-chat-message/ai-chat-message.css"], "git_node": "c54bb228ae13520b227160dc3adfa9b3949dd614", "git_parents": ["c25dae0ce263dc1ec96bc005f85cf15e1d2dd44f"], "node": "ec48330902f6689990a9399bec9f999f00792e64", "parents": ["8bc508c315fd131ab9afba47f4875456f793a71f"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2050380 Make shared memory transfer conditional on IsSharedMemoryAllowed(), a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312653\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313365\n", "files": ["dom/media/webaudio/AudioWorkletNode.cpp"], "git_node": "91e3e26fbd24df1da1cbf46bbbfb951d4f642df5", "git_parents": ["c54bb228ae13520b227160dc3adfa9b3949dd614"], "node": "055eaeaff6d095585f77cefeb53b07fb741e6d13", "parents": ["ec48330902f6689990a9399bec9f999f00792e64"], "tags": []}, {"author": "Artur Iunusov \u003caiunusov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048490 - Schedule queued workers on their owning thread, a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D307742\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313418\n", "files": ["dom/workers/RuntimeService.cpp", "dom/workers/RuntimeService.h", "dom/workers/WorkerPrivate.h"], "git_node": "b42a67f1cbe2a790aa34c9ac66f6e851b2fe0998", "git_parents": ["91e3e26fbd24df1da1cbf46bbbfb951d4f642df5"], "node": "8c414fd52118b7c05ba340550e81f3f21e883fc6", "parents": ["055eaeaff6d095585f77cefeb53b07fb741e6d13"], "tags": []}], "date": 1784813446, "git_changesets": ["e8163033b70c94faad14b9ce54d241b6bcb154bf", "c25dae0ce263dc1ec96bc005f85cf15e1d2dd44f", "c54bb228ae13520b227160dc3adfa9b3949dd614", "91e3e26fbd24df1da1cbf46bbbfb951d4f642df5", "b42a67f1cbe2a790aa34c9ac66f6e851b2fe0998"], "user": "dsmith@mozilla.com"}, "27573": {"changesets": [{"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2056152 - Revert the fix for bug 2033848.  a=diannaS\n\nRevert \"Bug 2033848 - Use non-default response ID for GTK file picker accept button. r=stransky\"\n\nThis reverts commit d07538533f1ab3d14e6ee7a58b928c26d952d754.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313053\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313548\n", "files": ["widget/gtk/nsFilePicker.cpp"], "git_node": "c1dbb8ca121ac06cd617b647a0ead9a4fe6ce357", "git_parents": ["b42a67f1cbe2a790aa34c9ac66f6e851b2fe0998"], "node": "49c300b60ec1523803dbf21625250601188aab78", "parents": ["8c414fd52118b7c05ba340550e81f3f21e883fc6"], "tags": []}], "date": 1784816950, "git_changesets": ["c1dbb8ca121ac06cd617b647a0ead9a4fe6ce357"], "user": "dsmith@mozilla.com"}, "27574": {"changesets": [{"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055429 - History icon should be visible on search results on Private Mode.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312477\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313664\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/awesomebar/SuggestionIconProvider.kt"], "git_node": "c818922bc20447deab6b665b82aed71d0dd09442", "git_parents": ["c1dbb8ca121ac06cd617b647a0ead9a4fe6ce357"], "node": "c45e3137f3133d752e3fdd122a6871fce9a59d08", "parents": ["49c300b60ec1523803dbf21625250601188aab78"], "tags": []}], "date": 1784823993, "git_changesets": ["c818922bc20447deab6b665b82aed71d0dd09442"], "user": "dsmith@mozilla.com"}, "27575": {"changesets": [{"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055173 - Only BrokenSite Other reason should not have \"optional\" in label, a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312263\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313686\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/store/WebCompatReporterStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporter.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "7ab273f9f4b82a08f810a60d1530d53840d8a8b6", "git_parents": ["c818922bc20447deab6b665b82aed71d0dd09442"], "node": "8f13dfa6ac4b0c1d059864e71e150ff9422e7437", "parents": ["c45e3137f3133d752e3fdd122a6871fce9a59d08"], "tags": []}, {"author": "James Graham \u003cjames@hoppipolla.co.uk\u003e", "branch": "default", "desc": "Bug 2052843 - Don't use lower leak threshold for Mozilla BiDi tests, a=dsmith\n\nUse the threshold defined for webdriver tests in general.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312493\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313721\n", "files": ["testing/web-platform/mozilla/meta/webdriver/bidi/__dir__.ini"], "git_node": "2be3cf876ef557d5ec3877c65afea1b2b9926092", "git_parents": ["7ab273f9f4b82a08f810a60d1530d53840d8a8b6"], "node": "db6f091a740991783ab3a95999b4df20a85a45de", "parents": ["8f13dfa6ac4b0c1d059864e71e150ff9422e7437"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041701 - History delete button should be visible when disabled with Light theme in Private mode, a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311522\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313665\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/HistoryFragment.kt", "mobile/android/fenix/app/src/main/res/values-night/colors.xml", "mobile/android/fenix/app/src/main/res/values/colors.xml"], "git_node": "3bb19961d7f0ef0989fd5ac124ea181e371da632", "git_parents": ["2be3cf876ef557d5ec3877c65afea1b2b9926092"], "node": "d9d7bfb9e176337322a95cf82dcd12857ad29517", "parents": ["db6f091a740991783ab3a95999b4df20a85a45de"], "tags": []}], "date": 1784824948, "git_changesets": ["7ab273f9f4b82a08f810a60d1530d53840d8a8b6", "2be3cf876ef557d5ec3877c65afea1b2b9926092", "3bb19961d7f0ef0989fd5ac124ea181e371da632"], "user": "dsmith@mozilla.com"}, "27576": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2053864 - Make `nsContentUtils::CompareChildNoes()` and `nsContentUtils::CompareChildOffsetAndChildNode()` handle unassigned node of a shadow host  a=diannaS\n\nWe compare the default fallback content of a `\u003cslot\u003e` which has some\nassigned nodes, but we don't do that for the unassigned nodes of a\nshadow host. This patch adds the unassigned case to the special\nhandling paths and fixes the assertion of checking the`CompareChildNodes`\nresult.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311773\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313393\n", "files": ["dom/base/nsContentUtils.cpp", "testing/web-platform/tests/selection/crashtests/selection-add-range-collapsed-in-unassigned-node-and-shadow-has-no-content.html"], "git_node": "36facb60cca9956c467f7223be2c434bb9920d48", "git_parents": ["3bb19961d7f0ef0989fd5ac124ea181e371da632"], "node": "82881a2373ae18df421642404274b8e360671350", "parents": ["d9d7bfb9e176337322a95cf82dcd12857ad29517"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2055977 - Add the reported testcase  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313155\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313394\n", "files": ["testing/web-platform/tests/selection/crashtests/selection-setBaseAndExtent-unassigned-nodes-backward.html"], "git_node": "af510ae929e8c25297c3b81bcf146aaa01a264ca", "git_parents": ["36facb60cca9956c467f7223be2c434bb9920d48"], "node": "371042fd2b854732b161fd76e16eaa1c691e6cf9", "parents": ["82881a2373ae18df421642404274b8e360671350"], "tags": []}], "date": 1784825862, "git_changesets": ["36facb60cca9956c467f7223be2c434bb9920d48", "af510ae929e8c25297c3b81bcf146aaa01a264ca"], "user": "dsmith@mozilla.com"}, "27577": {"changesets": [{"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2054232 - Fix race condition with camera preview session in LensCameraFragment  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312380\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313750\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensCameraFragmentTest.kt"], "git_node": "514cbf70f8ffbb346b46c2038b3158b276a3a2d6", "git_parents": ["af510ae929e8c25297c3b81bcf146aaa01a264ca"], "node": "ab7e3f7545f5d633913623994b1f4c3cb349d5df", "parents": ["371042fd2b854732b161fd76e16eaa1c691e6cf9"], "tags": []}], "date": 1784827729, "git_changesets": ["514cbf70f8ffbb346b46c2038b3158b276a3a2d6"], "user": "dsmith@mozilla.com"}, "27578": {"changesets": [{"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054776 - Validate form history entries in FormHistoryParent. a=dsmith\n\nMove the form history entry checks into FormHistory and apply them in\nFormHistoryParent for the submit, autocomplete search and remove paths,\nin addition to the existing checks in FormHistoryChild.\n\nThe checks are applied by the actor that receives these messages.\nFormHistory.update is intentionally left unchanged so in-process callers\nsuch as the search bar continue to manage their own history directly.\nAutocomplete results are still scoped by fieldname only, so form history\nvisibility across origins is unchanged.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313170\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313658\n", "files": ["toolkit/components/satchel/FormHistory.sys.mjs", "toolkit/components/satchel/FormHistoryChild.sys.mjs", "toolkit/components/satchel/FormHistoryParent.sys.mjs"], "git_node": "fc508c7982794811e3017fe5e14ae0db2ff08571", "git_parents": ["514cbf70f8ffbb346b46c2038b3158b276a3a2d6"], "node": "92ed968ede1b7f9e2c35b123af7cbd88f392efac", "parents": ["ab7e3f7545f5d633913623994b1f4c3cb349d5df"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055723 Part 1 - Skip computing shrink-to-fit ratio during a measuring reflow. a=dsmith\n\nSee the code comment added in this patch for rationale.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313118\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313592\n", "files": ["layout/generic/nsPageContentFrame.cpp"], "git_node": "4c19698fabdc26cd3c41ba7ba88d0f491f250ab5", "git_parents": ["fc508c7982794811e3017fe5e14ae0db2ff08571"], "node": "30185f3a71ec306688667563ad5759a1a477bd76", "parents": ["92ed968ede1b7f9e2c35b123af7cbd88f392efac"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2056306 - Invalidate picture cache tiles when text stops animating a=dsmith\n\nText under an animated transform is rasterized in local space (bug 2053638).\nA reference frame was treated as animating whenever its transform was bound to\na property, even if the value never moved, so bound-but-static text (a held or\nsettled animation) was rasterized locally and looked blurry at a fractional\ndevice offset (bug 2051166). And when the animation ended the raster space\nreturned to the device path, but nothing invalidated the tile, so it kept the\nstale local-raster text.\n\nRedefine \"animating\" as \"the bound transform has been observed to move\", using\na monotonic per-binding latch in SceneProperties: bound-but-static text stays on\nthe crisp device path, while a genuinely moving transform still rasterizes in\nlocal space to avoid per-frame snap jitter.\n\nAdd an AnimatedRasterSpace picture-cache dependency for text runs, present only\nwhile animating, so the tile invalidates when the animation ends (the binding is\nremoved) and the raster-space flip alone would otherwise change neither prim_uid\nnor the vertex corners.\n\nAlso extend the wrench yaml reader with property-bound reference-frame\ntransforms (transform-binding) and dynamic transform-property values, and add an\ninvalidation test.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313123\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313581\n", "files": ["gfx/wr/webrender/src/invalidation/cached_surface.rs", "gfx/wr/webrender/src/invalidation/compare.rs", "gfx/wr/webrender/src/scene.rs", "gfx/wr/webrender/src/spatial_node.rs", "gfx/wr/webrender/src/spatial_tree.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/wrench/invalidation/anim_text_a.yaml", "gfx/wr/wrench/invalidation/anim_text_b.yaml", "gfx/wr/wrench/invalidation/anim_text_c.yaml", "gfx/wr/wrench/invalidation/invalidation.list", "gfx/wr/wrench/src/wrench.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs"], "git_node": "aea8b26d7012cc4b7d63915a77b16324a113181d", "git_parents": ["4c19698fabdc26cd3c41ba7ba88d0f491f250ab5"], "node": "0f83fa23c5492a24024499872a83a1553cae6384", "parents": ["30185f3a71ec306688667563ad5759a1a477bd76"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056678 - fix breakage in webcompat automated tests (and potentially some updates) after bz1610046; a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313307\n", "files": ["browser/extensions/webcompat/lib/intervention_helpers.js", "browser/extensions/webcompat/lib/interventions.js", "browser/extensions/webcompat/manifest.json"], "git_node": "61f3fe8e4a437b950f21b3a1629bd536550a6fc8", "git_parents": ["aea8b26d7012cc4b7d63915a77b16324a113181d"], "node": "93443414320011c731f2418308e6961cdc718b05", "parents": ["0f83fa23c5492a24024499872a83a1553cae6384"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2052276 - Enable S2S by default a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310116\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313359\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml"], "git_node": "83b5f98e903a9bc0872c89063d85d817471e2a49", "git_parents": ["61f3fe8e4a437b950f21b3a1629bd536550a6fc8"], "node": "294a04df0314aff441389aa1e92550b6af4fe2c8", "parents": ["93443414320011c731f2418308e6961cdc718b05"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054687 - Check iframe's parent matches the browsing context, a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312950\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313655\n", "files": ["toolkit/components/formautofill/FormAutofillParent.sys.mjs"], "git_node": "0889b4abf18e4e9a5fffe248a42a4d841525d0bf", "git_parents": ["83b5f98e903a9bc0872c89063d85d817471e2a49"], "node": "5d071a759b81f3d6e9bf0b4962bbc0a4e7ec9e13", "parents": ["294a04df0314aff441389aa1e92550b6af4fe2c8"], "tags": []}], "date": 1784829678, "git_changesets": ["fc508c7982794811e3017fe5e14ae0db2ff08571", "4c19698fabdc26cd3c41ba7ba88d0f491f250ab5", "aea8b26d7012cc4b7d63915a77b16324a113181d", "61f3fe8e4a437b950f21b3a1629bd536550a6fc8", "83b5f98e903a9bc0872c89063d85d817471e2a49", "0889b4abf18e4e9a5fffe248a42a4d841525d0bf"], "user": "dsmith@mozilla.com"}, "27579": {"changesets": [{"author": "Ashley Hale \u003cahale@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055054 - query HDR display information and show it in about:support a=dsmith\n\nThis also fixes a bug in initializing MaxContentLightLevel but we currently aren't using that value so it does not change observed behavior.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312205\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313817\n", "files": ["dom/ipc/DOMTypes.ipdlh", "gfx/thebes/DeviceManagerDx.cpp", "gfx/thebes/gfxPlatform.cpp", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "widget/Screen.cpp", "widget/Screen.h", "widget/ScreenManager.cpp", "widget/android/ScreenHelperAndroid.cpp", "widget/cocoa/ScreenHelperCocoa.mm", "widget/gtk/ScreenHelperGTK.cpp", "widget/headless/HeadlessScreenHelper.cpp", "widget/uikit/ScreenHelperUIKit.mm", "widget/windows/ScreenHelperWin.cpp"], "git_node": "aa2e02ba356e465f410cad575eab636ac70a8286", "git_parents": ["0889b4abf18e4e9a5fffe248a42a4d841525d0bf"], "node": "9b69b62e30853c6badf03947df63bea4f41e7342", "parents": ["5d071a759b81f3d6e9bf0b4962bbc0a4e7ec9e13"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038713 - [WebCompat Reporter v3] Update \"Preview report\" bottom sheet. a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308808\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313690\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/middleware/WebCompatReporterSubmissionMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/store/WebCompatReporterStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporter.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporterPreviewSheet.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/middleware/WebCompatReporterSubmissionMiddlewareTest.kt"], "git_node": "32530d68a354c0f156a0c668cae9e914e6e58c5c", "git_parents": ["aa2e02ba356e465f410cad575eab636ac70a8286"], "node": "a1344b59403be91d9bf5a6f7119551a7da275664", "parents": ["9b69b62e30853c6badf03947df63bea4f41e7342"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054761. a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313213\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313730\n", "files": ["browser/components/mozcachedohttp/actors/MozCachedOHTTPParent.sys.mjs", "browser/components/mozcachedohttp/test/unit/test_cache_behavior.js"], "git_node": "9c71ab20ef9716340e285a74fa5fec00b2225d77", "git_parents": ["32530d68a354c0f156a0c668cae9e914e6e58c5c"], "node": "b232da737f8b7bd08f23016ca82d4898d0d6e39f", "parents": ["a1344b59403be91d9bf5a6f7119551a7da275664"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2056633 - Don't allow \u003cinput\u003e / \u003ctextarea\u003e to be affected by multicol styles. a=dsmith\n\nMatches other browsers and our previous behavior, in general it doesn't\nmake sense to split an input into columns.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313434\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313621\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "testing/web-platform/tests/css/css-multicol/textarea-text-overflow-ellipsis-crash.html", "testing/web-platform/tests/html/rendering/widgets/textarea-multicol-ref.html", "testing/web-platform/tests/html/rendering/widgets/textarea-multicol.html"], "git_node": "098302da9ad38ac1191e4804488e8d27e16de795", "git_parents": ["9c71ab20ef9716340e285a74fa5fec00b2225d77"], "node": "0c50c1f738085fffa93a2b4c82ab9f5a50260c05", "parents": ["b232da737f8b7bd08f23016ca82d4898d0d6e39f"], "tags": []}], "date": 1784833607, "git_changesets": ["aa2e02ba356e465f410cad575eab636ac70a8286", "32530d68a354c0f156a0c668cae9e914e6e58c5c", "9c71ab20ef9716340e285a74fa5fec00b2225d77", "098302da9ad38ac1191e4804488e8d27e16de795"], "user": "dsmith@mozilla.com"}, "27580": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings tld-suffixes ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313838\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "6edf63c501fad81f6146bc2a111578c733e1ebae", "git_parents": ["098302da9ad38ac1191e4804488e8d27e16de795"], "node": "df6a9a3f5abe9c3bb92890b6f737db7a627a8896", "parents": ["0c50c1f738085fffa93a2b4c82ab9f5a50260c05"], "tags": []}], "date": 1784849523, "git_changesets": ["6edf63c501fad81f6146bc2a111578c733e1ebae"], "user": "dsmith@mozilla.com"}, "27581": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053730: Fix handling of the enter key when assigning keys in about:keyboard.  ,Gijs  a=diannaS\n\n1. Map the enter key code correctly.\n  Previously, the key code was invalid, which caused severe breakage when enter was assigned.\n2. Don't allow unmodified enter to be assigned.\n  This is very likely to cause confusion at best, brokenness at worst, given the broad usage of the enter key in various different contexts.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313139\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313623\n", "files": ["browser/components/customkeys/CustomKeysParent.sys.mjs", "browser/components/customkeys/tests/browser/browser_aboutKeyboard.js"], "git_node": "d73d289e79f9d589f37f768fd94900766c575528", "git_parents": ["6edf63c501fad81f6146bc2a111578c733e1ebae"], "node": "d5d09c9472a38e0b974f50a348d9fdf836d69953", "parents": ["df6a9a3f5abe9c3bb92890b6f737db7a627a8896"], "tags": []}], "date": 1784851933, "git_changesets": ["d73d289e79f9d589f37f768fd94900766c575528"], "user": "dsmith@mozilla.com"}, "27582": {"changesets": [{"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2054832 - Cap total module size during streaming wasm compilation  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312565\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313832\n", "files": ["js/src/wasm/WasmJS.cpp"], "git_node": "e9bea766f884a099f858741c8db49a021ba830b6", "git_parents": ["d73d289e79f9d589f37f768fd94900766c575528"], "node": "a74c382c95a6061cac1fcb2c80c820f3ca63f0b6", "parents": ["d5d09c9472a38e0b974f50a348d9fdf836d69953"], "tags": []}], "date": 1784853845, "git_changesets": ["e9bea766f884a099f858741c8db49a021ba830b6"], "user": "dsmith@mozilla.com"}, "27583": {"changesets": [{"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053561 - Make back button on show all shortcuts screen reachable with TalkBack  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313285\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313804\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/ui/ShortcutsScreen.kt"], "git_node": "135a4c21c1ba0e8e7201adad2343e5a041c08bec", "git_parents": ["e9bea766f884a099f858741c8db49a021ba830b6"], "node": "957d9c2860bd0b8e98f4be48de58eccbdc2a49ff", "parents": ["a74c382c95a6061cac1fcb2c80c820f3ca63f0b6"], "tags": []}], "date": 1784857801, "git_changesets": ["135a4c21c1ba0e8e7201adad2343e5a041c08bec"], "user": "dsmith@mozilla.com"}, "27584": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-ca/strings.xml", "mobile/android/fenix/app/src/main/res/values-co/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-dsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src