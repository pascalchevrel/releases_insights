gtags"], "git_node": "72199603ff88eea6dc1ee38d1c7c1b9232cc7ba8", "git_parents": ["904b0d9902f98d1b359e5e36d364c95d6851645f"], "node": "03e0c921eb0443cc68437b392e85f02df8728716", "parents": ["f8db2df65eb9a12b6d1f3609ff190786a4a4c02d"], "tags": []}], "date": 1786451356, "git_changesets": ["72199603ff88eea6dc1ee38d1c7c1b9232cc7ba8"], "user": "ffxbld@lando.moz.tools"}, "27956": {"changesets": [{"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057197 - Fix \"Undo\" so it can restore a recently closed synced tab from the Recent Tabs section  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314023\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316251\n", "files": ["browser/base/content/test/sync/browser_sync.js", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "542c4b5792a8834abd179f1f4b45918d1f85d846", "git_parents": ["7dc6f8a0272b3b0feb6bb8797b74ac031703e4ee"], "node": "f10e99269a88ae26172b0387a4768a4df558b639", "parents": ["76c74ff4178d172b7620ef32a778e4bc10af906a"], "tags": []}], "date": 1786455523, "git_changesets": ["542c4b5792a8834abd179f1f4b45918d1f85d846"], "user": "dsmith@mozilla.com"}, "27957": {"changesets": [{"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058595 - Fix perma failing browser/base/content/test/sync/browser_sync.js  a=diannaS\n\nThe failing test revealed an accessibility issue in focusing the undo button in the disabled button. This restructures the buttons to be siblings.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316348\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317811\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser_sync.js", "browser/components/customizableui/test/browser_synced_tabs_menu.js", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "397ed651a9c9c0e40798e80e94c434d1dfb575fa", "git_parents": ["542c4b5792a8834abd179f1f4b45918d1f85d846"], "node": "ad51ed9f0decfd6d5991b161a1ad0265579c97bb", "parents": ["f10e99269a88ae26172b0387a4768a4df558b639"], "tags": []}], "date": 1786456158, "git_changesets": ["397ed651a9c9c0e40798e80e94c434d1dfb575fa"], "user": "dsmith@mozilla.com"}, "27958": {"changesets": [{"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055206 - Part 1: Do not attempt to refresh while in background  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313027\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317774\n", "files": ["toolkit/components/ipprotection/IPPLifecycleHelper.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPPLifecycleHelper.js"], "git_node": "5282cb5026093406c29d47b19a6052b98202dabd", "git_parents": ["397ed651a9c9c0e40798e80e94c434d1dfb575fa"], "node": "2647f98ec3ccdf9e2b00641b8b6a1080855c5950", "parents": ["ad51ed9f0decfd6d5991b161a1ad0265579c97bb"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055206 - Part 2: Add individual timouts per fetch  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313028\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317775\n", "files": ["toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "3dcf4a54f1684af5661f5311122c4b99dc770d7a", "git_parents": ["5282cb5026093406c29d47b19a6052b98202dabd"], "node": "db1cf265b4c1695beedec7a6f6a62c2cc85e2ff2", "parents": ["2647f98ec3ccdf9e2b00641b8b6a1080855c5950"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055206 - Part 3: A forced rotation should reset the Proxy-Manager timer  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313029\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317776\n", "files": ["toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPPLifecycleHelper.js"], "git_node": "53e80393f2932c262e587be244fa9929fc4f7408", "git_parents": ["3dcf4a54f1684af5661f5311122c4b99dc770d7a"], "node": "4d87f1833a005469626e700c8680e97ef5136094", "parents": ["db1cf265b4c1695beedec7a6f6a62c2cc85e2ff2"], "tags": []}], "date": 1786457644, "git_changesets": ["5282cb5026093406c29d47b19a6052b98202dabd", "3dcf4a54f1684af5661f5311122c4b99dc770d7a", "53e80393f2932c262e587be244fa9929fc4f7408"], "user": "dsmith@mozilla.com"}, "27959": {"changesets": [{"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059875 - Expose isAvailable() for native ONNX runtime  a=diannaS\n\nThis commit exposes an isAvailable() API for the native\nONNX runtime so that callers can more easily make an\ninformed decisions.\n\nMany of the current code solutions get around this by\nattempting to use ONNX native, and falling back to\nan alternative only if ONNX native fails.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315752\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317635\n", "files": ["dom/onnx/InferenceSession.cpp", "dom/onnx/InferenceSession.h", "dom/webidl/ONNX.webidl", "toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/content/MLEngine.worker.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_native_ort_availability.js", "toolkit/components/ml/tests/browser/ml_native_ort_available_stub.worker.mjs", "toolkit/components/ml/tests/browser/ml_native_ort_error_stub.worker.mjs", "toolkit/components/ml/tests/browser/ml_native_ort_unavailable_stub.worker.mjs"], "git_node": "3df5c69431a70be3a32e99d5815234f86efc3e99", "git_parents": ["53e80393f2932c262e587be244fa9929fc4f7408"], "node": "d212cf51e068167e59e3916bf8bf5046323628d8", "parents": ["4d87f1833a005469626e700c8680e97ef5136094"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059883 - Part 1: Disable extensions.formautofill.useml on Linux  a=diannaS\n\nThe native ONNX path does not yet work on Linux machines,\nand we would like to avoid the WASM path entirely for now,\nso it makes sense to leave this pref as `false` on Linux.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316639\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317636\n", "files": ["modules/libpref/init/all.js"], "git_node": "157766e73d79f5399fecbacfa2c387aaf4030da5", "git_parents": ["3df5c69431a70be3a32e99d5815234f86efc3e99"], "node": "4c0896323816fe2af7ba92e4ccca386af79dff4c", "parents": ["d212cf51e068167e59e3916bf8bf5046323628d8"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059883 - Part 2: Use two threads for form autofill ML inference  a=diannaS\n\nThis commit ensures that if the WASM path were to run, it would only\nspin up two workers, rather than being bounded by CPU concurrency.\nThe WASM path still uses quite a bit of memory even with only two\nworkers, which is why we are avoiding it for the time being, but\nif it were to run, two workers is better than the default.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316640\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317637\n", "files": ["toolkit/components/formautofill/shared/FormAutofillML.sys.mjs"], "git_node": "c73fdb24b01480fcf084b8ea8179aa9e4d3bb2d7", "git_parents": ["157766e73d79f5399fecbacfa2c387aaf4030da5"], "node": "a80973ef605c94b0bf64e43d8e2d0aa0820a9924", "parents": ["4c0896323816fe2af7ba92e4ccca386af79dff4c"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059883 - Part 3: Use form autofill ML only when native ONNX is available  a=diannaS\n\nAt startup the parent process asks the inference process whether the\nnative ONNX runtime is available and records the answer in\nextensions.formautofill.useml.nativeOnnxAvailable.\n\nThis commit ensures that form autofill will only use ML inference\nwhen the native ONNX runtime is available, otherwise it will use\nthe regex classification paths.\n\nNote that it is still possible to fall back to the ONNX WASM path\nin the case where native ONNX is available, but genuinely fails\nwith an error. This case should be very rare, if it happens at all.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317006\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317638\n", "files": ["browser/extensions/formautofill/api.js", "modules/libpref/init/all.js", "toolkit/components/formautofill/shared/FormAutofillUtils.sys.mjs"], "git_node": "18362b89e386d80c05c6b4f38d9d5cbc2042cbb3", "git_parents": ["c73fdb24b01480fcf084b8ea8179aa9e4d3bb2d7"], "node": "9c9c426be071b50fe552b91c8eb255eed232f4f8", "parents": ["a80973ef605c94b0bf64e43d8e2d0aa0820a9924"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059883 - Part 4: Introduce native ONNX availability test  a=diannaS\n\nThis commit introduces a new test case to ensure that the native ONNX\navaiability correctly influences whether form autofill utilizes machine\nlearning vs. regex for classification.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317116\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317639\n", "files": ["browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_ml_heuristics.js", "browser/extensions/formautofill/test/browser/browser_ml_native_onnx_availability.js", "browser/extensions/formautofill/test/browser/head.js"], "git_node": "a3134bd4fdac88ca86ab2ce8e9fe5b603298abc7", "git_parents": ["18362b89e386d80c05c6b4f38d9d5cbc2042cbb3"], "node": "1f7091303b947c26076f8134d87e5bbe362e886f", "parents": ["9c9c426be071b50fe552b91c8eb255eed232f4f8"], "tags": []}], "date": 1786457731, "git_changesets": ["3df5c69431a70be3a32e99d5815234f86efc3e99", "157766e73d79f5399fecbacfa2c387aaf4030da5", "c73fdb24b01480fcf084b8ea8179aa9e4d3bb2d7", "18362b89e386d80c05c6b4f38d9d5cbc2042cbb3", "a3134bd4fdac88ca86ab2ce8e9fe5b603298abc7"], "user": "dsmith@mozilla.com"}, "27960": {"changesets": [{"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060262 - Improve Precision Configs for Auto Tab Grouping Clustering.  a=diannaS\n\nThis patch improves the group cohesion and ensures that we show fewer, more precise groups.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317651\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317654\n", "files": ["browser/app/profile/firefox.js"], "git_node": "a373c82be11f5d230224f8c913991404878c93b5", "git_parents": ["a3134bd4fdac88ca86ab2ce8e9fe5b603298abc7"], "node": "a8c5b5dd9fc3689228e5e3f5151d18453d7447ac", "parents": ["1f7091303b947c26076f8134d87e5bbe362e886f"], "tags": []}], "date": 1786458992, "git_changesets": ["a373c82be11f5d230224f8c913991404878c93b5"], "user": "dsmith@mozilla.com"}, "27961": {"changesets": [{"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062474 - Enable Auto Tab Grouping for SW.  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317692\n", "files": ["browser/app/profile/firefox.js"], "git_node": "f290e1a0dfd8bb8467463a63e46cab2b8950d5ad", "git_parents": ["a373c82be11f5d230224f8c913991404878c93b5"], "node": "b9afa5bcd19fae420c729f8d599167e74aa5009e", "parents": ["a8c5b5dd9fc3689228e5e3f5151d18453d7447ac"], "tags": []}], "date": 1786460726, "git_changesets": ["f290e1a0dfd8bb8467463a63e46cab2b8950d5ad"], "user": "dsmith@mozilla.com"}, "27962": {"changesets": [{"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2058014 - fullpage Smart Window top fade and non-Nova chat-history button theming.  a=diannaS\n\n- Send the AI window mode (sidebar/fullpage) to the chat content over the actor and reflect it as a `mode` attribute so styles can target fullpage.\n- Add fullpage-only top blur/scrim fade; the scrim is Nova-only since non-Nova buttons carry their own background.\n- Theme the non-Nova ghost chrome buttons (fullpage New chat / Chat history / More, sidebar \"...\", New chat, Close) in dark mode\n- Show each chat's most recent non-about: page favicon in the history menu.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316368\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317655\n", "files": ["browser/components/aiwindow/ui/actors/AIChatContentChild.sys.mjs", "browser/components/aiwindow/ui/actors/AIChatContentParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.css", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.css", "browser/components/aiwindow/ui/components/smartwindow-history-menu/smartwindow-history-menu.css", "browser/components/aiwindow/ui/content/ai-window-shared.css", "browser/components/aiwindow/ui/modules/ChatSql.sys.mjs"], "git_node": "8813180101fc5740859efff0c661db729e24f512", "git_parents": ["f290e1a0dfd8bb8467463a63e46cab2b8950d5ad"], "node": "f0db726f77354d22e8df617456564b654ab933c9", "parents": ["b9afa5bcd19fae420c729f8d599167e74aa5009e"], "tags": []}], "date": 1786460753, "git_changesets": ["8813180101fc5740859efff0c661db729e24f512"], "user": "dsmith@mozilla.com"}, "27963": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1179722 - Send SSPI channel bindings on the initial InitializeSecurityContext call.  a=diannaS\n\nThe SEC_CHANNEL_BINDINGS buffer was only ever built on continuation calls. That\nis sufficient for raw NTLM, whose channel binding travels in message 3, but\nSPNEGO carries the AP-REQ in the very first token, so Kerberos needs the\nbindings from the initial call on and never received them.\n\nMove the token construction into a helper and attach it whenever a certificate\nis available, building the input buffer descriptor up front so it can be passed\nwith no accompanying token. Keep the certificate for the lifetime of the\nsequence instead of freeing it after first use, so every leg of a multi-leg\nexchange carries the bindings.\n\nThe exemption for PACKAGE_TYPE_NTLM covers the sys-ntlm module only, which\nkeeps behaving exactly as it does today. NTLM negotiated inside SPNEGO runs\nunder PACKAGE_TYPE_NEGOTIATE and will now carry bindings from the first call:\nthat is the main behaviour change here and the one worth reviewing closely,\nsince raw NTLM is deliberately untouched.\n\nOn its own this commit changes nothing, because no caller supplies a\ncertificate on the Negotiate path until the next one.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316807\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317789\n", "files": ["extensions/auth/nsAuthSSPI.cpp", "extensions/auth/nsAuthSSPI.h"], "git_node": "2fd863739a87ef725b9f54eb2116f6ef678237f4", "git_parents": ["8813180101fc5740859efff0c661db729e24f512"], "node": "78d8cb03536a5f10f379443c92257ccc75eeb64c", "parents": ["f0db726f77354d22e8df617456564b654ab933c9"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1179722 - Pass the server certificate to the Negotiate auth module.  a=diannaS\n\nnsHttpNegotiateAuth never retrieved the server certificate, so nsAuthSSPI had\nnothing to build a channel binding token from and Negotiate authentication\nnever sent one. Servers with Extended Protection set to Require reject that,\nwhich is why Kerberos SSO fails against ADFS and Exchange OWA where Chrome and\nEdge succeed. nsHttpNTLMAuth is the only caller that has ever supplied a\ncertificate.\n\nGenerateCredentials runs on a background thread, so the certificate is\ncollected on the main thread in GenerateCredentialsAsync, and only for a\nchallenge that carries no token of its own. That is the first call of a\nsequence, and the only call where nsAuthSSPI::GetNextToken expects a\ncertificate in place of the input token.\n\nProxy auth is excluded because the channel's security info describes the origin\nserver rather than the proxy. Extended Protection for proxies needs the proxy's\nown certificate and is left for a follow-up.\n\nnetwork.auth.negotiate_channel_binding backs the change out.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316808\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317790\n", "files": ["extensions/auth/nsHttpNegotiateAuth.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "5ab1e1db0bcc0dcf265245ea0f09caa4b7f930b1", "git_parents": ["2fd863739a87ef725b9f54eb2116f6ef678237f4"], "node": "4be935c8d7d6188c909d3e022544b450a41ed748", "parents": ["78d8cb03536a5f10f379443c92257ccc75eeb64c"], "tags": []}], "date": 1786460791, "git_changesets": ["2fd863739a87ef725b9f54eb2116f6ef678237f4", "5ab1e1db0bcc0dcf265245ea0f09caa4b7f930b1"], "user": "dsmith@mozilla.com"}, "27964": {"changesets": [{"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059390: fix crash in SitePermissionsFragment.onDismiss  a=diannaS\n\nIf a fragment is detached, it is no longer safe to call `requireComponents`, because this method throws if the `context` is null. In this case, `BaseBrowserFragment` is not attached and returning true from `shouldHide` will stop us from showing the permission prompt, rather than crashing. Also checked `hidePermissionsPrompt` which will be called if `shouldHide` is true. This allows for the case of the fragment not being attached by using an optional and a let, so should be safe to call in this detached fragment case.\n\n[try is running here](https://treeherder.mozilla.org/jobs?repo=try&revision=8dbfc878c87991d2da9167e8ad5daed2bb54579a)\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/321\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317829\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt"], "git_node": "7bea790e936d476311e3f56b9bb161e2f4ce507d", "git_parents": ["5ab1e1db0bcc0dcf265245ea0f09caa4b7f930b1"], "node": "e1b059c155d6b6bc3f1f1d8e1f897abc4a7edd70", "parents": ["4be935c8d7d6188c909d3e022544b450a41ed748"], "tags": []}], "date": 1786467656, "git_changesets": ["7bea790e936d476311e3f56b9bb161e2f4ce507d"], "user": "dsmith@mozilla.com"}, "27965": {"changesets": [{"author": "Jon Oliver \u003cjooliver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055462 - Fix findbar notfound/flash colors for lightweight themes  a=diannaS\n\nExclude notfound and flash states from the :root[lwtheme] findbar\ntextbox override so those status colors apply under lightweight themes.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316541\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317861\n", "files": ["toolkit/components/extensions/test/browser/browser_ext_themes_findbar.js", "toolkit/themes/shared/findbar.css"], "git_node": "46f3e6fb2363dbb73f7ede62de6ad603431190ad", "git_parents": ["7bea790e936d476311e3f56b9bb161e2f4ce507d"], "node": "cd054a33260b6a274dd3c8eaf366796193f75dee", "parents": ["e1b059c155d6b6bc3f1f1d8e1f897abc4a7edd70"], "tags": []}], "date": 1786472064, "git_changesets": ["46f3e6fb2363dbb73f7ede62de6ad603431190ad"], "user": "dsmith@mozilla.com"}, "27966": {"changesets": [{"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062254 - Fix about:translations port reacquisition (quick fix)  a=diannaS\n\nThis commit fixes an issue where about:translations attempts to reuse\na port after its TranslationsEngine is destroyed and the port is closed.\nThe Translator now acquires a new port each time before starting a\nnew batch of translation requests.\n\nSince Translator is only used by about:translations and SelectTranslations,\nthis should not affect the performance of FullPageTranslations. Even so\nthe performance hit of creating a new port is fairly minimal compared to\nthe correctness it will provide in the near term.\n\nThis commit is intended for Beta uplift.\n\nThe following commit contains a more robust fix for notifying features of\nengine termination that will fully ride the release trains.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317555\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317652\n", "files": ["toolkit/components/translations/content/Translator.mjs", "toolkit/components/translations/tests/browser/browser.toml", "toolkit/components/translations/tests/browser/browser_about_translations_engine_destroy.js"], "git_node": "c27b8e080152f82b79e0a089cec784de2928c0ff", "git_parents": ["46f3e6fb2363dbb73f7ede62de6ad603431190ad"], "node": "44d53d1211e3c727dc4934fccd7e000d8dc3fc6a", "parents": ["cd054a33260b6a274dd3c8eaf366796193f75dee"], "tags": []}], "date": 1786473743, "git_changesets": ["c27b8e080152f82b79e0a089cec784de2928c0ff"], "user": "dsmith@mozilla.com"}, "27967": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058162 - add a desktop-only CSS webcompat intervention for the-image-editor.com;  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317175\n", "files": ["browser/extensions/webcompat/data/interventions/2058162-the-image-editor.com.json", "browser/extensions/webcompat/manifest.json", "browser/extensions/webcompat/preprocessed_intervention_files.mozbuild", "testing/webcompat/interventions/tests/test_2058162_the-image-editor_com.py"], "git_node": "3bd8b361b7068050ce1933b719c537bc3c708e5d", "git_parents": ["c27b8e080152f82b79e0a089cec784de2928c0ff"], "node": "c11ca42383d266463a3bc008a0a9b33e99d76e00", "parents": ["44d53d1211e3c727dc4934fccd7e000d8dc3fc6a"], "tags": []}], "date": 1786475139, "git_changesets": ["3bd8b361b7068050ce1933b719c537bc3c708e5d"], "user": "dsmith@mozilla.com"}, "27968": {"changesets": [{"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051359 - Part 1: Add small size variant to ai-website-chip  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312330\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317743\n", "files": ["browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.css", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.mjs", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.stories.mjs"], "git_node": "2d76559d88ae31a7ebaffa00fed8b18d93167536", "git_parents": ["3bd8b361b7068050ce1933b719c537bc3c708e5d"], "node": "2156f2377a6a9973357789d8053e695591c94adb", "parents": ["c11ca42383d266463a3bc008a0a9b33e99d76e00"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051359 - Part 2: Support custom child items in smartwindow-panel-list  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312331\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317744\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.css", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.mjs"], "git_node": "fa1c5427742406f374f82f8915b33dec010fb2e7", "git_parents": ["2d76559d88ae31a7ebaffa00fed8b18d93167536"], "node": "99a43018e1c9db893a8a431a99f73399db38693f", "parents": ["2156f2377a6a9973357789d8053e695591c94adb"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051359 - Part 3: Add citation component for assistant chat messages  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312332\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317745\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/chat-assistant-citations/chat-assistant-citations.css", "browser/components/aiwindow/ui/components/ai-chat-content/chat-assistant-citations/chat-assistant-citations.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/chat-assistant-citations/chat-assistant-citations.stories.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/locales/en-US/browser/aiWindowContent.ftl"], "git_node": "1a5d3bb5e088b3ab24cf0d0ec8fd76ce899ffdbf", "git_parents": ["fa1c5427742406f374f82f8915b33dec010fb2e7"], "node": "59406f38e565546de9b0b14ecbfd9690dc4db79a", "parents": ["99a43018e1c9db893a8a431a99f73399db38693f"], "tags": []}], "date": 1786478173, "git_changesets": ["2d76559d88ae31a7ebaffa00fed8b18d93167536", "fa1c5427742406f374f82f8915b33dec010fb2e7", "1a5d3bb5e088b3ab24cf0d0ec8fd76ce899ffdbf"], "user": "dsmith@mozilla.com"}, "27969": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 5d7f4d5bc4ccf389b904e3d6b7d839075ffc0a00 with FIREFOX_115_39_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "f3f9ea76c92fb90bbbb5157144908eb099a1931c", "git_parents": ["72199603ff88eea6dc1ee38d1c7c1b9232cc7ba8"], "node": "7a7d4e52e6b8f59850c6d7ff18970a1f67153ed3", "parents": ["03e0c921eb0443cc68437b392e85f02df8728716"], "tags": []}], "date": 1786479136, "git_changesets": ["f3f9ea76c92fb90bbbb5157144908eb099a1931c"], "user": "ffxbld@lando.moz.tools"}, "27970": {"changesets": [{"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053889 - Part 1: Add a single row overflow handler  a=diannaS\n\nRows are width-aware by default. They measure themselves and show the items\nthat fit. Overflowing items are shown behind a \"+n more\" button. Setting a\nfixed item count overrides the width-aware behavior.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314738\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317748\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-overflow-row/SmartwindowOverflowRow.mjs", "browser/components/aiwindow/ui/components/smartwindow-overflow-row/smartwindow-overflow-row.css", "browser/components/aiwindow/ui/jar.mn"], "git_node": "acca57e153fe4345855d618ae28f4ba2c5e5f2f0", "git_parents": ["1a5d3bb5e088b3ab24cf0d0ec8fd76ce899ffdbf"], "node": "31f6b06a41f3c34e33b71d44d4d1316d0f6f0db0", "parents": ["59406f38e565546de9b0b14ecbfd9690dc4db79a"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053889 - Part 2: Collapse overflowing action log context chips  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314739\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317749\n", "files": ["browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.mjs", "browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.stories.mjs", "browser/components/aiwindow/ui/components/website-chip-container/website-chip-container.css", "browser/components/aiwindow/ui/components/website-chip-container/website-chip-container.mjs", "browser/components/aiwindow/ui/components/website-chip-container/website-chip-container.stories.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_chip_overflow.js", "browser/components/aiwindow/ui/test/browser/test_chip_overflow.mjs", "browser/components/aiwindow/ui/test/browser/test_chip_overflow_page.html"], "git_node": "fa9ba4afac330b52a43df8678401bcb491bfece3", "git_parents": ["acca57e153fe4345855d618ae28f4ba2c5e5f2f0"], "node": "2c1f809b72fca184bb8106b34ac6820705c7f8c7", "parents": ["31f6b06a41f3c34e33b71d44d4d1316d0f6f0db0"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057237 - Part 1: Connect search sources to assistant chat citations  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315052\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317750\n", "files": ["browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_search_the_web.js", "browser/components/aiwindow/ui/actors/AIChatContentParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/modules/ChatEnums.sys.mjs", "browser/components/aiwindow/ui/modules/ChatMessage.sys.mjs", "browser/components/aiwindow/ui/modules/ChatStore.sys.mjs", "browser/components/aiwindow/ui/modules/ChatUtils.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_ChatConversation.js", "browser/components/aiwindow/ui/test/xpcshell/test_ChatMessage.js", "browser/components/aiwindow/ui/test/xpcshell/test_ChatStore.js", "browser/components/aiwindow/ui/test/xpcshell/test_chat-utils.js"], "git_node": "26f8785eebc3df01c90bedf7371e288de9ef2c54", "git_parents": ["fa9ba4afac330b52a43df8678401bcb491bfece3"], "node": "a4c2ab7d5e46ab9d1f6251b6110e3f7bb96795ed", "parents": ["2c1f809b72fca184bb8106b34ac6820705c7f8c7"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u00