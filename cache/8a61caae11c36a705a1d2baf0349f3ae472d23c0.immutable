arents": ["5c34b1154a560c5074d4b341ab0056f714976d4c"], "tags": ["DEVEDITION_154_0b2_BUILD1", "DEVEDITION_154_0b2_RELEASE", "FIREFOX-ANDROID_154_0b2_BUILD1", "FIREFOX-ANDROID_154_0b2_RELEASE", "FIREFOX_154_0b2_BUILD1", "FIREFOX_154_0b2_RELEASE"]}], "date": 1784883949, "git_changesets": ["df3c830eed8a78df72ebd2d4bc69887911102f24", "946dc6c3467a2a952e0bc3c8a8808cdbcb2acae6"], "user": "ffxbld@lando.moz.tools"}, "27586": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging b7b1868f2e31da0d089ccb869ec773fa5d9fd9ac with DEVEDITION_154_0b2_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9e86fd8287fdc80e1668fb4ac56f02f39976bd27", "git_parents": ["fdff4ab6b296c13ebebec9afadf5b170744233e5"], "node": "8e8810b733a405f04d434308d17046e1bd9e0f55", "parents": ["a332384620d474ec2fde786e8885e1876b513933"], "tags": []}], "date": 1784898351, "git_changesets": ["9e86fd8287fdc80e1668fb4ac56f02f39976bd27"], "user": "ffxbld@lando.moz.tools"}, "27587": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging b7b1868f2e31da0d089ccb869ec773fa5d9fd9ac with FIREFOX_154_0b2_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "81653228e6da4aa8b9e401fe3186e2de14c8b05d", "git_parents": ["9e86fd8287fdc80e1668fb4ac56f02f39976bd27"], "node": "7f104e4b73d1e1ac5ceb3516d8435b50765b3877", "parents": ["8e8810b733a405f04d434308d17046e1bd9e0f55"], "tags": []}], "date": 1784898422, "git_changesets": ["81653228e6da4aa8b9e401fe3186e2de14c8b05d"], "user": "ffxbld@lando.moz.tools"}, "27588": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging b7b1868f2e31da0d089ccb869ec773fa5d9fd9ac with FIREFOX-ANDROID_154_0b2_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "f6f1d03c023e6bd935fc51e73f22cbee62a97318", "git_parents": ["81653228e6da4