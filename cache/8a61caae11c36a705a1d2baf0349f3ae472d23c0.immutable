13db0d0cf6a5fe1f8e4d83\nur -\u003e 31f336f5fe7c7c1cf513db0d0cf6a5fe1f8e4d83\nuz -\u003e 31f336f5fe7c7c1cf513db0d0cf6a5fe1f8e4d83\nvi -\u003e 31f336f5fe7c7c1cf513db0d0cf6a5fe1f8e4d83\nwo -\u003e 31f336f5fe7c7c1cf513db0d0cf6a5fe1f8e4d83\nxh -\u003e 31f336f5fe7c7c1cf513db0d0cf6a5fe1f8e4d83\nzam -\u003e 31f336f5fe7c7c1cf513db0d0cf6a5fe1f8e4d83\nzh-CN -\u003e 31f336f5fe7c7c1cf513db0d0cf6a5fe1f8e4d83\nzh-TW -\u003e 31f336f5fe7c7c1cf513db0d0cf6a5fe1f8e4d83\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "4a156d5e85efb1f2d264f0b6319f885095a2c340", "git_parents": ["7ff22b8fa5c8f422afa7c5b68730eff0d3a4fc52"], "node": "ed5f223189c904de429afab8d0325f6a7ccfcfcf", "parents": ["8f358190a06a258ad277a1eaa11f56182ce7029a"], "tags": []}], "date": 1785574995, "git_changesets": ["7ff22b8fa5c8f422afa7c5b68730eff0d3a4fc52", "4a156d5e85efb1f2d264f0b6319f885095a2c340"], "user": "ffxbld@lando.moz.tools"}, "27757": {"changesets": [{"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015460: Don't keep the requesting browser window alive during a macOS passkey handshake.  a=diannaS\n\nMacOSAuthenticatorPresentationContextProvider held a strong reference to the requesting NSWindow for the lifetime of a passkey handshake. If the handshake stalled (the platform does not always invoke the completion callback) and the user then closed that window, the window had been -close'd but stayed retained, so it lingered as an invisible window that remains in Mission Control and captures mouse events over its old frame until Firefox is force-quit.\n\nStore the window number instead and resolve the presentation anchor lazily via -[NSApplication windowWithWindowNumber:], which returns nil once the window has closed. This removes the retain without depending on zeroing weak references (which are not enabled for our Objective-C++ sources).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310261\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315562\n", "files": ["dom/webauthn/MacOSWebAuthnService.mm"], "git_node": "6dddadeea3518caf79f76500292379e869c468ed", "git_parents": ["4a156d5e85efb1f2d264f0b6319f885095a2c340"], "node": "2cc799cfdaa555678f84284a4827ebbafd5bc44b", "parents": ["ed5f223189c904de429afab8d0325f6a7ccfcfcf"], "tags": []}], "date": 1785634095, "git_changesets": ["6dddadeea3518caf79f76500292379e869c468ed"], "user": "dsmith@mozilla.com"}, "27758": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058759: remove firefox.exe hardcoding in make_incremental_updates.sh  a=diannaS\n\nThis was added in https://bugzilla.mozilla.org/show_bug.cgi?id=2058197 as a short term fix to some start-up crashes we were seeing in 153.0 updates. This patch gets rid of that hardcoding, allowing Thunderbird to benefit from the optimized instruction order as well, and clean up the code more generally.\n\nAFAIK the only caller to `make_incremental_update.sh` is `funsize.py`, which is also being updated here so there should be no risk to changing the required arguments.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315294\n", "files": ["taskcluster/docker/funsize-update-generator/scripts/funsize.py", "tools/update-packaging/make_incremental_update.sh", "tools/update-packaging/test/buildrefmars.sh"], "git_node": "52313a1fc25060397e049fe0958fd6fe290bbe63", "git_parents": ["6dddadeea3518caf79f76500292379e869c468ed"], "node": "df3b1ebb6f96af181afc6274735f87aa1ef256cf", "parents": ["2cc799cfdaa555678f84284a4827ebbafd5bc44b"], "tags": []}], "date": 1785634154, "git_changesets": ["52313a1fc25060397e049fe0958fd6fe290bbe63"], "user": "dsmith@mozilla.com"}, "27759": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059489 - Restore the themed colors for the Focus context menu note.  a=diannaS\n\nBug 2052613 removed these two colors during an UnusedResources cleanup. They override defaults in the\nandroid-components contextmenu component, which style the note shown when long-pressing an image, so the\nnote stopped following the app theme and rendered dark against the light theme. Restore them and mark them\nignored for UnusedResources, since their only references live in android-components where the check cannot\nsee them.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315342\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315512\n", "files": ["mobile/android/focus-android/app/src/main/res/values-night/colors.xml", "mobile/android/focus-android/app/src/main/res/values/colors.xml"], "git_node": "300bdf9847098bdc6617126912e7ef4f4e45a60b", "git_parents": ["52313a1fc25060397e049fe0958fd6fe290bbe63"], "node": "a0e39991492539c13174b7f9b966c56f84705215", "parents": ["df3b1ebb6f96af181afc6274735f87aa1ef256cf"], "tags": []}], "date": 1785634226, "git_changesets": ["300bdf9847098bdc6617126912e7ef4f4e45a60b"], "user": "dsmith@mozilla.com"}, "27760": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050584.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313883\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315489\n", "files": ["dom/canvas/WebGLFramebuffer.cpp", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance2.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml"], "git_node": "8f573196b5fbfc4d00c64ee9b2d300286ef744bf", "git_parents": ["300bdf9847098bdc6617126912e7ef4f4e45a60b"], "node": "599d38b55758465835646d8bb0cba9d14bef2d01", "parents": ["a0e39991492539c13174b7f9b966c56f84705215"], "tags": []}], "date": 1785634278, "git_changesets": ["8f573196b5fbfc4d00c64ee9b2d300286ef744bf"], "user": "dsmith@mozilla.com"}, "27761": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2053159  a=diannaS\n