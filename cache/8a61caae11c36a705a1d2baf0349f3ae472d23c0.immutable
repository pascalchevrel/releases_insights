/main/search-config-icons/a06db97d-1210-ea2e-5474-0e2f7d295bfd.meta.json", "services/settings/dumps/main/search-config-icons/a06dc3fd-4bdb-41f3-2ebc-4cbed06a9bd3.meta.json", "services/settings/dumps/main/search-config-icons/a2c7d4e9-f770-51e1-0963-3c2c8401631d.meta.json", "services/settings/dumps/main/search-config-icons/acae3d3c-b09e-47f0-a9e5-57980d21fc4a.meta.json", "services/settings/dumps/main/search-config-icons/b64f09fd-52d1-c48e-af23-4ce918e7bf3b.meta.json", "services/settings/dumps/main/search-config-icons/b8ca5a94-8fff-27ad-6e00-96e244a32e21.meta.json", "services/settings/dumps/main/search-config-icons/c411adc1-9661-4fb5-a4c1-8cfe74911943.meta.json", "services/settings/dumps/main/search-config-icons/cbf9e891-d079-2b28-5617-283450d463dd.meta.json", "services/settings/dumps/main/search-config-icons/d87f251c-3e12-a8bf-e2d0-afd43d36c5f9.meta.json", "services/settings/dumps/main/search-config-icons/e02f23df-8d48-2b1b-3b5c-6dd27302c61c.meta.json", "services/settings/dumps/main/search-config-icons/e718e983-09aa-e8f6-b25f-cd4b395d4785.meta.json", "services/settings/dumps/main/search-config-icons/e7547f62-187b-b641-d462-e54a3f813d9a.meta.json", "services/settings/dumps/main/search-config-icons/f312610a-ebfb-a106-ea92-fd643c5d3636.meta.json", "services/settings/dumps/main/search-config-icons/fa0fc42c-d91d-fca7-34eb-806ff46062dc.meta.json", "services/settings/dumps/main/search-config-icons/fca3e3ee-56cd-f474-dc31-307fd24a891d.meta.json", "services/settings/dumps/main/search-config-icons/fed4f021-ff3e-942a-010e-afa43fda2136.meta.json", "services/settings/dumps/main/search-config-overrides-v2.json", "services/settings/dumps/main/search-default-override-allowlist.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/main/sites-classification.json", "services/settings/dumps/main/top-sites.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/main/translations-wasm.json", "services/settings/dumps/main/url-classifier-skip-urls.json", "services/settings/dumps/main/url-parser-default-unknown-schemes-interventions.json", "services/settings/dumps/main/urlbar-persisted-search-terms.json", "services/settings/dumps/main/websites-with-shared-credential-backends.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "2d66ed19506956b8f9f260b8fac8d22c92bdb2ca", "git_parents": ["be7921c83ef51018495f7a776641efb52f5d54aa"], "node": "5e5b151df3b2296ef127cd5cad415eec79c6828e", "parents": ["822a5d2031da87ed0fadbeff0b3bab9710b8389c"], "tags": []}], "date": 1785876636, "git_changesets": ["2d66ed19506956b8f9f260b8fac8d22c92bdb2ca"], "user": "dsmith@mozilla.com"}, "27833": {"changesets": [{"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059593 - Stop passing BrowsingContext over IPC in the AutoScroll actors.  a=diannaS\n\nAutoScrollChild sent its own BrowsingContext to AutoScrollParent as part\nof the \"Autoscroll:Start\" message, but a JSWindowActorParent and its\npaired JSWindowActorChild always share the same BrowsingContext, so\nAutoScrollParent can just use its own `this.browsingContext` instead.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315468\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316389\n", "files": ["gfx/layers/apz/test/mochitest/browser_test_autoscrolling_in_oop_frame.js", "toolkit/actors/AutoScrollChild.sys.mjs", "toolkit/actors/AutoScrollParent.sys.mjs"], "git_node": "7608dff7be6c99c3a4c23758e003efcd86f453e8", "git_parents": ["2d66ed19506956b8f9f260b8fac8d22c92bdb2ca"], "node": "a216509f8b8ee44121ca52c46aa1dba70570e614", "parents": ["5e5b151df3b2296ef127cd5cad415eec79c6828e"], "tags": []}], "date": 1785878557, "git_changesets": ["7608dff7be6c99c3a4c23758e003efcd86f453e8"], "user": "dsmith@mozilla.com"}, "27834": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057994 - Update the waiting-for-key timer handling in MFContentProtectionManager.  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316075\n", "files": ["dom/media/ipc/MFMediaEngineParent.cpp", "dom/media/platforms/wmf/MFContentProtectionManager.cpp", "dom/media/platforms/wmf/MFContentProtectionManager.h"], "git_node": "99432b60a8de17551c2d04fa7f228058e89174d8", "git_parents": ["7608dff7be6c99c3a4c23758e003efcd86f453e8"], "node": "e158ac806ec77e1e5e69c0504b2b084d2ceeae96", "parents": ["a216509f8b8ee44121ca52c46aa1dba70570e614"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057994 - Synchronize access to the content protection manager state.  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316076\n", "files": ["dom/media/ipc/MFMediaEngineParent.cpp", "dom/media/platforms/wmf/MFContentProtectionManager.cpp", "dom/media/platforms/wmf/MFContentProtectionManager.h"], "git_node": "e66976b35cd0b8a8182c4b86dcc93a75a643f505", "git_parents": ["99432b60a8de17551c2d04fa7f228058e89174d8"], "node": "3d2ed8a8fe3efc56195beea883f36f60ed620e97", "parents": ["e158ac806ec77e1e5e69c0504b2b084d2ceeae96"], "tags": []}], "date": 1785878808, "git_changesets": ["99432b60a8de17551c2d04fa7f228058e89174d8", "e66976b35cd0b8a8182c4b86dcc93a75a643f505"], "user": "dsmith@mozilla.com"}, "27835": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055697 - Base media load-error message redaction on the final loaded resource.  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316073\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/mediaelement/HTMLMediaElement.h"], "git_node": "5a336aec204efa8620b88e0881922d712068c947", "git_parents": ["e66976b35cd0b8a8182c4b86dcc93a75a643f505"], "node": "34da31adabff7412e78b4f37f5d33fd63aaaf1e0", "parents": ["3d2ed8a8fe3efc56195beea883f36f60ed620e97"], "tags": []}], "date": 1785878851, "git_changesets": ["5a336aec204efa8620b88e0881922d712068c947"], "user": "dsmith@mozilla.com"}, "27836": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058032.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315759\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316107\n", "files": ["gfx/2d/DrawTargetSkia.cpp", "gfx/2d/Factory.cpp", "gfx/2d/NativeFontResourceGDI.cpp", "gfx/2d/NativeFontResourceGDI.h", "gfx/2d/ScaledFontWin.cpp", "gfx/2d/ScaledFontWin.h", "gfx/2d/Types.h", "gfx/2d/UnscaledFontGDI.h", "gfx/2d/moz.build"], "git_node": "9e8af16d2158e36b76d905ab953ad0eb2c7dda37", "git_parents": ["5a336aec204efa8620b88e0881922d712068c947"], "node": "07c73a567889bcd4942a5eda3e1f73a232743428", "parents": ["34da31adabff7412e78b4f37f5d33fd63aaaf1e0"], "tags": []}], "date": 1785878897, "git_changesets": ["9e8af16d2158e36b76d905ab953ad0eb2c7dda37"], "user": "dsmith@mozilla.com"}, "27837": {"changesets": [{"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2054270 - Scope the tab strip status bar gradient composition to the activity lifecycle  a=diannaS\n\n- Scope the gradient overlay Recomposer to the Activity lifecycle so that it will recompose across Activity#recreate, which is how toggling browser mode works.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315532\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316287\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/TabStripStatusBarView.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/theme/TabStripStatusBarViewTest.kt"], "git_node": "eac0d1e4d0c52e8cb65f2cacf369da6644671ffc", "git_parents": ["9e8af16d2158e36b76d905ab953ad0eb2c7dda37"], "node": "5d8555b44be0a9363537c993f189d89f67f402a3", "parents": ["07c73a567889bcd4942a5eda3e1f73a232743428"], "tags": []}], "date": 1785892386, "git_changesets": ["eac0d1e4d0c52e8cb65f2cacf369da6644671ffc"], "user": "dsmith@mozilla.com"}, "27838": {"changesets": [{"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - fix unbalanced AddRef/Release in SocketProcessParent.  a=diannaS\n\nBecause SocketProcessParent::DeallocPWebrtcTCPSocketParent is never called,\nthe AddRef in AllocPWebrtcTCPSocketParent was never balanced with a Release.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316422\n", "files": ["dom/media/webrtc/transport/ipc/WebrtcTCPSocketParent.h", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h"], "git_node": "c2edef2ddae10c29887fd9e17ff0bb13b79c6d99", "git_parents": ["eac0d1e4d0c52e8cb65f2cacf369da6644671ffc"], "node": "290cced0050b19ab8f4603d45ab94b26c2e05a56", "parents": ["5d8555b44be0a9363537c993f189d89f67f402a3"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - add checkRemoteCandidatePorts to test_peerConnection_portRestrictions.html  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316423\n", "files": ["dom/media/webrtc/tests/mochitests/test_peerConnection_portRestrictions.html"], "git_node": "14217383312c7eb59675a5c92b2201c67b6bb1f6", "git_parents": ["c2edef2ddae10c29887fd9e17ff0bb13b79c6d99"], "node": "5888775b41384f14ec46945a3d9ff4275f28c18f", "parents": ["290cced0050b19ab8f4603d45ab94b26c2e05a56"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Fix stale comment in UDPSocketParent::RecvOutgoingData.  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316424\n", "files": ["dom/network/UDPSocketParent.cpp"], "git_node": "342506c7229d63e65613fe4765ff14068655863b", "git_parents": ["14217383312c7eb59675a5c92b2201c67b6bb1f6"], "node": "d0d12b0ce25456c26b7d59d728eb4204742f360f", "parents": ["5888775b41384f14ec46945a3d9ff4275f28c18f"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Expose the webrtc port allowlist as a shared IsWebrtcPortAllowed helper.  a=diannaS\n\nTurn the gGoodWebrtcPortList allowlist into IceServerParser::kGoodWebrtcPortList\nand make the file-local IsPortAllowed check to a public mozilla::IsWebrtcPortAllowed\nhelper, so the outgoing port restriction can be reused outside of ICE server URL\nparsing. No behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316425\n", "files": ["dom/media/webrtc/common/IceServerParser.cpp", "dom/media/webrtc/common/IceServerParser.h"], "git_node": "b72572be81c437a3bdff8b46bafffeb6f3d21dc5", "git_parents": ["342506c7229d63e65613fe4765ff14068655863b"], "node": "60a6159cede638d2df8c62a0d7ccb26c1b843025", "parents": ["d0d12b0ce25456c26b7d59d728eb4204742f360f"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Apply outgoing port restrictions to remote ICE candidate destinations in NrSocket.  a=diannaS\n\nNrSocket (used for direct UDP/TCP sockets in the socket process and parent\nprocess) now rejects sends/connects to ports that are not allowed for webrtc,\nvia NrSocketBase::IsForbiddenAddress.  This blocks remote ICE candidates that\npoint at restricted destination ports in parent or socket process, the same\nway Bug 1677046 closed for them for ICE server URLs.  IsForbiddenAddress also\ngains the webrtc port allowlist so 53/3478/5349 stay usable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316426\n", "files": ["dom/media/webrtc/transport/nr_socket_prsock.cpp", "dom/media/webrtc/transport/nr_socket_prsock.h", "dom/media/webrtc/transport/test/test_nr_socket_unittest.cpp"], "git_node": "633edb1591abcc377e6d9a12b254dc7e64c217b5", "git_parents": ["b72572be81c437a3bdff8b46bafffeb6f3d21dc5"], "node": "104700c7b7dc21762697db0040149a04f210f628", "parents": ["60a6159cede638d2df8c62a0d7ccb26c1b843025"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Enforce the webrtc outgoing port restriction in the parent process for content-process UDP.  a=diannaS\n\nWhen mtransport runs in the content process, UDP is sent via NrUdpSocketIpc to\nUDPSocketParent in the parent process. Drop outgoing packets destined for a\nrestricted port there, so the restriction is enforced in a process the content\nprocess cannot bypass. A disallowed port is dropped silently (IPC_OK) rather\nthan treated as a protocol violation, since it can come from a remote candidate\nsupplied through the normal API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316427\n", "files": ["dom/media/webrtc/transport/nr_socket_prsock.cpp", "dom/media/webrtc/transport/stun_socket_filter.cpp"], "git_node": "cfc7697b0e32cd414fb2c68fc3aa75a14eda4b4e", "git_parents": ["633edb1591abcc377e6d9a12b254dc7e64c217b5"], "node": "2713c7132d596fac3e1cfcdbc7e7f13419be5e1f", "parents": ["104700c7b7dc21762697db0040149a04f210f628"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Enforce the webrtc outgoing port restriction in the parent process for ICE-TCP.  a=diannaS\n\nICE-TCP connections are opened via WebrtcTCPSocketParent::RecvAsyncOpen (in the\nsocket or parent process). Reject opens to a restricted destination port there,\nsignalling a normal connection failure to the child via OnClose rather than\ntearing down the process with IPC_FAIL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316428\n", "files": ["dom/media/webrtc/transport/ipc/WebrtcTCPSocketParent.cpp"], "git_node": "3faf461c16c67beeac2500f6ce51c6943d6c6ac0", "git_parents": ["cfc7697b0e32cd414fb2c68fc3aa75a14eda4b4e"], "node": "cd14d031bbf72f8e5c066556d8a0544163961dc5", "parents": ["2713c7132d596fac3e1cfcdbc7e7f13419be5e1f"], "tags": []}], "date": 1785892629, "git_changesets": ["c2edef2ddae10c29887fd9e17ff0bb13b79c6d99", "14217383312c7eb59675a5c92b2201c67b6bb1f6", "342506c7229d63e65613fe4765ff14068655863b", "b72572be81c437a3bdff8b46bafffeb6f3d21dc5", "633edb1591abcc377e6d9a12b254dc7e64c217b5", "cfc7697b0e32cd414fb2c68fc3aa75a14eda4b4e", "3faf461c16c67beeac2500f6ce51c6943d6c6ac0"], "user": "dsmith@mozilla.com"}, "27839": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059997.  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316166\n", "files": ["dom/canvas/WebGLBuffer.cpp"], "git_node": "affa6376e24d4e7a41488e714c0a5e98b5c11f3e", "git_parents": ["3faf461c16c67beeac2500f6ce51c6943d6c6ac0"], "node": "015cdf01aa60deba18acc1acf9ef28dde2c0f630", "parents": ["cd14d031bbf72f8e5c066556d8a0544163961dc5"], "tags": []}], "date": 1785892673, "git_changesets": ["affa6376e24d4e7a41488e714c0a5e98b5c11f3e"], "user": "dsmith@mozilla.com"}, "27840": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-es-rMX/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-pa-rIN/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-cak/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-es-rMX/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-pa-rIN/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml",