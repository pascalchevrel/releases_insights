esc": "Bug 2054677 - Compare more fields against original load state and history.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313005\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313963\n", "files": ["docshell/base/nsDocShellLoadState.cpp", "docshell/shistory/SessionHistoryEntry.h", "netwerk/ipc/DocumentLoadListener.cpp"], "git_node": "f570aba716a88d8f25c92a1aea086298b2a106e4", "git_parents": ["b05f2eefbf9458bb962457d805cd38a597989380"], "node": "5fe08d385bd68efe5f6d155800abec477019e4cf", "parents": ["9cbea5f49fc72f57c0f7f7cb55e006f884cf4ee2"], "tags": []}], "date": 1784918080, "git_changesets": ["f570aba716a88d8f25c92a1aea086298b2a106e4"], "user": "dsmith@mozilla.com"}, "27595": {"changesets": [{"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056728:  Replace remaining placeholder strings for tab groups  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313541\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313884\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabitems/SharedTabItemUi.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "e44f0804c2647b5037e265df21316094ced0b2f5", "git_parents": ["f570aba716a88d8f25c92a1aea086298b2a106e4"], "node": "675758a0ce959e1826b51408932f3b2cc8796a11", "parents": ["5fe08d385bd68efe5f6d155800abec477019e4cf"], "tags": []}], "date": 1784918819, "git_changesets": ["e44f0804c2647b5037e265df21316094ced0b2f5"], "user": "dsmith@mozilla.com"}, "27596": {"changesets": [{"author": "Bryan Johns \u003cbjohns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056725 - Adds missing browser.smartwindow.telemetryLogLevel pref  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313547\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313960\n", "files": ["browser/app/profile/firefox.js"], "git_node": "d3713afcb202f2f3f09d2218fb7977faf143185e", "git_parents": ["e44f0804c2647b5037e265df21316094ced0b2f5"], "node": "17113e416d4ad1ea3769dbae002d1cd920c6eb88", "parents": ["675758a0ce959e1826b51408932f3b2cc8796a11"], "tags": []}], "date": 1784918852, "git_changesets": ["d3713afcb202f2f3f09d2218fb7977faf143185e"], "user": "dsmith@mozilla.com"}, "27597": {"changesets": [{"author": "Bryan Johns \u003cbjohns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056626 - Added timeout to return from getPageContent if no results by READ_TIMEOUT_MS  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313323\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314060\n", "files": ["browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_search_the_web.js"], "git_node": "880fa46bbfb1225ac2f08a74f4fc031130631b55", "git_parents": ["d3713afcb202f2f3f09d2218fb7977faf143185e"], "node": "82216249d56d3338743b2954549a9686a4406de8", "parents": ["17113e416d4ad1ea3769dbae002d1cd920c6eb88"], "tags": []}, {"author": "Bryan Johns \u003cbjohns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056271 - Removed run_search from tools and embedded behavior switch in search_the_web  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313088\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314061\n", "files": ["browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_search_the_web.js", "browser/components/aiwindow/models/tests/xpcshell/test_Chat.js", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs"], "git_node": "bf8bee770bdfa71cc289fa4d9688f6a9ac1ab794", "git_parents": ["880fa46bbfb1225ac2f08a74f4fc031130631b55"], "node": "09b3cd36e5a09cc5039b24ec79a5cdc02dee9e75", "parents": ["82216249d56d3338743b2954549a9686a4406de8"], "tags": []}], "date": 1784919331, "git_changesets": ["880fa46bbfb1225ac2f08a74f4fc031130631b55", "bf8bee770bdfa71cc289fa4d9688f6a9ac1ab794"], "user": "dsmith@mozilla.com"}, "27598": {"changesets": [{"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056501: Allow detecting newer riscv64 extensions on older kernels.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313476\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313939\n", "files": ["js/src/jit/riscv64/Architecture-riscv64.cpp"], "git_node": "1858cde36e85eb5dce10ed33d7502b914d3fa544", "git_parents": ["bf8bee770bdfa71cc289fa4d9688f6a9ac1ab794"], "node": "f1644a3583333bc2ea5bcfb1b05d4c79b39967da", "parents": ["09b3cd36e5a09cc5039b24ec79a5cdc02dee9e75"], "tags": []}], "date": 1784919358, "git_changesets": ["1858cde36e85eb5dce10ed33d7502b914d3fa544"], "user": "dsmith@mozilla.com"}, "27599": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2053095 - Move untrusted marking back to document-element-inserted, a=dsmith\n\nIt turns out that the location in BrowserChild.cpp appears to have been\nsubstantially earlier than the previous location, which may have caused\nus to miss some scripts in the script cache.\n\nAfter this change, it's likely that the first point when a process\nbecomes untrusted is as the HttpChannelChild is created within the\nprocess.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311914\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313780\n", "files": ["dom/base/nsContentSink.cpp", "dom/ipc/BrowserChild.cpp"], "git_node": "27ba38d958cf133e557e99c483e42e402d0e7576", "git_parents": ["1858cde36e85eb5dce10ed33d7502b914d3fa544"], "node": "a2bfe76a1c4416ace7ef640897fde2499317e585", "parents": ["f1644a3583333bc2ea5bcfb1b05d4c79b39967da"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054812 - Check account when vpn toggle fails for an entitled user a=dsmith\n\nThis patch aims to unblock authenticated users that initiated VPN auth flow while\ntheir account was still being warming up. That would result in user\nhaving \"entitled\" account status, but ip protection service would be\nstill \"unauthenticated\", which locks the UI in connecting state. Why?\n\nNormally, that state means that the user has finished auth flow, and\nip protection machinery is processing new data and eventually moving\ninto \"ready\" state. The source of truth for the UI is the service state.\nThe auth flow is finished (we closed the custom tab with account),\nbut the ip protection state hasn't updated yet - so the UI goes into\nconnecting state, to show that it's working and prevent user from\nrepeated calls.\n\nHappy state flow is, account manager notifies it's ready, vpn ui\nelements initiate account check - that warms up the ip protection\nmachinery, and then user goes through the auth flow, so ip protection\nresponds to the auth flow properly, and eventually goes into ready\nstate.\n\nBut vpn auth flow doesn't wait for fxa to finish warming up, and the vpn\nauth flow might be started before that.\n\nI tried several approaches here:\n1. Make CheckAccount work for WarmingUp account state. Didn't work:\n   WarmingUp means both not account and an account in process\n2. Lock \"get started\" until WarmingUp finishes. Didn't work: the\n   CheckAccount is fired when the screen is opened, it doesn't listen to\n   the account state.\n3. Making IPProtectionStorageSynchronizer to also check account if\n   NeedsAuthorization happens during Auth flow. Didn't work: it still\n   leaves the race condition, fxa might take longer than auth flow.\n\nI also noticed that when FXA is not ready, the state transitions as if\nit were Authentication (AwaitingAuthentication, etc), which then updates\nwith \"NeedsAuthorization\" - and the FXA page shows Authorization. What's\nhappening in code doesn't represent what's going on.\n\nBut in the end, I want to avoid locking user in the \"connecting\" state.\nOur auth proccess always ends with a toggle action, so if that errors\nwhile we are entitled but the service state is still unauthenticated, we\nit means fxa and vpn auth went out of sync, and we should check account\nstate (warm up the ip protection machinery).\n\nIn theory, we could warn a check after seeing a toggle failure while the\nservice is unauthenticated - without considering account state, but I\nwanted to be eplicit about this case to minimize side-effects when we\nintroduce gpi as a way to enroll.\n\nFor that racing condition, the user will see a snackbar error \"try\nagain\", but they actually will be able to try again. Added telemetry to\nsee how often that happens, for prioritizing feature improvments here.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312137\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313800\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddlewareTest.kt"], "git_node": "6a4fa1ee26ac6753e5509e6650d92efbfb7dc6c4", "git_parents": ["27ba38d958cf133e557e99c483e42e402d0e7576"], "node": "807b5397892741e495f214626d0d5422a79192b2", "parents": ["a2bfe76a1c4416ace7ef640897fde2499317e585"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2055765 - Make `EventStateManager` store last `eMouseDown` and `eMouseUp` target and `HTMLInputElement` check them if the clear button is recreated a=dsmith\n\n`click` event target must be the closest and connected inclusive common\nancestor of `mousedown` and `mouseup` event targets and the clear button\nof `HTMLInputElement` is recreated at a reframe. So, if clicking the\nclear button causes a reframe of the `\u003cinput\u003e`, the `click` event target\nis the common ancestor of the old button and the new button. So,\n`HTMLInputElement` cannot check whether the button is clicked only with\nthe event target.\n\nThis patch makes `EventStateManager` store the last `eMouseDown` and\n`eMouseUp` targets while dispatching mouse button events and click\nevents. Therefore, the `ePointerClick` handler of `HTMLInputElement`\ncan know the `eMouseDown` and `eMouseUp` target even after they are\ndisconnected.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313368\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313911\n", "files": ["dom/events/EventStateManager.cpp", "dom/events/EventStateManager.h", "dom/html/HTMLInputElement.cpp", "dom/html/test/forms/mochitest.toml", "dom/html/test/forms/test_input_click_clear_button_without_focus.html"], "git_node": "d9114247d83ec23ca3e9c148f21970646deaf830", "git_parents": ["6a4fa1ee26ac6753e5509e6650d92efbfb7dc6c4"], "node": "bdbb2a2c875495d504f246fa3b33fe79df1825b2", "parents": ["807b5397892741e495f214626d0d5422a79192b2"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053827 - Service the RemoteWorkerDebugger IPC handshake from a worker's nested sync loop. a=dsmith\n\nWorkerPrivate::Enable/DisableRemoteDebugger block the worker's parent thread\nuntil the registration/unregistration handshake reply (RecvRegisterDone /\nRecvUnregisterDone) runs on the worker thread. That reply is delivered on the\nworker's debugger queue, which a nested RunCurrentSyncLoop does not drain, so a\nworker parked in a sync loop that needs the parent thread (e.g. a SharedWorker\nrunning new EventSource()) deadlocks the content process when the owner page is\nfrozen/thawed via bfcache.\n\nKeep the synchronous registration contract but let RunCurrentSyncLoop service\nonly the debugger IPC handshake runnables (WrappedDebuggerRunnable) while\nmProcessDebuggerIPCHandshake is set, leaving debugger script/message runnables\ndeferred to DoRunLoop as before.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312004\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313979\n", "files": ["dom/workers/Queue.h", "dom/workers/WorkerEventTarget.cpp", "dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerPrivate.h", "dom/workers/WorkerRunnable.h", "dom/workers/test/mochitest.toml", "dom/workers/test/remoteDebugger_freeze_syncloop_frame.html", "dom/workers/test/remoteDebugger_freeze_syncloop_hang.sjs", "dom/workers/test/remoteDebugger_freeze_syncloop_nav.html", "dom/workers/test/remoteDebugger_freeze_syncloop_worker.js", "dom/workers/test/test_remoteDebugger_freeze_syncloop.html"], "git_node": "ce26e842b9f53a6087eec57b25f8e76f30600c47", "git_parents": ["d9114247d83ec23ca3e9c148f21970646deaf830"], "node": "02a3ce0bc8d6f53e0d56d76ca59e6d52a24bb704", "parents": ["bdbb2a2c875495d504f246fa3b33fe79df1825b2"], "tags": []}], "date": 1784919674, "git_changesets": ["27ba38d958cf133e557e99c483e42e402d0e7576", "6a4fa1ee26ac6753e5509e6650d92efbfb7dc6c4", "d9114247d83ec23ca3e9c148f21970646deaf830", "ce26e842b9f53a6087eec57b25f8e76f30600c47"], "user": "dsmith@mozilla.com"}, "27600": {"changesets": [{"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2056791: Handle larger mDNS addresses than we use.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313577\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313711\n", "files": ["dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_candidate.cpp"], "git_node": "6f8459b58e37c9e30e2dadd585d6384211b141ab", "git_parents": ["ce26e842b9f53a6087eec57b25f8e76f30600c47"], "node": "b6e875cff0b0073be80fbfc5b0ce6fb62dfa768a", "parents": ["02a3ce0bc8d6f53e0d56d76ca59e6d52a24bb704"], "tags": []}], "date": 1784922295, "git_changesets": ["6f8459b58e37c9e30e2dadd585d6384211b141ab"], "user": "dsmith@mozilla.com"}, "27601": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2054351 - Make `Selection::StyledRanges::ReorderRangesIfNecessary` compare range boundaries in the flat tree  a=diannaS\n\nWhen `Selection` compares range boundaries, it always uses\n`TreeKind::FlatForSelection`. Therefore, this drops the template\nparameters of `CompareToRangeStart` and `CompareToRangeEnd`.\n\nThen, `Selection::StyledRanges::ReorderRangesIfNecessary` calls\n`nsContentUtils::ComparePoints` with range boundaries in\n`TreeKind::DOM`. So, this mismatch causes the crash with unexpected\nsituation.\n\nHowever, this patch does not strict `nsContentUtils::ComparePoints`\nbecause it requires a big patch. Therefore, this adds error handling\nand assertions into the related methods.\n\nIn a follow up, I think we should make `RangeBoundaryBase` split for\n`TreeKind::DOM` and `TreeKind::FlatForSelection`. Then, we can prevent\nmisuse of wrong tree kind boundaries.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313392\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313680\n", "files": ["dom/base/Selection.cpp", "dom/base/nsContentUtils.cpp"], "git_node": "f7a97b30388497bb775cba2e1fc05d9df1709d1f", "git_parents": ["6f8459b58e37c9e30e2dadd585d6384211b141ab"], "node": "bd746d7734efda71dbafde23e19fd8905c72153b", "parents": ["b6e875cff0b0073be80fbfc5b0ce6fb62dfa768a"], "tags": []}], "date": 1784927553, "git_changesets": ["f7a97b30388497bb775cba2e1fc05d9df1709d1f"], "user": "dsmith@mozilla.com"}, "27602": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056779.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313599\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313925\n", "files": ["dom/canvas/DrawTargetWebgl.cpp"], "git_node": "87b0a7ca26369e3bce3130979a5a59b2b5774877", "git_parents": ["f7a97b30388497bb775cba2e1fc05d9df1709d1f"], "node": "bb994f3e34209b510a571c6aa90cde60f27195bb", "parents": ["bd746d7734efda71dbafde23e19fd8905c72153b"], "tags": []}], "date": 1784927581, "git_changesets": ["87b0a7ca26369e3bce3130979a5a59b2b5774877"], "user": "dsmith@mozilla.com"}, "27603": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2056558  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313362\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313627\n", "files": ["gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "gfx/layers/wr/WebRenderBridgeParent.cpp"], "git_node": "2d5cf3e5632f097316c722d4a3c6e35ed3abb85e", "git_parents": ["87b0a7ca26369e3bce3130979a5a59b2b5774877"], "node": "3a5081f287e86f84d4a78a1fa4a1c362d51f72ae", "parents": ["bb994f3e34209b510a571c6aa90cde60f27195bb"], "tags": []}], "date": 1784927615, "git_changesets": ["2d5cf3e5632f097316c722d4a3c6e35ed3abb85e"], "user": "dsmith@mozilla.com"}, "27604": {"changesets": [{"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055341 - Update SmartWindow to use AboutNewTab TopSites API a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312781\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314030\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_topsites.js"], "git_node": "b4e895d73d9012dae3a793a34a51cd8560a5bfc7", "git_parents": ["2d5cf3e5632f097316c722d4a3c6e35ed3abb85e"], "node": "0c7288bf710d68865585830328473122fa099d52", "parents": ["3a5081f287e86f84d4a78a1fa4a1c362d51f72ae"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048336 - Make hide of Smart Window first run onboarding screen nimbus configurable a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312839\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314035\n", "files": ["browser/components/aiwindow/ui/content/firstrun.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_firstrun.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "bc589d06d91a50034650ff48069ca94d40a2d3e8", "git_parents": ["b4e895d73d9012dae3a793a34a51cd8560a5bfc7"], "node": "56bf93687eafb553fe7284fd0ade2267b145cdd1", "parents": ["0c7288bf710d68865585830328473122fa099d52"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056193 - Make smart window switcher clickable during first run a=dsmith\n\n**Cause**: When I made the window switcher button part of customizable UI another patch landed that touched the CSS for immersive view and first run. During a rebase I didn't notice this new CSS made the window switcher button unclickable as well via `pointer-events: none`.\n\n**Solution**: Adjust the new CSS so the window switcher button is clickable and the rest of the tabs toolbar stays with `pointer-events: none`.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313050\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314039\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aiwindow_firstrun.js", "browser/themes/shared/browser-shared.css"], "git_node": "80e55a6028685cc7c2579c645184aa1989240b28", "git_parents": ["bc589d06d91a50034650ff48069ca94d40a2d3e8"], "node": "65894bba2f93b23b44638f3dbd04b0d56dc92548", "parents": ["56bf93687eafb553fe7284fd0ade2267b145cdd1"], "tags": []}], "date": 1784928313, "git_changesets": ["b4e895d73d9012dae3a793a34a51cd8560a5bfc7", "bc589d06d91a50034650ff48069ca94d40a2d3e8", "80e55a6028685cc7c2579c645184aa1989240b28"], "user": "dsmith@mozilla.com"}, "27605": {"changesets": [{"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2044385 - Display Exa web search activity in the Smart Window Action Log.  a=diannaS\n\nWhen the search_the_web tool call runs, the Action Log labels (\"Searching the web with Exa\" while pending, \"Searched the web with Exa\" once complete) render \"Exa\" as a link to a SUMO support article.\n\nThe pending label's animated loading treatment is handled separately by bug 2046612.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311466\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314085\n", "files": ["browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.css", "browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/ToolActionLog.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_ai_action_result.js", "browser/components/aiwindow/ui/test/xpcshell/test_ToolActionLog.js", "browser/locales/en-US/browser/aiWindowContent.ftl"], "git_node": "bd136406be7f0b631d95ddccdb3676447455e657", "git_parents": ["80e55a6028685cc7c2579c645184aa1989240b28"], "node": "55690ddb615b7664763db5b59bedae7f861e5ae4", "parents": ["65894bba2f93b23b44638f3dbd04b0d56dc92548"], "tags": []}], "date": 1784928631, "git_changesets": ["bd136406be7f0b631d95ddccdb3676447455e657"], "user": "dsmith@mozilla.com"}, "27606": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2056795 - Don't start deferred loads immediately if aren't supposed to.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313580\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313810\n", "files": ["layout/style/Loader.cpp", "layout/style/SharedStyleSheetCache.cpp", "testing/web-platform/tests/html/semantics/document-metadata/the-link-element/link-load-event-alt-001.html", "testing/web-platform/tests/html/semantics/document-metadata/the-link-element/link-load-event-alt-002.html", "testing/web-platform/tests/html/semantics/document-metadata/the-link-element/link-load-event-alt.html"], "git_node": "a95721f2846c40067c074dceee6ebb17c6c34d40", "git_parents": ["bd136406be7f0b631d95ddccdb3676447455e657"], "node": "8732011e1c5986ae8a04bce2b3fedecf98a27d5d", "parents": ["55690ddb615b7664763db5b59bedae7f861e5ae4"], "tags": []}], "date": 1784928669, "git_changesets": ["a95721f2846c40067c074dceee6ebb17c6c34d40"], "user": "dsmith@mozilla.com"}, "27607": {"changesets": [{"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056650 - Mark moz-newtab-wallpaper as known-cacheable so newtab custom wallpapers stop flashing a=dsmith\n\nNewtab has its own special wallpaper protocol for custom wallpapers, and it\nwas missing from the knownCacheable detection. Combined with newtab\npreloading, that made the image periodically fail ValidateEntry and get\nre-requested, causing the flash.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313305\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314080\n", "files": ["dom/base/nsContentUtils.cpp"], "git_node": "89706b190d8363fa34cc15b2eeae920955a2de00", "git_parents": ["a95721f2846c40067c074dceee6ebb17c6c34d40"], "node": "656c1cbe06f6a51d7920e4f1332fdbac49eb9c13", "parents": ["8732011e1c5986ae8a04bce2b3fedecf98a27d5d"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056345 - Patch frequent linux asan FATAL ERROR a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313137\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314087\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aichat_content_message_event.js"], "git_node": "0deb85753a7a0645dbaf8dea9eccacd5c39f4bff", "git_parents": ["89706b190d8363fa34cc15b2eeae920955a2de00"], "node": "10ca60e9e79eedd68479f7f2d6389ef46795a323", "parents": ["656c1cbe06f6a51d7920e4f1332fdbac49eb9c13"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055260 - Add new memory tracking embedder APIs a=dsmith\n\nAdd GetGCHeapSizeForZone, GetMallocHeapSizeForZone, and\nGetJITHeapSizeForZone to the embedder API. Each of these methods\nreturns one of the sizes that is currently added together and\nreturned by GetMemoryUsageForZone.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312817\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314105\n", "files": ["js/src/jsfriendapi.cpp", "js/src/jsfriendapi.h"], "git_node": "1a087937a5f9ffe923cac199f86c0de19bc6304d", "git_parents": ["0deb85753a7a0645dbaf8dea9eccacd5c39f4bff"], "node": "4d66e31f948d74fbbb723223e156792be0127a1a", "parents": ["10ca60e9e79eedd68479f7f2d6389ef46795a323"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2050183 - part 2 - Update UI tests to support the translations availability only being known later r=android-reviewers,mcarare, a=test-only\n\nWhether the translation feature is available is only known later in the application\nlifetime which conflicts the current tests checking it immediately after the\napplication is opened.\n\nOnly initializing the translations support later was a decision made for\nperformance considerations - https://bugzilla.mozilla.org/show_bug.cgi?id=1958042.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312440\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsCustomizeTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuCustomizeRobot.kt"], "git_node": "1e1240d3b10a9d94936e097af77654e3181d030c", "git_parents": ["1a087937a5f9ffe923cac199f86c0de19bc6304d"], "node": "2d325c218970cfea893db788e55e752f187a5200", "parents": ["4d66e31f948d74fbbb723223e156792be0127a1a"], "tags": []}], "date": 1784928953, "git_changesets": ["89706b190d8363fa34cc15b2eeae920955a2de00", "0deb85753a7a0645dbaf8dea9eccacd5c39f4bff", "1a087937a5f9ffe923cac199f86c0de19bc6304d", "1e1240d3b10a9d94936e097af77654e3181d030c"], "user": "dsmith@mozilla.com"}, "27608": {"changesets": [{"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055991 - Update angle vendor directory in updatebot test yamls. r=ErichDonGubler, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312957\n", "files": ["tools/lint/test/files/updatebot/good1.yaml", "tools/lint/test/files/updatebot/no-revision.yaml"], "git_node": "99230033447fc39558b396d4b13ca40f544de433", "git_parents": ["1e1240d3b10a9d94936e097af77654e3181d030c"], "node": "89c063614b9ebdbf7d9c91b620a9023797526bae", "parents": ["2d325c218970cfea893db788e55e752f187a5200"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056031 - Fix test_popup_button.xhtml regression r=jules, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312928\n", "files": ["toolkit/content/tests/chrome/popup_trigger.js"], "git_node": "0d2e5991c4e32d011e815de0f67dae15f0c5a007", "git_parents": ["99230033447fc39558b396d4b13ca40f544de433"], "node": "e425ba4be2ff9a122d8403bd2f0f2a9be07b0a43", "parents": ["89c063614b9ebdbf7d9c91b620a9023797526bae"], "tags": []}], "date": 1784929473, "git_changesets": ["99230033447fc39558b396d4b13ca40f544de433", "0d2e5991c4e32d011e815de0f67dae15f0c5a007"], "user": "dsmith@mozilla.com"}, "27609": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2056086 - Upgrade json5 and add test  a=diannaS\n\nUpgrade json5 v2.2.1 to v2.2.3, from UMD to ESM, mainly to get rid of\nunnecessary polyfills.\n\nAnd add a unit test that confirms that the library is indeed doing\nanything meaningful. `JSON5.parse` is called from utils.js, but\nreplacing it with `JSON.parse` did not cause test failures at first.\nThat is because no tests were added in bug 1260382, which introduced\nthe original version of the logic.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312910\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314055\n", "files": ["devtools/client/storage/test/browser_storage_values.js", "devtools/client/storage/test/storage-complex-values.html", "devtools/shared/storage/utils.js", "devtools/shared/storage/vendor/JSON5_UPGRADING.md", "devtools/shared/storage/vendor/json5.js", "devtools/shared/storage/vendor/json5.mjs", "devtools/shared/storage/vendor/moz.build"], "git_node": "4d3497ddffa5ecccc6c2a9960fa9ec8828746f0a", "git_parents": ["0d2e5991c4e32d011e815de0f67dae15f0c5a007"], "node": "e44392100ced4d3c3a4617539b332e18ec6d5b23", "parents": ["e425ba4be2ff9a122d8403bd2f0f2a9be07b0a43"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2056076 - Drop freezeBuiltins from devtools loader  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312911\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314056\n", "files": ["devtools/shared/loader/base-loader.sys.mjs"], "git_node": "a3f1843d7bf066729a3af9b29d336875440962fd", "git_parents": ["4d3497ddffa5ecccc6c2a9960fa9ec8828746f0a"], "node": "17eea0449ab970c1054852001ab536e9c2e89d6c", "parents": ["e44392100ced4d3c3a4617539b332e18ec6d5b23"], "tags": []}], "date": 1784929842, "git_changesets": ["4d3497ddffa5ecccc6c2a