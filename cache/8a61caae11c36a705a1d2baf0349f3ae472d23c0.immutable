6e", "git_parents": ["d90630a2c2c7455872bc6f037fa4b34507017caf"], "node": "6075a5e37ddbdf738564b10f1e069cad98742854", "parents": ["3b0fb71ae6ad43cf7cdfb4dc3efdaccaa14671ef"], "tags": []}], "date": 1785242773, "git_changesets": ["b76a04437cd19d8e600ac0e8a84ef30bdb2e826e"], "user": "ffxbld@lando.moz.tools"}, "27663": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 44d12294c895576c9a489c0d7efa44b2ea0f7d71 with FIREFOX_153_0_1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "6625d06aff5742bf828966e63ec8e170c25f0300", "git_parents": ["b76a04437cd19d8e600ac0e8a84ef30bdb2e826e"], "node": "5484bed3001ea9b0e31afe384c25e9509edf09d8", "parents": ["6075a5e37ddbdf738564b10f1e069cad98742854"], "tags": []}], "date": 1785242823, "git_changesets": ["6625d06aff5742bf828966e63ec8e170c25f0300"], "user": "ffxbld@lando.moz.tools"}, "27664": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055458 - Don't trigger read barrier for assertion in NukeRemovedCrossCompartmentWrapper  a=diannaS\n\nThe read barrier can end up causing an assertion to fail because the CCW isn't\nin the wrapper map, but this is expected when calling\nNukeRemovedCrossCompartmentWrapper. The barrier isn't necessary to assert the\npointers are different.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313160\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314617\n", "files": ["js/src/proxy/BaseProxyHandler.cpp"], "git_node": "679d4c5009301491aaa5f5ba061d4047ce6314df", "git_parents": ["15af466199c03f27523835e86c6c4f670cd7128c"], "node": "9eafde5a5bc9cd50a530a1261aedcd121a5f9598", "parents": ["c138a9e1bf3d7792da636b6140bd67c17b59346e"], "tags": []}], "date": 1785259908, "git_changesets": ["679d4c5009301491aaa5f5ba061d4047ce6314df"], "user": "dsmith@mozilla.com"}, "27665": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057174 - Make the `InstallTime` crash annotation stable between runs on Windows  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313685\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314377\n", "files": ["toolkit/crashreporter/crash_helper_common/src/appinfo/windows.rs"], "git_node": "e8dc90c9c4127b7232497b18b78d741e79771e2b", "git_parents": ["679d4c5009301491aaa5f5ba061d4047ce6314df"], "node": "069a9fc02b88e30568dd22879bcce667966d4ed0", "parents": ["9eafde5a5bc9cd50a530a1261aedcd121a5f9598"], "tags": []}], "date": 1785260388, "git_changesets": ["e8dc90c9c4127b7232497b18b78d741e79771e2b"], "user": "dsmith@mozilla.com"}, "27666": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048118: Part 1 - Back off the NetworkGeolocationProvider retry timer while requests are failing  a=diannaS\n\nApply bounded exponential backoff to the repeating request timer after network\nfailures (increasing up to geo.provider.network.backoffMaxMs, default 20s) so a\nfailing or unreachable endpoint is not retried every 5s indefinitely, which\ndrains battery on always-on machines. The backoff is reset to the normal\ncadence on a new watch request and on a successful response, so genuine\nrequests are never delayed by a prior failure's backoff.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309730\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314444\n", "files": ["dom/system/NetworkGeolocationProvider.sys.mjs"], "git_node": "f7eb51288ffb949badeedd12ebd18169563f991a", "git_parents": ["e8dc90c9c4127b7232497b18b78d741e79771e2b"], "node": "9c8667321a59cad209f4dfe705e0a8c6a50a09ae", "parents": ["069a9fc02b88e30568dd22879bcce667966d4ed0"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048118: Part 2 - Stop active NetworkGeolocationProvider when GeoClue recovers  a=diannaS\n\nUpdateLastPosition only stopped the fallback _wait timer_, so an MLS fallback\nthat had already started (e.g. after a GeoClue error) kept running its\nNetworkGeolocation provider -- issuing network requests for the rest of the\nsession -- despite GeoClue producing positions again. Shut down an active\nfallback on recovery with \"ProviderResponded\", matching how CoreLocation and\nPortal work.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309731\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314445\n", "files": ["dom/system/linux/GeoclueLocationProvider.cpp"], "git_node": "5f4c3c8c8cff636fa46afbaf3e733905b124560b", "git_parents": ["f7eb51288ffb949badeedd12ebd18169563f991a"], "node": "42e563a934343b7f7906c19fdaa49de268eced37", "parents": ["9c8667321a59cad209f4dfe705e0a8c6a50a09ae"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048118: Part 3 - Reset NetworkGeolocationProvider request backoff on a new request  a=diannaS\n\nReset the NetworkGeolocationProvider failure backoff whenever a different\nprovider falls back, which can happen multiple times.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309732\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314446\n", "files": ["dom/geolocation/MLSFallback.cpp", "dom/system/NetworkGeolocationProvider.sys.mjs"], "git_node": "f72b281d34e15e6818bb6da790c7030fcccd251f", "git_parents": ["5f4c3c8c8cff636fa46afbaf3e733905b124560b"], "node": "1a6de9372acc28a4138daaa65f992047a766e3c1", "parents": ["42e563a934343b7f7906c19fdaa49de268eced37"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048118: Part 4 - Persist the NetworkGeolocationProvider request cache across shutdown  a=diannaS\n\nStop clearing gCachedRequest in shutdown() so a recent position can be reused\nacross the provider's stop/restart cycles within a browser run, instead of\ncold-starting a network request for each intermittent geolocation use.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313338\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314447\n", "files": ["dom/geolocation/test/unit/test_geolocation_network_cache.js", "dom/geolocation/test/unit/xpcshell.toml", "dom/system/NetworkGeolocationProvider.sys.mjs"], "git_node": "b12af245c3f77d6feb08a2e10603c08916701460", "git_parents": ["f72b281d34e15e6818bb6da790c7030fcccd251f"], "node": "f00d64b73a47336dcd4714df6ee593a3fa410bb5", "parents": ["1a6de9372acc28a4138daaa65f992047a766e3c1"], "tags": []}], "date": 1785260841, "git_changesets": ["f7eb51288ffb949badeedd12ebd18169563f991a", "5f4c3c8c8cff636fa46afbaf3e733905b124560b", "f72b281d34e15e6818bb6da790c7030fcccd251f", "b12af245c3f77d6feb08a2e10603c08916701460"], "user": "dsmith@mozilla.com"}, "27667": {"changesets": [{"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054501 - Gate Auto Tab Grouping on en-* locale and on-device ML  a=diannaS\n\nBuilding Auto Tab Grouping 'v0' - largely exploratory and gated behind a pref\nNo finalized designs yet, but there is a demo: https://auto-tab-grouping.netlify.app sw0626\n\n browser.smartwindow.autoTabGrouping.enabled\n browser.ml.enable + SmartTabGroupingManager.isAllowed\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312297\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314729\n", "files": ["browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js"], "git_node": "5d1f76587b17bbb806a1783ff84eb2868e933896", "git_parents": ["b12af245c3f77d6feb08a2e10603c08916701460"], "node": "cbb48b39068888acb0006abb5d8ed36146cd460f", "parents": ["f00d64b73a47336dcd4714df6ee593a3fa410bb5"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054504 - Render the \"Group my tabs\" panel with Lit, localize it, and complete an accessibility pass  a=diannaS\n\nRenders the panel and flyout as light-DOM Lit custom elements\n(smartwindow-group-tabs-card / -flyout), moves the panel strings to Fluent (in\na preview/ file, since the feature is still in development), and adds an\naccessibility pass:\n\n- the card is role=\"dialog\" with aria-labelledby; focus moves into it on open\n  and returns to the toolbar button on Escape\n- suggestions are focusable buttons; focusing one opens its flyout (the\n  keyboard equivalent of hovering)\n- decorative tiles, color dots, and the chevron are aria-hidden\n- suggestion rows and the flyout expose Fluent-localized accessible names\n\nDemo (no finalized designs yet): https://auto-tab-grouping.netlify.app sw0626\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312298\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314730\n", "files": ["browser/base/content/browser.js", "browser/base/content/browser.xhtml", "browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/locales-preview/autoTabGrouping.ftl", "browser/locales/jar.mn", "browser/themes/shared/smartwindowGroupTabs.css"], "git_node": "950b4b288d98af55791b62ec098976af8f10545c", "git_parents": ["5d1f76587b17bbb806a1783ff84eb2868e933896"], "node": "929485a6fe0db8c018efcce30a07bf8c441489d4", "parents": ["cbb48b39068888acb0006abb5d8ed36146cd460f"], "tags": []}], "date": 1785263070, "git_changesets": ["5d1f76587b17bbb806a1783ff84eb2868e933896", "950b4b288d98af55791b62ec098976af8f10545c"], "user": "dsmith@mozilla.com"}, "27668": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings mobile-experiments mobile-merino-manifest ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314751\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "mobile/android/fenix/app/src/main/res/raw/initial_experiments.json", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "toolkit/components/certviewer/content/components/logNameTable.mjs"], "git_node": "2eba43e9c3e6b564db8bb52830a2bf9737b982aa", "git_parents": ["950b4b288d98af55791b62ec098976af8f10545c"], "node": "1c5bdcc8cd7ce8c3bce54d89852df44346bb6039", "parents": ["929485a6fe0db8c018efcce30a07bf8c441489d4"], "tags": []}], "date": 1785269528, "git_changesets": ["2eba43e9c3e6b564db8bb52830a2bf9737b982aa"], "user": "rvandermeulen@mozilla.com"}, "27669": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-bg/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-dsb/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-el/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values