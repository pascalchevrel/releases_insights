node": "1d7be8374b28638e17922aa04f9a708e48be0e3e", "git_parents": ["489fcfb7613d80b17979a1688db17a1067835774"], "node": "abff8cf729e20810e0263b27de0101ff16d172e3", "parents": ["e756a2dbbb29fd08f314b9975f2d2a7256b585fc"], "tags": []}], "date": 1785068290, "git_changesets": ["1d7be8374b28638e17922aa04f9a708e48be0e3e"], "user": "dsmith@mozilla.com"}, "27623": {"changesets": [{"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2054787: Simplify this; alpn was hard-coded anyway.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313609\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314044\n", "files": ["dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/transport/ipc/WebrtcProxyConfig.ipdlh", "dom/media/webrtc/transport/ipc/WebrtcTCPSocket.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/test/unit/test_proxyconnect.js"], "git_node": "19d5c0a873f28406a3cd1bbd1e394bfe8e8d8fdc", "git_parents": ["1d7be8374b28638e17922aa04f9a708e48be0e3e"], "node": "dcd023fe40f6576a92fd115f55bbde9e17b42519", "parents": ["abff8cf729e20810e0263b27de0101ff16d172e3"], "tags": []}], "date": 1785068845, "git_changesets": ["19d5c0a873f28406a3cd1bbd1e394bfe8e8d8fdc"], "user": "dsmith@mozilla.com"}, "27624": {"changesets": [{"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056166 - Catch third-party provider exceptions in DistributionProviderChecker.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313786\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313811\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/distributions/DistributionProviderChecker.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/distributions/DefaultDistributionProviderCheckerTest.kt"], "git_node": "f878e425594588596a73c241e4359e440445e471", "git_parents": ["19d5c0a873f28406a3cd1bbd1e394bfe8e8d8fdc"], "node": "68d7cd4efaa989191b102f5c20e0cb3c5438cbe6", "parents": ["dcd023fe40f6576a92fd115f55bbde9e17b42519"], "tags": []}], "date": 1785083095, "git_changesets": ["f878e425594588596a73c241e4359e440445e471"], "user": "pchevrel@mozilla.com"}, "27625": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings tld-suffixes ct-logs -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314279\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "91fc56a150fe7e33aab212ec5e80dea1fab1d58e", "git_parents": ["f878e425594588596a73c241e4359e440445e471"], "node": "01385486c8e600404da13175ab9217e832d5ce0f", "parents": ["68d7cd4efaa989191b102f5c20e0cb3c5438cbe6"], "tags": []}], "date": 1785106755, "git_changesets": ["91fc56a150fe7e33aab212ec5e80dea1fab1d58e"], "user": "dsmith@mozilla.com"}, "27626": {"changesets": [{"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2056917 - [riscv64] Qualify enum BaseOpcode in return type position in InstructionBase.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313478\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314268\n", "files": ["js/src/jit/riscv64/base/Instruction.h"], "git_node": "b2ede9f54c9d126d0e9fb898a4b2202c0b4d731c", "git_parents": ["91fc56a150fe7e33aab212ec5e80dea1fab1d58e"], "node": "3d898880e58831fc517c9f7406e166a55034c193", "parents": ["01385486c8e600404da13175ab9217e832d5ce0f"], "tags": []}], "date": 1785106922, "git_changesets": ["b2ede9f54c9d126d0e9fb898a4b2202c0b4d731c"], "user": "dsmith@mozilla.com"}, "27627": {"changesets": [{"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2052706 - Keep sidebar interactive in F11 fullscreen autohide  a=diannaS\n\nThe autohide hides the toolbox when the pointer enters FullScreen's mouse-target\nrect. That rect was cached from tabpanels before the sidebar settled, so it\ncovered the sidebar; hovering it hid the toolbox (and the sidebar), making\nvertical tabs uninteractive.\n\nCompute the rect live in getMouseTargetRect so it follows the sidebar reveal.\nOnce settled, tabpanels excludes the sidebar on whichever side it sits.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310514\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314271\n", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js", "browser/components/sidebar/tests/browser/browser_f11_fullscreen_sidebar.js"], "git_node": "8b70899aee0d611eea80aa738e1e3ba7e3fa5c05", "git_parents": ["b2ede9f54c9d126d0e9fb898a4b2202c0b4d731c"], "node": "37a6ee5c0841fee8cfe735e2cf983f075cd4cf45", "parents": ["3d898880e58831fc517c9f7406e166a55034c193"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2052711 - Keep panel sidebars visible in F11 fullscreen  a=diannaS\n\nBug 1927457 collapsed all sidebar elements on fullscreenNavToolboxHidden, so in\nF11 the panel sidebars (bookmarks, history) hid too and Ctrl+B couldn't bring\nthem back. The intent was to hide only the tools/vertical-tabs launcher, like\nthe horizontal tab strip.\n\nSplit the CSS: the launcher (#sidebar-container, #sidebar-launcher-splitter)\nstill hides with the toolbox, while the panel (#sidebar-box, #sidebar-splitter)\nonly hides in DOM fullscreen and stays toggleable in F11.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310515\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314272\n", "files": ["browser/components/sidebar/tests/browser/browser_f11_fullscreen_sidebar.js", "browser/themes/shared/tabbrowser/fullscreen-and-pointerlock.css"], "git_node": "044a50e49932deffdf79092001d91c50ffb2c8c8", "git_parents": ["8b70899aee0d611eea80aa738e1e3ba7e3fa5c05"], "node": "b728a76068193ba78e821ba27f0738e6a325bfe7", "parents": ["37a6ee5c0841fee8cfe735e2cf983f075cd4cf45"], "tags": []}], "date": 1785106968, "git_changesets": ["8b70899aee0d611eea80aa738e1e3ba7e3fa5c05", "044a50e49932deffdf79092001d91c50ffb2c8c8"], "user": "dsmith@mozilla.com"}, "27628": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/feature/sitepermissions/src/main/res/values-sat/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rCL/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sat/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-th/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml"], "git_node": "5531c3250183204d6a18a64536c6acff210735b7", "git_parents": ["044a50e49932deffdf79092001d91c50ffb2c8c8"], "node": "9f574697d0175cb6d67079e4de054ac995814aed", "parents": ["b728a76068193ba78e821ba27f0738e6a325bfe7"], "tags": []}], "date": 1785118590, "git_changesets": ["5531c3250183204d6a18a64536c6acff210735b7"], "user": "ffxbld@lando.moz.tools"}, "27629": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031600 - remove our UA override for indeed.com;  a=pascalc DONTBUILD\n\nDif