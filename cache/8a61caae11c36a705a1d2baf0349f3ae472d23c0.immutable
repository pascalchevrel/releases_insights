c/main/res/values-gn/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-kk/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ko/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-nl/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-pt-rBR/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ru/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-tg/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ug/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-zh-rCN/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-zh-rTW/strings.xml", "mobile/android/fenix/app/src/main/res/values-ar/strings.xml", "mobile/android/fenix/app/src/main/res/values-es/strings.xml", "mobile/android/fenix/app/src/main/res/values-fi/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-ug/strings.xml"], "git_node": "f5e3db95b2050881c218e47add721710210727a5", "git_parents": ["5a6c0b9b6b9193618757a60b86478df86fcfe0a4"], "node": "54b8e0b27cd18f65ce21ae2694ae66ca091b1292", "parents": ["af690a607212b613e065fff8f0545bad89672eaf"], "tags": []}], "date": 1785377811, "git_changesets": ["f5e3db95b2050881c218e47add721710210727a5"], "user": "ffxbld@lando.moz.tools"}, "27694": {"changesets": [{"author": "Heitor Neiva \u003chneiva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059015 - Revert partials to mbsdiff on beta  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315030\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315038\n", "files": ["taskcluster/gecko_taskgraph/transforms/zucchini_partial_rollout.py"], "git_node": "de1b82380a7eb681c704922b529521d86c3f5bd7", "git_parents": ["f5e3db95b2050881c218e47add721710210727a5"], "node": "c660e70b2bdc191d0f4ecf7712da79244febb8b7", "parents": ["54b8e0b27cd18f65ce21ae2694ae66ca091b1292"], "tags": []}], "date": 1785382210, "git_changesets": ["de1b82380a7eb681c704922b529521d86c3f5bd7"], "user": "dsmith@mozilla.com"}, "27695": {"changesets": [{"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057310 - Parse bridged engine payloads in the Sync collection validator  a=diannaS\n\n`transformAfterDecrypt(cleartext)` has a different signature in the old\nsynchronization engine than in the Sync Bridge - it used to return an object, but\nnow it returns a string. The validator then saw a server item with no `id`, so\nevery local login was reported as `serverMissing`.\n\nNow parse the cleartext into an object when it is a string, at the single point where\nserver items are collected.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314350\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314861\n", "files": ["services/sync/modules/collection_validator.sys.mjs", "services/sync/tests/unit/test_password_validator.js"], "git_node": "3b7fb475fa02d25fab927771ed65d6014ad7a8e4", "git_parents": ["de1b82380a7eb681c704922b529521d86c3f5bd7"], "node": "fafe4e6fa2feb393709130bb3b082ec8b60d0cd0", "parents": ["c660e70b2bdc191d0f4ecf7712da79244febb8b7"], "tags": []}], "date": 1785382360, "git_changesets": ["3b7fb475fa02d25fab927771ed65d6014ad7a8e4"], "user": "dsmith@mozilla.com"}, "27696": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2058110 - Don't queue picture task if pictureness hasn't changed.  a=diannaS\n\nMatches the UnbindFromTree handling. I have another fix on top which is\na bit more annoying to test, but the test here should cover the broken\nwebsite.\n\nWithout this relevant-mutations.html fails the picture tests.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314436\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314891\n", "files": ["dom/html/HTMLImageElement.cpp", "dom/html/HTMLImageElement.h", "testing/web-platform/tests/html/semantics/embedded-content/the-img-element/support/relevant-mutations.js"], "git_node": "a9cf00f4b207a02744af0c617d076d3d76bfd029", "git_parents": ["3b7fb475fa02d25fab927771ed65d6014ad7a8e4"], "node": "c2cdbf815d583374c9c3158298ea47d3d421cd33", "parents": ["fafe4e6fa2feb393709130bb3b082ec8b60d0cd0"], "tags": []}], "date": 1785382405, "git_changesets": ["a9cf00f4b207a02744af0c617d076d3d76bfd029"], "user": "dsmith@mozilla.com"}, "27697": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2058134 - Use HasAuthorSpecifiedBorderBackground() rather than background alpha.  a=diannaS\n\nThis matches what we do for ::target-text. This shouldn't regress\nbug 2043232 (which uses background-color: revert) because that doesn't\ncount as author-specified.\n\nWe couldn't do this when I wrote the regressing bug because of the\nborder-radius support that nova had, but that has been reverted since.\nArguably, we should split the border-background bit, maybe...\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314607\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314889\n", "files": ["layout/generic/nsTextPaintStyle.cpp", "testing/web-platform/tests/css/css-pseudo/selection-background-color-revert-ref.html", "testing/web-platform/tests/css/css-pseudo/selection-background-color-revert.html", "testing/web-platform/tests/css/css-pseudo/selection-background-color-transparent-notref.html", "testing/web-platform/tests/css/css-pseudo/selection-background-color-transparent.html"], "git_node": "428e20aa594feba73d46212f5d78156a32569907", "git_parents": ["a9cf00f4b207a02744af0c617d076d3d76bfd029"], "node": "51dd202b85720ef99dec1adfe8dc480178e4f17d", "parents": ["c2cdbf815d583374c9c3158298ea47d3d421cd33"], "tags": []}], "date": 1785382470, "git_changesets": ["428e20aa594feba73d46212f5d78156a32569907"], "user": "dsmith@mozilla.com"}, "27698": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057995 - Bound the conversion source read to the mapped surface size in the image conversion helpers.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314473\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315010\n", "files": ["dom/media/ImageConversion.cpp"], "git_node": "215d47d992c5e570aa6f3502d1ccc04892cf88f6", "git_parents": ["428e20aa594feba73d46212f5d78156a32569907"], "node": "ca964a2cbe8a78667bec1187fc72279baebf5fe6", "parents": ["51dd202b85720ef99dec1adfe8dc480178e4f17d"], "tags": []}], "date": 1785382646, "git_changesets": ["215d47d992c5e570aa6f3502d1ccc04892cf88f6"], "user": "dsmith@mozilla.com"}, "27699": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053260 - Set the same limit to WebGL buffer sizes as WebGPU.  a=diannaS\n\nUncoditionally, just like in WebGPU.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310999\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313670\n", "files": ["dom/canvas/WebGLBuffer.cpp"], "git_node": "d6efad232b705e774652363a4a682aecc4880f78", "git_parents": ["215d47d992c5e570aa6f3502d1ccc04892cf88f6"], "node": "5ddfe660b98f74e936368d878085033f0b99bb1c", "parents": ["ca964a2cbe8a78667bec1187fc72279baebf5fe6"], "tags": []}], "date": 1785382836, "git_changesets": ["d6efad232b705e774652363a4a682aecc4880f78"], "user": "dsmith@mozilla.com"}, "27700": {"changesets": [{"author": "Shane Hughes \u003cshughes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056604 - ASRouter to only ingest messages from one enrollment on non-coenrolling features.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314767\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315037\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/tests/browser/browser_coenrolling_messaging_features.js"], "git_node": "ec0698f6cfc3ed4ceaf6a394918495db61d4b9d4", "git_parents": ["d6efad232b705e774652363a4a682aecc4880f78"], "node": "36639150775297e840fe477c8bb06b883eb874b4", "parents": ["5ddfe660b98f74e936368d878085033f0b99bb1c"], "tags": []}], "date": 1785383076, "git_changesets": ["ec0698f6cfc3ed4ceaf6a394918495db61d4b9d4"], "user": "dsmith@mozilla.com"}, "27701": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045380 - Validate input video frame dimensions before conversion in the encoder path.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314490\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315008\n", "files": ["dom/media/ImageConversion.cpp", "dom/media/ImageConversion.h", "dom/media/ipc/RemoteMediaDataEncoderParent.cpp"], "git_node": "e0148729f2db7d017be1c51dc60772cd9b766be3", "git_parents": ["ec0698f6cfc3ed4ceaf6a394918495db61d4b9d4"], "node": "1b70612ba215d4ec0a93f53de26f3cb9bd0edc79", "parents": ["36639150775297e840fe477c8bb06b883eb874b4"], "tags": []}], "date": 1785383849, "git_changesets": ["e0148729f2db7d017be1c51dc60772cd9b766be3"], "user": "dsmith@mozilla.com"}, "27702": {"changesets": [{"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2054085 - Hide the fullscreen sidebar launcher without restyling every tab  a=diannaS\n\nBug 1927457 hid the launcher along with the nav toolbox in F11, with\n`visibility: collapse`. That property is inherited, so every toolbar autoshow\nrestyled the whole launcher subtree, which holds a row per tab with vertical\ntabs: 162k elements and several seconds with a few thousand tabs.\n\n`content-visibility` is not inherited and skips the subtree, so hiding restyles\none element, and skipped content keeps what collapse gave us: no space, no\nfocus, no a11y. Zeroing the flex base size also reclaims the inline width of a\nuser-resized launcher. DOM fullscreen keeps collapsing, since it toggles once\nper transition and hides the panel and splitters too. Behavior is unchanged.\n\nMeasured headless with 600 lazy tabs, on the flush that shows the toolbox:\n312ms -\u003e 195ms, 90850 -\u003e 47315 frames reflowed. Hiding is flat in the tab count.\nShowing is not, and cannot be while the launcher leaves the layout: this removes\nthe restyle, not the reflow.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314305\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314862\n", "files": ["browser/components/sidebar/tests/browser/browser_f11_fullscreen_sidebar.js", "browser/themes/shared/tabbrowser/fullscreen-and-pointerlock.css"], "git_node": "ec8fbbb1ddfb0e11a843adb7e54b99f14f609e3a", "git_parents": ["e0148729f2db7d017be1c51dc60772cd9b766be3"], "node": "acc436724105e5fd4cfd1d2042280d1e5c9e424b", "parents": ["1b70612ba215d4ec0a93f53de26f3cb9bd0edc79"], "tags": []}], "date": 1785383962, "git_changesets": ["ec8fbbb1ddfb0e11a843adb7e54b99f14f609e3a"], "user": "dsmith@mozilla.com"}, "27703": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053261 - Allow overlapping vertex groups.  a=diannaS\n\nThe code was previously assuming that the vertex stride is always larger than the vertex size which is not necessarily true per spec. This patches fixes that by computing the number of times the stride fits in the buffer after having removed the size of the last element (following a similar logic to what the (much better) 