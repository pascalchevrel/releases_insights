files": [".hgtags"], "git_node": "38b512743f5593b5958912ae7413757ef6992c00", "git_parents": ["4c8e828efefb34259e2489b2991e7b3fb657971b"], "node": "66feaee2b275e7f3d9349ca41bacd439473c023d", "parents": ["8805dae5325a3278b80fa3952813913679c2b099"], "tags": []}], "date": 1785772597, "git_changesets": ["38b512743f5593b5958912ae7413757ef6992c00"], "user": "ffxbld@lando.moz.tools"}, "27797": {"changesets": [{"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2054230 - Make LensCameraScreen respect system status bar boundaries  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312350\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316093\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraScreen.kt"], "git_node": "748459cb632f89e2d18684bf90fa03b3800ec81f", "git_parents": ["234d97a3d291820732049dfeeea81de4d3477257"], "node": "41c5122f48c766ae5df4c87313b62c3432e67870", "parents": ["bb467def25402880980f3f4d0570d24f01325dd1"], "tags": []}], "date": 1785785166, "git_changesets": ["748459cb632f89e2d18684bf90fa03b3800ec81f"], "user": "dsmith@mozilla.com"}, "27798": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058645 - Clear a stale user value when an incoming pref update flips the type.  a=diannaS\n\nPref keeps its default and user values in a union governed by a single shared\ntype tag. FromDomPref applies the incoming default value first, so when that\nvalue changes the type it leaves mUserValue holding a member of the old type,\nwhich the user-value handling right below then reads as the new type.\n\nA content process can hold a user value whose type no longer matches the\nparent's, because ContentParent::Observe deliberately drops updates for prefs\nthat ShouldSanitizePreference() classifies as sanitized, and that\nclassification applies only while a dynamically named pref is a String without\na default value.\n\nClear such a user value before the type tag changes, while Clear() can still\nmatch the type it was actually stored as.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315248\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315935\n", "files": ["modules/libpref/Preferences.cpp"], "git_node": "38bfaceaded312ebf438105c7197d7a031d7d952", "git_parents": ["748459cb632f89e2d18684bf90fa03b3800ec81f"], "node": "c0d981603b655328c403fec21a560ab812de7538", "parents": ["41c5122f48c766ae5df4c87313b62c3432e67870"], "tags": []}], "date": 1785786087, "git_changesets": ["38bfaceaded312ebf438105c7197d7a031d7d952"], "user": "dsmith@mozilla.com"}, "27799": {"changesets": [{"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058536 - Ensure default engine changed notifications for search engines are only sent when something has changed.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314762\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315952\n", "files": ["toolkit/components/search/SearchService.sys.mjs", "toolkit/components/search/tests/xpcshell/test_telemetry_default_changed_startup.js", "toolkit/components/search/tests/xpcshell/xpcshell.toml"], "git_node": "235e0b9a2bcef17d09cde2f6d3a885bd4058759b", "git_parents": ["38bfaceaded312ebf438105c7197d7a031d7d952"], "node": "eebac4c6005e549b73a8ba3080af4bcb2e3d1987", "parents": ["c0d981603b655328c403fec21a560ab812de7538"], "tags": []}], "date": 1785786180, "git_changesets": ["235e0b9a2bcef17d09cde2f6d3a885bd4058759b"], "user": "dsmith@mozilla.com"}, "27800": {"changesets": [{"author": "Alex Cottner \u003cacottner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056364 - Making remote-settings v2 the default version to sync with for desktop.  a=diannaS\n\nMaking remote-settings v2 the default version for desktop.\nWe can still switch to v1 for a:b comparisons on nightly and dev builds.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313612\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316068\n", "files": ["python/mozperftest/mozperftest/system/ml_services.py", "python/mozperftest/mozperftest/tests/test_ml_services.py", "services/settings/docs/index.md", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh", "testing/firefox-ui/tests/functional/safebrowsing/test_initial_download.py", "toolkit/modules/AppConstants.sys.mjs"], "git_node": "05ac8b6c48dfcd6213ed59a964ffe85fedf6be9e", "git_parents": ["235e0b9a2bcef17d09cde2f6d3a885bd4058759b"], "node": "d93d7eda37191262afe9aae5a84a34050a9033ff", "parents": ["eebac4c6005e549b73a8ba3080af4bcb2e3d1987"], "tags": []}, {"author": "Alex Cottner \u003cacottner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058906 - Removing secondary remote-settings server url test as we dropped v1 server from AppConstants  a=diannaS\n\nThis test is no longer valid as we're back down to having only 1 URL in `AppConstants.REMOTE_SETTINGS_SERVER_URLS`.\nIn D313612 I removed the v1 remote-settings server from , but missed removing this unit-test.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314964\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316069\n", "files": ["services/settings/test/unit/test_remote_settings_release_prefs.js"], "git_node": "9029a01b3071d65d6427a394cec36e3522f7d713", "git_parents": ["05ac8b6c48dfcd6213ed59a964ffe85fedf6be9e"], "node": "e089d531c089a003045ae6dcf6539d624cac3ecd", "parents": ["d93d7eda37191262afe9aae5a84a34050a9033ff"], "tags": []}], "date": 1785786222, "git_changesets": ["05ac8b6c48dfcd6213ed59a964ffe85fedf6be9e", "9029a01b3071d65d6427a394cec36e3522f7d713"], "user": "dsmith@mozilla.com"}, "27801": {"changesets": [{"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2058916 - part 1 - Skip LinkText links not found in the full text  a=diannaS\n\n`buildUrlAnnotatedString` logged but still added a LinkAnnotation when the link\ntext was blank or not found in the full text (indexOf returned -1), producing a\nspan with a negative start that crashed later in the text layout pass.\nSkip such links instead so the text still renders, just without the broken\nclickable span. This mainly guards against localized strings whose link\nsubstring drifts out of the full text.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315282\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315948\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/LinkText.kt", "mobile/android/android-components/components/compose/base/src/test/java/mozilla/components/compose/base/LinkTextTest.kt"], "git_node": "87f13d1350a8bc5daeb1a8099edd980939854b74", "git_parents": ["9029a01b3071d65d6427a394cec36e3522f7d713"], "node": "5e62e2d14fcdc4de1ee67ef4ffbe674077fff638", "parents": ["e089d531c089a003045ae6dcf6539d624cac3ecd"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2058916 - part 2 - Clamp the domain range before measuring the highlighted URL  a=diannaS\n\n`computeDomainEndScrollValue` passed the registrable domain indices straight to\n`getPathForRange`, which throws if they are out of range or start \u003e end. Coerce\nthem so 0 \u003c= startIndex \u003c= endIndex \u003c= text.length always holds, guarding\nagainst a caller supplying a domain span inconsistent with the displayed URL.\n\nThis is mostly hardening the changes done for bug 2056836.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315283\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315949\n", "files": ["mobile/android/android-components/components/compose/browser-toolbar/build.gradle", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ui/HighlightedDomainUrl.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/ui/HighlightedDomainUrlLayoutTest.kt"], "git_node": "e32fc2cb4369018827a6be1dd0b8677bcfae33f1", "git_parents": ["87f13d1350a8bc5daeb1a8099edd980939854b74"], "node": "4cde9a2542e3b38f3b5faa5cd2960f7eb1ce323d", "parents": ["5e62e2d14fcdc4de1ee67ef4ffbe674077fff638"], "tags": []}], "date": 1785788088, "git_changesets": ["87f13d1350a8bc5daeb1a8099edd980939854b74", "e32fc2cb4369018827a6be1dd0b8677bcfae33f1"], "user": "dsmith@mozilla.com"}, "27802": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058165 - Persist a tab's deliberate mute state rather than its live audio mute.  a=diannaS\n\nSession restore now collects tab.muted instead of browser.audioMuted when it\nrecords a tab's mute state. The two are easy to confuse, but they differ in\nmeaning and in lifetime:\n\n- tab.muted is the tab's muted attribute. Only muting through the tab sets it,\n  it is what draws the mute indicator, and it outlives the tab's browsing\n  context.\n- browser.audioMuted is a live read of the media controller's mute state. Any\n  caller that silences the tab sets it, it is invisible on its own, and it is\n  cleared whenever the tab gets a new browsing context.\n\nEvery deliberate mute sets both, but some internal mutes set only the second,\nand those must not be persisted. Closing an audible tab is one of them: Firefox\nsilences it as the close begins so the sound stops at once instead of trailing\nthrough the close animation. Collecting the live state captured that internal\nmute and recorded it as though the user had asked for it, so reopening the tab\ncame back muted.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314724\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316072\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/TabState.sys.mjs", "browser/components/tabbrowser/content/tabbrowser.js", "browser/components/tabbrowser/test/browser/tabMediaIndicator/browser.toml", "browser/components/tabbrowser/test/browser/tabMediaIndicator/browser_mute_restore_closed_audible_tab.js"], "git_node": "10c0a419a503a465639f18b154e793b3c5462bee", "git_parents": ["e32fc2cb4369018827a6be1dd0b8677bcfae33f1"], "node": "ea86f4a4ccaae02dfb343041ff368588dfb1345f", "parents": ["4cde9a2542e3b38f3b5faa5cd2960f7eb1ce323d"], "tags": []}], "date": 1785788347, "git_changesets": ["10c0a419a503a465639f18b154e793b3c5462bee"], "user": "dsmith@mozilla.com"}, "27803": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059188 - Add the missing WebGL texel unpack specializations.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315284\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315980\n", "files": ["dom/canvas/TexUnpackBlob.cpp", "dom/canvas/WebGLTexelConversions.cpp", "dom/canvas/WebGLTexelConversions.h"], "git_node": "38f5e68e8b22eb00e49cf3a4131b04905b9c1fdc", "git_parents": ["10c0a419a503a465639f18b154e793b3c5462bee"], "node": "a9fd44cbb6d48113db18b09198e1639968cc849a", "parents": ["ea86f4a4ccaae02dfb343041ff368588dfb1345f"], "tags": []}], "date": 1785788391, "git_changesets": ["38f5e68e8b22eb00e49cf3a4131b04905b9c1fdc"], "user": "dsmith@mozilla.com"}, "27804": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059424 - Transform-feedback followup.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315302\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315984\n", "files": ["dom/canvas/WebGLContextDraw.cpp", "dom/canvas/WebGLTransformFeedback.cpp"], "git_node": "bd8d3cf9ba4c26efc3725c43581656a3198be6a6", "git_parents": ["38f5e68e8b22eb00e49cf3a4131b04905b9c1fdc"], "node": "9b024d94f7690ec178930b17bad63477c9f42cec", "parents": ["a9fd44cbb6d48113db18b09198e1639968cc849a"], "tags": []}], "date": 1785788451, "git_changesets": ["bd8d3cf9ba4c26efc3725c43581656a3198be6a6"], "user": "dsmith@mozilla.com"}, "27805": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2054643, make button's EndSubmitClick handling consistent with input type=button,  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315429\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315974\n", "files": ["dom/html/HTMLButtonElement.cpp", "dom/html/HTMLFormElement.cpp"], "git_node": "8520e2bdb766c72ccde43c4ca7990580e31bdc4b", "git_parents": ["bd8d3cf9ba4c26efc3725c43581656a3198be6a6"], "node": "c1fa8542cd6b47af90954defdd98c55e8611c36a", "parents": ["9b024d94f7690ec178930b17bad63477c9f42cec"], "tags": []}], "date": 1785788528, "git_changesets": ["8520e2bdb766c72ccde43c4ca7990580e31bdc4b"], "user": "dsmith@mozilla.com"}, "27806": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058644 - Don't strip a pref branch root longer than the pref name.  a=diannaS\n\nCallbackNode strips a trailing dot from its domain so it maps onto the trie's\ndot-separated segments, which puts domain \"browser.download.\" at the same node\nas the pref literally named \"browser.download\". All callbacks at a terminal\nnode fire, so the observer registered for the branch also fired for that\nshorter name, where the pre-trie StringBeginsWith match never did. Restore that\nby remembering whether the domain as registered ended with a dot. Array entries\nare not dot-stripped, so an exact match against one still fires.\n\nNotifyObserver strips GetRootLength() bytes off the notified name, which\nassumes the root is a prefix of it. The trie normalizes trailing dots while the\nroot length does not, so clamp the strip to the name length rather than rely on\nthat. Not an assertion: the two legitimately disagree for a root carrying a\nredundant dot.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315233\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315938\n", "files": ["modules/libpref/Preferences.cpp"], "git_node": "8b2e9d1880663bd04187e89aada8bfd122b49e77", "git_parents": ["8520e2bdb766c72ccde43c4ca7990580e31bdc4b"], "node": "acefcc5c49959b5e2f5b343b61fa4f6c5082ea57", "parents": ["c1fa8542cd6b47af90954defdd98c55e8611c36a"], "tags": []}], "date": 1785788786, "git_changesets": ["8b2e9d1880663bd04187e89aada8bfd122b49e77"], "user": "dsmith@mozilla.com"}, "27807": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059224 - Use NonVoidStringToJsval for HostGetCodeForEval.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315242\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315962\n", "files": ["dom/security/trusted-types/TrustedTypeUtils.cpp"], "git_node": "982cb97e75930716f3189303982d328e4b5750fb", "git_parents": ["8b2e9d1880663bd04187e89aada8bfd122b49e77"], "node": "6af4f879995b7e061319882025311400f93ff979", "parents": ["acefcc5c49959b5e2f5b343b61fa4f6c5082ea57"], "tags": []}], "date": 1785788824, "git_changesets": ["982cb97e75930716f3189303982d328e4b5750fb"], "user": "dsmith@mozilla.com"}, "27808": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059053 - Part 1: Add tests for push subscribes  a=diannaS\n\nThis mostly copies the same tests from notifications.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315057\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315989\n", "files": ["testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini", "testing/web-platform/meta/push-api/worker-subscribe.https.window.js.ini", "testing/web-platform/tests/push-api/cross-origin-nested.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/cross-origin-same-site-request.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/cross-origin-serviceworker.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/resources/cross-origin-nested-child.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-nested-parent.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-serviceworker-iframe.sub.html", "testing/web-platform/tests/push-api/resources/permission-helper.js", "testing/web-platform/tests/push-api/resources/permission-sw.js", "testing/web-platform/tests/push-api/resources/permission-worker.js", "testing/web-platform/tests/push-api/worker-subscribe.https.window.js"], "git_node": "aca980373ddaf7baaff5e8636038298100bef2bb", "git_parents": ["982cb97e75930716f3189303982d328e4b5750fb"], "node": "57ec55039dd7cbcb90f96a597cad68328930f084", "parents": ["6af4f879995b7e061319882025311400f93ff979"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059053 - Part 2: Disallow retrieving push subscription in partitioned worker  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315058\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315990\n", "files": ["dom/push/PushManager.cpp", "dom/push/test/mochitest.toml", "testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini"], "git_node": "74c9b6cca3a6ebf72e095256b73f1b0efb977b94", "git_parents": ["aca980373ddaf7baaff5e8636038298100bef2bb"], "node": "88c42b82465c8c11ef256d6e721abd5fd7545107", "parents": ["57ec55039dd7cbcb90f96a597cad68328930f084"], "tags": []}], "date": 1785788876, "git_changesets": ["aca980373ddaf7baaff5e8636038298100bef2bb", "74c9b6cca3a6ebf72e095256b73f1b0efb977b94"], "user": "dsmith@mozilla.com"}, "27809": {"c