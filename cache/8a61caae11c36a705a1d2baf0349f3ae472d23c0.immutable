1644dd9f3c270f18a920d3a"], "user": "ffxbld@lando.moz.tools"}, "27557": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 8a47838c188521a081902834cc8d52e32fcfab74 with FIREFOX_154_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "fdff4ab6b296c13ebebec9afadf5b170744233e5", "git_parents": ["4504b8e2f15d8b7981644dd9f3c270f18a920d3a"], "node": "a332384620d474ec2fde786e8885e1876b513933", "parents": ["933671e751a53a9a0aede22276a5eb477df06b83"], "tags": []}], "date": 1784742885, "git_changesets": ["fdff4ab6b296c13ebebec9afadf5b170744233e5"], "user": "ffxbld@lando.moz.tools"}, "27558": {"changesets": [{"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1910169 - Part 0: Fix Translations first-use header  a=diannaS\n\nThis commit fixes the issue where the Translations\nfirst-use header reverts when you switch the language\nwhile the Full-Page Translations Panel is open.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D298900\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313552\n", "files": ["browser/components/translations/content/fullPageTranslationsPanel.js", "browser/components/translations/tests/browser/browser_translations_full_page_panel_firstrun.js"], "git_node": "3be96321a72cfe3befa8731780d1c16f7ee4ac00", "git_parents": ["af6cb8438dd5b7baf6ba7504af5aa4d9582a8ba9"], "node": "e5fb736bcd90b956c6923d03995971381156ffec", "parents": ["fa8221c021d30b95d44641c1f43eff8ac9c847a2"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845783 - Part 1: Refactor find-bar state lookup in TranslationsParent  a=diannaS\n\nThis commit refactors the way that the FindBar's open state is queried\nwithin TranslationsParent to make things easier for the transition into\ntranslating iframes within subsequent commits.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297026\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313553\n", "files": ["toolkit/components/translations/actors/TranslationsParent.sys.mjs"], "git_node": "350abe0e4719898908ea668f0c789feb6e6cef10", "git_parents": ["3be96321a72cfe3befa8731780d1c16f7ee4ac00"], "node": "fd1eff3d4afebc3f07bf202ff1e37be2bad448ee", "parents": ["e5fb736bcd90b956c6923d03995971381156ffec"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845783 - Part 2: Refactor document translation startup in TranslationsParent  a=diannaS\n\nThis commit refactors the way that full-page translation is started\nwithin TranslationsParent to make things easier for the transition\ninto translating iframes within subsequent commits.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297027\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313554\n", "files": ["toolkit/components/translations/actors/TranslationsParent.sys.mjs"], "git_node": "781187a52258d323b9b5f3d8c4ec180e5af8b297", "git_parents": ["350abe0e4719898908ea668f0c789feb6e6cef10"], "node": "06cce1258782690fba94a0f0b2cde8a2d95f58a8", "parents": ["fd1eff3d4afebc3f07bf202ff1e37be2bad448ee"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845783 - Part 3: Make Translations actors available in sub frames  a=diannaS\n\nThis commit updates the actor management for the TranslationsParent\nand TranslationsChild actors to ensure that they are loaded into\nsub frames of the page, instead of only the main frame.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297028\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313555\n", "files": ["toolkit/components/translations/tests/browser/browser_translations_actor_availability.js", "toolkit/modules/ActorManagerParent.sys.mjs"], "git_node": "551c0831bf61f7e0a6611b1a29c0b69dcee94aed", "git_parents": ["781187a52258d323b9b5f3d8c4ec180e5af8b297"], "node": "eb38cdcac0da268daf4daa253407ca6b1d83901f", "parents": ["06cce1258782690fba94a0f0b2cde8a2d95f58a8"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845783 - Part 4: Translate \u003ciframe\u003e in full-page translation  a=diannaS\n\nThis commit reworks the full-page translation algorithms to enable\ntranslating iframe content and attributes, in addition to the main\npage's top-level content.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297029\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313556\n", "files": ["toolkit/components/translations/actors/TranslationsChild.sys.mjs", "toolkit/components/translations/actors/TranslationsEngineParent.sys.mjs", "toolkit/components/translations/actors/TranslationsParent.sys.mjs", "toolkit/components/translations/content/translations-document.sys.mjs", "toolkit/components/translations/content/translations-engine.sys.mjs"], "git_node": "ac03bd6fa376e184ebe228bb9f4439ec3fc73ae2", "git_parents": ["551c0831bf61f7e0a6611b1a29c0b69dcee94aed"], "node": "e247ea023963539d8687eecbf815e954ee288781", "parents": ["eb38cdcac0da268daf4daa253407ca6b1d83901f"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845783 - Part 5: Add iframe test page  a=diannaS\n\nThis commit adds a new test page that can be used specifically to\ntest the translation of iframes for full-page translation.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297030\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313557\n", "files": ["toolkit/components/translations/tests/browser/browser.toml", "toolkit/components/translations/tests/browser/translations-tester-iframe-es.html"], "git_node": "239ce2206b0d2cafe7c36c4020172d53b72160bf", "git_parents": ["ac03bd6fa376e184ebe228bb9f4439ec3fc73ae2"], "node": "1eafeafe0dc6bcf9dd650567ac588c4f977b01b8", "parents": ["e247ea023963539d8687eecbf815e954ee288781"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845783 - Part 6: Add full-page translation iframe tests  a=diannaS\n\nThis commit introduces several new test cases to ensure that the\nbehavior of translating iframes within full-page tranlation is\nworking as expected.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297031\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313558\n", "files": ["browser/components/translations/tests/browser/browser_full.toml", "browser/components/translations/tests/browser/browser_translations_full_page_intersection_iframe_content_eager.js", "browser/components/translations/tests/browser/browser_translations_full_page_intersection_iframe_find_bar.js", "browser/components/translations/tests/browser/browser_translations_full_page_intersection_iframe_lazy.js", "browser/components/translations/tests/browser/browser_translations_full_page_intersection_iframe_mutations_lazy.js", "browser/components/translations/tests/browser/head.js", "toolkit/components/translations/tests/browser/browser.toml", "toolkit/components/translations/tests/browser/browser_translations_full_page_iframe.js", "toolkit/components/translations/tests/browser/shared-head.js", "toolkit/components/translations/tests/browser/translations-test.mjs"], "git_node": "0ed3362432c709b83a03352d4cc1b1cead538c97", "git_parents": ["239ce2206b0d2cafe7c36c4020172d53b72160bf"], "node": "4f92e204d4e2721adce5f3d7d96162562c1edb01", "parents": ["1eafeafe0dc6bcf9dd650567ac588c4f977b01b8"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038279 - Part 7: Allow about:* subframe translations  a=diannaS\n\nThis commit adds the ability for `\u003ciframe\u003e` content that is\nloaded from `about:blank` or `about:srcdoc` to translate as\nsub-frame content while still restricting offering full-page\ntranslation for these as top-level pages.\n\nThis fixes the particular `\u003ciframe\u003e` issue in Bug 2038279,\nwhich is not addressed by the rest of this stack.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D299444\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313559\n", "files": ["toolkit/components/translations/actors/TranslationsParent.sys.mjs", "toolkit/components/translations/tests/browser/browser_translations_actor_availability.js", "toolkit/modules/ActorManagerParent.sys.mjs"], "git_node": "2a239586e81a64061a270b5924386a3b8e39ac23", "git_parents": ["0ed3362432c709b83a03352d4cc1b1cead538c97"], "node": "b41aa82512a615e88b1650e46a36088671a25a63", "parents": ["4f92e204d4e2721adce5f3d7d96162562c1edb01"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840857 - Part 1: Improve langTagsMatch  a=diannaS\n\nThis commit improves the reasoning behind the `TranslationsUtils.langTagsMatch()`\nfunction to consider canonicalization as one of the steps. This lets us further\nunify the lang-tag matching code throughout the Translations component.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302536\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313560\n", "files": ["toolkit/components/translations/TranslationsUtils.mjs"], "git_node": "ed3b13d4cb483b5d68e050b6dbe276baaaf582d5", "git_parents": ["2a239586e81a64061a270b5924386a3b8e39ac23"], "node": "31498889679859179616eb5d2a86b01c46fc7a30", "parents": ["b41aa82512a615e88b1650e46a36088671a25a63"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840857 - Part 2: Remove obviously unneeded code  a=diannaS\n\nThis patch removes code that will become obviously unneeded\nonce we move the page-text extraction code to native C++,\nand then rework the TranslationsChild to be lazily initialized.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302537\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313561\n", "files": ["toolkit/components/translations/actors/TranslationsChild.sys.mjs", "toolkit/components/translations/actors/TranslationsParent.sys.mjs", "toolkit/modules/ActorManagerParent.sys.mjs"], "git_node": "bfdb133c2962a4860690239a24188c4c066be235", "git_parents": ["ed3b13d4cb483b5d68e050b6dbe276baaaf582d5"], "node": "4aaebc1d4f899094fcbad3553fc497bdf2c17f24", "parents": ["31498889679859179616eb5d2a86b01c46fc7a30"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840857 - Part 3: DocumentLanguageMetadata Interfaces  a=diannaS\n\nThis commit defines the WebIDL and IPDL interfaces used to request\nDocumentLanguageMetadata through the WindowGlobal parent/child pair.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302538\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313562\n", "files": ["dom/chrome-webidl/WindowGlobalActors.webidl", "dom/ipc/PWindowGlobal.ipdl", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalChild.h", "dom/ipc/WindowGlobalMessageUtils.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/ipc/moz.build"], "git_node": "500415f70a03cbc86722687f7efb12803414249f", "git_parents": ["bfdb133c2962a4860690239a24188c4c066be235"], "node": "9168e719801f3ff000715f303a31d44b5d0c6d29", "parents": ["4aaebc1d4f899094fcbad3553fc497bdf2c17f24"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840857 - Part 4: Implement Native Page-Text Extraction  a=diannaS\n\nThis commit implements document-language metadata requests in\nWindowGlobalChild. Each request waits for the document load event or a\ntimeout, extracts the HTML lang attribute and a text sample, then may\nretry sampling based on how much text was sampled, controlled by prefs.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302539\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313563\n", "files": ["dom/base/nsGlobalWindowInner.cpp", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalChild.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "fdc0d70691f518ccf5d510db0616aa9cd8b419fc", "git_parents": ["500415f70a03cbc86722687f7efb12803414249f"], "node": "f5431c2834c17b2af356b5d2dba049350db6e185", "parents": ["9168e719801f3ff000715f303a31d44b5d0c6d29"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840857 - Part 5: Use document language metadata in TranslationsParent  a=diannaS\n\nThis commit updates TranslationsParent to consume document-language metadata payload\nfrom WindowGlobal instead of asking TranslationsChild to extract page text.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302540\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313564\n", "files": ["toolkit/components/translations/actors/TranslationsParent.sys.mjs", "toolkit/components/translations/translations.d.ts"], "git_node": "a0e76a46d0b4afe806b48f88b5f573c19df710d3", "git_parents": ["fdc0d70691f518ccf5d510db0616aa9cd8b419fc"], "node": "6025616f4ce41ffdbadb0fcd1f4461e73cb5e499", "parents": ["f5431c2834c17b2af356b5d2dba049350db6e185"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840857 - Part 6: Lazily create Translations sub-frame actors  a=diannaS\n\nUpdates the TranslationsParent code so that sub-frame actors are\ncreated lazily only when translation is requested, instead of\neagerly at page load.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310702\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313565\n", "files": ["toolkit/components/translations/actors/TranslationsChild.sys.mjs", "toolkit/components/translations/actors/TranslationsParent.sys.mjs"], "git_node": "d2b8a6fbaa6363cdfdb9f710bdb7391a2ad53741", "git_parents": ["a0e76a46d0b4afe806b48f88b5f573c19df710d3"], "node": "6cdd82d0db938cc0634480ba280b1bd1d6a7e567", "parents": ["6025616f4ce41ffdbadb0fcd1f4461e73cb5e499"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840857 - Part 7: Rework Translations offer decisions  a=diannaS\n\nThis commit reworks the full-page translation offer logic to use the\nnew document-language metadata API, and improves readability by letting\nthe logic map directly to conditions in a decision matrix.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302541\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313566\n", "files": ["browser/components/translations/content/fullPageTranslationsPanel.js", "toolkit/components/translations/TranslationsTelemetry.sys.mjs", "toolkit/components/translations/actors/TranslationsParent.sys.mjs", "toolkit/components/translations/metrics.yaml", "toolkit/components/translations/translations.d.ts"], "git_node": "d9a986e9861bc99dd7c64472d581648017ace281", "git_parents": ["d2b8a6fbaa6363cdfdb9f710bdb7391a2ad53741"], "node": "f0c88f7bcccd6d4dc5c32652932982126e0db5c7", "parents": ["6cdd82d0db938cc0634480ba280b1bd1d6a7e567"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840857 - Part 8: Update Test Expectations  a=diannaS\n\nThis commit updates all of the test cases and expectations to conform\nto the new language-identification behavior, and updated decision-making\nabout when to offer full-page translation to the user.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302542\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313567\n", "files": ["browser/components/translations/tests/browser/browser_translations_full_page_ai_feature_mid_translation.js", "browser/components/translations/tests/browser/browser_translations_full_page_language_id_behavior.js", "browser/components/translations/tests/browser/browser_translations_full_page_panel_auto_translate_error_view.js", "browser/components/translations/tests/browser/browser_translations_full_page_panel_auto_translate_revisit_view.js", "browser/components/translations/tests/browser/browser_translations_full_page_panel_settings_unsupported_lang.js", "browser/components/translations/tests/browser/browser_translations_full_page_telemetry_auto_translate.js", "browser/components/translations/tests/browser/browser_translations_full_page_telemetry_basics.js", "browser/components/translations/tests/browser/browser_translations_full_page_telemetry_open_panel.js", "browser/components/translations/tests/browser/browser_translations_full_page_telemetry_panel_auto_offer.js", "browser/components/translations/tests/browser/browser_translations_full_page_telemetry_panel_auto_offer_settings.js", "browser/components/translations/tests/browser/browser_translations_full_page_telemetry_retranslate.js", "browser/components/translations/tests/browser/browser_translations_full_page_telemetry_switch_languages.js", "browser/components/translations/tests/browser/browser_translations_full_page_telemetry_translation_failure.js", "browser/components/translations/tests/browser/browser_translations_full_page_telemetry_translation_request.js", "browser/components/translations/tests/browser/browser_translations_full_page_telemetry_unsupported_lang.js", "browser/components/translations/tests/browser/browser_translations_select_telemetry_multi_page.js", "toolkit/components/translations/tests/browser/browser_translations_actor_availability.js", "toolkit/components/translations/tests/browser/browser_translations_actor_detected_langs.js", "toolkit/components/translations/tests/browser/browser_translations_actor_empty_langs.js", "toolkit/components/translations/tests/browser/shared-head.js"], "git_node": "202a5383b1f94ec26f5498b48aabc05717d277fa", "git_parents": ["d9a986e9861bc99dd7c64472d581648017ace28