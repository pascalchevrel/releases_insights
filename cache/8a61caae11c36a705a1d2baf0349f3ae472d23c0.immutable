86": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052490 - Don't release buffer allocator lock before checking GC state  a=diannaS\n\nThere's an intermittent assertion failure because we release the lock between\nmerging swept data and checking the expected GC state which allows the\nbackground sweeping task to add more chunks to the swept chunks lists. When we\nmerge this data the expected state will be restored restored.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312447\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314846\n", "files": ["js/src/gc/BufferAllocator.cpp"], "git_node": "29b26fb77ce235cb00dd9b76b1d101645c2555c7", "git_parents": ["0673e25e7931c0a98030c53a288b651ada76c6c7"], "node": "8e1dd95ca5da904525886ea23c003ad04d7a673b", "parents": ["8e0b2113d93396c994561fa98cedbc69292cb6c5"], "tags": []}], "date": 1785354009, "git_changesets": ["29b26fb77ce235cb00dd9b76b1d101645c2555c7"], "user": "dsmith@mozilla.com"}, "27687": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045721: Add IPCClientInfo type checking  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D305382\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314869\n", "files": ["dom/clients/manager/ClientManagerParent.cpp", "dom/clients/manager/moz.build", "dom/fetch/FetchParent.cpp", "dom/ipc/WindowGlobalParent.cpp", "dom/serviceworkers/ServiceWorkerContainerParent.cpp", "ipc/glue/BackgroundParentImpl.cpp"], "git_node": "ead77e6ebe4254211662042ca904bfc1ae6c0974", "git_parents": ["29b26fb77ce235cb00dd9b76b1d101645c2555c7"], "node": "f7c2b07d50ee7b1661b39004470bf0a0267d0901", "parents": ["8e1dd95ca5da904525886ea23c003ad04d7a673b"], "tags": []}], "date": 1785354049, "git_changesets": ["ead77e6ebe4254211662042ca904bfc1ae6c0974"], "user": "dsmith@mozilla.com"}, "27688": {"changesets": [{"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051555: In case of OOM, make an inline array.  a=diannaS\n\nFor both array and struct objects, an OOM can occur in between\nallocating the object and allocating its out-of-line data area. For\nstructs we don't really have a choice but to be aware of null data\npointers in obj_trace and obj_moved, but for arrays we can just convert\nthe failed array into an empty inline-storage array.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311827\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314971\n", "files": ["js/src/jit-test/tests/wasm/gc/bug2051555.js", "js/src/wasm/WasmGcObject-inl.h", "js/src/wasm/WasmGcObject.cpp"], "git_node": "5628a9f1be847b9a3f0709043bc93c9dd4ab7efe", "git_parents": ["ead77e6ebe4254211662042ca904bfc1ae6c0974"], "node": "cdd4a36c7b027ae0e4c5a9e808ca70015d2c1230", "parents": ["f7c2b07d50ee7b1661b39004470bf0a0267d0901"], "tags": []}], "date": 1785354093, "git_changesets": ["5628a9f1be847b9a3f0709043bc93c9dd4ab7efe"], "user": "dsmith@mozilla.com"}, "27689": {"changesets": [{"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058264 - Attach an observer to IPProtection upgradeNotAvailable pref  a=diannaS\n\nRN we only read the pref at panel creation time, it might change during the window lifetime.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314640\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314953\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_locations_keyboard_navigation.js"], "git_node": "e27c97492039009a99894a813ac5ff73a612c453", "git_parents": ["5628a9f1be847b9a3f0709043bc93c9dd4ab7efe"], "node": "fad4264ece5960ebf32f15b34f31be93d6a529a1", "parents": ["cdd4a36c7b027ae0e4c5a9e808ca70015d2c1230"], "tags": []}], "date": 1785354137, "git_changesets