ce383b4d7affd305d5e022e01"], "user": "ffxbld@lando.moz.tools"}, "27942": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 54be19de0e08edff0b797e55fd935dd3978b0a6d with FIREFOX_153_0_4_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9ab9b478f6295da2a3fc44735568d42953067ca7", "git_parents": ["520d30656521d8ace383b4d7affd305d5e022e01"], "node": "a953cbe4ef086304aec764936abf3ee2c2063d0e", "parents": ["00edfd9ec0148eb5a5f3ba52744527ffa9e82f0c"], "tags": []}], "date": 1786387458, "git_changesets": ["9ab9b478f6295da2a3fc44735568d42953067ca7"], "user": "ffxbld@lando.moz.tools"}, "27943": {"changesets": [{"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059365 - Remove mochitest-remote from the macosx1500-aarch64-vms test set.  a=diannaS\n\nmochitest-remote is the only browser-chrome flavor suite running on the\nheadless VM pool, and it has been failing consistently since it was enabled.\n\nbrowser-test.js nextTest calls SimpleTest.waitForFocus before every test,\nincluding the first. That lands in SimpleTest.promiseFocus, which awaits a\nfocus event with no timeout and no fallback. Window activation never\ncompletes on these workers, so the job hangs before the first test, produces\nno output, and is killed by the 370s harness timeout on every one of its\nnine retries. A representative task burns 1h15m to produce zero results.\n\nProfiler captures taken automatically at the hang confirm the browser is\nidle rather than deadlocked: 1156 of 1157 GeckoMain samples sit in\nNative event loop idle under NSApplication run, waiting for an AppKit event\nthat never arrives.\n\nThis is not specific to mochitest-remote. mochitest-devtools-chrome was\nevaluated for this pool in June 2026 and rejected for the same signature;\nmochitest-remote only predates that finding. The block comment on this test\nset already states that suites needing focus management and browser windows\nare intentionally omitted, so this brings the list back in line with its own\nstated policy.\n\nBug 2050174 tracks the underlying window activation issue on these workers.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316346\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316789\n", "files": ["taskcluster/test_configs/test-sets.yml"], "git_node": "a2e3da9335062c312aa5155bf1eef30b1125e4c6", "git_parents": ["0428088c37be9bc1b6833d63dd27e86c035df620"], "node": "a382bda155c892dec03ac422d21322ee41d53028", "parents": ["0b1a8a2f57c52983eef08bf519185258abbbd6d1"], "tags": []}], "date": 1786389708, "git_changesets": ["a2e3da9335062c312aa5155bf1eef30b1125e4c6"], "user": "dsmith@mozilla.com"}, "27944": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2054671 - ValidatePrincipal in PLockManager,  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313529\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317546\n", "files": ["dom/locks/LockManager.cpp", "ipc/glue/BackgroundParentImpl.cpp"], "git_node": "d9a28ff07800f9e2e928ef7c3c9c56fb26381ef4", "git_parents": ["a2e3da9335062c312aa5155bf1eef30b1125e4c6"], "node": "c7e819234325e8f1ba99bde965a46421cf37d3ad", "parents": ["a382bda155c892dec03ac422d21322ee41d53028"], "tags": []}], "date": 1786389822, "git_changesets": ["d9a28ff07800f9e2e928ef7c3c9c56fb26381ef4"], "user": "dsmith@mozilla.com"}, "27945": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2052401 - Guard AudioCallbackDriver::mAudioStream with a DataMutex.  a=diannaS\n\nAudioOutputLatency() reads mAudioStream from the main thread\n(AudioContext.getOutputTimestamp()), while Init() writes it on the\nCubebOperation thread with no synchronization.\n\nEvery other access to mAudioStream is already CubebOperation-thread-only,\nso wrap it in a DataMutex, matching the existing mFallback pattern in this\nfile, rather than e.g. caching a latency value (which can change over the\nstream's life). The real-time audio callback thread never touches\nmAudioStream, so this lock is never contended on that path.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310300\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317498\n", "files": ["dom/media/GraphDriver.cpp", "dom/media/GraphDriver.h"], "git_node": "a143083f91ed6b0d6006d609fa1dce1d6eec93fa", "git_parents": ["d9a28ff07800f9e2e928ef7c3c9c56fb26381ef4"], "node": "432f9ed4ea87ef6644e4fc7f85b7e9f3741b3cf1", "parents": ["c7e819234325e8f1ba99bde965a46421cf37d3ad"], "tags": []}], "date": 1786389904, "git_changesets": ["a143083f91ed6b0d6006d609fa1dce1d6eec93fa"], "user": "dsmith@mozilla.com"}, "27946": {"changesets": [{"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054514 - Handle System-Clock drift when creating the ProxyPass  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313188\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317571\n", "files": ["toolkit/components/ipprotection/GuardianTypes.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "37c7e377bb72d3555ab32add3a6ef84b01a14cee", "git_parents": ["a143083f91ed6b0d6006d609fa1dce1d6eec93fa"], "node": "f606857fb69d8765eeee6460f2c1a0eae59a93ee", "parents": ["432f9ed4ea87ef6644e4fc7f85b7e9f3741b3cf1"], "tags": []}], "date": 1786390014, "git_changesets": ["37c7e377bb72d3555ab32add3a6ef84b01a14cee"], "user": "dsmith@mozilla.com"}, "27947": {"changesets": [{"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061853 - Add Auto Tab Grouping model for Smart Window name generation.  a=diannaS\n\nThis patch adds a separate model for the Smart Window Tab Group name generation.\nThis is so classic window users aren't affected when we do model updates for this\nfeature.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317162\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317544\n", "files": ["browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_AutoTabGrouping.js", "toolkit/components/ml/content/EngineProcess.sys.mjs"], "git_node": "72163ce665e64273515cad24383c465d3b5d950b", "git_parents": ["37c7e377bb72d3555ab32add3a6ef84b01a14cee"], "node": "532263ae898e0f488feb48c52ba6d43007df7dab", "parents": ["f606857fb69d8765eeee6460f2c1a0eae59a93ee"], "tags": []}], "date": 1786390270, "git_changesets": ["72163ce665e64273515cad24383c465d3b5d950b"], "user": "dsmith@mozilla.com"}, "27948": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2061794.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317311\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317312\n", "files": ["netwerk/protocol/http/InterceptedHttpChannel.cpp"], "git_node": "ee1870144cef13aa791cdf0bac5b7b5e995e7d1c", "git_parents": ["72163ce665e64273515cad24383c465d3b5d950b"], "node": "749058209c4a69895ef7746c7ed6afa1c850d921", "parents": ["532263ae898e0f488feb48c52ba6d43007df7dab"], "tags": []}], "date": 1786392886, "git_changesets": ["ee1870144cef13aa791cdf0bac5b7b5e995e7d1c"], "user": "dsmith@mozilla.com"}, "27949": {"changesets": [{"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061633 - Revert Bug 2022527 and fix an issue in browser_tokenAlias.js.  a=diannaS\n\nThis reverts commit f19cee519d9c4a951986d8e96a5a7ee78be7e59a.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317616\n", "files": ["browser/components/qrcode/test/browser/browser_qrcode_share_menu.js", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/tests/browser/browser_tokenAlias.js", "browser/components/urlbar/tests/browser/browser_urlbar_contextmenu.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_customizing_nobreakout.js"], "git_node": "94bdec29c08069635aba5676d6731722b8cef2ce", "git_parents": ["ee1870144cef13aa791cdf0bac5b7b5e995e7d1c"], "node": "e38f9a28f61af304d1a3d951d83076501df056c0", "parents": ["749058209c4a69895ef7746c7ed6afa1c850d921"], "tags": []}], "date": 1786394903, "git_changesets": ["94bdec29c08069635aba5676d6731722b8cef2ce"], "user": "dsmith@mozilla.com"}, "27950": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060748 - Add ifdef MOZ_THUNDERBIRD workaround for drag+drop regression.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317105\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317609\n", "files": ["widget/nsBaseDragService.cpp"], "git_node": "29810e50996184e628f7f1f2c1ab90dff3ef39dc", "git_parents": ["94bdec29c08069635aba5676d6731722b8cef2ce"], "node": "112558f0fc50483096ff3c600f49c5e5768d1a63", "parents": ["e38f9a28f61af304d1a3d951d83076501df056c0"], "tags": []}], "date": 1786400830, "git_changesets": ["29810e50996184e628f7f1f2c1ab90dff3ef39dc"], "user": "dsmith@mozilla.com"}, "27951": {"changesets": [{"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2057577 - DOM Media - Add FFmpeg 63 support.  a=diannaS\n\nRaise FFMPEG_MAX_MAJOR_VERSION to 63 and add the ffmpeg63 header tree\nso system/custom libavcodec.so.63 can be loaded. Keep libavcodec.so.62\nin the runtime linker search list after the max bump. Adapt to FFmpeg\n63 API removals: query sample rates via avcodec_get_supported_config,\nand pick the Vulkan transfer queue from AVVulkanDeviceContext::qf.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314026\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317678\n", "files": [".clang-format-ignore", ".prettierignore", "dom/media/platforms/ffmpeg/FFmpegAudioEncoder.cpp", "dom/media/platforms/ffmpeg/FFmpegLibWrapper.cpp", "dom/media/platforms/ffmpeg/FFmpegLibWrapper.h", "dom/media/platforms/ffmpeg/FFmpegRuntimeLinker.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/ffmpeg63/include/COPYING.LGPLv2.1", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/avcodec.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/avdct.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/bsf.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec_desc.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec_id.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec_par.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/defs.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/packet.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/vdpau.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/version.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/version_major.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/attributes.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/avconfig.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/avutil.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/buffer.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/channel_layout.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/common.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/cpu.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/dict.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/error.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/frame.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/hwcontext.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/hwcontext_drm.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/hwcontext_vaapi.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/hwcontext_vulkan.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/intfloat.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/log.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/macros.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/mathematics.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/mem.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/pixfmt.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/rational.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/samplefmt.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/version.h", "dom/media/platforms/ffmpeg/ffmpeg63/moz.build", "dom/media/platforms/ffmpeg/moz.build", "tools/rewriting/ThirdPartyPaths.txt"], "git_node": "bcbff000a536a2a2359c89daa969919d3d7eea12", "git_parents": ["29810e50996184e628f7f1f2c1ab90dff3ef39dc"], "node": "633fb934bbf6079adc0f6f568a848e97c814cc25", "parents": ["112558f0fc50483096ff3c600f49c5e5768d1a63"], "tags": []}], "date": 1786407870, "git_changesets": ["bcbff000a536a2a2359c89daa969919d3d7eea12"], "user": "dsmith@mozilla.com"}, "27952": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-tr/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-ko/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-ar/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-cak/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-fi/strings.xml", "mobile/android/android-components/