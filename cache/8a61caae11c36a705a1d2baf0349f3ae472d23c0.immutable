d/android-components/components/feature/summarize/src/main/res/values-ro/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-tr/strings.xml", "mobile/android/android-components/components/lib/crash/src/main/res/values-cak/strings.xml", "mobile/android/fenix/app/longfox/src/main/res/values-cak/strings.xml", "mobile/android/fenix/app/src/main/res/values-cak/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-nb-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-ro/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml"], "git_node": "63d384fc5fd48a997a145f87ab08adad3c4d4f5c", "git_parents": ["71f3423be89d4a724623d969dd907476b124bacb"], "node": "485df4baaed197d7e3d5929ff4a184c1ee42940a", "parents": ["11b0d2c2a372422e808d70cf27e5489b700d2b06"], "tags": []}], "date": 1785723473, "git_changesets": ["63d384fc5fd48a997a145f87ab08adad3c4d4f5c"], "user": "ffxbld@lando.moz.tools"}, "27786": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1955142 - Make `nsFrameSelection::MoveCaret` should do nothing if the anchor-focus range is outside the limiters  a=diannaS\n\nCurrently, browsers allow the selection range to be outside the focused\nediting host. Then, only Chrome allow to modify the `Selection`.\nHowever, I think we should not follow Chrome because it may cause more\ncomplicated things in edge cases. Therefore, the new tentative WPT\ncheck whether the selection won't be modified.\n\nNote that the reported assertion failure occurs only when the selection\nmove crosses a frame. Therefore, the new WPT puts caret at edge of the\n`Text` to cross the frame boundary with the `Selection.modify` call.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315133\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315910\n", "files": ["layout/generic/nsFrameSelection.cpp", "testing/web-platform/tests/selection/contenteditable/selection-outside-focused-editing-host.tentative.html"], "git_node": "6ec3dc1f9ba5875a26a06e8b800d642b458773a4", "git_parents": ["63d384fc5fd48a997a145f87ab08adad3c4d4f5c"], "node": "18e1d014d4c8e6aff893cc362e575676d847f832", "parents": ["485df4baaed197d7e3d5929ff4a184c1ee42940a"], "tags": []}], "date": 1785723641, "git_changesets": ["6ec3dc1f9ba5875a26a06e8b800d642b458773a4"], "user": "dsmith@mozilla.com"}, "27787": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump\n\nach -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\naf -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nan -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nar -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nast -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\naz -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nbe -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nbg -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nbn -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nbr -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nbs -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nca -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nca-valencia -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\ncak -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\ncs -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\ncy -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nda -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nde -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\ndsb -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nel -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nen-CA -\u003e 8a553cae51325d546f3efe9f6e13c20dc628dfa0\nen-GB -\u003e 8a553cae51325d546f3efe9f