/aiwindow/ui/test/xpcshell/test_AutoTabGrouping.js", "browser/locales-preview/autoTabGrouping.ftl", "browser/themes/shared/smartwindowGroupTabs.css"], "git_node": "6bd2da4fbe05bb1c2fc4d7f5de7ea7cfd26d9a15", "git_parents": ["6eafb843327e42a15fb78622cd2c204086a225a6"], "node": "7dcc5dd0825d25d305f0cc1131d2070eca5a6f4d", "parents": ["9769f3ea55bc3b65b7d7e7b22c2e7cbdc87415e5"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058205 - Add the note and loading states to the Auto Tab Grouping panel  a=diannaS DONTBUILD\n\nAuto Tab Grouping / 'Organize Tabs'\n\nFigma: https://www.figma.com/design/75Z1LtkCEUJWCxoY2KyNHv/Smart-Window-Q2?node-id=10472-13052&focus-id=10472-13052&view=focus&m=dev\n\nv0 Brief: https://docs.google.com/document/d/15_lGUTaAM6HFimBwkfBVPPCg_0ROGIyInNeLSPPb0NE/edit?tab=t.0#heading=h.k0db31goubh2\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314716\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316825\n", "files": ["browser/components/aiwindow/ui/assets/kit-meditating.svg", "browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/locales-preview/autoTabGrouping.ftl", "browser/themes/shared/smartwindowGroupTabs.css"], "git_node": "7806d92fc49b1179e15545caa4054ba37b14ff4e", "git_parents": ["6bd2da4fbe05bb1c2fc4d7f5de7ea7cfd26d9a15"], "node": "4ea04e41c8984b344057687e2063c3e8d22d763d", "parents": ["7dcc5dd0825d25d305f0cc1131d2070eca5a6f4d"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058205 - Restyle the Auto Tab Grouping panel with the chrome panel tokens  a=diannaS DONTBUILD\n\nAuto Tab Grouping / 'Organize Tabs'\n\nFigma: https://www.figma.com/design/75Z1LtkCEUJWCxoY2KyNHv/Smart-Window-Q2?node-id=10472-13052&focus-id=10472-13052&view=focus&m=dev\n\nv0 Brief: https://docs.google.com/document/d/15_lGUTaAM6HFimBwkfBVPPCg_0ROGIyInNeLSPPb0NE/edit?tab=t.0#heading=h.k0db31goubh2\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314717\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316826\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/themes/shared/smartwindowGroupTabs.css"], "git_node": "f9d81cc1aeae91b3bfc0562f26d860c2505ab979", "git_parents": ["7806d92fc49b1179e15545caa4054ba37b14ff4e"], "node": "0d1d0fa689ac4c24532544ce3822ad89a28e5732", "parents": ["4ea04e41c8984b344057687e2063c3e8d22d763d"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058205 - Anchor the Auto Tab Grouping flyout on the panel's end side  a=diannaS DONTBUILD\n\nAuto Tab Grouping / 'Organize Tabs'\n\nFigma: https://www.figma.com/design/75Z1LtkCEUJWCxoY2KyNHv/Smart-Window-Q2?node-id=10472-13052&focus-id=10472-13052&view=focus&m=dev\n\nv0 Brief: https://docs.google.com/document/d/15_lGUTaAM6HFimBwkfBVPPCg_0ROGIyInNeLSPPb0NE/edit?tab=t.0#heading=h.k0db31goubh2\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314718\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316827\n", "files": ["browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js"], "git_node": "90a2a277af5dbba8b42287c0a71eb8c097f98639", "git_parents": ["f9d81cc1aeae91b3bfc0562f26d860c2505ab979"], "node": "fc3c749deffcca7c183b0c8e8adeaa960efc02c7", "parents": ["0d1d0fa689ac4c24532544ce3822ad89a28e5732"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058205 - Rename the feature's user-visible strings to \"Organize Tabs\"  a=diannaS DONTBUILD\n\nAuto Tab Grouping / 'Organize Tabs'\n\nFigma: https://www.figma.com/design/75Z1LtkCEUJWCxoY2KyNHv/Smart-Window-Q2?node-id=10472-13052&focus-id=10472-13052&view=focus&m=dev\n\nv0 Brief: https://docs.google.com/document/d/15_lGUTaAM6HFimBwkfBVPPCg_0ROGIyInNeLSPPb0NE/edit?tab=t.0#heading=h.k0db31goubh2\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314719\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316828\n", "files": ["browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/locales-preview/autoTabGrouping.ftl", "browser/locales/en-US/browser/aiWindow.ftl", "browser/themes/shared/smartwindowGroupTabs.css"], "git_node": "bee0de93c2968b272731331f3288dd45b83852e1", "git_parents": ["90a2a277af5dbba8b42287c0a71eb8c097f98639"], "node": "1a9a08a7e46be3612c311d5c410049be509cee53", "parents": ["fc3c749deffcca7c183b0c8e8adeaa960efc02c7"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058205 - Restyle the Organize Tabs toolbar button per the design  a=diannaS DONTBUILD\n\nAuto Tab Grouping / 'Organize Tabs'\n\nFigma: https://www.figma.com/design/75Z1LtkCEUJWCxoY2KyNHv/Smart-Window-Q2?node-id=10472-13052&focus-id=10472-13052&view=focus&m=dev\n\nv0 Brief: https://docs.google.com/document/d/15_lGUTaAM6HFimBwkfBVPPCg_0ROGIyInNeLSPPb0NE/edit?tab=t.0#heading=h.k0db31goubh2\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314725\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316829\n", "files": ["browser/themes/shared/icons/grid-sparkle.svg", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/toolbarbutton-icons.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "a178d8979fcdac9afb002f656b05f3881042c225", "git_parents": ["bee0de93c2968b272731331f3288dd45b83852e1"], "node": "5f39a958b5342f61c1b0279d9be026faca7439dd", "parents": ["1a9a08a7e46be3612c311d5c410049be509cee53"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059806 - Add a Close Duplicate Tabs action to the Organize Tabs panel and fix the flyout auto-hide  a=diannaS DONTBUILD\n\nAuto Tab Grouping / 'Organize Tabs'\n\nFigma: https://www.figma.com/design/75Z1LtkCEUJWCxoY2KyNHv/Smart-Window-Q2?node-id=10202-80249&m=dev\n\nAdds a \"Close Duplicate Tabs\" row to the bottom of the Organize Tabs panel,\nreusing the same gBrowser.removeAllDuplicateTabs() action the All Tabs menu\noffers. The row is only rendered when the window actually has duplicates, and\nthat is re-checked every time the panel syncs, so it never offers a no-op. The\ncount comes from the same getAllDuplicateTabsToClose() list the action closes,\nso the row can name it and say how many tabs it will close. The panel is\ndismissed before the tabs close because the resulting confirmation hint anchors\nto the All Tabs button, which the open panel would cover.\n\nAlso fixes the suggestion flyout never auto-hiding. _scheduleHideFlyout read\npanel.ownerGlobal, which is undefined on the panel, so it took its early return\nand no hide was ever scheduled; the flyout stayed open no matter what the\npointer did next. It now uses the module's Timer.sys.mjs import, keeps a flyout\nthat holds focus open so pointer drift cannot close one the keyboard is working\nin, and marks the row dismissed before hiding so the focus the popup hands back\ndoes not immediately reopen it.\n\nThe panel test file now asks for a longer timeout. Every subtest passes, but\neach one opens its own Smart Window and waits for clustering, and with the tests\nthis stack adds the file runs 101s against the 90s per-file limit on ASAN.\nSplitting it up is left to a follow-up.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315692\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316830\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/locales-preview/autoTabGrouping.ftl"], "git_node": "1a37734ad8afdaf8cf622d621470c3d83a9e8142", "git_parents": ["a178d8979fcdac9afb002f656b05f3881042c225"], "node": "186d2de5234154ec549281149f93fd92f03a0554", "parents": ["5f39a958b5342f61c1b0279d9be026faca7439dd"], "tags": []}], "date": 1786138474, "git_changesets": ["6eafb843327e42a15fb78622cd2c204086a225a6", "6bd2da4fbe05bb1c2fc4d7f5de7ea7cfd26d9a15", "7806d92fc49b1179e15545caa4054ba37b14ff4e", "f9d81cc1aeae91b3bfc0562f26d860c2505ab979", "90a2a277af5dbba8b42287c0a71eb8c097f98639", "bee0de93c2968b272731331f3288dd45b83852e1", "a178d8979fcdac9afb002f656b05f3881042c225", "1a37734ad8afdaf8cf622d621470c3d83a9e8142"], "user": "dsmith@mozilla.com"}, "27908": {"changesets": [{"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060705 - Skip the Organize Tabs panel test under test-verify  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316937\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317174\n", "files": ["browser/components/aiwindow/ui/test/browser/browser.toml"], "git_node": "c2be494e26929fa3d620c21c84a430f4251c59f0", "git_parents": ["1a37734ad8afdaf8cf622d621470c3d83a9e8142"], "node": "a78e35dbe964c676793d61cff0e24866710d9d2f", "parents": ["186d2de5234154ec549281149f93fd92f03a0554"], "tags": []}], "date": 1786138635, "git_changesets": ["c2be494e26929fa3d620c21c84a430f4251c59f0"], "user": "dsmith@mozilla.com"}, "27909": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060511 - update our webcompat intervention for all Nintendo domains;  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317176\n", "files": ["browser/extensions/webcompat/injections/js/predefine_OnetrustActiveGroups.js", "browser/extensions/webcompat/manifest.json"], "git_node": "9830214c21878fcbd1acdc5be0c23c5a57191bbb", "git_parents": ["c2be494e26929fa3d620c21c84a430f4251c59f0"], "node": "2febb073002d6dfa88842df41217bcc9a5f8064e", "parents": ["a78e35dbe964c676793d61cff0e24866710d9d2f"], "tags": []}], "date": 1786138905, "git_changesets": ["9830214c21878fcbd1acdc5be0c23c5a57191bbb"], "user": "dsmith@mozilla.com"}, "27910": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058525 - Make submenus inherit the color scheme of their parent popup.  a=diannaS\n\nThe generic popup rule sets color-scheme on every popup, submenus included, so\na popup that narrows its scheme couldn't pass that on: the content context\nmenu follows content's preferred color scheme, but its submenus fell back to\nthe chrome scheme, which can be the opposite one.\n\nPopups whose parent doesn't narrow the scheme are unaffected, since inheriting\nthere resolves to the same light dark.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316919\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317187\n", "files": ["browser/base/content/test/contextMenu/browser.toml", "browser/base/content/test/contextMenu/browser_contextmenu_color_scheme.js", "toolkit/themes/shared/popup.css"], "git_node": "6b9dca0a5394a5ff4e5dd8309000aa4ed0e9a97b", "git_parents": ["9830214c21878fcbd1acdc5be0c23c5a57191bbb"], "node": "1b656b03ee4618e887ed97d3982fcbafb3ba8b23", "parents": ["2febb073002d6dfa88842df41217bcc9a5f8064e"], "tags": []}], "date": 1786138942, "git_changesets": ["6b9dca0a5394a5ff4e5dd8309000aa4ed0e9a97b"], "user": "dsmith@mozilla.com"}, "27911": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2061315 - check we're in the composed doc before calling ScheduleForPresAttrEvaluation  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316883\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317018\n", "files": ["dom/svg/SVGSVGElement.cpp"], "git_node": "d4334af7eb936783b23cd62debd373183bf8eb83", "git_parents": ["6b9dca0a5394a5ff4e5dd8309000aa4ed0e9a97b"], "node": "bf8456be37d6d6352753b5e5531cefbb5760db7b", "parents": ["1b656b03ee4618e887ed97d3982fcbafb3ba8b23"], "tags": []}], "date": 1786140094, "git_changesets": ["d4334af7eb936783b23cd62debd373183bf8eb83"], "user": "dsmith@mozilla.com"}, "27912": {"changesets": [{"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053455 - Add support for multiple arguments in jump list items.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314118\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317092\n", "files": ["browser/modules/WindowsJumpLists.sys.mjs", "dom/chrome-webidl/WindowsJumpListShortcutDescription.webidl", "widget/windows/JumpListBuilder.cpp", "widget/windows/tests/gtest/TestJumpListBuilder.cpp"], "git_node": "583bb337a198f2f2319e71cacf21da5b0a8688a4", "git_parents": ["d4334af7eb936783b23cd62debd373183bf8eb83"], "node": "abe13064bd67bc0af4153f72dbef64d6e9cafe37", "parents": ["bf8456be37d6d6352753b5e5531cefbb5760db7b"], "tags": []}], "date": 1786140116, "git_changesets": ["583bb337a198f2f2319e71cacf21da5b0a8688a4"], "user": "dsmith@mozilla.com"}, "27913": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2057033: Disable ::-webkit-scrollbar on gemini.google.com.  a=diannaS\n\nThe gemini.google.com website has its own bespoke \"fake overlay scrollbars\"\nscrollbar styles.  Their styles turn out to produce a worse experience for\nus if we enable our partial ::-webkit-scrollbar support.  So, let's turn off\nthat support on this site for now.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313616\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317190\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "5f0d4c3154f1c00fa8779326a48695b252ab3938", "git_parents": ["583bb337a198f2f2319e71cacf21da5b0a8688a4"], "node": "24fd645ba36aa0813722430916c57d401745c1d8", "parents": ["abe13064bd67bc0af4153f72dbef64d6e9cafe37"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2058432: Disable ::-webkit-scrollbar on content.powerapps.com.  a=diannaS\n\nThis domain (used by app.powerbi.com) has some JS that works with\n::-webkit-scrollbar in a way that's more sophisticated than our partial support\ncan handle (specifically, expecting arbitrary `width` / `height` values to\nwork).  This ends up giving us a worse experience (various useless scrollbars)\nwhen we have this feature enabled.  So, let's add the site to our feature\nopt-out list.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315681\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317191\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "8a03a50552c35f4971b4f587930d810a51d2310d", "git_parents": ["5f0d4c3154f1c00fa8779326a48695b252ab3938"], "node": "825b2b031fdf62a108127fb65aa38630e518442d", "parents": ["24fd645ba36aa0813722430916c57d401745c1d8"], "tags": []}], "date": 1786141208, "git_changesets": ["5f0d4c3154f1c00fa8779326a48695b252ab3938", "8a03a50552c35f4971b4f587930d810a51d2310d"], "user": "dsmith@mozilla.com"}, "27914": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobi